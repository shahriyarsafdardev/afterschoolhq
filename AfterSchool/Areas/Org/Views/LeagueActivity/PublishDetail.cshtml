@model Activity
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages) ViewBag.Messages;
    var publishMsgs = Model.GetItemsRequiredToPublish();
    var group = Model.GetActivityGroup();

    var publishUrl = "#";
    var btnDisabled = "disabled";
    var isPublishable = Model.IsPublishable();
    if (isPublishable)
    {
        publishUrl = Url.Action("publish", "activity", new {id = Model.Uid});
        btnDisabled = "";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString()); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Publish"); }
        </div>
        <div class="panel-body">

            <div class="panel panel-default">
                <div class="panel-heading">
                    <div class="btn-group pull-right">
                        @if (isPublishable)
                        {
                            if (SessionVariables.CurrentUser.VerifiedAccount)
                            {
                                if (!Model.IsPublished)
                                {
                                    <a href="@publishUrl" class="btn btn-success btn-space @btnDisabled">Publish Your @UILabel.ActivityLabel(Model.ActivityTypeId) <i class="s7-right-arrow"></i></a>
                                }
                                else
                                {
                                    <button class="btn btn-default btn-space md-trigger" data-modal="modal-unpublish">Unpublish Your @UILabel.ActivityLabel(Model.ActivityTypeId) <i class="s7-right-arrow"></i></button>
                                }
                            }
                            else
                            {
                                <a href="javascript:AccountSetup.sendVerificationEmail()" class="text-danger">Please verify your email address to publish @UILabel.ActivityLabel(Model.ActivityTypeId, true).ToLower()</a>
                            }
                        }
                    </div>
                    <div>
                        Publish @UILabel.ActivityLabel(Model.ActivityTypeId)
                    </div>
                </div>

                <div class="panel-body">
                    <div class="widget col-md-10 col-md-offset-1">
                        <div class="widget-head">
                            @if (isPublishable)
                            {
                                if (Model.IsPublished)
                                {
                                    <p class="text-success text-xlarge">
                                        <i class="s7-check-circle"></i>
                                        Your @UILabel.ActivityLabel(Model.ActivityTypeId) is published :)
                                    </p>
                                }
                                else
                                {
                                    <p class="text-warning text-xlarge">
                                        <i class="s7-next-2"></i>
                                        Your @UILabel.ActivityLabel(Model.ActivityTypeId) is ready to publish
                                    </p>
                                }
                            }
                            else
                            {
                                <p class="text-danger text-xlarge">
                                    <i class="s7-close-circle"></i>
                                    Your @UILabel.ActivityLabel(Model.ActivityTypeId) is <em>not</em> ready to publish
                                </p>
                            }
                        </div>
                        <div class="widget-tile">
                            @if (!isPublishable)
                            {
                                <h3>Please review the items below and save your updates in order to publish your registration form</h3>
                                foreach (SystemMessage msg in publishMsgs)
                                {
                                    if (msg.Text.Contains("publish-error-title"))
                                    {
                                        <br/>
                                        <p>
                                            @Html.Raw(msg.Text) <i class="s7-link"></i>
                                        </p>
                                    }
                                    else
                                    {
                                        @:&nbsp;&bull; @Html.Raw(msg.Text)<br/>
                                    }
                                }
                            }
                            else
                            {
                                <table class="table table-striped">
                                    <tr>
                                        <td>Organization Home Page</td>
                                        <td>
                                            <a href="@SessionVariables.CurrentAccount.HomePageUrl" target="_blank">@SessionVariables.CurrentAccount.HomePageUrl</a>
                                            <a href="@SessionVariables.CurrentAccount.HomePageUrl" target="_blank">
                                                <i class="s7-link"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    @if (Model.IsPublished)
                                    {
                                        if (Model.ActivityGroupId.HasValue)
                                        {
                                            <tr>
                                                <td>@UILabel.ActivityGroupLabel(group.ActivityGroupTypeId) URL</td>
                                                <td>
                                                    <a href="@group.HomePageUrl" target="_blank">@group.HomePageUrl</a>
                                                    <a href="@group.HomePageUrl" target="_blank">
                                                        <i class="s7-link"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr>
                                                <td>@UILabel.ActivityLabel(Model.ActivityTypeId) URL</td>
                                                <td>
                                                    <a href="@Model.HomePageUrl" target="_blank">@Model.HomePageUrl</a>
                                                    <a href="@Model.HomePageUrl" target="_blank">
                                                        <i class="s7-link"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    @if (!Model.ActivityGroupId.HasValue)
                                    {
                                        <tr>
                                            <td>Preview URL (do not share)</td>
                                            <td>
                                                <a href="@Model.PreviewUrl" target="_blank">@Model.PreviewUrl</a>
                                                <a href="@Model.PreviewUrl" target="_blank">
                                                    <i class="s7-link"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </table>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="modal-unpublish" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Warning</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to unpublish the @UILabel.ActivityLabel(Model.ActivityTypeId).ToLower()? This will make it inaccessible to potential @UILabel.RegistrantLabel(true).ToLower()</p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a href="@Url.Action("unpublish", "activity", new {id = Model.Uid})" class="btn btn-primary">
                Unpublish @UILabel.ActivityLabel(Model.ActivityTypeId) &raquo;
            </a>
        </div>
    </div>
</div>