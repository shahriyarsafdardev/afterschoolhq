@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Team"); }
        </div>
        <div class="panel-body">

            <div class="col-md-10 col-md-offset-1">

                @{Html.RenderPartial("~/Views/Shared/_ActivityTeam.cshtml", Model);}

            </div>
        </div>
    </div>
</div>

