@model Activity
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;

    var saveButtonCols = 7;
    var saveButtonPrimary = "btn-primary";
    if (!Model.ActivityGroupId.HasValue)
    {
        saveButtonCols = 5;
        saveButtonPrimary = "btn-default";
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">            
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editcost", "activity", new { id = Model.Uid })" class="form-horizontal">

                    @if (Model.CanAcceptPayments())
                    {
                        if (!Model.ActivityGroupId.HasValue)
                        {
                            <button type="submit" class="btn btn-primary pull-right btn-space" onclick="navigateActivity('@Url.Action("editcost", "activity", new { id = Model.Uid, cmd = "next" })')">&raquo;</button>
                        }
                        <button type="submit" class="btn btn-default pull-right btn-space"><i class="s7-diskette"></i> Save</button>
                        <button type="submit" class="btn btn-default pull-right btn-space" onclick="navigateActivity('@Url.Action("editcost", "activity", new { id = Model.Uid, cmd = "prev" })')">&laquo;</button>
                    }

                    @{Html.RenderPartial("~/Views/Shared/_ActivityFormPayment.cshtml", Model);}

                    @if (Model.CanAcceptPayments())
                    {
                        <div class="form-group">
                            <div class="col-sm-2 col-sm-offset-3">
                                <button type="submit" class="btn btn-default btn-space btn-lg btn-block" onclick="navigateActivity('@Url.Action("editcost", "activity", new { id = Model.Uid, cmd = "prev" })')">&laquo; Previous</button>
                            </div>
                            <div class="col-sm-@saveButtonCols">
                                <button type="submit" class="btn @saveButtonPrimary btn-space btn-lg btn-block"><i class="s7-diskette"></i> Save</button>
                            </div>
                            
                            @if (!Model.ActivityGroupId.HasValue)
                            {
                                <div class="col-sm-2">
                                    <button type="submit" class="btn btn-primary btn-space btn-lg btn-block" onclick="navigateActivity('@Url.Action("editcost", "activity", new { id = Model.Uid, cmd = "next" })')">Next &raquo;</button>
                                </div>
                            }

                        </div>
                    }
                </form>
            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>

<script>

    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

</script>