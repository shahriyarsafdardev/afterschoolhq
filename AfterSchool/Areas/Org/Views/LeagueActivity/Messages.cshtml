@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Messages"); }
        </div>
        <div class="panel-body">
            @{Html.RenderPartial(
                "~/Views/Shared/_Messages.cshtml",
                Model.GetMessages().OrderByDescending(x => x.DateSent.Value).ToList(),
                new ViewDataDictionary()
                {
                    { "SendNewMessageLink", Url.Action("messageadd", "activity", new { id = Model.ID }) },
                    { "Account", SessionVariables.CurrentAccount },
                    { "ViewLinkController", "activity" }
                }
                );}

        </div>
    </div>
</div>
