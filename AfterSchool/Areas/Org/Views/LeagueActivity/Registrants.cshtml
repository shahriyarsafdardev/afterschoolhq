@model AfterSchoolLibrary.Activity
@{
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;

    var registrants = (List<RegistrantActivity>)ViewBag.Registrants;
    var account = SessionVariables.CurrentAccount;
    decimal totalPaid = 0;
    int registrantCount = registrants
        .Where(x => x.AssignmentTypeId == RegistrationAssignmentType.Reserved || x.AssignmentTypeId == RegistrationAssignmentType.ReservedPendingPayment)
        .Count();
    int waitingListCount = registrants
        .Where(x => x.AssignmentTypeId == RegistrationAssignmentType.WaitingList)
        .Count();
    int applicationCount = registrants
        .Where(x => x.AssignmentTypeId == RegistrationAssignmentType.Applied)
        .Count();
    int invitationCount = registrants
        .Where(x => x.AssignmentTypeId == RegistrationAssignmentType.Invited)
        .Count();
    int declinedCount = registrants
        .Where(x => x.AssignmentTypeId == RegistrationAssignmentType.Declined)
        .Count();

    if (registrants.Where(x => x.DatePaid.HasValue).Count() > 0)
    {
        totalPaid = registrants.Where(x => x.DatePaid.HasValue).Sum(x => x.AmountPaid.Value);
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">
                <a href="@Url.Action("managestudents", "leagueactivity", new { id = Model.Uid })" class="btn btn-default btn-space pull-right btn-success">
                    <i class="icon icon-left s7-plus"></i> Manage Students
                </a>
            </div>
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - " + UILabel.RegistrantLabel(true)); }
        </div>
        <div class="panel-body">
            <div class="row">

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@registrantCount" data-decimals="0" data-suffix="" class="value">@registrantCount</div>
                            <div class="desc">Reserved</div>
                        </div>
                        <div class="icon"><span class="s7-users"></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@waitingListCount" data-decimals="0" data-suffix="" class="value">@waitingListCount</div>
                            <div class="desc">Waiting List</div>
                        </div>
                        <div class="icon"><span class="s7-users"></span></div>
                    </div>
                </div>

                <div class="col-md-3 hide">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@applicationCount" data-decimals="0" data-suffix="" class="value">@applicationCount</div>
                            <div class="desc">Applied</div>
                        </div>
                        <div class="icon"><span class="s7-users"></span></div>
                    </div>
                </div>

                @if (Model.CostPerRegistrant > 0)
                {
                    <div class="col-md-3">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                                <div class="desc">Total Paid</div>
                            </div>
                            <div class="icon"><span class="s7-cash"></span></div>
                        </div>
                    </div>
                }
            </div>

            <div class="row">
                <div class="col-md-4">
                    <select id="assignmentType" onchange="changeAssignment()" class="form-control">
                        <option value="">View All Assignments</option>
                        @foreach (var x in Enum.GetValues(typeof(RegistrationAssignmentType)).Cast<RegistrationAssignmentType>().Where(x => x != RegistrationAssignmentType.NotSet))
                        {
                            if (account.HasFeature(FeatureType.AllowApplications) || x != RegistrationAssignmentType.Applied)
                            {
                                var selected = "";
                                if (assignmentType == x)
                                {
                                    selected = "selected=\"selected\"";
                                }

                                <option value="@((int)x)" @selected>@x.ToString().SplitByUpperCase()</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4"></div>
                <div class="col-md-4">

                    <div class="pull-right">
                        <a href="@Url.Action("registrantsummary", "leagueactivity", new { id = Model.Uid })" class="btn btn-default btn-space pull-right">
                            <i class="icon icon-left s7-paper-plane"></i> Send Registration Report
                        </a>                        
                    </div>

                    <a href="@Url.Action("registrantdownload", "activity", new { id = Model.Uid })" class="btn btn-primary btn-space hide">
                        <i class="icon icon-left s7-download"></i> Download Registration Data
                    </a>
                    <a href="@Url.Action("registrantimport", "activity", new { id = Model.Uid })" class="btn btn-primary btn-space hide">
                        <i class="icon icon-left s7-upload"></i> Import Registration Data
                    </a>
                </div>
            </div>

            @{Html.RenderPartial(
                  "~/Views/Shared/_ActivityRegistrants.cshtml", 
                  registrants,
                  new ViewDataDictionary()
                  {
                    { "Activity", Model },
                    { "Account", account },
                    { "EditAction", "registrantdetail" },
                    { "EditController", "leagueactivity" },
                    { "AssignmentType", assignmentType }
                  }
             );}

        </div>
    </div>
</div>

<script>
    function changeAssignment() {
        location.href = '@Url.Action("registrants", "leagueactivity", new { id = Model.Uid })?atype=' + $('#assignmentType').val();
    }
</script>