@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    var msgs = (SystemMessages)ViewBag.Messages;

    var group = (ActivityGroup)ViewBag.Group;
    var mainColWidth = 10;
    var saveBtnWidth = 7;
    var title = Model.Name.IfBlank("New " + UILabel.ActivityLabel(Model.ActivityTypeId));
    var registrants = (List<Registrant>)ViewBag.Registrants;
    var addedRegistrants = (List<Registrant>)ViewBag.AddedRegistrants;
    var registrantsPerColumn = 2;
    var count = registrants.Count;
    if (group.IsNotEmpty())
    {
        title = group.Name + " - " + title;
    }


}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", title); }
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("managestudents", "leagueactivity", new { id = Model.Uid })" class="form-horizontal">

                    @if (registrants.Count == 0 && addedRegistrants.Count == 0)
                    {
                        <p> There are no available registrants to add to this team. </p>
                    }
                    else
                    {
                        Html.RenderPartial("_ManageStudents", Model,
                            new ViewDataDictionary() {
                                { "Registrants", registrants },
                                { "AddedRegistrants", addedRegistrants },
                                { "Group", group }
                            }
                            );
                    }

                    <div class="form-group">

                        <div class="col-sm-@saveBtnWidth col-sm-offset-3">
                            <button type="submit" class="btn btn-default btn-space btn-lg btn-block" onclick="navigateActivity('@Url.Action("managestudents", "leagueactivity", new { id = Model.Uid })')"><i class="s7-diskette"></i>Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>

    
    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

    function selectAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', true);
        });
    }
    function clearAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', false);
        });
    }
    

</script>

