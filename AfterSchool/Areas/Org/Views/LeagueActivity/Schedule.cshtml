@model  Activity
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var activityInstances = (List<ActivityInstance>)ViewBag.ActivityInstances;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }
        </div>
        <div class="panel-body">

            <div class="panel-heading">
                <h2>
                    Season Schedule
                </h2>
            </div>
            <div class="table-responsive">
                <table class="table">
                    @foreach (List<ActivityInstance> day in activityInstances.GroupBy(a => a.StartDateTime.Value.Date).Select(grp => grp.ToList()).ToList())
                    {
                        <tr>
                            <td colspan="4">
                                <h4 class="margin-10">
                                    <strong>
                                        @day.First().StartDateTime.Value.ToShortDateString() - @day.First().Day.ToString()
                                    </strong>
                                </h4>
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><strong>Time</strong></td>
                            <td><strong>Location</strong></td>
                            <td class="text-center"><strong>Teams</strong></td>
                        </tr>
                        foreach (var activityInstance in day)
                        {
                            var matches = Match.LoadByActivityInstanceId(activityInstance.ID.Value);
                            var matchTeams = "";
                            var location = new Location();
                            var locationName = "TBD";
                            var startTime = activityInstance.StartDateTime.Value.ToShortTimeString();
                            var endTime = activityInstance.EndDateTime.Value.ToShortTimeString();
                            if (activityInstance.LocationId.IsNotEmpty())
                            {
                                location = Location.Load(activityInstance.LocationId.Value);
                                locationName = location.Name.ToString();
                            }

                            var vs = " ";

                            foreach (var match in matches)
                            {
                                Activity team = Activity.Load(match.TeamId.Value);

                                if (team.IsNotEmpty())
                                {
                                    matchTeams += vs + team.Name.ToString();
                                    vs = " vs. ";
                                }

                            }

                            <tr>
                                <td>
                                </td>
                                <td>@startTime - @endTime</td>
                                <td>@locationName</td>
                                <td class="text-center">@matchTeams</td>
                            </tr>
                        }
                        <tr>
                            <td colspan="4"></td>
                        </tr>

                    }

                </table>
            </div>
        </div>
    </div>
</div>
