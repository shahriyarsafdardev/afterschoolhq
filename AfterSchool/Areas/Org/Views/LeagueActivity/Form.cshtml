@model Activity
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var questionGroups = (List<FormQuestionGroup>)ViewBag.QuestionGroups;
    var individualGroups = (List<FormQuestionGroup>)ViewBag.IndividualGroups;
    var questionGroup = (FormQuestionGroup)ViewBag.QuestionGroup;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Registration Form"); }
        </div>
        <div class="panel-body">
            
            <div class="col-md-8 col-lg-9">
                
                <form id="form1" method="post" action="@Url.Action("form", "activity", new { id = Model.Uid.ToString(), qg = questionGroup.ID })" class="form-horizontal">
                
                    @if (questionGroup.IsEmpty())
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Form Settings
                            </div>
                            <div class="panel-body">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Registration Form Name</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="name" name="name" value="@Model.Name.IfBlank(Model.Name + " Registration Form")" onfocus="this.select()" required />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Brief Instructions</label>
                                    <div class="col-sm-9">
                                        <textarea name="description" id="description" class="form-control" rows="5" required>@Model.Description.IfBlank("Please fill in the registration form below")</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="btn-group pull-right">

                                    @if (questionGroups.First().ID != questionGroup.ID)
                                    {
                                        <button type="submit" class="btn btn-default btn-space" onclick="navigateForm('@Url.Action("form", "activity", new { id = Model.Uid, qg = questionGroup.ID, cmd = "prev" })')">&laquo;</button>
                                    }
                                    <button type="submit" class="btn btn-default btn-space"><i class="s7-diskette"></i> Save</button>
                                    @if (questionGroups.Last().ID != questionGroup.ID)
                                    {
                                        <button type="submit" class="btn btn-primary btn-space" onclick="navigateForm('@Url.Action("form", "activity", new { id = Model.Uid, qg = questionGroup.ID, cmd = "next" })')">&raquo;</button>
                                    }
                                </div>
                                <div class="clearfix"></div>
                                <p></p>
                                <input type="text" id="name-@questionGroup.ID" name="name-@questionGroup.ID" value="@questionGroup.Name" required class="form-control input-lg input-lg-font" onfocus="this.select()" data-tooltip-id="name-@questionGroup.ID" />
                            </div>
                            <div class="panel-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <tr>
                                            <td>Question Label</td>
                                            <td>Show Question? (<a href="javascript:checkAllActive()">All</a> / <a href="javascript:uncheckAllActive()">None</a>)</td>
                                            <td>Is Required? (<a href="javascript:checkAllRequired()">All</a> / <a href="javascript:uncheckAllRequired()">None</a>)</td>
                                        </tr>
                                        @foreach (var question in questionGroup.GetAllQuestions())
                                        {
                                            <tr>
                                                <td>
                                                    @if (!question.IsLocked)
                                                    {
                                                        <input type="text" id="text-@question.ID" name="text-@question.ID" value="@question.Text" required class="form-control col-sm-3" onfocus="this.select()" data-tooltip-id="text-@question.ID" />
                                                    }
                                                    else
                                                    {
                                                        <i class="s7-lock icon-medium"></i> @question.Text
                                                    }
                                                </td>
                                                <td>
                                                    @{Html.RenderPartial(
                                                      "~/Views/Shared/_SwitchButton.cshtml",
                                                      question.IsActive,
                                                      new ViewDataDictionary()
                                                      {
                                                          { "checkboxname", "active-" + question.ID },
                                                          { "checkboxid", "active-" + question.ID },
                                                          { "disabled", question.IsLocked }
                                                      });}
                                                </td>
                                                <td>
                                                    @{Html.RenderPartial(
                                                      "~/Views/Shared/_SwitchButton.cshtml",
                                                      question.IsRequired,
                                                      new ViewDataDictionary()
                                                      {
                                                          { "checkboxname", "required-" + question.ID },
                                                          { "checkboxid", "required-" + question.ID },
                                                          { "disabled", question.IsLocked }
                                                      });}
                                                </td>
                                            </tr>
                                        }

                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-sm-2">
                        <button type="submit" class="btn btn-default btn-lg btn-block" onclick="navigateForm('@Url.Action("form", "activity", new { id = Model.Uid, qg = questionGroup.ID, cmd = "prev" })')">&laquo; Previous</button>
                    </div>
                    <div class="col-sm-8">
                        <button type="submit" class="btn btn-default btn-lg btn-block"><i class="s7-diskette"></i> Save</button>
                    </div>
                    <div class="col-sm-2">
                        <button type="submit" class="btn btn-primary btn-lg btn-block" onclick="navigateForm('@Url.Action("form", "activity", new { id = Model.Uid, qg = questionGroup.ID, cmd = "next" })')">Next &raquo;</button>
                    </div>

                </form>
            </div>
            <div class="col-md-4 col-lg-3">
                
                <div id="list1" class="dd">
                    <ol class="dd-list">
                        <!--
                        <li data-id="1" class="dd-item">
                            <div class="dd-handle">
                                <a href="@Url.Action("form", "activity", new { id = Model.Uid.ToString() })">Form Settings</a>
                            </div>
                        </li>
                        -->
                        <li data-id="1" class="dd-item">
                            <div class="dd-handle title">Individual</div>
                        </li>
                        @for (var i = 0; i < individualGroups.Count; i++)
                        {
                            var active = "";
                            if(questionGroup.ID == individualGroups[i].ID)
                            {
                                active = "active";
                            }

                            <li data-id="@(i+1)" class="dd-item">
                                <div class="dd-handle @active">
                                    &nbsp;&nbsp;&nbsp;&nbsp;<a href="@Url.Action("form", "activity", new { id = Model.Uid.ToString(), qg = individualGroups[i].ID.ToString() })">@individualGroups[i].Name</a>
                                </div>
                            </li>
                        }
                    </ol>
                </div>

            </div>         

        </div>

    </div>

</div>

<script>

    function navigateForm(url) {
        $('#form1').attr('action', url);
    }
    function checkAllActive() {
        $('input[id^="active-"][disabled!="disabled"]').prop('checked', true);
    }
    function uncheckAllActive() {
        $('input[id^="active-"][disabled!="disabled"]').prop('checked', false);
    }
    function checkAllRequired() {
        $('input[id^="required-"][disabled!="disabled"]').prop('checked', true);
    }
    function uncheckAllRequired() {
        $('input[id^="required-"][disabled!="disabled"]').prop('checked', false);
    }

</script>