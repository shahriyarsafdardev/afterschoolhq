@model RegistrantActivity
@{
    ViewBag.Title = SessionVariables.CurrentAccount.Name;
    var activity = Model.GetActivity();
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", SessionVariables.CurrentAccount.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", activity);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", $"{activity.Name} - {UILabel.RegistrantLabel()} Detail"); }
        </div>
        <div class="panel-body">

            <div class="col-md-10 col-md-offset-1">

                @{Html.RenderPartial("~/Views/Shared/_RegistrantDetail.cshtml", Model,
                                new ViewDataDictionary() {
                                  { "BackToListAction", "Registrants" },
                                  { "BackToListController", "LeagueActivity" },
                                  { "ShowPaymentForm", true },
                                  { "IsActivityLeader", ViewBag.IsActivityLeader }
                                }
                                );}

            </div>
        </div>
    </div>
</div>
