@model AfterSchoolLibrary.Activity
@{
    var account = (Account)ViewBag.Account;
    ViewBag.Title = account.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var acceptPayments = accountPackage.HasFeature(FeatureType.AcceptPayments);
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_LeagueActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">            
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editlocation", "activity", new { id = Model.ID })" class="form-horizontal">
                    
                    <button type="submit" class="btn btn-primary pull-right btn-space" onclick="navigateActivity('@Url.Action("editlocation", "activity", new { id = Model.ID, cmd = "next" })')">&raquo;</button>
                    <button type="submit" class="btn btn-default pull-right btn-space"><i class="s7-diskette"></i> Save</button>
                    <button type="submit" class="btn btn-default pull-right btn-space" onclick="navigateActivity('@Url.Action("editlocation", "activity", new { id = Model.ID, cmd = "prev" })')">&laquo;</button>

                    @{Html.RenderPartial("~/Views/Shared/_ActivityFormLocation.cshtml", Model);}

                    <div class="form-group">
                        <div class="col-sm-2 col-sm-offset-3">
                            <button type="submit" class="btn btn-default btn-space btn-lg btn-block" onclick="navigateActivity('@Url.Action("editlocation", "activity", new { id = Model.ID, cmd = "prev" })')">&laquo; Previous</button>
                        </div>
                        <div class="col-sm-5">
                            <button type="submit" class="btn btn-default btn-space btn-lg btn-block"><i class="s7-diskette"></i> Save</button>
                        </div>
                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-primary btn-space btn-lg btn-block" onclick="navigateActivity('@Url.Action("editlocation", "activity", new { id = Model.ID, cmd = "next" })')">Next &raquo;</button>
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>

<script>

    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

</script>