@model List<Registrant>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var id = ViewBag.Id;
    var type = ViewBag.Type;
    var lists = (List<ContactList>)ViewBag.Lists;
    var selectedList = (int?)ViewBag.SelectedList;
    var returnUrl = ViewBag.ReturnUrl;
    var activities = (List<Activity>)ViewBag.Activities;
    var itemsPerColumn = Math.Ceiling(activities.Count / 3.0).ToInteger();
    var group = (ActivityGroup)ViewBag.Group;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <div class="pull-right">
                <a class="btn btn-primary btn-space" href="@returnUrl">
                    &laquo; Cancel
                </a>
            </div>
            <i class="s7-note2"></i> Invite Contacts
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <form action="@Url.Action("inviteto", "contact", new { id = id, type = type })" method="post" class="form-horizontal">
                <div class="row">
                    <div class="col-md-6 col-md-offset-3">

                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Select your contact list and enter a custom message
                            </div>
                            <div class="panel-body">

                                <div class="form-group">
                                    <label for="list" class="col-md-6">Contact List</label>
                                    <select id="list" name="list" class="form-control col-md-6" onchange="selectList()" required>
                                        <option value="">Select List...</option>
                                        <option value="0">New Contact List</option>
                                        <optgroup label="Contact Lists">
                                            @foreach (var list in lists)
                                            {
                                                <option value="@list.ID" @(list.ID == selectedList ? "selected=\"selected\"": "")>
                                                    @list.Name
                                                </option>
                                            }
                                        </optgroup>
                                    </select>
                                </div>
                                @if (activities.Where(x => x.ActivityGroupId.HasValue).Any() && group.ActivityGroupTypeId != ActivityGroupType.League)
                                {
                                    <div class="form-group">
                                        <label for="list" class="col-md-12">
                                            Invite &amp; restrict to specific @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower() (optional)
                                            <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="If no @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower() are selected, contacts will be invited to all @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()" data-placement="top"></i>
                                        </label>
                                        <div class="col-md-12">
                                            @for (int i = 0; i < 3; i++)
                                            {
                                                <div class="col-md-4">
                                                    @foreach (var activity in activities.Skip(i * itemsPerColumn).ToList().Take(itemsPerColumn))
                                                    {
                                                        <div class="am-checkbox">
                                                            <input type="checkbox" id="activity-@activity.ID" name="activity-@activity.ID" value="1" />
                                                            <label for="activity-@activity.ID">@activity.Name</label>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                <div class="form-group">
                                    <label for="list" class="col-md-12">Custom Invite Message (optional)</label>
                                    <div class="col-md-12">
                                        <textarea name="invitemessage" id="invitemessage" style="width: 100%" rows="5" class="form-control"></textarea>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <button type="submit" class="btn btn-primary btn-lg btn-block">Send Invites &raquo;</button>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </form> 
        </div>
    </div>
</div>

<script>
    function selectList() {
        if ($('#list').val() == '0') {
            location.href = '@Url.Action("add", "contact", new { returnUrl = Url.Action("inviteto", "contact", new { id = id, type = type }) })'
        } 
    }
</script>