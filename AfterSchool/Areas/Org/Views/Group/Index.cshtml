@model List<AfterSchoolLibrary.Models.ActivityGroup>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var activityGroupType = (ActivityGroupType)ViewBag.ActivityGroupType;
    var controller = ViewBag.GroupController;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <div class="pull-right">
                <a class="btn btn-primary btn-space" href="@Url.Action("edit", controller, new { isnew = 1 })">
                    <i class="icon icon-left s7-plus"></i>
                    Add @UILabel.ActivityGroupLabel(activityGroupType)
                </a>
            </div>
            <i class="s7-note2"></i> @UILabel.ActivityGroupLabel(activityGroupType, true)
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityGroups.cshtml", Model); }
        </div>
    </div>
</div>

