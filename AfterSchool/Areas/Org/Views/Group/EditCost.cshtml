@model ActivityGroup
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var canProcessPayments = Model.GetAccount().CanProcessPayments();

    var isFullScreen = (bool)ViewBag.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_ActivityGroupHeader"); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", "");
            }
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editcost", "group", new { id = Model.Uid, isnew = Request["isnew"] })" class="form-horizontal">


                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editcost", "next", true, true, Request))
                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(true, false, !canProcessPayments))

                    @{Html.RenderPartial("_GroupPayment", Model);}


                    <div class="form-group">
                        <div class="col-sm-6 col-sm-offset-3">
                            <div>@Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, false, !canProcessPayments))</div>
                        </div>
                        <div class="col-sm-3">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editcost", canProcessPayments ? "next" : "onlynext", false, true, Request))
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("_GroupEditNav", Model); }
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="processPayments" tabindex="-1" role="dialog" aria-labelledby="processPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-center" style="padding-top: 5px;">
                <p>Your account must be able to process payments in order to edit the cost</p>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $(document).on('click', '.disabled', function (event) {
                event.preventDefault();
                $("#processPayments").modal('show');
            })
        })
    </script>
  
}