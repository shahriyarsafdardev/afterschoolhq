@model ActivityGroup
@{
    ViewBag.Title = "Activities";
    var msgs = (SystemMessages)ViewBag.Messages;
    var activities = (List<Activity>)ViewBag.Activities;
    var hasArchivedActivities = (bool)ViewBag.HasArchivedActivities;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{ Html.RenderPartial("_ActivityGroupHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">

                @if (Model.ActivityGroupTypeId == ActivityGroupType.Session)
                {
                    <a class="btn btn-primary" href="@Url.Action("editsetup", "activity", new { group = Model.Uid, type = (int)ActivityType.Activity })">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel(Model.ActivityGroupTypeId)
                    </a>
                }
                else
                {
                    <button class="btn btn-primary btn-space md-trigger" data-modal="modal-quick-add">
                        Team Quick Add &raquo;
                    </button>
                    <div id="modal-quick-add" class="md-modal colored-header custom-width md-effect-9">
                        <form id="form-upgrade" action="@Url.Action("teamquickadd", "group", new { id = Model.Uid })" method="post">
                            <div class="md-content">

                                <div class="modal-header">
                                    <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                                    <h3 class="modal-title">Create a Team</h3>
                                </div>
                                <div class="modal-body form">
                                    <div class="form-group">
                                        <label class="control-label">Enter your team name</label>
                                        <input type="text" required id="teamname" name="teamname" class="form-control" placeholder="ex: Tigers" />
                                    </div>
                                    <div class="form-group">
                                        <label class="control-label">Enter the maximum number of players</label>
                                        <input type="number" required id="seatsavailable" name="seatsavailable" step="1" min="1" max="100" class="form-control" placeholder="ex: 15" />
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Create Team &raquo;</button>
                                </div>
                            </div>
                        </form>
                    </div>
                }

            </div>

            @{Html.RenderPartial("_ActivityGroupTitle", Model.Name); }
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">

            @{ Html.RenderPartial(
                       "~/Views/Shared/_Activities.cshtml",
                       activities,
                       new ViewDataDictionary() {
                            { "Account", SessionVariables.CurrentAccount },
                            { "AccountPackage", SessionVariables.AccountPackage },
                            { "PagingModel", ViewBag.PagingModel },
                            { "ShowRegistrationPeriodFilter", false },
                            { "Group", Model },
                            { "NeedToUpgrade", false },
                            { "HasArchivedActivities", hasArchivedActivities }
                           }
                       ); }
        </div>
    </div>
</div>
