@model ActivityGroup
@{
    var msgs = (SystemMessages)ViewBag.Messages;

    var registrations = (List<Registration>)ViewBag.Registrations;
    var account = (Account)ViewBag.Account;
    var paging = (PagingModel)ViewBag.PagingModel;
    var reservedSeats = (int)ViewBag.ReservedSeats;
    var waitingListSeats = (int)ViewBag.WaitingListSeats;
    var applicationSeats = (int)ViewBag.ApplicationSeats;
    var returnUrl = ViewBag.ReturnUrl;

    decimal totalPaid = 0;
    if (registrations.Where(x => x.DatePaid.HasValue).Count() > 0)
    {
        totalPaid = registrations.Where(x => x.DatePaid.HasValue).Sum(x => x.AmountPaid.Value);
    }

    var btnNotifyDisabled = "";
    if(registrations.Count() == 0)
    {
        btnNotifyDisabled = " disabled=\"disabled\" ";
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_ActivityGroupHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("_ActivityGroupTitle", Model.Name); }

            <div class="pull-right">
                
            </div>
        </div>
        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@reservedSeats" data-decimals="0" data-suffix="" class="value">@reservedSeats</div>
                            <div class="desc">Reserved Seats</div>
                        </div>
                        <div class="icon"><span class="s7-users"></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@waitingListSeats" data-decimals="0" data-suffix="" class="value">@waitingListSeats</div>
                            <div class="desc">Waiting List Seats</div>
                        </div>
                        <div class="icon"><span class="s7-users"></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@applicationSeats" data-decimals="0" data-suffix="" class="value">@applicationSeats</div>
                            <div class="desc">Seats Applied For</div>
                        </div>
                        <div class="icon"><span class="s7-users"></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                            <div class="desc">Total Paid</div>
                        </div>
                        <div class="icon"><span class="s7-cash"></span></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="pull-right">
                        <button onclick="location.href='@Url.Action("addregistration", "group" , new { id = Model.Uid })'" class="btn btn-primary btn-space">
                            Add Student
                        </button>

                        <button class="btn btn-default md-trigger btn-space" data-modal="modal-emails">
                            Send Registration Report
                        </button>

                        <button type="button" onclick="notifyAll()" class="btn btn-default btn-space md-trigger" data-modal="modal-confirmation" @btnNotifyDisabled>
                            Email Registration Details to @UILabel.RegistrantLabel(true)
                        </button>

                    </div>
                </div>
            </div>

            <div class="row hide">
                <div class="col-md-12">
                    <a href="@Url.Action("downloadregistrations", "group", new { id = Model.Uid })" class="btn btn-default btn-space hide"><i class="icon icon-left s7-download"></i> Download Registration Data</a>
                    <button type="button" onclick="notifyAll()" class="btn btn-default btn-space md-trigger" data-modal="modal-confirmation" @btnNotifyDisabled>Notify All @UILabel.RegistrantLabel(true)</button>
                    <a href="@account.HomePageUrl?group=@Model.Uid.ToString()" class="btn btn-default btn-space" target="_blank">Add New Registration</a>
                </div>
            </div>

            @{ Html.RenderPartial("_Registrations", registrations, new ViewDataDictionary() {
               { "NavAction", "registrations" },
               { "NavController", "group" },
               { "NavId", Model.Uid },
               { "EditAction", "edit" },
               { "EditController", "registration" },
               { "Account", account },
               { "Paging", paging },
               { "ReturnUrl", returnUrl }
            });}

        </div>
    </div>
</div>

@{
    Html.RenderPartial(
        "_EmailRegistrationReportModal",
        account,
        new ViewDataDictionary()
        {
            { "PostAction", "EmailRegistrationReport" },
            { "PostController", "group" },
            { "PostId", Model.Uid }
        }
    );
}

<div id="modal-confirmation" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-offer" action="" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title"><i class="s7-attention"></i> Confirmation</h3>
            </div>
            <div class="modal-body form">

                <p>Are you sure you want to <span id="confirmation-action"></span>?</p>
                <p id="confirmation-additional-text"></p>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">No</button>
                <a href="#" class="btn btn-primary" id="btnconfirm">Yes</a>
            </div>
        </div>
    </form>
</div>

<script>
    function notifyAll() {
        $('#confirmation-action').html('<strong>notify all @UILabel.RegistrantLabel(true).ToLower()</strong>');
        $('#confirmation-additional-text').html('All @UILabel.RegistrantLabel(true).ToLower() will receive an email of their current registrations.');
        $('#btnconfirm').attr('href', '@Url.Action("notifyall", "group", new { id = Model.Uid })');
    }
</script>
