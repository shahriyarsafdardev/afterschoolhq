@model ActivityGroup
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;

    var registrants = (List<Registrant>)ViewBag.Registrants;
    var registrantsPerColumn = Math.Ceiling(registrants.Count / 3.0).ToInteger();
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_ActivityGroupHeader", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("_ActivityGroupTitle", Model.Name + " - Send Message"); }
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("messageadd", "group", new { id = Model.Uid })" class="form-horizontal">

                @if (registrants.Count == 0)
                {
                    <div>
                        <a href="@Url.Action("messages", "group", new { id = Model.Uid })" class="btn btn-default pull-right">&laquo; Back to List</a>
                        <p>There are no @UILabel.RegistrantLabel(true).ToLower() with valid email addresses</p>
                    </div>
                }
                else
                {

                    <div class="form-group" id="subject-group">
                        <label class="col-sm-3 control-label">Message Reason</label>
                        <div class="col-sm-6">
                            <select name="subject" id="subject" class="form-control">
                                <option value="">Select a Message Reason...</option>
                                @foreach (var reason in Enum.GetValues(typeof(ActivityMessageReason)).Cast<ActivityMessageReason>().Except(ActivityMessageReason.NotSet.AsList()).OrderBy(x => x.ToString()))
                                {
                                    <option value="@reason.ToString().SplitByUpperCase()">@reason.ToString().SplitByUpperCase()</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">Message Body</label>
                        <div class="col-sm-6">
                            <textarea name="body" id="body" required style="width: 100%" rows="5" class="form-control"></textarea>
                            <p class="text-muted">Max of 1000 characters</p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-6">
                            <div class="am-checkbox">
                                <input type="checkbox" id="sendtostaff" name="sendtostaff" value="1" checked="checked" />
                                <label for="sendtostaff">Send Message To Staff</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-3">
                            <div class="am-checkbox">
                                <input type="checkbox" id="parentsonly" name="parentsonly" value="1" />
                                <label for="parentsonly">Send to Parents Only</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">
                            Select @UILabel.RegistrantLabel(true)<br />
                            <a href="javascript:selectAll()">Select All</a> | <a href="javascript:clearAll()">Clear All</a>
                        </label>
                        <div class="col-sm-6">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="col-md-4">
                                    @foreach (var registrant in registrants.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                                    {
                                        <div class="am-checkbox registrant"
                                             data-has-email="@registrant.Email.IsNotEmpty().ToInteger()"
                                             data-has-phone-number="@registrant.Phone.IsNotEmpty().ToInteger()">

                                            <input type="checkbox"
                                                   class="chk-registrant"
                                                   id="registrant-@registrant.ID"
                                                   name="registrant-@registrant.ID"
                                                   value="1"
                                                   checked="checked" />

                                            <label for="registrant-@registrant.ID">
                                                @registrant.DisplayName.MaxChars(20, "...")
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-6">
                            <div class="pull-left">
                                <a href="@Url.Action("messages", "group", new { id = Model.Uid })" class="text-muted">
                                    &laquo; Cancel
                                </a>
                            </div>
                            <div class="pull-right">
                                <button id="send-btn" type="submit" class="btn btn-primary btn-lg btn-block pull-right">
                                    <i class="s7-mail"></i> Send Message to Selected Registrants &raquo;
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </form>
        </div>
    </div>

</div>

<script>
    function selectAll() {
        $('input[type="checkbox"].chk-registrant').each(function () {
            $(this).prop('checked', true);
        });
    }
    function clearAll() {
        $('input[type="checkbox"].chk-registrant').each(function () {
            $(this).prop('checked', false);
        });
    }
</script>