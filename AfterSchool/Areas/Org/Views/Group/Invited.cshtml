@model ActivityGroup
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var paging = (PagingModel)ViewData["PagingModel"];
    var contacts = (List<RegistrantActivityGroup>)ViewBag.Contacts;
    var account = (Account)ViewBag.Account;

    var previousLink = "#";
    var nextLink = "#";
    if (paging.IsNotEmpty())
    {
        if (paging.PageNumber > 1)
        {
            previousLink = Url.Action("invited", "group", new { pn = paging.PageNumber - 1, rpp = Request["rpp"] });
        }
        if (paging.PageNumber < paging.TotalPages)
        {
            nextLink = Url.Action("invited", "group", new { pn = paging.PageNumber + 1, rpp = Request["rpp"] });
        }
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_ActivityGroupHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("_ActivityGroupTitle", string.Format("{0} - Invitations", Model.Name)); }
        </div>
        <div class="panel-body">

            <div class="row hide">
                <div class="pull-right">
                    <button class="btn btn-primary btn-space margin-r-10 md-trigger" data-modal="modal-add">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.RegistrationPeriodLabel()
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (contacts.Count > 0)
                        {
                            foreach (var contact in contacts)
                            {
                                <tr>
                                    <td>@contact.RegistrantName</td>
                                    <td>@contact.RegistrantEmail</td>
                                    <td>@contact.Status</td>
                                    <td>
                                        <button 
                                                type="button" 
                                                class="btn btn-default btn-sm md-trigger" 
                                                data-modal="modal-urls" 
                                                onclick="showUrls('@contact.GetInviteUrl()','@contact.GetDeclineUrl()')">
                                            View Invite Urls
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">You haven't invited any contacts</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>

            @if (paging.IsNotEmpty() && paging.TotalCount > 0)
            {
                <div class="row">
                    <div class="col-md-6">
                        Showing @paging.StartingRecord - @paging.EndingRecord of @paging.TotalCount
                    </div>
                    <div class="col-md-6">
                        <div class="btn-group pull-right">
                            <a class="btn btn-default" href="@previousLink">Previous</a>
                            @for (var i = 1; i <= paging.TotalPages; i++)
                            {
                                <a class="btn btn-default" href="@Url.Action("invited", "group", new { pn = i, rpp = Request["rpp"] })">@i</a>
                            }
                            <a class="btn btn-default" href="@nextLink">Next</a>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<div id="modal-urls" class="md-modal colored-header custom-width md-effect-9">
    <form>
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title"><i class="s7-edit"></i> Invite Urls</h3>
            </div>
            <div class="modal-body form">
                <div class="form-group">
                    <label class="col-sm-12 control-label">Invite Url</label>
                </div>
                <div class="form-group">
                    <div class="col-sm-12">
                        <input type="text" id="invite-url" onclick="this.select()" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-body form">
                <div class="form-group">
                    <label class="col-sm-12 control-label">Decline Url</label>
                </div>
                <div class="form-group">
                    <div class="col-sm-12">
                        <input type="text" id="decline-url" onclick="this.select()" class="form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-body form">

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-primary md-close">Close</button>
            </div>
        </div>
    </form>
</div>

<script>
    function showUrls(inviteUrl, declineUrl) {
        $('#invite-url').val(inviteUrl);
        $('#decline-url').val(declineUrl);
    }
</script>