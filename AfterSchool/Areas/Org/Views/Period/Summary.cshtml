@model RegistrationPeriod
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var actions = (List<WebSessionAction>)ViewBag.Actions;
    var registrations = (List<Registration>)ViewBag.Registrations;

    decimal totalPaid = 0;
    int registrationCount = registrations.Count();
    var activityCount = Model.GetActivityCount();

    if (registrations.Where(x => x.DatePaid.HasValue).Count() > 0)
    {
        totalPaid = registrations.Where(x => x.DatePaid.HasValue).Sum(x => x.AmountPaid.Value);
    }

    var dates = registrations.Select(x => SessionVariables.CurrentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString()).Distinct();

    var addUrl = Url.Action("editsetup", "activity", new { period = Model.ID });
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{ Html.RenderPartial("_RegistrationPeriodHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("_RegistrationPeriodTitle", Model.Name); }
        </div>
        <div class="panel-body">

            @if (activityCount == 0)
            {
                <div class="widget">
                    <div class="widget-head">
                        <h1>@Model.Name</h1>
                    </div>
                    <div class="widget-tile">
                        <hr />
                        <p>Welcome, @SessionVariables.CurrentUser.FirstName!</p>
                        <p>You haven't created any @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower() for @Model.Name yet. In order to get started, <a href="@addUrl">add your first @UILabel.ActivityLabel().ToLower()</a> for @Model.Name.</p>
                        <p>&nbsp;</p>
                        <p>
                            <a href="@addUrl" class="btn btn-primary btn-lg">Add Your First @UILabel.ActivityLabel() &raquo;</a>
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-8">
                        <div class="col-md-6">
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-toggle="counter" data-end="@registrationCount" data-decimals="0" data-suffix="" class="value">@registrationCount</div>
                                    <div class="desc">Total @UILabel.RegistrantLabel(true)</div>
                                </div>
                                <div class="icon"><span class="s7-users"></span></div>
                            </div>
                        </div>
                        <div class="col-md-6">

                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                                    <div class="desc">Total Paid</div>
                                </div>
                                <div class="icon"><span class="s7-cash"></span></div>
                            </div>

                        </div>

                        @if (registrationCount > 0)
                        {
                            <div class="col-md-12">

                                <div class="panel panel-default">
                                    <div class="panel-heading">
                                        Registrations By Date
                                    </div>
                                    <div class="panel-body">
                                        <div id="registrantsbydate" style="height: 350px;"></div>
                                    </div>
                                </div>

                            </div>
                        }

                    </div>

                    <div class="col-md-4">

                        <div class="panel">
                            <div class="panel-heading">
                                Latest Activity
                            </div>
                            <div class="panel-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        @if (actions.Count > 0)
                                        {
                                            var day = "";

                                            foreach (var action in actions)
                                            {
                                                if (day != action.CreateDate.Value.ToLongDateString())
                                                {
                                                    day = action.CreateDate.Value.ToLongDateString();

                                                    <tr>
                                                        <td colspan="2" class="text-nowrap bg-primary">
                                                            @day
                                                        </td>
                                                    </tr>
                                                }

                                                <tr>
                                                    <td class="text-nowrap">@SessionVariables.CurrentAccount.ConvertToAccountTimeZone(action.CreateDate.Value).ToShortTimeString()</td>
                                                    <td>@action.ToString()</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="2">There is no recent activity</td>
                                            </tr>
                                        }

                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }

        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        new Morris.Bar({
            // ID of the element in which to draw the chart.
            element: 'registrantsbydate',
            // Chart data records -- each entry in this array corresponds to a point on
            // the chart.
            data: [
                @foreach(var date in dates){
                    @:{ date: '@date', value: @registrations.Where(x => SessionVariables.CurrentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString() == date).Count() },
                }
            ],
            // The name of the data record attribute that contains x-values.
            xkey: 'date',
            // A list of names of data record attributes that contain y-values.
            ykeys: ['value'],
            // Labels for the ykeys -- will be displayed when you hover over the
            // chart.
            labels: ['Registrations'],
            resize: true,
            barColors: ['#3d3c3c']
        });
    });



</script>
