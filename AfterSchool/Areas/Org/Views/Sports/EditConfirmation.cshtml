@model ActivityGroup
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var isFullScreen = (bool)ViewBag.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

    <div class="main-content">

        @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

        @{ Html.RenderPartial("_ActivityGroupHeader"); }

        <div class="panel panel-default">
            <div class="panel-heading">
                @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }

                @if (isFullScreen)
                {
                    Html.RenderPartial("_ExitFullScreen", "");
                }
            </div>
            <div class="panel-body">

                <div class="col-md-8 col-lg-9">
                    <form id="form1" method="post" action="@Url.Action("editconfirmation", "sports", new { id = Model.Uid, isnew = Request["isnew"] })" class="form-horizontal">

                        @if (!Model.IsPublished)
                        {
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editconfirmation", "publish", true, true, Request))
                        }
                        @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(true, false))

                        @{Html.RenderPartial("_SportsConfirmation", Model);}

                        <div class="form-group">
                            @if (!Model.IsPublished)
                            {
                                <div class="col-sm-6 col-sm-offset-3">
                                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, false))
                                </div>
                                <div class="col-sm-3">
                                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editconfirmation", "publish", false, true, Request))
                                </div>
                            }
                            else
                            {
                                <div class="col-sm-9 col-sm-offset-3">
                                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, false))
                                </div>
                            }
                        </div>

                    </form>
                </div>

                <div class="col-md-4 col-lg-3">
                    @{Html.RenderPartial("_SportsEditNav", Model); }
                </div>

            </div>
        </div>
    </div>


<script>

    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

</script>