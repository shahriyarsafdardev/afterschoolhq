@model Account
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    ViewBag.Title = "Getting Started";
}

<div>
    <div class="col-sm-12 col-md-8 col-lg-6 col-md-offset-2 col-lg-offset-3">
        <div class="panel panel-default" style="background-color: #f9fcfb; ">
            <div class="panel-heading" style="border-color: #90f0ec;">
                <img src="@UILabel.ProductLogoInverseAfterSchoolHQ()" alt="logo" width="350px" class="logo-img center-block">
            </div>         
            <div class="panel-body">
                <h1 style="text-align:center; font-weight: bold;">Welcome, @SessionVariables.CurrentUser.FirstName!</h1>
                <div class="text-medium-small">
                    <p class="padding-v-20">
                        Our platform gives you a central location to showcase your programs online allowing parents to easily discover, register, and pay for 
                        after-school @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()

                    </p>
                    <p class="padding-v-20">
                        Get started by creating your first @UILabel.ActivityLabel(ActivityType.Activity).ToLower().<span style="font-weight: bold">You are on your way to reducing clutter, increasing parent satisfaction, 
                            and increasing after-school safety and awareness.</span>
                    </p>
                    <p class="padding-v-20">
                        <div style="text-align:center">
                            <div class="">
                                <a href="@Url.Action("editsetup", "activity", new {isnew = 1, type = (int) ActivityType.Activity})" 
                                   class="btn btn-primary btn-lg" 
                                   style="border-radius:6px">
                                    Create Your First @UILabel.ActivityLabel(ActivityType.Activity) &raquo;
                                </a>
                            </div><br /><br />
                            <div class="">
                                <a href="@Url.Action("index", "activity")" class="text-muted text-small">Explore on my own</a>
                            </div>
                        </div>
                       
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#app-body').css('background-color', '#f9fcfb');
    });
</script>