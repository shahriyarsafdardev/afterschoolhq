@model Account
@using Utilities = AfterSchoolLibrary.Helpers.Utilities
@{
    var msgs = (SystemMessages) ViewBag.Messages;
    var registrations = (List<Registration>) ViewBag.CurrentRegistrations;
    var totalPaid = (decimal) ViewBag.TotalPaid;
    var registrationCount = (int) ViewBag.RegistrationCount;
    var activityCount = (int) ViewBag.ActivityCount;
    var dates = registrations.Where(x => x.CreateDate.HasValue)
        .GroupBy(x => Model.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString())
        .Select(group => new {Date = group.Key, Count = group.Count()});

    var classesCount = (int) ViewBag.TotalCompleted;
    var totalPresent = (int) ViewBag.TotalPresent;
    var totalPossible = (int) ViewBag.TotalPossible;
    var totalAbsent = totalPossible - totalPresent;
    var hasVisitorAccountsToApprove = (bool) ViewBag.HasVisitorAccountsToApprove;
    var hasOutstandingLeagueInvites = (bool) ViewBag.HasOutstandingLeagueInvites;
    var externalLeagueCount = (int) ViewBag.ExternalLeagueCount;
    var currentAccount = SessionVariables.CurrentAccount;
    var logoUrl = SessionVariables.CurrentAccount.GetAccountProfile().GetLogoUrl();
    logoUrl = logoUrl.IsNotEmpty() ? logoUrl : "";

    var attendanceRate = totalPresent > 0 ? (totalPresent.ToDouble() / (totalPresent + totalAbsent) * 100).Round(1).ToString("###.#") : "0";

    var addUrl = Url.Action("editsetup", "activity", new {isnew = 1, type = (int) ActivityType.Activity});
}

@{ Html.RenderPartial("OrgAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            Welcome @SessionVariables.CurrentUser.FirstName

            @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.ActivitiesEdit))
            {
                <div class="pull-right">
                    <a href="@Url.Action("editsetup", "activity", new {isnew = 1, type = (int) ActivityType.Activity})" class="btn btn-primary">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel()
                    </a>
                </div>
            }
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">

            @if (hasVisitorAccountsToApprove)
            {
                <div role="alert" class="alert alert-info alert-icon">
                    <div class="icon">
                        <span class="s7-check-circle"></span>
                    </div>
                    <div class="message">
                        <p class="text-center">
                            You have new providers requesting permission to post @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower() to your page. <a href="@Url.Action("visitors", "account")">Review providers</a>.
                        </p>
                    </div>
                </div>
            }

            @if (hasOutstandingLeagueInvites)
            {
                <div role="alert" class="alert alert-info alert-icon">
                    <div class="icon">
                        <span class="s7-check-circle"></span>
                    </div>
                    <div class="message">
                        <p class="text-center">
                            You have new invites to join leagues. <a href="@Url.Action("indexexternal", "league")">Review league invites</a>.
                        </p>
                    </div>
                </div>
            }

            @if (activityCount == 0)
            {
                <div class="col-md-6 col-sm-12">
                    <div class="widget">
                        <div class="widget-head">
                            <h1>@UILabel.ActivityLabel(ActivityType.Activity, true)</h1>
                        </div>
                        <div class="widget-tile">
                            <hr/>
                            <p>You haven't created any @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower() yet. In order to get started, <a href="@addUrl">create your first @UILabel.ActivityLabel().ToLower()</a>.</p>
                            <p>&nbsp;</p>
                            <p>
                                <a href="@addUrl" class="btn btn-primary btn-lg">Create Your First @UILabel.ActivityLabel() &raquo;</a>
                            </p>
                        </div>
                    </div>
                </div>

                if (externalLeagueCount > 0)
                {
                    <div class="col-md-6 col-sm-12">
                        <div class="widget">
                            <div class="widget-head">
                                <h1>Leagues</h1>
                            </div>
                            <div class="widget-tile">
                                <hr/>
                                @if (hasOutstandingLeagueInvites)
                                {
                                    <p>You have new invites to join leagues. <a href="@Url.Action("indexexternal", "league")">Review league invites</a>.</p>
                                }
                                else
                                {
                                    <p>You have league teams to manage.</p>
                                }
                                <p>&nbsp;</p>
                                <p>
                                    <a href="@Url.Action("indexexternal", "league")" class="btn btn-primary btn-lg">Manage your teams &raquo;</a>
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="row">
                    <div class="col-lg-8 col-md-12">
                        <div class="col-md-6">
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-end="@registrationCount" data-decimals="0" data-suffix="" class="value">@registrationCount</div>
                                    <div class="desc desc-mobile-width">Total Registrations (30 days)</div>
                                </div>
                                <div class="icon">
                                    <span class="s7-users"></span>
                                </div>
                            </div>
                        </div>

                        @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView))
                        {
                            <div class="col-md-6">
                                <div class="widget widget-tile widget-bordered">
                                    <div class="data-info">
                                        <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                                        <div class="desc">Total Earned</div>
                                    </div>
                                    <div class="icon">
                                        <span class="s7-cash"></span>
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="col-md-6">
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-toggle="counter" data-end="@classesCount" data-decimals="0" data-suffix="" class="value">@classesCount</div>
                                    <div class="desc">@UILabel.ActivityLabel() Meetings</div>
                                </div>
                                <div class="icon">
                                    <span class="s7-users"></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">

                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-end="@attendanceRate.IfBlank("0")" data-decimals="0" data-suffix="" class="value">@attendanceRate.IfBlank("0")%</div>
                                    <div class="desc">Attendance Rate</div>
                                </div>
                                <div class="icon">
                                    <span class="s7-check-circle"></span>
                                </div>
                            </div>

                        </div>

                        @if (registrationCount > 0)
                        {
                            <div class="col-md-12">

                                <div class="panel panel-default">
                                    <div class="panel-heading">
                                        Registrations By Date (last 30 days)
                                    </div>
                                    <div class="panel-body">
                                        <div id="registrantsbydate" style="height: 350px;"></div>
                                    </div>
                                </div>

                            </div>
                        }

                    </div>
                    @if (currentAccount.HasAccountPackageFeature(FeatureType.ManageCheckInCheckOut))
                    {
                        <div class="col-lg-4 col-md-12">
                            <div class="qr-heading">Check In/Out</div>
                            <div class="panel panel-default">
                                <div class="panel-body">
                                    <div id="qr-code" class="m-auto"></div>
                                </div>
                                <div class="margin-h-20">
                                    <a data-toggle="modal" data-target="#modal-fullscreen" class="btn btn-default">Full Screen</a>
                                    <a id="download-btn" class="btn btn-default">Download</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>
    </div>
</div>

@{
    Html.RenderPartial("_ModalQR", new ModalQRModel()
    {
        LogoUrl = logoUrl,
        AccountName = currentAccount.Name,
        ID = "modal-fullscreen",
    });
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js" integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSQX0FslNhTDadL4O5SAGapGt4FodqL8My0mA=="
        crossorigin="anonymous"
        referrerpolicy="no-referrer">
</script>
<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        new Morris.Bar({
            // ID of the element in which to draw the chart.
            element: 'registrantsbydate',
            // Chart data records -- each entry in this array corresponds to a point on
            // the chart.
            data: [
                @foreach (var date in dates)
                {
                    @:{ date: '@date.Date', value: @date.Count },
                }
            ],
            // The name of the data record attribute that contains x-values.
            xkey: 'date',
            // A list of names of data record attributes that contain y-values.
            ykeys: ['value'],
            // Labels for the ykeys -- will be displayed when you hover over the
            // chart.
            labels: ['Registrations'],
            resize: true,
            barColors: ['#3d3c3c']
        });
    });

    const downloadBtn = document.querySelector("#download-btn");
    const qrCode = document.querySelector("#qr-codes");

    function downloadQR() {
        const qrCanvas = document.querySelector("#qr-code canvas");
        const qrDataURL = qrCanvas.toDataURL("image/png");

        const link = document.createElement("a");
        link.href = qrDataURL;
        link.download = "qr-code.png";
        link.click();
    }

    function generateQrCode() {
        const url = "@Utilities.BaseUrl()/reactapp/check-in-out/@currentAccount.UniqueName";

        new QRCode(document.getElementById("qr-code"), {
                text: url,
                height: 200,
                width: 200
            });
        new QRCode(document.getElementById("modal-qr-code"), {
            text: url,
            height: 350,
            width: 350
        });
    }

    if ('@currentAccount.HasAccountPackageFeature(FeatureType.ManageCheckInCheckOut)'.toLowerCase() === 'true') {
        generateQrCode();
        downloadBtn.addEventListener("click", downloadQR);
    }
</script>