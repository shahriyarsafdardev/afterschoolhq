@model Registration
@{
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;
    var registrant = (Registrant)ViewBag.Registrant;
    var registrations = (List<Registration>)ViewBag.Registrations;
    var selectedRegistration = (Registration)ViewBag.SelectedRegistration;
    var account = (Account)ViewBag.Account;    
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("_ActivityGroupTitle", Model.Name); }
        </div>
        <div class="panel-body">
        
            <div class="pull-right">
                <select name="r" id="r" class="form-control" onchange= "registrationChange(this.value)">
                    @foreach (var registration in registrations)
                    {
                        <option value="@registration.Uid"
                                @(registration.ID == selectedRegistration.ID ? "selected=\"selected\"" : "")>
                            Registration - @account.ConvertToAccountTimeZone(registration.CreateDate.Value).ToShortDateTimeString()
                        </option>
                    }
                </select>

            </div>

          
            <form id="form-add-reg" action="@Url.Action("update", "registration", new { id = Model.Uid })" class="form-horizontal" method="post" enctype="multipart/form-data">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnURl">
                @foreach (var group in qvms.Select(qvm => qvm.Question.GetFormQuestionGroup()).DistinctBy(group => group.ID).OrderBy(group => group.DisplayOrder))
                {
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            @group.Name
                        </div>
                        <div class="panel-body">
                            @foreach (var qvm in qvms.Where(qvm => qvm.Question.GetFormQuestionGroup().ID == group.ID))
                            {
                                Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                            }
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <div class="pull-left">
                            <a href="@Url.Action("edit", "registration", new { id = Model.Uid, returnUrl = ViewBag.ReturnURl })" class="text-muted">&laquo; Back</a>
                        </div>
                        <div class="btn-group pull-right">
                            <button type="submit" class="btn btn-primary btn-lg">Update @UILabel.RegistrantLabel() &raquo;</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    function registrationChange(id){
        console.log('registrationChange', id);
        let link = '@Url.Action("update", "registration", new { id = "ID" })?r=' + this.value + '&returnUrl=@Request["returnurl"]';
        link = link.replace("ID", id);
        console.log('Link', link);
        location.href = link;
    }
</script>
