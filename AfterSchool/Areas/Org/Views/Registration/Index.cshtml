@model AfterSchool.Areas.Org.Assemblers.Registration.RegistrationIndexResult
@{
    var msgs = Model.Messages;
    var paging = Model.PagingModel;
    var isStudentCrmEnabled = Model.IsStudentCrmEnabled;
    var studentCrmPackage = Model.StudentCrmPackage;
    var currentAccount = Model.CurrentAccount;
    var isVolunteer = Request.QueryString["Volunteers"];
    var returnUrlEditAction = isVolunteer.IsBool() && isVolunteer.ToBoolean() ? Url.Action("index", "registration", new
    {
        volunteers = "true",
    }) : Url.Action("index", "registration");
}

@{ Html.RenderPartial("OrgAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_RegistrationHeader"); }

    <div id="studentcrmcontainer" class="panel panel-default">
        <div class="panel-heading">
            @{
                if (isVolunteer.IsBool() && isVolunteer.ToBoolean())
                {
                    <i class="s7-smile"></i>
                    @UILabel.RegistrantLabel(ActivityType.VolunteerOpportunity, true)
                }
                else
                {
                    <i class="s7-id"></i>
                    @UILabel.RegistrantLabel(true)
                }
            }
        </div>
        <div class="panel-body">

            @{ Html.RenderPartial("_RegistrationSearchBar", new ViewDataDictionary
               {
                   {"Volunteer", isVolunteer},
                   {"Activities", Model.Activities},
                   {"Groups", Model.Groups},
                   {"Questions", Model.Questions},
                   {"QuestionGroups", Model.QuestionGroups},
                   {"IsReadOnly", Model.SearchBarReadOnly},
               }); }

            <div class="row">
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" onclick="doSearch()">Search</button>
                    <button class="btn btn-default md-trigger" data-modal="modal-emails">Email Report...</button>
                    <button class="btn btn-default" onclick="sendMessages()">Send Messages &raquo;</button>
                </div>
            </div>

            @{
                Html.RenderPartial("_Registrations", Model.Registrations, new ViewDataDictionary
                {
                    {"NavAction", "index"},
                    {"NavController", "registration"},
                    {"NavId", ""},
                    {"EditAction", "edit"},
                    {"EditController", "registration"},
                    {"Account", currentAccount},
                    {"Paging", paging},
                    {"ReturnUrl", returnUrlEditAction},
                });
            }

        </div>
    </div>
</div>

@{ Html.RenderPartial("_EmailRegistrationReportModal", currentAccount, new ViewDataDictionary {{"PostAction", "emailreport"}, {"PostController", "registration"}, {"PostId", ""}}); }

@section scripts
{
    <script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (!@(isStudentCrmEnabled.ToString().ToLower())) {
            $("#studentcrmcontainer").find("button").addClass("disabled");
            $("#studentcrmcontainer").find("a").addClass("disabled");
            $("#studentcrmcontainer").find("input").addClass("disabled");
            $("#studentcrmcontainer").find("a").on("click", function (e) {
                e.preventDefault();
            });
            showUpgradeMyPlan('@(studentCrmPackage?.Name)','@(studentCrmPackage?.ID)',true)
        }
    });
    </script>
    <script>

        function sendMessages() {
            location.href = `@Url.Action("messageadd", "registration")?${isVolunteer()}&${getQuery()}&${getActivityOrGroup()}${getFilterQuestionQS()}&${getRegStatus()}&${getAssignmentType()}`; 
        }

        function doSearch(){
            location.href = `@Url.Action("index", "registration")?${isVolunteer()}&${getQuery()}&${getActivityOrGroup()}${getFilterQuestionQS()}&${getRegStatus()}&${getAssignmentType()}`;
        }
    </script>
}