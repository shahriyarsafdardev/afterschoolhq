@model List<Registration>
@{
    var msgs = (SystemMessages) ViewBag.Messages;
    var paging = (PagingModel) ViewBag.PagingModel;
    var studentCRMEnabled = SessionVariables.CurrentAccount.HasFeature(FeatureType.StudentCRM);
    var studentCRMPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.StudentCRM, SessionVariables.AccountPackage);
}

@{ Html.RenderPartial("OrgAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_RegistrationHeader"); }

    <div id="studentcrmcontainer" class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-id"></i> @UILabel.RegistrantLabel(true)
        </div>
        <div class="panel-body">

            @{ Html.RenderPartial("_RegistrationSearchBar"); }

            <div class="row">
                <div class="col-md-12">
                    <button type="button" class="btn btn-primary" onclick="doSearch()">Search</button>
                    <button class="btn btn-default md-trigger" data-modal="modal-emails">Email Report...</button>
                    <button class="btn btn-default" onclick="sendMessages()">Send Messages &raquo;</button>
                </div>
            </div>

            @{ Html.RenderPartial("_Registrations", Model, new ViewDataDictionary
               {
                   {"NavAction", "index"},
                   {"NavController", "registration"},
                   {"NavId", ""},
                   {"EditAction", "edit"},
                   {"EditController", "registration"},
                   {"Account", SessionVariables.CurrentAccount},
                   {"Paging", paging},
                   {"ReturnUrl", Url.Action("index", "registration")},
               }); }

        </div>
    </div>
</div>

@{ Html.RenderPartial("_EmailRegistrationReportModal", SessionVariables.CurrentAccount, new ViewDataDictionary {{"PostAction", "emailreport"}, {"PostController", "registration"}, {"PostId", ""}}); }

@section scripts
{
    <script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (!@(studentCRMEnabled.ToString().ToLower())) {
            $("#studentcrmcontainer").find("button").addClass("disabled");
            $("#studentcrmcontainer").find("a").addClass("disabled");
            $("#studentcrmcontainer").find("input").addClass("disabled");
            $("#studentcrmcontainer").find("a").on("click", function (e) {
                e.preventDefault();
            });
            showUpgradeMyPlan('@(studentCRMPackage?.Name)','@(studentCRMPackage?.ID)',true)
        }
    });
    </script>
    <script>

        function sendMessages() {
            location.href = `@Url.Action("messageadd", "registration")?${getQuery()}&${getActivityOrGroup()}${getFilterQuestionQS()}&${getRegStatus()}&${getAssignmentType()}`;
        }

        function doSearch(){
            location.href = `@Url.Action("index", "registration")?${getQuery()}&${getActivityOrGroup()}${getFilterQuestionQS()}&${getRegStatus()}&${getAssignmentType()}`;
        }
    </script>
}