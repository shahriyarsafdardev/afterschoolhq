@model ActivityMessage
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;

    var amrs = (List<ActivityMessageRegistrant>)ViewBag.Registrants;
    var registrantsPerColumn = 0;

    if (amrs.IsNotEmpty())
    {
        registrantsPerColumn = Math.Ceiling(amrs.Count / 3.0).ToInteger();
    }
    var viewBagIsVolunteer = false;

    if (ViewBag.Volunteers != null)
    {
        viewBagIsVolunteer = (bool)ViewBag.Volunteers;
    }

    var isVolunteers = Request.QueryString["volunteers"] == "true" || viewBagIsVolunteer;
    var routeValues = isVolunteers ? new { volunteers = "true" } : null;
    var body = Model.Body;
    int startIndex = body.IndexOf("<div class=\"attachments text-left\">");
    var attachments = "";
    var bodyText = "";
    if (startIndex != -1)
    {
        attachments = body.Substring(startIndex);
        bodyText = body.Substring(0, startIndex);
    }
}

@{ Html.RenderPartial("OrgAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_RegistrationHeader"); }

    <div class="panel panel-default">
        <div class="panel-heading">
            Message
            <a href="@Url.Action("messages", "registration", routeValues)" class="btn btn-default pull-right">&laquo; Back to List</a>
        </div>
        <div class="panel-body form-body">
            <div class="col-md-10 col-md-offset-1">
                <div class="row">
                    <div class="btn-group pull-right">
                        @if (Model.GetUnsentCount() > 0)
                        {
                            <button class="btn btn-default md-trigger hide" data-modal="resend-confirm" onclick="setResendLink()">
                                <i class="s7-paper-plane"></i>
                                Resend Message to Unreached Recipients
                            </button>
                        }
                    </div>
                </div>

                <form method="post" action="@Url.Action("messageadd", "registration", routeValues)" class="form-horizontal">

                    <div class="form-group">
                        <label class="control-label text-bold">Subject<span class="text-danger">*</span></label>
                        <div>
                            @Model.Subject
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label text-bold">Body<span class="text-danger">*</span></label>
                        <div>
                            @Html.Raw(@bodyText.IsNotEmpty() ? bodyText.Replace("\n", "<br />") : body.Replace("\n", "<br />"))
                        </div>
                    </div>

                     <div class="form-group">
                        <label class="control-label text-bold">Attachment(s)</label>
                        <div>
                            @Html.Raw(attachments)
                        </div>
                     </div>

                    <div class="form-group">
                        <label class="control-label text-bold">Sent By</label>
                        <div>
                            @Model.GetCreatedBy().DisplayName
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label text-bold">Sent to Staff</label>
                        <div>
                            @Model.SendToStaff.ToYesNo()
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="control-label text-bold">Sent only to parents of selected students</label>
                        <div>
                            @Model.ParentsOnly.ToYesNo()
                        </div>
                    </div>

                    @if (Model.DateSent.HasValue)
                    {
                        <div class="form-group">
                            <label class="control-label text-bold">Date Sent</label>
                            <div>
                                @SessionVariables.CurrentAccount.ConvertToAccountTimeZone(Model.DateSent.Value).ToLongDateTimeString()
                            </div>
                        </div>
                    }
                    @if (amrs.IsNotEmpty())
                    {
                        <div class="form-group">
                            <label class="control-label text-bold">
                                    Recipients
                            </label>
                            <div>
                                @for (int i = 0; i < 3; i++)
                                {
                                    <div class="col-md-4">
                                        @foreach (var amr in amrs.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                                        {
                                            <div>
                                                @if (amr.DateSent.HasValue)
                                                {
                                                    <i class="s7-check-circle text-success text-bold"></i>
                                                }
                                                else
                                                {
                                                    <i class="s7-close-circle text-danger text-bold"></i>
                                                }
                                                @amr.RegistrantDisplayName
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                </form>
            </div>
        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".download-link").forEach(function (link) {
            link.addEventListener("click", function () {
                var fileLinks = document.querySelectorAll(".file-link");
                fileLinks.forEach(function (fileLink) {
                    var url = fileLink.href;
                    var fileName = fileLink.getAttribute("data-file-name");
                    downloadFile(url, fileName);
                });
            });
        });
    });
    function downloadFile(url, fileName) {
        fetch(url)
            .then(response => response.blob())
            .then(blob => {
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = fileName;
                a.style.display = "none";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            });
    }
    function setResendLink() {
        $('#btn-confirm').attr('href', '@Url.Action("messagesresend", "registration", new { id = Model.ID })');
    }
</script>

@{
    Html.RenderPartial(
        "~/Views/Shared/_Modal.cshtml",
        new ModalViewModel()
        {
            ID = "resend-confirm",
            Title = "Confirm",
            HtmlBody = "Are you sure? This will sent an email to all recipients who did not receive an email previously.",
            ActionButtonHtml = "Send Message &raquo;",
            ActionButtonId = "btn-confirm"
        }
        );
}