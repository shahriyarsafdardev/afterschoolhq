@model AfterSchoolLibrary.Registration
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var registrant = (Registrant)ViewBag.Registrant;
    var account = (Account)ViewBag.Account;
    var answers = (List<FormQuestionAnswer>)ViewBag.Answers;
    var registrantActivities = (List<RegistrantActivity>)ViewBag.RegistrantActivities;
    var activities = (List<Activity>)ViewBag.Activities;
    var registrations = (List<Registration>)ViewBag.Registrations;
    var listUrl = ViewBag.ListUrl;
    var selectedRegistration = (Registration)ViewBag.SelectedRegistration;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_RegistrationHeader", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-id"></i> @UILabel.RegistrantLabel() Detail
        </div>
        <div class="panel-body">

            <div class="col-md-10 col-md-offset-1">

                <div class="panel panel-default">
                    <div class="panel-heading">
                        
                        <div class="pull-right">
                            <select name="r" id="r" class="form-control" onchange="location.href='@Url.Action("edit", "registration", new { id = Model.Uid })?r=' + this.value + '&returnUrl=@Request["returnurl"]'">
                                @foreach (var registration in registrations)
                                {
                                    <option 
                                            value="@registration.Uid" 
                                            @(registration.ID == selectedRegistration.ID ? "selected=\"selected\"" : "")>
                                            Registration - @account.ConvertToAccountTimeZone(registration.CreateDate.Value).ToShortDateTimeString()
                                    </option>
                                }
                            </select>
                        </div>

                        @registrant.Name
                    </div>
                    <div class="panel-body">

                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Registration Data
                            </div>
                            <div class="panel-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <tr>
                                            <td class="text-right" width="33%">Registration Date/Time</td>
                                            <td>@account.ConvertToAccountTimeZone(selectedRegistration.CreateDate.Value).ToLongDateTimeString()</td>
                                        </tr>
                                        <tr class="hide">
                                            <td class="text-right">@UILabel.RegistrantLabel() Link to Add Activities</td>
                                            <td><a href="@selectedRegistration.AddToRegistrationUrl" target="_blank">@selectedRegistration.AddToRegistrationUrl</a></td>
                                        </tr>
                                    </table>
                                </div>

                                @foreach (var group in answers.Select(x => x.ToFormQuestionGroup()).DistinctBy(x => x.QuestionGroupDataTypeId).OrderBy(x => x.DisplayOrder))
                                {
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            <thead>
                                                <tr>
                                                    <th colspan="2">@group.Name</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var answer in answers.Where(x => x.FormQuestionGroupQuestionGroupDataTypeId == group.QuestionGroupDataTypeId).OrderBy(x => x.FormQuestionDisplayOrder))
                                                {
                                                    <tr>
                                                        <td valign="top" width="33%" class="text-right">@answer.FormQuestionText</td>
                                                        <td valign="top">
                                                            @if (answer.FormQuestionQuestionTypeId == QuestionType.Checkbox)
                                                            {
                                                                @answer.Text.IfBlank("0").ToBoolean().ToYesNo();
                                                            }
                                                            else if(answer.FormQuestionQuestionTypeId == QuestionType.RadioMatrix)
                                                            {
                                                                foreach(var item in answer.Text.Split(';'))
                                                                {
                                                                    @:@item.Split('=')[0]: @item.Split('=')[1]<br />
                                                                }
                                                            }
                                                            else
                                                            {
                                                                @answer.Text.IfBlank("-")
                                                            }

                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }

                            </div>
                        </div>

                        @foreach (var ra in registrantActivities.OrderBy(x => x.Day))
                        {
                            var activity = ra.ToActivity(true);
                            var dayText = ra.Day.ToString();
                            
                            if (ra.ActivityScheduleRequiresAllDays)
                            {
                                dayText = activity.GetDaysOfTheWeek().Select(x => x.ToString()).ToStringList(", ", " and ");
                            }
                            
                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    <div class="btn-group pull-right">
                                        <button class="btn btn-default md-trigger" data-modal="modal-move-seat" onclick="moveSeat(@ra.ID, @((int)ra.RegistrationAssignmentTypeId))"><i class="s7-gleam"></i> <span>Move Seat</span></button>
                                        <button class="btn btn-default md-trigger" data-modal="modal-confirmation-activity" onclick="deleteActivity(@ra.ActivityId, '@UI.JavascriptSafeString(ra.ActivityName)')"><i class="s7-trash text-danger"></i> <span class="text-danger">Delete</span></button>
                                    </div>
                                    <a href="@Url.Action("summary", "activity", new { id = activity.Uid })">@activity.ToFullDescription()</a>                                    
                                </div>
                                <div class="panel-body">
                                    <div class="table-responsive">
                                        <table class="table table-striped">
                                            @if(ra.Day != DayOfWeekASL.NotSet)
                                            {
                                                <tr>
                                                    <td width="33%" class="text-right">Day</td>
                                                    <td>@dayText</td>
                                                </tr>
                                            }
                                            @if (account.HasFeature(FeatureType.ManageActivityGroups) && ra.PreferenceNumber.HasValue)
                                            {
                                                <tr>
                                                    <td class="text-right">Choice Number</td>
                                                    <td>@ra.PreferenceNumber.Value.ToOrdinal() Choice</td>
                                                </tr>
                                            }    
                                            <tr>
                                                <td width="33%" class="text-right">Status</td>
                                                <td>@ra.RegistrationAssignmentTypeId.ToString().SplitByUpperCase()</td>
                                            </tr>
                                            @if (ra.AssignmentSeatIndex.HasValue)
                                            {
                                                <tr>
                                                    <td width="33%" class="text-right">Seat</td>
                                                    <td>@ra.AssignmentSeatIndex</td>
                                                </tr>
                                            }
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div id="modal-confirmation-activity" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-offer" action="" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title"><i class="s7-attention"></i> Confirmation</h3>
            </div>
            <div class="modal-body form">

                <p>Are you sure you want to <span id="confirmation-activity-action"></span>?</p>
                <p id="confirmation-activity-additional-text"></p>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">No</button>
                <a href="#" class="btn btn-primary" id="btnconfirm-activity">Yes</a>
            </div>
        </div>
    </form>
</div>

<div id="modal-move-seat" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-move-seat" action="" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title"><i class="s7-gleam"></i> Move Seat</h3>
            </div>
            <div class="modal-body form">

                <div class="form-group">
                    <label>Move to </label>
                    <select name="to" id="move-to" class="form-control" required> 
                    </select>
                </div>

                <input type="hidden" name="ra" id="activity-ra" value="" />

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary" id="btnconfirm-moveseat">Move @UILabel.RegistrantLabel() &raquo;</button>
            </div>
        </div>
    </form>
</div>


<script>
    function moveSeat(ra, rat) {
        $('#form-move-seat').attr('action', '@Url.Action("moveseat", "registration", new { id = Model.Uid.ToString(), r = selectedRegistration.Uid.ToString(), returnUrl = Request["returnurl"] })');
        $('#activity-ra').val(ra);
        $('#move-to').html('');
        @foreach (var item in Enum.GetValues(typeof(RegistrationAssignmentType)).Cast<RegistrationAssignmentType>().Where(x=>x != RegistrationAssignmentType.NotSet))
        {
            @:if(@((int)item) != rat){
            @:  $('#move-to').append('<option value="@((int)item)">@item.ToString().SplitByUpperCase()</option>');            
            @:}
        }
    }    

    function deleteActivity(activity, name) {
        $('#confirmation-activity-action').html('<strong>remove "' + name + '"</strong> from <strong>@selectedRegistration.ToRegistrant().Name</strong>');
        $('#confirmation-activity-additional-text').html('This cannot be undone');
        $('#btnconfirm-activity').attr('href', '@Url.Action("RemoveActivity", "registration", new { id = Model.Uid.ToString(), r = selectedRegistration.Uid.ToString(), returnUrl = Request["returnurl"] })&activity=' + activity);
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#activity').change(function () {
            // loadActivityDays();
        });

        $('#activityday').click(function () {
            //loadChoiceNumbers($(this).val());
        });
    });

    function loadChoiceNumbers(day) {
        $.get(
            '/org/services/GetRegistrationMaxChoiceNumbersForDay/@selectedRegistration.ID?day=' + day,
            function (data) {
                if (data && data.status == 'ok') {
                    if (data.MaxChoices > 1) {
                        $('#choicenumber-container').removeClass('hide');

                        $('#choicenumber').html('');

                        for (var i = 1; i <= data.MaxChoices + 1; i++) {
                            $('#choicenumber').append('<option value="' + i + '">' + i + '</option>');
                        }

                    } else {
                        $('#activity-days-container').addClass('hide');
                    }
                } else {
                    alert('Error getting choice numbers')
                }
            }
        );
    }

    function loadActivityDays() {
        $.get(
            '/org/services/getactivitydays/' + $('#activity').val(),
            function (data) {
                if (data && data.status == 'ok') {
                    if (data.days.length > 0) {
                        // $('#activity-days-container').removeClass('hide');

                        $('#activity-days').html('');

                        for (var i = 0; i < data.days.length; i++) {
                            var day = data.days[i];
                            $('#activity-days').append('<div class="am-radio inline"><input type="radio" id="activity-day-' + day.Value + '" name="activityday" class="form-control" value="' + day.Value + '" required /><label for="activity-day-' + day.Value + '">' + day.Text + '</label></div>');
                        }

                    } else {
                        $('#activity-days-container').addClass('hide');
                    }
                } else {
                    alert('Error getting activity days')
                }
            }
        );
    }

</script>
