@model List<ActivityMessage>
@{
    ViewBag.Title = $"Messages - {SessionVariables.CurrentAccount.Name}";
    var msgs = (SystemMessages)ViewBag.Messages;
    var isVolunteers = Request.QueryString["volunteers"] == "true";
    var SendNewMessageUrl = isVolunteers ? Url.Action("messageadd", "registration", new {volunteers = "true"}) : Url.Action("messageadd", "registration");
    var receiptants = isVolunteers ? "Volunteers" : "Students"; //Verify how it is done in other locations
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_RegistrationHeader" ,  new ViewDataDictionary()
      {
          { "Volunteer", isVolunteers },
      });}

    <div class="panel panel-default">
        <div class="panel-heading">
            Messages
        </div>
        <div class="panel-body">            
            <button class="btn btn-link" onclick="toggleFilter()">Send New Message</button>
            <div class="panel panel-default panel-borders hide" id="student-filter">

                <div class="panel-body">

                    <h3>Filter @receiptants</h3>

                    @{ Html.RenderPartial("_RegistrationSearchBar"); }

                    <div class="row">
                        <div class="col-md-12">
                            <button class="btn btn-primary btn-lg" onclick="sendMessages()">Send Messages &raquo;</button>
                        </div>
                    </div>
                </div>
            </div>

            @{Html.RenderPartial(
                  "~/Views/Shared/_Messages.cshtml",
                  Model,
                  new ViewDataDictionary
                  {
                    { "SendNewMessageLink", @SendNewMessageUrl },
                    { "Account", SessionVariables.CurrentAccount },
                    { "ViewLinkController", "registration" },
                    { "ShowAddMessage", false },
                    { "PagingModel", ViewBag.PagingModel },
                    { "ActivityType", isVolunteers ? ActivityType.VolunteerOpportunity : ActivityType.Activity },
                  }
                );}
        </div>
    </div>
</div>

@section scripts
{
    <script>
        function sendMessages() {
            location.href = `@Url.Action("messageadd", "registration")?${isVolunteer()}&${getQuery()}&${getActivityOrGroup()}${getFilterQuestionQS()}&${getRegStatus()}&${getAssignmentType()}`;
        }

        function toggleFilter() {
            if ($('#student-filter').hasClass('hide')) {
                $('#student-filter').removeClass('hide');
            } else {
                $('#student-filter').addClass('hide');
            }
        }
       
    </script>
}