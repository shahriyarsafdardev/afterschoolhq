@{
    ViewBag.Title = SessionVariables.CurrentAccount.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var totalCount = (int)ViewBag.TotalCount;

    var selectedActivities = (List<Activity>)ViewBag.SelectedActivities;
    var selectedGroups = (List<ActivityGroup>)ViewBag.SelectedGroups;
    var registrations = (List<Registration>)ViewBag.Registrations;
    var queryString = ViewContext.RequestContext.HttpContext.Request.QueryString;
    var isVolunteers = queryString.HasKeys() && queryString["volunteers"] == "true";
    var recipients = UILabel.RegistrantLabel(isVolunteers ? ActivityType.VolunteerOpportunity : ActivityType.Activity, true);
    var sendButtonText = $"Send Messages";
    var sendMessagesUrl = isVolunteers ? Url.Action("messages", "registration", new { volunteers = "true" }) : Url.Action("messages", "registration");
    var activityLabel = isVolunteers ? @UILabel.ActivityLabel(ActivityType.VolunteerOpportunity, true) : @UILabel.ActivityLabel(plural:true);
}

@{ Html.RenderPartial("OrgAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_RegistrationHeader"); }

    <div class="panel panel-default">
        <div class="panel-heading">
            Send Message
        </div>
        <div class="panel-body">

            <form method="post" action="@Url.Action("messageadd", "registration")" class="form-horizontal" enctype="multipart/form-data">
                @if (Request["q"].IsNotEmpty())
                {
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Search Term</label>
                        <div class="col-sm-6">
                            <input type="text" readonly="readonly" class="form-control" value="@Request["q"]" />
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="col-sm-3 control-label">@activityLabel</label>
                    <div class="col-sm-6">
                        @if (selectedActivities.Any() || selectedGroups.Any())
                        {
                            <input type="text" readonly="readonly" class="form-control" value="@string.Join(",", selectedGroups.Select(group => group.Name).Union(selectedActivities.Select(activity => activity.Name)))" />
                        }
                        else
                        {
                            <input type="text" readonly="readonly" class="form-control" value="All @activityLabel" />
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Seat Assignments</label>
                    <div class="col-sm-6">
                        @if (Request["at"].IsNotEmpty() && Request["at"].IsNumber())
                        {
                            <input type="text" readonly="readonly" class="form-control" value="@(Request["at"].ToInteger().ToEnum<RegistrationAssignmentType>().ToString().SplitByUpperCase())" />
                        }
                        else
                        {
                            <input type="text" readonly="readonly" class="form-control" value="All Seat Assignments" />
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Registration Status</label>
                    <div class="col-sm-6">
                        @if (Request["regstatus"].IsNotEmpty() && Request["regstatus"].IsNumber())
                        {
                            <input type="text" readonly="readonly" class="form-control" value="@(Request["regstatus"].ToInteger().ToEnum<RegistrationAssignmentType>().ToString().SplitByUpperCase())" />
                        }
                        else
                        {
                            <input type="text" readonly="readonly" class="form-control" value="All @recipients" />
                        }
                    </div>
                </div>

                <div class="form-group" id="subject-group">
                    <label class="col-sm-3 control-label">Message Reason</label>
                    <div class="col-sm-6">
                        <select name="subject" id="subject" class="form-control" required>
                            <option value="">Select a Message Reason...</option>
                            @{
                                var reasons = isVolunteers ? FormConstants.VolunteerMessageReasons() : FormConstants.StudentMessageReasons();

                                foreach (var reason in reasons)
                                {
                                    <option value="@reason.ToString().SplitByUpperCase()">@reason.ToString().SplitByUpperCase()</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <input type="hidden" name="q" value="@Request["q"]" />
                <input type="hidden" name="activity" value="@Request["activity"]" />
                <input type="hidden" name="group" value="@Request["group"]" />
                <input type="hidden" name="at" value="@Request["at"]" />
                <input type="hidden" name="regstatus" value="@Request["regstatus"]" />
                <input type="hidden" name="volunteers" value="@isVolunteers.ToString()">

                <div class="form-group">
                    <label class="col-sm-3 control-label">Message Body</label>
                    <div class="col-sm-6">
                        <textarea name="body" id="body" required style="width: 100%" rows="5" class="form-control"></textarea>
                        <p class="text-muted">Max of 1000 characters</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Attachment(s)</label>
                    <div class="col-md-6">
                        <div id="selected-files"></div>
                        <div class="border-gray-bold">
                            <input type="file" name="importedFiles" id="file-input" class="hide" multiple />
                            <label id="file-label" class="btn attachment-btn" for="file-input">Choose File(s)<i class="icon s7-upload"></i></label>
                        </div>
                        <p class="text-muted">Max of 25 mb per file</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div class="am-checkbox">
                            <input type="checkbox" id="sendtostaff" name="sendtostaff" value="1" checked="checked" />
                            <label for="sendtostaff">Send Message To Staff</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div class="am-checkbox">
                            <input type="checkbox" id="parentsonly" name="parentsonly" value="1" />
                            <label for="parentsonly">Send only to parents of selected students</label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Selected @recipients</label>
                    <div class="col-sm-6">
                        <div class="panel panel-default panel-borders">
                            <div class="panel-body">
                                <div style="height: 200px; overflow: auto;">
                                    @Html.Raw(string.Join("<br />", registrations.Select(registration => $"{registration.RegistrantName}")))
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div class="panel panel-default panel-borders">
                            <div class="panel-body">
                                <div class="am-checkbox">
                                    <input type="checkbox" id="confirmed" name="confirmed" value="1" required onclick="checkForm()" />
                                    <label for="confirmed" id="lblconfirmed">
                                        I acknowledge that clicking <strong>'@sendButtonText'</strong> will send the message above to <strong>@totalCount @recipients.ToLower()</strong>. <strong>Once the message is sent it is non-reversible and it cannot be undone</strong>. Please carefully review your message and the list of @recipients.ToLower() before you click '@sendButtonText' below.
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div class="pull-left">
                            <a href="@sendMessagesUrl" class="text-muted">
                                &laquo; Cancel
                            </a>
                        </div>
                        <div class="pull-right">
                            <button id="send-btn" type="submit" onclick="checkForm()" class="btn btn-primary btn-lg btn-block pull-right">
                                <i class="s7-mail"></i> @sendButtonText &raquo;
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        const fileInput = document.getElementById("file-input");
        const selectedFiles = document.getElementById("selected-files");
        let validFiles = []; 

        fileInput.addEventListener("change", function () {
            selectedFiles.innerHTML = "";
            const files = this.files;
            let totalFileSize = 0;
            let validExtensions = [".jpg", ".pdf", ".jpeg", ".png"];
            if (files.length >=1 && files.length <= 10) {
                for (let i = 0; i < files.length; i++){
                    const file = files[i];
                    const fileSizeMB = (file.size / (1024 * 1024)).toFixed(2);
                    const fileSizeKB = (file.size / 1024).toFixed(2);
                    const fileExtension = file.name.split('.').pop().toLowerCase();

                    if (file.size > 25 * 1024 * 1024){
                        Notifications.showBar({
                            title: 'Error',
                            message: "File size exceeds the limit 25 MB",
                            success: false
                        });
                    }
                    else if (!validExtensions.includes("." + fileExtension)) {
                        Notifications.showBar({
                            title: 'Error',
                            message: "Please add the valid jpg, png or pdf file",
                            success: false
                        });
                    }
                    else {
                        if (totalFileSize + file.size > 50 * 1024 * 1024) {
                            Notifications.showBar({
                                title: 'Error',
                                message: "Total file size exceeds the limit (50 MB)!",
                                success: false
                            });
                            break;
                        }

                        totalFileSize += file.size;

                        const fileItem = document.createElement("div");
                        fileItem.classList.add("form-control");
                        fileItem.classList.add("col-md-6");
                        fileItem.innerHTML = `
                        <span class="file-name">${file.name}</span>
                        <span class="float-right">
                            <span class="mr-3">${fileSizeMB > 1 ? fileSizeMB + " MB" : fileSizeKB + " KB"}</span>
                            <i class="s7-trash text-danger" data-index="${i}" onclick="deleteFile(event)"></i>
                        </span>`;
                        selectedFiles.appendChild(fileItem);

                        validFiles.push(file);
                    }
                }

                const newFileList = new DataTransfer();
                validFiles.forEach(file => {
                    newFileList.items.add(file);
                });
                fileInput.files = newFileList.files;
            }
            else
            {
                const newFileList = new DataTransfer();
                fileInput.files = newFileList.files;
                Notifications.showBar({
                    title: 'Error',
                    message: "You can't attach more than 10 files",
                    success: false
                });
            }

        });
    });
    function checkForm() {
        if (!$('#confirmed').is(':checked')) {
            $('#lblconfirmed').addClass('text-danger');
        } else {
            $('#lblconfirmed').removeClass('text-danger');
        }
    }
    function deleteFile(event) {
        const fileInput = document.getElementById("file-input");
        const index = event.target.getAttribute("data-index");
        const selectedFiles = document.getElementById("selected-files");
        fileInput.files[index] = null;
        selectedFiles.removeChild(event.target.parentElement.parentElement);
        fileInput.value = "";
    }
</script>