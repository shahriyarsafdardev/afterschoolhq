
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var user = WebUser.Load(SessionVariables.CurrentUser.ID.Value);
}

@{Html.RenderPartial("OrgAccountHeader");}
<div class="main-content">

    @{Html.RenderPartial("_RegistrationHeader");}
    <div id="studentcrmcontainer" class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-lg-6">
                    <div style="font-size:22px">@user.FirstName @user.LastName</div>
                </div>
                
            </div>
            <div style="clear:both"></div>
            <div class="margin-t-35">
                <table class="table surveyTable">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Survey Name</th>
                            <th>Activity</th>
                            <th>Sent By</th>
                            <th>Date Sent</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <a href="@Url.Action("viewsurvey", "activity", new { })">View</a>
                            </td>
                            <td>
                                Daily Reflection
                            </td>
                            <td>Activity</td>
                            <td>
                                Margo Wilson
                            </td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
