
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var user = WebUser.Load(SessionVariables.CurrentUser.ID.Value);
}

@{Html.RenderPartial("OrgAccountHeader");}
<div class="main-content">

    @{Html.RenderPartial("_RegistrationHeader");}
    <div id="studentcrmcontainer" class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-lg-6">
                    <div style="font-size:22px">@user.FirstName @user.LastName</div>
                </div>
                
            </div>
            <div style="clear:both"></div>
            <div class="margin-t-35">
                <table class="table surveyTable">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Survey Name</th>
                            <th>Activity</th>
                            <th>Sent By</th>
                            <th>Date Sent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var survey in (List<SurveyRequest>)ViewBag.Surveys)
                        {
                            var activity = SurveyRequestService.GetActivity(survey);
                            <tr>
                                <td>
                                    <a href="@Url.Action("viewsurvey", "activity", new { id = survey.ID, activitId = activity.Uid })">View</a>
                                </td>
                                <td>
                                    @survey.Name
                                </td>
                                <td>
                                    @activity.UniqueName
                                </td>
                                <td>
                                    @SurveyRequestService.GetCreatedBy(survey).DisplayName
                                </td>
                                <td>
                                    @(survey.CreateDate.IsNotEmpty() ? survey.CreateDate.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
