@{
    ViewBag.Title = "Invite Users";
    var msgs = (SystemMessages)ViewBag.Messages;
}

<div class="page-head">
    <h2>Invite Users</h2>
</div>
<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-body">
            
            <form method="post" action="@Url.Action("invite", "user", new { id = ViewBag.AccountId, returnurl = ViewBag.ReturnUrl })" class="form-horizontal">

                <div class="form-group">
                    <label class="col-sm-3 control-label">Account Type</label>
                    <div class="col-sm-6">

                        <div class="am-radio inline">
                            <input type="radio" name="usertype" id="usertype1" required value="@((int)UserType.Administrator)">
                            <label for="usertype1">@UserType.Administrator.ToString()</label>
                        </div>
                        <div class="am-radio inline">
                            <input type="radio" name="usertype" id="usertype2" required value="@((int)UserType.ProgramDirector)">
                            <label for="usertype2">@UserType.ProgramDirector.ToString().SplitByUpperCase()</label>
                        </div>
                        <div class="am-radio inline">
                            <input type="radio" name="usertype" id="usertype2" required value="@((int)UserType.Instructor)">
                            <label for="usertype2">@UserType.Instructor.ToString().SplitByUpperCase()</label>
                        </div>

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Emails</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="emails" name="emails" value="@ViewBag.Emails" onfocus="this.select()" required placeholder="name@domain.com, name2@domain.com" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Message</label>
                    <div class="col-sm-6">
                        <textarea class="form-control" id="message" name="message" onfocus="this.select()">@ViewBag.InviteMessage</textarea>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        @if(ViewBag.ReturnUrl != null)
                        {
                            <a href="@ViewBag.ReturnUrl" class="btn btn-default">Return <i class="icon icon-right s7-right-arrow"></i></a>
                        }
                        <button type="submit" class="btn btn-primary pull-right">Invite</button>
                    </div>
                </div>
            </form>
        </div>

    </div>
</div>


