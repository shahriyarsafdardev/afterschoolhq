@model WebUser
@{
    var account = (Account)ViewBag.Account;
    ViewBag.Title = account.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var cleverSsoEnabled = ViewBag.CleverSsoEnabled;
}

@{Html.RenderPartial("OrgAccountHeader", account.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-user"></i> @Model.DisplayName
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("edit", "user")" class="form-horizontal">
                <div class="form-group">
                    <label class="col-sm-3 control-label">First Name</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="firstname" name="firstname" value="@Model.FirstName" onfocus="this.select()" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Last Name</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="lastname" name="lastname" value="@Model.LastName" onfocus="this.select()" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Email</label>
                    <div class="col-sm-6">
                        <input type="email" class="form-control" id="email" name="email" value="@Model.Email" onfocus="this.select()" required />
                    </div>
                </div>
                <div class="form-group hide">
                    <label class="col-sm-3 control-label">Username</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="username" name="username" value="@Model.Username" onfocus="this.select()" required readonly="readonly" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-6 col-sm-offset-3 margin-v-10">
                        <hr />
                        <h4>Change Password</h4>
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Password</label>
                    <div class="col-sm-6">
                        <input type="password" class="form-control" id="password1" name="password1" value="" onfocus="this.select()" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Verify Password</label>
                    <div class="col-sm-6">
                        <input type="password" class="form-control" id="password2" name="password2" value="" onfocus="this.select()" />
                    </div>
                </div>

                @if(Model.IsRegistered && SessionVariables.CurrentUser.ID != Model.ID)
                { 
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Is Active</label>
                        <div class="col-sm-6">
                            <div class="switch-button switch-button-yesno">
                                <input type="checkbox" @(Model.IsActive ? " checked=\"checked\" " : "") name="isactive" id="isactive">
                                <span>
                                    <label for="isactive"></label>
                                </span>
                            </div>
                        </div>
                    </div>
                }

                <div class="clearfix"></div>
                @if (cleverSsoEnabled)
                {
                    <div class="row">
                        <div class="col-sm-6 col-sm-offset-3 margin-v-10">
                            <hr/>
                            <h4>Login With Clever</h4>

                            @if (UILabel.IsCurrentUserCleverIntegrated())
                            {
                                <p class="txt-clever-connected">You are currently connected to a Clever account with the username <b>@UILabel.GetCleverUserNameForCurrentUser()</b>. To change your connected Clever account, press the "Disconnect" button below.</p>
                                <a type="button" class="btn btn-primary" href="@Url.Action("DisconnectCleverForCurrentUser", "User", new { Area = "Org" })">Disconnect</a>
                            }
                            else
                            {
                                <br/>
                                <a href="@AfterSchoolLibrary.Helpers.CleverHelper.SSOLink">
                                    <img src="~/img/clever-login.png" style="width: 160px; height: 39px;" class="clever-login-img"/>
                                </a>
                            }
                        </div>
                    </div>
                }
                
                <br />
                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6 text-center">
                        <button type="submit" class="btn btn-primary">Update</button>
                        <button type="reset" class="btn btn-default">Discard Changes</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@{ Html.RenderPartial("_ModalUpdateCleverAccount"); }
