@{ var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower(); }
<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        <a href="@Url.Action("index", "contact")" class="btn btn-alt6@(actionName == "index" ? "-active" : "")"><i class="s7-users"></i> Contacts</a>
        <a href="@Url.Action("lists", "contact")" class="btn btn-alt6@(actionName == "lists" ? "-active" : "")"><i class="s7-lists"></i> Contact Lists</a>
    </div>
    <div class="hidden-lg hidden-sm hidden-md">
        <select class="form-control" onchange="location.href=this.value;">
            <option value="">Navigation</option>
            <option value="@Url.Action("index", "contact")">Contacts</option>
            <option value="@Url.Action("lists", "contact")">Contact Lists</option>
        </select>
    </div>
</div>   