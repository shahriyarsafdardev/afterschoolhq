@{ 
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var manageContacts = SessionVariables.AccountPackage.HasFeature(FeatureType.ManageContacts);
    var manageContactsPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.ManageContacts);
}

<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        @if (manageContacts)
        {
            <a href="@Url.Action("index", "contact")" class="btn btn-alt6@(actionName == "index" ? "-active" : "")"><i class="s7-users"></i> Contacts</a>
        }
        else
        {
            <a href="#" class="btn btn-alt6@(actionName == "index" ? "-active" : "")" onclick="return showUpgradeMyPlan('@(manageContactsPackage?.Name)'S,@(manageContactsPackage?.ID))"><i class="s7-users"></i> Contacts</a>
        }

        <a href="@Url.Action("lists", "contact")" class="btn btn-alt6@(actionName == "lists" ? "-active" : "")"><i class="s7-lists"></i> Contact Lists</a>
    </div>
    <div class="hidden-lg hidden-sm hidden-md">
        <select class="form-control" onchange="this.value == '#' ? showUpgradeMyPlan('@(manageContactsPackage?.Name)',@(manageContactsPackage?.ID)) : location.href = this.value;">
            <option value="">Navigation</option>
            @if (manageContacts)
            {
                <option value="@Url.Action("index", "contact")">Contacts</option>
            }
            else
            {
                <option value="#">Contacts</option>
            }

            <option value="@Url.Action("lists", "contact")">Contact Lists</option>
        </select>
    </div>
</div>   