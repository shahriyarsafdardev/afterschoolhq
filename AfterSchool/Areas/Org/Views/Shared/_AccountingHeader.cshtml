
@{
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
}

@if (!SessionVariables.CurrentAccount.HasFeature(FeatureType.UseStripeConnectedAccount))
{
    <div class="btn-toolbar">
        <div class="btn-group hidden-xs">
            <a class="btn btn-alt6@(actionName == "index" ? "-active" : "")" href="@Url.Action("index", "accounting")">
                Transactions
            </a>
            <a class="btn btn-alt6@(actionName == "payouts" ? "-active" : "")" href="@Url.Action("payouts", "accounting")">
                Payouts
            </a>
        </div>
        <div class="hidden-lg hidden-sm hidden-md">
            <select class="form-control" onchange="handleNav(this.value)">
                <optgroup label="Navigation">
                    <option value="@Url.Action("index", "accounting")">Transactions</option>
                    <option value="@Url.Action("payouts", "accounting")">Payouts</option>
                </optgroup>
            </select>
        </div>
    </div>

    <script>
        function handleNav(value) {
            location.href = value;
        }
    </script>
}