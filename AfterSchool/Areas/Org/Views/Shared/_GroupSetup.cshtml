@model ActivityGroup

@{
    var accountPackage = (AccountPackage)ViewData["AccountPackage"];
    var forms = (List<Form>)ViewBag.Forms;
    var activeForm = (Form)ViewBag.ActiveForm;

    var waitinglistdisabled = "";
    if (!accountPackage.HasFeature(FeatureType.WaitingList))
    {
        waitinglistdisabled = " disabled=\"disabled\" ";
    }
}

<div class="panel panel-default panel-small-padding">
    <div class="panel-heading">
        Settings
    </div>
    <div class="panel-body">

        <div class="form-group">
            <label class="col-sm-3 control-label">@UILabel.ActivityGroupLabel(Model.ActivityGroupTypeId) Name <span class="text-danger">*</span></label>
            <div class="col-sm-9">
                <input type="text" class="form-control" id="name" name="name" value="@Model.Name" onfocus="this.select()" required placeholder="Your @UILabel.ActivityGroupLabel(Model.ActivityGroupTypeId) Name" />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">
                Total Available Seats
                <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Must be a number between 1 and @accountPackage.GetFeature(FeatureType.Participants).Max.Value" data-placement="top"></i>
            </label>
            <div class="col-sm-9">
                <input type="number" class="form-control" id="seatsavailable" name="seatsavailable" value="@Model.SeatsAvailable" onfocus="this.select()" step="1" min="1" max="@accountPackage.GetFeature(FeatureType.Participants).Max.Value" />
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">
                Start Date
            </label>
            <div class="col-md-7">                
                @{
                    Html.RenderPartial(
                        "~/Views/Shared/Components/_Date.cshtml",
                        new FormInputViewModel()
                        {
                            Id = "startdate",
                            Name = "startdate",
                            Value = Model.StartDate.ToShortDateString()
                        }
                    );
                }
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">
                End Date
            </label>
            <div class="col-md-7">   
                @{ 
                    Html.RenderPartial(
                        "~/Views/Shared/Components/_Date.cshtml",
                        new FormInputViewModel()
                        {
                           Id = "enddate",
                           Name = "enddate",
                           Value = Model.EndDate.ToShortDateString()
                         }
                      );
                    }
            </div>
        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">Invite Only</label>
            <div class="col-sm-9">
                @{
                    Html.RenderPartial(
                        "~/Views/Shared/_SwitchButton.cshtml",
                        Model.IsInviteOnly,
                        new ViewDataDictionary()
                        {
                        { "checkboxname", "isinviteonly" },
                        { "checkboxid", "isinviteonly" }
        }
                    );
                }
            </div>
        </div>

        <div class="col-md-offset-3 col-md-9 padding-v-20">
            <span><a onclick="ActivitySetup.showAdvancedSettings()" id="btn-advanced-settings" class="pointer">Show Advanced Settings</a></span>
        </div>

        <div class="advanced-settings hide">

            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Waiting List Seats <span class="text-danger">*</span>
                    <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Can be any positive number" data-placement="top"></i>
                </label>
                <div class="col-sm-9">
                    <input type="number" class="form-control" id="waitinglistseats" name="waitinglistseats" value="@Model.WaitingListSeats" onfocus="this.select()" required step="1" min="0" @waitinglistdisabled />
                </div>
            </div>

            @if (accountPackage.HasFeature(FeatureType.ManageForms))
            {
                <div class="form-group">
                    <label class="col-md-3 control-label">
                        Registration Form <span class="text-danger">*</span>
                    </label>
                    <div class="col-md-6">
                        <select name="form" id="form" class="form-control" required>
                            <option value="">Select Form...</option>
                            <option value="0"> + New Form</option>
                            @foreach (var form in forms)
                            {
                                <option value="@form.ID" @(activeForm?.ID == form.ID ? " selected=\"selected\" " : "")>@form.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <a class="btn btn-block btn-link" href="@Url.Action("edit","form", new { id = activeForm?.ID })" id="editForm" target="_blank">Edit Form</a>
                    </div>
                </div>
            }

            @if (SessionVariables.AccountPackage.HasFeature(FeatureType.AllowApplications))
            {
                <div class="form-group">
                    <label class="col-sm-3 control-label">
                        Registration Mode <span class="text-danger">*</span>
                    </label>
                    <div class="col-sm-9">
                        <div class="am-radio inline">
                            @foreach (var item in Enum.GetValues(typeof(RegistrationMode)).Cast<RegistrationMode>().Where(x => x != RegistrationMode.NotSet))
                            {
                                <input type="radio" name="regmode" id="regmode-@item.ToString()" value="@((int)item)" @(item == Model.RegistrationModeId ? "checked=\"checked\"" : "") />
                                <label for="regmode-@item.ToString()" class="margin-h-10">@item.ToString()</label>
                            }
                        </div>
                        <p class="text-muted">
                            <em>
                                <strong>Register Mode</strong> means a @UILabel.RegistrantLabel().ToLower() will be given a &lsquo;reserved&rsquo; seat on a first come first serve basis.<br />
                                <strong>Apply Mode</strong> means a @UILabel.RegistrantLabel().ToLower() will only &lsquo;apply&rsquo; and will be given a reserved seat either via lottery or by being placed manually by you in a reserved seat.
                            </em>
                        </p>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" name="regmode" value="@((int)RegistrationMode.Register)" />
            }
        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#form').change(function () {
            checkFormVal();
        });

        checkFormVal();

        $('input[name=startdate],input[name=enddate]').on('change', function () {
            validateSetup(event);
        });
    });

    function checkFormVal() {
        if ($('#form').val().length > 0 && $('#form').val() != "0") {
            $('#editForm').removeClass('hide');
            $('#editForm').attr('href', '@Url.Action("edit", "form")/' + $('#form').val());
        } else {
            $('#editForm').addClass('hide');
        }
    }

</script>
