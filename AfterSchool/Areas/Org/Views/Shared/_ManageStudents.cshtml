@model AfterSchoolLibrary.Activity
@{


    var group = (ActivityGroup)ViewData["Group"];
    var mainColWidth = 10;

    var registrants = (List<Registrant>)ViewData["Registrants"];
    var addedRegistrants = (List<Registrant>)ViewData["AddedRegistrants"];
    var registrantsPerColumn = registrants.Count/3 + 1;
    var addedRegistrantsPerColumn = addedRegistrants.Count / 3 + 1;
}

<div class="main-content">      
    
     <div role="alert" class="alert alert-info alert-icon">
        <div class="icon">
            <span class="s7-check-circle"></span>
        </div>
        <div class="message">
            <p class="text-center">
                If a student is already on another team in @group.Name, they will automatically be removed from the other team when you add them to this team.
            </p>
        </div>
    </div>

    <div class="form-group">
        <div class="row">
            <label class="col-md-3 control-label">
                Select Students<br />
                <a href="javascript:selectAll()">Select All</a> | <a href="javascript:clearAll()">Clear All</a>
            </label>
                            
            <div class="col-md-6" id="available-registrants">
                <p class="text-medium-small">Students registered for @group.Name but not on @Model.Name:</p>
                @if (registrants.Any())
                {
                    for (int i = 0; i < 3; i++)
                    {
                        <div class="col-md-4">
                            @foreach (var registrant in registrants.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                            {
                                var ra = registrant.GetRegistrantActivities().Where(item => item.ParticipationObjectTypeId == ParticipationObjectType.Activity).FirstOrDefault();
                                var activity = ra?.GetActivity();

                                <div class="am-checkbox">
                                    <input type="checkbox" id="registrant-@registrant.ID" name="registrant-@registrant.ID" value="1" />
                                    <label for="registrant-@registrant.ID">
                                        @registrant.DisplayName
                                        @if (activity.IsNotEmpty())
                                        {
                                            <span>(@activity.Name)</span>
                                        }
                                        else
                                        {
                                            <span>No Team</span>
                                        }
                                    </label>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p>None</p>
                }
            </div>
        </div>
        
        <div class="row padding-v-20">
            <div class="col-md-3"></div>
            <div class="col-md-6" id="added-registrants">
                <p class="text-medium-small">Students on @Model.Name:</p>
                @if (addedRegistrants.Any())
                {
                    for (int i = 0; i < 3; i++)
                    {
                        <div class="col-md-4">
                            @foreach (var registrant in addedRegistrants.Skip(i * addedRegistrantsPerColumn).ToList().Take(addedRegistrantsPerColumn))
                            {
                                <div class="am-checkbox">
                                    <input type="checkbox" id="registrant-@registrant.ID" name="registrant-@registrant.ID" value="1" checked />
                                    <label for="registrant-@registrant.ID">@registrant.DisplayName</label>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p>None</p>
                }
            </div>
        </div>
    </div>                 
</div>

<script>

    
    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

    function selectAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', true);
        });
    }
    function clearAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', false);
        });
    }
    

</script>

