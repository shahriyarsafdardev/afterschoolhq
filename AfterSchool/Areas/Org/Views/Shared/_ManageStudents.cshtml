@model AfterSchoolLibrary.Activity
@{
    

    var group = (ActivityGroup)ViewData["Group"];
    var mainColWidth = 10;
    var registrantsPerColumn = 2;
    var registrants = (List<Registrant>)ViewData["Registrants"];
    var addedRegistrants = (List<Registrant>)ViewData["AddedRegistrants"];
}

<div class="main-content">                 
    <p><i class="s7-info"></i> If a student is already on another team in @group.Name, they will automatically be removed from the other team when you add them to this team. </p>
    <div class="form-group">
        <label class="col-sm-3 control-label">
            Select Students<br />
            <a href="javascript:selectAll()">Select All</a> | <a href="javascript:clearAll()">Clear All</a>
        </label>
                            
        <div class="col-sm-7" id="available-registrants">
            <p>Students registered for @group.Name but not on @Model.Name:</p>
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-md-4">
                    @foreach (var registrant in registrants.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                    {
                        <div class="am-checkbox">
                            <input type="checkbox" id="registrant-@registrant.ID" name="registrant-@registrant.ID" value="1" />
                            <label for="registrant-@registrant.ID">@registrant.DisplayName</label>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-sm-3"></div>
        <div class="col-sm-7" id="added-registrants">
            <p>Students on @Model.Name:</p>
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-md-4">
                    @foreach (var registrant in addedRegistrants.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                    {
                        <div class="am-checkbox">
                            <input type="checkbox" id="registrant-@registrant.ID" name="registrant-@registrant.ID" value="1" checked />
                            <label for="registrant-@registrant.ID">@registrant.DisplayName</label>
                        </div>
                    }
                </div>
            }
        </div>
    </div>                 
</div>

<script>

    
    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

    function selectAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', true);
        });
    }
    function clearAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', false);
        });
    }
    

</script>

