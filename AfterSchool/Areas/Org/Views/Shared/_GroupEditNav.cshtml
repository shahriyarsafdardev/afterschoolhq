@model ActivityGroup
@{ 
    var isActive = Model.ID.HasValue && Model.ID.Value > 0;
    var isScheduleActive = Model.ID.HasValue && Model.ID.Value > 0;
    var activeMenu = ViewBag.ActiveMenu.ToString().ToLower();

    var editsetupactive = activeMenu == "editsetup" ? "active" : "";
    var editrestrictionsactive = activeMenu == "editrestrictions" ? "active" : "";
    var editdetailsactive = activeMenu == "editdetails" ? "active" : "";
    var editcontactactive = activeMenu == "editcontact" ? "active" : "";
    var editcostactive = activeMenu == "editcost" ? "active" : "";
    var editconfirmationactive = activeMenu == "editconfirmation" ? "active" : "";
}
<div id="list1" class="dd">
    <ol class="dd-list">
        <li data-id="1" class="dd-item">
            <div class="dd-handle @editsetupactive">
                <a href="@Url.Action("editsetup", "group", new { id = Model.ID.HasValue && Model.ID > 0 ? Model.Uid.ToString() : "", isnew = Request["isnew"] })">Settings</a>
            </div>
        </li>
        <li data-id="4" class="dd-item">
            <div class="dd-handle @editrestrictionsactive">
                @{Html.RenderPartial(
                        "~/Views/Shared/_ActiveLink.cshtml",
                        new ViewDataDictionary {
                            { "Url", Url.Action("editrestrictions", "group", new { id = Model.Uid.ToString(), isnew = Request["isnew"] }) },
                            { "Text", "Restrictions" },
                            { "IsActive", isScheduleActive },
                        }
                    );
                }
            </div>
        </li>
        <li data-id="2" class="dd-item">
            <div class="dd-handle @editdetailsactive">
                @{Html.RenderPartial(
                        "~/Views/Shared/_ActiveLink.cshtml",
                        new ViewDataDictionary {
                            { "Url", Url.Action("editdetails", "group", new { id = Model.Uid.ToString(), isnew = Request["isnew"] }) },
                            { "Text", "About Your " + UILabel.ActivityGroupLabel(Model.ActivityGroupTypeId) },
                            { "IsActive", isActive },
                        }
                    );
                }
            </div>
        </li>
        <li data-id="3" class="dd-item">
            <div class="dd-handle @editcontactactive">
                @{Html.RenderPartial(
                        "~/Views/Shared/_ActiveLink.cshtml",
                        new ViewDataDictionary {
                            { "Url", Url.Action("editcontact", "group", new { id = Model.Uid.ToString(), isnew = Request["isnew"] }) },
                            { "Text", "Contact" },
                            { "IsActive", isActive },
                        }
                    ); 
                }
            </div>
        </li>
        <li data-id="5" class="dd-item">
            <div class="dd-handle @editcostactive">
                @{Html.RenderPartial(
                        "~/Views/Shared/_ActiveLink.cshtml",
                        new ViewDataDictionary {
                            { "Url", Url.Action("editcost", "group", new { id = Model.Uid.ToString(), isnew = Request["isnew"] }) },
                            { "Text", "Pricing & Payment" },
                            { "IsActive", isActive},
                        }
                    );
                }
            </div>
        </li>
       
        <li data-id="6" class="dd-item">
            <div class="dd-handle @editconfirmationactive">
                @{Html.RenderPartial(
                        "~/Views/Shared/_ActiveLink.cshtml",
                        new ViewDataDictionary {
                            { "Url", Url.Action("editconfirmation", "group", new { id = Model.Uid.ToString(), isnew = Request["isnew"] }) },
                            { "Text", "Email Content" },
                            { "IsActive", isActive },
                        }
                    );
                }
            </div>
        </li>
    </ol>
</div>   