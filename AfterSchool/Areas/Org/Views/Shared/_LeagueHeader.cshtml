@model ActivityGroup
@{
    var publishClass = "btn-danger";
    if (!Model.IsPublished)
    {
        publishClass = "btn-alt7";
    }
    else if (Model.IsPublishable)
    {
        publishClass = "btn-success";
    }
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var activityCount = Model.GetActivityCount(null, false);
}
@if (Model.IsNotEmpty() && Model.ID.HasValue && Model.ID.Value > 0)
{
    <div class="btn-toolbar">
        <div class="btn-group hidden-xs">
            <a href="@Url.Action("summary", "league", new { id = Model.Uid })" class="btn btn-alt6@(actionName == "summary" ? "-active" : "")">
                <i class="s7-graph2"></i> Summary
            </a>
           
            <a href="@Url.Action("periods", "league", new {id = Model.Uid})" class="btn btn-alt6@(actionName == "periods" ? "-active" : "")">
                <i class="s7-date"></i> @UILabel.RegistrationPeriodAbbrLabel(true)
            </a>
            <a href="@Url.Action("leagueActivities", "league", new {id = Model.Uid})" class="btn btn-alt6@(actionName == "activities" ? "-active" : "")">
                <i class="s7-gleam"></i> @UILabel.ActivityLabel(Model.ActivityGroupTypeId, true)s
            </a>

            @if (Model.IsPublished || true)
            {
                <a href="@Url.Action("registrations", "league", new {id = Model.Uid})" class="btn btn-alt6@(actionName == "registrations" ? "-active" : "")">
                    <i class="s7-user"></i> @UILabel.RegistrantLabel(true)
                </a>
                @*<a href="@Url.Action("schedules", "league", new {id = Model.Uid})"  class="btn btn-alt6@(actionName == "schedules" ? "-active" : "")">
                  <i class="s7-date"></i>  Practice ?? Schedule
                </a>*@
                 <a href="@Url.Action("schedules", "league", new {id = Model.Uid})"  class="btn btn-alt6@(actionName == "schedules" ? "-active" : "")">
                  <i class="s7-date"></i>  Game Schedule
                </a>
                <div class="btn-group">
                    <button type="button" data-toggle="dropdown" class="btn btn-alt6 dropdown-toggle" aria-expanded="false">
                        More... <span class="caret"></span>
                    </button>
                    <ul role="menu" class="dropdown-menu" id="list-add-menu">
                       
                        <li>
                            <a href="@Url.Action("invited", "league", new {id = Model.Uid})">
                                <!-- class="btn btn-alt6@(actionName == "invited" ? "-active" : "")"-->
                                <i class="s7-user"></i> Invitations
                            </a>
                        </li>
                        <li>
                            <a href="@Url.Action("messages", "league", new {id = Model.Uid})">
                                <!-- class="btn btn-alt6@(actionName == "messages" ? "-active" : "")"-->
                                <i class="s7-mail"></i> Messaging
                            </a>
                        </li>
                        @if (Model.RegistrationModeId == RegistrationMode.Apply && SessionVariables.AccountPackage.HasFeature(FeatureType.Lottery))
                        {
                            <li>
                                <a href="@Url.Action("placement", "league", new { id = Model.Uid })">
                                    <!-- class="btn btn-alt6@(actionName == "placement" ? "-active" : "")"-->
                                    Lottery
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            <a href="@Url.Action("publishdetail", "league", new { id = Model.Uid })" class="btn @publishClass"><i class="s7-link"></i> Publish</a>
        </div>
        <div class="hidden-lg hidden-sm hidden-md">
            <select class="form-control" onchange="location.href=this.value;">
                <option value="">Navigation</option>
                <option value="@Url.Action("summary", "league", new { id = Model.Uid })">Summary</option>
                <option value="@Url.Action("edit", "league", new {id = Model.Uid})">Setup</option>
                <option value="@Url.Action("emailcontent", "league", new {id = Model.Uid})">Content</option>
                <option value="@Url.Action("periods", "league", new {id = Model.Uid})">@UILabel.RegistrationPeriodLabel(true)</option>
                <option value="@Url.Action("activities", "league", new { id = Model.Uid })">@UILabel.ActivityLabel(Model.ActivityGroupTypeId, true)</option>
                @if (activityCount > 0 || Model.IsPublished)
                {
                    <option value="@Url.Action("registrations", "league", new { id = Model.Uid })">@UILabel.RegistrantLabel(true)</option>
                    <option value="@Url.Action("invited", "league", new { id = Model.Uid })">Invitations</option>
                    <option value="@Url.Action("messages", "league", new { id = Model.Uid })">Messaging</option>
                    if (Model.RegistrationModeId == RegistrationMode.Apply)
                    {
                        <option value="@Url.Action("placement", "league", new { id = Model.Uid })">Lottery</option>
                    }
                }
                <option value="@Url.Action("publishdetail", "league", new { id = Model.Uid })">Publish</option>
            </select>
        </div>
    </div>
}