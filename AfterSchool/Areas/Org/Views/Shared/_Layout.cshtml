<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="shortcut icon" href="/favicon.png">
    <meta name="keywords" content="">
    <title>@UILabel.ProductName()</title>

    @{Html.RenderPartial("~/Views/Shared/_HeadIncludes.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/_ZendeskWidget.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/JavascriptIncludes/_QuillEditorScripts.cshtml");}

    @RenderSection("head", required: false)

</head>
<body>
    <div class="am-wrapper notopmenu">
        <!-- top navbar-->
        @*Html.Partial("_TopNavbar")*@
        <!-- sidebar-->
        @Html.Partial("_Sidebar")
        <!-- Main section-->
        <div id="app-body" class="am-content">
            <div class="visible-xs am-toggle-left-sidebar pointer padding-10" style="background-color: #333;">
                <table>
                    <tr>
                        <td><i class="s7-menu icon-large text-white"></i> </td>
                        <td><span class="text-medium-small text-white d-inline-block padding-h-10">Menu</span></td>
                    </tr>
                </table>
            </div>
            @RenderBody()
        </div>

        <style>
            .overlay {
                width: 94%; /*only for screen with layout*/
            }
        </style>
        @{Html.RenderPartial("~/Views/Shared/_UpgradePlan.cshtml");}
        @*@Html.Partial("_RightSideBar")*@
    </div>

    @{Html.RenderPartial("~/Views/Shared/_JavascriptIncludes.cshtml");}

    @RenderSection("scripts", required: false)

    <script>
        $(document).ready(function () {

            $('form').submit(function () {
                $(this).find('button[type="submit"]').prop('disabled', true);
                $(this).find('button[type="submit"]').html('...');
                $('#modal-saving').removeClass('hide');
                // $("#modal-saving").addClass("md-show");
                // $('#saving-text').html('Saving...');
            });

            $('a').click(function () {
                if ($(this).attr('href') && $(this).attr('href') != "#" && $(this).attr('href').indexOf('javascript:') == -1 && $(this).attr('target') != "_blank") {
                    //$("#modal-saving").addClass("md-show");
                    //$('#saving-text').html('Loading...');
                    $('#modal-saving').removeClass('hide');
                }
            });
        });
    </script>
    <!-- -->

    <div id="modal-saving"
         class="hide"
         style="position: absolute; width: 250px; height: 65px; top: 10px; right: 10px; padding: 0px; margin: 0px; background-color: #333; color: #eee; border-radius: 10px;">
        <h3 class="text-center">Loading...</h3>
    </div>

    <div id="modal-saving-1" class="md-modal modal-container modal-full-color modal-full-color-success modal-effect-8" style="perspective: 1300px;">
        <div class="modal-content">
            <div class="modal-body">
                <div style="margin:auto; width: 90%; height: 90%;">
                    <img src="/assets/img/spinner.gif" style="width: 300px;" />
                </div>
                <div class="hide" style="background-image: url(/assets/img/spinner.gif); background-position: center; width: 600px; height: 300px;">

                </div>
                <div class="text-center hide">
                    <h3 id="saving-text">Saving...</h3>
                </div>
            </div>
        </div>
    </div>

    <div id="modal-payment-restriction" class="modal colored-header" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                    <h4 class="modal-title">Payment method not found.</h4>
                </div>
                <div class="modal-body" style="overflow-y: auto;">
                    Please setup payment method before you proceed futher. <br /><br />
                    For support or any query contact, please email us at <a href="mailto:support@afterschoolhq.com">support@afterschoolhq.com</a>
                </div>
                <div class="modal-footer">
                    <a class="btn btn-primary" data-dismiss="modal" onclick="return location.href = '@Url.Action("paymentsoptions", "account", new { area = "org"})'">Proceed</a>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div id="modal-payment-notification" class="modal colored-header" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
                    <h4 class="modal-title">Payment method not found.</h4>
                </div>
                <div class="modal-body" style="overflow-y: auto;">
                    You have been redirected to this payment setup page since you haven't added your default payment method yet.
                    <br /><br />
                    You can close this modal and start setting up your payment method.
                    <br /><br />
                    For support or any query contact, please email us at <a href="mailto:support@afterschoolhq.com">support@afterschoolhq.com</a>
                </div>
                <div class="modal-footer">                    
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        function loadPaymentRestrictionModal() {
            $('#modal-payment-restriction').modal('show');
            return false;
        }

        function loadPaymentNotificationModal() {
            $('#modal-payment-notification').modal('show');
            return false;
        }
    </script>
</body>
</html>