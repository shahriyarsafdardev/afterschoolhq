@{
    var isFullScreen = false;

    if (ViewData["IsFullScreen"] != null)
    {
        isFullScreen = (bool) ViewData["IsFullScreen"];
    }
}

<script>

    function getStripeBillingLink() {
        $.get(
            '@Url.Action("GetStripeBillingLink", "services")',
            function (data) {
                if (data && data.status == 'ok') {
                    location.href = data.link;
                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }
</script>

@if (!isFullScreen)
{
    var currentAccount = SessionVariables.CurrentAccount;
    var accountPackage = SessionVariables.AccountPackage;
    if (accountPackage.IsNotEmpty() && !currentAccount.HasDefaultPaymentMethod.IsTrue())
    {
        if (accountPackage.IsDuringTrial)
        {
            <div class="trial-header text-center text-white bg-danger">
                You have @accountPackage.TrialDaysRemaining day(s) remaining in your trial 
                <button onclick="getStripeBillingLink()" url="@Url.Action("newbilling", "account", new { id = accountPackage.PackageUid })" class="btn btn-alt5 margin-h-10">
                    Add Payment Method &raquo;
                </button>
            </div>
        }
        else if (accountPackage.IsTrialExpired(currentAccount))
        {
            <div class="trial-header text-center text-white bg-danger">
                It looks like your trial has expired. 
                <button onclick="getStripeBillingLink()" url="@Url.Action("newbilling", "account", new { id = accountPackage.PackageUid })" class="btn btn-alt5 margin-h-10">
                    Purchase Now &raquo;
                </button>
            </div>
        }
    }

    var currentUser = SessionVariables.CurrentUser;
    if (!currentUser.VerifiedAccount)
    {
        <div class="trial-header text-center text-white bg-danger">
            Please verify your email address in order to accept @UILabel.ActivityLabel().ToLower() registrations. 
            <a href="javascript:AccountSetup.sendVerificationEmail('')" class="white">
                Resend Email Verification Email &raquo;
            </a>
        </div>
    }

    <div class="page-head">
        <div class="row">
            <div class="col-md-5">
                <h2>
                    @currentAccount.Name
                </h2>
            </div>
            <div class="col-md-2">
                <a href="@currentAccount.ShortHomePageUrl" class="btn btn-primary">
                    View Profile
                </a>
            </div>
            <div class="col-md-2 col-md-offset-3">
                <div class="pull-right padding-10">
                    Logged in as: <a href="@Url.Action("edit", "user")">@currentUser.DisplayName</a> <br/>
                </div>
            </div>
        </div>
    </div>
}