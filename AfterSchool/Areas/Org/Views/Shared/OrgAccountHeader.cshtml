@if (SessionVariables.AccountPackage.IsNotEmpty())
{
    if (SessionVariables.AccountPackage.IsDuringTrial)
    {
        <div class="trial-header text-center text-white bg-warning">
            You have @SessionVariables.AccountPackage.TrialDaysRemaining day(s) remaining in your trial <a href="@Url.Action("newbilling", "account", new { id = SessionVariables.AccountPackage.PackageUid })" class="btn btn-alt5 margin-h-10">Purchase Now &raquo;</a>
        </div>
    }
    else if (SessionVariables.AccountPackage.IsTrialExpired(SessionVariables.CurrentAccount))
    {
        <div class="trial-header text-center text-white bg-danger">
            It looks like your trial has expired. <a href="@Url.Action("newbilling", "account", new { id = SessionVariables.AccountPackage.PackageUid })" class="btn btn-alt5 margin-h-10">Purchase Now &raquo;</a>
        </div>
    }
}
@if (!SessionVariables.LoggedInUser.VerifiedAccount)
{
    <div class="trial-header text-center text-white bg-danger">
        Please verify your email address in order to publish activities. <a href="javascript:sendVerificationEmail()" class="white">Resend Email Verification Email &raquo;</a>
    </div>
}

@if ((new UserType[] { UserType.Owner, UserType.Administrator }).Contains(SessionVariables.AccountUserType) && !SessionVariables.CurrentAccount.GetOrCreateStripeAccount(SessionVariables.LoggedInUser).IsVerified)
{
    <div class="trial-header text-center text-white bg-danger">
        Finish setting up your account in order to accept payments. <a href="@Url.Action("paymentsentity", "account")" class="white">Setup Payments &raquo;</a>
    </div>
}

<div class="page-head">
    <div class="row">
        <div class="col-md-5">
            <h2>
                @SessionVariables.CurrentAccount.Name
            </h2>
        </div>
        <div class="col-md-2">
            <a href="@SessionVariables.CurrentAccount.HomePageUrl" target="_blank" class="btn btn-primary">
                View Activity Home Page
            </a>
        </div>
        <div class="col-md-2 col-md-offset-3">
            <div class="pull-right">
                Logged in as: <a href="@Url.Action("edit", "user")">@SessionVariables.LoggedInUser.DisplayName</a> <br />
            </div>
        </div>
    </div>    
</div>

<script>
    function sendVerificationEmail() {
        $.get(
            '@Url.Action("SendVerificationEmail", "Services")',
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: 'A verification email has been sent. Please check your email.'
                    });
                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: 'Error sending verification email. Please <a href="mailto:@AfterSchoolLibrary.Email.AppSupportEmailAddress()" class="white">contact support</a>.'
                    });
                }
            }
            );
    }
</script>