@{ 
    var controller = ViewContext.RouteData.Values["controller"].ToString().ToLower();
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();

    string homeactive = "",
        activityactive = "",
        leagueactive = "",
        sessionactive = "",
        registrationactive = "",
        formactive = "",
        contactactive = "",
        teamactive = "",
        accountactive = "",
        profileactive = "",
        accountingactive = "",
        leagueexternalactive = "";

    switch(controller)
    {
        case "home":
            homeactive = "active";
            break;
        case "activity":
            activityactive = "active";
            break;
        case "group":
            sessionactive = "active";
            break;
        case "league":
            leagueexternalactive = "active";
            break;
        case "sports":
            leagueactive = "active";
            break;
        case "registration":
            registrationactive = "active";
            break;
        case "form":
            formactive = "active";
            break;
        case "contact":
            contactactive = "active";
            break;
        case "account":
            if (action == "team")
            {
                teamactive = "active";
            }
            else
            {
                accountactive = "active";
            }
            break;
        case "profile":
            profileactive = "active";
            break;
        case "accounting":
            accountingactive = "active";
            break;

    }
}

@functions
{
    public bool CanView(FeatureType featureType, UserType userType, PermissionType permissionType)
    {
        return SessionVariables.CurrentAccount.HasAccountPackageFeature(featureType) && Permissions.HasPermission(userType, permissionType);
    }
}

<div class="am-left-sidebar">
    <div class="content">
        <div class="am-logo hide"></div>

        <ul class="sidebar-elements">
            <li>
                <img src="/public/images/footer-icon.png" class="side-menu-logo" />
            </li>

            <li class="@homeactive"><a href="@Url.Action("index", "home")"><i class="icon s7-home"></i><span>Home</span></a></li>

            @if (CanView(FeatureType.Activities, SessionVariables.AccountUserType, PermissionType.ActivitiesView))
            {
                <li class="@activityactive"><a href="@Url.Action("index", "activity")"><i class="icon s7-gleam"></i> @UILabel.ActivityLabel(ActivityType.Activity, true)</a></li>
            }

            @if (CanView(FeatureType.ManageActivityGroups, SessionVariables.AccountUserType, PermissionType.SessionsView))
            {
                <li class="@sessionactive"><a href="@Url.Action("index", "group")"><i class="icon s7-date"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.Session, true)</a></li>
            }

            @if (CanView(FeatureType.ManageLeagues, SessionVariables.AccountUserType, PermissionType.LeaguesView))
            {
                <li class="@leagueactive"><a href="@Url.Action("indexleague", "group")"><i class="icon s7-ball"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.League, true)</a></li>
            }

            @if (CanView(FeatureType.ManageExternalLeagues, SessionVariables.AccountUserType, PermissionType.LeaguesView))
            {
                <li class="@leagueexternalactive"><a href="@Url.Action("indexexternal", "league")"><i class="icon s7-ball"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.League, true)</a></li>
            }

            @if (CanView(FeatureType.Participants, SessionVariables.AccountUserType, PermissionType.StudentsView))
            {
                <li class="@registrationactive"><a href="@Url.Action("index", "registration")"><i class="icon s7-id"></i> @UILabel.RegistrantLabel(true)</a></li>
            }

            @if (CanView(FeatureType.ManageForms, SessionVariables.AccountUserType, PermissionType.FormsView))
            {
                <li class="@formactive hide"><a href="@Url.Action("index", "form")"><i class="icon s7-note2"></i> Forms</a></li>
            }

            @if (CanView(FeatureType.ManageContacts, SessionVariables.AccountUserType, PermissionType.ContactsView))
            {
                <li class="@contactactive"><a href="@Url.Action("index", "contact")"><i class="icon s7-notebook"></i> Contacts</a></li>
            }

            @if (CanView(FeatureType.AcceptPayments, SessionVariables.AccountUserType, PermissionType.AccountingView))
            {
                <li class="@accountingactive"><a href="@Url.Action("index", "accounting")"><i class="icon s7-cash"></i> Accounting</a></li>
            }

            @if (CanView(FeatureType.TeamAccounts, SessionVariables.AccountUserType, PermissionType.TeamView))
            {
                <li class="@teamactive"><a href="@Url.Action("team", "account")"><i class="icon s7-users"></i> Staff</a></li>
            }

            @if (CanView(FeatureType.Activities, SessionVariables.AccountUserType, PermissionType.AccountSettingsView))
            {
                <li class="@accountactive"><a href="@Url.Action("edit", "account")"><i class="icon s7-edit"></i> Settings</a></li>
            }
            <li class="@profileactive"><a href="@Url.Action("edit", "user")"><i class="icon s7-user"></i><span>Profile</span></a></li>
            <li class=""><a href="@Url.Action("index", "logout", new { area = "" })"><i class="icon s7-power"></i> Logout</a></li>
        </ul>
        <!--Sidebar bottom content-->
    </div>
</div>
