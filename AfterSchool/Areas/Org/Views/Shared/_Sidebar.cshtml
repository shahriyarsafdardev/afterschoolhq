<div class="am-left-sidebar">
    <div class="content">
        <div class="am-logo hide"></div>

        <ul class="sidebar-elements">
            @if ((SessionVariables.AccountPackage.IsNotEmpty() &&
                    (SessionVariables.AccountPackage.IsFree || SessionVariables.AccountPackage.IsDuringTrial)) || SessionVariables.CurrentAccount.HasPaymentCard)
            {
                <li><a href="@Url.Action("index", "home")"><i class="icon s7-home"></i><span>Home</span></a></li>
                <li><a href="@Url.Action("index", "activity")"><i class="icon s7-gleam"></i> @UILabel.ActivityLabel(ActivityType.Activity, true)</a></li>
                if (SessionVariables.AccountPackage.HasFeature(FeatureType.ManageActivityGroups) && SessionVariables.CurrentAccount.AccountTypeId != AccountType.ActivityProvider)
                {
                    <li><a href="@Url.Action("index", "group")"><i class="icon s7-date"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.Session, true)</a></li>
                }
                if (SessionVariables.AccountPackage.HasFeature(FeatureType.ManageActivityGroups) && SessionVariables.CurrentAccount.AccountTypeId != AccountType.ActivityProvider)
                {
                    <li><a href="@Url.Action("index", "league")"><i class="icon s7-ball"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.League, true)</a></li>
                }
                <li><a href="@Url.Action("index", "registration")"><i class="icon s7-id"></i> @UILabel.RegistrantLabel(true)</a></li>
                if (SessionVariables.AccountPackage.HasFeature(FeatureType.ManageForms))
                {
                    <li><a href="@Url.Action("index", "form")"><i class="icon s7-note2"></i> Forms</a></li>
                }
                if (SessionVariables.AccountPackage.HasFeature(FeatureType.ManageContacts))
                {
                    <li><a href="@Url.Action("index", "contact")"><i class="icon s7-notebook"></i> Contacts</a></li>
                }
                if (SessionVariables.AccountUserType == UserType.Owner || SessionVariables.AccountUserType == UserType.Administrator)
                {
                    if (SessionVariables.AccountPackage.GetFeature(FeatureType.TeamAccounts).Max.Value > 0)
                    {
                        <li><a href="@Url.Action("team", "account")"><i class="icon s7-users"></i> Team</a></li>
                    }
                    <li><a href="@Url.Action("edit", "account")"><i class="icon s7-edit"></i> Settings</a></li>
                }
            }

            <li><a href="@Url.Action("edit", "user")"><i class="icon s7-user"></i><span>Profile</span></a></li>
            <li><a href="@Url.Action("index", "logout", new { area = "" })"><i class="icon s7-power"></i> Logout</a></li>
        </ul>
        <!--Sidebar bottom content-->
    </div>
</div>
