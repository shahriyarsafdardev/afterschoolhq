@{
    var controller = ViewContext.RouteData.Values["controller"].ToString().ToLower();
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();

    string homeactive = "",
        activityactive = "",
        leagueactive = "",
        sessionactive = "",
        registrationactive = "",
        volunteercontactsactive = "",
        formactive = "",
        contactactive = "",
        teamactive = "",
        accountactive = "",
        profileactive = "",
        accountingactive = "",
        leagueexternalactive = "",
        activitycenteractive = "",
        accountsubmenuactive = "",
        contactmenuactive = "";

    switch (controller)
    {
        case "activity":
        case "group":
        case "league":
            activitycenteractive = "active";
            break;
        case "account":
        case "user":
            accountsubmenuactive = "active";
            break;
        case "registration":
        case "contact":
            contactmenuactive = "active";
            break;
    }

    switch (controller)
    {
        case "home":
            homeactive = "active";
            break;
        case "activity":
            activityactive = "active";
            break;
        case "group":
            sessionactive = "active";
            leagueactive = "active";
            break;
        case "league":
            leagueexternalactive = "active";
            break;
        case "registration":
            var queryString = ViewContext.RequestContext.HttpContext.Request.QueryString;
            var isVolunteers = queryString.HasKeys() && queryString["volunteers"]?.ToLower() == "true";
            if (!isVolunteers && ViewBag.Volunteers != null)
            {
                string viewBagVolunteers = ViewBag.Volunteers.ToString();
                isVolunteers = viewBagVolunteers.IsBoolean() && viewBagVolunteers.ToBoolean();
            }
            if (isVolunteers)
            {
                volunteercontactsactive = "active";
            }
            else
            {
                registrationactive = "active";
            }

            break;
        case "form":
            formactive = "active";
            break;
        case "contact":
            contactactive = "active";
            break;
        case "account":
            if (action == "team")
            {
                teamactive = "active";
            }
            else
            {
                accountactive = "active";
            }
            break;
        case "user":
            profileactive = "active";
            break;
        case "accounting":
            accountingactive = "active";
            break;
    }
}

@functions
{
    public bool CanView(FeatureType featureType, UserType userType, PermissionType permissionType)
    {
        return SessionVariables.CurrentAccount.HasAccountPackageFeature(featureType) && Permissions.HasPermission(userType, permissionType);
    }

    public bool CanView(UserType userType, PermissionType permissionType)
    {
        return Permissions.HasPermission(userType, permissionType);
    }
}

<div class="am-left-sidebar">
    <div class="content">
        <div class="am-logo hide"></div>

        <ul class="sidebar-elements">
            <li>
                <img src="/assets/img/footer-icon.png" class="side-menu-logo"/>
            </li>

            <li class="@homeactive">
                <a href="@Url.Action("index", "home")">
                    <i class="icon s7-home"></i><span>Home</span>
                </a>
            </li>

            @if (SessionVariables.CurrentAccount.AccountTypeId.In(FormConstants.IndividualProviderAccountTypes))
            {
                if (CanView(SessionVariables.AccountUserType, PermissionType.ActivitiesView))
                {
                    <li class="@activityactive">
                        <a href="@Url.Action("index", "activity", new { type = (int)ActivityType.Activity })">
                            <i class="icon s7-gleam"></i> @UILabel.ActivityLabel(ActivityType.Activity, true)
                        </a>
                    </li>
                }
            }
            else
            {
                <li class="parent @activitycenteractive">
                    <a href="#">
                        <i class="icon s7-gleam"></i> <span>Activity Center</span>
                    </a>
                    <ul class="sub-menu">
                        @if (CanView(SessionVariables.AccountUserType, PermissionType.ActivitiesView))
                        {
                            <li>
                                <a href="@Url.Action("index", "activity", new { type = (int)ActivityType.Activity })"><i class="icon s7-gleam"></i> Extracurricular @UILabel.ActivityLabel(ActivityType.Activity, true)</a>
                            </li>
                        }
                        @if (CanView(FeatureType.ManageFieldTrips, SessionVariables.AccountUserType, PermissionType.FieldTripsView))
                        {
                            <li>
                                <a href="@Url.Action("index", "activity", new { type = (int)ActivityType.FieldTrip })">
                                    <i class="icon s7-compass"></i> @UILabel.ActivityLabel(ActivityType.FieldTrip, true)
                                </a>
                            </li>
                        }
                        @if (CanView(SessionVariables.AccountUserType, PermissionType.PermissionSlipsView))
                        {
                            <li>
                                <a href="@Url.Action("index", "activity", new { type = (int)ActivityType.PermissionSlip })">
                                    <i class="icon s7-file"></i> @UILabel.ActivityLabel(ActivityType.PermissionSlip, true)
                                </a>
                            </li>
                        }
                        @if (CanView(FeatureType.ManageLearningPods, SessionVariables.AccountUserType, PermissionType.LearningPodsView))
                        {
                            <li>
                                <a href="@Url.Action("index", "activity", new { type = (int)ActivityType.LearningPod })">
                                    <i class="icon s7-box2"></i> @UILabel.ActivityLabel(ActivityType.LearningPod, true)
                                </a>
                            </li>
                        }
                        @if (CanView(FeatureType.ManageActivityGroups, SessionVariables.AccountUserType, PermissionType.SessionsView))
                        {
                            <li class="">
                                <a href="@Url.Action("index", "group")">
                                    <i class="icon s7-date"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.Session, true)
                                </a>
                            </li>
                        }
                        @if (CanView(FeatureType.ManageLeagues, SessionVariables.AccountUserType, PermissionType.LeaguesView))
                        {
                            <li class="">
                                <a href="@Url.Action("indexleague", "group")">
                                    <i class="icon s7-ball"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.League, true)
                                </a>
                            </li>
                        }

                        @if (CanView(FeatureType.ManageExternalLeagues, SessionVariables.AccountUserType, PermissionType.LeaguesView))
                        {
                            <li class="">
                                <a href="@Url.Action("indexexternal", "league")">
                                    <i class="icon s7-ball"></i> @UILabel.ActivityGroupLabel(ActivityGroupType.League, true)
                                </a>
                            </li>
                        }
                        @if (CanView(FeatureType.ManageVolunteerOpportunities, SessionVariables.AccountUserType, PermissionType.VolunteerOpportunitiesView))
                        {
                            <li>
                                <a data-test="volunteer-opportunities" href="@Url.Action("index", "activity", new { type = (int)ActivityType.VolunteerOpportunity })">
                                    <i class="icon s7-smile"></i> Volunteer Opportunities
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }


            <li class="parent @contactmenuactive">
                <a href="#">
                    <i class="icon s7-id"></i> <span>Contacts</span>
                </a>
                <ul class="sub-menu">
                    @if (CanView(SessionVariables.AccountUserType, PermissionType.StudentsView))
                    {
                        <li class="@registrationactive">
                            <a href="@Url.Action("index", "registration")">
                                <i class="icon s7-id"></i> @UILabel.RegistrantLabel(true)
                            </a>
                        </li>
                    }
                    @if (CanView(FeatureType.ManageVolunteerOpportunities, SessionVariables.AccountUserType, PermissionType.VolunteerOpportunitiesView))
                    {
                        <li class="@volunteercontactsactive">
                            <a href="@Url.Action("index", "registration", new { volunteers = "true" })">
                                <i class="icon s7-smile"></i> @UILabel.RegistrantLabel(ActivityType.VolunteerOpportunity, true)
                            </a>
                        </li>
                    }

                    @if (CanView(SessionVariables.AccountUserType, PermissionType.ContactsView))
                    {
                        <li class="@contactactive">
                            <a href="@Url.Action("index", "contact")"><i class="icon s7-notebook"></i> Contacts</a>
                        </li>
                    }
                </ul>
            </li>

            @if (CanView(FeatureType.ManageForms, SessionVariables.AccountUserType, PermissionType.FormsView))
            {
                <li class="@formactive hide">
                    <a href="@Url.Action("index", "form")"><i class="icon s7-note2"></i> Forms</a>
                </li>
            }

            @if (CanView(FeatureType.AcceptPayments, SessionVariables.AccountUserType, PermissionType.AccountingView))
            {
                <li class="@accountingactive">
                    <a href="@Url.Action("index", "accounting")"><i class="icon s7-cash"></i> Accounting</a>
                </li>
            }
            @if (CanView(SessionVariables.AccountUserType, PermissionType.AccountSettingsView))
            {
                <li class="">
                    <a href="@SessionVariables.CurrentAccount.HomePageUrl?edit=1"><i class="icon s7-browser"></i> Edit Profile</a>
                </li>
            }

            <li class="parent @accountsubmenuactive">
                <a href="#">
                    <i class="icon s7-settings"></i> <span>Account &amp; Settings</span>
                </a>
                <ul class="sub-menu">

                    @if (CanView(SessionVariables.AccountUserType, PermissionType.AccountSettingsView))
                    {
                        <li class="@accountactive">
                            <a href="@Url.Action("edit", "account")"><i class="icon s7-edit"></i> Settings</a>
                        </li>
                    }
                    @if (CanView(FeatureType.TeamAccounts, SessionVariables.AccountUserType, PermissionType.TeamView))
                    {
                        <li class="@teamactive">
                            <a href="@Url.Action("team", "account")"><i class="icon s7-users"></i> Staff</a>
                        </li>
                    }
                    <li class="@profileactive">
                        <a href="@Url.Action("edit", "user")">
                            <i class="icon s7-user"></i> <span>User Profile</span>
                        </a>
                    </li>
                    @if (SessionVariables.CurrentUser.HasMultipleAccounts())
                    {
                        <li class="">
                            <a href="@Url.Action("switch", "logout", new { area = "" })"><i class="icon s7-shuffle"></i> Switch Accounts</a>
                        </li>
                    }
                    <li class="">
                        <a href="@Url.Action("index", "logout", new { area = "" })"><i class="icon s7-power"></i> Logout</a>
                    </li>
                </ul>
            </li>
        </ul>
        <!--Sidebar bottom content-->
    </div>
</div>