@model string
@{
    var fullscreenExitUrl = Model;
    var fullscreenExitText = (string)ViewBag.FullscreenExitText;
    var showFloatingExit = false;

    if (fullscreenExitUrl.IsBlank())
    {
        fullscreenExitUrl = (string)ViewBag.FullScreenExitUrl;
    }

    if (fullscreenExitText.IsBlank())
    {
        fullscreenExitText = "X";
    }

    if (ViewBag.ShowFloatingExit != null)
    {
        showFloatingExit = (bool)ViewBag.ShowFloatingExit;
    }
}

<div class="pull-right">
    <a href="@fullscreenExitUrl" class="btn btn-default">@Html.Raw(fullscreenExitText)</a>
</div>


