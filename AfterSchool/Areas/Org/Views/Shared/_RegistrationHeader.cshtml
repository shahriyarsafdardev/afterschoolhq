@{     
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
}
<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        <a href="@Url.Action("index", "registration")" class="btn btn-alt6@(actionName == "index" ? "-active" : "")">
            <i class="s7-graph2"></i>  Students
        </a>
        <a href="@Url.Action("messages", "registration")" class="btn btn-alt6@(actionName == "messages" ? "-active" : "")">
            <i class="s7-graph2"></i>  Messages
        </a>
    </div>
    <div class="hidden-lg hidden-sm hidden-md">
        <select class="form-control" onchange="location.href=this.value;">
            <option value="">Navigation</option>
            <option value="@Url.Action("index", "registration")">Students</option>
            <option value="@Url.Action("messages", "registration")">Messages</option>
        </select>
    </div>
</div>
