@{
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var showStudentCrm = SessionVariables.AccountPackage.HasFeature(FeatureType.StudentCRM);
    var studentCrmPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.StudentCRM, SessionVariables.AccountPackage);
    var isVolunteers = Request.QueryString["volunteers"] == "true";
    if (!isVolunteers && ViewBag.Volunteers != null)
    {
        string viewBagVolunteers = ViewBag.Volunteers.ToString();
        isVolunteers = viewBagVolunteers.IsBoolean() && viewBagVolunteers.ToBoolean();
    }
    var registrants = UILabel.RegistrantLabel(isVolunteers ? ActivityType.VolunteerOpportunity : ActivityType.Activity, true);
    var messagesUrl = isVolunteers ? Url.Action("messages", "registration", new {volunteers = "true"}) : Url.Action("messages", "registration");
}
<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        @if (showStudentCrm || studentCrmPackage == null)
        {
            <a href="@Url.Action("index", "registration", isVolunteers ? new {volunteers = "true"} : null)" class="btn btn-alt6@(actionName == "index" ? "-active" : "")">
                <i class="s7-graph2"></i> @(registrants)
            </a>
        }
        else
        {
            <a href="#" class="btn btn-alt6@(actionName == "index" ? "-active" : "")" onclick="return showUpgradeMyPlan('@(studentCrmPackage.Name)',@(studentCrmPackage.ID))">
                <i class="s7-graph2"></i> @(registrants)
            </a>
        }

        <a href="@messagesUrl" class="btn btn-alt6@(actionName == "messages" ? "-active" : "")">
            <i class="s7-graph2"></i> Messages
        </a>
    </div>
    <div class="hidden-lg hidden-sm hidden-md">
        @if (studentCrmPackage != null)
        {
            <select class="form-control" onchange="this.value === '#' ? showUpgradeMyPlan('@(studentCrmPackage.Name)',@(studentCrmPackage.ID)) : location.href = this.value;">
                <option value="">Navigation</option>
                @if (showStudentCrm)
                {
                    <option value="@Url.Action("index", "registration")">@(registrants)</option>
                }
                else
                {
                    <option value="#">Students</option>
                }

                <option value="@Url.Action("messages", "registration")">Messages</option>
            </select>
        }
    </div>
</div>