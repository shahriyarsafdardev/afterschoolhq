@model Account
@{ 
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;

    string email = (string)ViewBag.Email;
    string phone = (string)ViewBag.Phone;
    var location = (Location)ViewBag.Location; 
    var isProfileEmail = (bool)ViewBag.IsProfileEmail;
    var isProfilePhone = (bool)ViewBag.IsProfilePhone;
}

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

                <form class="form form-horizontal" method="post" action="@Url.Action("contactinfo", "onboarding")">

                    @{ Html.RenderPartial("~/Views/Shared/_Loaders.cshtml",
                            new ViewDataDictionary() {
                               { "count", 6 },
                               { "activeDotNumber", 3 }
                            });
                    }

                    <div class="col-md-12 onboarding-form-group">
                        <h1 class="text-center register-thankyou-2">Enter your contact information.</h1>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable"> PROFILE EMAIL ADDRESS</label>

                        <input type="text" class="form-control onboarding-input" name="email" id="email" value="@email" placeholder="" />
                        <div class="am-checkbox">
                            <input type="checkbox"
                                   name="publicemail"
                                   id="publicemail"
                                   value="@isProfileEmail"
                                   @(isProfileEmail ? "checked=\"checked\"" : "") />
                            <label for="publicemail">Show email on public profile page</label>
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable"> PROFILE PHONE NUMBER</label>

                        <input id="phone" type="text" class="form-control onboarding-input" name="phone" value="@phone" placeholder="ex. (317) 483 3489" />
                        <div class="am-checkbox">
                            <input type="checkbox"
                                   name="publicphone"
                                   id="publicphone"
                                   value="@isProfilePhone"
                                   @(isProfilePhone ? "checked=\"checked\"" : "") />
                            <label for="publicphone">Show phone number on public profile page</label>
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable">LOCATION</label>
                        @{ Html.RenderPartial("~/Views/Shared/Components/_GoogleLocationEditNew.cshtml", location); }
                    </div>

                    <div class="clearfix"></div>
                    <div class="visible-sm visible-xs margin-v-30">
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue">Save and Continue</button>

                        <div class="clearfix"></div>
                        <div class="text-center margin-v-30">
                            <a href="@Url.Action("additionalinfo", "onboarding")" class="text-muted">Back</a>
                        </div>
                    </div>

                    <div class="visible-md visible-lg margin-v-30">
                        <a href="@Url.Action("additionalinfo", "onboarding")" class="process-back">
                            <img src="~/img/welcome-back-arrow.PNG" />
                        </a>
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">Save and Continue</button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script type="text/javascript">

        var inputElement = document.getElementById('phone');
        inputElement.addEventListener('keydown', enforceFormat);
        inputElement.addEventListener('keyup', formatToPhone);

        //format phone number when we load
        if (inputElement && inputElement.value) {
            var input = inputElement.value.replace(/\D/g, '').substring(0, 10); // First ten digits of input only
            var zip = input.substring(0, 3);
            var middle = input.substring(3, 6);
            var last = input.substring(6, 10);

            if (input.length > 6) { inputElement.value = `(${zip}) ${middle} ${last}`; } //(xxx) xxx xxxx
            else if (input.length > 3) { inputElement.value = `(${zip}) ${middle}`; }
            else if (input.length > 0) { inputElement.value = `(${zip}`; }
        }

       
        $(document).ready(function () {
             //adding HTML5 required attribute to 'Location' here, so we can use Location Component partial view in any other Form also
            //where we might need not need it 'required'
            $("#location").attr("required", "required");
        })

    </script>
}
