@model Account
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";

    var hostAccounts = (List<Account>) ViewBag.HostAccounts;
}


<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                <div class="col-md-12 onboarding-form-group text-center">
                    <img src="~/Assets/img/tempsnip.png" class="img-responsive" style="display: initial;" />
                    <h1 class="text-center register-thankyou-2">Great Job!!</h1>
                </div>

                <div class="clearfix"></div>
                <div class="text-medium-small text-center">
                    <p class="padding-v-10 font-styling-18">
                        You have set up your @AfterSchoolLibrary.Helpers.Utilities.AppName() profile, completing the first step in joining our mission to enable education for children everywhere.
                    </p>
                </div>
                <div class="clearfix"></div>

                <div class="margin-v-30 text-center">
                    @if (!hostAccounts.Any())
                    {
                        <div>
                            <a id="btnGoProfile"
                               href="@Url.Action("editsetup", "activity", new {isnew = 1, type = (int) ActivityType.Activity})" 
                               class="btn btn-primary btn-free-profile">
                                Create Your First @UILabel.ActivityLabel(ActivityType.Activity)
                            </a>
                        </div>
                        <div class="padding-v-20">
                            <a href="@Url.Action("index", "activity")" class="text-muted text-small">Explore on my own</a> |
                            <a href="@Model.HomePageUrl" class="text-muted text-small">View My Profile</a>
                        </div>
                    }
                    else
                    {
                        <a id="btnGoProfile"
                           href="@Model.HomePageUrl" 
                           class="btn btn-primary btn-free-profile">
                            Go to Your Profile
                        </a>
                    }
                    
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
