@model Account
@{ Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml"; }

<style>
    .am-checkbox input[type="checkbox"] + label:before,
    .am-radio input[type="checkbox"] + label:before,
    .am-checkbox input[type="radio"] + label:before,
    .am-radio input[type="radio"] + label:before {
        content: "";
        width: 22px;
        height: 22px;
        display: inline-block;
        border: 2px solid #eaeaea;
        margin-right: 5px;
        font-size: 18px;
        font-family: 'Stroke 7';
        font-weight: normal;
        line-height: 19px;
        vertical-align: bottom;
        text-align: center;
        background-color: transparent;
        cursor: pointer;
        border-radius: 6px;
        margin-right: 12px;
        border: solid 1px #00c5a3;
    }
    .Create-your-profile {
        font-weight: bold;
        margin-left: 36px;
    }
    .div-hover:hover {
        background-color: #f0f0f0;
        border-radius: 6px;
    }
</style>
<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                <div class="col-md-12 onboarding-form-group text-center">
                    <img src="~/img/tempsnip.png" class="img-responsive" style="display: initial;" />
                    <h1 class="text-center register-thankyou-2">Great Job!!</h1>
                </div>

                <div class="clearfix"></div>
                <div class="text-medium-small text-center">
                    <p class="padding-v-10">
                        You have setup your @AfterSchoolLibrary.Helpers.Utilities.AppName() profile. You have completed the first step to enabling education for children everywhere.
                    </p>
                </div>
                <div class="clearfix"></div>
                <div class="div-center">
                    <div class="Rectangle">
                        <div class="div-hover" style=" padding: 10px;">
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       style="border-radius:6px"
                                       name="createprofile"
                                       id="createprofile" />
                                <label for="createprofile" class="Create-your-profile">Create your profile.</label>
                                <p class="text-paragraph">Parents need to know what you offer. This <br />helps us match parents to your program.</p>
                            </div>
                        </div>
                    </div><br />
                    <div class="Rectangle">
                        <div class="div-hover" style=" padding: 10px;">
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       style="border-radius:6px"
                                       name="createactivity"
                                       id="createactivity" />
                                <label for="createactivity" class="Create-your-profile">Create your first activity.</label>
                                <p class="text-paragraph">Adding your first activity informs parents of<br /> your program’s offerings and enables them<br /> to register online immediately.</p>
                            </div>
                        </div>
                    </div><br />
                    <div class="Rectangle">
                        <div class="div-hover" style=" padding: 10px;">
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       style="border-radius:6px"
                                       name="validateemail"
                                       id="validateemail" />
                                <label for="validateemail" class="Create-your-profile">Validate your email.</label>
                                <p class="text-paragraph">We need to confirm your identity before we<br /> publish your programs and activities.</p>
                            </div>
                        </div>
                    </div><br />
                    <div class="Rectangle">
                        <div class="div-hover" style=" padding: 10px;">
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       style="border-radius:6px"
                                       name="payment"
                                       id="payment" />
                                <label for="payment" class="Create-your-profile">Accept payments.</label>
                                <p class="text-paragraph">Let’s get you set up to make payments. This<br /> not only makes it easier for parents to pay,<br /> but you will also receive funds quicker.</p>
                            </div>
                        </div>
                    </div><br />                    
                </div>
                <div class="clearfix"></div>
                <div class="visible-sm visible-xs margin-v-30">
                    <a href="@Model.HomePageUrl?edit=1" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue">View Your Profile</a>
                </div>

                <div class="visible-md visible-lg margin-v-30">
                    <a href="@Model.HomePageUrl?edit=1" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">View Your Profile</a>
                </div>


                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>
