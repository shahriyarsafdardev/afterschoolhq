@model Account
@{ Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml"; }

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                <div class="col-md-12 onboarding-form-group text-center">
                    <img src="~/img/tempsnip.png" class="img-responsive" style="display: initial;" />
                    <h1 class="text-center register-thankyou-2">Great Job!!</h1>
                </div>

                <div class="clearfix"></div>
                <div class="text-medium-small">
                    <p class="padding-v-10">
                        You have setup your @AfterSchoolLibrary.Helpers.Utilities.AppName() profile. You have completed the first step to enabling education for children everywhere.
                    </p>
                </div>

                <div class="clearfix"></div>
                <div class="visible-sm visible-xs margin-v-30">
                    <a href="@Model.HomePageUrl?edit=1" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12">View Your Profile</a>
                </div>

                <div class="visible-md visible-lg margin-v-30">
                    <a href="@Model.HomePageUrl?edit=1" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">View Your Profile</a>
                </div>

            </div>
        </div>
    </div>
</div>
