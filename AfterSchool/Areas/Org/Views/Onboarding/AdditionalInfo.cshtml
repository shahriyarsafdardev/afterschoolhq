@model Account
@{ 
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var opencovid = (bool)ViewBag.OpenCovid;
    var elc = (bool)ViewBag.ELC;
    var isProgram = Model.AccountTypeId == AccountType.Teacher;
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <form class="form form-horizontal" method="post" action="@Url.Action("additionalinfo", "onboarding")">
        <div class="row">
            <div class="col-md-offset-3 col-md-6">

                <div class="form-group">
                    <label class="col-lg-3 control-label">
                        Providing services during COVID?
                    </label>
                    <div class="col-lg-9">
                        @{ Html.RenderPartial(
                                 "~/Views/Shared/_SwitchButton.cshtml",
                                 opencovid,
                                 new ViewDataDictionary() { { "checkboxname", "opencovid" }, { "checkboxid", "opencovid" } }); }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">
                        Are you an E-Learning Center?
                    </label>
                    <div class="col-lg-9">
                        @{ Html.RenderPartial(
                                  "~/Views/Shared/_SwitchButton.cshtml",
                                  elc,
                                  new ViewDataDictionary() { { "checkboxname", "elearningcenter" }, { "checkboxid", "elearningcenter" } }); }
                        <p class="text-muted">You will host/care for students to assist e-learning during the school day</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label"></label>
                    <div class="col-lg-9">
                        <div class="visible-sm visible-xs">
                            <button type="submit" class="btn btn-primary btn-lg btn-block">Save Changes &raquo;</button>
                        </div>

                        <div class="visible-sm visible-xs text-center margin-v-30">
                            <a href="@Url.Action("index", "onboarding")" class="text-muted">&laquo; Back</a>
                        </div>

                        <div class="visible-md visible-lg">
                            <a href="@Url.Action("index", "onboarding")" class="text-muted">&laquo; Back</a>
                            <button type="submit" class="btn btn-primary btn-lg pull-right">Save Changes &raquo;</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </form>

</div>
