@model Account
@{ 
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var opencovid = (bool)ViewBag.OpenCovid;
    var elc = (bool)ViewBag.ELC;
    var isVirtualProgram = (bool)ViewBag.IsVirtualProgram;
    var grades = (List<GradeLevel>)ViewBag.Grades;
    var gradeStart = (int)ViewBag.GradeStart;
    var gradeEnd = (int)ViewBag.GradeEnd;
    var ageStart = (int)ViewBag.AgeStart;
    var ageEnd = (int)ViewBag.AgeEnd;
    var isRestrictByGrade = (bool)ViewBag.IsRestrictByGrade;
    var costLow = (string)ViewBag.CostLow;
    var costHigh = (string)ViewBag.CostHigh;
    var headerText = $"Share info about your organization with parents.";
}

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">
                @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

                <form class="form form-horizontal" method="post" action="@Url.Action("additionalinfo", "onboarding")">

                    @{ Html.RenderPartial("~/Views/Shared/_Loaders.cshtml",
                              new ViewDataDictionary() {
                               { "count", 6 },
                               { "activeDotNumber", 2 }
      }); }

                    <div class="col-md-12 onboarding-form-group">
                        <h1 class="text-center register-thankyou-2">@headerText</h1>
                    </div>

                    @{Html.RenderPartial("~/Views/Shared/_RestrictBySelectionNew.cshtml", null, new ViewDataDictionary() {
                                    { "minGradeLevelId", gradeStart },
                                    { "MaxGradeLevelId", gradeEnd },
                                    { "grades", grades },
                                    { "ageStart", ageStart },
                                    { "ageEnd", ageEnd },
                                    { "restrictbygrade", isRestrictByGrade } }
                                        ); }

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable"> PRICE RANGE OF ACTIVITIES OFFERED </label>
                        <div class="clearfix"></div>
                        <div class="">
                            <div class="col-md-4 col-xs-12 padding-0">
                                <div class="input-group green-outline">
                                    <span class="input-group-addon">$</span>
                                    <input id="costlow" name="costlow" class="form-control" type="number" required="required" value="@costLow" onclick="this.select()" step=".01" onblur="checkLowHighValue()" style="height: 44px;">
                                </div>
                            </div>
                            <p class="col-md-1 col-xs-12 margin-v-10 desktop-text-center" style="color: #00c5a3; font-size: 16px;">
                                TO
                            </p>
                            <div class="col-md-4 col-xs-12 padding-0">
                                <div class="input-group green-outline">
                                    <span class="input-group-addon">$</span>
                                    <input id="costhigh" name="costhigh" class="form-control" type="number" required="required" value="@costHigh" onclick="this.select()" step=".01" onblur="checkLowHighValue()" style="height: 44px;">
                                </div>
                            </div>
                            <div class="col-lg-12 padding-0 text-muted margin-t-10" style="font-style:italic">If all of your programs are free enter 0 into both fields</div>
                        </div>

                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable"> PROVIDING SERVICES DURING COVID-19? </label>
                        <div class="clearfix"></div>
                        @{ Html.RenderPartial("~/Views/Shared/_SwitchButton.cshtml", opencovid, new ViewDataDictionary() {
                                        { "checkboxname", "opencovid" },
                                        { "checkboxid", "chkOpenCovid" },
                                        {"classname", "form-control onboarding-input " }
                                    }); }
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable"> ARE YOU AN E-LEARNING CENTER? </label>
                        <div class="clearfix"></div>

                        @{ Html.RenderPartial("~/Views/Shared/_SwitchButton.cshtml", elc, new ViewDataDictionary() {
                                        { "checkboxname", "elearningcenter" },
                                        { "checkboxid", "chkELearningCenter" },
                                        {"classname", "form-control onboarding-input " }
                                    }); }

                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-lable">  IS IT A VIRTUAL PROGRAM? </label>
                        <div class="clearfix"></div>

                        @{ Html.RenderPartial("~/Views/Shared/_SwitchButton.cshtml", isVirtualProgram, new ViewDataDictionary() {
                                        { "checkboxname", "isvirtualprogram" },
                                        { "checkboxid", "chkIsVirtualProgram" },
                                        {"classname", "form-control onboarding-input " }
                                    }); }
                    </div>

                    <div class="clearfix"></div>
                    <div class="visible-sm visible-xs margin-v-30">
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue">Save and Continue</button>

                        <div class="clearfix"></div>
                        <div class="text-center margin-v-30">
                            <a href="@Url.Action("index", "onboarding")" class="text-muted">Back</a>
                        </div>
                    </div>

                    <div class="visible-md visible-lg margin-v-30">
                        <a href="@Url.Action("index", "onboarding")" class="process-back">
                            <img src="~/img/welcome-back-arrow.PNG" />
                        </a>
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">Save and Continue</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<script>
    function checkLowHighValue() {
        var costLow = $("#costlow").val();
        var costHigh = $("#costhigh").val();
        if (costLow != "" && costHigh != "") {
            $("#costlow").val(parseFloat(costLow).toFixed(2));
            $("#costhigh").val(parseFloat(costHigh).toFixed(2));
            if (parseFloat(costLow) > parseFloat(costHigh)) {
                Notifications.showBar({
                    title: 'Error',
                    message: 'Please make the low cost range value less than high cost.',
                    success: false
                });
                $('#costlow').attr('style', 'height: 44px; border: 1px solid red');
                $('#costhigh').attr('style', 'height: 44px; border: 1px solid red');
                $('.register-continue').attr('disabled', "disabled");
                return false;
            }
            else {
                $('#costlow').attr('style', 'height: 44px;');
                $('#costhigh').attr('style', 'height: 44px;');
                $('.register-continue').removeAttr('disabled');
                return true;
            }
        }
        else if (costLow != "") {
            $("#costlow").val(parseFloat(costLow).toFixed(2));
        }
        else if (costHigh != "") {
            $("#costhigh").val(parseFloat(costHigh).toFixed(2));
        }
    }
</script>