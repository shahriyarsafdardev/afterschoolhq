@model Account
@{ Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";

    var programCategories = (List<AccountProperty>)ViewBag.ProgramCategories;
    var softSkills = (List<AccountProperty>)ViewBag.SoftSkills;
    var academicSubjects = (List<AccountProperty>)ViewBag.AcademicSubjects;
    var teachingMethods = (List<AccountProperty>)ViewBag.TeachingMethods;
    var serviceOffered = (List<AccountProperty>)ViewBag.ServiceOffered;
    var timeOffered = (List<AccountProperty>)ViewBag.TimeOffered;
    var pricingOption = (List<AccountProperty>)ViewBag.PricingOption;
    var specialNeedsOffering = (List<AccountProperty>)ViewBag.SpecialNeedsOffering;
    var programsAllDayDuringWorkWeek = (List<AccountProperty>) ViewBag.ProgramsAllDayDuringWorkWeek;
    var isProgramsAllDayDuringWorkWeek = false;
    var programsAllDayDuringWorkWeekCaptured = programsAllDayDuringWorkWeek.IsNotEmpty() && programsAllDayDuringWorkWeek.Any();
    if (programsAllDayDuringWorkWeekCaptured)
    {
        isProgramsAllDayDuringWorkWeek = programsAllDayDuringWorkWeek.FirstOrDefault()?.Value == "1";
    }
 }

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                <form class="form form-horizontal" method="post" action="@Url.Action("servicesoffered", "onboarding")">

                    @{ Html.RenderPartial("~/Views/Shared/_Loaders.cshtml",
                                 new ViewDataDictionary() {
                                 { "count", 6 },
                                 { "activeDotNumber", 5 }
                        });
                    }

                    <div class="col-md-12 onboarding-form-group">
                        <h1 class="text-center register-thankyou-2">Make it easy for parents to find your activity.</h1>
                    </div>

                    <div class="clearfix"></div>
                    <div style="">
                        <img src="~/Assets/img/client_success_manager_color.jpeg" class="manger-comment pull-left">
                        <div class="dialogbox pull-left">
                            <div class="dialogbox-body dialogBodyMargin">
                                <span class="tip tip-left tipTop"></span>
                                <div class="message text-center">
                                    <span>By adding categories, you enable parents to easily find the types of activities their children are interested in joining!</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group" style="margin-top:20px">
                        <label class="onboarding-label"> PROGRAM CATEGORIES (UP TO 3)</label>

                        <input type="text" class="form-control onboarding-input" name="programCategories" id="txtProgramCategories" data-role="tagsinput" value="@programCategories.Select(x => x.Value).ToStringList(",")" />
                        <p class="text-muted" style="padding: 5px 0; font-size: 14px;">Seprate with a comma (ex: Karate, Sports, Leadership)</p>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> SERVICES OFFERED</label>

                        <div class="clearfix"></div>
                        <div class="pull-left col-md-4" style="padding: 0;">
                            @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.ServicesOfferings.Take(6))
                            {
                                <div class="am-checkbox">
                                    <input type="checkbox"
                                           class="form-control onboarding-input"
                                           name="services-offered-@item.ToLower()"
                                           id="services-offered-@item.ToLower()"
                                           value="@item"
                                           @(serviceOffered.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                    <label for="services-offered-@item.ToLower()">@item</label>
                                </div>
                            }
                        </div>

                        <div class="pull-left col-md-4">
                            @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.ServicesOfferings.Skip(6))
                            {
                                <div class="am-checkbox">
                                    <input type="checkbox"
                                           class="form-control onboarding-input"
                                           name="services-offered-@item.ToLower()"
                                           id="services-offered-@item.ToLower()"
                                           value="@item"
                                           @(serviceOffered.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                    <label for="services-offered-@item.ToLower()">@item</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <span><a id="btn-onboarding-advanced-settings" href="#" onclick="return showAdvancedSettings(this)" class="pointer">Show More Options</a></span>

                        <div class="visible-lg">
                            <br />
                            <br />
                        </div>
                    </div>

                    <div class="onboarding-advanced-settings hide">

                        <div class="clearfix"></div>
                        <div class="col-md-12 onboarding-form-group">
                            <label class="onboarding-label">TIMES OFFERED</label>

                            <div class="clearfix"></div>
                            <div class="pull-left col-md-4" style="padding: 0;">
                                @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.OfferingTimes.Take(4))
                                {
                                    <div class="am-checkbox">
                                        <input type="checkbox"
                                               class="form-control onboarding-input"
                                               name="times-offered-@item.ToLower()"
                                               id="times-offered-@item.ToLower()"
                                               value="@item"
                                               @(timeOffered.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                        <label for="times-offered-@item.ToLower()">@item</label>
                                    </div>
                                }
                            </div>

                            <div class="pull-left">
                                @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.OfferingTimes.Skip(4))
                                {
                                    <div class="am-checkbox">
                                        <input type="checkbox"
                                               class="form-control onboarding-input"
                                               name="times-offered-@item.ToLower()"
                                               id="times-offered-@item.ToLower()"
                                               value="@item"
                                               @(timeOffered.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                        <label for="times-offered-@item.ToLower()">@item</label>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-md-12 onboarding-form-group">
                            <label class="onboarding-label">PRICING OPTIONS</label>

                            <div class="clearfix"></div>
                            <div class="pull-left" style="padding: 0;">
                                @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.PricingOptions)
                                {
                                    <div class="am-checkbox">
                                        <input type="checkbox"
                                               class="form-control onboarding-input"
                                               name="pricing-options-@item.ToLower()"
                                               id="pricing-options-@item.ToLower()"
                                               value="@item"
                                               @(pricingOption.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                        <label for="pricing-options-@item.ToLower()">@item</label>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-md-12 onboarding-form-group">
                            <label class="onboarding-label">SPECIAL NEEDS OFFERINGS</label>

                            <div class="clearfix"></div>
                            <div class="pull-left col-md-4" style="padding: 0;">
                                @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.SpecialNeedsOfferings.Take(8))
                                {
                                    <div class="am-checkbox">
                                        <input type="checkbox"
                                               class="form-control onboarding-input"
                                               name="special-needs-@item.ToLower()"
                                               id="special-needs-@item.ToLower()"
                                               value="@item"
                                               @(specialNeedsOffering.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                        <label for="special-needs-@item.ToLower()">@item</label>
                                    </div>
                                }

                            </div>

                            <div class="pull-left">
                                @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.SpecialNeedsOfferings.Skip(8))
                                {
                                    <div class="am-checkbox">
                                        <input type="checkbox"
                                               class="form-control onboarding-input"
                                               name="special-needs-@item.ToLower()"
                                               id="special-needs-@item.ToLower()"
                                               value="@item"
                                               @(specialNeedsOffering.Select(x => x.Value.ToLower()).Contains(item.ToLower()) ? "checked=\"checked\"" : "") />
                                        <label for="special-needs-@item.ToLower()">@item</label>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-md-12 onboarding-form-group">
                            <label class="onboarding-label">SOFT SKILLS (UP TO 10)</label>
                            <input type="text" name="softskills" id="softskills" class="form-control onboarding-input" data-role="tagsinput" value="@softSkills.Select(x => x.Value).ToStringList(",")" />
                            <p class="text-muted" style="padding: 5px 0; font-size: 14px;">ex: Leadership, Teamwork, Communication</p>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-md-12 onboarding-form-group">
                            <label class="onboarding-label">ACADEMIC SUBJECTS (UP TO 5)</label>
                            <input type="text" name="academicsubjects" id="academicsubjects" class="form-control onboarding-input" data-role="tagsinput" value="@academicSubjects.Select(x => x.Value).ToStringList(",")" />
                            <p class="text-muted" style="padding: 5px 0; font-size: 14px;">ex: Math, Science, Language Arts, Physical Education</p>
                        </div>

                        <div class="clearfix"></div>
                        <div class="col-md-12 onboarding-form-group">
                            <label class="onboarding-label">TEACHING METHODS (UP TO 3)</label>
                            <input type="text" name="teachingmethods" id="teachingmethods" class="form-control onboarding-input" data-role="tagsinput" value="@teachingMethods.Select(x => x.Value).ToStringList(",")" />
                            <p class="text-muted" style="padding: 5px 0; font-size: 14px;">ex: Project Based Learning, Team work, Games</p>
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> DO ANY OF YOUR PROGRAMS RUN ALL DAY DURING THE WORK WEEK?</label>

                        <div class="clearfix"></div>
                        <div class="pull-left col-md-12" style="padding: 0;">
                            <div class="am-radio inline">
                                <input type="radio" id="programsalldayduringworkweek-yes" name="programsalldayduringworkweek" class="form-control onboarding-input" value="1"/>
                                <label for="programsalldayduringworkweek-yes">YES</label>
                            </div>
                            <div class="am-radio inline">
                                <input type="radio" id="programsalldayduringworkweek-no" name="programsalldayduringworkweek" class="form-control onboarding-input" value="0"/>
                                <label for="programsalldayduringworkweek-no">NO</label>
                            </div>
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="visible-sm visible-xs margin-v-30">
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue">Save &amp; Continue</button>

                        <div class="clearfix"></div>
                        <div class="text-center margin-v-30">
                            <a href="@Url.Action("logo", "onboarding")" class="text-muted">Back</a>
                        </div>
                    </div>

                    <div class="visible-md visible-lg margin-v-30">
                        <a href="@Url.Action("logo", "onboarding")" class="process-back">
                            <img src="~/Assets/img/welcome-back-arrow.png" />
                        </a>
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">Save &amp; Continue</button>
                    </div>

                    <div class="clearfix"></div>
                    <div class="text-center">
                        <a href="@Url.Action("Links", "onboarding")" class="text-muted" style="font-size: 16px; font-weight: normal; font-stretch: normal; font-style: normal; line-height: normal; letter-spacing: normal; color: #979797; text-align: center; text-decoration: underline;">I'll do this later</a>
                    </div>


                    <div class="clearfix"></div>
                </form>

            </div>
        </div>
    </div>
</div>


@section head
{
    <link href="~/Assets/tagsinput/tagsinput.css" rel="stylesheet" type="text/css" />

    <style>
        .badge-info {
            background-color: #00c5a3;
        }
    </style>
}

@section scripts
{
    <script src="~/Assets/tagsinput/tagsinput.js"></script>
    <script>
        $('#txtProgramCategories').tagsinput({  
            maxTags: 3           
        });
        $('#softskills').tagsinput({
            maxTags: 10
        });
        $('#academicsubjects').tagsinput({
            maxTags: 5
        });
        $('#teachingmethods').tagsinput({
            maxTags: 3
        });

        var advanceSettings = $('.onboarding-advanced-settings');

        function showAdvancedSettings(element) {
            if (advanceSettings.attr('class').indexOf('hide') > -1) {
                advanceSettings.removeClass('hide');
                $(element).html('Hide More Options');
            } else {
                advanceSettings.addClass('hide');
                $(element).html('Show More Options');
            }
        }

        function setFormValuesOnLoad() {
            if (!@programsAllDayDuringWorkWeekCaptured.ToJSON())
                return;
            if (@isProgramsAllDayDuringWorkWeek.ToJSON())
                $('#programsalldayduringworkweek-yes').attr("checked", true);
            else
                $('#programsalldayduringworkweek-no').attr("checked", true);
        }

        PageEvent.add(PageEvent.AFTER_INIT, function()
            {
                setFormValuesOnLoad();
            }
        );
    </script>

}
