@model Account
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";

}

<div class="main-content">
    
    <form class="form form-horizontal" method="post" action="@Url.Action("servicesoffered", "onboarding")">
        <div class="row">
            <div class="col-md-offset-3 col-md-6">
                <div class="form-group">
                    <h1 class="text-center">Enter More Details</h1>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Program Categories (up to 3)</label>
                    <div class="col-lg-9">
                        <input type="text" name="programCategories" id="txtProgramCategories" class="form-control" data-role="tagsinput" value="@Request["programCategories"]" />
                        <p class="text-small text-muted">ex: Karate, Sports, Arts, Pottery, Dance, Football</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Services Offered</label>
                    <div class="col-lg-9">
                        @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.ServicesOfferings)
                        {
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       name="services-offered-@item.ToLower()"
                                       id="services-offered-@item.ToLower()"
                                       value="@item"
                                       @(Request[$"services-offered-{item.ToLower()}"].IsBoolean() ? "checked=\"checked\"" : "") />
                                <label for="services-offered-@item.ToLower()">@item</label>
                            </div>
                        }

                    </div>
                </div>

                <div class="form-group hide">
                    <label class="col-lg-3 control-label">Times offered</label>
                    <div class="col-lg-9">
                        @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.OfferingTimes)
                        {
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       name="times-offered-@item.ToLower()"
                                       id="times-offered-@item.ToLower()"
                                       value="@item"
                                       @(Request[$"times-offered-{item.ToLower()}"].IsBoolean() ? "checked=\"checked\"" : "") />
                                <label for="times-offered-@item.ToLower()">@item</label>
                            </div>
                        }

                    </div>
                </div>

                <div class="form-group hide">
                    <label class="col-lg-3 control-label">Pricing options</label>
                    <div class="col-lg-9">
                        @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.PricingOptions)
                        {
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       name="pricing-options-@item.ToLower()"
                                       id="pricing-options-@item.ToLower()"
                                       value="@item"
                                       @(Request[$"pricing-options-{item.ToLower()}"].IsBoolean() ? "checked=\"checked\"" : "") />
                                <label for="pricing-options-@item.ToLower()">@item</label>
                            </div>
                        }

                    </div>
                </div>

                <div class="form-group hide">
                    <label class="col-lg-3 control-label">Special Needs Offerings</label>
                    <div class="col-lg-9">
                        @foreach (var item in AfterSchoolLibrary.Helpers.ProfileHelper.SpecialNeedsOfferings)
                        {
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       name="special-needs-@item.ToLower()"
                                       id="special-needs-@item.ToLower()"
                                       value="@item"
                                       @(Request[$"special-needs-{item.ToLower()}"].IsBoolean() ? "checked=\"checked\"" : "") />
                                <label for="special-needs-@item.ToLower()">@item</label>
                            </div>
                        }

                    </div>
                </div>

                <div class="form-group hide">
                    <label class="col-lg-3 control-label">Soft Skills (up to 10)</label>
                    <div class="col-lg-9">
                        <input type="text" name="softskills" id="softskills" class="form-control" data-role="tagsinput" value="@Request["softskills"]" />
                        <p class="text-small text-muted">ex: Leadership, Teamwork, Communication</p>
                    </div>
                </div>

                <div class="form-group hide">
                    <label class="col-lg-3 control-label">Academic Subjects (up to 5)</label>
                    <div class="col-lg-9">
                        <input type="text" name="academicsubjects" id="academicsubjects" class="form-control" data-role="tagsinput" value="@Request["academicsubjects"]" />
                        <p class="text-small text-muted">ex: Math, Science, Language Arts, Physical Education</p>
                    </div>
                </div>

                <div class="form-group hide">
                    <label class="col-lg-3 control-label">Teaching Methods (up to 3)</label>
                    <div class="col-lg-9">
                        <input type="text" name="teachingmethods" id="teachingmethods" class="form-control" data-role="tagsinput" value="@Request["teachingmethods"]" />
                        <p class="text-small text-muted">ex: Project Based Learning, Team work, Games</p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label"></label>
                    <div class="col-lg-9">

                        <div class="visible-sm visible-xs">
                            <button type="submit" class="btn btn-primary btn-lg btn-block">Save Changes &raquo;</button>
                        </div>

                        <div class="visible-sm visible-xs text-center margin-v-30">
                            <a href="@Url.Action("Links", "onboarding")" class="text-muted">I'll do this later</a>
                        </div>

                        <div class="visible-md visible-lg">
                            <a href="@Url.Action("Links", "onboarding")" class="text-muted">I'll do this later</a>
                            <button type="submit" class="btn btn-primary btn-lg pull-right">Save Changes &raquo;</button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </form>

</div>


@section head
{
    <link href="~/Assets/tagsinput/tagsinput.css" rel="stylesheet" type="text/css" />

    <style>
        .badge-info {
            background-color: #00c5a3;
        }
    </style>
}

@section scripts
{
    <script src="~/Assets/tagsinput/tagsinput.js"></script>
    <script>
        $('#txtProgramCategories').tagsinput({
            maxTags: 3
        });
        $('#softskills').tagsinput({
            maxTags: 10
        });
        $('#academicsubjects').tagsinput({
            maxTags: 5
        });
        $('#teachingmethods').tagsinput({
            maxTags: 3
        });
    </script>

}