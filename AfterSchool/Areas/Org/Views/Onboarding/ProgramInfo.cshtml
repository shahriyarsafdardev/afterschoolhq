@model Account
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var title = (string)ViewBag.Title;
    var headline = (string)ViewBag.Headline;
    var isProgram = Model.AccountTypeId == AccountType.Teacher;
    var genderRestriction = ViewBag.GenderRestriction;

    var organizationLabel = Model.AccountTypeId.ToString().SplitByUpperCase();
    var organizationExampleNames = "";
    var headerText = $"Enter info about your organization.";

    if (Model.AccountTypeId == AccountType.ActivityProvider)
    {
        organizationLabel = "Organization";
        headerText = $"Enter info about your organization";
    }

    if (isProgram)
    {
        organizationLabel = "Program";
        headerText = "Let's get some info about your organization.";
        organizationExampleNames = "Ex. Math Club, Chess Club, Elite Track &amp; Field";
    } 
}

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

                <form class="form form-horizontal" method="post" action="@Url.Action("programinfo", "onboarding")">

                    @{ Html.RenderPartial("~/Views/Shared/_Loaders.cshtml",
                             new ViewDataDictionary() {
                               { "count", 6 },
                               { "activeDotNumber", 1 }
                             });
                    }

                    <div class="col-md-12 onboarding-form-group">
                        <h1 class="text-center register-thankyou-2">@headerText</h1>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> @organizationLabel.ToUpper() NAME</label>
                        <input id="title" name="title" class="form-control onboarding-input" type="text" required="required" value="@title" onclick="this.select()">
                        <p class="text-muted" style="padding: 5px 0;">@Html.Raw(organizationExampleNames)</p>
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> SHORT DESCRIPTION </label>
                        <input id="headline" name="headline" class="form-control onboarding-input" type="text" value="@headline">
                        <p class="text-muted" style="padding: 5px 0;">Short tagline describing what you do. Max 100 characters.</p>
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> MY PROGRAM IS DESIGNED FOR</label>
                        <div class="clearfix"></div>
                        <div class="am-radio program-radio">
                            <input type="radio"
                                   name="genderrestrictions"
                                   id="genderrestrictions-@((int)GenderRestrictionType.None)"
                                   value="@((int)GenderRestrictionType.None)"
                                   @(genderRestriction == (int)GenderRestrictionType.None ? "checked='true'" : "") />
                            <label for="genderrestrictions-@((int)GenderRestrictionType.None)">All Genders</label>
                        </div>
                        <div class="am-radio program-radio">
                            <input type="radio"
                                   name="genderrestrictions"
                                   id="genderrestrictions-@((int)GenderRestrictionType.MaleOnly)"
                                   value="@((int)GenderRestrictionType.MaleOnly)"
                                   @(genderRestriction == (int)GenderRestrictionType.MaleOnly ? "checked='true'" : "") />
                            <label for="genderrestrictions-@((int)GenderRestrictionType.MaleOnly)">Boys</label>
                        </div>
                        <div class="am-radio program-radio">
                            <input type="radio"
                                   name="genderrestrictions"
                                   id="genderrestrictions-@((int)GenderRestrictionType.FemaleOnly)"
                                   value="@((int)GenderRestrictionType.FemaleOnly)"
                                   @(genderRestriction == (int)GenderRestrictionType.FemaleOnly ? "checked='true'" : "") />
                            <label for="genderrestrictions-@((int)GenderRestrictionType.FemaleOnly)">Girls</label>
                        </div>
                    </div>
                    <div class="clearfix"></div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> TIMEZONE </label>
                        <div class="clearfix"></div>
                        <div style="padding: 0;">
                            <select id="select-program-timezone" class="form-control onboarding-input" name="timeZone" style="height: 44px;" required>
                                @foreach (var zone in new string[] { "Eastern - EST", "Central - CST", "Mountain - MST", "Pacific - PST", "Alaska - AKST", "Hawaii - HAST" })
                                {
                                    var selected = "";
                                    if (zone == Model.TimeZone.IfEmpty(""))
                                    {
                                        selected = " selected=\"selected\" ";
                                    }

                                    <option value="@zone" @selected>@zone</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="clearfix"></div>

                    <div class="visible-sm visible-xs margin-v-30">
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue">Save and Continue</button>
                    </div>

                    <div class="visible-md visible-lg margin-v-30">
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">Save and Continue</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>


<script type="text/javascript">
     PageEvent.add(
        PageEvent.AFTER_INIT,
         function (){             
            var selectClientTimeZone = $("#select-program-timezone");
            var modelTimeZone = '@Model.TimeZone';

            if (!modelTimeZone) {
                var clientTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

                if (appTimezones[clientTimeZone]) {
                    selectClientTimeZone.val(appTimezones[clientTimeZone]);
                } else {
                    // TODO: if user is outside of USA & creates account, what should be the default timezone?
                    selectClientTimeZone.val(appTimezones["America/New_York"]);
                }
            }

             $('#title').keyup(function (e) {
                 var titleLength = $('#title').val().length;

                 if (titleLength > 50) {
                     e.preventDefault();
                     e.stopPropagation();
                     this.value = this.value.substring(0, 50);
                     return false;
                 }
             });

             $('#headline').keyup(function (e) {
                 var headlineLength = $('#headline').val().length;

                 if (headlineLength > 100) {
                     e.preventDefault();
                     e.stopPropagation();
                     this.value = this.value.substring(0, 100);
                     return false;
                 }
             });
         });
</script>