@{ 
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    var gettingStartedOptions = (List<GettingStartedOptions>)ViewBag.GettingStartedOptions; 
}

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">
                @{ 
                    Html.RenderPartial("~/Views/Shared/_GettingStarted.cshtml",
                        new ViewDataDictionary() {
                            { "gettingStartedOptions", gettingStartedOptions },
                            { "url", Url.Action("GettingStarted", "onboarding") }
                        }
                    );
                }
            </div>
        </div>
    </div>
</div>