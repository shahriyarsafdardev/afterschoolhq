@model Account
@{ 
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var logoUrl = (string)ViewBag.LogoUrl;
    var headerImageUrl = (string)ViewBag.HeaderImageUrl;
    var accountPackage = (AccountPackage) ViewBag.AccountPackage;
    var totalStepCount = accountPackage.IsFree ? 6 : 5;
}

<div class="row main-content main-content-welcome-pages">
    <div class="welcome-box-width">
        <div class="welcome-outer-ring">
            <div class="onboarding-inner-ring">

                @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

                <form class="form form-horizontal" method="post" action="@Url.Action("logo", "onboarding")" enctype="multipart/form-data">

                    @{
                        Html.RenderPartial("~/Views/Shared/_Loaders.cshtml",
                            new ViewDataDictionary()
                            {
                                {"count", totalStepCount},
                                {"activeDotNumber", 4}
                            });
                    }

                    <div class="col-md-12 onboarding-form-group">
                        <h1 class="text-center register-thankyou-2">Customize your profile images.</h1>
                    </div>
                    <div class="clearfix"></div>
                    <div style="margin-top: 20px;">
                        <img src="~/Assets/img/client_success_manager_color.jpeg" class="manger-comment pull-left">
                        <div class="dialogbox pull-left">
                            <div class="dialogbox-body dialogBodyMargin">
                                <span class="tip tip-left tipTop"></span>
                                <div class="message text-center">
                                    <span>Adding images is a great way to capture the attention of parents and show students what your program is all about.</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> PROFILE IMAGE</label>

                        <input type="file" class="form-control onboarding-input" name="logo" id="logo" accept=".jpg,.jpeg,.png" style="height: 44px;" />
                        <p class="text-muted" style="padding: 5px 0;">Please upload your logo or headshot. A square logo is best with a size of 400px x 400px. File size should be no larger than 4MB</p>
                        <div class="col-sm-3">
                            @if (logoUrl.IsNotBlank())
                            {
                                <img src="@logoUrl" width="100" />
                            }
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label"> PROFILE HEADER IMAGE</label>

                        <input type="file" class="form-control onboarding-input" name="headerimage" id="headerimage" accept=".jpg,.jpeg,.png" style="height: 44px;" />
                        <p class="text-muted" style="padding: 5px 0;">Please select a header image, no larger than 4MB</p>
                        <div class="col-sm-3">
                            @if (headerImageUrl.IsNotBlank())
                            {
                                <img src="@headerImageUrl" width="100" />
                            }
                        </div>
                    </div>

                    <div class="clearfix"></div>
                    <div class="visible-sm visible-xs margin-v-30">
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue">Save &amp; Continue</button>

                        <div class="clearfix"></div>
                        <div class="text-center margin-v-30">
                            <a href="@Url.Action("contactinfo", "onboarding")" class="text-muted">Back</a>
                        </div>
                    </div>

                    <div class="visible-md visible-lg margin-v-30">
                        <a href="@Url.Action("contactinfo", "onboarding")" class="process-back">
                            <img src="~/Assets/img/welcome-back-arrow.png" />
                        </a>
                        <button type="submit" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue">Save &amp; Continue</button>
                    </div>

                    <div class="clearfix"></div>
                    <div class="text-center">
                        <a href="@Url.Action(accountPackage.IsFree ? "ServicesOffered" : "Links", "onboarding")" class="text-muted" style="font-size: 16px; font-weight: normal; font-stretch: normal; font-style: normal; line-height: normal; letter-spacing: normal; color: #979797; text-align: center; text-decoration: underline;">I'll do this later</a>
                    </div>

                    <div class="clearfix"></div>

                </form>

            </div>
        </div>
    </div>
</div>
