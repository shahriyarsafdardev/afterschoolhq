@model Account
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;

}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <form class="form form-horizontal" method="post" action="@Url.Action("logo", "onboarding")" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-offset-3 col-md-6">
                <div class="form-group">
                    <h1 class="text-center">Enter program info:</h1>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Profile Image</label>
                    <div class="col-lg-9">
                        <input type="file" class="form-control" name="logo" id="logo" accept=".jpg,.jpeg,.png" />
                        <p class="text-muted"><em>Please upload your logo or headshot. A square logo is best with a size of 400px x 400px. File size should be no larger than 2MB</em></p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label">Profile Header Image</label>
                    <div class="col-lg-9">
                        <input type="file" class="form-control" name="headerimage" id="headerimage" accept=".jpg,.jpeg,.png" />
                        <p class="text-muted"><em>Please select a header image, no larger than 4MB</em></p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-lg-3 control-label"></label>
                    <div class="col-lg-9">

                        <div class="visible-sm visible-xs">
                            <button type="submit" class="btn btn-primary btn-lg btn-block">Save Changes &raquo;</button>
                        </div>

                        <div class="visible-sm visible-xs text-center margin-v-30">
                            <a href="@Url.Action("ServicesOffered", "onboarding")" class="text-muted">I'll do this later</a>
                        </div>

                        <div class="visible-md visible-lg">
                            <a href="@Url.Action("ServicesOffered", "onboarding")" class="text-muted">I'll do this Later</a>
                            <button type="submit" class="btn btn-primary btn-lg pull-right">Save Changes &raquo;</button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </form>

</div>