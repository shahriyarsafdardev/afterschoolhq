
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;

}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="row">
        <div class="col-md-offset-3 col-md-6 col-lg-offset-4 col-lg-4">
            <div class="form-group text-center">
                <h1>I am creating an account for</h1>
            </div>
            <div class="form-group myself">
                <button type="button" class="btn btn-primary btn-xl btn-block" onclick="location.href='@Url.Action("setaccounttype", "onboarding", new { type = AccountType.Teacher })'">Myself</button>
            </div>
            <div class="form-group my-organization">
                <button type="button" class="btn btn-primary btn-xl btn-block" onclick="chooseType()">
                    My Organization
                </button>
            </div>
            <div class="my-organization-type hide">
                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-xl btn-block" onclick="location.href='@Url.Action("setaccounttype", "onboarding", new { type = AccountType.School })'">
                        My School
                    </button>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-xl btn-block" onclick="location.href='@Url.Action("setaccounttype", "onboarding", new { type = AccountType.CommunityCenter })'">
                        My Community Center
                    </button>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-xl btn-block" onclick="location.href='@Url.Action("setaccounttype", "onboarding", new { type = AccountType.Church })'">
                        My Church
                    </button>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-xl btn-block" onclick="location.href='@Url.Action("setaccounttype", "onboarding", new { type = AccountType.Business })'">
                        My Business
                    </button>
                </div>
                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-xl btn-block" onclick="location.href='@Url.Action("setaccounttype", "onboarding", new { type = AccountType.ActivityProvider })'">
                        My Non-profit
                    </button>
                </div>
                <div class="form-group">
                    <div class="margin-v-30 text-center">
                        <span onclick="reset()" class="pointer">&laquo; Back</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
    function chooseType() {
        $('.my-organization-type').removeClass('hide');
        $('.my-organization').addClass('hide');
        $('.myself').addClass('hide');
    }

    function reset() {
        $('.my-organization-type').addClass('hide');
        $('.my-organization').removeClass('hide');
        $('.myself').removeClass('hide');
    }
</script>