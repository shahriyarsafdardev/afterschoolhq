@model Account
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;

}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading hide">
            <i class="s7-edit"></i> Settings - Setup Payment Account
        </div>
        <div class="panel-body">
            <form class="form form-horizontal" method="post" action="@Url.Action("links", "onboarding")">
                <div class="row">
                    <div class="col-md-offset-3 col-md-6">
                        <div class="form-group">
                            <h1 class="text-center">Enter links:</h1>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                Website Url
                            </label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="website" id="website" value="@Request["website"]" placeholder="https://your-website.com" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                Twitter Handle
                            </label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="twitter" id="twitter" value="@Request["twitter"]" placeholder="@("@your_twitter_handle")" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                Instagram Handle
                            </label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="instagram" id="instagram" value="@Request["instagram"]" placeholder="@("@your_instagram_handle")" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                Facebook Page Url
                            </label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="facebook" id="facebook" value="@Request["facebook"]" placeholder="https://facebook.com/your-page" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                YouTube Url
                            </label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="youtube" id="youtube" value="@Request["youtube"]" placeholder="https://youtube.com/your-page" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                LinkedIn Url
                            </label>
                            <div class="col-md-9">
                                <input type="text" class="form-control" name="linkedin" id="linkedin" value="@Request["linkedin"]" placeholder="https://linkedin.com/your-page" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-sm-3 control-label"></label>
                            <div class="col-sm-9">
                                <a href="@Url.Action("Done", "onboarding")" class="text-muted">I'll do this Later</a>
                                <button type="submit" class="btn btn-primary btn-lg pull-right">Save Changes &raquo;</button>
                            </div>
                        </div>

                    </div>
                </div>
            </form>
        </div>

    </div>

</div>