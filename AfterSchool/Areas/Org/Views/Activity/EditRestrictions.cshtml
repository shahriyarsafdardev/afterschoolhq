@model Activity
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var isFullScreen = (bool)ViewBag.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", "");
            }
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editrestrictions", "activity", new { id = Model.Uid, isnew = Request["isnew"] })" class="form-horizontal">

                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editrestrictions", "next", true, true, Request))
                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(true, false))
                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editrestrictions", "prev", true, false, Request))

                    @{Html.RenderPartial("~/Views/Shared/_ActivityFormRestrictions.cshtml", Model);}

                    <div class="form-group">
                        <div class="col-sm-2 col-sm-offset-3">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editrestrictions", "prev", false, false, Request))
                        </div>
                        <div class="col-sm-5">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, false))
                        </div>
                        <div class="col-sm-2">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editrestrictions", "next", false, true, Request))
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>