@model Activity
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var activityMessages = (List<ActivityMessage>)ViewBag.ActivityMessages;
    var accountPackage = SessionVariables.AccountPackage;
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Messages", new ViewDataDictionary
              {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(Model.ActivityTypeId)},
              }); }
        </div>
        <div class="panel-body">
            @{Html.RenderPartial(
                "~/Views/Shared/_Messages.cshtml",
                activityMessages,
                new ViewDataDictionary
                {
                    { "SendNewMessageLink", Url.Action("messageadd", "activity", new { id = Model.Uid }) },
                    { "Account", currentAccount },
                    { "ViewLinkController", "activity" },
                    { "ViewLinkAction", "messages" },
                    { "ViewLinkId", Model.Uid.ToString() },
                    { "PagingModel", ViewBag.PagingModel },
                    { "ActivityType", Model.ActivityTypeId },
                }
                );}

        </div>
    </div>
</div>
