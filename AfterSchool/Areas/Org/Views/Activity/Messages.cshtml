@model Activity
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var activityMessages = (List<ActivityMessage>)ViewBag.ActivityMessages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Messages"); }
        </div>
        <div class="panel-body">
            @{Html.RenderPartial(
                "~/Views/Shared/_Messages.cshtml",
                activityMessages,
                new ViewDataDictionary()
                {
                    { "SendNewMessageLink", Url.Action("messageadd", "activity", new { id = Model.Uid }) },
                    { "Account", SessionVariables.CurrentAccount },
                    { "ViewLinkController", "activity" },
                    { "ViewLinkAction", "messages" },
                    { "ViewLinkId", Model.Uid.ToString() },
                    { "PagingModel", ViewBag.PagingModel },
                }
                );}

        </div>
    </div>
</div>
