@model Activity
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;

    var saveButtonCols = 7;
    var saveButtonPrimary = "btn-primary";
    if (!Model.ActivityGroupId.HasValue)
    {
        saveButtonCols = 5;
        saveButtonPrimary = "btn-default";
    }

    var fullscreen = Request["isnew"] == "1" && !Model.IsPublished;
    if (fullscreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!fullscreen)
{
    Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @if (!fullscreen)
    {
        Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model);
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }
            
            @if (fullscreen)
            {
                <div class="pull-right">
                    <a href="@Url.Action("index", "activity")" class="btn btn-default">X</a>
                </div>
            }
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editcost", "activity", new { id = Model.Uid, isnew = Request["isnew"] })" class="form-horizontal">

                    @if (Model.CanAcceptPayments())
                    {
                        if (!Model.ActivityGroupId.HasValue)
                        {
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editcost", "next", true, true, Request))
                        }
                        @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(true, false))
                        @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editcost", "prev", true, false, Request))
                    }

                    @{Html.RenderPartial("~/Views/Shared/_ActivityFormPayment.cshtml", Model);}

                    @if (Model.CanAcceptPayments())
                    {
                        <div class="form-group">
                            <div class="col-sm-2 col-sm-offset-3">
                                @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editcost", "prev", false, false, Request))
                            </div>
                            <div class="col-sm-@saveButtonCols">
                                @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, Model.ActivityGroupId.HasValue))
                            </div>

                            @if (!Model.ActivityGroupId.HasValue)
                            {
                                <div class="col-sm-2">
                                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editcost", "next", false, true, Request))
                                </div>
                            }

                        </div>
                    }
                </form>
            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>