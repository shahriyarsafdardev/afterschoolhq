@model Activity
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;

    var registrants = (List<Registrant>)ViewBag.Registrants;
    var body = ViewBag.Body;
    var registrantsPerColumn = Math.Ceiling(registrants.Count / 3.0).ToInteger();

    var accountPackage = SessionVariables.AccountPackage;
    var maxTextCount = accountPackage.HasFeature(FeatureType.TextMessaging)
        ? (int)accountPackage.GetFeature(FeatureType.TextMessaging).Max.Value
        : 0;
    var currentTextCount = ViewBag.TextCount != null ? (int)ViewBag.TextCount : 0;
    var textQuotaExceeded = currentTextCount >= maxTextCount;

    var maxEmailCount = accountPackage.HasFeature(FeatureType.EmailMessaging)
        ? (int)accountPackage.GetFeature(FeatureType.EmailMessaging).Max.Value
        : 0;
    var currentEmailCount = ViewBag.EmailCount != null ? (int)ViewBag.EmailCount : 0;
    var emailQuotaExceeded = currentEmailCount >= maxEmailCount;
    var emailMessagingPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.EmailMessaging, accountPackage);
    var textMessagingPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.TextMessaging, accountPackage);
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
    var activityType = Model.ActivityTypeId;
    var isVolunteer = activityType == ActivityType.VolunteerOpportunity;
    var registrantsLabel = UILabel.RegistrantLabel(activityType, true);
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Send Message", new ViewDataDictionary
              {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(activityType)},
              }); }
        </div>
        <div class="panel-body">
            <form method="post" id="message-form" action="@Url.Action("messageadd", "activity", new { id = Model.Uid })" class="form-horizontal">

                @if (registrants.Count == 0)
                {
                    <div>
                        <a href="@Url.Action("messages", "activity", new { id = Model.Uid })" class="btn btn-default pull-right">&laquo; Back to List</a>
                        <p>There are no @registrantsLabel.ToLower() with valid email addresses</p>
                    </div>
                }
                else
                {
                    <div class="form-group" id="subject-group">
                        <label class="col-sm-3 control-label">Message Reason</label>
                        <div class="col-sm-6">
                            <select name="subject" id="subject" class="form-control">
                                <option value="">Select a Message Reason...</option>
                                @{
                                    var reasons = isVolunteer ? FormConstants.VolunteerMessageReasons() : FormConstants.StudentMessageReasons();
                                    foreach (var reason in reasons)
                                    {
                                        <option value="@reason.ToString().SplitByUpperCase()">@reason.ToString().SplitByUpperCase()</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">Message Body</label>
                        <div class="col-sm-6">
                            <textarea name="body" id="body" required style="width: 100%" rows="5" class="form-control">@body</textarea>
                            <p class="text-muted">Max of 1000 characters</p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-3">
                            @if (!emailQuotaExceeded)
                            {
                                <div class="am-checkbox">
                                    <input type="checkbox" id="sendtostaff" name="sendtostaff" value="1" checked="checked" />
                                    <label for="sendtostaff">Send Email To Staff</label>
                                </div>
                            } else
                            {
                                 <div class="am-checkbox"  onclick="return showUpgradeMyPlan('@(emailMessagingPackage?.Name)', @(emailMessagingPackage?.ID))">
                                    <input type="checkbox" id="sendtostaff" name="sendtostaff" value="1" disabled="disabled" />
                                    <label for="sendtostaff">Send Email To Staff</label>
                                </div>
                            }
                        </div>

                        <div class="col-sm-3 hidden">
                            @if (!textQuotaExceeded)
                            {
                                <div class="am-checkbox">
                                    <input type="checkbox" id="sendtextmessages" name="sendtextmessages" value="0" />
                                    <label for="sendtextmessages">Send Text Messages</label>
                                </div>
                            }
                            else
                            {
                                <div class="am-checkbox" onclick="return showUpgradeMyPlan('@(textMessagingPackage?.Name)', @(textMessagingPackage?.ID))">
                                    <input type="checkbox" id="sendtextmessages" name="sendtextmessages" value="0" disabled="disabled" />
                                    <label for="sendtextmessages">Send Text Messages</label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">
                            Select @registrantsLabel<br />
                            <a href="javascript:selectAll()">Select All</a> | <a href="javascript:clearAll()">Clear All</a>
                        </label>
                        <div class="col-sm-6">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="col-md-4">
                                    @foreach (var registrant in registrants.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                                    {
                                        <div class="am-checkbox registrant" 
                                             data-has-email="@registrant.Email.IsNotEmpty().ToInteger()" 
                                             data-has-phone-number="@registrant.Phone.IsNotEmpty().ToInteger()">

                                            <input type="checkbox" 
                                                   class="chk-registrant" 
                                                   id="registrant-@registrant.ID" 
                                                   name="registrant-@registrant.ID" 
                                                   value="1" 
                                                   checked="checked" />

                                            <label for="registrant-@registrant.ID">
                                                @registrant.DisplayName.MaxChars(20, "...")
                                            </label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-6">
                            <div class="pull-left">
                                <a href="@Url.Action("messages", "activity", new { id = Model.Uid })" class="text-muted">
                                    &laquo; Cancel
                                </a>
                            </div>
                            <div class="pull-right">
                                <button id="send-btn" type="submit" class="btn btn-primary btn-lg btn-block pull-right">
                                    <i class="s7-mail"></i> Send Message to Selected @registrantsLabel &raquo;
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </form>
        </div>
    </div>

</div>

<script>
    function selectAll() {
        $('input[type="checkbox"].chk-registrant').each(function () {
            $(this).prop('checked', true);
        });
    }
    function clearAll() {
        $('input[type="checkbox"].chk-registrant').each(function () {
            $(this).prop('checked', false);
        });
    }
</script>