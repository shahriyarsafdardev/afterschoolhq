@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;

    var registrants = (List<Registrant>)ViewBag.Registrants;
    var registrantsPerColumn = Math.Ceiling(registrants.Count / 3.0).ToInteger();
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Send Message"); }
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("messageadd", "activity", new { id = Model.ID })" class="form-horizontal">

                @if (registrants.Count == 0)
                {
                    <div>
                        <a href="@Url.Action("messages", "activity", new { id = Model.ID })" class="btn btn-default pull-right">&laquo; Back to List</a>
                        <p>There are no @UILabel.RegistrantLabel(true).ToLower() with valid email addresses</p>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Subject</label>
                        <div class="col-sm-6">
                            <input type="text" name="subject" id="subject" maxlength="150" class="form-control" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">Body</label>
                        <div class="col-sm-6">
                            <div class="text-editor" id="body-div">
                            </div>
                            <textarea name="body" id="body" class="hide" required></textarea>
                            <!--
                            <textarea name="body" id="body" class="form-control" rows="10" required></textarea>
                            -->
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label">
                            Select @UILabel.RegistrantLabel(true)<br/>
                            <a href="javascript:selectAll()">Select All</a> | <a href="javascript:clearAll()">Clear All</a>
                        </label>
                        <div class="col-sm-6">
                            @for (int i = 0; i < 3; i++)
                            {
                                <div class="col-md-4">
                                    @foreach (var registrant in registrants.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                                    {
                                        <div class="am-checkbox">
                                            <input type="checkbox" id="registrant-@registrant.ID" name="registrant-@registrant.ID" value="1" checked="checked" />
                                            <label for="registrant-@registrant.ID">@registrant.DisplayName.MaxChars(20, "...")</label>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-6">
                            <button type="submit" class="btn btn-primary btn-lg btn-block pull-right"><i class="s7-diskette"></i> Send Message to Selected Registrants</button>
                        </div>
                    </div>
                }
            </form>
        </div>
    </div>

</div>

<script>
    function selectAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', true);
        });
    }
    function clearAll() {
        $('input[type="checkbox"]').each(function () {
            $(this).prop('checked', false);
        });
    }
</script>


<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('.text-editor').wysihtml5({
            toolbar: {
                'image': false,
                'color': false,
            }
        });

        $('.text-editor').on('blur', function () {
            $('#body').val($('#body-div').html());
        });
    });
</script>