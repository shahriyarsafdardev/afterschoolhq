@model Activity
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var activityId = (string)ViewBag.ActivityId;
    var IsScheduled = ViewBag.hasSchedule;

    var fullscreen = Request["isnew"] == "1" && !Model.IsPublished;
    if (fullscreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name); }

            @if (fullscreen)
            {
                Html.RenderPartial("_ExitFullScreen", "");
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editschedule", "activity", new { id = Model.Uid, isnew = Request["isnew"], source = Request["source"] })" class="form-horizontal">

                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editschedule", "next", true, true, Request))
                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(true, false))

                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/_ActivityFormSchedule.cshtml", 
                            (ActivitySchedule)ViewBag.Schedule, 
                            new ViewDataDictionary() { 
                                { "ActivityType", (int)Model.ActivityTypeId },
                                { "IsScheduled", IsScheduled }
                            });
                    }

                    <div class="form-group">
                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, false))
                        </div>
                        <div class="col-sm-3">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.NavButton(Model, "editschedule", "next", false, true, Request))
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">
    function validateSetup(flag, event, url) {
        var startDate = moment($('#startdate').val());
        var endDate = moment($('#enddate').val());
        var beginningTime = moment($('#dailystarttime').val(), 'h:mma');
        var endingTime = moment($('#dailyendtime').val(), 'h:mma');

        if (endDate.isBefore(startDate) || (endDate.isSame(startDate) && (endingTime.isSame(beginningTime) || endingTime.isBefore(beginningTime))))
        {
            Notifications.showBar({
                title: 'Error',
                message: 'Please make the end date after the start date.',
                success: false
            });

            event.preventDefault();
            return false;
        }
    }
</script>