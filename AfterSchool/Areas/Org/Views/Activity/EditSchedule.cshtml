@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Assemblers.Activity.EditScheduleResult
@{
    ViewBag.Title = Model.Account.Name;
    var msgs = Model.Messages;
    var hasSchedule = Model.Activity.HasSchedule;

    var fullscreen = Request["isnew"] == "1" && !Model.IsPublished;
    if (fullscreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
    var accountPackage = SessionVariables.AccountPackage;
    var currentUser = SessionVariables.CurrentUser;
}

@{ Html.RenderPartial("OrgAccountHeader", Model.Activity.AccountId.ToString(), new ViewDataDictionary
   {
       {"IsFullScreen", Model.IsFullScreen},
   }); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model.Activity,
           IsActivityLeader = Model.IsActivityLeader,
           IsFullScreen = Model.IsFullScreen,
           AccountPackage = accountPackage,
           CurrentAccount = Model.Account,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Activity.Name, new ViewDataDictionary
               {
                   {"IconClass", IconForActivityType.GetIconClassForActivityType(Model.Activity.ActivityTypeId)},
               }); }

            @if (fullscreen)
            {
                Html.RenderPartial("_ExitFullScreen", Model.FullScreenExitUrl);
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editschedule", "activity", new {id = Model.Activity.Uid, isnew = Request["isnew"], source = Request["source"]})" class="form-horizontal">

                    @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editschedule", "next", true, true, Request))
                    @Html.Raw(ActivitySetupHelper.SaveButton(true, false))

                    @{
                        if (Model.Activity.ActivityTypeId == ActivityType.VolunteerOpportunity)
                        {
                            Html.RenderPartial("_VolunteerFormSchedule", Model.Schedule, new ViewDataDictionary
                            {
                                {"ActivityType", (int) Model.Activity.ActivityTypeId}, 
                                {"hasSchedule", hasSchedule},
                                {"isContinuousEnrollmentEnabled", Model.Activity.IsContinuousEnrollment},
                            });
                        }
                        else
                        {
                            Html.RenderPartial("_ActivityFormSchedule", Model.Schedule, new ViewDataDictionary
                            {
                                {"ActivityType", (int) Model.Activity.ActivityTypeId},
                                {"hasSchedule", hasSchedule},
                                {"isContinuousEnrollmentEnabled", Model.Activity.IsContinuousEnrollment},
                                {"isDisabled", Model.Activity?.GetSubscriptionPlan() != null &&
                                Model.Activity.GetSubscriptionPlan().PaymentStartTypeId != PlanPaymentStartType.OnPeriodStart},
                                {"PaymentStartType", Model.Activity?.GetSubscriptionPlan()?.PaymentStartTypeId},
                            });
                        }
                    }

                    <div class="form-group">
                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                        </div>
                        <div class="col-sm-3">
                            @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editschedule", "next", false, true, Request))
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{ Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model.Activity, new ViewDataDictionary
                   {
                       {"ActiveMenu", Model.ActiveMenu},
                   }); }
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">
    function validateSetup(flag, event, url) {
        let startDate = moment($('#startdate').val());
        let endDate = moment($('#enddate').val());
        let beginningTime = moment($('#dailystarttime').val(), 'h:mma');
        let endingTime = moment($('#dailyendtime').val(), 'h:mma');

        if (endDate.isBefore(startDate) || (endDate.isSame(startDate) && (endingTime.isSame(beginningTime) || endingTime.isBefore(beginningTime))))
        {
            Notifications.showBar({
                title: 'Error',
                message: 'Please make the end date after the start date.',
                success: false
            });

            event.preventDefault();
            return false;
        }
    }
</script>