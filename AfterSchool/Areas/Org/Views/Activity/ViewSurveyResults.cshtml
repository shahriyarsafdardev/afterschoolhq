@model Activity
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var surveyResponse = (SurveyResponse)ViewBag.SurveyFeedback;
    var accountPackage = SessionVariables.AccountPackage;
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
}
@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">
    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }
    <div class="panel panel-default">
        <div class="panel-body surveypanelpadding">
            <div class="col-lg-6">
                <div style="font-size:22px">@ViewBag.RegistrantName</div>
                <div style="font-size:14px; "><a href="@Url.Action("ViewSurvey", "activity", new { id = surveyResponse.SurveyRequestId, activityId = Model.Uid })" style="color:#B2B2B4">@ViewBag.SurveyName | @(surveyResponse.CreateDate.IsNotEmpty() ? surveyResponse.CreateDate.Value.ToString("MMMM dd, yyyy") : "")</a></div>
            </div>
            <div class="col-lg-6">
                <div class="pull-right iconsViewResults">
                    <a href="@(ViewBag.PrevExists != null ? Url.Action("viewsurveyresults", "activity", new { id = ViewBag.PrevExists, activityId = Model.Uid }) : "javascript:void(0)")" style="color: #494949;" class="@(ViewBag.PrevExists != null ? "" : "noCursor")"><span class="s7-angle-left arrowBtns"></span></a>
                    <a href="@(ViewBag.NextExists != null ? Url.Action("viewsurveyresults", "activity", new { id = ViewBag.NextExists, activityId = Model.Uid }) : "javascript:void(0)")" style="color: #494949;" class="@(ViewBag.NextExists != null ? "" : "noCursor")"><span class="s7-angle-right arrowBtns"></span></a>
                </div>
            </div>
            <div style="clear:both"></div>
            <div class="row">
                @foreach (var question in (List<FormQuestionAnswer>)ViewBag.FormQuestionAnswers)
                {
                    if (question.FormQuestionQuestionTypeId != QuestionType.Audio && question.FormQuestionQuestionTypeId != QuestionType.Video && question.FormQuestionQuestionTypeId != QuestionType.FileUpload)
                    {
                        if (question.FormQuestionQuestionTypeId == QuestionType.TextArea || question.FormQuestionQuestionTypeId == QuestionType.TextBlock)
                        {
                            if (question.QuestionText.IsNotEmpty())
                            {
                                <div class="col-lg-12">
                                    <div class="viewSurvey">
                                        <div class="viewSurveyHead">@question.QuestionText</div>
                                        @if (question.Text.IsNotEmpty())
                                        {
                                            dynamic json = Newtonsoft.Json.JsonConvert.DeserializeObject(question.Text);
                                            <div class="viewSurveyAnswer">@Html.Raw(json.blocks[0].text)</div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else if (question.FormQuestionQuestionTypeId == QuestionType.Checkbox)
                        {
                            <div class="col-lg-12">
                                <div class="viewSurvey">
                                    <div class="viewSurveyHead">@question.QuestionText</div>
                                    <div class="viewSurveyAnswer">@(question.Text == "1" ? "True" : "False")</div>
                                </div>
                            </div>
                        }
                        else if (question.FormQuestionQuestionTypeId == QuestionType.DropDownList || question.FormQuestionQuestionTypeId == QuestionType.RadioList || question.FormQuestionQuestionTypeId == QuestionType.Rating || question.FormQuestionQuestionTypeId == QuestionType.Emoji)
                        {
                            <div class="col-lg-12">
                                <div class="viewSurvey">
                                    <div class="viewSurveyHead">@question.QuestionText</div>
                                    @if (question.Text.IsNotEmpty())
                                    {
                                        dynamic json = Newtonsoft.Json.JsonConvert.DeserializeObject(question.Text);
                                        if (question.FormQuestionQuestionTypeId == QuestionType.Rating)
                                        {
                                            <div class="viewSurveyAnswer">@Html.Raw(json[0].key)</div>
                                        }
                                        else if (question.FormQuestionQuestionTypeId == QuestionType.Emoji)
                                        {
                                            <div class="viewSurveyAnswer emoji">@Html.Raw(json[0].key)</div>
                                        }
                                        else
                                        {
                                            <div class="viewSurveyAnswer">@Html.Raw(json[0].value)</div>
                                        }
                                    }
                                </div>
                            </div>

                        }
                        else if (question.FormQuestionQuestionTypeId == QuestionType.CheckboxList)
                        {
                            var str = "";
                            if (question.Text.IsNotEmpty())
                            {
                                dynamic json = Newtonsoft.Json.JsonConvert.DeserializeObject(question.Text);

                                foreach (var item in json)
                                {
                                    if (str.IsNotEmpty())
                                    {
                                        str = str + ", " + item.value;
                                    }
                                    else
                                    {
                                        str = item.value;
                                    }

                                }
                            }
                            <div class="col-lg-12">
                                <div class="viewSurvey">
                                    <div class="viewSurveyHead">@question.QuestionText</div>
                                    <div class="viewSurveyAnswer">@str</div>
                                </div>
                            </div>
                        }
                        else if (question.FormQuestionQuestionTypeId == QuestionType.Photo)
                        {
                            <div class="col-lg-12">
                                <div class="viewSurvey">
                                    <div class="viewSurveyHead">@question.QuestionText</div>
                                    <div class="viewSurveyAnswer">
                                        @if (question.Text.IsNotEmpty())
                                        {
                                            <img src="@question.Text" style="max-height:350px;max-width: 100%;" />
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="col-lg-12">
                                <div class="viewSurvey">
                                    <div class="viewSurveyHead">@question.QuestionText</div>
                                    <div class="viewSurveyAnswer">@question.Text</div>
                                </div>
                            </div>
                        }
                    }
                    else if (question.FormQuestionQuestionTypeId == QuestionType.Audio)
                    {
                        <div class="col-lg-12">
                            <div class="viewSurvey">
                                <div class="viewSurveyHead">@question.QuestionText</div>
                                <div class="viewSurveyAnswer" style="height: 60px;">
                                    <div class="playPauseBtn" style="float:left; margin-right:10px">
                                        <i class="glyphicon glyphicon-play playbtn"></i>
                                    </div>
                                    <div class="waveformMain" style="max-width: 350px;height: 30px;overflow: hidden;">
                                        <div class="waveform"></div>
                                    </div>
                                    <input type="hidden" value="@question.Text" class="waveValue">
                                </div>
                            </div>
                        </div>
                    }
                    else if (question.FormQuestionQuestionTypeId == QuestionType.Video)
                    {
                        <div class="col-lg-12">
                            <div class="viewSurvey">
                                <div class="viewSurveyHead">@question.QuestionText</div>
                                <div class="viewSurveyAnswer">
                                    <iframe width="420" height="315" src="@question.Text" style="max-width: 100%;"></iframe>
                                </div>
                            </div>
                        </div>
                    }
                    else if (question.FormQuestionQuestionTypeId == QuestionType.FileUpload)
                    {
                        <div class="col-lg-12">
                            <div class="viewSurvey">
                                <div class="viewSurveyHead">@question.QuestionText</div>
                                <div class="viewSurveyAnswer">
                                    <a href="@question.Text" target="_blank">@question.Text</a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="https://cdn.jsdelivr.net/emojione/2.0.0/lib/js/emojione.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wavesurfer.js/3.3.1/wavesurfer.min.js"></script>
    <script>
        $(document).ready(function () {
            if ($('.waveform').length) {
                var wavesurfer = WaveSurfer.create({
                    container: '.waveform',
                    waveColor: '#494949',
                    progressColor: '#494949',
                    cursorColor: '#ffad49',
                    hideScrollbar: true,
                    responsive: true,
                    barWidth: 2,
                    barRadius: 2,
                    cursorWidth: 1,
                    height: 60,
                    barGap: null
                });


                wavesurfer.load($(".waveValue").val());
                $(".playbtn").on('click', function () {
                    if ($(this).hasClass('glyphicon-play')) {
                        $(this).removeClass('glyphicon-play');
                        $(this).addClass('glyphicon-pause');
                    }
                    else if ($(this).hasClass('glyphicon-pause')) {
                        $(this).removeClass('glyphicon-pause');
                        $(this).addClass('glyphicon-play');
                    }
                    wavesurfer.playPause();
                })

                wavesurfer.on('finish', function () {
                    wavesurfer.seekTo(0);
                    $('.playbtn').removeClass('glyphicon-pause');
                    $('.playbtn').addClass('glyphicon-play');
                });
            }


            if ($('.emoji').length) {
                function convert() {
                    var input = $(".emoji").html();
                    var output = emojione.shortnameToImage(input);
                    $(".emoji").html(output);
                    $(".emojione").attr('style', "height: 30px;");
                }
                convert();
            }
        })
    </script>
}
