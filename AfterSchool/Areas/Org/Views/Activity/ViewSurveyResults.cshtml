@model Activity
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var surveyFeedback = (SurveyFeedback)ViewBag.SurveyFeedback;
}
@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">
    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model); }
    <div class="panel panel-default">
        <div class="panel-body surveypanelpadding">
            <div class="col-lg-6">
                <div style="font-size:22px">@ViewBag.RegistrantName</div>
                <div style="font-size:14px; "><a href="@Url.Action("ViewSurvey", "activity", new { id = surveyFeedback.SurveyId, activityId = Model.Uid })" style="color:#B2B2B4">@ViewBag.SurveyName | @(surveyFeedback.CreateDate.IsNotEmpty() ? surveyFeedback.CreateDate.Value.ToString("MMMM dd, yyyy") : "")</a></div>
            </div>
            <div class="col-lg-6">
                <div class="pull-right iconsViewResults">
                    <a href="@(ViewBag.PrevExists != null ? Url.Action("viewsurveyresults", "activity", new { id = ViewBag.PrevExists, activityId = Model.Uid }) : "javascript:void(0)")" style="color: #494949;" class="@(ViewBag.PrevExists != null ? "" : "noCursor")"><span class="s7-angle-left arrowBtns"></span></a>
                    <a href="@(ViewBag.NextExists != null ? Url.Action("viewsurveyresults", "activity", new { id = ViewBag.NextExists, activityId = Model.Uid }) : "javascript:void(0)")" style="color: #494949;" class="@(ViewBag.NextExists != null ? "" : "noCursor")"><span class="s7-angle-right arrowBtns"></span></a>
                </div>
            </div>
            <div style="clear:both"></div>
            <div class="row">
                @foreach (var question in (List<FormQuestionAnswer>)ViewBag.FormQuestionAnswers)
                {
                    <div class="col-lg-12">
                        <div class="viewSurvey">
                            <div class="viewSurveyHead">@question.QuestionText</div>
                            <div class="viewSurveyAnswer">@question.Text</div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
