@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Assemblers.Activity.EditContactResult
@{
    ViewBag.Title = Model.Account.Name;
    var msgs = Model.Messages;
    var activityTitle = $"{(Model.Activity.ActivityGroupName.IsNotEmpty() ? $"{Model.Activity.ActivityGroupName} - " : "")}{Model.Activity.Name}";
    var isFullScreen = Model.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
    var accountPackage = SessionVariables.AccountPackage;
    var currentUser = SessionVariables.CurrentUser;
}

@{ Html.RenderPartial("OrgAccountHeader", Model.Activity.AccountId.ToString(), new ViewDataDictionary {{"IsFullScreen", Model.IsFullScreen}}); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_ActivityHeader", new ActivityHeaderModel
       {
           Activity = Model.Activity,
           IsActivityLeader = Model.IsActivityLeader,
           IsFullScreen = Model.IsFullScreen,
           AccountPackage = accountPackage,
           CurrentAccount = Model.Account,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", activityTitle, new ViewDataDictionary
               {
                   {"IconClass", IconForActivityType.GetIconClassForActivityType(Model.Activity.ActivityTypeId)},
               }); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", Model.FullScreenExitUrl);
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editcontact", "activity", new {id = Model.Activity.Uid, isnew = Request["isnew"], source = Request["source"]})" class="form-horizontal">

                    @if (Model.Activity.ActivityTypeId != ActivityType.Team)
                    {
                        @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editcontact", "next", true, true, Request))
                    }
                    @Html.Raw(ActivitySetupHelper.SaveButton(true, false))

                    @{
                        if (Model.Activity.ActivityTypeId == ActivityType.VolunteerOpportunity)
                        {
                            Html.RenderPartial("~/Views/Shared/_VolunteerFormContactInfo.cshtml", Model.Activity);
                        }
                        else
                        {
                            Html.RenderPartial("~/Views/Shared/_ActivityFormContactInfo.cshtml", Model.Activity, new ViewDataDictionary
                            {
                                {"Instructors", Model.Instructors},
                            });
                        }
                    }

                    <div class="form-group">
                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                        </div>
                        <div class="col-sm-3">
                            @if (Model.Activity.ActivityTypeId != ActivityType.Team)
                            {
                                @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editcontact", "next", false, true, Request))
                            }
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{ Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model.Activity, new ViewDataDictionary {{"ActiveMenu", Model.ActiveMenu}}); }
            </div>

        </div>
    </div>
</div>