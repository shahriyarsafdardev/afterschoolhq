@model Activity

@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var suryveyFeedbacks = (List<SurveyFeedback>)ViewBag.GetSurveyFeedback;
    var survey = (SurveyRequest)ViewBag.Survey;
}
@{Html.RenderPartial("OrgAccountHeader");}
<div class="main-content">
    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model); }
    <div class="panel panel-default">
        <div class="panel-body surveypanelpadding">
            <div class="row">
                <div class="col-lg-3">
                    <div style="font-size:22px">@survey.Name</div>
                    <div style="font-size:14px; color:#B2B2B4">@Model.Name | @(survey.CreateDate.IsNotEmpty() ? survey.CreateDate.Value.ToString("MMMM dd, yyyy") :"")</div>
                    <a href="@Url.Action("ExportCSV", "activity", new { id = Model.ID })" class="exportBtn" style="font-size:14px; color:#00ae85"  download>Export Survey Results</a>
                </div>
                <div class="col-lg-3">
                    <div class="surveyCheck">@suryveyFeedbacks.Count() Survey Sent</div>
                </div>
                <div class="col-lg-3">
                    <div class="surveyCheck">@suryveyFeedbacks.Where(a => a.SurveyFeedbackStatusTypeId == SurveyFeedbackStatus.Completed).Count() Completed</div>
                </div>
                <div class="col-lg-3">
                    <div class="pull-right">
                        <a href="javascript:void(0)" class="btn btn-success surveybtn" data-toggle="modal" data-target="#resendModal">Remind To All Incomplete</a>
                    </div>
                </div>
            </div>
            <div style="clear:both"></div>
            <div class="margin-t-35 mainTableDiv" id="exportable">
                <table class="table surveyTable">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Name</th>
                            <th>Status</th>
                            <th>Last Modified</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var surveyFeedback in suryveyFeedbacks)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("viewsurveyresults", "activity", new { id = surveyFeedback.ID, activityId = Model.Uid })" class="linkGreen">View</a>
                                </td>
                                <td>
                                   @surveyFeedback.GetCreatedBy().DisplayName
                                </td>
                                <td>
                                    @surveyFeedback.SurveyFeedbackStatusTypeId.ToString()
                                </td>
                                <td>
                                    @(surveyFeedback.LastModifiedDate.IsNotEmpty() ? survey.LastModifiedDate.Value.ToString("dd/MM/yyyy") : "")
                                </td>
                                <td>
                                    <a href="javascript:void(0)" class="linkGreen">Resend reminder</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="resendModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="border-radius: 10px;">
            
            <div class="modal-body">
               <div class="text-center" style="font-size: 22px;  font-weight: bold;color: #282828; margin-bottom:17px;">Resend to <span id="CountStudent">0</span> Student</div>
               <div class="text-center"><input type="button" class="btn btnNewColorSurvey" value="Send Survey" style="padding: 12px 72px;" /></div>
            </div>
           
        </div>
    </div>
</div>

@section scripts{
<script>
    $(document).ready(function () {
        $(".exportBtn").on('click', function () {
            setTimeout(function () { $("#modal-saving").addClass("hide"); }, 500);
        });
    })
</script>
}