@model AfterSchool.Areas.Org.Assemblers.Activity.SummaryResult
@{
    var participationObject = Model.ParticipationObject;
    var msgs = Model.Messages;
    var registrants = Model.Activity.GetRegistrantActivities();
    var schedule = Model.Schedule;
    var totalPaid = Model.TotalPaid;
    var registrantCount = registrants.Count;
    var waitingListCount = registrants.Count(x => x.AssignmentTypeId == RegistrationAssignmentType.WaitingList);

    var currentAccount = Model.CurrentAccount;
    var dates = registrants.Select(x => currentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString()).Distinct();

    var classes = Model.Activity.GetCompletedAttendance();
    var totalPresent = Model.Activity.GetAttendancePresentCount();
    var totalPossible = Model.Activity.GetAttendancePossibleCount();
    var totalAbsent = totalPossible - totalPresent;

    var isActivityLeader = !Model.IsActivityLeader.HasValue || Model.IsActivityLeader.Value;
    var attendanceRate = totalPresent > 0 ? (totalPresent.ToDouble() / (totalPresent + totalAbsent) * 100).Round(1).ToString("###.#") : "0";
    var accountPackage = Model.AccountPackage;
    var currentUser = Model.CurrentUser;
}

@{Html.RenderPartial("OrgAccountHeader", currentAccount.ID.Value.ToString(), new ViewDataDictionary
  {
      { "IsFullScreen", false }
  });}

<div class="main-content">

    @{ Html.RenderPartial("_RenderMessages", msgs); }

    @{ Html.RenderPartial("_ActivityHeader", new ActivityHeaderModel
       {
           Activity = Model.Activity,
           IsActivityLeader = Model.IsActivityLeader,
           IsFullScreen = false,
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading text-center-sm">
            @{Html.RenderPartial("_ActivityTitle", Model.Activity.Name + " - Summary"); }

            @if (isActivityLeader)
            {           
                <div class="pull-right visible-lg visible-md">
                    <a href="@Url.Action("EditSetup", "Activity", new {id = Model.Activity.Uid })" class="btn btn-default">Edit @UILabel.ActivityLabel(Model.Activity.ActivityTypeId) &raquo;</a>
                </div>
           
                <div class="visible-xs visible-sm">                
                    <a href="@Url.Action("EditSetup", "Activity", new {id = Model.Activity.Uid })" class="btn btn-default">Edit @UILabel.ActivityLabel(Model.Activity.ActivityTypeId) &raquo;</a>                
                </div>             

            }

        </div>
        <div class="panel-body">

            <div class="row">
                <div class="col-md-8">
                    <div class="col-md-6">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-toggle="counter" data-end="@registrantCount" data-decimals="0" data-suffix="" class="value">@registrantCount</div>
                                <div class="desc">Total @UILabel.RegistrantLabel(true)</div>
                            </div>
                            <div class="icon"><span class="s7-users"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">

                        @if (Model.Activity.CostPerRegistrant > 0 && Permissions.HasPermission(Model.AccountUserType, PermissionType.AccountingView))
                        {
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                                    <div class="desc">Total Paid</div>
                                </div>
                                <div class="icon"><span class="s7-cash"></span></div>
                            </div>
                        }
                        else
                        {
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-toggle="counter" data-end="@waitingListCount" data-decimals="0" data-suffix="" class="value">@waitingListCount</div>
                                    <div class="desc">On Waiting List</div>
                                </div>
                                <div class="icon"><span class="s7-users"></span></div>
                            </div>
                        }

                    </div>
                    <div class="col-md-6">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-toggle="counter" data-end="@classes.Count" data-decimals="0" data-suffix="" class="value">@classes.Count</div>
                                <div class="desc">Total @UILabel.ActivityLabel(Model.Activity.ActivityTypeId) Meetings</div>
                            </div>
                            <div class="icon"><span class="s7-users"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">

                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-end="@attendanceRate.IfBlank("0")" data-decimals="0" data-suffix="" class="value">@attendanceRate.IfBlank("0")%</div>
                                <div class="desc">Attendance Rate</div>
                            </div>
                            <div class="icon"><span class="s7-check-circle"></span></div>
                        </div>

                    </div>

                    @if (registrantCount > 0)
                    {
                        <div class="col-md-12">

                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    Registrations By Date
                                </div>
                                <div class="panel-body">
                                    <div id="registrantsbydate" style="height: 350px;"></div>
                                </div>
                            </div>

                        </div>
                    }

                </div>

                <div class="col-md-4">
                    
                    @if (!Model.Activity.IsFree)
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Pricing
                                @if (isActivityLeader)
                                {
                                    <div class="pull-right">
                                        <a href="@Url.Action("EditCost", "Activity", new { id = Model.Activity.Uid })" class="btn btn-sm btn-link">Edit &raquo;</a>
                                    </div>
                                }
                            </div>
                            <div class="panel-body">
                                @if (participationObject.PostPayPlans.Any())
                                {
                                    Html.RenderPartial("ParticipationObject/_TuitionAndPostPayPlans", new ParticipationObjectViewModel
                                    {
                                        IsCheckoutCost = false,
                                        ParticipationObject = participationObject,
                                    });
                                }
                                else if (!participationObject.PaymentPlans.Any())
                                {
                                    Html.RenderPartial("ParticipationObject/_TuitionAndNoPaymentPlans", new ParticipationObjectViewModel
                                    {
                                        IsCheckoutCost = false,
                                        ParticipationObject = participationObject,
                                    }, new ViewDataDictionary{{"CurrentAccount", currentAccount}});
                                }
                                else
                                {
                                    Html.RenderPartial("ParticipationObject/_TuitionAndPaymentPlans", new ParticipationObjectViewModel
                                    {
                                        IsCheckoutCost = false,
                                        ParticipationObject = participationObject,
                                    });
                                }
                            </div>
                        </div>
                    }

                    @if (schedule.IsNotEmpty())
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Schedule

                                @if (isActivityLeader)
                                {
                                    <div class="pull-right">
                                        <a href="@Url.Action("EditSchedule", "Activity", new { id = Model.Activity.Uid })" class="btn btn-sm btn-link">Edit &raquo;</a>
                                    </div>
                                }

                            </div>
                            <div class="panel-body">
                                @{ Html.RenderPartial("_ActivityScheduleHtml", schedule); }
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        new Morris.Bar({
            // ID of the element in which to draw the chart.
            element: 'registrantsbydate',
            // Chart data records -- each entry in this array corresponds to a point on
            // the chart.
            data: [
                @foreach(var date in dates){
                    @:{ date: '@date', value: @registrants.Count(x => currentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString() == date) },
                }
            ],
            // The name of the data record attribute that contains x-values.
            xkey: 'date',
            // A list of names of data record attributes that contain y-values.
            ykeys: ['value'],
            // Labels for the ykeys -- will be displayed when you hover over the
            // chart.
            labels: ['Registrations'],
            resize: true,
            barColors: ['#3d3c3c']
        });
    });

    

</script>
