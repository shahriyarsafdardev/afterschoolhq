@model Activity
@{
    var participationObject = (ParticipationObject)ViewBag.ParticipationObject;
    var msgs = (SystemMessages)ViewBag.Messages;
    var actions = (List<SessionAction>)ViewBag.Actions;
    var registrants = Model.GetRegistrantActivities();
    var schedule = (ActivitySchedule)ViewBag.Schedule;
    var totalPaid = (decimal)ViewBag.TotalPaid;
    int registrantCount = registrants.Count;
    int waitingListCount = registrants
        .Where(x => x.AssignmentTypeId == RegistrationAssignmentType.WaitingList)
        .Count();

    var dates = registrants.Select(x => SessionVariables.CurrentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString()).Distinct();

    var classes = Model.GetCompletedAttendance();
    var totalPresent = Model.GetAttendancePresentCount();
    var totalPossible = Model.GetAttendancePossibleCount();
    var totalAbsent = totalPossible - totalPresent;
    var attendanceRate = "0";
    var isActivityLeader = true;

    if (ViewBag.IsActivityLeader != null)
    {
        isActivityLeader = (bool)ViewBag.IsActivityLeader;
    }

    if (totalPresent > 0) {
        attendanceRate = ((totalPresent.ToDouble() / (totalPresent + totalAbsent)) * 100).Round(1).ToString("###.#");
    }
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model); }

    <div class="panel panel-default">
        <div class="panel-heading text-center-sm">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Summary"); }

            @if (isActivityLeader)
            {           
                <div class="pull-right visible-lg visible-md">
                    <a href="@Url.Action("editsetup", "activity", new {id = Model.Uid })" class="btn btn-default">Edit @UILabel.ActivityLabel(Model.ActivityTypeId) &raquo;</a>
                </div>
           
                <div class="visible-xs visible-sm">                
                    <a href="@Url.Action("editsetup", "activity", new {id = Model.Uid })" class="btn btn-default">Edit @UILabel.ActivityLabel(Model.ActivityTypeId) &raquo;</a>                
                </div>             

            }

        </div>
        <div class="panel-body">

            <div class="row">
                <div class="col-md-8">
                    <div class="col-md-6">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-toggle="counter" data-end="@registrantCount" data-decimals="0" data-suffix="" class="value">@registrantCount</div>
                                <div class="desc">Total @UILabel.RegistrantLabel(true)</div>
                            </div>
                            <div class="icon"><span class="s7-users"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">

                        @if (Model.CostPerRegistrant > 0 && Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView))
                        {
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                                    <div class="desc">Total Paid</div>
                                </div>
                                <div class="icon"><span class="s7-cash"></span></div>
                            </div>
                        }
                        else
                        {
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-toggle="counter" data-end="@waitingListCount" data-decimals="0" data-suffix="" class="value">@waitingListCount</div>
                                    <div class="desc">On Waiting List</div>
                                </div>
                                <div class="icon"><span class="s7-users"></span></div>
                            </div>
                        }

                    </div>
                    <div class="col-md-6">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-toggle="counter" data-end="@classes.Count" data-decimals="0" data-suffix="" class="value">@classes.Count</div>
                                <div class="desc">Total @UILabel.ActivityLabel(Model.ActivityTypeId) Meetings</div>
                            </div>
                            <div class="icon"><span class="s7-users"></span></div>
                        </div>
                    </div>
                    <div class="col-md-6">

                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-end="@attendanceRate.IfBlank("0")" data-decimals="0" data-suffix="" class="value">@attendanceRate.IfBlank("0")%</div>
                                <div class="desc">Attendance Rate</div>
                            </div>
                            <div class="icon"><span class="s7-check-circle"></span></div>
                        </div>

                    </div>

                    @if (registrantCount > 0)
                    {
                        <div class="col-md-12">

                            <div class="panel panel-default">
                                <div class="panel-heading">
                                    Registrations By Date
                                </div>
                                <div class="panel-body">
                                    <div id="registrantsbydate" style="height: 350px;"></div>
                                </div>
                            </div>

                        </div>
                    }

                </div>

                <div class="col-md-4">
                    
                    @if (!Model.IsFree)
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Pricing
                                @if (isActivityLeader)
                                {
                                    <div class="pull-right">
                                        <a href="@Url.Action("editcost", "activity", new { id = Model.Uid })" class="btn btn-sm btn-link">Edit &raquo;</a>
                                    </div>
                                }
                            </div>
                            <div class="panel-body">
                                @if (participationObject.PostPayPlans.Any())
                                {
                                    Html.RenderPartial("~/Views/Shared/ParticipationObject/_TuitionAndPostPayPlans.cshtml", participationObject);
                                }
                                else if (!participationObject.PaymentPlans.Any())
                                {
                                    Html.RenderPartial("~/Views/Shared/ParticipationObject/_TuitionAndNoPaymentPlans.cshtml", participationObject);
                                }
                                else
                                {
                                    Html.RenderPartial("~/Views/Shared/ParticipationObject/_TuitionAndPaymentPlans.cshtml", participationObject);
                                }
                            </div>
                        </div>
                    }

                    @if (schedule.IsNotEmpty())
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                Schedule

                                @if (isActivityLeader)
                                {
                                    <div class="pull-right">
                                        <a href="@Url.Action("editschedule", "activity", new { id = Model.Uid })" class="btn btn-sm btn-link">Edit &raquo;</a>
                                    </div>
                                }

                            </div>
                            <div class="panel-body">
                                @{
                                    Html.RenderPartial("~/Views/Shared/_ActivityScheduleHtml.cshtml", schedule);
                                }
                            </div>
                        </div>
                    }

                    @{ Html.RenderPartial("_Actions", actions, new ViewDataDictionary() { { "account", SessionVariables.CurrentAccount } }); }
                </div>

            </div>
        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        new Morris.Bar({
            // ID of the element in which to draw the chart.
            element: 'registrantsbydate',
            // Chart data records -- each entry in this array corresponds to a point on
            // the chart.
            data: [
                @foreach(var date in dates){
                    @:{ date: '@date', value: @registrants.Where(x => SessionVariables.CurrentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString() == date).Count() },
                }
            ],
            // The name of the data record attribute that contains x-values.
            xkey: 'date',
            // A list of names of data record attributes that contain y-values.
            ykeys: ['value'],
            // Labels for the ykeys -- will be displayed when you hover over the
            // chart.
            labels: ['Registrations'],
            resize: true,
            barColors: ['#3d3c3c']
        });
    });

    

</script>
