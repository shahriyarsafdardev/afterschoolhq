@model Attendance
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var registrants = Model.GetAttendanceRegistrants();
}

@{Html.RenderPartial("OrgAccountHeader", Model.ActivityAccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model.ToActivity(true));}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.ActivityName + " - Attendance"); }
        </div>
        <div class="panel-body">

            <div class="col-md-10 col-md-offset-1">
                
                @{
                    Html.RenderPartial(
                      "~/Views/Shared/_RegistrantAttendance.cshtml",
                      Model,
                      new ViewDataDictionary()
                      {
                          { "AttendanceRegistrants", ViewBag.AttendanceRegistrants },
                          { "Schedule", ViewBag.Schedule },
                          { "RegistrantActivity", ViewBag.RegistrantActivity },
                          { "Controller", "activity" },
                      });
                }

            </div>
        </div>
    </div>
</div>

