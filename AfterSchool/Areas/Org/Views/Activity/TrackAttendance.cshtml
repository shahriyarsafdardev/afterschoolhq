@model Attendance
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = SessionVariables.AccountPackage;
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
    var activity = Model.ToActivity(true);
}

@{Html.RenderPartial("OrgAccountHeader", Model.ActivityAccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = activity,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.ActivityName + " - Attendance", new ViewDataDictionary
              {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(activity.ActivityTypeId)},
              }); }
        </div>
        <div class="panel-body">

            <div class="col-md-10 col-md-offset-1">
                
                @{
                    Html.RenderPartial(
                      "~/Views/Shared/_RegistrantAttendance.cshtml",
                      Model,
                      new ViewDataDictionary
                      {
                          { "AttendanceRegistrants", ViewBag.AttendanceRegistrants },
                          { "Schedule", ViewBag.Schedule },
                          { "RegistrantActivities", ViewBag.RegistrantActivities },
                          { "Controller", "activity" },
                      });
                }

            </div>
        </div>
    </div>
</div>

