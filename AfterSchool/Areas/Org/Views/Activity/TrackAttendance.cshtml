@model Attendance
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var currentAccount = (Account)ViewBag.CurrentAccount;
    var currentUser = (WebUser)ViewBag.CurrentUser;
    var activity = Model.ToActivity(true);
}

@{Html.RenderPartial("OrgAccountHeader", Model.ActivityAccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = activity,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.ActivityName + " - Attendance", new ViewDataDictionary
              {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(activity.ActivityTypeId)},
              }); }
        </div>
        <div class="panel-body">

            <div class="col-md-10 col-md-offset-1">
                
                @{
                    if(AccountPackageFeature.HasAccountPackageByFeatureTypeId(accountPackage.ID.Value,FeatureType.ManageCheckInCheckOut) &&
                       activity.IsRequireCheckInCheckOut.IsNotEmpty() && activity.IsRequireCheckInCheckOut)
                    {
                        if(activity.HasSchedule && !activity.GetSchedule().IsOngoing)
                        {
                            Html.RenderPartial(
                           "_CheckInOutAttendance",
                           Model,
                           new ViewDataDictionary
                           {
                                { "AttendanceRegistrants", ViewBag.AttendanceRegistrants },
                                { "Schedule", ViewBag.Schedule },
                                { "RegistrantActivities", ViewBag.RegistrantActivities },
                                { "Controller", "activity" },
                                { "CurrentAccount", ViewBag.CurrentAccount },
                           });
                        }
                        else {
                            Html.RenderPartial(
                                "_CICOAttendanceNoSchedule",
                                Model,
                                new ViewDataDictionary
                                {
                                { "AttendanceRegistrants", ViewBag.AttendanceRegistrants },
                                { "RegistrantActivities", ViewBag.RegistrantActivities },
                                { "Controller", "activity" },
                                {"AttendanceList",ViewBag.AttendanceList },
                                });
                        }
                    }
                    else
                    {
                        if (!activity.HasSchedule || (activity.HasSchedule && activity.GetSchedule().IsOngoing))
                        {
                            Html.RenderPartial(
                            "~/Views/Shared/_RegistrantAttendanceNoSchedule.cshtml",
                            Model,
                            new ViewDataDictionary
                            {
                                { "AttendanceRegistrants", ViewBag.AttendanceRegistrants },
                                { "RegistrantActivities", ViewBag.RegistrantActivities },
                                { "Controller", "activity" },
                                 {"AttendanceList",ViewBag.AttendanceList },
                                {"CurrentAccount", ViewBag.CurrentAccount },
                            });
                        }
                        else
                        {
                            Html.RenderPartial(
                            "~/Views/Shared/_RegistrantAttendance.cshtml",
                            Model,
                            new ViewDataDictionary
                            {
                                { "AttendanceRegistrants", ViewBag.AttendanceRegistrants },
                                { "Schedule", ViewBag.Schedule },
                                { "RegistrantActivities", ViewBag.RegistrantActivities },
                                { "Controller", "activity" },
                                { "CurrentAccount", ViewBag.CurrentAccount },
                            });
                        }
                    }

                }
            </div>
        </div>
    </div>
</div>

