@model RegistrantActivity
@{
    var currentAccount = SessionVariables.CurrentAccount;
    ViewBag.Title = currentAccount.Name;
    var activity = Model.GetActivity();
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = SessionVariables.AccountPackage;
    var currentUser = SessionVariables.CurrentUser;
}

@{Html.RenderPartial("OrgAccountHeader", currentAccount.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = activity,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", $"{activity.Name} - {UILabel.RegistrantLabel(activity.ActivityTypeId)} Detail", new ViewDataDictionary
              {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(activity.ActivityTypeId)},
              }); }
        </div>
        <div class="panel-body">
            <div class="row">
            <div class="col-md-10 col-md-offset-1">

                @{Html.RenderPartial("~/Views/Shared/_RegistrantDetail.cshtml", Model,
                                new ViewDataDictionary() {
                                  { "BackToListAction", "Registrants" },
                                  { "BackToListController", "Activity" },
                                  { "ShowPaymentForm", true },
                                  { "IsActivityLeader", ViewBag.IsActivityLeader },
                                  { "AttachedCoupons", ViewBag.AttachedCoupons }
                                }
                                );}

            </div>
            </div>
        </div>
    </div>
</div>
