@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Assemblers.Activity.EditDetailsResult
@{
    ViewBag.Title = Model.Account.Name;
    var msgs = Model.Messages;
    var isFullScreen = (Request["isnew"] == "1" && !Model.Activity.IsPublished) || Model.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
    var currentUser = SessionVariables.CurrentUser;
}

@{ Html.RenderPartial("OrgAccountHeader", Model.Activity.AccountId.ToString(), new ViewDataDictionary
   {
       {"IsFullScreen", Model.IsFullScreen},
   }); }
<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model.Activity,
           IsActivityLeader = Model.IsActivityLeader,
           IsFullScreen = Model.IsFullScreen,
           AccountPackage = Model.AccountPackage,
           CurrentAccount = Model.Account,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Activity.Name, new ViewDataDictionary
               {
                   {"IconClass", IconForActivityType.GetIconClassForActivityType(Model.Activity.ActivityTypeId)},
               }); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", Model.FullScreenExitUrl);
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editdetails", "activity", new {id = Model.Activity.Uid, isnew = Request["isnew"], source = Request["source"]})" class="form-horizontal">

                    @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editdetails", "next", true, true, Request))
                    @Html.Raw(ActivitySetupHelper.SaveButton(true, false))

                    @{
                        var viewModel = new ActivityFormDetailsViewModel {Activity = Model.Activity, Details = Model.Details};
                        // You may see that this could be rewritten to conditionally set the first parameter to eliminate if and else blocks...
                        // But this is the only way Rider can detect the files and provide links and have it show as a using for these files.
                        if (Model.Activity.ActivityTypeId == ActivityType.VolunteerOpportunity)
                        {
                            Html.RenderPartial("~/Views/Shared/_VolunteerFormDetails.cshtml", viewModel);
                        }
                        else
                        {
                            Html.RenderPartial("~/Views/Shared/_ActivityFormDetails.cshtml", viewModel);
                        }
                    }

                    <div class="form-group">
                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                        </div>
                        <div class="col-sm-3">
                            @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editdetails", "next", false, true, Request))
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{ Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model.Activity, new ViewDataDictionary {{"ActiveMenu", "EditDetails"}}); }
            </div>

        </div>
    </div>
</div>