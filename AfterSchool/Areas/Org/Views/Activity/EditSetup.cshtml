@model Activity
@{
    ViewBag.Title = ((Account)ViewBag.Account).Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var group = (ActivityGroup)ViewBag.Group;
    var isFullScreen = (bool)ViewBag.IsFullScreen;
    var title = $"{(Model.ActivityGroupName.IsNotEmpty() ? $"{Model.ActivityGroupName} - " : "")}{Model.Name.IfBlank("New " + UILabel.ActivityLabel(Model.ActivityTypeId))}";
    var url = $"/Org/activity/editsetup/{Model.Uid}?cmd=next&amp;isnew={Request["isnew"]}";

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", title); }
            
            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", Request["returnurl"] ?? "");
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editsetup", "activity", new { id = Model.Uid, isnew = Request["isnew"], source = Request["source"] })" class="form-horizontal">
                    
                    <button type="submit" class="btn pull-right btn-space btn-primary" onclick="return validateSetup('@url')">»</button>

                    @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(true, false))

                    @{Html.RenderPartial("~/Views/Shared/_ActivityFormSetup.cshtml", Model);}

                    <div class="form-group">

                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(AfterSchool.Helpers.ActivitySetupHelper.SaveButton(false, false))
                        </div>

                        <div class="col-sm-3">
                            <button type="submit" class="btn btn-space btn-lg btn-block btn-primary" onclick="return validateSetup(1);">Save &amp; Next »</button>                    
                        </div>

                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">
    function validateSetup(flag) {        
        var startDate = moment($('#registrationopendate').val());
        var endDate = moment($('#registrationclosedate').val());
        var beginningTime = moment($('#registrationopentime').val(), 'h:mma');
        var endingTime = moment($('#registrationclosetime').val(), 'h:mma');

        if (endDate.isBefore(startDate) ||
            (endDate.isSame(startDate) && (endingTime.isSame(beginningTime) || endingTime.isBefore(beginningTime))))
        {
            Notifications.showBar({
                title: 'Error',
                message: 'Please make the end date after the start date.',
                success: false
            });
            return false;
        } else if (flag) {
            return ActivitySetup.navigateActivity('@url');
        }
    }
</script>
