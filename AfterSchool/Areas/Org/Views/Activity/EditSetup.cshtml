@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Assemblers.Activity.EditSetupResult
@{
    ViewBag.Title = Model.Account.Name;
    var msgs = Model.Messages;
    var accountPackage = Model.AccountPackage;
    var group = Model.Group;
    var isFullScreen = Model.IsFullScreen;
    var title = $"{(Model.Activity.ActivityGroupName.IsNotEmpty() ? $"{Model.Activity.ActivityGroupName} - " : "")}{Model.Activity.Name.IfBlank("New " + UILabel.ActivityLabel(Model.Activity.ActivityTypeId))}";

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
    var currentUser = SessionVariables.CurrentUser;
}

@{ Html.RenderPartial("OrgAccountHeader", Model.Activity.AccountId.ToString(), new ViewDataDictionary
   {
       {"IsFullScreen", isFullScreen},
   }); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model.Activity,
           IsActivityLeader = Model.IsActivityLeader,
           IsFullScreen = isFullScreen,
           AccountPackage = accountPackage,
           CurrentAccount = Model.Account,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", title, new ViewDataDictionary
               {
                   {"IconClass", IconForActivityType.GetIconClassForActivityType(Model.Activity.ActivityTypeId)},
               }); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", Model.FullScreenExitUrl);
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editsetup", "activity", new {id = Model.Activity.Uid, isnew = Request["isnew"], source = Request["source"]})" class="form-horizontal">

                    @Html.Raw(ActivitySetupHelper.NavButtonWithSetupValidation(Model.Activity, "editsetup", "next", true, true, Request))

                    @Html.Raw(ActivitySetupHelper.SaveButton(true, false))

                    @{
                        if (Model.Activity.ActivityTypeId == ActivityType.VolunteerOpportunity)
                        {
                            Html.RenderPartial("_VolunteerFormSetup", Model.Activity, new ViewDataDictionary
                            {
                                {"AccountPackage", accountPackage},
                                {"Forms", Model.Forms},
                                {"ActivePeriod", Model.ActivePeriod},
                                {"ActiveForm", Model.ActiveForm},
                            });
                        }
                        else
                        {
                            Html.RenderPartial("_ActivityFormSetup", Model.Activity, new ViewDataDictionary
                            {
                                {"AccountPackage", accountPackage},
                                {"Forms", Model.Forms},
                                {"Group", Model.Group},
                                {"ActivePeriod", Model.ActivePeriod},
                                {"ActiveForm", Model.ActiveForm},
                            });
                        }
                    }

                    <div class="form-group">

                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                        </div>

                        <div class="col-sm-3">
                            @Html.Raw(ActivitySetupHelper.NavButtonWithSetupValidation(Model.Activity, "editsetup", "next", false, true, Request))
                        </div>

                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{ Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model.Activity, new ViewDataDictionary {{"ActiveMenu", Model.ActiveMenu}}); }
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">
    function validateSetup(flag, event, url) {        
        let startDate = moment($('#registrationopendate').val());
        let endDate = moment($('#registrationclosedate').val());
        let beginningTime = moment($('#registrationopentime').val(), 'h:mma');
        let endingTime = moment($('#registrationclosetime').val(), 'h:mma');
        let isActivityGroup = @Json.Encode(group.IsNotEmpty());

        if (isActivityGroup)
            return ActivitySetup.navigateActivity(url);

        if (endDate.isBefore(startDate) || (endDate.isSame(startDate) && (endingTime.isSame(beginningTime) || endingTime.isBefore(beginningTime))))
        {
            Notifications.showBar({
                title: 'Error',
                message: 'Please make the end date after the start date.',
                success: false
            });

            event.preventDefault();
            return false;
        } else if (flag) {
            return ActivitySetup.navigateActivity(url);
        }
    }
</script>