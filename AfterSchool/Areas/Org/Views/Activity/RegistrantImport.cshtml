@model Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var currentAccount = SessionVariables.CurrentAccount;
    var accountPackage = SessionVariables.AccountPackage;
    var currentUser = SessionVariables.CurrentUser;
    var anyErrors = false;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
        {
            Activity = Model,
            IsActivityLeader = (bool?)ViewData["IsActivityLeader"],
            IsFullScreen = (bool?)ViewData["IsFullScreen"],
            AccountPackage = accountPackage,
            CurrentAccount = currentAccount,
            CurrentUser = currentUser,
        }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", $"{Model.Name} - {UILabel.RegistrantLabel(Model.ActivityTypeId)} Detail", new ViewDataDictionary
                {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(Model.ActivityTypeId)},
              }); }
        </div>
        <div class="panel-body">

            <div class="panel panel-default">
                <div class="panel-heading">
                    @if (ViewBag.Step == 1)
                    {
                        <a href="@Url.Action("getimportsample", "activity", new { id = Model.Uid })" target="_blank" class="btn btn-default pull-right"><i class="s7-download"></i> Download Sample</a>
                    }
                    Step @ViewBag.Step: @ViewBag.StepLabel
                </div>
                <div class="panel-body">

                    @if (ViewBag.Step == 1)
                    {
                        <form method="post" action="@Url.Action("registrantimport", "activity", new { id = Model.Uid })" class="form-horizontal" enctype="multipart/form-data">
                            <div class="form-group">
                                <label class="col-sm-3 control-label">Registration Data File (.csv, .xls, .xlsx)</label>
                                <div class="col-md-6">
                                    <input type="file" name="importfile" id="importfile" class="form-control" required />
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-3">
                                    <button type="submit" class="btn btn-primary">Upload &amp; Review</button>
                                    <a href="@Url.Action("registrants", "activity", new { id = Model.Uid })" class="btn btn-default pull-right">&laquo; Back to List</a>
                                </div>
                            </div>

                        </form>
                    }
                    else if (ViewBag.Step == 2)
                    {
                        var headers = (List<string>)ViewBag.Headers;
                        var rows = (List<List<AfterSchool.Models.ImportField>>)ViewBag.Rows;

                        <p>Below is a table of the registration data that will be imported. Please review the results and confirm or cancel to make adjustments to your file and re-upload.</p>

                        <p>&nbsp;</p>

                        <div class="table-responsive">
                            <table class="table table-condensed table-striped">
                                <tr>
                                    <th></th>
                                    @foreach (var header in headers)
                                    {
                                        <th>@header</th>
                                    }
                                </tr>
                                @foreach (var row in rows)
                                {
                                    if (!anyErrors && row.Any(x => x.Messages.HasErrors()))
                                    {
                                        anyErrors = true;
                                    }

                                    <tr>
                                        <td>
                                            @if (row.Any(x => x.Messages.HasErrors()))
                                            {
                                                <i class="s7-attention icon-large text-danger" data-toggle="popover" data-trigger="hover" data-content="This row has errors and cannot be imported" data-placement="top"></i>
                                            }
                                            else if (row.Any(x => x.Messages.Has(MessageType.Warning)))
                                            {
                                                <i class="s7-attention icon-large text-warning" data-toggle="popover" data-trigger="hover" data-content="This row has warnings for you to review" data-placement="top"></i>
                                            }
                                            else
                                            {
                                                <i class="s7-check-circle icon-large text-success" data-toggle="popover" data-trigger="hover" data-content="This row has no errors or warnings and is ready to import" data-placement="top"></i>
                                            }
                                        </td>
                                        @foreach (var field in row)
                                        {
                                            <td>
                                                @field.Value
                                                @if (field.Messages.HasErrors() || field.Messages.Has(MessageType.Warning))
                                                {
                                                    <strong><i class="s7-attention icon-medium text-danger" data-toggle="popover" data-trigger="hover" data-content="@field.Messages.RenderMessageList(MessageOutputType.Text)" data-placement="top"></i></strong>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </table>
                        </div>

                        <form method="post" action="@Url.Action("registrantimport", "activity", new { id = Model.Uid })" class="form-horizontal">

                            <textarea name="csv" id="csv" class="hidden">@ViewBag.Csv</textarea>

                            <div class="form-group">
                                <div class="col-md-12">
                                    <button type="submit" class="btn btn-primary btn-lg pull-right" @(anyErrors ? "disabled=\"disabled\"" : "" )>Import Registration Data &raquo;</button>
                                    <a href="@Url.Action("registrantimport", "activity", new { id = Model.Uid })" class="btn btn-default">&laquo; Re-Upload</a>
                                </div>
                            </div>

                        </form>

                    }
                    else if (ViewBag.Step == 3)
                    {
                        if (msgs.HasNoErrors())
                        {
                            <p>Your data has been imported successfully.</p>
                            <p>
                                <a href="@Url.Action("registrants", "activity", new { id = Model.Uid })" class="btn btn-primary btn-lg">View Registration Data &raquo;</a>
                            </p>
                        }
                        else
                        {
                            <p>An error occurred. We'll try to figure out what is going on :-(</p>
                        }
                    }
                </div>
            </div>

        </div>
    </div>
