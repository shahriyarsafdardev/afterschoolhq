@model ActivityMessage
@{
    ViewBag.Title = Model.AccountName;
    var msgs = (SystemMessages)ViewBag.Messages;

    var amrs = (List<ActivityMessageRegistrant>)ViewBag.Registrants;
    var registrantsPerColumn = 0;
    var account = SessionVariables.CurrentAccount;
    var activity = Model.GetActivity();

    if (amrs.IsNotEmpty())
    {
        registrantsPerColumn = Math.Ceiling(amrs.Count / 3.0).ToInteger();
    }
    var accountPackage = SessionVariables.AccountPackage;
    var currentUser = SessionVariables.CurrentUser;
    var body = Model.Body;
    int startIndex = body.IndexOf("<div class=\"attachments text-left\">");
    var attachments = "";
    var bodyText = "";
    if (startIndex != -1)
    {
        attachments = body.Substring(startIndex);
        bodyText = body.Substring(0,startIndex);
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = activity,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = account,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", activity.Name + " - Message", new ViewDataDictionary
              {
                  {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(activity.ActivityTypeId)},
              }); }
        </div>
        <div class="panel-body">
            <div class="col-md-10 col-md-offset-1">

                <div class="row">
                    <a href="@Url.Action("messages", "activity", new { id = activity.Uid})" class="btn btn-primary pull-right">&laquo; Message List</a>
                </div>

                <form method="post" action="@Url.Action("messageadd", "activity", new { id = activity.Uid })" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label text-bold">Message Reason<span class="text-danger">*</span></label>
                        <div class="col-sm-6 padding-10">
                            @Model.Subject
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label text-bold">Message Body<span class="text-danger">*</span> </label>
                        <div class="col-sm-6 padding-10">
                            @Html.Raw(@bodyText.IsNotEmpty()?bodyText.Replace("\n", "<br />"): body.Replace("\n", "<br />"))
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label text-bold">Attachment(s)</label>
                        <div class="col-sm-6 padding-10">
                            @Html.Raw(attachments)
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label text-bold">Sent to Staff</label>
                        <div class="col-sm-6 padding-10">
                            @Model.SendToStaff.ToYesNo()
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label text-bold">Sent only to parents of selected students</label>
                        <div class="col-sm-6 padding-10">
                            @Model.ParentsOnly.ToYesNo()
                        </div>
                    </div>
                    @if (Model.DateSent.HasValue)
                    {
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Date Sent</label>
                            <div class="col-sm-6 padding-10">
                                @account.ConvertToAccountTimeZone(Model.DateSent.Value).ToLongDateTimeString()
                            </div>
                        </div>
                    }
                    @if (amrs.IsNotEmpty())
                    {
                        <div class="form-group">
                            <label class="col-sm-3 control-label text-bold">
                                    @UILabel.RegistrantLabel(activity.ActivityTypeId) Recipients
                            </label>
                            <div class="col-sm-6 padding-10">
                                @if (amrs.Count > 0)
                                {
                                    for (int i = 0; i < 3; i++)
                                    {
                                        <div class="col-md-4">
                                            @foreach (var amr in amrs.Skip(i * registrantsPerColumn).ToList().Take(registrantsPerColumn))
                                            {
                                                <div class="padding-10">
                                                    @if (amr.DateSent.HasValue)
                                                    {
                                                        <i class="s7-check-circle text-success text-bold"></i>
                                                    }
                                                    @(string.IsNullOrEmpty(amr.RegistrantDisplayName) ? amr.RegistrantEmail : amr.RegistrantDisplayName)
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span>None</span>
                                }
                            </div>
                        </div>
                    }

                </form>
            </div>
        </div>
    </div>

</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".download-link").forEach(function (link) {
            link.addEventListener("click", function () {
                var fileLinks = document.querySelectorAll(".file-link");
                fileLinks.forEach(function (fileLink) {
                    var url = fileLink.href;
                    var fileName = fileLink.getAttribute("data-file-name");
                    downloadFile(url, fileName);
                });
            });
        });
    });
    function downloadFile(url, fileName) {
        fetch(url)
            .then(response => response.blob())
            .then(blob => {
                var a = document.createElement('a');
                a.href = URL.createObjectURL(blob);
                a.download = fileName;
                a.style.display = "none";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            });
    }
</script>