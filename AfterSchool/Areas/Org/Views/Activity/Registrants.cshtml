@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Assemblers.Activity.RegistrantsResult
@{
    var msgs = Model.Messages;
    var ras = Model.RegistrantActivities;
    var account = Model.CurrentAccount;
    var totalPaid = Model.Activity.GetTotalPaid();
    var activeRegistrationPeriod = Model.Activity.GetActiveRegistrationPeriod();
    var registrantCount = Model.RegistrantCount;
    var waitingListCount = Model.WaitingListCount;
    var applicationCount = Model.ApplicationCount;
    var invitationCount = Model.InvitationCount;
    var declinedCount = Model.DeclinedCount;
    var assignmentType = Model.AssignmentType;

    var accountPackage = Model.AccountPackage;
    var showAllowInvites = accountPackage.HasFeature(FeatureType.AllowInvites);
    var showStudentCRM = accountPackage.HasFeature(FeatureType.StudentCRM);
    var allowInvitesPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.AllowInvites, accountPackage);
    var studentCRMPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.StudentCRM, accountPackage);
    var isReadOnlySeatStatus = Model.IsReadOnlySeatStatus;
    var currentUser = Model.CurrentUser;
    var canViewRegistrantData = Model.AccountUserType != UserType.Instructor || !Model.CurrentAccount.HasFeature(FeatureType.LimitInstructorRegistrantView);
}


@{ Html.RenderPartial("OrgAccountHeader", Model.CurrentAccount.ID.ToString()); }

<div class="main-content">

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("_ActivityHeader", new ActivityHeaderModel
   {
       Activity = Model.Activity,
       IsActivityLeader = Model.IsActivityLeader,
       IsFullScreen = (bool?) ViewData["IsFullScreen"],
       AccountPackage = accountPackage,
       CurrentAccount = account,
       CurrentUser = currentUser,
   }); }

<div class="panel panel-default">
<div class="panel-heading">
    @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Activity.Name + " - " + UILabel.RegistrantLabel(Model.Activity.ActivityTypeId, true),
           new ViewDataDictionary
           {
               {"IconClass", IconForActivityType.GetIconClassForActivityType(Model.Activity.ActivityTypeId)},
           }); }
</div>
<div class="panel-body">
<div class="row">

    <div class="col-md-2 hide">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@invitationCount" data-decimals="0" data-suffix="" class="value">@invitationCount</div>
                <div class="desc">Invited</div>
            </div>
            <div class="icon">
                <span class="s7-users"></span>
            </div>
        </div>
    </div>

    <div class="col-md-2 hide">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@declinedCount" data-decimals="0" data-suffix="" class="value">@declinedCount</div>
                <div class="desc">Declined</div>
            </div>
            <div class="icon">
                <span class="s7-users"></span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@registrantCount" data-decimals="0" data-suffix="" class="value">@registrantCount</div>
                <div class="desc">Reserved</div>
            </div>
            <div class="icon">
                <span class="s7-users"></span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@waitingListCount" data-decimals="0" data-suffix="" class="value">@waitingListCount</div>
                <div class="desc">Waiting</div>
            </div>
            <div class="icon">
                <span class="s7-users"></span>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@applicationCount" data-decimals="0" data-suffix="" class="value">@applicationCount</div>
                <div class="desc">Applied</div>
            </div>
            <div class="icon">
                <span class="s7-users"></span>
            </div>
        </div>
    </div>

    @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView) && Model.Activity.CostPerRegistrant > 0)
    {
        <div class="col-md-3">
            <div class="widget widget-tile widget-bordered">
                <div class="data-info">
                    <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                    <div class="desc">Total Paid</div>
                </div>
                <div class="icon">
                    <span class="s7-cash"></span>
                </div>
            </div>
        </div>
    }
</div>

<div class="row">
    <div class="col-md-3">
        <select id="assignmentType" onchange="changeAssignment()" class="form-control">
            <option value="">View All Assignments</option>

            @foreach (var x in Enum.GetValues(typeof(RegistrationAssignmentType)).Cast<RegistrationAssignmentType>().Where(x => x != RegistrationAssignmentType.NotSet && x != RegistrationAssignmentType.ReservedPendingBackgroundCheck))
            {
                if (account.HasFeature(FeatureType.AllowApplications) || x != RegistrationAssignmentType.Applied)
                {
                    var selected = "";
                    if (assignmentType == x)
                    {
                        selected = "selected=\"selected\"";
                    }

                    <option value="@((int) x)" @selected>@x.ToString().SplitByUpperCase()</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3">
        @if (Model.Activity.CostFrequencyTypeId == ActivityCostFrequencyType.PerClass)
        {
            <select id="classes" onchange="changeClass()" class="form-control">
                <option value="">All Dates</option>
                @foreach (var instance in Model.ActivitySchedule.GetInSessionInstances())
                {
                    <option value="@instance.ID">@instance.StartDateTime.ToShortDateTimeString()</option>
                }
            </select>
        }
    </div>
    <div class="col-md-6">
        <div class="btn-group pull-right @(Model.Activity.CostFrequencyTypeId == ActivityCostFrequencyType.PerClass ? "hide" : "")">

            @if (canViewRegistrantData)
            {
                if (Model.IsActivityLeader)
                {
                    if (showStudentCRM)
                    {
                        <a href="@Url.Action("addregistration", "activity", new { id = Model.Activity.Uid })" class="btn btn-default btn-space">
                            Add Student
                        </a>
                    }
                    else
                    {
                        <a href="#" class="btn btn-default btn-space" onclick="return showUpgradeMyPlan('@(studentCRMPackage?.Name)',@(studentCRMPackage?.ID))" disabled="disabled">
                            Add Student
                        </a>
                    }
                }

                if (FeatureFlag.CheckFlagIsEnabled("forms-reporting") && Model.CurrentAccount.HasFeature(FeatureType.AdvancedReports))
                {
                    <a href="@Url.Action("Report", "Form", new { activities = Model.Activity.ID })" class="btn btn-default btn-space" target="_blank">
                        View Submissions
                    </a>
                }
                else
                {
                    <a href="@Url.Action("registrantsummary", "activity", new { id = Model.Activity.Uid })" class="btn btn-default btn-space">
                        Send Registration Report
                    </a>
                }

                <a href="@Url.Action("printregistrants", "activity", new { id = Model.Activity.Uid })" class="btn btn-default btn-space" target="_blank">
                    Print Registrations
                </a>

                if (!Model.Activity.ActivityGroupId.HasValue && Model.AccountPackage.HasFeature(FeatureType.AllowRegistrantImport))
                {
                    <a href="@Url.Action("registrantimport", "activity", new { id = Model.Activity.Uid })" class="btn btn-default btn-space">
                        Import Students
                    </a>
                }

                if (activeRegistrationPeriod.IsNotEmpty())
                {
                    if (showAllowInvites)
                    {
                        <a href="@Url.Action("inviteto", "contact", new { id = activeRegistrationPeriod.Uid, type = "period" })" class="btn btn-default btn-space">
                            Invite Contacts
                        </a>
                    }
                    else
                    {
                        <a href="#" class="btn btn-default btn-space" onclick="return showUpgradeMyPlan('@(allowInvitesPackage?.Name)',@(allowInvitesPackage?.ID))" disabled="disabled">
                            Invite Contacts
                        </a>
                    }
                }
            }
        </div>
    </div>
</div>

<div class="clearfix"></div>
<br/>
@if (ras.IsEmpty() || ras.Count() == 0)
{
    <hr style="width:100%"/>
    <div class="text-center text-bold">No students have registered yet</div>
}
else
{
    Html.RenderPartial(
        "~/Views/Shared/_ActivityRegistrantsWithAllStatus.cshtml",
        ras,
        new ViewDataDictionary
        {
            {"Activity", Model.Activity},
            {"Account", account},
            {"EditAction", "registrantdetail"},
            {"EditController", "activity"},
            {"AssignmentType", assignmentType},
            {"IsReadOnlySeatStatus", isReadOnlySeatStatus},
            {"CanViewRegistrantData", canViewRegistrantData }
        }
        );
}

</div>
</div>
</div>

<script>
    function changeAssignment() {
        location.href = '@Url.Action("registrants", "activity", new {id = Model.Activity.Uid})?atype=' + $('#assignmentType').val();
    }
    function changeClass() {
        $('.instance').addClass('hide');

        if ($('#classes').val() == '') {
            $('.instance').removeClass('hide');
        } else {
            $('.instance-' + $('#classes').val()).removeClass('hide');
        }
    }
</script>

@section scripts{
    <script>
        $(document).ready(function () {
            $(document).on("change", ".yesno", function () {
                let manualWithdrawButton = $("#btn-manual-withdraw");
                if ($(this).val() === "yes") {
                    manualWithdrawButton.text('Withdraw & Cancel Payments »').button("refresh");
                    let value = manualWithdrawButton.attr('onclick');
                    manualWithdrawButton.attr('onclick', value.replace('false', 'true'));
                }
                else {
                    manualWithdrawButton.text('Withdraw & Continue Payments »').button("refresh");
                    let value = manualWithdrawButton.attr('onclick');
                    manualWithdrawButton.attr('onclick', value.replace('true', 'false'));
                }

            })
        })
    </script>
}