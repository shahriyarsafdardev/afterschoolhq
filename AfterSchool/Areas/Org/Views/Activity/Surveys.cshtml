@model Activity
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = SessionVariables.AccountPackage;
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
}
@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">
    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }
    <div class="panel panel-default">
        <div class="panel-body surveypanelpadding">
            <div class="row">
                <div class="col-lg-6">
                    <div class="DDLMain">
                        <span class="titleName">@Model.Name</span>
                        <div class="dropdown" style="width: 54%;">
                            <i class="s7-edit filterIcon" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true"></i>
                            <ul class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdownMenu1">
                                <li><a href="javascript:void(0)" class="sortFilterAnchor" style="font-weight: bold;">Sort By:</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="sort" data-index="3" data-order="desc"><a href="javascript:void(0)" class="sortFilterAnchor">Newest to oldest</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="sort" data-index="3" data-order="asc"><a href="javascript:void(0)" class="sortFilterAnchor">Oldest to newest</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="sort" data-index="2" data-order="asc"><a href="javascript:void(0)" class="sortFilterAnchor">Group by Sender</a></li>
                                <li role="separator" class="divider"></li>
                                <li class="sort" data-index="1" data-order="asc"><a href="javascript:void(0)" class="sortFilterAnchor">Alphabetically</a></li>
                            </ul>
                        </div>
                    </div>
                    <div style="font-size:14px; color:#B2B2B4;clear: both;">@Model.AccountName</div>
                </div>
                <div class="col-lg-6">
                    <div class="pull-right">
                        <a href="@Url.Action("newsurvey", "activity", new { id = Model.Uid })" class="btn btn-success surveybtn">Send New Survey</a>
                    </div>
                </div>
            </div>
            <div style="clear:both"></div>
            <div class="margin-t-35">
                <table class="table surveyTable sortTable">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Survey Name</th>
                            <th>Sent By</th>
                            <th>Date Sent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var survey in (List<SurveyRequest>)ViewBag.Surveys)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("viewsurvey", "activity", new { id = survey.ID, activityId = Model.Uid })">View</a>
                                </td>
                                <td>
                                    @survey.Name
                                </td>
                                <td>
                                    @SurveyRequestService.GetCreatedBy(survey).DisplayName
                                </td>
                                <td>
                                    @(survey.CreateDate.IsNotEmpty() ? survey.CreateDate.Value.ToString("MM/dd/yyyy") : "")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts{
     <script src="~/Assets/lib/customTableSorter.js"></script>
}