@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Assemblers.Activity.EditConfirmationResult
@{
    var msgs = Model.Messages;
    var isFullScreen = Model.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
    var accountPackage = SessionVariables.AccountPackage;
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
}

@{ Html.RenderPartial("OrgAccountHeader", Model.Activity.AccountId.ToString(), new ViewDataDictionary
   {
       {"IsFullScreen", isFullScreen},
   }); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model.Activity,
           IsActivityLeader = Model.IsActivityLeader,
           IsFullScreen = isFullScreen,
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Activity.Name); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", Model.FullScreenExitUrl);
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editconfirmation", "activity", new {id = Model.Activity.Uid, isnew = Request["isnew"], source = Request["source"]})" class="form-horizontal">

                    @if (!Model.Activity.IsPublished)
                    {
                        @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editconfirmation", "publish", true, true, Request))
                    }
                    @Html.Raw(ActivitySetupHelper.SaveButton(true, false))

                    @{
                        if (Model.Activity.ActivityTypeId == ActivityType.VolunteerOpportunity)
                        {
                            var activityProperties = Model.Activity.GetActivityProperties();
                            var emailTextContent = activityProperties
                                .FirstOrDefault(x => x.AccountPropertyTypeId == AccountPropertyType.RegistrationThankYouEmail)?.Value;
                            Html.RenderPartial("_VolunteerFormConfirmation", emailTextContent);
                        }
                        else
                        {
                            Html.RenderPartial("_ActivityFormConfirmation", Model.Activity);
                        }
                    }

                    <div class="form-group">
                        @if (!Model.Activity.IsPublished)
                        {
                            <div class="col-sm-6 col-sm-offset-3">
                                @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                            </div>
                            <div class="col-sm-3">
                                @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editconfirmation", "publish", false, true, Request))
                            </div>
                        }
                        else
                        {
                            <div class="col-md-offset-3 col-sm-9">
                                @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                            </div>
                        }
                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{ Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model.Activity, new ViewDataDictionary
                   {
                       {"ActiveMenu", "EditConfirmation"},
                   }); }
            </div>

        </div>
    </div>
</div>


<script>

    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

</script>