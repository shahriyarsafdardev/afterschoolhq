@using AfterSchool.Helpers
@model AfterSchool.Areas.Org.Controllers.EditLocationResult
@{
    var account = Model.Account;
    ViewBag.Title = account.Name;
    var msgs = Model.Messages;
    var isFullScreen = Model.IsFullScreen;
    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@{ Html.RenderPartial("OrgAccountHeader", Model.Activity.AccountId.ToString(), new ViewDataDictionary
   {
       {"IsFullScreen", Model.IsFullScreen},
   }); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model.Activity, new ViewDataDictionary
       {
           {"IsActivityLeader", Model.IsActivityLeader},
           {"IsFullScreen", Model.IsFullScreen},
       }); }

    <div class="panel panel-default margin-bottom-zero">
        <div class="panel-heading">
            @{ Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Activity.Name); }

            @if (isFullScreen)
            {
                Html.RenderPartial("_ExitFullScreen", Model.FullScreenExitUrl);
            }
        </div>
        <div class="panel-body padding-lr-zero-sm">

            <div class="col-md-10 col-lg-9">
                <form id="form1" method="post" action="@Url.Action("editlocation", "activity", new {id = Model.Activity.Uid, isnew = Request["isnew"], source = Request["source"]})" class="form-horizontal">

                    @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editlocation", "next", true, true, Request))
                    @Html.Raw(ActivitySetupHelper.SaveButton(true, false))

                    @{
                        if (Model.Activity.ActivityTypeId == ActivityType.VolunteerOpportunity)
                        {
                            Html.RenderPartial("~/Views/Shared/_VolunteerFormLocation.cshtml", Model.Activity, new ViewDataDictionary {{"Location", Model.Location}});
                        }
                        else
                        {
                            Html.RenderPartial("~/Views/Shared/_ActivityFormLocation.cshtml", Model.Activity, new ViewDataDictionary {{"Location", Model.Location}});
                        }
                    }

                    <div class="form-group">
                        <div class="col-sm-6 col-sm-offset-3">
                            @Html.Raw(ActivitySetupHelper.SaveButton(false, false))
                        </div>
                        <div class="col-sm-3">
                            @Html.Raw(ActivitySetupHelper.NavButton(Model.Activity, "editlocation", "next", false, true, Request))
                        </div>
                    </div>

                </form>
            </div>

            <div class="col-md-2 col-lg-3">
                @{ Html.RenderPartial("~/Views/Shared/_ActivityEditNav.cshtml", Model.Activity,
                       new ViewDataDictionary
                       {
                           {"ActiveMenu", "EditLocation"},
                       }); }
            </div>

        </div>
    </div>
</div>