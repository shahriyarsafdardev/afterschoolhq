@model Activity
@{
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;
    var accountPackage = SessionVariables.AccountPackage;
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", new ActivityHeaderModel
       {
           Activity = Model,
           IsActivityLeader = (bool?) ViewData["IsActivityLeader"],
           IsFullScreen = (bool?) ViewData["IsFullScreen"],
           AccountPackage = accountPackage,
           CurrentAccount = currentAccount,
           CurrentUser = currentUser,
       }); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("_ActivityGroupTitle", Model.Name); }
        </div>
        <div class="panel-body">

            <form id="form-add-reg" action="@Url.Action("addregistration", "activity", new { id = Model.Uid })" class="form-horizontal" method="post">

                @foreach (var group in qvms.Select(qvm => qvm.Question.GetFormQuestionGroup()).DistinctBy(group => group.ID).OrderBy(group => group.DisplayOrder))
                {
                    <div class="panel panel-default">
                        <div class="panel-heading">
                            @group.Name
                        </div>
                        <div class="panel-body">
                            @foreach (var qvm in qvms.Where(qvm => qvm.Question.GetFormQuestionGroup().ID == group.ID))
                            {
                                Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                            }
                        </div>
                    </div>
                }

                <div class="row">
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <div class="pull-left">
                            <a href="@Url.Action("registrants", "activity", new { id = Model.Uid })" class="text-muted">&laquo; Back</a>
                        </div>
                        <div class="btn-group pull-right">
                            <button type="submit" class="btn btn-primary btn-lg">Register @UILabel.RegistrantLabel() &raquo;</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
