@model Activity
@{
    ViewBag.Title = Model.AccountName;
    var attendancesToBillRegistrants = (Dictionary<RegistrantActivity, List<Attendance>>)ViewBag.AttendancesToBillRegistrants;
    var billingPeriodType = ViewBag.BillingPeriodType;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{
    Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());
}

<div class="main-content">

    @{
        Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs);

        Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model);
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            Charge Attendance Fee - Preview

            <div class="clearfix"></div>

            <div style="font-size: 13px">
                <p>Please review the following attendances to ensure all of the correct charges are listed</p>
            </div>

            <div>
                <div class="pull-left">
                    <a href="@Url.Action("attendance", new { id = Model.Uid })" class="btn btn-default btn-space">&laquo; Cancel</a>
                </div>
                <span class="pull-right">
                    <button class="btn btn-primary" onclick="confirmChargeForAttendances()">
                        Confirm and Charge Fees to Parents >
                    </button>
                </span>
            </div>
            <br />
        </div>
        <div class="panel-body">

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>@billingPeriodType Attended (Not Paid) <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="These are the number of attendances that haven't been charged yet, so it may be less than the number of attendances you selected for each student if you have already charged for some of those selected attendances." data-placement="top"></i></th>
                            <th>Total Amount </th>
                            <th>Coupon Discount </th>
                            <th>Total Amount To Charge</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (attendancesToBillRegistrants.Count > 0)
                        {
                            foreach (var attendancesToBillRegistrant in attendancesToBillRegistrants)
                            {
                                var registrant = attendancesToBillRegistrant.Key.GetRegistrant();
                                var registration = attendancesToBillRegistrant.Key.GetRegistration();
                                var presentCount = attendancesToBillRegistrant.Value.Count;
                                var costPerClass = registration.CostPerClass.HasValue ? registration.CostPerClass.Value : 0;
                                var totalAmount = (decimal)(presentCount * (registration.CostPerClass.HasValue ? registration.CostPerClass.Value : 0));
                                var couponDiscount = (decimal)(presentCount * (registration.CouponValue.HasValue ? registration.CouponValue.Value : 0));
                                var totalAmountToCharge = (decimal)totalAmount - couponDiscount;
                                
                                if (billingPeriodType == BillingPeriodType.Week)
                                {
                                    var isCharged = registrant.CheckRegistrantChargeForWeeklyBillingType(Model);
                                    if (isCharged)
                                    {
                                        presentCount = 0;
                                        totalAmount = 0;
                                        couponDiscount = 0;
                                        totalAmountToCharge = 0;
                                    }
                                }

                                <tr>
                                    <td>@registrant.FirstName @registrant.LastName</td>

                                    <td>@presentCount</td>

                                    <td>@totalAmount.ToCurrency()</td>

                                    <td>@couponDiscount.ToCurrency()</td>

                                    @if (totalAmountToCharge > 0)
                                    {
                                        <td style="font-weight: bold;">@totalAmountToCharge.ToCurrency()</td>
                                    }
                                    else
                                    {
                                        <td>@totalAmountToCharge.ToCurrency()</td>
                                    }

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5">You have not taken attendance yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<form action="@Url.Action("ChargeAttendanceFeeDone","activity")" id="frmChargeAttendancePreview" method="post">
    @Html.Hidden("AttendanceIds")
    @Html.HiddenFor(m => m.Uid)
</form>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {

    });



    function confirmChargeForAttendances() {
        $("#AttendanceIds").val('@ViewBag.AttdanceIds');
        $("#frmChargeAttendancePreview").submit();
    }

</script>
