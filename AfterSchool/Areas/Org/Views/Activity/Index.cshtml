@model List<Activity>
@{
    var currentAccount = SessionVariables.CurrentAccount;
    ViewBag.Title = currentAccount.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var hasArchivedActivities = (bool)ViewBag.HasArchivedActivities;
    var activityType = (ActivityType)ViewBag.ActivityType;
    var accountPackage = SessionVariables.AccountPackage;
    var managePermissionSlips = accountPackage.HasFeature(FeatureType.ManagePermissionSlips);
    var maxPermissionSlipCount = accountPackage.IsNotEmpty() ? (int)accountPackage.GetFeature(FeatureType.ManagePermissionSlips).Max.Value : 0;
    var showPermissionSlipFields = ViewBag.PagingModel?.TotalCount < maxPermissionSlipCount;
    var permissionSlipsPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.ManagePermissionSlips, accountPackage);
}

@{Html.RenderPartial("OrgAccountHeader", currentAccount.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">
                @if (activityType == ActivityType.PermissionSlip)
                {
                    if (managePermissionSlips && showPermissionSlipFields)
                    {
                        <a href="@Url.Action("editsetup", "activity", new { isnew = 1, type = (int)activityType })" class="btn btn-primary">
                            <i class="icon icon-left s7-plus"></i>
                            Add @UILabel.ActivityLabel(activityType)
                        </a>
                    }
                    else 
                    { 
                        <a href="#" class="btn btn-primary" onclick="return showUpgradeMyPlan('@(permissionSlipsPackage?.Name)', @(permissionSlipsPackage?.ID))">
                            <i class="icon icon-left s7-plus"></i>
                            Add @UILabel.ActivityLabel(activityType)
                        </a>
                    }
                } 
                else
                {
                    <a href="@Url.Action("editsetup", "activity", new { isnew = 1, type = (int)activityType })" class="btn btn-primary">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel(activityType)
                    </a>
                }
            </div>
            @{
                var activityTypeLabel = (activityType == ActivityType.VolunteerOpportunity ? "Volunteer " : "") + UILabel.ActivityLabel(activityType, true);
                Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", activityTypeLabel, new ViewDataDictionary
                {
                    {"IconClass", AfterSchool.Helpers.IconForActivityType.GetIconClassForActivityType(activityType)},
                });
            }
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">
            @{ Html.RenderPartial(
                 "~/Views/Shared/_Activities.cshtml",
                 Model,
                 new ViewDataDictionary
                 {
                    { "Account", currentAccount },
                    { "AccountPackage", accountPackage },
                    { "PagingModel", ViewBag.PagingModel },
                    { "ShowRegistrationPeriodFilter", true },
                    { "Groups", ViewBag.Groups },
                    { "Group", ViewBag.Group },
                    { "NeedToUpgrade", false },
                    { "HasArchivedActivities", hasArchivedActivities },
                    { "ActivityType", (int)activityType }
                }); }
        </div>
    </div>
</div>
