@model List<Activity>
@{
    ViewBag.Title = SessionVariables.CurrentAccount.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var needToUpgrade = (bool)ViewBag.NeedToUpgrade;
    var hasArchivedActivities = (bool)ViewBag.HasArchivedActivities;
    var activityType = (ActivityType)ViewBag.ActivityType;
}

@{Html.RenderPartial("OrgAccountHeader", SessionVariables.CurrentAccount.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">
                @if (!needToUpgrade)
                {
                    <a href="@Url.Action("editsetup", "activity", new { isnew = 1, type = (int)activityType })" class="btn btn-primary">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel(activityType)
                    </a>
                }
                else
                {
                    <button class="btn btn-primary md-trigger" data-modal="modal-offering">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel(activityType)
                    </button>
                    <div id="modal-offering" class="md-modal colored-header custom-width md-effect-9">
                        <form id="form-upgrade" action="" method="post">
                            <div class="md-content">
                                <div class="modal-header">
                                    <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                                    <h3 class="modal-title">Upgrade Your Account</h3>
                                </div>
                                <div class="modal-body form">
                                    <p>You have reached your limit of @UILabel.ActivityLabel(activityType, true). Time to upgrade :).</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                                    <a href="@Url.Action("packages", "account")" class="btn btn-primary">Upgrade &raquo;</a>
                                </div>
                            </div>
                        </form>
                    </div>
                }
            </div>
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", UILabel.ActivityLabel(activityType, true)); }
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">
            @{ Html.RenderPartial(
                 "~/Views/Shared/_Activities.cshtml",
                 Model,
                 new ViewDataDictionary() {
                    { "Account", SessionVariables.CurrentAccount },
                    { "AccountPackage", SessionVariables.AccountPackage },
                    { "PagingModel", ViewBag.PagingModel },
                    { "ShowRegistrationPeriodFilter", true },
                    { "Groups", ViewBag.Groups },
                    { "Group", ViewBag.Group },
                    { "NeedToUpgrade", needToUpgrade },
                    { "HasArchivedActivities", hasArchivedActivities },
                    { "ActivityType", (int)activityType }
                     }
                 ); }
        </div>
    </div>
</div>
