@model PaymentsEntityViewModel
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var account = (Account)ViewBag.Account;
    var isFullScreen = (bool)ViewBag.IsFullScreen;

    ViewBag.Title = account.Name;

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!isFullScreen)
{
    Html.RenderPartial("OrgAccountHeader");
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", account);}

    <div class="panel panel-default">
        <div class="panel-heading">
            @if (isFullScreen)
            {
                <div class="pull-right">
                    <a href="@Url.Action("paymentsoptions", "account")" class="btn btn-default">&laquo; Exit</a>
                </div>
            }
            <i class="s7-edit"></i> Settings - Accept Payments
        </div>
        <div class="panel-body">

            @if (isFullScreen)
            {
                <div class="col-md-1"></div>
            }

            <div class="col-md-8 col-lg-9">

                @if (Model.BankAccountId.IsNotEmpty())
                {
                    <div role="alert" class="alert alert-success alert-icon">
                        <div class="icon">
                            <span class="s7-info"></span>
                        </div>
                        <div class="message">
                            <p class="text-center">
                                Your bank account is now connected
                            </p>
                        </div>
                    </div>

                    <div><p><br /><br /></p></div>
                    <div class="row">
                        <div class="col-md-offset-4 col-md-4 text-center">
                            <i class="s7-culture icon-large"></i>
                            <p class="text-medium">
                                @Model.BankName
                                *** *** @Model.BankLast4
                            </p>
                        </div>
                    </div>
                    <div><p><br /><br /></p></div>
                    <hr />
                }

                <form method="post" action="@Url.Action("paymentsbank", "account", new { isnew = Request["isnew"] })" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <p class="text-center">
                                @if (Model.BankAccountId.IsNotEmpty())
                                {
                                    @:Update your bank account information. It must be a US bank account.
                                }
                                else
                                {
                                    @:Enter your bank account information. It must be a US bank account.
                                }
                            </p>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Routing # <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="bankroutingnumber1" name="bankroutingnumber1" value="" onfocus="this.select()" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Routing # Confirm <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="bankroutingnumber2" name="bankroutingnumber2" value="" onfocus="this.select()" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Account # <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="bankaccountnumber1" name="bankaccountnumber1" value="" onfocus="this.select()" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-4 control-label">Account # Confirm<span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="bankaccountnumber2" name="bankaccountnumber2" value="" onfocus="this.select()" required />
                        </div>
                    </div>

                    <div class="form-group text-center">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" class="btn btn-primary btn-xl">Save Bank Information &raquo;</button>
                        </div>
                    </div>
                </form>

            </div>

            @if (!isFullScreen)
            {                
                <div class="col-md-4 col-lg-3">
                    @{Html.RenderPartial("~/Views/Shared/_AccountPaymentEditNav.cshtml", account); }
                </div>
            }
        </div>

    </div>
</div>
