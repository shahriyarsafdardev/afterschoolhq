@model Account
@{
    ViewBag.Title = Model.Name;
    List<Package> packages = (List<Package>)ViewBag.Packages;
    AccountPackage accountPackage = (AccountPackage)ViewBag.AccountPackage;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-box2"></i> Account - Packages
        </div>
        <div class="panel-body">
            <div class="col-md-8 col-lg-9">
                @{Html.RenderPartial("~/Views/Shared/_Packages.cshtml", Model);}
            </div>
            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_AccountEditNav.cshtml", Model); }
            </div>
        </div>
    </div>
</div>
