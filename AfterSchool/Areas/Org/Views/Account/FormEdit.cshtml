    //called when rating modal is going to display
    //Also setting rating range values in options hidden field.
    var selectedRatingQuestion = null;
    function setRating(id) {

        selectedRatingQuestion = id;

        //set default ratings
        setDefaultRatings();

        //ideal rating stored in db = 1|Start,50|End,5
        var rating = $(`#link-text-${id}`).val();
        var splitedRating = rating.split(',');

        var startString = splitedRating[0];
        if (startString) {
            var start = startString.split("|");
            if (start) {
                var min = start[0];
                var minLabel = start[1];

                $('#question-rating-min').val(min);
                $('#rating-min-label').val(min);

                if (minLabel)
                    $('#question-rating-label-min').val(minLabel);
            }
        }

        var endString = splitedRating[1];
        if (endString) {
            var end = endString.split("|");
            if (end) {
                var max = end[0];
                var maxLabel = end[1];

                $('#question-rating-max').val(max);
                $('#rating-max-label').val(max);

                if (maxLabel)
                    $('#question-rating-label-max').val(maxLabel);
            }
        }

        var increment = splitedRating[2];
        if (increment)
            $('#question-rating-increment').val(parseInt(increment));
    }

    function setDefaultRatings() {
        var min = $('#question-rating-min').val();
        if (min == '')
            $('#question-rating-min').val(1);

        $('#question-rating-label-min').val('');
        $('#rating-min-label').val(1);

        var max = $('#question-rating-max').val();
        if (max == '')
            $('#question-rating-max').val(5);

        $('#question-rating-label-max').val('');
        $('#rating-max-label').val('5');

        var increment = $('#question-rating-increment').val();
        if (increment == '')
            $('#question-rating-increment').val(1);
    }

    //Updating rating range values in options hidden input
    function updateRating() {
        var validation = true;
        var ratingMin = $('#question-rating-min');
        var ratingMax = $('#question-rating-max');
        var valueRequired = $('#valueRequired');
        var invalidBarChar = $('#invalidBarChar');
        var minMaxValidation = $('.minMaxValidation');
        var ratingMinOptionalLabel = $('#question-rating-label-min');
        var ratingMaxOptionalLabel = $('#question-rating-label-max');
        var ratingMinValIsInteger = $.isNumeric($('#question-rating-min').val());
        var ratingMaxValIsInteger = $.isNumeric($('#question-rating-max').val());

        if (ratingMin.val() == "") {
            ratingMin.addClass("danger");
            valueRequired.removeClass("hide");
            validation = false;
        }
        else {
            ratingMin.removeClass("danger");
            valueRequired.addClass("hide");

            if (parseInt(ratingMin.val()) >= parseInt(ratingMax.val())) {
                ratingMax.addClass("danger");
                ratingMin.addClass("danger");
                minMaxValidation.removeClass("hide");
                validation = false;
            }
            else {
                ratingMax.removeClass("danger");
                ratingMin.removeClass("danger");
                minMaxValidation.addClass("hide");
                validation = true;
            }
        }

        if (ratingMax.val() == "") {
            ratingMax.addClass("danger");
            valueRequired.removeClass("hide");
            validation = false;
        }
        else {
            ratingMax.removeClass("danger");
        }

        if (ratingMinOptionalLabel.val().includes('|')) {
            ratingMinOptionalLabel.addClass("danger");
            invalidBarChar.removeClass("hide");
            validation = false;
        }
        else {
            ratingMinOptionalLabel.removeClass("danger");
            invalidBarChar.addClass("hide");
        }

        if (ratingMaxOptionalLabel.val().includes('|')) {
            ratingMaxOptionalLabel.addClass("danger");
            invalidBarChar.removeClass("hide");
            validation = false;
        }
        else {
            ratingMaxOptionalLabel.removeClass("danger");
        }

        if (validation == true) {
            var start = $('#question-rating-min').val();
            var startLabel = $('#question-rating-label-min').val();

            var end = $('#question-rating-max').val();
            var endLabel = $('#question-rating-label-max').val();

            var increment = $('#question-rating-increment').val();

            var options = getOptionsTextForRating(parseInt(start), startLabel, parseInt(end), endLabel, parseInt(increment));
            $('#options-text-' + selectedRatingQuestion).val(options);

            //lets store other configuration info in link field for now
            $('#link-text-' + selectedRatingQuestion).val(`${start}|${startLabel},${end}|${endLabel},${increment}`);

            $("#btn-setratings-" + selectedRatingQuestion).css("border", "").tooltip("destroy");
            invalidBarChar.addClass("hide");
            valueRequired.addClass("hide");
            $("#modal-rating").removeClass("md-show");
        }
        else return false;
    }

    function getOptionsTextForRating(start, startLabel, end, endLabel, increment) {
        // example of good option chain 1|Start,5,10,15,20,25,30,35,40,45,50|End
        var options = '';

        if (startLabel)
            options = `${start}|${startLabel},`;
        else
            options = `${start},`;

        var loopStart = start;
        if (start % 2)
            loopStart = start - 1;

        for (var i = loopStart; i <= end; i += increment) {
            if (i > start && i < end)
                options += `${i},`;
        }

        if (endLabel)
            options += `${end}|${endLabel}`;
        else
            options += `${end}`;

        return options;
    }

    function setRatingIncrement() {
        $('#question-rating-increment').val($('#question-rating-increment').val());
