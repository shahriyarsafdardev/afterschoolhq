@model Form
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var questionGroups = (List<FormQuestionGroup>)ViewBag.QuestionGroups;
    var individualGroups = (List<FormQuestionGroup>)ViewBag.IndividualGroups;
    var organizationGroups = (List<FormQuestionGroup>)ViewBag.OrganizationGroups;
    var questionGroup = (FormQuestionGroup)ViewBag.QuestionGroup;
    var qgId = new int?();
    var questions = new List<FormQuestion>();
    var typesWithRating = new List<QuestionType>() { QuestionType.Rating };
    var typesWithOptions = new List<QuestionType>() { QuestionType.CheckboxList, QuestionType.DropDownList, QuestionType.RadioList, QuestionType.RadioMatrix, QuestionType.Emoji };
    var typesUserCannotAdd = Model.GetTypesUserCannotAdd();

    if (questionGroup.IsNotEmpty())
    {
        qgId = questionGroup.ID;
        questions = questionGroup.GetAllQuestions().Where(a => a.Text.IsNotEmpty() || a.QuestionTypeId == QuestionType.TextBlock).ToList();
    }
    var count = 1;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", SessionVariables.CurrentAccount);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <a href="@Url.Action("forms", "account")" class="btn btn-default pull-right">&laquo; All Forms</a>
            <i class="s7-note2"></i> Form - @Model.Name
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <form id="form1" method="post" action="@Url.Action("formedit", "account", new { id = Model.ID.ToString(), qg = qgId })" class="form-horizontal">

                    @if (questionGroup.IsEmpty())
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="btn-group pull-right">
                                    @if (qgId.HasValue)
                                    {
                                        <button type="submit" class="btn btn-default btn-space" onclick="navigateForm('@Url.Action("formedit", "account", new { id = Model.ID, qg = qgId, cmd = "prev" })')">&laquo;</button>
                                    }
                                    <button type="submit" class="btn btn-default btn-space"><i class="s7-diskette"></i> Save</button>
                                    @if (questionGroups.Count() > 0 ? questionGroups.Last().ID != qgId : false)
                                    {
                                        <button type="submit" class="btn btn-primary btn-space" onclick="navigateForm('@Url.Action("formedit", "account", new { id = Model.ID, qg = qgId, cmd = "next" })')">&raquo;</button>
                                    }
                                </div>
                                <div class="clearfix"></div>
                                <p></p>
                                Settings
                            </div>
                            <div class="panel-body">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Form Name</label>
                                    <div class="col-sm-9">
                                        <input type="text" class="form-control" id="name" name="name" value="@Model.Name.IfBlank(Model.Name + " Registration Form")" onfocus="this.select()" required />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Form Type</label>
                                    <div class="col-sm-9">
                                        <select class="form-control formtype-select" id="formtype" name="formtype">
                                            @foreach (var type in Enum.GetValues(typeof(FormType)).Cast<FormType>().Where(a => !a.Equals(FormType.NotSet)))
                                            {
                                                <option value="@((int)type)" @(type == Model.FormTypeId ? "selected=\"selected\"" : "")>
                                                    @type.ToString().SplitByUpperCase()
                                                </option>
                                            }
                                        </select>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label">Description</label>
                                    <div class="col-sm-9">
                                        <textarea name="description" id="description" class="form-control" rows="5">@Model.Description</textarea>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                <div class="btn-group pull-right">

                                    @if (questionGroups.Count() > 0 ? questionGroups.First().ID != qgId : false)
                                    {
                                        <button type="submit" class="btn btn-default btn-space" onclick="navigateForm('@Url.Action("formedit", "account", new { id = Model.ID, qg = questionGroup.ID, cmd = "prev" })')">&laquo;</button>
                                    }
                                    <button type="submit" class="btn btn-default btn-space"><i class="s7-diskette"></i> Save</button>
                                    @if (questionGroups.Count() > 0 ? questionGroups.Last().ID != qgId && qgId != 0 : false)
                                    {
                                        <button type="submit" class="btn btn-primary btn-space" onclick="navigateForm('@Url.Action("formedit", "account", new { id = Model.ID, qg = questionGroup.ID, cmd = "next" })')">&raquo;</button>
                                    }
                                </div>
                                <div class="clearfix"></div>

                                <p></p>

                                @if (questionGroup.IsNotEmpty())
                                {
                                    if (questionGroup.QuestionGroupDataTypeId == QuestionGroupDataType.NotSet || questionGroup.QuestionGroupDataTypeId == QuestionGroupDataType.Custom)
                                    {
                                        <input type="text"
                                               id="name-@questionGroup.ID"
                                               name="name-@questionGroup.ID"
                                               value="@questionGroup.Name"
                                               required
                                               class="form-control input-lg input-lg-font"
                                               onfocus="this.select()"
                                               data-tooltip-id="name-@questionGroup.ID"
                                               placeholder="Enter your new section name" />
                                    }
                                    else
                                    {
                                        <p class="text-medium">@questionGroup.Name</p>
                                    }
                                }


                            </div>
                            <div class="panel-body">
                                <div class="table-responsive">
                                    <table class="table table-striped question-table" id="question-table">
                                        <thead>
                                            <tr>
                                                <th>Order</th>
                                                <th>Question Label</th>
                                                <th></th>
                                                <th></th>
                                                <th>Ask? (<a href="javascript:checkAllActive()">All</a> / <a href="javascript:uncheckAllActive()">None</a>)</th>
                                                <th>Required? (<a href="javascript:checkAllRequired()">All</a> / <a href="javascript:uncheckAllRequired()">None</a>)</th>
                                                <th>Answer Description? (<a href="javascript:checkAllAnswerDescription()">All</a> / <a href="javascript:uncheckAllAnswerDescription()">None</a>)</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var question in questions)
                                            {
                                                <tr class="questionRow">
                                                    <td>
                                                        <label class="lbl-display-order" id="displayOrderlabel-@question.ID">
                                                            @count
                                                        </label>
                                                        <input type="hidden"
                                                               id="sortorder-@question.ID"
                                                               name="displayOrderId-@question.ID" class="displayOrderId"
                                                               value="@count" />
                                                        <input type="hidden"
                                                               id="questionid-@question.ID"
                                                               name="questionid-@question.ID"
                                                               class="questionId"
                                                               value=" @question.ID" />
                                                    </td>
                                                    <td>
                                                        @if (question.QuestionTypeId != QuestionType.TextBlock)
                                                        {
                                                            if (question.QuestionDataTypeId == QuestionDataType.NotSet)
                                                            {
                                                                <input type="text"
                                                                       id="text-@question.ID"
                                                                       name="text-@question.ID"
                                                                       value="@question.Text"
                                                                       required
                                                                       class="form-control col-sm-3"
                                                                       onfocus="this.select()"
                                                                       data-tooltip-id="text-@question.ID" />

                                                            }
                                                            else if (question.IsLocked)
                                                            {
                                                                <i class="s7-lock icon-medium"></i> @question.Text
                                                            }
                                                            else
                                                            {
                                                                @question.Text
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <textarea class="form-control" id="description-@question.ID" name="description-@question.ID">@question.Description</textarea>

                                                        }
                                                    </td>

                                                    <td>
                                                        @if (!question.IsLocked && question.QuestionDataTypeId == QuestionDataType.NotSet && question.QuestionTypeId != QuestionType.TextBlock)
                                                        {
                                                            <select class="form-control questiontype-select"
                                                                    id="questiontype-@question.ID"
                                                                    name="questiontype-@question.ID"
                                                                    onchange="showEditButton(@question.ID)"
                                                                    @(question.QuestionDataTypeId != QuestionDataType.NotSet ? "disabled=\"disabled\"" : "")>

                                                                @foreach (var type in Enum.GetValues(typeof(QuestionType)).Cast<QuestionType>().Where(questionType => !typesUserCannotAdd.Contains(questionType)))
                                                                {
                                                                    <option value="@((int)type)" @(type == question.QuestionTypeId ? "selected=\"selected\"" : "")>
                                                                        @type.ToString().SplitByUpperCase()
                                                                    </option>
                                                                }
                                                            </select>
                                                        }
                                                        else if (question.QuestionTypeId == QuestionType.TextBlock)
                                                        {
                                                            <input type="hidden"
                                                                   value="@((int)QuestionType.TextBlock)"
                                                                   id="questiontype-@question.ID"
                                                                   name="questiontype-@question.ID" />
                                                        }
                                                    </td>
                                                    <td>
                                                        <button type="button"
                                                                class="btn btn-default md-trigger btn-space hide"
                                                                data-modal="modal-options"
                                                                onclick="setOptions(@question.ID)"
                                                                id="btn-setoptions-@question.ID">
                                                            Edit Options
                                                        </button>
                                                        <input type="hidden" class="options-input"
                                                               id="options-text-@question.ID"
                                                               name="options-text-@question.ID"
                                                               value="@question.Options" />

                                                        <button type="button"
                                                                class="btn btn-default md-trigger btn-space hide"
                                                                data-modal="modal-link"
                                                                onclick="setLink(@question.ID)"
                                                                id="btn-setlink-@question.ID">
                                                            Edit Link
                                                        </button>
                                                        <input type="hidden"
                                                               id="link-text-@question.ID"
                                                               name="link-text-@question.ID"
                                                               value="@question.Link" />
                                                        <button type="button"
                                                                class="btn btn-default md-trigger btn-space hide"
                                                                data-modal="modal-rating"
                                                                onclick="setRating(@question.ID)"
                                                                id="btn-setratings-@question.ID">
                                                            Edit Ratings
                                                        </button>
                                                        <input type="hidden" class="rating-input"
                                                               id="rating-text-@question.ID"
                                                               name="rating-text-@question.ID"
                                                               value="@question.Options" />
                                                    </td>

                                                    <td>
                                                        @{Html.RenderPartial(
                                                                              "~/Views/Shared/_SwitchButton.cshtml",
                                                                              question.IsActive,
                                                                              new ViewDataDictionary()
                                                                              {
                                                                                                                    { "checkboxname", "active-" + question.ID },
                                                                                                                    { "checkboxid", "active-" + question.ID },
                                                                                                                    { "disabled", question.IsLocked },
                                                                                                                    { "classname", "question-isactive" }
});}
                                                    </td>
                                                    <td>
                                                        @if (question.QuestionTypeId != QuestionType.TextBlock)
                                                        {
                                                            Html.RenderPartial(
                                                                   "~/Views/Shared/_SwitchButton.cshtml",
                                                                   question.IsRequired,
                                                                   new ViewDataDictionary()
                                                                   {
                                                                                                                { "checkboxname", "required-" + question.ID },
                                                                                                                { "checkboxid", "required-" + question.ID },
                                                                                                                { "disabled", question.IsLocked },
                                                                                                                { "classname", "question-isrequired" }
});
                                                        }
                                                    </td>
                                                    <td>
                                                        @{Html.RenderPartial(
                                                                                "~/Views/Shared/_SwitchButton.cshtml",
                                                                                question.IsAnswerDescriptionEnabled,
                                                                                new ViewDataDictionary()
                                                                                {
                                                                                                                    { "checkboxname", "answerDescription-" + question.ID },
                                                                                                                    { "checkboxid", "answerDescription-" + question.ID },
                                                                                                                    { "disabled", question.IsLocked },
                                                                                                                    { "classname", "question-IsAnswerDescriptionEnabled" }
});}
                                                    </td>
                                                    <td>
                                                        <button class="btn btn-default btn-sm md-trigger" data-modal="modal-delete" onclick="deleteQuestion('@question.Text', '@Url.Action("delete","Account", new { id = question.ID.ToString()})')"><span class="text-danger"><i class="s7-trash"></i></span></button>
                                                    </td>
                                                </tr>
                                                count++;
                                            }

                                            @if (questionGroup.IsNotEmpty())
                                            {
                                                if (questionGroup.QuestionGroupDataTypeId == QuestionGroupDataType.NotSet || true)
                                                {
                                                    <tr>
                                                        <td colspan="5">
                                                            <button type="button" class="btn btn-default" onclick="addQuestion()">
                                                                <i class="s7-plus"></i> Add Question
                                                            </button>
                                                            <button type="button" class="btn btn-default" onclick="addTextBlock()">
                                                                <i class="s7-plus"></i> Add Text Block
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }

                    @if (qgId.HasValue)
                    {
                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-default btn-lg btn-block" onclick="navigateForm('@Url.Action("formedit", "account", new { id = Model.ID, qg = qgId, cmd = "prev" })')">&laquo; Previous</button>
                        </div>
                    }
                    else
                    {
                        <div class="col-sm-2"></div>
                    }
                    <div class="col-sm-8">
                        <button type="submit" class="btn btn-default btn-lg btn-block" onclick="Validate()"><i class="s7-diskette"></i> Save</button>
                    </div>
                    @if (questionGroups.Count() > 0 ? questionGroups.Last().ID != qgId && qgId != 0 : false)
                    {
                        <div class="col-sm-2">
                            <button type="submit" class="btn btn-primary btn-lg btn-block" onclick="navigateForm('@Url.Action("formedit", "account", new { id = Model.ID, qg = qgId, cmd = "next" })')">Next &raquo;</button>
                        </div>
                    }

                    <input type="hidden" name="newquestioncount" id="newquestioncount" value="0" />

                </form>
            </div>
            <div class="col-md-4 col-lg-3">

                <div id="list1" class="dd">
                    <ol class="dd-list">
                        <li data-id="1" class="dd-item">
                            <div class="dd-handle @(!qgId.HasValue ? "active" : "")">
                                <a href="@Url.Action("formedit", "account", new { id = Model.ID.ToString() })">Settings</a>
                            </div>
                        </li>

                        @{ Html.RenderPartial("_FormEditMenu",
                                          Model,
                                          new ViewDataDictionary() {
                                        { "RegistrantType", RegistrantType.Individual },
                                        { "QuestionGroups", individualGroups },
                                        { "QuestionGroupId", qgId }
});
                        }

                        <li class="dd-item">
                            <div class="dd-handle">
                                &nbsp;&nbsp;&nbsp;&nbsp;
                                <a href="@Url.Action("formedit", "account", new { id = Model.ID.ToString(), qg = 0 })">
                                    + Add New Section
                                </a>
                            </div>
                        </li>

                        @{ Html.RenderPartial("_FormEditMenu",
                                          Model,
                                          new ViewDataDictionary() {
                                        { "RegistrantType", RegistrantType.Organization },
                                        { "QuestionGroups", organizationGroups },
                                        { "QuestionGroupId", qgId }
});
                        }

                    </ol>
                </div>

            </div>

        </div>

    </div>

</div>

<!------- Options and Emoji Modal Pop-up------------->
<div id="modal-options" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-options" name="form-options" action="#" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Edit <span id="modal-options-title">Options</span></h3>
            </div>
            <div class="clearfix"></div>

            <div class="modal-body form fixed-height-modal-options">

                <p>Update your options here. Your options are not saved until you hit the save button on the screen</p>
                <p class="twoOptionsValidation text-danger hide">Please add atleast two options.</p>
                <p class="invalid-char text-danger hide">| sign is not allowed.</p>
                <p class="requiredData text-danger hide">Please select emojis.</p>

                <div class="table-responsive">
                    <table class="table options-table emoji-option-table" id="options-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Value <span style="color:red">*</span></th>
                                <th>Description (optional)</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="questionRow" id="option-1">
                                <td>
                                    Option 1
                                </td>
                                <td>
                                    <input type="text" value="" id="option-1" required class="form-control col-sm-3 option" onfocus="this.select()" />
                                </td>
                                <td>
                                    <input type="text" value="" id="optionDescription-1" class="form-control col-sm-3 optionDescription" onfocus="this.select()" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-default btn-sm md-trigger" onclick="removeOption($(this).closest('tr').attr('id'))"><span class="text-danger"><i class="s7-trash"></i></span></button>
                                </td>
                            </tr>

                            <tr>
                                <td colspan="4">
                                    <button type="button" class="btn btn-default" onclick="addOption()">
                                        <i class="s7-plus"></i>
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close" onclick="removeValidations()">Cancel</button>
                <button type="button" data-dismiss="modal" class="btn btn-primary" onclick="updateOptions()">Done</button>
            </div>
            <div class="clearfix"></div>
        </div>
    </form>
</div>
<!------- Enf of Options and Emoji Modal Pop-up------------->
<!------- Link Modal Pop-up------------->
<div id="modal-link" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-link" action="#" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title modalLinkTitle">Edit Link</h3>
            </div>
            <div class="modal-body form fixed-height-modal-options">

                <p id="linkMessage">Enter the url below. This will make your question label clickable and it will open a new window to your link. Note: Your link is not saved until you hit the <strong>Save</strong> button after you click <strong>Done</strong></p>

                <div class="form-group textAreaOption">
                    <label><span id="question-link-label"></span></label>
                    <textarea class="form-control" id="question-link" name="question-link" rows="6" placeholder="ex: http://yourdomain.com/go-here"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="button" data-dismiss="modal" class="btn btn-primary md-close" onclick="updateLink()">Done</button>
            </div>
        </div>
    </form>
</div>
<!------- End of Link Modal Pop-up------------->
<!------- Rating Modal Pop-up------------->
<div id="modal-rating" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-rating" name="form-rating" action="#" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Edit Rating</h3>
            </div>
            <div class="modal-body form fixed-height-modal-options">                
                <p id="valueRequired" class="text-danger hide">Value is required.</p>
                <p class="minMaxValidation text-danger hide">Max value should be greater than min value.</p>
                <p id="invalidBarChar" class="text-danger hide">| sign is not allowed.</p>
                <div class="form-group row d-flex">
                    <div class="col">
                        <input class="form-control input-sm rating" required id="question-rating-min" name="question-rating-min" oninput="setOptionalLabelAndIncrement();" onkeyup="if (/\D/g.test(this.value)) this.value = this.value.replace(/\D/g,'')" />
                    </div>

                    <div class="col">
                        <label class="rating-label">
                            to
                        </label>
                    </div>

                    <div class="col">
                        <input class="form-control input-sm rating" required id="question-rating-max" name="question-rating-max" oninput="setOptionalLabelAndIncrement();" onkeyup="if (/\D/g.test(this.value)) this.value = this.value.replace(/\D/g,'')" />
                    </div>

                    <div class="col">
                        <label class="rating-label">
                            by increments of
                        </label>
                    </div>

                    <div class="col">
                        <select class="form-control input-sm rating" id="question-rating-increment" onchange="setRatingIncrement()">
                            <option>1</option>
                            <option>2</option>
                            <option>5</option>
                            <option>10</option>
                            <option>25</option>
                        </select>
                    </div>
                </div>                

                <div class="form-group row">
                    <div class="col-xs-1">
                        <label class="rating-label"><span id="rating-min-label">1</span></label>
                    </div>
                    <div class="col-xs-6">
                        <input class="form-control input-sm" id="question-rating-label-min" required placeholder="Label (Optional)" />
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-xs-1">
                        <label class="rating-label"><span id="rating-max-label">5</span></label>
                    </div>
                    <div class="col-xs-6">
                        <input class="form-control input-sm" id="question-rating-label-max" required placeholder="Label (Optional)" />
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="button" data-dismiss="modal" class="btn btn-primary" onclick="updateRating()">Done</button>
            </div>
        </div>
    </form>
</div>
<!-------End of Rating Modal Pop-up------------->
<!------- Delete Modal Pop-up------------->
<div id="modal-delete" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Delete Question</h3>
        </div>
        <div class="modal-body form fixed-height-modal-options">

            <p>Are you sure you want to delete <strong><span id="delete-question-name"></span></strong>? </p><p>This action cannot be undone.</p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-danger" href="#" id="delete-question-button">Delete &raquo;</a>
        </div>
    </div>
</div>
<!-------End of Delete Modal Pop-up------------->

<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jquery/1.8.3/jquery.min.js"></script>
<link rel="stylesheet" href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.24/themes/smoothness/jquery-ui.css" />
<script type="text/javascript" src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.8.24/jquery-ui.min.js"></script>

<script>
    var selectedQuestion = null;
    var newQuestionNumber = 0;
    var optionQuestionType = 0;
    var emojiDictionary = [
        { key: "grinning", value: "Happy" },
        { key: "grin", value: "Thrilled" },
        { key: "blush", value: "Pleased" },
        { key: "laughing", value: "Laughing" },
        { key: "sweat_smile", value: "Relieved" },
        { key: "joy", value: "Funny" },
        { key: "wink", value: "Playful" },
        { key: "slight_smile", value: "Content" },
        { key: "upside_down", value: "Upside Down" },
        { key: "heart_eyes", value: "Love" },
        { key: "innocent", value: "Innocent" },
        { key: "stuck_out_tongue", value: "Goofy" },
        { key: "thinking", value: "Unsure" },
        { key: "neutral_face", value: "Neutral" },
        { key: "sleeping", value: "Tired" },
        { key: "mask", value: "Sick" },
        { key: "slight_frown", value: "Sad" },
