    function uncheckAllAnswerDescription() {
        $('input[id^="answerDescription-"][disabled!="disabled"]').prop('checked', false);
    }


    function Validate() {
        $(".btn btn-default btn-lg btn-block").removeAttr("disabled");
        var validated = true;
        $("#form1 tr").each(function (index) {

            //Checking for options empty values
            var td = $(this).find("td:nth-child(4)");
            var optionsInput = td.find("input:first-of-type");
            var ratingInput = td.find("input:last-of-type");
            var optionsButton = td.find("button:first-of-type");
            var ratingButton = td.find("button:last-of-type");
            var linkEmojiButton = td.children('button').eq(1);

            if (optionsInput.val() === '' && !optionsButton.hasClass("hide") ) {
                td.find("button:first-of-type").css("border", "2px solid red").css('cursor', 'pointer').attr('title', 'Please sepcify values.').tooltip({ tooltipClass: 'tooltipclass' });
                validated = false;
            }

            if (optionsInput.val() === '' && !ratingButton.hasClass("hide") ) {
                td.find("button:last-of-type").css("border", "2px solid red").css('cursor', 'pointer').attr('title', 'Please sepcify range.').tooltip({ tooltipClass: 'tooltipclass' });
                validated = false;
            }
        });
        if (!validated) {
            event.preventDefault();
            return false;
        }

        $('#form1').attr('action', '@Url.Action("formedit", "account", new { id = Model.ID.ToString(), qg = qgId })');
    }

    function AddEmojiOne() {
        $(".emojionearea2").emojioneArea({
            pickerPosition: "bottom",
            tonesStyle: "radio",
            shortnames: true,
            search: false,
            events: {
                keyup: (a, e) => {
                    e.stopPropagation();
                    e.preventDefault();
                },
                keypress: (a, e) => {
                    e.stopPropagation();
                    e.preventDefault();
                }
            }
        });
    }

</script>


<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('.question-isactive').click(function () {
            if (!$(this).is(':checked')) {
                var id = $(this).attr('id').split('-')[1];
                $('#required-' + id).prop('checked', false);
                $('#answerDescription-' + id).prop('checked', false);
            }
        });

        $('.question-isrequired').click(function () {
            if ($(this).is(':checked')) {
                var id = $(this).attr('id').split('-')[1];
                $('#active-' + id).prop('checked', true);
            }
        });

        $('.question-IsAnswerDescriptionEnabled').click(function () {
            if ($(this).is(':checked')) {
                var id = $(this).attr('id').split('-')[1];
                $('#answerDescription-' + id).prop('checked', true);
            }
        });

        $('.questiontype-select').each(function () {
            var id = $(this).attr('id').split('-')[1];
            showEditButton(id);
        });

        AddEmojiOne();
    });
</script>

