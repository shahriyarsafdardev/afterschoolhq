    //--Set options type based on emoji/option question type and their labels
    // triggers when pop-up opens
    function setOptions(id,optionString,questionType) {
        selectedQuestion = id;
        var options = '';
        var optionType = "Option";
        $('#modal-options-title').text("Options");
        optionQuestionType = 0;

        //---1---If options type is emoji, then set emoji option and labels
        if ($('#questiontype-' + id).val() == '@((int)QuestionType.Emoji)') {
            $('#modal-options-title').text("Emojis");
            optionType = "Emoji";
            $(".requiredData").addClass("hide");
            optionQuestionType = '@((int)QuestionType.Emoji)';
        }

        //---2---Get option values from hidden field
        if (optionString) {
            options = optionString;
            optionType = questionType;
            if (questionType == "Emoji")
                $('#modal-options-title').text("Emojis");
            else
                $('#modal-options-title').text("Options");
        }
        else {
            options = $('#options-text-' + selectedQuestion).val();
        }
        var rowCount = $("#options-table tr").length - 1;

        //---3---Initialize Modal table, so that for other questions, old question data get removed. we will keep the header and footer rows
        $("#options-table tr").each(function (index) {
            if (index != 0 && index != rowCount) {
                $(this).remove();
            }
        });

        //---4--If options have value then parse string, create rows and populate with values.
        if (options != '') {
            var numberofOptionRows = (options.split(",").length);
            indivdualOption = options.split(',');
            //---Check if numberofOptionRows has value
            for (var i = 0; i < numberofOptionRows; i++) {
                var optionRow = indivdualOption[i];
                var optionRowArray = optionRow.split('|');
                optionNo = i;
                optionValue = optionRowArray[0];

                var optionDescriptionValue = '';
                if (optionRowArray[1]) {
                    optionDescriptionValue = optionRowArray[1];
                }
                //create new row for option modal

                addOptionRow(optionType, optionNo, optionValue, optionDescriptionValue, function () {
                    addEmoji(optionNo + 1);
                });

            }
            indivdualOption = null;
            if (optionType != "Emoji") {
                //descriptions would be disabled only for emojis
                $(".optionDescription").prop('disabled', false);
            }
        }
        else {
            addOption();
        }
        
    }

    function addEmoji(index) {
        var rowCount = $("#options-table tr").length - 1;
        var row = $("#options-table").find(`#Emoji-${index}`);
        var emojiCollection = getEmojis();
        var emojiInput = $(row).find(".emojionearea2");
         emojiInput.emojioneArea({
                pickerPosition: "right",
                filtersPosition: "bottom",
                tonesStyle: "square",
                shortnames: true,
             search: false,

                events: {
                    keyup: (a, e) => {
                        e.stopPropagation();
                        e.preventDefault();
                    },
                    keypress: (a, e) => {
                        e.stopPropagation();
                        e.preventDefault();
                 },
                    emojibtn_click: (a, e) => {
                        $(`.emojionearea2#option-${index}`).text("");
                        $(`.emojionearea2#option-${index}`)[0].emojioneArea.setText(a[0].dataset.name);
                        var emojiKey = a[0].dataset.name;
                        var emojiKeyWithoutColons = emojiKey.replaceAll(":", "");
                        var emojiKeyDescription = emojiDictionary.find(({ key }) => key === emojiKeyWithoutColons);
                        $(`#optionDescription-${index}`).val(emojiKeyDescription.value);
                    }
                },
                filters: {
                    recent: false, // disable recent
                    tones: true, // disable recent
                    objects: false, // disable objects filter
                    symbols: false, // disable symbols filter
                    flags: false, // disable flags filter
                    animals_nature: false,
                    activity: true,
                    travel_places: true,
                    objects: true,
                    symbols: true,
                    flags: true,
                    food_drink:true,
                    smileys_people: {
                        icon: "yum",
                        title: "Smileys & People",
                        emoji: emojiCollection
                    }
                }
            });
    }

    function updateOptions() {
        if (!isNaN(selectedQuestion)) {
            var optionString = '';
            var rowCount = $("#options-table tr").length - 1;
            var validation = true;
            var validChars = true;
            if (rowCount < 3) {
                validation = false;
                $(".twoOptionsValidation").removeClass("hide")
            }
            $("#options-table tr").each(function (index) {
                if (index != 0 && index != rowCount) {
                    var optVal = $(this).find("input.option").val();
                    var optDesc = $(this).find("input.optionDescription").val();
                    if ($('#modal-options-title').text() == 'Emojis') {
                        optVal = emojione.toShort($(this).find("input.option").val());
                        if ($(this).find("input.emojionearea2").val() == "") {
                            $(".requiredData").removeClass("hide")
                            validation = false;
                        }
                    }

                    if ($(this).find("input.option").val() == "") {
                        $(this).find("input.option").addClass("danger");
                        validation = false;
                    }
                    else {
                        if (optVal.includes('|')) {
                            $(this).find("input.option").addClass("danger");
                            validChars = false;
                            validation = false;
                        }
                        else {
                            $(this).find("input.option").removeClass("danger");
                            optVal.trim();
                        }

                        if (optDesc.includes('|')) {
                            $(this).find("input.optionDescription").addClass("danger");
                            validChars = false;
                            validation = false;
                        }
                        else {
                            $(this).find("input.optionDescription").removeClass("danger");
                            optDesc.trim();
                        }
                    }

                    var rowOption;

                    if (optDesc) {
                        rowOption = `${optVal}|${optDesc},`
                    } else {
                        rowOption = `${optVal},`
                    }

                    optionString = optionString + rowOption;

                }
            });

            if (!validChars) {
                $(".invalid-char").removeClass("hide");
            }
            else {
                $(".invalid-char").addClass("hide");
            }

            if (validation == true) {
                var commaIndex = optionString.lastIndexOf(",");
                var optionWithoutLastComma = optionString.substring(0, commaIndex);
                $('#options-text-' + selectedQuestion).val(optionWithoutLastComma);
                $("#btn-setoptions-" + selectedQuestion).css("border", "").tooltip("destroy");

                $("#modal-options").removeClass("md-show");
            }
            else return false;
        }
    }

