    function setOptionalLabelAndIncrement() {

        var ratingMaxValue = $('#question-rating-max').val().replace(/[^\d.-]/g, '');

        if ($.isNumeric($('#question-rating-min').val())) {
            $('#rating-min-label').empty();
            $('#rating-min-label').append($('#question-rating-min').val());
        }

        if ($.isNumeric($('#question-rating-max').val())) {
            $('#rating-max-label').empty();
            $('#rating-max-label').append($('#question-rating-max').val());
        }

        $('#question-rating-increment').empty();

        for (var i = 0; i < ratingMaxValue; i++) {
            if (ratingMaxValue % i == 0) {
                var newOption = $('<option value="' + i + '">' + i + '</option>');
                $('#question-rating-increment').append(newOption);
            }
        }
    }

