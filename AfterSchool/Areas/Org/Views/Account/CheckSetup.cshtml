@model CheckPaymentAccount
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var account = (Account)ViewBag.Account;
    var isFullScreen = (bool)ViewBag.IsFullScreen;

    ViewBag.Title = account.Name;

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!isFullScreen)
{
    Html.RenderPartial("OrgAccountHeader");
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", account);}

    <div class="panel panel-default">
        <div class="panel-heading">
                        
            @if (isFullScreen)
            {
                <div class="pull-right">
                    <a href="@Url.Action("paymentsoptions", "account")" class="btn btn-default">&laquo; Exit</a>
                </div>
            }

            <i class="s7-edit"></i> Settings - Accept Payments
        </div>
        <div class="panel-body">

            @if (isFullScreen)
            {
                <div class="col-md-1"></div>
            }

            <div class="col-md-8 col-lg-9">

                @if (Model.ID.HasValue)
                {
                    <div class="col-md-8 col-md-offset-4">
                        <div role="alert" class="alert alert-success alert-icon">
                            <div class="icon">
                                <span class="s7-info"></span>
                            </div>
                            <div class="message">
                                <p class="text-center">
                                    Your address is now saved
                                </p>
                            </div>
                        </div>
                        <div><p><br /><br /></p></div>
                        <hr />
                    </div>
                }

                <form method="post" action="@Url.Action("checksetup", "account", new { isnew = Request["isnew"], isaccountredirect = Request["isaccountredirect"] })" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <p class="text-center">
                                @if (Model.ID.HasValue)
                                {
                                    @:Update your payment address information
                                }
                                else
                                {
                                    @:Enter your payment address information
                                }
                            </p>
                        </div>
                    </div>

                    <div class="form-group">
                        
                        <div class="col-md-4"></div>
                        <div class="col-md-8">
                            <div class="text-medium-small text-center">
                                <p>Are you an Individual or are you representing a Company?</p>
                            </div>

                            <div class="text-center">
                                <div class="am-radio inline">
                                    <input type="radio"
                                           name="entitytype"
                                           id="entitytype-individual"
                                           value="@((int)LegalEntityType.Individual)"
                                           @(Model.LegalEntityTypeId == LegalEntityType.Individual ? " checked=\"checked\"" : "") />
                                    <label for="entitytype-individual">@LegalEntityType.Individual.ToString()</label>
                                </div>
                                <div class="am-radio inline">
                                    <input type="radio"
                                           name="entitytype"
                                           id="entitytype-company"
                                           value="@((int)LegalEntityType.Company)"
                                           @(Model.LegalEntityTypeId == LegalEntityType.Company ? " checked=\"checked\"" : "") />
                                    <label for="entitytype-company">@LegalEntityType.Company.ToString()</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Payee <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="name" name="name" value="@Model.Name" onfocus="this.select()" required />
                            <p class="muted"><em>Enter who you want us to write the check to</em></p>
                        </div>
                    </div>
                    
                    @{ Html.RenderPartial(
                         "~/Views/Shared/_Address.cshtml",
                         Model.ToAddressViewModel(),
                         new ViewDataDictionary()
                         {
                            { "address1Required", true },
                            { "cityRequired", true },
                            { "stateRequired", true },
                            { "postalCodeRequired", true },
                            { "labelColWidth", 4 }
                         }
                         ); }

                    

                    <div class="form-group text-center">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" class="btn btn-primary btn-xl">Save Payment Information &raquo;</button>
                        </div>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>
