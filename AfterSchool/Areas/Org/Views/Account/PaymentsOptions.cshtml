
@{
    var account = (Account)ViewBag.Account;
    var msgs = (SystemMessages)ViewBag.Messages;
    var isFullScreen = (bool)ViewBag.IsFullScreen;

    ViewBag.Title = account.Name;

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!isFullScreen)
{
    Html.RenderPartial("OrgAccountHeader");
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", account); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Settings - Setup Payment Account
        </div>
        <div class="panel-body">

            <div class="col-md-12">
                @if (account.CanReceiveStripeDeposits())
                {
                    <div class="text-center">
                        <h1 class=""><i class="s7-check-circle text-success"></i> Your payment account has been setup.</h1>
                        <p class="margin-v-30">
                            <button type="button" class="btn btn-default md-trigger" data-modal="modal-disconnect-confirm" onclick="disconnectPaymentAccount()">Disconnect Payment Account</button>
                        </p>
                    </div>

                    Html.RenderPartial("~/Views/Shared/_Modal.cshtml", new ModalViewModel() { ActionButtonHtml = "Disconnect Payment Account &raquo;", ActionButtonId = "btn-disconnect-confirm", HtmlBody = "<p>Are you sure you want to disconnect your payment account? You will not be able to process payments unless you re-connect.</p><p><strong>This action cannot be undone</strong></p>", ID = "modal-disconnect-confirm", Title = "Disconnect Payment Account" });

                    <script>
                        PageEvent.add(PageEvent.AFTER_INIT, function () {
                            $('#btn-disconnect-confirm').click(function () {
                                location.href = '@Url.Action("DisconnectStripe", "account")';
                            });
                        });
                    </script>
                }
                else
                {
                    <div class="margin-20">
                        <h2 class="text-center">Please choose how you want us to pay you.</h2>
                    </div>
                    <div class="row">
                        <div class="col-xl-3 col-lg-2 visible-xl visible-lg"></div>
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                            <table class="table table-bordered">
                                <thead>
                                    <tr class="bg-success">
                                        <th class="text-center text-bold text-white">
                                            <h3>
                                                Get Paid<br />via Direct Deposit
                                            </h3>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">Get payouts daily</div></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">Deposits take only 2 days</div></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">No more trips to the bank</div></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">Automated payouts</div></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @if (!account.CanReceiveACHDeposits())
                                            {
                                                var redirectUri = Server.UrlEncode($"{AfterSchoolLibrary.Helpers.Utilities.BaseUrl()}/org/account/oauthstripe/");

                                                <a href="https://connect.stripe.com/express/oauth/authorize?redirect_uri=@redirectUri&state=@Request["source"]&client_id=@AfterSchoolLibrary.Billing.StripeHelper.PlatformClientId&stripe_user[email]=@account.Email"
                                                    class="btn btn-alt5 btn-xl btn-block">
                                                    Choose Direct Deposits &raquo;
                                                </a>
                                                <a href="@Url.Action("banksetup", "account", new { isnew = 1 })" class="btn btn-alt5 btn-xl btn-block hide">
                                                    Choose Direct Deposits &raquo;
                                                </a>
                                            }
                                            else if (!account.HasStripeConnectedAccount)
                                            {
                                                <a href="@Url.Action("banksetup", "account")" class="btn btn-alt5 btn-xl btn-block">
                                                    Update Direct Deposits &raquo;
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-alt5 btn-xl btn-block" disabled="disabled">
                                                    <i class="s7-check-circle"></i> Connected
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xl-3 col-lg-4 col-md-6 col-sm-12">
                            <table class="table table-bordered">
                                <thead>
                                    <tr class="bg-success">
                                        <th class="text-center text-bold text-white">
                                            <h3>
                                                Get Paid<br />via Check
                                            </h3>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">Get payouts bi-weekly</div></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">Checks take 5 - 7 days</div></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">You'll still have to deposit your check</div></td>
                                    </tr>
                                    <tr>
                                        <td class="text-center"><div class="padding-10 text-medium-small">Must request payout</div></td>
                                    </tr>
                                    <tr>
                                        <td>
                                            @if (account.AccountTypeId == AccountType.School)
                                            {
                                                if (account.GetCheckPaymentAccount().IsEmpty())
                                                {
                                                    <a href="@Url.Action("checksetup", "account", new { isnew = 1 })" class="btn btn-default btn-xl btn-block">
                                                        Choose Checks &raquo;
                                                    </a>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action("checksetup", "account")" class="btn btn-default btn-xl btn-block">
                                                        Update Payout Details &raquo;
                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-default btn-xl btn-block" disabled>
                                                    Must be a school, community center, or church
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-xl-3 col-lg-2 visible-xl visible-lg"></div>
                    </div>
                }
            </div>
        </div>
    </div>      
</div>

