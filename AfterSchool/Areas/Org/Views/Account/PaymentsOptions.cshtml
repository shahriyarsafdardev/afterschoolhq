
@{
    var account = (Account)ViewBag.Account;
    var msgs = (SystemMessages)ViewBag.Messages;
    var isFullScreen = (bool)ViewBag.IsFullScreen;

    ViewBag.Title = account.Name;

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!isFullScreen)
{
    Html.RenderPartial("OrgAccountHeader");
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", account); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Settings - Setup Payment Account
        </div>
        <div class="panel-body">

            <div class="col-md-12">
                <div class="margin-20">
                    <h2 class="text-center">Please choose how you want us to pay you.</h2>
                </div>
                <div class="row">
                    <div class="col-lg-3 visible-lg"></div>
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <table class="table table-bordered">
                            <thead>
                                <tr class="bg-success">
                                    <th class="text-center text-bold text-white">
                                        <h3>
                                            Get Paid<br />via Direct Deposit
                                        </h3>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">Get payouts daily</div></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">Deposits take only 2 days</div></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">No more trips to the bank</div></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">Automated payouts coming soon</div></td>
                                </tr>
                                <tr>
                                    <td>
                                        @if (!account.CanReceiveACHDeposits())
                                        {
                                            <a href="@Url.Action("banksetup", "account", new { isnew = 1 })" class="btn btn-alt5 btn-xl btn-block">
                                                Choose Direct Deposits &raquo;
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("banksetup", "account")" class="btn btn-alt5 btn-xl btn-block">
                                                Update Direct Deposits &raquo;
                                            </a>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-lg-3 col-md-6 col-sm-12">
                        <table class="table table-bordered">
                            <thead>
                                <tr class="bg-success">
                                    <th class="text-center text-bold text-white">
                                        <h3>
                                            Get Paid<br />via Check
                                        </h3>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">Get payouts bi-weekly</div></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">Deposits take 5 - 7 days</div></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">You'll still have to deposit your check</div></td>
                                </tr>
                                <tr>
                                    <td class="text-center"><div class="padding-10 text-medium-small">No automated payouts</div></td>
                                </tr>
                                <tr>
                                    <td>
                                        @if (account.GetCheckPaymentAccount().IsEmpty())
                                        {
                                            <a href="@Url.Action("checksetup", "account", new { isnew = 1 })" class="btn btn-default btn-xl btn-block">
                                                Choose Checks &raquo;
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("checksetup", "account")" class="btn btn-default btn-xl btn-block">
                                                Update Payout Details &raquo;
                                            </a>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-lg-3 visible-lg"></div>
                </div>
            </div>
        </div>
    </div>      
</div>

