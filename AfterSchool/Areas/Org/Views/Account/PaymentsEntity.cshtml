@model PaymentsEntityViewModel
@{
    var account = (Account)ViewBag.Account;
    var msgs = (SystemMessages)ViewBag.Messages;
    var isFullScreen = (bool)ViewBag.IsFullScreen;
    var showForm = !Model.PayoutsEnabled || Model.VerificationStatus != StripeVerificationStatus.Pending;

    ViewBag.Title = account.Name;

    var disabled = "";
    if (Model.PayoutsEnabled || Model.VerificationStatus == StripeVerificationStatus.Pending || Model.VerificationStatus == StripeVerificationStatus.Verified)
    {
        disabled = "disabled=\"disabled\"";
    }

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!isFullScreen)
{
    Html.RenderPartial("OrgAccountHeader");
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", account); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @if (isFullScreen)
            {
                <div class="pull-right">
                    <a href="@Url.Action("paymentsoptions", "account")" class="btn btn-default">&laquo; Exit</a>
                </div>
            }

            <i class="s7-edit"></i> Settings - Accept Payments
        </div>
        <div class="panel-body">

            @if (isFullScreen)
            {
                <div class="col-md-1"></div>
            }

            <div class="col-md-8 col-lg-9">

                @if (Model.ChargesEnabled)
                {
                    <div role="alert" class="alert alert-success alert-icon">
                        <div class="icon">
                            <span class="s7-check-circle"></span>
                        </div>
                        <div class="message">
                            <p class="text-center">
                                Your account has been verified. You can now receive payments.                                
                            </p>
                            @if (!Model.PayoutsEnabled)
                            {
                                <p class="text-center">
                                    Enter your bank account information so we can make deposits directly to your account.
                                </p>
                            }
                        </div>
                    </div>
                }
                else if(Model.RequiresFullSSN.IsTrue())
                {
                    <div role="alert" class="alert alert-danger alert-icon">
                        <div class="icon">
                            <span class="s7-close-circle"></span>
                        </div>
                        <div class="message">
                            <p class="text-center">
                                It has been determined that your full SSN is required to activate your payments account. Please enter your SSN below.
                            </p>
                        </div>
                    </div>
                }
                else if (Model.RequiresDocument.IsTrue())
                {
                    <div role="alert" class="alert alert-danger alert-icon">
                        <div class="icon">
                            <span class="s7-close-circle"></span>
                        </div>
                        <div class="message">
                            <p class="text-center">                                
                                @if (Model.FailedDetailsCode != StripeVerificationFailedCode.NotSet)
                                {
                                    @:We are having issues verifying your identity for the following reason: @Model.FailedDetailsCode.GetDescription()
                                }
                                else
                                {
                                    @:It has been determined that a scan of a Valid Driver's license or Passport is required to be uploaded in order to process payments. 
                                }
                                Please upload your document below and verify the information you have entered previously.
                            </p>
                        </div>
                    </div>
                }
                else if(Model.VerificationStatus == StripeVerificationStatus.Pending)
                {
                     <div role="alert" class="alert alert-info alert-icon">
                        <div class="icon">
                            <span class="s7-info"></span>
                        </div>
                        <div class="message">
                            <p class="text-center text-medium-small">
                                We are verifying your information. We will send you an email when your account is verified.
                            </p>
                            
                            <p class="text-center text-medium-small">
                                In the meantime:
                            </p>

                            @if (!isFullScreen)
                            {
                                <p class="text-center">
                                    You are @(!Model.ChargesEnabled ? "NOT" : "") able to accept payments<br />
                                    You are @(!Model.PayoutsEnabled ? "NOT" : "") able to receive deposits to your bank account
                                </p>
                            }
                            else
                            {
                                <p class="text-center text-medium-small">
                                    <a href="@Url.Action("paymentsbank", "account", new { isnew = Request["isnew"] })">
                                        Setup your bank account to receive deposits
                                    </a>
                                </p>
                            }
                        </div>
                    </div>
                }
                else if (Model.VerificationStatus == StripeVerificationStatus.Unverified)
                {
                    <div role="alert" class="alert alert-danger alert-icon">
                        <div class="icon">
                            <span class="s7-close-circle"></span>
                        </div>
                        <div class="message">
                            <p class="text-center">
                                Your details have not been verified for the following reason: @Model.FailedDetailsCode.GetDescription()
                            </p>
                        </div>
                    </div>
                }
                else if (!isFullScreen)
                {
                     <div role="alert" class="alert alert-danger alert-icon">
                        <div class="icon">
                            <span class="s7-close-circle"></span>
                        </div>
                        <div class="message">
                            <p class="text-center">
                                You will need to submit the info below in order to process payments and receive deposits.
                            </p>
                        </div>
                    </div>
                }
                
                @if (Model.ChargesEnabled && !Model.PayoutsEnabled)
                {
                     <div class="row">
                         <div class="pull-right">
                             <a href="@Url.Action("paymentsbank", "account", new { isnew = Request["isnew"] })" class="btn btn-primary btn-lg">Enter your bank account info &raquo;</a>
                         </div>
                     </div>
                }

                @if (showForm)
                { 
                    <form method="post" action="@Url.Action("paymentsentity", "account", new { isnew = Request["isnew"] })" class="form-horizontal" enctype="multipart/form-data">

                        @if (!Model.ChargesEnabled && Model.VerificationStatus != StripeVerificationStatus.Pending)
                        { 
                            <div role="alert" class="alert alert-info alert-icon">
                                <div class="icon">
                                    <span class="s7-close-circle"></span>
                                </div>
                                <div class="message">
                                    <p class="text-muted">If you're a for-profit company (partnership, LLC, or corporation) please email us at <a href="mailto:support@afterschoolhq.com">support@afterschoolhq.com</a> to enable Direct Deposits or <a href="@Url.Action("checksetup", "account")">enable payouts via check</a></p>
                                </div>
                            </div>
                        }
                        <div class="form-group">
                            <div class="text-center">

                                @if (Model.BusinessType == LegalEntityType.Individual || (!Model.ChargesEnabled && Model.VerificationStatus != StripeVerificationStatus.Pending))
                                {
                                    <div class="text-medium-small text-center margin-t-20">
                                        <p>Are you an Individual or Non-profit Organization?</p>
                                    </div>
                                    <div class="am-radio inline">
                                        <input type="radio"
                                               name="businesstype"
                                               id="entitytype-individual"
                                               value="@((int)LegalEntityType.Individual)"
                                               onclick="showIndividual()"
                                               @(Model.BusinessType == LegalEntityType.Individual ? " checked=\"checked\"" : "") 
                                               @disabled />
                                        <label for="entitytype-individual">Yes</label>
                                    </div>
                                    <div class="am-radio inline">
                                        <input type="radio"
                                               name="businesstype"
                                               id="entitytype-company"
                                               value=""
                                               onclick="hideAll()"
                                               @(Model.BusinessType == LegalEntityType.Company ? " checked=\"checked\"" : "") 
                                               @disabled />
                                        <label for="entitytype-company">No</label>
                                    </div>
                                }
                                @if (Model.BusinessType == LegalEntityType.Company || (!Model.ChargesEnabled && Model.VerificationStatus != StripeVerificationStatus.Pending))
                                {
                                    <div class="am-radio inline hide">
                                        <input type="radio"
                                               name="businesstype"
                                               id="entitytype-company"
                                               value="@((int)LegalEntityType.Company)"
                                               onclick="showCompany()"
                                               @(Model.BusinessType == LegalEntityType.Company ? " checked=\"checked\"" : "") />
                                        <label for="entitytype-company">@LegalEntityType.Company.ToString()</label>
                                    </div>
                                }
                            </div>
                        </div>

                        @if (Model.RequiresFullSSN.IsTrue() || Model.RequiresDocument.IsTrue())
                        {
                            <div class="panel" id="additional-info">
                                <div class="panel-heading">
                                    <span>Additional Information</span>
                                </div>
                                <div class="panel-body">
                                    @if (Model.RequiresFullSSN.IsTrue())
                                    {
                                        <div class="form-group" id="full-ssn">
                                            <label class="col-sm-4 control-label">SSN <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="ssn" name="ssn" value="" onfocus="this.select()" maxlength="9" @disabled />
                                            </div>
                                        </div>
                                    }
                                    @if (Model.RequiresDocument.IsTrue())
                                    {                                        
                                        <div class="form-group">
                                            <div class="col-md-8 col-md-offset-4">
                                                <p>Please upload your Driver's License or Passport. The file must be a jpg or png file and no more than 8 MBs</p>
                                            </div>
                                        </div>

                                        <div class="form-group" id="document-info">
                                            <label class="col-sm-4 control-label">Front <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="file" class="form-control" id="documentfront" name="documentfront" value="" @disabled />
                                            </div>
                                        </div>

                                        <div class="form-group" id="document-info">
                                            <label class="col-sm-4 control-label">Back <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="file" class="form-control" id="documentback" name="documentback" value="" @disabled />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <div id="all-info" class="hide">

                            <div id="individual-info" class="panel">
                                <div class="panel-heading">
                                    <span id="personal-info">Personal Information</span>
                                </div>
                                <div class="panel-body">

                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">First Name <span class="text-danger">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control individual-input" id="firstname" name="firstname" value="@Model.FirstName" onfocus="this.select()" required @disabled />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Last Name <span class="text-danger">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control individual-input" id="lastname" name="lastname" value="@Model.LastName" onfocus="this.select()" required @disabled />
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Date of Birth <span class="text-danger">*</span></label>
                                        <div class="col-sm-8">
                                            @{
                                                Html.RenderPartial(
                                                    "~/Views/Shared/Components/_Date.cshtml",
                                                    new FormInputViewModel()
                                                    {
                                                        Id = "dateofbirth",
                                                        Name = "dateofbirth",
                                                        Value = Model.DateOfBirth.ToShortDateString()
                                                    }
                                                );
                                            }
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">Statement Descriptor / DBA</label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control" id="statementdescriptor" name="statementdescriptor" value="@Model.StatementDescriptor" onfocus="this.select()" @disabled />
                                            <p class="text-muted"><em>This will be shown on the credit card statement of your clients. Must be at least 5 characters and no longer than 22 characters</em></p>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label class="col-sm-4 control-label">SSN(last 4) <span class="text-danger">*</span></label>
                                        <div class="col-sm-8">
                                            <input type="text" class="form-control individual-input" id="ssnlast4" name="ssnlast4" value="" onfocus="this.select()" maxlength="4" required @disabled />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div id="company-info">
                                <div class="panel">
                                    <div class="panel-heading">
                                        <span>Company Information</span>
                                    </div>
                                    <div class="panel-body">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Legal Business Name <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control business-input" id="legalbusinessname" name="legalbusinessname" value="@Model.BusinessName" onfocus="this.select()" @disabled />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Employer Identification Number (EIN) <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control business-input" id="ein" name="ein" value="@Model.EIN" onfocus="this.select()" @disabled />
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Business Phone <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="businessphone" name="businessphone" value="@Model.BusinessPhone" onfocus="this.select()" @disabled />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div id="contact-info">
                                <div class="panel">
                                    <div class="panel-heading">
                                        <span>Contact Information</span>
                                    </div>
                                    <div class="panel-body">

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Email <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="personalemail" name="personalemail" value="@Model.PersonalEmail" onfocus="this.select()" required @disabled />
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Phone <span class="text-danger">*</span></label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="personalphone" name="personalphone" value="@Model.PersonalPhone" onfocus="this.select()" required @disabled />
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="col-md-8 col-md-offset-4">
                                                <p>Please enter your website address. If you do not have a website you can enter a service description.</p>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Website</label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="businessurl" name="businessurl" value="@Model.BusinessUrl" onfocus="this.select()" @disabled />
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <label class="col-sm-4 control-label">Service Description</label>
                                            <div class="col-sm-8">
                                                <input type="text" class="form-control" id="productdescription" name="productdescription" value="@Model.ProductDescription" onfocus="this.select()" @disabled />
                                                <p class="text-muted"><em>Describe what service you provide (ex. I lead an afterschool chess club)</em></p>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>

                            <div id="address-info">
                                <div class="panel">
                                    <div class="panel-heading">
                                        <span id="address-header">Legal Address</span>
                                    </div>
                                    <div class="panel-body">
                                        @{
                                            Html.RenderPartial(
                                                "~/Views/Shared/_Address.cshtml",
                                                Model.ToAddressViewModel(),
                                                new ViewDataDictionary()
                                                {
                                                    { "address1required", true },
                                                    { "cityrequired", true },
                                                    { "staterequired", true },
                                                    { "postalcoderequired", true },
                                                    { "labelcolwidth", 4 },
                                                    { "disabled", disabled.IsNotEmpty() }
                                                });
                                        }
                                    </div>
                                </div>
                            </div>

                            <hr />

                            <div id="tos-info" class="padding-20">
                                <div class="text-center">
                                
                                    @if (Model.PayoutsEnabled || Model.VerificationStatus == StripeVerificationStatus.Pending || Model.VerificationStatus == StripeVerificationStatus.Verified)
                                    {
                                        <p>You have agreed to the <a href="/legal/tos" target="_blank">Terms of Services</a> and <a href="https://stripe.com/us/connect-account/legal" target="_blank">Stripe Terms of Services</a> on @Model.TOSAcceptanceDate.ToLongDateTimeString()</p>
                                    }
                                    else
                                    {
                                        <div class="am-checkbox inline">
                                            <input type="checkbox" name="tosaccept" id="tosaccept" value="true" />
                                            <label class="control-label" for="tosaccept">
                                                I agree to the <a href="/tos" target="_blank">Terms of Services</a> and <a href="https://stripe.com/us/connect-account/legal" target="_blank">Stripe Terms of Services</a>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </div>

                            <div><p>&nbsp;</p></div>

                            @if (!Model.ChargesEnabled && Model.VerificationStatus != StripeVerificationStatus.Pending)
                            {
                                <div class="form-group margin-10 text-center">
                                    <div class="text-center">
                                        <button type="submit" class="btn btn-primary btn-xl">Update and Activate Payments &raquo;</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </form>

                }

                <div>
                    <br />
                    <br />
                    <br />
                    <br />
                </div>

            </div>

            @if (!isFullScreen)
            {            
                <div class="col-md-4 col-lg-3">
                    @{
                        Html.RenderPartial("~/Views/Shared/_AccountPaymentEditNav.cshtml", account); 
                    }
                </div>
            }
        </div>

    </div>
</div>

<script>

    function hideAll() {
        $('#all-info').addClass('hide');
    }

    function showIndividual() {
        if ($('#entitytype-individual').is(':checked')) {
            $('#all-info').removeClass('hide');
            $('#individual-info').removeClass('hide');
            $('#company-info').addClass('hide');

            $('#address-header').html('Personal Address');
            $('#personal-info').html('Personal Information');

            $('.business-input').removeAttr('required');
            $('.individual-input').attr('required', 'required');
        }
    }

    function showCompany() {
        if ($('#entitytype-company').is(':checked')) {
            $('#all-info').removeClass('hide');
            $('#individual-info').addClass('hide');
            $('#company-info').removeClass('hide');

            $('#address-header').html('Company Legal Address');
            $('#personal-info').html('Legal Company Representative');

            $('.business-input').attr('required', 'required');
            $('.individual-input').removeAttr('required');
        }
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (@((int)Model.BusinessType) == '@((int)LegalEntityType.Company)')
            showCompany();
        else
            showIndividual();

        if (@Model.RequiresFullSSN.IsTrue().ToString().ToLower() == true) {
            $('#additional-info').removeClass('hide');
            $('#full-ssn').removeClass('hide');
            $('#ssn').attr('required', 'required');
        }
        if (@Model.RequiresFullSSN.IsTrue().ToString().ToLower() == true) {
            $('#additional-info').removeClass('hide');
            $('#document-info').removeClass('hide');
            $('#document').attr('required', 'required');
        }
            
    });

</script>
