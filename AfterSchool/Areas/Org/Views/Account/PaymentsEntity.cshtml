@model AfterSchoolLibrary.StripeAccount
@{
    var account = (Account)ViewBag.Account;
    var msgs = (SystemMessages)ViewBag.Messages;

    ViewBag.Title = account.Name;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", Model); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-box2"></i> Account - Payment Integrations
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <form method="post" action="@Url.Action("entitypayments", "account")" class="form-horizontal">

                    <div class="panel">
                        <div class="panel-body">
                            <div class="am-radio inline">
                                <input type="radio" name="entitytype" id="entitytype" value="@LegalEntityType.Individual" />
                                <label for="entitytype">@LegalEntityType.Individual.ToString()</label>
                            </div>

                            <div class="am-radio inline">
                                <input type="radio" name="entitytype" id="entitytype" value="@LegalEntityType.Company" />
                                <label for="entitytype">@LegalEntityType.Company.ToString()</label>
                            </div>
                        </div>
                    </div>

                    <div class="panel">
                        <div class="panel-heading">
                           <span id="personal-info">Personal Information</span>
                        </div>
                        <div class="panel-body">

                            <div class="form-group">
                                <label class="col-sm-4 control-label">First Name <span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="firstname" name="firstname" value="" onfocus="this.select()" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Last Name <span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="lastname" name="lastname" value="" onfocus="this.select()" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Birth Date <span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <input type="date" class="form-control" id="birthdate" name="birthdate" value="" onfocus="this.select()" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">Email Address <span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <input type="email" class="form-control" id="emailaddress" name="emailaddress" value="" onfocus="this.select()" required />
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-4 control-label">SSN(last 4) <span class="text-danger">*</span></label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" id="ssnlast4" name="ssnlast4" value="" onfocus="this.select()" maxlength="4" required />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="company-info">
                        <div class="panel">
                            <div class="panel-heading">
                                <span>Company Information</span>
                            </div>
                            <div class="panel-body">

                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Legal Business Name <span class="text-danger">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control" id="legalbusinessname" name="legalbusinessname" value="" onfocus="this.select()" required />
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label class="col-sm-4 control-label">Employer Identification Number (EIN) <span class="text-danger">*</span></label>
                                    <div class="col-sm-8">
                                        <input type="text" class="form-control" id="ein" name="ein" value="" onfocus="this.select()" required />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="address-info">
                        <div class="panel">
                            <div class="panel-heading">
                                <span id="address-header">Legal Address</span>
                            </div>
                            <div class="panel-body">
                                @{
                                    Html.RenderPartial("~/Views/Shared/_Address.cshtml", Model.ToAddressViewModel())
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="reset" class="btn btn-default">Discard Changes</button>
                        </div>
                    </div>
                </form>

            </div>

            <div class="col-md-4 col-lg-3">
                @{
                    Html.RenderPartial("~/Views/Shared/_AccountPaymentEditNav.cshtml", account); 
                }
            </div>
        </div>

    </div>
</div>

<script>

    function showIndividual() {
        $('#company-info').addClass('hide');
        $('#personal-info').removeClass('hide');

        $('#address-header').html('Personal Address');
        $('#personal-info').html('Personal Information');
    }

    function showCompany() {
        $('#personal-info').addClass('hide');
        $('#company-info').removeClass('hide');

        $('#address-header').html('Company Legal Address');
        $('#personal-info').html('Company Representative');

    }

</script>
