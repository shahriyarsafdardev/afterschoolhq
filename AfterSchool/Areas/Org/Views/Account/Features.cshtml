@model AfterSchoolLibrary.Account
@{
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    ViewBag.Title = accountPackage.PackageName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var features = (List<AccountPackageFeature>)ViewBag.Features;
    var featureTypes = System.Enum.GetValues(typeof(FeatureType)).Cast<FeatureType>().OrderBy(x => x.ToString());
}

<div class="page-head">
    <h2>Package: @accountPackage.PackageName</h2>
</div>

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-box2"></i> Account - Features
        </div>
        <div class="panel-body">
            <div class="col-md-8 col-lg-9">
                <form method="post" action="@Url.Action("features", "account")" class="form-horizontal">

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-6">
                            <div>
                                <h3>Features</h3>
                                <p>Enter 0 to turn off feature, a number greater than 0 to activate feature and one denote the max number of the feature the package has</p>
                            </div>
                        </div>
                    </div>

                    @foreach (FeatureType type in featureTypes)
                    {
                        if (type == FeatureType.NotSet)
                        {
                            continue;
                        }

                        var feature = features.Where(x => x.FeatureTypeId == type).FirstOrDefault();
                        var value = feature.IsNotEmpty() ? feature.Max.ToString() : "";

                        <div class="form-group">
                            <label class="col-sm-3 control-label">@type.ToString().SplitByUpperCase()</label>
                            <div class="col-sm-6">
                                <input type="number" class="form-control" id="@type" name="@type" value="@value" onfocus="this.select()" step="1" required />
                            </div>
                        </div>
                    }

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-6">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="reset" class="btn btn-default">Discard Changes</button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_AccountEditNav.cshtml", Model); }
            </div>
        </div>
    </div>
</div>


