@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Account - Default Location
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <form method="post" action="@Url.Action("location", "account")" class="form-horizontal">
                    <div class="col-md-9 col-md-offset-3">
                        <p class="padding-20">
                            The default location is used to make creating your new activities easier. If you typically meet at one location, this will keep you from entering your address over and over again.
                        </p>
                    </div>

                    @{ Html.RenderPartial(
                          "~/Views/Shared/_Address.cshtml",
                          Model.ToAddressViewModel(),
                          new ViewDataDictionary() { { "address1Required", true }, { "address2Required", false }, { "cityRequired", true }, { "stateRequired", true }, { "postalCodeRequired", true } }
                      ); }

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-9">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="reset" class="btn btn-default">Discard Changes</button>
                        </div>
                    </div>
                </form>

            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_AccountEditNav.cshtml", Model); }
            </div>

        </div>
    </div>
</div>
