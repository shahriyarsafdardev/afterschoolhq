@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", Model);}
    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Settings - Company Office
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <form method="post" action="@Url.Action("location", "account")" class="form-horizontal">
                    <div class="col-md-9 col-md-offset-3">
                        <p>
                           Please enter your business location. If you don't have one, you can enter your default location for after school @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()
                        </p>
                        <p>Keep in mind your location may be published. Do not put your private home address in this area.</p>
                    </div>
                    <p>

                    </p>

                    @{ 
                        Html.RenderPartial(
                           "~/Views/Shared/_AccountLocation.cshtml",
                           (Location)ViewBag.Location,
                           new ViewDataDictionary() { { "accountId", Model.ID.Value } }
                       );
                    }

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-9">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="reset" class="btn btn-default">Discard Changes</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
