@model BankInfoViewModel
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var account = (Account)ViewBag.Account;
    var isFullScreen = (bool)ViewBag.IsFullScreen;

    ViewBag.Title = account.Name;

    if (isFullScreen)
    {
        Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    }
}

@if (!isFullScreen)
{
    Html.RenderPartial("OrgAccountHeader");
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", account);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Settings - Bank Account Info
        </div>
        <div class="panel-body">

            @if (isFullScreen)
            {
                <div class="col-md-1"></div>
            }

            <div class="col-md-8 col-lg-9">

                @if (Model.ID.HasValue)
                {
                    <div class="col-md-8 col-md-offset-4">
                        <div role="alert" class="alert alert-success alert-icon">
                            <div class="icon">
                                <span class="s7-info"></span>
                            </div>
                            <div class="message">
                                <p class="text-center">
                                    Your bank account is now saved
                                </p>
                            </div>
                        </div>
                        <div><p><br /><br /></p></div>
                        <hr />
                    </div>
                }

                <form method="post" action="@Url.Action("banksetup", "account", new { isnew = Request["isnew"] })" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <p class="text-center">
                                @if (Model.ID.HasValue)
                                {
                                    @:Update your bank account information.  It must be a US Based bank account.
                                }
                                else
                                {
                                    @:Enter your bank account information. It must be a US Based bank account.
                                }
                            </p>
                        </div>
                    </div>

                    <div class="form-group">
                        
                        <div class="col-md-4"></div>
                        <div class="col-md-8">
                            <div class="text-medium-small text-center">
                                <p>Choose the bank account type</p>
                            </div>

                            <div class="text-center">
                                @foreach (var item in Enum.GetValues(typeof(BankAccountType)).Cast<BankAccountType>().Except(BankAccountType.NotSet.AsList()))
                                {
                                    AccountTypeRadio(item);
                                }
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">What is your Bank? <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="bankname" name="bankname" value="@Model.BankName" onfocus="this.select()" required />
                            <p class="muted"><em>Enter the name of the bank where your account is held</em></p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Who's name is on the bank account? <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="accountholdersname" name="accountholdersname" value="@Model.AccountHoldersName" onfocus="this.select()" required />
                            <p class="muted"><em>Account holder's name</em></p>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Routing Number <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="routingnumber1" name="routingnumber1" value="@Model.RoutingNumber1" onfocus="this.select()" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Verify Routing Number <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="routingnumber2" name="routingnumber2" value="@Model.RoutingNumber2" onfocus="this.select()" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Account Number <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="accountnumber1" name="accountnumber1" value="@Model.AccountNumber1" onfocus="this.select()" required />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-4 control-label">Verify Account Number <span class="text-danger">*</span></label>
                        <div class="col-sm-8">
                            <input type="text" class="form-control" id="accountnumber2" name="accountnumber2" value="@Model.AccountNumber2" onfocus="this.select()" required />
                        </div>
                    </div>

                    <div class="form-group text-center">
                        <label class="col-sm-4 control-label"></label>
                        <div class="col-sm-8">
                            <button type="submit" class="btn btn-primary btn-xl">Save Payment Information &raquo;</button>
                        </div>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>


@helper AccountTypeRadio(BankAccountType bankAccountType)
{
    <div class="am-radio inline">
        <input type="radio"
                name="bankaccounttype"
                id="bankaccounttype-@((int)bankAccountType)"
                value="@((int)bankAccountType)"
                @(Model.BankAccountType == bankAccountType ? " checked=\"checked\"" : "") />
        <label for="bankaccounttype-@((int)bankAccountType)">@bankAccountType.ToString().SplitByUpperCase()</label>
    </div>
}