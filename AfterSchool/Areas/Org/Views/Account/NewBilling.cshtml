@model Account
@{ 
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var cards = Model.GetStripeCards();
    var currentPackage = SessionVariables.AccountPackage;
    var packages = (List<Package>)ViewBag.Packages;
    var suggestedPackage = (Package)ViewBag.SuggestedPackage;
    var returnUrl = "";
    if (ViewBag.ReturnUrl != null)
    {
        returnUrl = (string)ViewBag.ReturnUrl;
    }
    else
    {
        returnUrl = Url.Action("index", "activity");
    }

    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
}

<div class="main-content-new">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-cash"></i> Purchase

            @{Html.RenderPartial("_ExitFullScreen", returnUrl); }
        </div>
        <div class="panel-body padding-lr-zero-sm">
            <div class="col-md-12">
                <form method="post" id="new-billing-form" action="@Url.Action("newpayment", "account")" class="form-horizontal">

                    <div class="panel panel-default panel-small-padding">
                        <div class="panel-heading">
                            Select Your Plan
                        </div>

                        <div class="panel-body">
                            <div class="col-md-12 padding-lr-zero-sm" style="max-height: 500px; overflow-x: auto;">
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Package</th>                                            
                                            <th class="text-center">Monthly Plan</th>
                                            <th class="text-center">Annual Plan (2 months free)</th>
                                        </tr>
                                    </thead>
                                    <tbody>

                                        @foreach (var p in packages)
                                        {
                                            var monthlySelected = "";
                                            var yearlySelected = "";
                                            var current = "";

                                            // ..if suggestedPackage has value, that means user arrived from upgrade button and choose to select other premium plan, so highlight only that package
                                            // ..if suggestedPackage is empty, select current package as highlighted

                                            if (suggestedPackage.IsNotEmpty() && suggestedPackage.ID == p.ID)
                                            {
                                                monthlySelected = " checked=\"checked\" ";
                                            }

                                            if (p.IsNotEmpty() && currentPackage.IsNotEmpty() && p.ID == currentPackage.PackageId)
                                            {
                                                if (suggestedPackage.IsEmpty() && currentPackage.BillingPeriodTypeId == BillingPeriodType.Month)
                                                {
                                                    monthlySelected = " checked=\"checked\" ";
                                                }
                                                else if (suggestedPackage.IsEmpty() && currentPackage.BillingPeriodTypeId == BillingPeriodType.Year)
                                                {
                                                    yearlySelected = " checked=\"checked\" ";
                                                }

                                                current = "Current Package";
                                            }

                                            <tr>
                                                <td>
                                                    <a href="#" onclick="return loadFeatures('@p.ID', '@p.Name')"> @p.Name </a><br />
                                                    @{ 
                                                        if (current.IsNotEmpty())
                                                        {
                                                            <span class="font-size-11">(@current)</span>
                                                        }
                                                     }
                                                </td>


                                                <td class="text-center mobile-padding-zero">
                                                    <div class="am-radio inline">
                                                        <input type="radio" name="selectedpackage" id="selectedpackage-@p.ID-monthly" @monthlySelected value="@((int)BillingPeriodType.Month)_@p.Uid.ToString()" />
                                                        <label for="selectedpackage-@p.ID-monthly">@p.Price.ToCurrency()</label>
                                                    </div>
                                                </td>

                                                <td class="text-center mobile-padding-zero">
                                                    @if (p.PricePerYear > 0)
                                                    {                                                    
                                                        <div class="am-radio">
                                                            <input type="radio" name="selectedpackage" id="selectedpackage-@p.ID-yearly" @yearlySelected value="@((int)BillingPeriodType.Year)_@p.Uid.ToString()" />
                                                            <label for="selectedpackage-@p.ID-yearly">@p.PricePerYear.ToCurrency()</label>
                                                        </div>                                                    
                                                    } else { 
                                                        <div>-</div>
                                                    }
                                                </td>                                               
                                            </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="panel panel-default panel-small-padding">
                        <div class="panel-heading">
                            Payment Details
                        </div>
                        <div class="panel-body">
                            <input id="hidden-stripe-token" type="hidden" name="stripetoken" />
                            <input id="hidden-stripe-card" type="hidden" name="cardId" />

                            <div class="form-group">
                                <label class="col-sm-3 control-label">
                                    Payment method <span class="text-danger">*</span>
                                </label>
                                <div class="col-sm-6">
                                    <select id="ddlPaymentMethod" name="ddlPaymentMethod" class="form-control" required onchange="paymentMethodSelectionChange(this)">
                                        <option value="-1">Select Card...</option>
                                        <option value="0"> + New Card</option>
                                        @foreach (var card in cards)
                                        {
                                            <option value="@card.Id">
                                                @card.Brand,  **** **** **** @card.Last4, @card.Name, @card.ExpMonth / @card.ExpYear
                                            </option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div id="container-add-payment-method" style="display: none;">
                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="new_billing_name">Name on Card</label>
                                    <div class="col-sm-6">
                                        <input type="text" class="form-control" id="new_billing_name" name="name" value="" onfocus="this.select()" required data-tooltip-id="Name" data-toggle='popover' data-trigger='hover' data-content='Name on Card' data-placement='right' />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label class="col-sm-3 control-label" for="new_billing_number">Credit or Debit card</label>
                                    <div class="col-sm-6">
                                        <div id="new_billing_number" class="form-control" style='height: 44px; padding-top: 3px;'>
                                            <!-- A Stripe Element will be inserted here. -->
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div id="new_billing_card_errors" role="alert"></div>
                                </div>
                            </div>

                            <div class="form-group">
                                <label class="col-sm-3 control-label"></label>
                                <div class="col-sm-6">
                                    <button type="button" id="newbilling-button" class="btn btn-primary btn-block btn-lg">Purchase &raquo;</button>
                                    <div id="form-validation-settings" data-form-validation-submit-button="newbilling-button" data-form-validation-submit-text="Purchase &raquo;" data-form-validation-submitting-text="Purchasing..."></div>
                                </div>
                            </div>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<div id="feature-modal"></div>

<script id="script-feature-list" type="text/template">
    <!-- Modal -->
    <div id="modal-feature-list-<%= package_id %>" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title"><%= package_name %></h4>
                </div>
                <div class="modal-body" style="height: 450px; overflow-y: auto;">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% for(i = 0; i < features.length; i++) { %>
                            <tr>
                                <td><%= features[i].type %></td>

                                <% if(features[i].value <= 1) {
                                var isChecked = features[i].value == 1 ? 'checked' : '';
                                %>
                                <td>
                                    <div class="am-checkbox">
                                        <input type="checkbox"
                                               id="feature-type-<%= i %>"
                                               value="<%= features[i].value %>"
                                               disabled="disabled"
                                               {{ <%= isChecked %> }} />
                                        <label for="feature-type-<%= i %>"></label>
                                    </div>
                                </td>
                                <% }
                                else { %>
                                <td><%= features[i].value %></td>
                                <% }%>
                            </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</script>

@section scripts
{
    <script src="https://js.stripe.com/v3/"></script>

    <script type="text/javascript">

        var isCurrentPackage = '@(suggestedPackage.IsNotEmpty())' != 'True';
        var currentPackage = '@((int)currentPackage.BillingPeriodTypeId)_@(currentPackage.PackageUid)';        
        var hiddenStripeCard = $('#hidden-stripe-card');

        PageEvent.add(PageEvent.AFTER_INIT, function () {

            var stripe = Stripe('@AfterSchoolLibrary.Billing.StripeHelper.PublishableKey');
            var elements = stripe.elements();

            var style = {
                base: {
                    iconColor: '#666EE8',
                    color: '#31325F',
                    lineHeight: '40px',
                    fontWeight: 300,
                    fontSize: '16px',

                    '::placeholder': {
                        color: '#CFD7E0',
                    },
                },
            };

            // Create an instance of the card Element.
            var card = elements.create('card', { hidePostalCode: true, style: style });

            // Add an instance of the card Element into the `card-element` <div>.
            card.mount('#new_billing_number');

            $('#newbilling-button').click(function (e) {

                // ..if card value -1, required field error
                // ..if card value 0, new card                
                // ..if card valud > 0, existing card

                if (hiddenStripeCard) {
                    if (hiddenStripeCard.val() == -1 || hiddenStripeCard.val() == "") {
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Please enter valid card to proceed further.',
                            success: false
                        });

                        return;
                    } else if (hiddenStripeCard.val() == 0) {
                        validateAddNewCard();
                    }
                    else {
                        showLoader();
                        submitForm();
                    }
                }
            });

            // ..due to stripe element, this function will come here in AFTER_INIT
            function validateAddNewCard() {
                var name = $('#new_billing_name').val();
                if (name == null || name == undefined || name.length < 3) {
                    Notifications.showBar({
                        title: 'Error',
                        message: 'Please enter card holder name with atleast 3 characters.',
                        success: false
                    });

                    return;
                }

                showLoader();
                updatePurchaseButton(true);

                stripe.createToken(card, { name: name }).then(function (result) {
                    hideLoader();

                    if (result.error) {
                        // Inform the customer that there was an error.
                        Notifications.showBar({
                            title: 'Error',
                            message: result.error.message,
                            success: false
                        });

                        updatePurchaseButton(false);
                    } else {
                        var hiddenStripeToken = $('#hidden-stripe-token');
                        hiddenStripeToken.val(result.token.id);
                        submitForm();
                    }
                });
            }
        });

        updatePurchaseButton(false);

        function updatePurchaseButton(purchasing) {
            if (isCurrentPackage) {
                $('#newbilling-button').html('Current Package Selected &raquo', true);
                $('#newbilling-button').prop('disabled', true);
            } else if (purchasing) {
                $('#newbilling-button').html('Purchasing...');
                $('#newbilling-button').prop('disabled', true);
            } else {
                $('#newbilling-button').html('Purchase &raquo;');
                $('#newbilling-button').prop('disabled', false);
            }
        }

        function submitForm() {
            // Insert the token ID into the form so it gets submitted to the srver
            var form = $('#new-billing-form');
            form.submit();
        }

        $('input[type=radio][name=selectedpackage]').change(function () {
            var currentVal = $(this).val();

            isCurrentPackage = true;
            if (currentVal != currentPackage) {
                isCurrentPackage = false;
            }

            updatePurchaseButton(false);
        });

        function loadFeatures(packageId, packageName) {
            showLoader();

            var url = '@Url.Action("GetFeatures", "Account", new { Area = "Org" })';
            $.ajax({
                type: "GET",
                url: url,
                data: { id: packageId },
                success: function (data) {
                    if (data && data.success == true) {

                        //.. prepare source and template
                        var source = $("#script-feature-list").html();
                        var compiled = _.template(source);

                        //.. format data as JSON and combine with template
                        var compiledHtml = compiled({
                            package_id: packageId,
                            package_name: packageName,
                            features: data.data,
                        });

                        //.. update html to dom
                        $('#feature-modal').html(compiledHtml);
                        $('#modal-feature-list-' + packageId).modal('show');

                        hideLoader();
                        return;
                    }
                    else {
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong, try again after sometime.',
                            success: false
                        });
                        hideLoader();
                        return false;
                    }
                }
            });
        }

        function paymentMethodSelectionChange(selectObject) {
            var value = selectObject.value;
            var containerPaymentMethod = $('#container-add-payment-method');            

            if (value == 0) {
                containerPaymentMethod.show();
            } else {
                containerPaymentMethod.hide();
            }

            hiddenStripeCard.val(value);
        }
    </script>
}