@model Account
@{
    ViewBag.Title = Model.Name;
    var isLocationBasedProvider = ViewBag.IsLocationBasedProvider;
    var msgs = (SystemMessages) ViewBag.Messages;
}


<style>
    .select-instructions {
        font-size:  16px;
        margin-bottom: 32px;
        text-align: center;
    }
    
    .team-invite-form {
        display: grid;
        grid-template-columns: 1fr 2fr 2fr;
        row-gap:  10px;
        column-gap:  20px;
        max-width: 800px;
        margin: 0 auto;
    }
    input[type="radio"] {
        display: none;
    }
    input[type="radio"] + label, .third-party-options {
        border: 2px solid #e7e7e7;
        padding: 10px;
        cursor: pointer;
    }
    
    .third-party-options,
    .third-party-options:hover,
    .third-party-options:visited {
        color: #555555;
    }
    
    input[type="radio"]:checked + label {
        border: 2px solid #00c5a3;
    }
    
    .grid-col-2 {
        grid-column-end: span 2;
    }
    
    h3 {
        font-size: 14px;
        font-weight: bold;
        margin-top: 0;
    }
    
    .light-p {
        color: #b2b2b4;
    }
    
    .hide-until-button-selected {
        display: none;
    }
    
    .text-input-border {
        border: solid 2px #e7e7e7;
    }
    .message-text-area {
        height: 100px;
        resize: none;
        margin-bottom: 15px;
    }
    .cancel-button {
        margin: auto 0;
    }
    
    .send-invite-div {
        text-align: right;
    }
    
    .expand-svg {
        height: 10px;
        width: 10px;
    } 

    .first-option-in-row {
        grid-column: 2;
    }
</style>

@{ Html.RenderPartial("OrgAccountHeader", Model.ID.ToString()); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-users"></i> Invite Team Members
        </div>
        <div class="panel-body">
            <p class="select-instructions">Select the level of permission you would like to grant the invitee. This can be changed at a later date.</p>
            <form method="post" action="@Url.Action("teaminvite", "account")" class="form-horizontal team-invite-form">
                @if (isLocationBasedProvider)
                {
                    <label class="control-label">Administrative</label>
                }
                <input type="radio" name="usertype" id="usertype1" required value="@((int) UserType.Administrator)">
                <label for="usertype1" class="first-option-in-row">
                    <h3>@UserType.Administrator.ToString()</h3>
                    <p>Full access to your account, including financials, activities, and student information.</p>
                </label>
                <input type="radio" name="usertype" id="usertype2" required value="@((int) UserType.Treasurer)">
                <label for="usertype2">
                    <h3>@UserType.Treasurer.ToString()</h3>
                    <p>Access to all financial information, but will <em>not</em> see student or activity information.</p>
                </label>
                @if (isLocationBasedProvider)
                {
                    <label class="control-label">
                        <span>@(Model.AccountTypeId.ToString().SplitByUpperCase())-Sponsored</span>
                        <p class="light-p">Payments from registration go to the organization</p>
                    </label>
                }
                <input type="radio" name="usertype" id="usertype3" required value="@((int) UserType.ProgramDirector)">
                <label for="usertype3" class="first-option-in-row">
                    <h3>@UserType.ProgramDirector.ToString().SplitByUpperCase()</h3>
                    <p>Full access to information pertaining to their own activities.</p>
                </label>
                <input type="radio" name="usertype" id="usertype4" required value="@((int) UserType.Instructor)">
                <label for="usertype4">
                    <h3>@UserType.Instructor.ToString()</h3>
                    <p>Full access to information pertaining to their own activities, <em>excluding</em> financials.</p>
                </label>
                @if (isLocationBasedProvider)
                {
                    <label class="control-label">
                        <span>Provider</span>
                        <p class="light-p">Payments from registration go to the provider</p>
                    </label>
                    <a class="third-party-options" href="@Url.Action("visitors", "account")">
                        <h3>Third-Party Organization &raquo;</h3>
                        <p>
                            Full access to information pertaining to their own activities.
                            They <em>are not</em> employed by your organization.
                        </p>
                    </a>
                    <a class="third-party-options" href="@Url.Action("visitors", "account")">
                        <h3>Paid Instructor &raquo;</h3>
                        <p>
                            Full access to information pertaining to their own activities.
                            They <em>are</em> employed by your organization.
                        </p>
                    </a>
                }

                <label class="control-label hide-until-button-selected">Emails</label>
                <input type="text" class="grid-col-2 hide-until-button-selected text-input-border" id="emails" name="emails" value="@ViewBag.Emails" onfocus="this.select()" required placeholder="name@domain.com, name2@domain.com"/>
                <label class="control-label hide-until-button-selected">Message <em>(Optional)</em></label>
                <textarea class="grid-col-2 hide-until-button-selected message-text-area text-input-border" id="message" name="message" onfocus="this.select()">@ViewBag.InviteMessage</textarea>
                <label class="control-label"></label>
                <a href="@Url.Action("team", "account")" class="text-muted cancel-button">
                    Cancel
                </a>
                <div class="send-invite-div hide-until-button-selected">
                    <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">Send Invite</button>
                </div>

            </form>
        </div>

    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $("#submitBtn").on('click', function () {
                if (!$("input:radio[name='usertype']").is(":checked")) {
                      Notifications.showBar({
                        title: 'Error',
                        message: 'Select any Account type',
                        success: false
                    });
                }
            })
            
            $("input:radio").on('click', () => {
                console.log("account type picked");
                $(".hide-until-button-selected").removeClass("hide-until-button-selected");
            })
        })
       
    </script>
}