@model List<AfterSchoolLibrary.Account>
@{
    ViewBag.Title = "Accounts";
    
}

<div class="page-head">
    <h2>Accounts</h2>
</div>
<div class="main-content">

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-id"></i> Accounts
        </div>

        <div class="panel-body">
            
            <a href="@Url.Action("edit", "account")" class="btn btn-primary btn-space">
                <i class="icon icon-left s7-plus"></i>
                Add Account
            </a>

            <div class="table-responsive">
                <table class="table table-striped">
                    <tr>
                        <th></th>
                        <th>Account Name</th>
                        <th>Account #</th>
                        <th>Is Active</th>
                        <th>Member Since</th>
                    </tr>
                    @if (Model.Count > 0)
                    {
                        foreach (Account a in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("activity", "account", new {id = a.ID})" class="btn btn-primary btn-xs"><i class="icon icon-left s7-id"></i> View</a>
                                </td>
                                <td>@a.Name</td>
                                <td>@a.AccountNumber</td>
                                <td>@a.IsActive.ToYesNo()</td>
                                <td>@a.CreateDate.Value.ToLongDateString()</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">There are no accounts. Please <a href="/account/edit/">add a new account</a></td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
</div>


