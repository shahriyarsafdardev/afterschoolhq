@using AfterSchoolLibrary.Billing
@using AfterSchoolLibrary.Enums
@using Utilities = AfterSchoolLibrary.Helpers.Utilities
@model Account
@{ 
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var currentPackage = (AccountPackage)ViewBag.CurrentPackage;
    var returnUrl = "";
    
    if (ViewBag.ReturnUrl != null)
    {
        returnUrl = (string)ViewBag.ReturnUrl;
    }
    else
    {
        returnUrl = Url.Action("index", "activity");
    }

    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
}

<style>
    p.package-description {
        min-height: 60px;
    }
</style>

<div class="main-content-new">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-cash"></i> Select Plan - Completed
        </div>
        <div class="panel-body padding-lr-zero-sm">
            <div class="col-lg-8 col-lg-offset-2 col-md-12">

                <p class="text-medium-small">
                    Great Job. You now are subscribed to the @currentPackage.PackageName Plan.
                </p>
                
                <p>
                    <button type="button" class="btn btn-primary btn-lg" onclick="location.href='@Url.Action("index", "home")'">Return to Dashboard</button>
                </p>

            </div>
        </div>
    </div>
</div>
