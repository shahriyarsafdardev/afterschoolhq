@model Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-cash"></i> Billing Details
        </div>
        <div class="panel-body">
            <div class="col-md-8 col-lg-9">
                @{Html.RenderPartial("~/Views/Shared/_PaymentDetails.cshtml", Model);}
            </div>
        </div>
    </div>
</div>

