@model Account
@{ 
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var currentPackage = SessionVariables.AccountPackage;
    var suggestedPackage = (Package)ViewBag.SuggestedPackage;
    var returnUrl = "";
    
    if (ViewBag.ReturnUrl != null)
    {
        returnUrl = (string)ViewBag.ReturnUrl;
    }
    else
    {
        returnUrl = Url.Action("index", "activity");
    }

    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
}

<style>
    p.package-description {
        min-height: 60px;
    }
</style>

<div class="main-content-new">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-cash"></i> Select Plan

            @{Html.RenderPartial("_ExitFullScreen", returnUrl); }
        </div>
        <div class="panel-body padding-lr-zero-sm">
            <div class="col-md-12">
                <form method="post" id="new-billing-form" action="" class="form-horizontal">

                    <div class="panel panel-default panel-small-padding">
                        <div class="panel-heading">
                            Choose the best plan for your program!
                        </div>

                        <div class="panel-body">
                        
                            
                            <div class="row">
                                <table class="" style="margin-left: auto; margin-right: auto;">
                                    <tr>
                                        <td class="padding-10">Billing Cycle</td>
                                        <td class="padding-10">
                                            @{
                                                Html.RenderPartial(
                                                    "~/Views/Shared/_SwitchButton.cshtml",
                                                    true,
                                                    new ViewDataDictionary
                                                    {
                                                        {"checkboxname", "annual"},
                                                        {"checkboxid", "annual"},
                                                        {"disabled", false},
                                                        {"onclick", "annualClick()"},
                                                        {"customoptions", new List<string>() {"Monthly","Annually"}},
                                                    });
                                            }
                                        </td>
                                    </tr>
                                </table>
                            </div>
                            
                            <div class="row text-center padding-20">
                                <p>**2 Months free with all annual contracts**</p>
                            </div>
                            
                            <div class="row">
                                <div class="col-md-12 col-lg-3">
                                    <div>
                                        <div class="pull-left">
                                            <h3 class="text-success">Free</h3>
                                        </div>
                                        <div class="pull-right">
                                            <h3 class="text-success">
                                                <span class="monthly hide">$0 / Mo</span>
                                                <span class="annually">$0 / Mo</span>
                                            </h3>
                                            <p>&nbsp;</p>
                                        </div>
                                        <div class="clearfix"></div>
                                    </div>
                                    <p class="package-description">
                                        For organizations with parent paid programs or organizations with free programs looking to try out the platform
                                    </p>
                                    <hr/>
                                    <p class="padding-v-20">
                                        1 User account<br/>
                                        Unlimited Paid Activities<br/>
                                        1 Free Activities<br/>
                                        1 Custom Forms<br/>
                                        1 Location<br/>
                                        50 SMS/mo<br/>
                                        50 Emails/mo<br/>
                                        Live chat & Ticket support<br/>
                                        5% Registration Fee<br/>
                                        &nbsp;<br/>
                                        &nbsp;<br/>
                                    </p>
                                    <p class="text-center">
                                        <button type="button" class="btn btn-default btn-lg btn-block">Choose Free Plan</button>
                                    </p>
                                </div>
                                <div class="col-md-12 col-lg-3">
                                    <div>
                                        <div class="pull-left">
                                            <h3 class="text-success">Lite</h3>
                                        </div>
                                        <div class="pull-right">
                                            <h3 class="text-success text-right">
                                                <span class="monthly hide">$39 / Mo</span>
                                                <span class="annually">$32.50 / Mo</span>
                                            </h3>
                                            <p class="text-right">
                                                <span class="monthly hide">billed monthly</span>
                                                <span class="annually">$390 billed annually</span>
                                            </p>
                                        </div>
                                        <div class="clearfix"></div>
                                    </div>
                                    <p class="package-description">
                                        For solopreneurs with one location that are looking to take their program to the next level
                                    </p>
                                    <hr/>
                                    <p class="padding-v-20">
                                        2 User Accounts<br/>
                                        Unlimited Paid Activities<br/>
                                        5 Free Activities<br/>
                                        2 Custom Forms<br/>
                                        Data Export<br/>
                                        1 Location (Same timezone)<br/>
                                        5 Active Permission Slips & Field Trips<br/>
                                        100 SMS/mo<br/>
                                        100 Emails/mo<br/>
                                        Live chat & Ticket support<br/>
                                        5% Registration Fee<br/>
                                    </p>
                                    <p class="text-center">
                                        <button type="button" class="btn btn-primary btn-lg btn-block">Choose Lite Plan</button>
                                    </p>
                                </div>
                                <div class="col-md-12 col-lg-3">
                                    <div>
                                        <div class="pull-left">
                                            <h3 class="text-success">Premium</h3>
                                        </div>
                                        <div class="pull-right">
                                            <h3 class="text-success text-right">
                                                <span class="monthly hide">$99 / Mo</span>
                                                <span class="annually">$82.50 / Mo</span>
                                            </h3>
                                            <p class="text-right">
                                                <span class="monthly hide">billed monthly</span>
                                                <span class="annually">$990 billed annually</span>
                                            </p>
                                        </div>
                                        <div class="clearfix"></div>
                                    </div>
                                    <p class="package-description">
                                        For small teams with multiple programs serving at more than one location
                                    </p>
                                    <hr/>
                                    <p class="padding-v-20">
                                        5 User accounts<br/>
                                        Unlimited Paid Activities<br/>
                                        15 Free Activities<br/>
                                        5 Custom Forms<br/>
                                        Student CRM<br/>
                                        2 Locations (Same Timezone)<br/>
                                        15 Active Permission Slips & Field Trips<br/>
                                        500 SMS/mo<br/>
                                        500 Emails/mo<br/>
                                        Live chat & Ticket support<br/>
                                        3% Registration Fee<br/>
                                    </p>
                                    <p class="text-center">
                                        <button type="button" class="btn btn-primary btn-lg btn-block">Choose Premium Plan</button>
                                    </p>
                                </div>
                                <div class="col-md-12 col-lg-3">
                                    <div>
                                        <div class="pull-left">
                                            <h3 class="text-success">Pro</h3>
                                        </div>
                                        <div class="pull-right">
                                            <h3 class="text-success text-right">
                                                <span class="monthly hide">$199 / Mo</span>
                                                <span class="annually">$165.83 / Mo</span>
                                            </h3>
                                            <p class="text-right">
                                                <span class="monthly hide">billed monthly</span>
                                                <span class="annually">$1,990 billed annually</span>
                                            </p>
                                        </div>
                                        <div class="clearfix"></div>
                                    </div>
                                    <p class="package-description">
                                        For larger teams with more sophisticated needs
                                    </p>
                                    <hr/>
                                    <p class="padding-v-20">
                                        20 User Accounts<br/>
                                        Unlimited Paid Activities<br/>
                                        25 Free Activities<br/>
                                        10 Custom Forms<br/>
                                        Student CRM<br/>
                                        5 Locations (Same Timezone)<br/>
                                        25 Active Permission Slips and Field Trips<br/>
                                        2000 SMS/mo<br/>
                                        2000 Emails/mo<br/>
                                        Email, Phone & Video  Support<br/>
                                        1% Registration Fee<br/>
                                    </p>
                                    <p class="text-center">
                                        <button type="button" class="btn btn-primary btn-lg btn-block">Choose Pro Plan</button>
                                    </p>
                                </div>
                            </div>
                        
                        </div>
                        
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section scripts
{
    <script>
        function annualClick(){
            
            $('.annually').addClass('hide');
            $('.monthly').addClass('hide');
            
            if ($('#annual').is(':checked')){
                $('.annually').removeClass('hide');
            } else {
                $('.monthly').removeClass('hide');
            }
            
        }
    </script>
}