@model Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var members = (List<WebUser>)ViewBag.Members;
    var needToUpgrade = (bool)ViewBag.NeedToUpgrade;
    var teamAccountsPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.TeamAccounts);

    string accountId = Model.ID.ToString();
    string returnUrl = "";

    if (!ViewData["ReturnUrl"].IsEmpty())
    {
        returnUrl = ViewData["ReturnUrl"].ToString();
    }

    string inviteUrl = Url.Action("invite", "user");

    if (accountId.Length > 0)
    {
        inviteUrl = Url.Action("teaminvite", "account");
    }

    if (accountPackage.IsNotEmpty() && members.Count >= accountPackage.GetFeature(FeatureType.TeamAccounts).Max.Value)
    {
        inviteUrl = "javascript:alert('Please upgrade your account or delete existing user accounts in order to invite additional users')";
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">

            @if (SessionVariables.AccountUserType == UserType.TechSupport)
            {
                <div role="alert" class="alert alert-success alert-icon">
                    <div class="icon">
                        <span class="s7-check-circle"></span>
                    </div>
                    <div class="message">
                        <p class="text-center text-small">
                            Invite Link to Share with Administrators: <a href="@Model.UserInviteUrl" target="_blank">@Model.UserInviteUrl</a>
                        </p>
                    </div>
                </div>
            }

            <div class="pull-right">

                @if (!needToUpgrade)
                {
                    <a href="@inviteUrl" class="btn btn-primary">
                        <i class="icon icon-left s7-plus"></i>
                        Invite Team Member
                    </a>
                }
                else
                {
                     <a href="#" class="btn btn-primary" onclick="return showUpgradeMyPlan('@(teamAccountsPackage.Name)',@(teamAccountsPackage.ID));">
                        <i class="icon icon-left s7-plus"></i>
                        Invite Team Member
                    </a>

                     @*<button class="btn btn-primary md-trigger" data-modal="modal-offering">
                        <i class="icon icon-left s7-plus"></i>
                        Invite Team Member
                    </button>
                   <div id="modal-offering" class="md-modal colored-header custom-width md-effect-9">
                        <form id="form-upgrade" action="" method="post">
                            <div class="md-content">
                                <div class="modal-header">
                                    <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                                    <h3 class="modal-title">Upgrade Your Account</h3>
                                </div>
                                <div class="modal-body form">
                                    <p>You have reached your limit of Team Accounts. Time to upgrade :).</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                                    <a href="@Url.Action("packages", "account")" class="btn btn-primary">Upgrade &raquo;</a>
                                </div>
                            </div>
                        </form>
                    </div>*@
                }
            </div>
            <i class="s7-users"></i> Team
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">
            @{ Html.RenderPartial(
                   "~/Views/Shared/_Users.cshtml", 
                   members,
                   new ViewDataDictionary() { 
                        {"AccountId", Model.ID},
                        {"ReturnUrl", ViewBag.ReturnUrl},
                        {"AccountPackage", accountPackage} 
                   }); }
        </div>
    </div>
</div>

<script>

    function updateAssignment(user, userName, selectBox) {
        let newAssignment = selectBox.value;
        let newAssignmentText = selectBox.options[selectBox.selectedIndex].text;
        console.log(newAssignment, selectBox.selectedIndex, newAssignmentText);
        console.log(user);
        updateAssignment2(user, userName, newAssignment, newAssignmentText);
    }

    function updateAssignment2(user, userName, newAssignment, newAssignmentText) {
        $.get(
            `@Url.Action("updateusertype", "account", new { })?userid=${user}&newusertypeid=${newAssignment}`,
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: `${userName}'s type has been updated to ${newAssignmentText}.`
                    });
                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: `Error updating the user type for ${userName}. Please <a href="mailto:@AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress" class="white">contact support</a>.`
                    });
                }
            }
        );
    }


</script>