@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var clientId = AfterSchoolLibrary.Billing.StripeHelper.PlatformClientId;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-box2"></i> Account - Payment Integrations
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <div role="alert" class="alert alert-info alert-icon">
                    <div class="icon"><span class="s7-check-circle"></span></div>
                    <div class="message">
                        Your account is connect to stripe. Start accepting payments for your activities now :)
                    </div>
                </div>

            </div>

            <div class="col-md-4 col-lg-3">
                @{Html.RenderPartial("~/Views/Shared/_AccountEditNav.cshtml", Model); }
            </div>

        </div>

    </div>
</div>
