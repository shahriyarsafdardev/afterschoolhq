@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var facebookAdPixel = (AccountProperty)ViewBag.FacebookAdPixel;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Account - Integrations
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <form method="post" action="@Url.Action("integrations", "account")" class="form-horizontal">

                    <div class="form-group">
                        <label class="col-sm-3 control-label">Facebook Ad Pixel</label>
                        <div class="col-sm-9">
                            <textarea name="facebookadpixelscript" id="facebookadpixelscript" class="form-control" rows="10" placeholder="Paste Facebook Ad Pixel Code Here">@(facebookAdPixel?.Value ?? "")</textarea>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-9">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="reset" class="btn btn-default">Discard Changes</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
