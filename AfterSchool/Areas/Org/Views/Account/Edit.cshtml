@model Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var value = Model.UniqueName;
    var packages = (List<Package>)ViewBag.Packages;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_AccountDetailsHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-edit"></i> Settings - Details
        </div>
        <div class="panel-body">

            <div class="col-md-8 col-lg-9">

                <form method="post" action="@Url.Action("edit", "account")" class="form-horizontal">
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Organization Name</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="name" name="name" value="@Model.Name" onfocus="this.select()" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Contact Email</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="email" name="email" value="@Model.Email" onfocus="this.select()" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Contact Phone</label>
                        <div class="col-sm-9">
                            <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone" onfocus="this.select()" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Organization Url</label>
                            <div class="col-sm-8">
                                <div class="input-group">
                                    <span class="input-group-addon">http://@AfterSchoolLibrary.Helpers.Utilities.HostName/</span>
                                    <input type="text" class="form-control" name="uniquename" id="uniquename" value="@value" />
                                </div>
                            </div>
                            <div class="col-sm-1">
                                <a href="http://@AfterSchoolLibrary.Helpers.Utilities.HostName/@value" target="_blank" class="btn btn-block btn-link">View</a>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Time Zone</label>
                        <div class="col-sm-9">
                            @{ Html.RenderPartial("~/Views/Shared/Components/_TimezoneDropdown.cshtml", Model.TimeZone.IfEmpty("")); }
                        </div>
                    </div>

                    @if (SessionVariables.OriginalLoggedInUser.IsNotEmpty())
                    {
                        <hr />
                        <div class="form-group">
                            <label class="col-sm-3 control-label"></label>
                            <div class="col-sm-9">
                                Admin Only
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Stripe Customer Id</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" id="stripeCustomerId" name="stripeCustomerId" value="@Model.StripeCustomerId" onfocus="this.select()" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Stripe Subscription Id</label>
                            <div class="col-sm-9">
                                <input type="text" class="form-control" id="stripeSubscriptionId" name="stripeSubscriptionId" value="@accountPackage.StripeSubscriptionId" onfocus="this.select()" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-3 control-label">Start New Trial?</label>
                            <div class="col-sm-9">
                                @{ 
                                    Html.RenderPartial("~/Views/Shared/_SwitchButton.cshtml", false, new ViewDataDictionary
                                    {
                                        { "checkboxname", "startnewtrial" },
                                        { "checkboxid", "startnewtrial" },
                                        { "disabled", false },
                                    }); 
                                }
                            </div>
                        </div>
                        <div class="form-group hide">
                            <label class="col-sm-3 control-label">Packages</label>
                            <div class="col-sm-9">
                                <select name="newpackage" class="form-control">
                                    @foreach (var package in packages.OrderBy(x => x.Price))
                                    {
                                        <option value="@package.ID.Value" @(accountPackage.PackageId == package.ID ? "selected=\"selected\"" : "")>
                                            @package.Name
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group hide">
                            <label class="col-sm-3 control-label">Billing Period</label>
                            <div class="col-sm-9">
                                <select name="billingperiod" class="form-control">
                                    @foreach (var periodType in Enum.GetValues(typeof(BillingPeriodType)).Cast<BillingPeriodType>().Where(x => x != BillingPeriodType.NotSet))
                                    {
                                        <option value="@((int)periodType)"
                                                @(accountPackage.BillingPeriodTypeId == periodType ? "selected=\"selected\"" : "")>
                                            @periodType.ToString().SplitByUpperCase()
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        
                    }

                    <div class="form-group">
                        <label class="col-sm-3 control-label"></label>
                        <div class="col-sm-9">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <button type="reset" class="btn btn-default">Discard Changes</button>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
