@model List<Payout>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var payoutCount = ((PagingModel)ViewBag.PagingModel).TotalCount;
    var totalPayoutAmount = (decimal)ViewBag.TotalPayoutAmount;
    var avgPayoutAmount = payoutCount == 0 ? 0 : totalPayoutAmount / payoutCount;
    var totalPendingAmount = (decimal)ViewBag.TotalPendingAmount;
    var maxRequestAmount = (decimal)ViewBag.MaxRequestAmount;
    var lastPayout = (Payout)ViewBag.LastPayout;
    var canReceiveDeposits = SessionVariables.CurrentAccount.CanReceivePaymentDeposits();
    var canRequestAnotherPayout = false;

    if (canReceiveDeposits)
    {
        canRequestAnotherPayout = lastPayout.IsEmpty() || lastPayout.DateRequested.Value.AddDays(1) < DateTime.UtcNow;
    }
    else
    {
        canRequestAnotherPayout = lastPayout.IsEmpty() || lastPayout.DateRequested.Value.AddWeeks(2) < DateTime.UtcNow;
    }
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("_AccountingHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">

            <div class="pull-right">
                @if (canRequestAnotherPayout)
                {
                    <button class="btn btn-primary md-trigger" data-modal="modal-payout-request">
                        Request Payout
                    </button>
                }
                else
                {
                    <button class="btn btn-primary" disabled>
                        @if (canReceiveDeposits)
                        {
                            @: Must wait 1 day from your last payout request
                        }
                        else
                        {
                            @: Must wait 2 weeks from your last payout request
                        }                        
                    </button>
                }
            </div>

            <i class="s7-note2"></i> Payouts
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@payoutCount" id="payoutCount" data-decimals="0" data-suffix="" class="value">@payoutCount</div>
                            <div class="desc">Total Payouts</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@avgPayoutAmount" id="avgPayoutAmount" data-decimals="2" data-suffix="" class="value">@avgPayoutAmount.ToCurrency()</div>
                            <div class="desc">Avg Payout Amt</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalPayoutAmount" id="totalPayoutAmount" data-decimals="2" data-suffix="" class="value">@totalPayoutAmount.ToCurrency()</div>
                            <div class="desc">Total Amt</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalPendingAmount" id="totalPendingAmount" data-decimals="2" data-suffix="" class="value">@totalPendingAmount.ToCurrency()</div>
                            <div class="desc">Pending Amount</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "startdate",
                                Name = "startdate",
                                Value = Request["sdate"],
                                Placeholder = "From Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "enddate",
                                Name = "enddate",
                                Value = Request["edate"],
                                Placeholder = "To Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary btn-lg" onclick="search()">Search</button>
                </div>

                <script>
                    function search() {
                        window.location.href = `@Url.Action("payouts", "accounting")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}`;
                    }
                </script>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Requested On</th>
                            <th>Requested By</th>
                            <th>Status</th>
                            <th>Method</th>
                            <th class="text-center">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var payout in Model)
                            {
                                <tr id="@payout.Uid">
                                    <td>
                                        @payout.Uid
                                    </td>
                                    <td>
                                        @payout.DateRequested.ToShortDateTimeString()
                                    </td>
                                    <td>
                                        @payout.GetRequestor().DisplayName
                                    </td>
                                    <td>
                                        @payout.PayoutStatusId.ToString().SplitByUpperCase()
                                    </td>
                                    <td>
                                        @payout.PaymentTypeId.ToString().SplitByUpperCase()
                                    </td>
                                    <td class="text-center">
                                        @payout.Amount.ToCurrency()
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6">There are no payouts</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                Html.RenderPartial(
                    "~/Views/Shared/_Paging.cshtml",
                    (PagingModel)ViewBag.PagingModel,
                    new ViewDataDictionary()
                    {
                            { "controller", "accounting" },
                            { "action", "index" },
                            { "querystring", $"sdate={Request["sdate"]}&edate={Request["edate"]}" }
                    }
                );
            }
        </div>
    </div>
</div>

<div id="modal-payout-request" class="md-modal colored-header custom-width md-effect-9">
    <form method="post" action="@Url.Action("requestpayout", "accounting")" class="form">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Request Payout</h3>
            </div>
            <div class="modal-body form">

                <div class="form-group">
                    <label for="payout-amount">Amount Requested</label>
                    <input type="number" class="form-control" name="payoutamount" id="payout-amount" step=".01" required="required" min="1.00" />
                    <p class="muted"><em>The maximum amount available for request is <strong>@maxRequestAmount.ToCurrency()</strong></em></p>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" id="confirm-request-btn" class="btn btn-primary md-close">Request &raquo;</button>
            </div>
        </div>
    </form>
</div>
