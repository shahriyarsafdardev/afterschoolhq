@model List<AfterSchoolLibrary.Transaction>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Transactions
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Created On</th>
                            <th>Payer</th>
                            <th>Purchase</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var transaction in Model)
                            {
                                <tr>
                                    <td>
                                        @transaction.CreateDate.ToShortDateTimeString()
                                    </td>
                                    <td>
                                        @transaction.GetPayerAccount().Name
                                    </td>
                                    <td>
                                        @transaction.GetParticipationObjects().DistinctBy(po => new { po.ObjectID, po.ObjectType }).Select(po => po.Name).ToStringList(", ")
                                    </td>
                                    <td>
                                        @transaction.Amount.ToCurrency()
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">There are no transactions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{ 
                Html.RenderPartial(
                    "~/Views/Shared/_Paging.cshtml",
                    (PagingModel)ViewBag.PagingModel,
                    new ViewDataDictionary()
                    {
                        { "controller", "accounting" },
                        { "action", "index" }
                    }
                );
            }
        </div>
    </div>
</div>

