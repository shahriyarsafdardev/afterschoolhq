@model List<Transaction>
@{
    var msgs = (SystemMessages) ViewBag.Messages;
    var account = SessionVariables.CurrentAccount;
    var useStripeConnectedAccount = account.HasFeature(FeatureType.UseStripeConnectedAccount);
    var transactionCount = ((PagingModel) ViewBag.PagingModel).TotalCount;
    var totalTransactionAmount = (decimal) ViewBag.TotalAmountPaid;
    var totalAmountRefunded = (decimal) ViewBag.TotalAmountRefunded;
    var totalAmountRefundedAHQ = (decimal) ViewBag.TotalAmountRefundedAHQ;
    var avgTransactionAmount = transactionCount == 0 ? 0 : totalTransactionAmount / transactionCount;
    var totalFees = (decimal) ViewBag.TotalFeesPaid;
    var totalPaidOut = (decimal) ViewBag.TotalPaidOut;
    var totalAvailableForPayout = (decimal) ViewBag.TotalAvailableForPayout;

    var isSearchResult = Request["sdate"].IsNotBlank() || Request["edate"].IsNotBlank() || Request["q"].IsNotBlank();
    var payoutMsg = account.HasStripeConnectedAccount ? "Pending Payout" : "Available for Payout";
    var isSchoolAccount = account.AccountTypeId.In(FormConstants.LocationProviderAccountTypes);
}

@{ Html.RenderPartial("OrgAccountHeader"); }

<div class="main-content">

@{ Html.RenderPartial("_AccountingHeader"); }

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div class="panel panel-default">

<div class="panel-heading">
    <i class="s7-note2"></i> Transactions
</div>

<div class="panel-body">

<div class="row">

    <div class="col-md-2">
        @{
            Html.RenderPartial(
                "~/Views/Shared/Components/_Date.cshtml",
                new FormInputViewModel
                {
                    Id = "startdate",
                    Name = "startdate",
                    Value = Request["sdate"],
                    Placeholder = "From Date",
                }
                );
        }
    </div>
    <div class="col-md-2">
        @{
            Html.RenderPartial(
                "~/Views/Shared/Components/_Date.cshtml",
                new FormInputViewModel
                {
                    Id = "enddate",
                    Name = "enddate",
                    Value = Request["edate"],
                    Placeholder = "To Date",
                }
                );
        }
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <input type="text" class="form-control" id="search" value="@Request["q"]"/>

            <select id="participationObjects" class="form-control hide">
                <option data-type="" value="">Activities</option>
                @foreach (var po in (List<(int ID, ParticipationObjectType ParticipationObjectTypeId, string Name)>) ViewBag.ParticipationObjects)
                {
                    var selected = "";
                    if (po.ID.ToString() == Request["poid"] && ((int) po.ParticipationObjectTypeId).ToString() == Request["poTypeId"])
                    {
                        selected = "selected=\"selected\"";
                    }
                    <option value="@po.ID" data-type="@((int) po.ParticipationObjectTypeId)" @selected>@po.Name</option>
                }
            </select>

        </div>
    </div>
    <div class="col-md-4">
        <button type="button" class="btn btn-primary btn-lg" onclick="search()">Search</button>
        <button type="button" class="btn btn-primary btn-lg" onclick="DownloadToCSV()">Export To CSV</button>
    </div>

    <script>
                    function search() {
                        window.location.href = `@Url.Action("index", "accounting")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}&q=${encodeURIComponent($('#search').val())}&poId=${encodeURIComponent($('#participationObjects').val())}&poTypeId=${encodeURIComponent($('#participationObjects option:selected').data('type'))}`;
                    }
                    function DownloadToCSV() {
                        window.location.href = `@Url.Action("DownloadCSV", "accounting")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}&q=${encodeURIComponent($('#search').val())}&poId=${encodeURIComponent($('#participationObjects').val())}&poTypeId=${encodeURIComponent($('#participationObjects option:selected').data('type'))}`;
                    }

                </script>
</div>

<div class="row">
    <div class="col-md-2">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-end="@transactionCount" id="transactionCount" data-decimals="0" data-suffix="" class="value">@transactionCount</div>
                <div class="desc">Total Transactions</div>
            </div>
            <div class="icon">
                <span class=""></span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@avgTransactionAmount" id="avgTransactionAmount" data-decimals="2" data-suffix="" class="value">@avgTransactionAmount.ToCurrency()</div>
                <div class="desc">Avg Transaction Amt</div>
            </div>
            <div class="icon">
                <span class=""></span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@totalTransactionAmount" id="totalTransactionAmount" data-decimals="2" data-suffix="" class="value">@totalTransactionAmount.ToCurrency()</div>
                <div class="desc">Total Sold &amp; Credits</div>
            </div>
            <div class="icon">
                <span class=""></span>
            </div>
        </div>
    </div>

    <div class="col-md-2">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-toggle="counter" data-end="@totalAmountRefunded" id="totalAmountRefunded" data-decimals="2" data-suffix="" class="value">@totalAmountRefunded.ToCurrency()</div>
                <div class="desc">Total Refunds &amp; Debits</div>
            </div>
            <div class="icon">
                <span class=""></span>
            </div>
        </div>
    </div>

    @if (!isSearchResult)
    {
        <div class="col-md-2">
            <div class="widget widget-tile widget-bordered">
                <div class="data-info">
                    <div data-toggle="counter" data-end="@totalPaidOut" id="totalPayout" data-decimals="2" data-suffix="" class="value">@totalPaidOut.ToCurrency()</div>
                    <div class="desc">Total Paid Out</div>
                </div>
                <div class="icon">
                    <span class=""></span>
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="widget widget-tile widget-bordered">
                <div class="data-info">
                    <div data-toggle="counter" data-end="@totalAvailableForPayout" id="totalPayout" data-decimals="2" data-suffix="" class="value">@totalAvailableForPayout.ToCurrency()</div>
                    <div class="desc">@payoutMsg</div>
                </div>
                <div class="icon">
                    <span class=""></span>
                </div>
            </div>
        </div>
    }
</div>

<div class="row">
    <div class="col-md-12">
        @if (account.AccountTypeId.In(FormConstants.LocationProviderAccountTypes))
        {
            <button class="btn btn-primary md-trigger" id="request-payout" disabled="disabled" onclick="return requestPayout()" data-modal="modal-payout-request">
                Request Payouts
            </button>
        }
        @if (account.HasStripeConnectedAccount)
        {
            <button class="btn btn-default" id="stripe-login-link" onclick="getStripeLoginLink()">
                Login to Stripe Dashboard
            </button>
        }

    </div>
</div>

<div class="table-responsive">
    <table class="table table-hover table-condensed" id="transaction-table">
        <thead>
        <tr>
            <th>
                <span class="am-checkbox">
                    <input type="checkbox" id="selectAllTransaction" onchange="selectAllTransaction(this)"/>
                    <label for="selectAllTransaction"></label>
                </span>
            </th>
            <th>ID</th>
            <th>Created On</th>
            <th>Payer</th>
            <th>For</th>
            <th>Item Description</th>
            <th class="text-center">Amount Paid</th>
            <th class="text-center">Fees</th>
            <th class="text-center">Your Amount</th>
            <th class="text-center">Status</th>
            <th class="text-center">Type</th>
            <th class="text-center">Refunds</th>
        </tr>
        </thead>
        <tbody>
        @if (Model.Count > 0)
        {
            var useStripeConnect = account.HasFeature(FeatureType.UseStripeConnectedAccount);

            foreach (var transaction in Model)
            {
                var registrant = transaction.GetPurchase()?.GetRegistrant();
                var currentStatus = transaction.GetStatus();
                var showPartialRefundIcon = transaction.CouponId.HasValue && transaction.HasRefundableAmount(false, msgs);
                var disableChk = !transaction.CanRequestPayout() ? "disabled" : "";
                var enableTransfer = !transaction.UsedStripeConnect && !transaction.PayoutId.HasValue && useStripeConnect && account.StripePayoutsEnabled && !transaction.HasRefundsAHQ() && transaction.TransactionTypeId == TransactionType.Charge;
                var ownerAccount = transaction.GetPayerAccount().GetAccountOwner();
                var payerName = transaction.CreatedBy.IsNotEmpty() ? WebUser.Load(transaction.CreatedBy.Value,msgs)?.DisplayName : (ownerAccount.IsNotEmpty() ? WebUser.Load(ownerAccount.ID.Value, msgs)?.DisplayName : transaction.GetPayerAccount().Name);

                <tr id="@transaction.Uid">
                    <td>
                        <span class="am-checkbox">
                            <input type="checkbox"
                                   id="selectTransaction-@transaction.ID"
                                   @disableChk
                                   class="chkTransaction"
                                   onchange="selectTransaction(@transaction.ID,this)"/>
                            <label for="selectTransaction-@transaction.ID"></label>
                        </span>
                    </td>
                    <td>
                        @transaction.GetTransactionNumber()
                    </td>
                    <td>
                        @transaction.CreateDate.ToShortDateTimeString()
                    </td>
                    <td>
                        <span>@(payerName.IfEmpty("N/A"))</span>
                    </td>
                    <td>
                        @if (transaction.IsCharge() && registrant.IsNotEmpty())
                        {
                            @registrant.DisplayName
                        }
                        else
                        {
                            @transaction.GetBillerAccount().Name
                        }
                    </td>
                    <td>
                        @transaction.Description
                    </td>
                    <td class="text-center">
                        @transaction.GetPayerAmount().ToCurrency()

                        @if (transaction.IsRefund() || transaction.IsDebit())
                        {
                            <i class="s7-back-2"></i>
                        }

                        @if (transaction.CouponId.IsNotEmpty() && transaction.CouponValue.IsNotEmpty())
                        {
                            <i class="s7-info icon-small" data-toggle="popover" data-trigger="hover" data-html="true" data-placement="top"
                               data-content="Coupon: @transaction.CouponValue.ToCurrency()">
                            </i>
                        }
                    </td>
                    <td class="text-center">
                        @if (transaction.IsCharge())
                        {
                            @transaction.GetFees().ToCurrency()

                            <i class="s7-info icon-small" data-toggle="popover" data-trigger="hover" data-html="true" data-content="Convenience Fees: @transaction.ConvenienceFeeCharged.ToCurrency() <br/> Credit Card Fees: @transaction.PaymentTypeFeeCharged.ToCurrency()" data-placement="top"></i>
                        }
                        else
                        {
                            @:-
                        }
                    </td>
                    <td class="text-center">
                        @if (transaction.IsCharge() || transaction.IsCredit())
                        {
                            @transaction.GetBillerPayout().ToCurrency()
                        }
                        else
                        {
                            @:-
                        }
                    </td>
                    <td class="text-center">
                        @currentStatus

                        @if (showPartialRefundIcon)
                        {
                            <img src="~/Assets/img/coupon-discount.svg" style="height: 15px; width: 15px;" data-toggle="popover" data-trigger="hover" data-html="true"
                                 data-placement="top" data-content="Discount: @transaction.CouponValue.ToCurrency()" />
                        }
                    </td>
                    <td class="text-center">
                        @if (transaction.PaymentTypeId == PaymentType.NotSet)
                        {
                            @:-
                        }
                        else
                        {
                            @transaction.PaymentTypeId.ToString().SplitByUpperCase()
                        }
                    </td>
                    <td class="text-center">
                        @if (transaction.IsCharge() && !transaction.IsTotallyRefunded(false))
                        {
                            var hasUnfulfilledRequest = transaction.HasUnfulfilledRefundRequests();
                            var disableRequest = hasUnfulfilledRequest || !transaction.CanRefundViaStripe();

                            <button onclick="manualRefund('@transaction.Uid'); showModal('modal-process-refund'); requestRefund('@transaction.Uid',
                             @transaction.GetRefundableAmount(isPartialRefundWithConvenienceFee: true).ToString("#.00"), @((int)transaction.PaymentSourceTypeId))"
                                    class="md-trigger btn btn-sm btn-default">
                                Refund
                            </button>
                        }
                    </td>

                    @if (SessionVariables.AccountUserType == UserType.TechSupport)
                    {
                        <td class="text-center">
                            @if (enableTransfer)
                            {
                                Html.RenderPartial("~/Views/Shared/Modals/_TransferModal-TransferButton.cshtml", transaction);
                            }
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10">There are no transactions</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@{
    Html.RenderPartial(
        "~/Views/Shared/_Paging.cshtml",
        (PagingModel) ViewBag.PagingModel,
        new ViewDataDictionary
        {
            {"controller", "accounting"},
            {"action", "index"},
            {"querystring", $"sdate={Request["sdate"]}&edate={Request["edate"]}&poId={Request["poId"]}&poTypeId={Request["poTypeId"]}"},
        }
        );
}
</div>
</div>
</div>

<div id="modal-process-refund" class="md-modal colored-header custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Process Refund</h3>
        </div>
        <div class="modal-body form text-center">
            <p>Refunds via Stripe will send the registrant's refund back to their original payment method.</p>
            <br/>
            <p>Manual refunds are handled outside of the AfterSchool HQ platform (i.e. cash, check, PayPal, Venmo, etc.).</p>
        </div>
        <div class="modal-footer">
            <button type="button" onclick="showModal('modal-manual-refund')" data-dismiss="modal" class="btn btn-default md-close">Record Manual Refund</button>
            <button type="button" id="btn-stripe-payment" onclick="showModal('modal-stripe-refund')" data-dismiss="modal" class="btn btn-primary md-close">Refund via Stripe</button>
        </div>
    </div>
</div>

<div id="modal-stripe-refund" class="md-modal colored-header custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Submit Refund</h3>
        </div>
        <div class="modal-body form">
            <p class="text-center">Refunds will send the registrant's refund back to their original payment method. You cannot refund more than their original 
                payment amount.</p>
            <br/>
            <div class="form-group">
                <input type="number" id="refund-request-amount" class="form-control" required="required" max="" min="1" step=".01"/>
                <p class="text-muted text-small" id="stripe-refund-notes">Refund Amount<span class="stripe-refund-max-amount"></span></p>
            </div>
            <div class="form-group">
                <input type="text" id="refund-reason" maxlength="100" class="form-control" oninput="enableRequestRefundButton()"/>
                <p class="text-muted text-small" id="stripe-refund-reason-notes">Refund Reason</p>
            </div>
            <input type="hidden" id="refund-request-transaction-uid" value=""/>
            <input type="hidden" id="refund-request-max-amount" value=""/>
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" data-dismiss="modal" id="btn-request-refund" onclick="processRefundRequest()" class="btn btn-primary md-close">Submit Refund</button>
        </div>
    </div>
</div>          

<div id="modal-manual-refund" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Enter Manual Refund</h3>
        </div>
        <div class="modal-body form">
            <p class="text-center">Manual refunds are handled outside of the AfterSchool HQ platform (i.e. cash, check, PayPal, Venmo, etc.).</p>      
            <br/>
            <div class="form-group">
                <input type="number" id="manual-refund-amount" class="form-control" required="required" max="" min="1" step=".01"/>
                <p class="text-muted text-small" id="manual-refund-notes">Refund Amount<span class="stripe-refund-max-amount"></span></p>
            </div>
            <input type="hidden" id="manual-refund-transaction-uid" value=""/>
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" data-dismiss="modal" id="btn-manual-refund" onclick="processManualRefund()" class="btn btn-primary md-close">Record Manual Refund</button>
        </div>
    </div>
</div>

<form action="@Url.Action("RequestPayout", "Accounting")" id="requestPayoutForm" method="post">
    @Html.Hidden("TransactionIds")
</form>

@{ Html.RenderPartial(
       "~/Views/Shared/Modals/_TransferModal.cshtml",
       null,
       new ViewDataDictionary
       {
           {"controller", "accounting"},
           {"action", "createtransfer"},
           {"area", "org"},
       }); }

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#refund-request-amount').blur(function () {
            canProcessRequest();
        });
        $("#refund-request-amount").on('change', function(e){
           this.value = Math.min(this.value, $("#refund-request-amount").attr('max'));
        });
    });

    function manualRefund(uid) {
        $('#manual-refund-transaction-uid').val(uid);
    }

    function processManualRefund() {
        showLoader();
        const uid = $('#manual-refund-transaction-uid').val();
        const amount = $('#manual-refund-amount').val();

        $.get(
            '@Url.Action("ProcessManualRefund", "accounting")?uid=' + uid + '&amount=' + amount,
            function (data) {
                hideLoader();
                if (data && data.status == 'ok') {
                    Notifications.showMessage('Success', 'Your refund for <strong>$' + amount + '</strong> has been saved', true);
                    setTimeout(function () { location.reload() }, 500);
                } else {
                    Notifications.showErrors(data.messages);
                }
            }     
        );

    }

    function requestRefund(uid, maxAmount, paymentType) {
        $('#refund-request-transaction-uid').val(uid);
        $('#refund-request-max-amount').val(maxAmount);
        $('.refund-request-max-amount').html(maxAmount);
        $('#refund-request-amount').attr('max', maxAmount);
        $('#refund-request-amount').val(maxAmount);
        let btnStripe = $('#btn-stripe-payment');
        paymentType !== @((int)PaymentType.CreditCard) ?btnStripe.prop('disabled',true) : btnStripe.prop('disabled',false);
    }

    function canProcessRequest() {
        const amount = $('#refund-request-amount').val();
        const maxAmount = $('#refund-request-max-amount').val();

        if (parseFloat(amount) > parseFloat(maxAmount) || parseFloat(amount) < 1) {
            $('#btn-request-refund').prop('disabled', true);
            $('#refund-request-notes').addClass('text-danger');
            return false;
        }

        if ($('#refund-reason').val().trim().length == 0) {
            $('#btn-request-refund').prop('disabled', true);
            $('#refund-request-reason-notes').addClass('text-danger');
            return false;
        }

        $('#btn-request-refund').prop('disabled', false);
        $('#refund-request-notes').removeClass('text-danger');
        $('#refund-request-reason-notes').removeClass('text-danger');
        return true;
    }

    function enableRequestRefundButton() {
        $('#btn-request-refund').prop('disabled', false);
        $('#refund-request-reason-notes').removeClass('text-danger');
    }

    function processRefundRequest() {
        showLoader();
        const uid = $('#refund-request-transaction-uid').val();
        const amount = $('#refund-request-amount').val();
        const reason = $('#refund-reason').val();

        if (canProcessRequest()) {
            $.post(
                '@Url.Action("requestrefund", "accounting")',
                'uid=' + uid + '&amount=' + amount + '&reason=' + encodeURIComponent(reason),
                function (data) {
                    if (data && data.status == 'ok') {
                        refundTransaction(uid,amount,data.uid, $('#refund-request-payment-source-type').val());
                    } else {
                        Notifications.showErrors(data.messages);
                    }
                }
            );
        }

    }

function refundTransaction(transactionUid,amount,uid) {
        let url = '@Url.Action("refund", "accounting")/' + transactionUid + '?amount='+amount+'&request=' + uid;
        $.get(
            url,
            function (data) {
                hideLoader();
                if (data && data.status === 'ok') {
                    Notifications.showMessage('Success', 'Transaction has been refunded', true);
                    setTimeout(function () { location.reload() }, 500);
                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }

    var selectedTransactions = [];
    function validateForm() {
        var val = parseFloat($("#amount").val());
        var isValid = val >= 0.1;

        $("#confirm-refund-btn").attr('disabled', !isValid);
    }

    function requestPayout() {
        var useStripeConnectedAccount = @Json.Encode(useStripeConnectedAccount);
        var isSchoolAccount = @Json.Encode(isSchoolAccount);
        if (!useStripeConnectedAccount && isSchoolAccount) {
            $("#TransactionIds").val(this.selectedTransactions.join());
            $("#requestPayoutForm").submit();
        } else {
            loadPaymentRestrictionModal();
            return false;
        }
    }

    function selectTransaction(id, event) {
        if (event.checked) {
            this.selectedTransactions.push(id);
        }
        else {
            var index = this.selectedTransactions.map(x => {
                    return x;
                }).indexOf(id);
            this.selectedTransactions.splice(index, 1);
        }
        if (this.selectedTransactions.length > 0)
            $("#request-payout").attr("disabled", false);
        else
            $("#request-payout").attr("disabled", true);
    }

    function selectAllTransaction(event) {
        var allChkBoxes = $(".chkTransaction");
        allChkBoxes.map(function (e) {
            if (event.checked) {
                if ($(this).prop("checked") == false)
                    this.click();
               }
             else {
                if ($(this).prop("checked") == true)
                    this.click();
              }
           })
    }

    function confirmRefund() {
        var amount = $("#amount").val();

        if (!!amount) {
            var uid = $("#modal-refund").data("uid");

            $.post(
                "@Url.Action("refund", "accounting")",
                { uid: uid, amount: amount },
                function (data) {
                    if (data.status === "ok") {
                        var transaction = data.transaction;

                        // update the page header
                        var transactionNumber = parseInt($("#transactionCount").data("end")) + 1;
                        var totalTransactionAmount = (parseFloat($("#totalTransactionAmount").data("end")) + parseFloat(transaction.totalPaid)).toFixed(2);
                        var totalPayout = (parseFloat($("#totalPayout").data("end")) + parseFloat(transaction.payout)).toFixed(2);
                        var avgTransactionAmount = (totalTransactionAmount / transactionNumber).toFixed(2);

                        $("#transactionCount").data("end", transactionNumber);
                        $("#transactionCount").text(transactionNumber);
                        $("#avgTransactionAmount").data("end", avgTransactionAmount);
                        $("#avgTransactionAmount").text("$" + avgTransactionAmount);
                        $("#totalTransactionAmount").data("end", totalTransactionAmount);
                        $("#totalTransactionAmount").text("$" + totalTransactionAmount);
                        $("#totalPayout").data("end", totalPayout);
                        $("#totalPayout").text("$" + totalPayout);
                        $("#" + transaction.originalTransactionUid).data('refunded-amount', "$"+ data.refundedAmount.toFixed(2));

                        // update the transaction table
                        $("#transaction-table tr:first").after('<tr>' +
                            '<td>' + transaction.id + '</td>' +
                            '<td>' + transaction.createdOn + '</td>' +
                            '<td>' + transaction.payer + '</td>' +
                            '<td>' + transaction.refundFor + '</td>' +
                            '<td>' + transaction.itemDescription + '</td>' +
                            '<td>-$' + (-transaction.totalPaid).toFixed(2) + '</td>' +
                            '<td>$' + transaction.platformFee.toFixed(2) + '</td>' +
                            '<td>-$' + (-transaction.payout).toFixed(2) + '</td>' +
                            '<td></td>' +
                            '</tr>'
                        );
                        Notifications.showBar({
                            title: 'Success',
                            message: `<strong>Successful operation!</strong>`,
                            success: true
                        });
                    } else {
                        var items = "";
                        for (var message of data.messages) {
                            items += "<li>" + message.Text + "</li>";
                        }

                        Notifications.showBar({
                            title: 'Error',
                            message: '<ul>' + items + '</ul>',
                            success: false
                        });
                    }
                },
                "json"
            );
        }
    }

    function getStripeLoginLink() {
        $.get(
            '@Url.Action("getstripeloginlink", "accounting")',
            function (data) {
                if (data && data.status == 'ok') {
                    location.href = data.link;
                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }
    function showModal(showModal)
    {
        $(showModal).modal('show');
    }
</script>