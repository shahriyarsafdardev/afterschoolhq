@model Coupon
@{ 
    var msgs = (SystemMessages)ViewBag.Messages;
    var id = Model.Uid.ToString() ?? Request["Uid"];
    var name = (string)Model.Name ?? Request["Name"];
    var description = (string)Model.Description ?? Request["description"];
    var couponCode = (string)Model.CouponCode ?? Request["couponcode"];
    var maxUsesAll = (int)(Model.MaxNumberOfUsesAll.HasValue ? Model.MaxNumberOfUsesAll : Request["maxusesall"].ToInteger());
    var maxUsesPerPerson = (int)(Model.MaxNumberOfUsesPerPerson.HasValue ? Model.MaxNumberOfUsesAll : Request["maxUsesPerPerson"].ToInteger());
    var expirationDate = Model.ExpirationDate.ToShortDateString() ?? Request["expirationDate"];
    var amount = Model.Amount.ToString() ?? Request["amount"];
    var amountType = (int)(Model.AmountTypeId.IsNotEmpty() ? (int)Model.AmountTypeId : Request["amountType"].ToInteger());

    var activityIds = "";
    if (ViewBag.Activities != null)
    {
        activityIds = (string)ViewBag.Activities;
    }
 }

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("_AccountingHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <a href="@Url.Action("coupon", "accounting")" class="btn btn-default pull-right">&laquo; All Coupons</a>
            <i class="s7-plus"></i> Add Coupon
        </div>

        <form class="form form-horizontal" method="post" action="@Url.Action("savecoupon", "accounting", new { id = Model.Uid })">

            <input id="hdnActivityIds" type="hidden" name="activityIds" value="@activityIds" />
            <input id="hdnCouponId" type="hidden" name="id" value="@id" />

            <div class="panel-body">

                <div class="col-md-6 col-sm-12">

                    <div class="col-md-10 p-tb-5">
                        <label class="control-label p-5"> Name </label>
                        <input id="txtName" name="name" value="@name" type="text" class="form-control" required />
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-10 p-tb-5">
                        <label class="control-label p-5"> Description </label>
                        <input id="txtDescription" name="description" value="@description" type="text" class="form-control" />
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-10 p-tb-5">
                        <label class="control-label p-5"> Coupon Code </label>
                        <input id="txtCouponCode" name="couponCode" value="@couponCode" type="text" class="form-control" required/>
                        <p class="text-muted">
                            <em>This is the code parents will enter on checkout.</em>
                        </p>
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-10 p-tb-5">
                        <label class="control-label p-5"> Number of Uses </label>
                        <input id="txtMaxUsesAll" name="maxUsesAll" value="@maxUsesAll" type="number" step="1" class="form-control" required />
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-10 p-tb-5">
                        <label class="control-label p-5"> Number of Uses Per Person </label>
                        <input id="txtMaxUsesPerPerson" name="maxUsesPerPerson" value="@maxUsesPerPerson" type="number" step="1" class="form-control" />
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-10 p-tb-5">
                        <label class="control-label p-5">  Expiration Date </label>
                        @{ Html.RenderPartial("~/Views/Shared/Components/_Date.cshtml",
                                new FormInputViewModel()
                                {
                                    Id = "dateExpdate",
                                    Name = "expirationDate",
                                    Value = expirationDate,
                                    Placeholder = "Expiration Date"
                                }); }
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-10 p-tb-5">
                        <div class="col-md-7 no-padding">
                            <label class="control-label p-5"> Discount Amount </label>
                            <input id="txtAmount" name="amount" value="@amount" type="number" class="form-control" required />
                        </div>
                        <div class="col-md-offset-1 col-md-4 no-padding">
                            <label class="control-label p-5"> % or $ </label>

                            <select class="form-control" id="amountType" name="amountType">

                                @{ 
                                    foreach (var item in EnumHelper.GetSelectList(typeof(AmountType)))
                                    {
                                        var selected = item.Value.ToInteger() == amountType ? " selected=\"selected\" "  : "";
                                        if (item.Text.ToString() != AmountType.NotSet.ToString())
                                        {
                                            <option value="@item.Value.ToString()" @selected>@item.Text</option>
                                        }
                                    }
                                }

                            </select>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>

                <div class="col-md-6 col-sm-12">
                    
                    <div class="col-md-10 p-tb-5">
                        <label class="row control-label p-5"> Activities </label>
                        <div class="form-group has-search">
                            <span class="fa fa-search form-control-search"></span>
                            <input type="text" class="form-control" placeholder="Search" onkeyup="return filterRecords(this.value)">
                        </div>
                    </div>
                    <div class="clearfix"></div>

                    <div id="activities-data" class="am-checkbox form-group " style="max-height: 500px;">
                    </div>
                </div>

                <div class="clearfix"></div>
                <br />
                <br />
                <div class="col-md-12 p-tb-5">
                    <button type="submit" class="btn btn-primary btn-lg btn-center register-continue">Save Coupon</button>
                </div>

                <div class="clearfix"></div>
            </div>

        </form>

    </div>
</div>

@section Scripts
{
    <script type="text/javascript">
        var activities;
        var comma_seperated_activities = @Html.Raw(Json.Encode(activityIds));
        var activityIdsToSelect;

        $(document).ready(function () {
            getActivities();

            if (comma_seperated_activities) {
                activityIdsToSelect = comma_seperated_activities.split(',');
            }
        });

        function getActivities() {
            var url = '@Url.Action("GetActivities", "Accounting", new { Area = "Org" })';

                $.ajax({
                    url: url,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (data && data.success == false) {
                            var errors = ''
                            data.data.forEach(function (error) {
                                if (error && error.Text) {
                                    errors += '<li style="color: white;">' + error.Text + '</li>';
                                }
                                else {
                                    errors += '<li style="color: white;">' + error + '</li>';
                                }
                            });
                            Notifications.showBar({
                                title: 'Error',
                                message: errors,
                                success: false
                            });
                            return false;
                        } else if (data && data.data && data.success == true) {
                            activities = data.data;
                            loadActivities(data.data)
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log(errorThrown);
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong. Please contact customer support.',
                            success: false
                        });
                        return;
                    }
                });
        }

        function loadActivities(data) {
            var divActivities = $('#activities-data');
            divActivities.html('');

            if (data) {
                _.each(data, function (activity) {
                    var isSelected = _.contains(activityIdsToSelect, activity.ID);
                    var html = `<div class="form-check p-tb-5">`;
                    if (isSelected) {
                        html += `<input id="chk-activity-${activity.ID}" name="coupoun-activities" type="checkbox" checked="checked" value="${activity.ID}" onclick="return prepareActivities()">`;
                    } else {
                        html += `<input id="chk-activity-${activity.ID}" name="coupoun-activities" type="checkbox" value="${activity.ID}" onclick="return prepareActivities()">`;
                    }
                    
                    html += `<label for="chk-activity-${activity.ID}" class="margin-h-10 mobile-padding chk-lable">${activity.Title}</label>`;
                    html += `</div>`;
                    divActivities.append(html)
                });
            }
        }

        function filterRecords(search) {
            var filteredActivities = _.filter(activities, function (activity) {
                return activity.Title.toLowerCase().indexOf(search.toLowerCase()) !== -1; // -1 means not present
            });

            loadActivities(filteredActivities);
        }

        function prepareActivities() {
            var ids = $('input[name="coupoun-activities"]:checked').map(function () {
                return this.value;
            }).get().join(",");

            $('#hdnActivityIds').val(ids);
        }
    </script>
}