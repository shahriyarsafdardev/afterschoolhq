@model List<Transaction>
@{ 
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader");}
<div class="main-content">
    @{ Html.RenderPartial("_AccountingHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    <div class="panel panel-default">
        <div class="panel-heading">
            
            Request Payouts - Preview
            
            <div class="pull-right">
                    Total: @ViewBag.TotalPayoutAmount
            </div>
            
            <div class="clearfix"></div>

            <div style="font-size: 13px">
                <p>Please review the following transactions to ensure all of the correct transactions are listed</p>
            </div>

            <div>
                <div class="pull-left">
                    <button class="btn btn-default" onclick="returnToTransactions()">
                       < Cancel
                    </button>
                </div>
                <span class="pull-right">
                    <button class="btn btn-primary" onclick="requestPayout('@ViewBag.TranIds')">
                        Complete Payout Request >
                    </button>
                </span>
            </div>
            <br />
        </div>
        <div class="panel-body">

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Created On</th>
                            <th>Payer</th>
                            <th>For</th>
                            <th>Item Description</th>
                            <th class="text-center">Total Amt Paid</th>
                            <th class="text-center">Platform Fee</th>
                            <th class="text-center">Amount Refunded</th>
                            <th class="text-center">Your Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var transaction in Model)
                        {
                            var registrant = transaction.GetPurchase()?.GetRegistrant();

                            var participationObjects = transaction.GetParticipationObjects();
                            <tr id="@transaction.Uid" data-refunded-amount="@transaction.GetRefundedAmount().ToCurrency()">
                                <td>
                                    @transaction.GetTransactionNumber()
                                </td>
                                <td>
                                    @transaction.CreateDate.ToShortDateTimeString()
                                </td>
                                <td>
                                    @transaction.GetPayerAccount().Name
                                </td>
                                <td>
                                    @if (transaction.IsCharge())
                                    {
                                        if (registrant.IsNotEmpty())
                                        {
                                            @registrant.DisplayName
                                        }
                                        else
                                        {
                                            @transaction.GetPayerAccount().Name
                                        }
                                    }
                                    else
                                    {
                                        @transaction.GetBillerAccount().Name
                                    }
                                </td>
                                <td>
                                    @participationObjects.DistinctBy(po => new { po.ObjectID, po.ObjectType }).Select(po => po.Name).ToStringList(", ")
                                </td>
                                <td class="text-center">
                                    @transaction.GetBillerAmount().ToCurrency()
                                </td>
                                <td class="text-center">
                                    @transaction.GetFeesChargedToBiller().ToCurrency()
                                </td>
                                <td class="text-center">
                                    @transaction.GetRefundedAmountAHQ(true).ToCurrency()
                                </td>
                                <td class="text-center">
                                    @transaction.GetBillerPayout().ToCurrency()
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<form action="@Url.Action("RequestPayoutDone","Accounting")" id="requestPayoutForm" method="post">
    @Html.Hidden("TransactionIds")
</form>

<script>
    function requestPayout(ids) {
        $("#TransactionIds").val(ids);
        $("#requestPayoutForm").submit();
        }
     function returnToTransactions() {
         window.location.href = `@Url.Action("Index", "accounting")`;
    }
</script>


