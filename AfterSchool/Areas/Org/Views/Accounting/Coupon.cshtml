
@model List<Coupon>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
  
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("_AccountingHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-ticket"></i> Coupons
        </div>

        <div class="panel-body">

            <div class="row">
                <div class="col-md-12">
                    <a href="@Url.Action("addcoupon", "accounting")" class="btn btn-primary">
                        <i class="icon icon-left s7-plus"></i>
                        Add Coupon
                    </a>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>
                                <span class="am-checkbox">
                                    <input type="checkbox" id="selectAllTransaction" onchange="selectAllTransaction(this)" />
                                    <label for="selectAllTransaction"></label>
                                </span>
                            </th>
                            <th>ID</th>
                            <th>Code</th>
                            <th>Number of Uses</th>
                            <th>Total Uses Allows</th>
                            <th>Activity</th>
                            <th class="text-center">Amount</th>
                            <th>Expiration Date</th>
                            <th>Copy</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var coupon in Model)
                            {

                                <tr id="@coupon.ID">
                                    <td>
                                        @coupon.CouponCode
                                    </td>
                                    <td>
                                        @coupon.GetNumberOfUses()
                                    </td>
                                    <td>
                                        @coupon.MaxNumberOfUsesAll
                                    </td>
                                    <td>
                                        @coupon.GetAmountAsString()
                                    </td>
                                    <td>
                                        @coupon.ExpirationDate.ToShortDateString()
                                    </td>
                                    <td>
                                        <a href="@Url.Action("copy", "coupon", new { couponId = coupon.Uid })" class="btn btn-default">
                                            <i class="icon icon-left s7-copy-file"></i>
                                            Copy
                                        </a>
                                    </td>
                                    <td>
                                        <a href="@Url.Action("disable", "coupon", new { couponId = coupon.Uid })" class="btn btn-warning">
                                            <i class="icon icon-left s7-junk warning"></i>
                                            @(!coupon.IsDisabled && coupon.ExpirationDate > DateTime.Now ? "Enable" : "Disable")
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">You haven't created any coupons yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
