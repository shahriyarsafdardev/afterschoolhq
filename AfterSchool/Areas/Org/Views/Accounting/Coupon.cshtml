
@model List<Coupon>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var couponFeatureEnabled = SessionVariables.CurrentAccount.HasFeature(FeatureType.ManageCoupons);
    var couponPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.ManageCoupons, SessionVariables.AccountPackage);

}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("_AccountingHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">

            <i class="s7-ticket"></i> Coupons

            <div class="clearfix"></div>

            <div class="pull-right">
                <a href="@Url.Action("editcoupon", "accounting", new { area = "org" })" class="btn btn-primary">
                    <i class="icon icon-left s7-plus"></i>
                    Add Coupon
                </a>
            </div>

            <div class="clearfix"></div>
        </div>

        <div class="panel-body">

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>                   
                            <th>Name</th>
                            <th>Code</th>
                            <th>Total Times Used</th>
                            <th>Max Uses Allowed</th>
                            <th>Activities</th>
                            <th>Discount</th>
                            <th>Expiration Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var coupon in Model)
                            {
                                var participationObjects = coupon.GetParticipationObjects();

                                <tr id="@coupon.ID">
                                    <td>
                                        @coupon.Name
                                    </td>
                                    <td>
                                        @coupon.CouponCode
                                    </td>
                                    <td>
                                        @coupon.GetNumberOfUses()
                                    </td>
                                    <td>
                                        @coupon.MaxNumberOfUsesAll
                                    </td>
                                    <td>
                                        <ul>
                                            @if (participationObjects.IsNotEmpty())
                                            {
                                                foreach (var po in participationObjects)
                                                {
                                                    if (po.IsNotEmpty())
                                                    {
                                                        <li>@po.Name</li>
                                                    }                                                    
                                                }
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        @coupon.GetAmountAsString()
                                    </td>
                                    <td>
                                        @coupon.ExpirationDate.ToShortDateString()
                                    </td>
                                    <td>
                                        <a href="@Url.Action("EditCoupon", "Accounting", new { id = coupon.Uid })" class="btn btn-success btn-sm">
                                            <i class="icon icon-left s7-copy-file"></i>
                                            Edit
                                        </a>
                                        @*<a href="@Url.Action("copy", "coupon", new { couponId = coupon.Uid })" class="btn btn-default btn-sm">
                                            <i class="icon icon-left s7-copy-file"></i>
                                            Copy
                                        </a>
                                        <a href="@Url.Action("disable", "coupon", new { couponId = coupon.Uid })" class="btn btn-warning btn-sm">
                                            <i class="icon icon-left s7-junk warning"></i>
                                            @(!coupon.IsDisabled && coupon.ExpirationDate > DateTime.Now ? "Enable" : "Disable")
                                        </a>*@
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">You haven't created any coupons yet</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<script type="text/javascript">
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (!@(couponFeatureEnabled.ToString().ToLower())) {
            showUpgradeMyPlan('@(couponPackage?.Name)','@(couponPackage?.ID)',true)
        }
    });
</script>