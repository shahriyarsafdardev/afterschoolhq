@model List<RefundRequest>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var totalRequestAmount = Model.Sum(request => Math.Min(request.Amount.Value, request.GetTransaction().GetPayerAmount()));
    var totalAmountAvailable = (decimal)ViewBag.AmountAvailableToRefund;
    var totalAmountRefunded = (decimal)ViewBag.AmountRefunded;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("_AccountingHeader"); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Refund Requests
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalAmountRefunded" id="lblAmountRefunded" data-decimals="2" data-suffix="" class="value">@totalAmountRefunded.ToCurrency()</div>
                            <div class="desc">Total Amount Refunded</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalRequestAmount" id="payoutCount" data-decimals="0" data-suffix="" class="value">@totalRequestAmount.ToCurrency()</div>
                            <div class="desc">Total Amount Requested</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalAmountAvailable" id="avgPayoutAmount" data-decimals="2" data-suffix="" class="value">@totalAmountAvailable.ToCurrency()</div>
                            <div class="desc">Amount Available to Refund</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th class="text-center">Requested On</th>
                            <th class="text-center">Requested By</th>
                            <th class="text-center">For</th>
                            <th class="text-center">Transaction #</th>
                            <th class="text-center">Description</th>
                            <th class="text-center">Transaction Amount</th>
                            <th class="text-center">Refund Requested</th>
                            <th class="text-center">Request Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var request in Model)
                            {
                                var transaction = request.GetTransaction();

                                <tr id="@request.Uid">
                                    <td class="text-center">
                                        @request.CreateDate.ToShortDateTimeString()
                                    </td>
                                    <td class="text-center">
                                        @request.GetCreator().DisplayName
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetPayerAccount().Name
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetTransactionNumber()
                                    </td>
                                    <td class="text-center">
                                        @transaction.Description
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetPayerAmount().ToCurrency()
                                    </td>
                                    <td class="text-center">
                                        @request.Amount.ToCurrency()
                                    </td>
                                    <td class="text-center">
                                        @switch (request.RefundRequestStatusId)
                                        {
                                            case RefundRequestStatus.RequestedByParent:
                                                @:Requested
                                                break;
                                            case RefundRequestStatus.RequestedByProvider:
                                            case RefundRequestStatus.ApprovedByProvider:
                                                @:Pending
                                                break;
                                            case RefundRequestStatus.ApprovedByAfterSchoolHQ:
                                            case RefundRequestStatus.ApprovedManualRefund:
                                                @:Approved
                                                break;
                                            case RefundRequestStatus.Completed:
                                                @:Completed
                                                break;
                                            case RefundRequestStatus.DeniedByAfterSchoolHQ:
                                            case RefundRequestStatus.DeniedByProvider:
                                                @:Denied
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (request.RefundRequestStatusId == RefundRequestStatus.RequestedByParent)
                                        {
                                            <button type="button" class="btn btn-default btn-sm md-trigger" id="btn-approve" onclick="approve('@request.Uid')" data-modal="modal-confirm-approve">
                                                Approve
                                            </button>
                                            <button type="button" class="btn btn-default btn-sm md-trigger" id="btn-deny" onclick="deny('@request.Uid')" data-modal="modal-confirm-deny">
                                                Deny
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">There are no refund requests</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div id="modal-confirm-approve" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Approve?</h3>
        </div>
        <div class="modal-body form">

            Are you sure you want to <strong>approve</strong> this refund request?

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" class="btn btn-default" id="btn-approve-confirm" onclick="confirmApprove()">Approve Electronic Refund &raquo;</button>
            <button type="button" class="btn btn-default" id="btn-approve-confirm-manual" onclick="confirmApproveManual()" title="Approve refund other than the way payment was made (AfterSchool HQ will NOT process the refund)">Approve Manual Refund &raquo;</button>
        </div>
    </div>
</div>

<div id="modal-confirm-deny" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Deny?</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to <strong>deny</strong> this refund request?</p>

            <div class="form-group">
                <label for="request-reason">Reason</label>
                <input type="text" id="deny-reason" maxlength="100" class="form-control" />
                <p class="text-muted text-small" id="deny-reason-notes">Please enter a reason</p>
            </div>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" class="btn btn-default" id="btn-deny-confirm" onclick="confirmDeny()">Deny Refund &raquo;</button>
        </div>
    </div>
</div>

<script>

    let uid = '';

    function approve(request) {
        uid = request;
    }

    function confirmApprove() {
        $.get('@Url.Action("approverefundrequest", "accounting")?uid=' + uid, function (data) {

            if (data && data.status == 'ok') {
                Notifications.showMessage('Success', 'The refund request has been approved', true);
                setTimeout(function () { location.reload() }, 500);
            } else {
                Notifications.showErrors(data.messages);
            }

        });
    }

    function confirmApproveManual() {
        $.get('@Url.Action("approvemanualrefundrequest", "accounting")?uid=' + uid, function (data) {

            if (data && data.status == 'ok') {
                Notifications.showMessage('Success', 'The refund request has been approved', true);
                setTimeout(function () { location.reload() }, 500);
            } else {
                Notifications.showErrors(data.messages);
            }

        });
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#deny-reason').blur(function () {
            canProcessDenial();
        });
    });

    function deny(request) {
        uid = request;
    }

    function confirmDeny() {

        const reason = $('#deny-reason').val();

        if (canProcessDenial()) {

            const params = 'uid=' + uid + '&reason=' + encodeURIComponent(reason);
            $('#btn-deny-confirm').prop('disabled', true);

            $.post('@Url.Action("denyrefundrequest", "accounting")', params, function (data) {

                if (data && data.status == 'ok') {
                    Notifications.showMessage('Success', 'The refund request has been denied', true);
                    setTimeout(function () { location.reload() }, 1000);
                } else {
                    Notifications.showErrors(data.messages);
                }
                
                $('#btn-deny-confirm').prop('disabled', false);

            });
        }
    }

    function canProcessDenial() {
        if ($('#deny-reason').val().trim().length == 0) {
            $('#btn-deny-confirm').prop('disabled', true);
            $('#deny-reason-notes').addClass('text-danger');
            return false;
        }
        
        $('#btn-deny-confirm').prop('disabled', false);
        $('#deny-reason-notes').removeClass('text-danger');
        return true;
    }

</script>