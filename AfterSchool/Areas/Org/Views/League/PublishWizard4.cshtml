@model ActivityGroup
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var aag = (AccountActivityGroup)ViewBag.AccountActivityGroup;
    var period = (RegistrationPeriod)ViewBag.Period;
}

<div>

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityGroupTitle.cshtml", $"Publish {Model.Name} - Step 4 of 4 - League Details "); }
        </div>
        <div class="panel-body">

            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-7">
                    <div role="alert" class="alert alert-success alert-icon">
                        <div class="icon">
                            <span class="s7-check-circle"></span>
                        </div>
                        <div class="message text-medium-small">
                            <p class="text-center">
                                Please review and update the details describing the league activities for parents
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <form id="form1" method="post" action="@Url.Action("publishwizard4", "league", new { id = Model.Uid })" class="form-horizontal">

                <div class="form-group">
                    <label class="col-md-3 control-label">
                        @UILabel.ActivityGroupLabel(Model.ActivityGroupTypeId) Details <span class="text-danger">*</span>
                    </label>
                    <div class="col-md-9">
                        @{ Html.RenderPartial(
                               "~/Views/Shared/_TextEditor.cshtml",
                               aag.Details,
                               new ViewDataDictionary() {
                                   { "required", true },
                                   { "name", "details" },
                                   { "id", "details" }
                               }
                               ); }
                        <p class="text-muted">
                            <em>
                                Describe your @UILabel.ActivityGroupLabel(Model.ActivityGroupTypeId)
                            </em>
                        </p>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div class="btn-group pull-left">
                            <a href="@Url.Action("publishwizard3", "league", new { id = Model.Uid })" class="text-muted">&laquo; Back</a>
                        </div>
                        <div class="btn-group pull-right">
                            <button type="submit" class="btn btn-primary btn-lg">Save &amp; Publish &raquo;</button>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>
