@model ActivityGroup
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var aag = (AccountActivityGroup)ViewBag.AccountActivityGroup;
    var period = (RegistrationPeriod)ViewBag.Period;
}

<div>

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityGroupTitle.cshtml", $"Publish {Model.Name} - Step 2 of 2 - Registration Window "); }
        </div>
        <div class="panel-body">

            <div class="row">
                <div class="col-md-2"></div>
                <div class="col-md-7">
                    <div role="alert" class="alert alert-success alert-icon">
                        <div class="icon">
                            <span class="s7-check-circle"></span>
                        </div>
                        <div class="message text-medium-small">
                            <p class="text-center">
                                Please enter the time period that parents are allowed to register their children
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <form id="form1" method="post" action="@Url.Action("publishwizard2", "league", new { id = Model.Uid })" class="form-horizontal">

                <div class="form-group reg-period">
                    <label class="col-md-3 control-label">Registration Opens <span class="text-danger">*</span></label>
                    <div class="col-md-3">
                        <div data-min-view="2" data-date-format="mm/dd/yyyy" class="input-group date datetimepicker">
                            <input size="16" type="text" class="form-control" id="opendate" name="opendate" onfocus="this.select()" required value="@period.StartDateTime.ToShortDateString()" data-type="date" />
                            <span class="input-group-addon btn btn-primary"><i class="icon-th s7-date"></i></span>
                        </div>
                    </div>
                    <div class="col-md-3">

                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/_TimeSelect.cshtml",
                                period.StartDateTime,
                                new ViewDataDictionary()
                                {
                                    { "name", "opentime" },
                                    { "id", "opentime" },
                                    { "required", true }
                                }
                            );
                        }

                    </div>
                </div>

                <div class="form-group reg-period">
                    <label class="col-md-3 control-label">Registration Closes <span class="text-danger">*</span></label>
                    <div class="col-md-3">
                        <div data-min-view="2" data-date-format="mm/dd/yyyy" class="input-group date datetimepicker">
                            <input size="16" type="text" class="form-control" id="closedate" name="closedate" onfocus="this.select()" required value="@period.EndDateTime.ToShortDateString()" data-type="date" />
                            <span class="input-group-addon btn btn-primary"><i class="icon-th s7-date"></i></span>
                        </div>
                    </div>
                    <div class="col-md-3">

                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/_TimeSelect.cshtml",
                                period.EndDateTime,
                                new ViewDataDictionary()
                                {
                                    { "name", "closetime" },
                                    { "id", "closetime" },
                                    { "required", true }
                                }
                            );
                        }

                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div class="btn-group pull-left">
                            <a href="@Url.Action("publishwizard1", "league", new { id = Model.Uid })" class="text-muted">&laquo; Back</a>
                        </div>
                        <div class="btn-group pull-right">
                            <button type="submit" class="btn btn-primary btn-lg">Save &amp; Publish &raquo;</button>
                        </div>
                    </div>
                </div>

            </form>

        </div>
    </div>
</div>
