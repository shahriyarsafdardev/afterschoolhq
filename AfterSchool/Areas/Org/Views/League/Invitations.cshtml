                        Team Registration Dates
                    </th>
                    <th class="text-center">
                        Accept
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invite in recentlyDeclinedInvites)
                {
                    var period = invite.GetLatestRegistrationPeriod();
