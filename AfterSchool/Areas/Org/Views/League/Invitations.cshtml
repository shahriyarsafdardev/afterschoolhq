<div id="modal-copy" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-copy" action="" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Repeat @UILabel.ActivityGroupLabel(activityGroupType)</h3>
            </div>
            <div class="modal-body form">

                <p>This is used to create an copy of the existing @UILabel.ActivityGroupLabel(activityGroupType).ToLower(). Once copied you can make any modifications as needed.</p>

                <div class="form-group">
                    <label>@UILabel.ActivityGroupLabel(activityGroupType) Name</label>
                    <input type="text" placeholder="Your @UILabel.ActivityGroupLabel(activityGroupType) Name" class="form-control" id="groupnamecopy" name="groupnamecopy" onfocus="this.select()">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Repeat @UILabel.ActivityGroupLabel(activityGroupType) &raquo;</button>
            </div>
        </div>
    </form>
</div>

<div id="modal-archive" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Archive @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to archive <strong><span id="archive-group-name"></span></strong>? </p><p>Archived @UILabel.ActivityGroupLabel(activityGroupType, true).ToLower() are automatically unpublished and all related @UILabel.ActivityLabel(activityGroupType, true).ToLower() are also archived and unpublished.</p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="archive-group-button">Archive &raquo;</a>
        </div>
    </div>
</div>

<div id="modal-restore" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Restore @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to restore <strong><span id="restore-group-name"></span></strong>? </p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="restore-group-button">Restore &raquo;</a>
        </div>
    </div>
</div>

<div id="modal-accept" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Accept @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to accept the invitation to <strong><span id="accept-group-name"></span></strong>? </p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="accept-group-button">Accept &raquo;</a>
        </div>
    </div>
</div>

<div id="modal-decline" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Decline @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to decline the invitation to <strong><span id="decline-group-name"></span></strong>? </p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="decline-group-button">Decline &raquo;</a>
        </div>
    </div>
</div>


<script>
    function setCopyGroup(name, url) {
        $('#groupnamecopy').val(name + ' [copy]');
        $('#form-copy').attr('action', url);
    }
    function archiveGroup(name, url) {
        $('#archive-group-name').html(name);
        $('#archive-group-button').attr('href', url);
    }
    function restoreGroup(name, url) {
        $('#restore-group-name').html(name);
        $('#restore-group-button').attr('href', url);
    }

    function acceptInvitation(name, url) {
        $('#accept-group-name').html(name);
        $('#accept-group-button').attr('href', url);
    }

    function declineInvitation(name, url) {
        $('#decline-group-name').html(name);
        $('#decline-group-button').attr('href', url);
    }
</script>