                            <a href="@Url.Action("summary", controller, new { id = invite.Uid })" class=" hide btn btn-default btn-sm"><i class="icon icon-left s7-date"></i> View</a>
                        </td>
                        <td>@invite.Name</td>
                        <td class="text-center">
                            @if (invite.IsOpenNow())
                            {
                                <span>Teams must be submitted by @period.EndDateTime.ToLongDateTimeString()</span>
                            }
                            else if (invite.WillOpen())
                            {
                                <span>Team registration will open @period.EndDateTime.ToLongDateTimeString()</span>
                            }
                            else
                            {
                                <span>Team registration closed @period.EndDateTime.ToLongDateTimeString()</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-primary md-trigger"
                                        data-modal="modal-accept"
                                        onclick="acceptInvitation('@invite.Name', '@Url.Action("UpdateInvitation", controller, new { id = invite.ID.Value.ToString(), inviteStatus = InviteStatus.Accepted })')">
                                    <i class="s7-copy-file"></i> Accept
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

