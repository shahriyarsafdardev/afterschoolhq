@model List<ActivityGroup>
@{
    var activityGroupType = (ActivityGroupType)ViewBag.ActivityGroupType;
    var paging = (PagingModel)ViewBag.PagingModel;
    var hasArchivedGroups = (bool)ViewBag.HasArchivedGroups;
    var controller = ViewBag.GroupController;

    var pendingInvites = (List<ActivityGroup>)ViewBag.pendingInvites;
    var recentlyDeclinedInvites = (List<ActivityGroup>)ViewBag.recentlyDeclinedInvites;

    var previousLink = "#";
    var nextLink = "#";
    if (paging.IsNotEmpty())
    {
        if (paging.PageNumber > 1)
        {
            previousLink = Url.Action("index", controller, new { pn = paging.PageNumber - 1, rpp = Request["rpp"], archive = Request["archive"] });
        }
        if (paging.PageNumber < paging.TotalPages)
        {
            nextLink = Url.Action("index", controller, new { pn = paging.PageNumber + 1, rpp = Request["rpp"], archive = Request["archive"] });
        }
    }
}
<p>League Invitations</p>
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th></th>
                <th>
                    @(activityGroupType == ActivityGroupType.Session ? "Session" : "League")
                </th>
                <th class="text-center">
                    Team Registration Dates
                </th>
                <th class="text-center">
                    Accept/Decline
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (pendingInvites.Count > 0)
            {
                foreach (var pendingInvite in pendingInvites)
                {
                    var period = pendingInvite.GetLatestRegistrationPeriod();
                    <tr>
                        <td>
                            <a href="@Url.Action("summary", controller, new {id = pendingInvite.Uid})" class=" hide btn btn-default btn-sm"><i class="icon icon-left s7-date"></i> View</a>
                        </td>
                        <td>@pendingInvite.Name</td>
                        <td class="text-center">
                            @if (pendingInvite.IsOpenNow())
                            {
                                <span>Teams must be submitted by @period.EndDateTime.ToLongDateTimeString()</span>
                            }
                            else if (pendingInvite.WillOpen())
                            {
                                <span>Team registration will open @period.EndDateTime.ToLongDateTimeString()</span>
                            }
                            else
                            {
                                <span>Team registration closed @period.EndDateTime.ToLongDateTimeString()</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-primary md-trigger"
                                        data-modal="modal-accept"
                                        onclick="acceptInvitation('@pendingInvite.Name', '@Url.Action("UpdateInvitation", controller, new { id = pendingInvite.ID.Value.ToString(), inviteStatus = InviteStatus.Accepted })')">
                                    <i class="s7-copy-file"></i> Accept
                                </button>
                                <button class="btn btn-danger md-trigger"
                                        data-modal="modal-decline"
                                        onclick="declineInvitation('@pendingInvite.Name', '@Url.Action("UpdateInvitation", controller, new { id = pendingInvite.ID.Value.ToString(), inviteStatus = InviteStatus.Declined })')">
                                    <i class="s7-albums"></i> Decline
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4">
                        You currently have no League invitations.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (recentlyDeclinedInvites.Any())
