@model ActivityGroup
@{
    ViewBag.Title = "Teams";
    var msgs = (SystemMessages)ViewBag.Messages;
    var activities = (List<Activity>)ViewBag.Activities;
    var needToUpgrade = (bool)ViewBag.NeedToUpgrade;
    var hasArchivedActivities = (bool)ViewBag.HasArchivedActivities;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{ Html.RenderPartial("_LeagueHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">

                @if (!needToUpgrade)
                {
                    <a href="@Url.Action("editsetup", "leagueactivity", new { group = Model.Uid })" class="btn btn-primary btn-space margin-r-10">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel(Model.ActivityGroupTypeId)
                    </a>
                }
                else
                {
                    <button class="btn btn-primary md-trigger" data-modal="modal-offering">
                        <i class="icon icon-left s7-plus"></i>
                        Add @UILabel.ActivityLabel(Model.ActivityGroupTypeId)
                    </button>
                    <div id="modal-offering" class="md-modal colored-header custom-width md-effect-9">
                        <form id="form-upgrade" action="" method="post">
                            <div class="md-content">
                                <div class="modal-header">
                                    <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                                    <h3 class="modal-title">Upgrade Your Account</h3>
                                </div>
                                <div class="modal-body form">
                                    <p>You have reached your limit of @UILabel.ActivityLabel(Model.ActivityGroupTypeId, true). Time to upgrade :).</p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                                    <a href="@Url.Action("packages", "account")" class="btn btn-primary">Upgrade &raquo;</a>
                                </div>
                            </div>
                        </form>
                    </div>
                }

            </div>

            @{Html.RenderPartial("_ActivityGroupTitle", Model.Name); }
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">

            @{ Html.RenderPartial(
                        "~/Views/Shared/_LeagueActivities.cshtml",
                        activities,
                        new ViewDataDictionary() {
                                { "Account", SessionVariables.CurrentAccount },
                                { "AccountPackage", SessionVariables.AccountPackage },
                                { "PagingModel", ViewBag.PagingModel },
                                { "ShowRegistrationPeriodFilter", false },
                                { "Group", Model },
                                { "NeedToUpgrade", needToUpgrade },
                                { "HasArchivedActivities", hasArchivedActivities }
                            }
                        ); }
        </div>
    </div>
</div>
