@model ActivityGroup
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var schedules = (List<ActivitySchedule>)ViewBag.Schedules;
    var account = (Account)ViewBag.Account;
    var activities = (List<Activity>)ViewBag.Activities;
    var activitiesPerColumn = 0;

    if (activities.IsNotEmpty())
    {
        activitiesPerColumn = Math.Ceiling(activities.Count / 2.0).ToInteger();
    }
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_LeagueHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{ Html.RenderPartial("_ActivityGroupTitle", string.Format("{0} - Schedules", Model.Name)); }
        </div>
        <div class="panel-body">

            <div class="row">
                <div class="pull-right">
                    <a class="btn btn-primary btn-space margin-r-10" href="@Url.Action("edit", "schedule", new { id = 0, group = Model.Uid })">
                        <i class="icon icon-left s7-plus"></i>
                        Add Schedule
                    </a>
                </div>
            </div>

           <div class="table-responsive">
               <table class="table table-striped">
                   <thead>
                       <tr>
                           <th></th>
                           <th>Name</th>
                           <th>Description</th>
                           <th></th>
                       </tr>
                   </thead>
                   <tbody>
                        @if (schedules.Count > 0)
                        {
                            foreach (var schedule in schedules)
                            {
                                <tr>
                                    <td><a class="btn btn-default btn-sm" href="@Url.Action("edit", "schedule", new { id = schedule.ID, group = Model.Uid })">Edit</a></td>
                                    <td>@schedule.Name</td>
                                    <td>@{ Html.RenderPartial("~/Views/Shared/_ActivityScheduleHtml.cshtml", schedule); }</td>
                                    <td>
                                        @if (activities.Any())
                                        {
                                            <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="modal-activities" onclick="assignActivities(@schedule.ID)">Assign Activities</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">The league schedule has not been created yet.</td>
                            </tr>
                        }
                       
                   </tbody>
               </table>
           </div>

        </div>
    </div>
</div>


<div id="modal-activities" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-add" action="@Url.Action("assignactivities", "group", new { id = Model.Uid })" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title"><i class="s7-edit"></i> Assign @UILabel.ActivityLabel(Model.ActivityGroupTypeId, true) to Schedule</h3>
            </div>
            <div class="modal-body form">
                <div style="height: 300px; overflow-x: hidden; overflow-y: auto;">
                    <div class="form-group">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="loading text-center"><h3>Loading...</h3></div>
                                <div class="checkboxes hide">
                                    @for (int i = 0; i < 2; i++)
                                    {
                                        <div class="col-md-6">
                                            @foreach (var activity in activities.Skip(i * activitiesPerColumn).ToList().Take(activitiesPerColumn))
                                            {
                                                <div class="am-checkbox">
                                                    <input type="checkbox" id="activity-@activity.ID" name="activity-@activity.ID" class="activity-checkbox" value="1" />
                                                    <label for="activity-@activity.ID">@activity.Name</label>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                    <input type="hidden" name="schedule" id="schedule" value="" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="button" data-dismiss="modal" class="btn btn-primary md-close" onclick="saveActivities()">Assign Activities &raquo;</button>
            </div>
        </div>
    </form>
</div>

<script>
    function saveActivities() {

        var params = '';
        $('.activity-checkbox').each(function () {
            if ($(this).is(':checked')) {
                var id = $(this).attr('id').split('-')[1];
                if (params.length > 0) params += '&';
                params += `activity-${id}=1`;
            }
        });

        var scheduleId = $('#schedule').val();

        $.post(
            `@Url.Action("setscheduleactivities", "services")/${scheduleId}`,
            params,
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: 'The schedule has been added to the selected @UILabel.ActivityLabel(Model.ActivityGroupTypeId, true).ToLower()',
                        success: true
                    });
                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: 'The schedule has NOT been added to the selected @UILabel.ActivityLabel(Model.ActivityGroupTypeId, true).ToLower()',
                        success: false
                    });
                }
            }
        );

    }

    function assignActivities(id) {
        $('#schedule').val(id);

        $('.loading').removeClass('hide');
        $('.checkboxes').addClass('hide');
        $('.activity-checkbox').prop('checked', false);

        $.get(
            `@Url.Action("getscheduleactivities", "services")/${id}`,
            function (data) {
                if (data && data.status == 'ok') {
                    for(let activity of data.activities) {
                        $(`#activity-${activity.ID}`).prop('checked', true);
                    }
                    $('.checkboxes').removeClass('hide');
                    $('.loading').addClass('hide');
                }
            }
        );
    }
</script>
