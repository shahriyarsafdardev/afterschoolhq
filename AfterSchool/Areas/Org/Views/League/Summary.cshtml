@model ActivityGroup
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var registrations = (List<Registration>)ViewBag.Registrations;
    var aag = (AccountActivityGroup)ViewBag.AccountActivityGroup;

    decimal totalPaid = 0;
    int registrationCount = registrations.Count();

    if (registrations.Where(x => x.DatePaid.HasValue).Any())
    {
        totalPaid = registrations.Where(x => x.DatePaid.HasValue).Sum(x => x.AmountPaid.Value);
    }

    var dates = registrations.OrderBy(x => x.CreateDate).Select(x => SessionVariables.CurrentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString()).Distinct();
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_LeagueHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityGroupTitle.cshtml", Model.Name); }
        </div>
        <div class="panel-body">

          @if (registrationCount == 0 && !aag.IsPublished)
            {
                <div class="widget">
                    <div class="widget-tile text-medium-small">
                        <p>Welcome @SessionVariables.CurrentUser.FirstName</p>
                        <p>                            
                            <ol>
                                <li><a href="@Url.Action("edit", "league", new { id = Model.Uid })">Setup final details</a> to enable parents to register</li>
                                <li>Create your <a href="@Url.Action("periods", "league", new { id = Model.Uid })">@UILabel.RegistrationPeriodLabel(true).ToLower()</a></li>
                                <li>
                                    <a href="@Url.Action("publishdetail", "league", new { id = Model.Uid })">publish the league</a> to your
                                    <a href="@SessionVariables.CurrentAccount.HomePageUrl" target="_blank">activity home page</a> for @UILabel.RegistrantLabel(true).ToLower() to register.
                                </li>
                            </ol>
                        </p>
                        
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    <div class="col-md-8">
                        <div class="col-md-6">
                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-toggle="counter" data-end="@registrationCount" data-decimals="0" data-suffix="" class="value">@registrationCount</div>
                                    <div class="desc">@UILabel.RegistrantLabel(true) Registered</div>
                                </div>
                                <div class="icon"><span class="s7-users"></span></div>
                            </div>
                        </div>
                        <div class="col-md-6">

                            <div class="widget widget-tile widget-bordered">
                                <div class="data-info">
                                    <div data-end="@totalPaid" data-decimals="2" data-suffix="" class="value">@totalPaid.ToCurrency()</div>
                                    <div class="desc">Total Paid</div>
                                </div>
                                <div class="icon"><span class="s7-cash"></span></div>
                            </div>
                        </div>

                        @if (registrationCount > 0)
                        {
                            <div class="col-md-12">

                                <div class="panel panel-default">
                                    <div class="panel-heading">
                                        Registrations By Date
                                    </div>
                                    <div class="panel-body">
                                        <div id="registrantsbydate" style="height: 350px;"></div>
                                    </div>
                                </div>

                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        new Morris.Bar({
            // ID of the element in which to draw the chart.
            element: 'registrantsbydate',
            // Chart data records -- each entry in this array corresponds to a point on
            // the chart.
            data: [
                @foreach(var date in dates){
                    @:{ date: '@date', value: @registrations.Where(x => SessionVariables.CurrentAccount.ConvertToAccountTimeZone(x.CreateDate.Value).ToShortDateString() == date).Count() },
                }
            ],
            // The name of the data record attribute that contains x-values.
            xkey: 'date',
            // A list of names of data record attributes that contain y-values.
            ykeys: ['value'],
            // Labels for the ykeys -- will be displayed when you hover over the
            // chart.
            labels: ['Registrations'],
            resize: true,
            barColors: ['#3d3c3c']
        });
    });



</script>
