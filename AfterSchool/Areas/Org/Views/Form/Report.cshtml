@model AfterSchool.Areas.Org.Controllers.FormController.ReportResults
@{
    ViewBag.Title = Model.Form.Name;
    var questions = Model.Questions;
    var msgs = Model.Messages;
    Layout = "~/Views/Shared/Layouts/_PrintScreen.cshtml";
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-body">

            <div class="row">
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel
                            {
                                Id = "startdate",
                                Name = "startdate",
                                Value = Request["sdate"],
                                Placeholder = "From Date",
                            }
                            );
                    }
                </div>
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel
                            {
                                Id = "enddate",
                                Name = "enddate",
                                Value = Request["edate"],
                                Placeholder = "To Date",
                            }
                            );
                    }
                </div>
                <div class="col-md-2">
                    <input type="text" id="search" placeholder="Search" class="form-control" />
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-primary" onclick="search()">Search</button>
                    <button type="button" class="btn btn-primary" onclick="emailReport()">Email CSV Report</button>
                    <button type="button" class="btn btn-default hidden-print" onclick="window.close()">
                        <i class="s7-close-circle"></i> Close
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    &nbsp;
                </div>
            </div>
            <div class="row">
                <div class="col-md-12 ">
                    <span id="starting-record"></span> -
                    <span id="total-records-loaded"></span> of
                    <span id="total-records"></span> Submissions
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    &nbsp;
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="table-responsive ">
                        <table class="table table-bordered table-condensed" id="answers-table">
                            <thead>
                                <tr>
                                    <th>Submission ID</th>
                                    <th>Submission Date</th>
                                    @foreach (var question in questions)
                                    {
                                        <th>@question.FormQuestionGroupName - @question.Text</th>
                                    }

                                </tr>
                            </thead>
                            <tbody id="answer-tbody">
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>

    var questions = @Html.Raw(questions.Select(x => new { x.ID, x.FormQuestionGroupName, x.Text }).ToJSON());
    var pageStart = 0;
    let pageSize = 25;

    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $(window).on('scroll', function () {

            if ((window.innerHeight + window.scrollY) >= $(document).height() - 10) {
                loadRegistrants(pageStart, pageSize);
            } else {
                // console.log('end not reached');
            }
        });

        loadRegistrants(pageStart, pageSize);

    });

    function resetScreen() {
        pageStart = 0;
        $('#answer-tbody').html('');
    }

    function search() {
        resetScreen();
        loadRegistrants(pageStart, pageSize);
    }

    function emailReport() {

        let search = encodeURIComponent($('#search').val());
        let sdate = encodeURIComponent($('#startdate').val());
        let edate = encodeURIComponent($('#enddate').val());

        $.get(
            `@Url.Action("DownloadReport", "Form", new { id = Model.Form.ID.Value})?search=${search}&sdate=${sdate}&edate=${edate}`,
            function (data) {
                if (data && data.status === 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: 'Your report will be emailed shortly',
                        success: true
                    });
                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }

    function loadRegistrants(start, length) {

        let search = encodeURIComponent($('#search').val());
        let sdate = encodeURIComponent($('#startdate').val());
        let edate = encodeURIComponent($('#enddate').val());

        $.get(
            `@Url.Action("GetReportPage", "Form", new { id = Model.Form.ID.Value})?start=${start}&length=${length}&search=${search}&sdate=${sdate}&edate=${edate}`,
            function (data) {
                if (data && data.status === 'ok') {

                    for (let registrant of data.registrants) {

                        var tableRow = `<tr>`;

                        tableRow += `<td>${registrant.ID}</td>`;
                        tableRow += `<td>${registrant.CreateDate}</td>`;

                        for (let question of questions) {

                            answer = getAnswerForQuestion(question.ID, registrant, data.answers);

                            tableRow += `<td>`;
                            if (answer) {
                                tableRow += answer.Text;
                            }
                            tableRow += `</td>`;
                        }

                        tableRow += `</tr>`;
                        $('#answer-tbody').append(tableRow);
                    }

                    pageStart += pageSize;

                    $('#starting-record').html(1);
                    $('#total-records-loaded').html(pageStart);
                    $('#total-records').html(data.registrantCount);

                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }

    function getAnswerForQuestion(questionId, registrant, answers) {

        for (let answer of answers) {
            if (answer.QuestionId == questionId && answer.RegistrantId == registrant.ID)
                return answer;
        }

        return null;
    }

</script>
