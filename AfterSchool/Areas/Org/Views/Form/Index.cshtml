@model List<AfterSchoolLibrary.Form>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("OrgAccountHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <div class="pull-right">
                <button class="btn btn-primary btn-space md-trigger" data-modal="modal-newform">
                    <i class="icon icon-left s7-plus"></i>
                    Add Form
                </button>
            </div>
            <i class="s7-note2"></i> Forms
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">            

            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th></th>
                            <th>Form</th>
                            <th>Created On</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var form in Model)
                            {
                                <tr>
                                    <td><a href="@Url.Action("edit", "form", new {id = form.ID})" class="btn btn-default btn-sm"><i class="icon icon-left s7-edit"></i> Edit</a></td>
                                    <td><a href="@Url.Action("edit", "form", new {id = form.ID})">@form.Name</a></td>
                                    <td>@form.CreateDate.Value.ToLongDateString()</td>
                                    <td>
                                        <button class="btn btn-default btn-sm md-trigger" data-modal="modal-newform" onclick="copy(@form.ID, '@form.Name')">
                                            <i class="icon icon-left s7-copy-file"></i> Copy
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4">There are no forms. Please <a href="#" class="md-trigger" data-modal="modal-newform">add a new registration form</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>


<div id="modal-newform" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-new" action="@Url.Action("edit", "form", new { id = 0 })" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">New Registration Form</h3>
            </div>
            <div class="modal-body form">

                <p>This is used to create a registration form that can be used for your @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()</p>

                <div class="form-group">
                    <label>Registration Form Name</label>
                    <input type="text" placeholder="" class="form-control" id="name" name="name" onfocus="this.select()">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Create Form</button>
            </div>
        </div>
    </form>
</div>

<script>
    function copy(id, name) {
        $('.modal-title').html('Copy Registration Form');
        $('#form-new').attr('action', '/org/form/edit/0?copyfrom=' + id);
        $('#name').val(name + ' Copy');
        $('#name').focus();
    }
</script>
