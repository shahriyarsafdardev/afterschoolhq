@model List<Transaction>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
}

@{ Html.RenderPartial("_UserAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("_BillingHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-credit"></i> Transactions
        </div>
        <div class="panel-body">

            <p>Records start as of 12/1/2019</p>

            <div class="row">
                <div class="col-md-3">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "startdate",
                                Name = "startdate",
                                Value = Request["sdate"],
                                Placeholder = "From Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-3">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "enddate",
                                Name = "enddate",
                                Value = Request["edate"],
                                Placeholder = "To Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-primary btn-lg" onclick="search()">Search</button>
                    <button type="button" class="hide btn btn-primary btn-lg" onclick="DownloadToCSV()">Export To CSV</button>
                </div>

                <script>
                    function search() {
                        window.location.href = `@Url.Action("transactions", "billing")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}`;
                    }
                    function DownloadToCSV() {
                            window.location.href = `@Url.Action("transactions", "billing")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}`;
                    }

                </script>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Created On</th>
                            <th>For</th>
                            <th>Paid to</th>
                            <th>Item Description</th>
                            <th>Type</th>
                            <th class="text-center">Amount</th>
                            <th class="text-center">Payment Method</th>
                            <th class="text-center">Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var transaction in Model)
                            {
                                var registrant = transaction.GetPurchase()?.GetRegistrant();
                                var billerAccount = transaction.GetBillerAccount();

                                <tr id="@transaction.Uid">
                                    <td>
                                        @transaction.GetTransactionNumber()
                                    </td>
                                    <td>
                                        @transaction.CreateDate.ToShortDateTimeString()
                                    </td>
                                    <td>
                                        @if (transaction.IsCharge())
                                        {
                                            if (registrant.IsNotEmpty())
                                            {
                                                @(!isTechSupport ? registrant.Name : registrant.GetFirstNameLastInitial())
                                            }
                                            else
                                            {
                                                @:-
                                            }
                                        }
                                        else
                                        {
                                            @billerAccount.Name
                                        }
                                    </td>
                                    <td>
                                        @billerAccount.Name
                                    </td>
                                    <td>
                                        @transaction.Description
                                    </td>
                                    <td>
                                        @transaction.TransactionTypeId.ToString()
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetPayerAmount().ToCurrency()

                                        @if (transaction.IsRefund())
                                        {
                                            <i class="s7-back-2"></i>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @transaction.PaymentTypeId.ToString().SplitByUpperCase()
                                    </td>
                                    <td class="text-center">
                                        @if (transaction.IsCharge())
                                        {
                                            if (transaction.HasRefunds())
                                            {
                                                @:Refunded
                                            }
                                            else
                                            {
                                                @:Paid
                                            }

                                        }
                                        else if (transaction.IsRefund())
                                        {
                                            @:-
                                        }
                                    </td>
                                    <td>
                                        @if (transaction.IsCharge() && !transaction.IsTotallyRefunded(false) && transaction.CanParentRequestRefund())
                                        {
                                            var hasUnfulfilledRequest = transaction.HasUnfulfilledRefundRequests();

                                            <button onclick="requestRefund('@transaction.Uid', @transaction.GetParentRefundableAmount().ToString("0.00"))"
                                                    class="md-trigger btn btn-default btn-sm"
                                                    data-modal="modal-request-refund"
                                                    @(hasUnfulfilledRequest ? "disabled=\"disabled\"" : "")>

                                                @if (hasUnfulfilledRequest)
                                                {
                                                    @:Refund Requested
                                                }
                                                else
                                                {
                                                    @:Request Refund
                                                }

                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">There are no transactions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                Html.RenderPartial(
                    "~/Views/Shared/_Paging.cshtml",
                    (PagingModel)ViewBag.PagingModel,
                    new ViewDataDictionary()
                    {
                    { "controller", "billing" },
                    { "action", "transactions" },
                    { "querystring", $"sdate={Request["sdate"]}&edate={Request["edate"]}&poId={Request["poId"]}&poTypeId={Request["poTypeId"]}" }
        }
                );
            }
        </div>
    </div>
</div>

<div id="modal-request-refund" class="md-modal colored-header custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Request Refund</h3>
        </div>
        <div class="modal-body form">
            <div class="form-group">
                <input type="number" id="refund-request-amount" class="form-control" placeholder="Refund Amount" required="required" max="" min="1" step=".01" />
                <p class="text-muted text-small" id="refund-request-notes">Please enter an amount between $1 and $<span class="refund-request-max-amount"></span>. Credit card transaction fees are non-refundable. <a href="~/parent-faq.html" target="_blank">Click here for more info about our billing policies</a></p>
            </div>
            <div class="form-group">
                <label for="request-reason">Reason</label>
                <input type="text" id="refund-reason" maxlength="100" class="form-control" oninput="enableRequestRefundButton()" />
                <p class="text-muted text-small" id="refund-request-reason-notes">Please enter a reason</p>
            </div>
            <input type="hidden" id="refund-request-transaction-uid" value="" />
            <input type="hidden" id="refund-request-max-amount" value="" />
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" id="btn-request-refund" onclick="processRefundRequest()" class="btn btn-primary md-close">Request Refund &raquo;</button>
        </div>
    </div>
</div>

<script>
    
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#refund-request-amount').blur(function () {
            canProcessRequest();
        });
        $('#refund-reason').blur(function () {
            canProcessRequest();
        });
    });

    function requestRefund(uid, maxAmount) {
        $('#refund-request-transaction-uid').val(uid);
        $('#refund-request-max-amount').val(maxAmount.toFixed(2));
        $('.refund-request-max-amount').html(maxAmount.toFixed(2));
        $('#refund-request-amount').attr('max', maxAmount.toFixed(2));
        $('#refund-request-amount').val(maxAmount.toFixed(2));
        $('#refund-reason').val('');

        canProcessRequest();
    }

    function canProcessRequest() {
        const amount = $('#refund-request-amount').val();
        const maxAmount = $('#refund-request-max-amount').val();

        if (parseFloat(amount) > parseFloat(maxAmount) || parseFloat(amount) < 1) {
            $('#btn-request-refund').prop('disabled', true);
            $('#refund-request-notes').addClass('text-danger');
            return false;
        }

        if ($('#refund-reason').val().trim().length == 0) {
            $('#btn-request-refund').prop('disabled', true);
            $('#refund-request-reason-notes').addClass('text-danger');
            return false;
        }

        $('#btn-request-refund').prop('disabled', false);
        $('#refund-request-notes').removeClass('text-danger');
        $('#refund-request-reason-notes').removeClass('text-danger');
        return true;
    }

    function enableRequestRefundButton() {
        $('#btn-request-refund').prop('disabled', false);
        $('#refund-request-reason-notes').removeClass('text-danger');
    }

    function processRefundRequest() {

        const uid = $('#refund-request-transaction-uid').val();
        const amount = $('#refund-request-amount').val();
        const reason = $('#refund-reason').val();

        if (canProcessRequest()) {
            $.post(
                '@Url.Action("requestrefund", "billing")',
                'uid=' + uid + '&amount=' + amount + '&reason=' + encodeURIComponent(reason),
                function (data) {
                    if (data && data.status == 'ok') {
                        Notifications.showMessage('Success', 'Your refund request for <strong>$' + amount + '</strong> has been submitted for review.', true);
                        setTimeout(function () { location.reload() }, 500);
                    } else {
                        Notifications.showErrors(data.messages);
                    }
                }
            );
        }

    }
</script>