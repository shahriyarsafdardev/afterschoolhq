@model List<RegistrantSubscriptionPlan>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{ Html.RenderPartial("_UserAccountHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("_BillingHeader"); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-info"></i> Plans
        </div>
        <div class="panel-body">

            <p>Records start as of 12/1/2019</p>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>@UILabel.ActivityLabel(ActivityType.Activity)</th>
                            <th class="text-center">@UILabel.RegistrantLabel()</th>
                            <th class="text-center">Plan Start Date</th>
                            <th class="text-center">Date Cancelled</th>
                            <th class="text-center">Payment</th>
                            <th class="text-center">Payments</th>
                            <th class="text-center">Next Payment Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var plan in Model)
                            {
                                var originalPlan = plan.GetSubscriptionPlan();
                                var participationObject = originalPlan.GetParticipationObject();
                                var registrant = plan.GetRegistrant();
                                var masterRegistrant = registrant.GetMasterRegistrant();
                                var regStatus = RegistrationStatus.Current;

                                if (originalPlan.PlanTypeId == SubscriptionPlanType.Subscription || originalPlan.PlanTypeId == SubscriptionPlanType.PaymentPlan)
                                {
                                    if (plan.StartDate.Value.IsAfter(DateTime.UtcNow))
                                    {
                                        regStatus = RegistrationStatus.Future;
                                    }
                                    else if (plan.ValidUntil.HasValue && plan.ValidUntil.Value.IsBefore(DateTime.UtcNow))
                                    {
                                        regStatus = RegistrationStatus.Past;
                                    }
                                } 
                                else
                                {
                                    if (participationObject.StartDate.Value.IsAfter(DateTime.UtcNow))
                                    {
                                        regStatus = RegistrationStatus.Future;
                                    }
                                    else if (participationObject.EndDate.HasValue && participationObject.EndDate.Value.IsBefore(DateTime.UtcNow))
                                    {
                                        regStatus = RegistrationStatus.Past;
                                    }
                                }

                                var registrantActivity = registrant.GetRegistrantActivity(participationObject, msgs);
                                var participationVM = new ParticipationViewModel(participationObject, registrantActivity, registrant, regStatus);

                                var billingPeriodTypeId = plan.BillingPeriodTypeId;
                                var payments = plan.GetPayments();
                                var nextPaymentDate = "-";
                                var amount = plan.TotalPaidWithFees;
                                var endDate = "-";

                                if (billingPeriodTypeId == BillingPeriodType.NotSet)
                                {
                                    billingPeriodTypeId = originalPlan.BillingPeriodTypeId;
                                }

                                if (!plan.DateCancelled.HasValue)
                                {
                                    if (payments.Any() && payments.Last().CreateDate.Value.AddMonths(1).IsOnOrAfter(DateTime.UtcNow))
                                    {
                                        nextPaymentDate = payments.Last().CreateDate.Value.AddMonths(1).ToShortDateString();
                                    }
                                    else if (plan.StartDate.Value.IsAfter(DateTime.UtcNow))
                                    {
                                        nextPaymentDate = plan.StartDate.Value.ToShortDateString();
                                    }
                                }

                                if (amount == 0)
                                {
                                    if (payments.Any())
                                    {
                                        amount = payments.Last().GetTransaction().Amount.Value;
                                    }
                                    else
                                    {
                                        amount = originalPlan.CostPerPeriod.Value;
                                    }
                                }

                                if (originalPlan.PlanTypeId == SubscriptionPlanType.PaymentPlan)
                                {
                                    if (payments.Count == plan.TotalPeriods)
                                    {
                                        endDate = plan.GetLastPaymentDate().ToShortDateString();
                                    }
                                }
                                else
                                {
                                    endDate = plan.DateCancelled.ToShortDateString("-");
                                }

                                <tr>
                                    <td>
                                        @participationObject.Name - @originalPlan.PlanTypeId.ToString().SplitByUpperCase()
                                    </td>
                                    <td class="text-center">
                                        @registrant.DisplayName
                                    </td>
                                    <td class="text-center">
                                        @plan.StartDate.ToShortDateString()
                                    </td>
                                    <td class="text-center">
                                        @endDate
                                    </td>
                                    <td class="text-center">
                                        @plan.TotalPaidWithFees.ToCurrency() / @billingPeriodTypeId.ToString().ToLower()
                                    </td>
                                    <td class="text-center">
                                        @if (plan.TotalPeriods.HasValue)
                                        {
                                            <span>
                                                @payments.Count of @plan.TotalPeriods.Value
                                            </span>
                                        }
                                        else
                                        {
                                            <span>@payments.Count payment(s)</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @nextPaymentDate
                                    </td>
                                    <td>
                                        @if (regStatus != RegistrationStatus.Past)
                                        {
                                            if (!plan.DateCancelled.HasValue)
                                            {
                                                Html.RenderPartial("Activities/_WithdrawLink",
                                                    participationVM,
                                                    new ViewDataDictionary() { { "ReturnUrl", Url.Action("plans", "billing") } });
                                            }
                                            else if (registrantActivity.AssignmentTypeId == RegistrationAssignmentType.Withdrawn && registrantActivity.AssignmentTypeId.NotIn(Registration.ReservedStatuses))
                                            {
                                                <a href="@participationObject.GetRegistrationPageUrl()?reg=@masterRegistrant.Uid" class="btn btn-link">Re-Enroll &raquo;</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">There are no plans</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                Html.RenderPartial(
                    "~/Views/Shared/_Paging.cshtml",
                    (PagingModel)ViewBag.PagingModel,
                    new ViewDataDictionary()
                    {
                    { "controller", "billing" },
                    { "action", "plans" },
                    { "querystring", $"sdate={Request["sdate"]}&edate={Request["edate"]}&poId={Request["poId"]}&poTypeId={Request["poTypeId"]}" }
            }
                );
            }
        </div>
    </div>
</div>

@{ Html.RenderPartial("Modals/_Withdraw"); }