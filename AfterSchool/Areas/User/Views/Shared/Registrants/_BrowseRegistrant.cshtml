@model Registrant

@{ 
    var grade = Model.GetAnswer(QuestionDataType.RegistrantGrade)?.Text;
}

<div class="col-sm-12 col-md-6 col-lg-4">
    <div class="panel" style="overflow: hidden;">
        <div class="heading panel-h3" style="background-color: #2f3c40; height: 80px;">
            <h3 style="vertical-align: middle; display: table-cell; width: 100%; height: 80px; padding-right: 20px;" class="text-white">
                <strong title="@Model.Name">@Model.Name @(grade.IsNotEmpty() ? $"({grade})" : "")</strong>
            </h3>
        </div>
        <div class="panel-body">

            <div class="margin-t-20">
                <a href="@Url.Action((Model.IsParentOrGuardian ? "editpersonal" : "editstudentpersonal"), "family", new { id = Model.Uid })" class="btn btn-primary btn-register btn-block">
                    Update Profile &raquo;
                </a>
            </div>

        </div>
        <div class="panel-footer">
            <p class="text-center">
                @(Model.IsParentOrGuardian ? "Parent / Guardian" : "Student") Account
            </p>
        </div>
    </div>
</div>
