@model List<ParticipationViewModel>

@{
    var status = Enum.GetValues(typeof(RegistrationStatus)).Cast<RegistrationStatus>().OrderBy(x => x.ToString()).ToList();

    if (ViewData["Status"].IsNotEmpty() && ViewData["Status"].IsNumber())
    {
        status = ((RegistrationStatus) ViewData["Status"].ToString().ToInteger()).AsList();
    }
}

@if (Model.Any(participation => participation.RegistrationStatus.In(status)))
{
    <h4 class="text-center">@status.Select(x => x.ToString()).ToStringList() @UILabel.ActivityLabel(ActivityType.Activity, true)</h4>

    foreach (var participation in Model.Where(participation => participation.RegistrationStatus.In(status)))
    {
        Html.RenderPartial(
            "Activities/_BrowseActivity",
            participation
            );
    }
    <hr class="hr-line" style="border-color: #ddd;"/>
}