@model Account

@{
    var isVolunteer = SessionVariables.CurrentAccount.AccountTypeId == AccountType.Volunteer;

    var participationObjectCount = isVolunteer
        ? Model.GetPublishedOpportunitiesParticipationObjectCount()
        : Model.GetPublishedActivitiesParticipationObjectCount();

    var activityLabel = UILabel.ActivityLabel(isVolunteer ? ActivityType.VolunteerOpportunity : ActivityType.Activity, participationObjectCount != 1);
}

<div class="panel" style="overflow: hidden;">
    <div class="heading panel-h3" style="background-color: #2f3c40; height: 80px;">
        <h3 style="vertical-align: middle; display: table-cell; width: 100%; height: 80px; padding-right: 20px;" class="text-white">
            <strong title="@Model.Name" class="notranslate">@Model.Name</strong>
            <span class="badge badge-danger" style="font-size: 0.7em;">@participationObjectCount @activityLabel</span>
        </h3>
    </div>
    <div class="panel-body">

        <div class="margin-t-20">
            <a href="@Model.HomePageUrl" class="btn btn-register-primary btn-block">
                Browse @activityLabel &raquo;
            </a>
        </div>

        <div class="seats-remaining text-center">
            <strong>
                <em>
                    @if (participationObjectCount > 0)
                    {
                        <span>Now Registering</span>
                    }
                </em>
            </strong>
        </div>

    </div>
</div>