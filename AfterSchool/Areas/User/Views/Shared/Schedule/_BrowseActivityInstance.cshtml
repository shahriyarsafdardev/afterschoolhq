@model (ActivityInstance ActivityInstance, Registrant Registrant, int? ID, ParticipationObjectType Type)

@{ 
    var participationObject = new ParticipationObject(Model.ID.Value, Model.Type);
    var account = participationObject.OwnerAccount;
    var registrant = Model.Registrant;
    var activityInstance = Model.ActivityInstance;
    var canRegisterPerClass = participationObject.CanRegisterPerClass;
    var cartItems = CartItem.LoadByParticipationObjectId(participationObject.ObjectID.Value);
    var selectedDates = cartItems.SelectedDates.Split(',').Select(x => x.ToDateTime()).ToList();
}

<div class="">
    <div class="panel" style="overflow: hidden;">
        <div class="heading panel-h3" style="background-color: #2f3c40; height: 80px;">
            <h3 style="vertical-align: middle; display: table-cell; width: 100%; height: 80px; padding-right: 20px;" class="text-white">
                <strong>
                    @activityInstance.StartDateTime.Value.DayOfWeek.ToString().MaxChars(3),
                    @activityInstance.StartDateTime.Value.MonthAsString().MaxChars(3)
                    @activityInstance.StartDateTime.Value.Day
                    at
                    @activityInstance.StartDateTime.Value.ToShortTimeString()
                    for
                    @(registrant.FirstName + " " + registrant.LastName)
                </strong>
            </h3>
        </div>
        <div class="panel-body">
            <div class="margin-t-20">
                <p class="text-medium">
                    <span>
                        @account.Name -
                        @participationObject.Name
                    </span>
                </p>
            </div>

            @if (participationObject.Location.IsNotEmpty())
            {
                var location = participationObject.Location;

                <div>
                    <p class="reg-info">
                        <a href="@location.GetGoogleMapsLink()" target="_blank">@location.FormatAddressWithoutName()</a>
                    </p>
                </div>

                <div style="position: relative; margin-left: -20px; margin-right: -20px">
                    <img src="@LocationService.GetGoogleMapsImageUrl(location, 650, 150)" style="width: 100%;" />
                </div>
            }

        </div>
        <div class="panel-footer">
            @{ Html.RenderPartial("/Areas/User/Views/Shared/Providers/_ProviderContactInfo.cshtml", participationObject); }
        </div>
    </div>
</div>
