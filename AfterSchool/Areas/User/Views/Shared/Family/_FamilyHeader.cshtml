@{
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
}

<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        <a class="btn btn-alt6@(actionName == "editpersonal" ? "-active" : "")" href="@Url.Action("editpersonal", "family")">
            Personal
        </a>
        <a class="btn btn-alt6@(actionName == "edithealth" ? "-active" : "")" href="@Url.Action("edithealth", "family")">
            Health
        </a>
    </div>
    <div class="hidden-lg hidden-sm hidden-md">
        <select class="form-control" onchange="handleNav(this.value)">
            <optgroup label="Navigation">
                <option value="@Url.Action("editpersonal", "family")">Personal</option>
                <option value="@Url.Action("edithealth", "family")">Health</option>
            </optgroup>
        </select>
    </div>
</div>

<script>
    function handleNav(value) {
        location.href = value;
    }
</script>