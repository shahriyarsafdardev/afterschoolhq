@model List<Registrant>

@{
    var activitiesRequiringAttention = (List<RegistrantActivity>)ViewBag.ActivitiesRequiringAttention;
}

<div class="panel" style="overflow: hidden;">
    <div class="heading panel-h3" style="background-color: #2f3c40; height: 80px;">
        <h3 style="vertical-align: middle; display: table-cell; width: 100%; height: 80px; padding-right: 20px;" class="text-white">
            <strong title="To Dos">To Dos</strong>
        </h3>
    </div>
    <div class="panel-body">

        @if (Model.Any(registrant => registrant.ProfileStatusId != RegistrantProfileStatus.Completed))
        {
            <div class="text-medium padding-10">
                <strong>Finalize Profiles</strong>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>Profile</th>
                        <th></th>
                    </tr>
                    @foreach (var registrant in Model.Where(registrant => registrant.ProfileStatusId != RegistrantProfileStatus.Completed))
                    {
                        <tr>
                            <td>
                                @registrant.Name
                            </td>
                            <td class="text-right">
                                <a href="@Url.Action((registrant.IsParentOrGuardian ? "editpersonal" : "editstudentpersonal"), "family", new { id = registrant.Uid })" class="btn btn-primary">
                                    @(registrant.ProfileStatusId == RegistrantProfileStatus.OutOfDate ? "Update" : "Complete")
                                    Profile &raquo;
                                </a>
                            </td>
                        </tr>
                    }
                </thead>
            </table>
        }

        @if (activitiesRequiringAttention.Any())
        {
            <div class="text-medium margin-t-20">
                <strong>Finalize Registrations</strong>
            </div>

            <table class="table">
                <thead>
                    <tr>
                        <th>Activity</th>
                        <th class="text-center">For</th>
                        <th class="text-center">Registered On</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ra in activitiesRequiringAttention)
                    {
                        var participationObject = ra.GetParticipationObject();
                        var registration = ra.GetRegistration();

                        <tr>
                            <td>@participationObject.Name</td>
                            <td class="text-center">@ra.RegistrantFirstName</td>
                            <td class="text-center">@registration.LastModifiedDate.ToShortDateString()</td>
                            <td class="text-right">
                                <a href="@registration.GetParentalConsentUrl" class="btn btn-primary">
                                    @if (ra.AssignmentTypeId == RegistrationAssignmentType.ReservedPendingParentalConsent)
                                    {
                                        <span>Give Consent @(participationObject.IsNotFreeAndCanAcceptPayments ? "& Pay" : "")</span>
                                    }
                                    else if (ra.AssignmentTypeId == RegistrationAssignmentType.ReservedPendingPayment && participationObject.IsNotFreeAndCanAcceptPayments)
                                    {
                                        <span>Pay Online</span>
                                    }
                                    &raquo;
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
