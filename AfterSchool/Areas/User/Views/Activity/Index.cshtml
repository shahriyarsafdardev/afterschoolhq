@model List<RegistrantActivityViewModel>
@{
    var isTechSupport = SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
}

@{ Html.RenderPartial("_UserAccountHeader"); }

<div class="main-content">

    @foreach (var item in Model)
    {
        <div class="row">

            <h3 class="margin-h-30">@(!isTechSupport ? item.Registrant.Name : item.Registrant.GetFirstNameLastInitial())</h3>

            @foreach (var regStatus in Enum.GetValues(typeof(RegistrationStatus)).Cast<RegistrationStatus>().Except(RegistrationStatus.NotSet.AsList()).OrderBy(x => x.ToString()))
            {
                <div class="row">
                    @{
                        Html.RenderPartial(
                            "Activities/_BrowseGroupedActivities",
                            item.Participations,
                            new ViewDataDictionary
                            {
                                {"Status", (int) regStatus},
                            }
                            );
                    }
                </div>
            }
        </div>
    }
</div>

@{ Html.RenderPartial("Modals/_Withdraw"); }

@section header
{
    <link href="~/Assets/css/style-registration.css?v=1.01" type="text/css" rel="stylesheet"/>
}