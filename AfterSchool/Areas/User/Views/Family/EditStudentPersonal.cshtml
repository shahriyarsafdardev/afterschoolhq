@model Registrant
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;
    var school = (Location)ViewBag.School;
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
    var regName = !isTechSupport ? Model.Name : Model.GetFirstNameLastInitial();
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-user"></i> @regName - Personal Info

            <div class="pull-right">
                <a href="@Url.Action("index", (Request["reg"].IsGuid() ? "home" : "family"))" class="btn btn-default">
                    Exit
                </a>
            </div>
        </div>

        <div class="panel-body">

            @if (Request["reg"].IsGuid() || Request["student"].IsGuid())
            {
                <div role="alert" class="alert alert-danger alert-icon">
                    <div class="icon">
                        <span class="s7-info"></span>
                    </div>
                    <div class="message">
                        <p class="text-center text-medium">
                            You must update/complete your profile in order to continue registration
                        </p>
                    </div>
                </div>
            }

            <form class="form-horizontal" 
                  id="form-save-personal" 
                  method="post" 
                  action="@Url.Action("editstudentpersonal", "family", new { id = Model.Uid, reg = Request["reg"], student = Request["student"] })">

                @foreach (var qvm in qvms)
                {
                    Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                }

                <div class="form-group">
                    <div class="col-md-3 control-label">
                        School
                    </div>
                    <div class="col-md-6">
                        @{ Html.RenderPartial(
                                 "~/Views/Shared/Components/_GoogleLocationEdit.cshtml",
                                 school ?? new Location() { },
                                 new ViewDataDictionary() { { "types", "establishment" }, { "description", "Enter your school name" } });
                        }                        
                        <div class="am-checkbox">
                            <input type="checkbox" id="schoolnotfound" name="schoolnotfound" value="true"/>
                            <label for="schoolnotfound">
                                I can’t find my child’s school or my child is homeschooled
                            </label>
                        </div>
                    </div>
                </div>

                <div class="margin-v-20">
                    <div class="col-md-offset-3 col-md-6">
                        <button type="submit" id="btn-save-personal" class="btn btn-primary btn-block btn-lg">Save and Continue &raquo;</button>
                    </div>
                </div>

            </form>
        </div>

    </div>
</div>


<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#form-save-personal').submit(function () {
            $('#btn-save-personal').html('Saving...');
            $('#btn-save-personal').prop('disabled', true);
        });

        if (@Json.Encode(school.IsEmpty())) 
            $('#schoolnotfound').prop('checked', true);        

        $('#schoolnotfound').click(function () {
            if ($(this).prop("checked") == true) {
                $('#location').val('');
                $('#placeid').val('');
            }
        });
    });
</script>
