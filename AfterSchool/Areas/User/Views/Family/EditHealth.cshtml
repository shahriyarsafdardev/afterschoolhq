@model Registrant
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
    var regName = !isTechSupport ? Model.Name : Model.GetFirstNameLastInitial();
}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-user"></i> @regName - Health Info

            <div class="pull-right">
                <a href="@Url.Action("index", (Request["reg"].IsGuid() ? "home" : "family"))" class="btn btn-default">
                    Exit
                </a>
            </div>
        </div>

        <div class="panel-body">
            <form class="form-horizontal" id="form-save-health" method="post" action="@Url.Action("edithealth", "family", new { id = Model.Uid, reg = Request["reg"], student = Request["student"], returnUrl = Request["returnurl"] })">

                @foreach (var qvm in qvms)
                {
                    Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                }

                <div class="margin-v-20">
                    <div class="col-md-offset-3 col-md-6">
                        <button type="submit" id="btn-save-health" class="btn btn-primary btn-block btn-lg">Save and Complete &raquo;</button>
                    </div>
                </div>

            </form>
        </div>

    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#form-save-health').submit(function () {
            $('#btn-save-health').html('Saving...');
            $('#btn-save-health').prop('disabled', true);
        });
    });
</script>
