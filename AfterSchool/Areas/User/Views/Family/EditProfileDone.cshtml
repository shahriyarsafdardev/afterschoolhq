@model Registrant
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";

}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-user"></i> @Model.Name - Done

            <div class="pull-right">
                <a href="@Url.Action("index", (Request["reg"].IsGuid() ? "home" : "family"))" class="btn btn-default">
                    Exit
                </a>
            </div>
        </div>

        <div class="panel-body">
            <p class="text-center">
                <i class="s7-check-circle text-success icon-xxlarge"></i>
            </p>
            <p class="text-center text-medium">
                @Model.FirstName's profile has been completed
            </p>
            <p class="text-center margin-v-30">
                <a href="@Url.Action("index", "family")" class="btn btn-primary btn-lg">
                    Exit Profile
                </a>
            </p>
        </div>

    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#form-save-health').submit(function () {
            $('#btn-save-health').html('Saving...');
            $('#btn-save-health').prop('disabled', true);
        });
    });
</script>
