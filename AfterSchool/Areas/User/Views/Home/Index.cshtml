@model List<Registrant>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
}

<div class="main-content">

    <div class="panel panel-default hide">
        <div class="panel-body bg-info">
            <p class="text-center text-medium">
                Missing a registration? Contact us at <a href="mailto:support@afterschoolhq.zendesk.com">support@afterschoolhq.zendesk.com</a>
            </p>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading">
            Welcome @SessionVariables.CurrentUser.FirstName.Trim().ToProperCase()!
        </div>
        <div class="panel-body">
            <p>Here is some info about your account</p>
        </div>
    </div>

    @foreach (var registrant in Model)
    {
        var answers = registrant.GetAnswers(msgs).Where(x => x.QuestionDataTypeId != QuestionDataType.NotSet).ToList();
        var children = registrant.GetChildren();
        var ras = new List<RegistrantActivity>();

        foreach(var child in children)
        {
            ras.AddRange(child.GetRegistrantActivities());
        }
       
        <div class="panel panel-default">
            <div class="panel-heading">
                @registrant.Name.ToProperCase()
            </div>
            <div class="panel-body"> 
                <div class="col-md-6">
                    <table class="table-condensed">
                        @foreach (var group in answers.DistinctBy(x => x.FormQuestionFormQuestionGroupId).Select(answer => answer.ToFormQuestionGroup()).Where(group => group.QuestionGroupDataTypeId == QuestionGroupDataType.PersonalInformation))
                        {
                            <tr>
                                <td colspan="2" class="text-medium">
                                    @group.Name
                                </td>
                            </tr>

                            foreach (var answer in answers.Where(answer => answer.FormQuestionFormQuestionGroupId == group.ID).OrderBy(answer => answer.FormQuestionDisplayOrder))
                            {
                                <tr>
                                    <td>@answer.QuestionText</td>
                                    <td>@answer.Text</td>
                                </tr>
                            }
                        }
                        
                    </table>
                </div>       
                <div class="col-md-6">

                    @if (ras.Any())
                    {
                        Html.RenderPartial(
                             "_ScheduledActivities",
                             ras.Where(x => x.IsInSession()).ToList(),
                             new ViewDataDictionary()
                             {
                                 { "registrant", registrant },
                                 { "title", string.Format("Current {0}", UILabel.ActivityLabel(ActivityType.Activity, true)) }
                             }
                        );

                        Html.RenderPartial(
                             "_ScheduledActivities",
                             ras.Where(x => x.WillBeInSession()).ToList(),
                             new ViewDataDictionary()
                             {
                                 { "registrant", registrant },
                                 { "title", string.Format("Upcoming {0}", UILabel.ActivityLabel(ActivityType.Activity, true)) }
                             }
                        );
                    }
                    else
                    {
                        <p>@registrant.FirstName.ToProperCase() is not registered for any @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()</p>
                    }
                </div> 
            </div>
        </div>
    }
</div>
