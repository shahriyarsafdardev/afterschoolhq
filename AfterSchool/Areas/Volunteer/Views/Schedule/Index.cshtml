@model List<Registrant>
@{
    var msgs = (SystemMessages) ViewBag.Messages;
    var registrantActivities = (List<RegistrantActivity>) ViewBag.RegistrantActivities;
}

@{ Html.RenderPartial("_VolunteerAccountHeader"); }

<div class="main-content">

    <div class="panel panel-default">
        <div class="panel-heading">
            Welcome @SessionVariables.CurrentUser.FirstName.Trim().ToProperCase()!
        </div>
    </div>

    @foreach (var registrantActivity in registrantActivities)
    {
        Html.RenderPartial("_BrowseRegistrantActivity", registrantActivity);
    }

