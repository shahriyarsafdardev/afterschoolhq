@model List<RegistrantActivity>
@{ 
    var registrant = (Registrant)ViewData["registrant"];
    var title = ViewData["title"];
}

@if (Model.Any(x => x.AssignmentTypeId.In(Registration.ReservedStatuses)))
{
    <div class="panel panel-alt4">
        <div class="panel-heading">
            @title 
        </div>
        <div class="panel-body">
            @foreach (var ra in Model.Where(x => x.AssignmentTypeId.In(Registration.ReservedStatuses)))
            {
                var po = ra.GetParticipationObject();
                var registration = ra.GetRegistration();

                <div class="col-md-12">
                    <div class="row">
                        <p class="text-medium">@po.Name</p>
                    </div>
                </div>

                Html.RenderPartial("~/Views/Shared/_ActivityScheduleHtml.cshtml", po.Schedule);

                if (ra.AssignmentTypeId == RegistrationAssignmentType.ReservedPendingParentalConsent)
                {
                    <div class="col-md-12 padding-v-20">
                        <div class="row">
                            <a href="@registration.GetParentalConsentUrl" class="btn btn-primary center-block btn-lg">
                                Give Consent
                                @if (po.IsNotFreeAndCanAcceptPayments)
                                {
                                    <span>&amp; Pay Online</span>
                                }
                                &raquo;
                            </a>
                        </div>
                    </div>
                }
                else if (po.IsNotFreeAndCanAcceptPayments && ra.GetAmountPaid() == 0)
                {
                    <div class="col-md-12 padding-v-20">
                        <div class="row">
                            <a href="@registration.GetPaymentUrl" class="btn btn-primary center-block btn-lg">
                                Pay Balance Online &raquo;
                            </a>
                        </div>
                    </div>
                }

                <hr />
            }
        </div>
    </div>
}
@if (Model.Any(x => x.AssignmentTypeId == RegistrationAssignmentType.WaitingList))
{
    <div class="panel panel-alt4">
        <div class="panel-heading">
            @registrant.FirstName.ToProperCase() is on the waiting list for the following @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()
        </div>
        <div class="panel-body">
            @foreach (var ra in Model.Where(x => x.AssignmentTypeId == RegistrationAssignmentType.WaitingList))
            {
                var po = ra.GetParticipationObject();

                <span>
                    @po.Name - 
                    @po.Schedule.GetDaysOfTheWeek().Select(x => x.ToString()).ToStringList(", ")
                </span><br />
            }
        </div>
    </div>
}
@if (Model.Any(x => x.AssignmentTypeId == RegistrationAssignmentType.Applied))
{
    <div class="panel panel-alt4">
        <div class="panel-heading">
            @registrant.FirstName.ToProperCase() applied for the following @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower()
        </div>
        <div class="panel-body">
            @foreach (var ra in Model.Where(x => x.AssignmentTypeId == RegistrationAssignmentType.Applied))
            {
                var po = ra.GetParticipationObject();

                <span>
                    @po.Name - 
                    @po.Schedule.GetDaysOfTheWeek().Select(x => x.ToString()).ToStringList(", ")
                </span><br />
            }
        </div>
    </div>
}
