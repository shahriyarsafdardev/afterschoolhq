@{
    var activityLabel = UILabel.ActivityLabel(ActivityType.VolunteerOpportunity);
}
<div id="modal-withdraw" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-withdraw" action="" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                    <i class="icon s7-close"></i>
                </button>
                <h3 class="modal-title"><i class="s7-attention"></i> Withdrawal Confirmation</h3>
            </div>
            <div class="modal-body form text-center">
                <p class="text-medium-small">
                    Are you sure you want to <strong>withdraw</strong>
                    <strong>
                        <span id="withdraw-name"></span>
                    </strong> from
                    <strong>
                        <span id="withdraw-activity"></span>
                    </strong>?
                </p>
                <p>
                    This action <em>cannot</em> be undone. In order to rejoin the @activityLabel.ToLower(), you will need to get in touch with the provider to re-enroll.
                </p>
            </div>
            <div class="modal-footer" style="text-align:center">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <a href="" class="btn btn-danger padding-h-20" id="btn-confirm-withdraw">Withdraw &raquo;</a>
            </div>
        </div>
    </form>
</div>

<script>
    function withdraw(registrant, po, type, registrantName, activityName, providerName, returnUrl) {
        $('#withdraw-name').html(registrantName);
        $('#withdraw-activity').html(activityName);
        $('#withdraw-provider').html(providerName);

        $('#btn-confirm-withdraw').attr('href', `@Url.Action("withdraw", "opportunity")/${registrant}?po=${po}&type=${type}&returnurl=${encodeURI(returnUrl)}`);
    }
</script>