@{
    var activityLabel = UILabel.ActivityLabel(ActivityType.VolunteerOpportunity, true);
}
<div class="panel" style="overflow: hidden;">
    <div class="heading panel-h3" style="background-color: #2f3c40; height: 80px;">
        <h3 style="vertical-align: middle; display: table-cell; width: 100%; height: 80px; padding-right: 20px;" class="text-white">
            <strong title="Your @activityLabel">Your @activityLabel</strong>
        </h3>
    </div>
    <div class="panel-body padding-sm-lr-5">

        <div class="margin-t-20">
            <p class="text-medium-small text-center">
                <span>
                    You do not have any upcoming scheduled @activityLabel
                </span>
            </p>
        </div>

        <div class="margin-t-20 visible-md visible-lg">
            <a href="@Url.Action("index", "opportunity")" class="btn btn-primary btn-register btn-block text-small">
                View Your Registration History &raquo;
            </a>
        </div>

        <div class="margin-t-20 visible-xs visible-sm">
            <a href="@Url.Action("index", "opportunity")" class="btn btn-primary btn-register btn-block text-small">
                View Your Registration History
            </a>
        </div>

    </div>
</div>