@model Account

@{
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
}

<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        <a href="@Url.Action("summary", "sport" )" class="btn btn-alt6@(actionName == "summary" ? "-active" : "" )"><i class="s7-graph2"></i> Summary</a>
        <a href="@Url.Action("division", "sport" )" class="btn btn-alt6@(actionName == "division" ? "-active" : "" )"><i class="s7-folder"></i> Divisions</a>
        <a href="@Url.Action("league", "sport")" class="btn btn-alt6@(actionName == "league" ? "-active" : "")"><i class="s7-ball"></i> Leagues</a>
    </div>
    <div class="hidden-lg hidden-sm hidden-md">
        <select class="form-control" onchange="location.href=this.value;">
            <option value="">Navigation</option>
            <option value="@Url.Action("summary", "sport")">Summary</option>
            <option value="@Url.Action("league", "sport")">Leagues</option>
            <option value="@Url.Action("division", "sport")">Divisions</option>
        </select>
    </div>
</div>