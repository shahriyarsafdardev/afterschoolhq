@{
    var objectType = (int)ViewData["objectType"];
}

<div class="btn-toolbar">
    <div class="btn-group hidden-xs">
        <a href="@Url.Action("Index", "tag" , new {objectType = (int)ObjectType.Account})" class="btn btn-alt6@(objectType == (int)ObjectType.Account ? "-active" : "")">
            <i class="s7-study"></i> School Tags
        </a>
        <a href="@Url.Action("Index", "tag" , new {objectType = (int)ObjectType.Activity})" class="btn btn-alt6@(objectType == (int)ObjectType.Activity ? "-active" : "")">
            <i class="s7-ticket"></i> Activity Tags
        </a>
    </div>
</div>

