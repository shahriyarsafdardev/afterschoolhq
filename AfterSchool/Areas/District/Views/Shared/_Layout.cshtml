<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <meta name="google" content="notranslate">
    <link rel="shortcut icon" href="/favicon.png">
    <meta name="keywords" content="">
    <title>@UILabel.ProductName()</title>
    @{Html.RenderPartial("~/Views/Shared/_HeadIncludes.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/_ZendeskWidget.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/_MediumEditorScripts.cshtml");}
</head>
<body>
    <div class="am-wrapper notopmenu">
        <!-- top navbar-->
        @*Html.Partial("_TopNavbar")*@
        <!-- sidebar-->
        @Html.Partial("_Sidebar")
        <!-- Main section-->
        <div class="am-content">
            @RenderBody()
        </div>
        @*
            @Html.Partial("_RightSideBar")
        *@
    </div>
    @{Html.RenderPartial("~/Views/Shared/_JavascriptIncludes.cshtml");}
    @RenderSection("scripts", required: false)
</body>
</html>