@model Registration
@{
    var msgs = (SystemMessages) ViewBag.Messages;
    var registrant = (Registrant) ViewBag.Registrant;
    var account = (Account) ViewBag.Account;
    var answers = (List<FormQuestionAnswer>) ViewBag.Answers;
    var registrations = (List<Registration>) ViewBag.Registrations;
    var selectedRegistration = (Registration) ViewBag.SelectedRegistration;
    var type = (ApprovalStatus)ViewBag.SelectedType;
}

<style>
    
    .input-group
    {
        display: flex;
        flex-direction: column;
        align-content: center;
        align-items: flex-start;
    }
    
    .searchActivitiesBtn
    {
        color: black;
    }
    
    small
    {
        font-size: 76%;
        color: grey;
    }
    
    .pull-left , .pull-right > button
    {
        width: 100px;
    }
    
    .date
    {
        display: table;
    }
    
</style>

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{ Html.RenderPartial("_VolunteerHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-id"></i>
            <span>@UILabel.RegistrantLabel(ActivityType.VolunteerOpportunity) Detail</span>
        </div>
        <div class="panel-body no-padding">

            <div class="col-md-10 col-md-offset-1 no-padding">

                <div class="panel panel-default">
                    <div class="panel-heading">
                         
                        <div class="pull-right">
                            <select name="r" id="r" class="form-control" onchange="registrationChange(this.value)">
                                @foreach (var registration in registrations)
                                {
                                    <option
                                        value="@registration.Uid"
                                        @(registration.ID == selectedRegistration.ID ? "selected=\"selected\"" : "")>
                                        Registration - @account.ConvertToAccountTimeZone(registration.CreateDate.Value).ToShortDateTimeString()
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-lg-2 pull-right" onchange="volunteerStatusChange()">
                            <select name="type" id="type" class="form-control">
                                @foreach (var status in Enum.GetValues(typeof(ApprovalStatus)).Cast<ApprovalStatus>().Except(ApprovalStatus.Requested.AsList()).Except(ApprovalStatus.All.AsList()))
                                {
                                    <option @(status == type ? "selected" : "") value="@((int)status)">
                                        @status
                                    </option>
                                }
                            </select>
                        </div>
                        
                        @registrant.Name
                    </div>
                    <div class="panel-body no-padding">

                        <div class="panel panel-default">
                            <div class="panel-heading">
                                
                                Registration Data
                            </div>
                            <div class="panel-body">
                                <div class="table-responsive">
                                    <table class="table table-striped">
                                        <tr>
                                            <td class="text-right" width="33%">Registration Date/Time</td>
                                            <td>@account.ConvertToAccountTimeZone(selectedRegistration.CreateDate.Value).ToLongDateTimeString()</td>
                                        </tr>
                                        <tr>
                                            <td width="33%" class="text-right">E-Signature</td>
                                            <td>@selectedRegistration.ESignature</td>
                                        </tr>
                                        @if (selectedRegistration.ESignatureIPAddress.IsNotEmpty())
                                        {
                                            <tr>
                                                <td width="33%" class="text-right">IP Address</td>
                                                <td>@selectedRegistration.ESignatureIPAddress</td>
                                            </tr>
                                        }
                                        @if (selectedRegistration.ESignatureUserAgent.IsNotEmpty())
                                        {
                                            <tr>
                                                <td width="33%" class="text-right">Browser Info</td>
                                                <td>@selectedRegistration.ESignatureUserAgent</td>
                                            </tr>
                                        }
                                    </table>
                                </div>

                                @{ Html.RenderPartial("~/Views/Shared/Registrant/_Answers.cshtml", answers); }

                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

