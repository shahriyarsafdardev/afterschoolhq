@using AfterSchoolLibrary.Enums
@model List<BackgroundViewModel>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var inviteUrl = Url.Action("invite", "school");
    var paging = (PagingModel)ViewBag.PagingModel;
    var returnUrl = Request.Url;
}

<style>
    a
    {
        width: auto;
    }
    
    .table
    {
        border-top-style: hidden;
    }
</style>

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">
    
    @{ Html.RenderPartial("_VolunteerHeader");}

    <div class="panel panel-default">
        
        <div class="panel-heading">
            <div class="pull-right">
                <a class="btn btn-primary">View Background Check Dashboard <i><img src="/Assets/img/expand 1.svg"/></i></a>
            </div>
            <h2><i class="s7-smile"></i> Background Checks</h2>
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">

            <div class="table-responsive">
                
                <div class="pull-right">
                    <input type="text" id="search" class="form-control searchFormInput" placeholder="Search for volunteer" style="float: left;width: 300px;height: 38px;margin-right: 10px;" value="@Request["search"]"/>
                    <button class="btn btn-primary searchActivitiesBtn" id="searchBtn" onclick="doSearch()">
                        Search
                    </button>
                </div>
                
                
                <table class="table">
                    <tr>
                        <th></th>
                        <th>Registrant Name</th>
                        <th>Date Submitted</th>
                        <th>Background Check Status</th>
                        <th></th>
                    </tr>
                    @if (Model.Count > 0)
                    {
                        foreach (var backgroundViewModel in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("loginto", "school")" class="btn btn-primary btn-md">View Background Check <i><img src="/Assets/img/expand 1.svg"/></i></a>
                                </td>
                                <td>@(backgroundViewModel.FirstName + ' ' + backgroundViewModel.LastName)</td>
                                <td>@backgroundViewModel.DateSubmitted.ToShortDateString()</td>
                                <td>@backgroundViewModel.BackgroundCheckStatus.ToString().SplitByUpperCase()</td>
                                <td>
                                    <div class="pull-right">
                                        <a href="@Url.Action("Details", "Volunteer", new {id = Registrant.LoadByWebUserId((int) backgroundViewModel.WebUserId, RegistrantPersonType.Volunteer, false, false).FirstOrDefault().ID, returnUrl = returnUrl})"
                                           class="btn btn-primary whitebgbtn">
                                            View Volunteer Info
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                </table>
                
                @if (Model.Count == 0)
                {
                    <p>No Background available</p>
                }
                
                @{Html.RenderPartial(
                      "~/Views/Shared/_Paging.cshtml",
                      paging,
                      new ViewDataDictionary()
                      {
                          { "id", "" },
                          { "action", "BackgroundCheck" },
                          { "controller", "volunteer" },
                          { "querystring", $"search={Request["search"]}" }
                      }
                      );
                }
            </div>
        </div>
    </div>
</div>

<script>
function doSearch() 
    {
        location.href = `@Url.Action("backgroundcheck", "volunteer")?search=${$('#search').val()}`;
    }
        
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $('#search').keypress(function (e) {
            if (e.keyCode == 13 || e.keyCode == 10) {
                doSearch();
            }
        });
    });
</script>

