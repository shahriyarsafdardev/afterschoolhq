@using AfterSchoolLibrary.Enums
@model List<VolunteerViewModel>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var returnUrl = Request.Url;
    var paging = (PagingModel)ViewBag.PagingModel;
    var type = (ApprovalStatus)ViewBag.SelectedType;
}

<style>
    a
    {
        width: auto;
    }
    .table
    {
        border-top-style: hidden;
    }
</style>

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">
    
    @{ Html.RenderPartial("_VolunteerHeader");}

    <div class="panel panel-default">
        
        <div class="panel-heading">
            <div class="pull-right">
                <a class="btn btn-primary">View Background Check Dashboard <i><img src="/Assets/img/expand 1.svg"/></i></a>
            </div>
            <h2><i class="s7-smile"></i> Volunteer</h2>
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">

            <div class="table-responsive">

                <div class="row">
                    <div class="col-lg-2">
                        <select name="type" id="type" class="form-control">
                            @foreach (var status in Enum.GetValues(typeof(ApprovalStatus)).Cast<ApprovalStatus>().Except(ApprovalStatus.NotSet.AsList()).Except(ApprovalStatus.Requested.AsList()))
                            {
                                <option @(status == type ? "selected" : "") value="@((int)status)">
                                    @status
                                </option>
                            }
                        </select>   
                    </div>
                    <div class="col-lg-5">
                        <input type="text" id="search" class="form-control searchFormInput" value="@Request["search"]" placeholder="Search for volunteer" style="float: left;width: 300px;height: 38px;margin-right: 10px;"/>
                            <button class="btn btn-primary searchActivitiesBtn" id="searchBtn" onclick="doSearch()">
                                Search
                            </button>
                    </div>
                    </div>
                    
                    <table class="table">
                        <tr>
                            <th></th>
                            <th>Registrant Name</th>
                            <th>Volunteer Status</th>
                            <th>Phone Number</th>
                            <th>Email</th>
                            <th></th>
                        </tr>
                        @if (Model.Count > 0)
                        {
                        foreach (var volunteerViewModel in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Details", "Volunteer", new {id = Registrant.LoadByWebUserId((int) volunteerViewModel.WebUserId, RegistrantPersonType.Volunteer, false, false).FirstOrDefault().ID, returnUrl = returnUrl})"
                                       class="btn btn-primary btn-md">
                                        View Volunteer Info
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Volunteer", new {id = Registrant.LoadByWebUserId((int)volunteerViewModel.WebUserId, RegistrantPersonType.Volunteer, false , false).FirstOrDefault().ID , returnUrl = returnUrl})">
                                        @(volunteerViewModel.FirstName + ' ' + @volunteerViewModel.LastName)
                                    </a>
                                </td>
                                <td>@volunteerViewModel.ApprovalStatus.ToString().SplitByUpperCase()</td>
                                <td>@volunteerViewModel.Phone</td>
                                <td>@volunteerViewModel.Email</td>
                                <td>
                                    <div class="pull-right">
                                        <a class="btn btn-primary whitebgbtn">Message</a>
                                        <a class="btn btn-primary whitebgbtn">View Background Check</a>
                                    </div>
                                </td>
                            </tr>
                        }
                        }
                    </table>
                
                @if (Model.Count == 0)
                {
                    <p>No Volunteer</p>
                }
                
                @{Html.RenderPartial(
                        "~/Views/Shared/_Paging.cshtml",
                        paging,
                        new ViewDataDictionary()
                        {
                            { "id", "" },
                            { "action", "index" },
                            { "controller", "volunteer" },
                            { "querystring", $"search={Request["search"]}&type={Request["type"]}" }
                        }
                        );
                    }
                    
            </div>
        </div>
    </div>
</div>

<script>
    function doSearch() 
    {
        location.href = `@Url.Action("index", "volunteer")?search=${$('#search').val()}&type=` + $('#type').find(":selected").val();
    }
        
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $('#search').keypress(function (e) {
            if (e.keyCode == 13 || e.keyCode == 10) {
                doSearch();
            }
        });
        
        $('#type').on('change', function() {
           location.href = '@Url.Action("index","Volunteer")?type=' + this.value; 
        });
    });
    
</script>

