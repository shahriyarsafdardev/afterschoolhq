@using AfterSchoolLibrary.Enums
@model List<VolunteerViewModel>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var returnUrl = Request.Url;
    var paging = (PagingModel)ViewBag.PagingModel;
    var type = (ApprovalStatus)ViewBag.SelectedType;
}

<style>
    a
    {
        width: auto;
    }
    .table
    {
        border-top-style: hidden;
    }
</style>

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">
    
    @{ Html.RenderPartial("_VolunteerHeader");}

    <div class="panel panel-default">
        
        <div class="panel-heading">
            <div class="pull-right">
                <a class="btn btn-primary hidden">View Background Check Dashboard <i><img src="/Assets/img/expand 1.svg"/></i></a>
            </div>
            <h2><i class="s7-smile"></i> Volunteer</h2>
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">

            <div class="table-responsive">

                <div>
                    <div class="col-lg-2">
                        <select name="type" id="type" class="form-control">
                            @foreach (var status in Enum.GetValues(typeof(ApprovalStatus)).Cast<ApprovalStatus>().Except(ApprovalStatus.NotSet.AsList()).Except(ApprovalStatus.Requested.AsList()))
                            {
                                <option @(status == type ? "selected" : "") value="@((int)status)">
                                    @status
                                </option>
                            }
                        </select>   
                    </div>
                    <div class="pull-right">
                        <input type="text" id="search" class="form-control searchFormInput" value="@Request["search"]" placeholder="Search for volunteer" style="width: 300px;height: 38px;margin-right: 10px;"/>
                        <button class="btn btn-primary searchActivitiesBtn" id="searchBtn" onclick="doSearch()">
                            Search
                        </button>
                        <a class="btn btn-primary" href="@Url.Action("ExportVolunteer", "Volunteer" , new {search = Request["search"] , type = Request["type"]})" >Export Volunteer</a>
                    </div>
                    </div>
                    
                    <table class="table">
                        <tr>
                            <th></th>
                            <th>First Name</th>
                            <th>Last Name</th>
                            <th>Volunteer Status</th>
                            <th>Phone Number</th>
                            <th>Email</th>
                            <th></th>
                        </tr>
                        @if (Model.Count > 0)
                        {
                        foreach (var volunteerViewModel in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("Details", "Volunteer", new {id = Registrant.LoadByWebUserId((int) volunteerViewModel.WebUserId, RegistrantPersonType.Volunteer, false, false).FirstOrDefault().ID, returnUrl = returnUrl})"
                                       class="btn btn-primary btn-md">
                                        View Volunteer Info
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Volunteer", new {id = Registrant.LoadByWebUserId((int)volunteerViewModel.WebUserId, RegistrantPersonType.Volunteer, false , false).FirstOrDefault().ID , returnUrl = returnUrl})">
                                        @(volunteerViewModel.FirstName)
                                    </a>
                                </td>
                                <td>
                                    <a href="@Url.Action("Details", "Volunteer", new {id = Registrant.LoadByWebUserId((int)volunteerViewModel.WebUserId, RegistrantPersonType.Volunteer, false , false).FirstOrDefault().ID , returnUrl = returnUrl})">
                                        @(volunteerViewModel.LastName)
                                    </a>
                                </td>
                                <td>@volunteerViewModel.ApprovalStatus.ToString().SplitByUpperCase()</td>
                                <td>@volunteerViewModel.Phone</td>
                                <td>@volunteerViewModel.Email</td>
                                <td>
                                    <div class="pull-right">
                                        <a class="btn btn-primary whitebgbtn" onclick="sendEmail('@volunteerViewModel.FirstName', '@volunteerViewModel.LastName', '@volunteerViewModel.Email')">Message</a>
                                        <a class="btn btn-primary whitebgbtn hidden">View Background Check</a>
                                    </div>
                                </td>
                            </tr>
                        }
                        }
                    </table>
                
                @if (Model.Count == 0)
                {
                    <p>No Volunteers</p>
                }
                
                @{Html.RenderPartial(
                        "~/Views/Shared/_Paging.cshtml",
                        paging,
                        new ViewDataDictionary()
                        {
                            { "id", "" },
                            { "action", "index" },
                            { "controller", "volunteer" },
                            { "querystring", $"search={Request["search"]}&type={Request["type"]}" }
                        }
                        );
                    }
                    
            </div>
        </div>
    </div>
</div>

<div id="modal-send-mail" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <h3 id="title" class="modal-title">
                
            </h3>
        </div>
        <div class="modal-body text-center">
            <div class="modal-form">
                <form class="form-horizontal"  action="@Url.Action("SendMessage", "Volunteer")" method="post">
                    <div class="form-group" id="subject-group">
                        <label class="col-sm-3 control-label">Message Reason</label>
                        <div class="col-sm-6">
                            <select name="subject" id="subject" class="form-control">
                                <option value="">Select a Message Reason...</option>
                                @{
                                    var reasons = FormConstants.VolunteerMessageReasons();
                                    foreach (var reason in reasons)
                                    {
                                        <option value="@reason.ToString().SplitByUpperCase()">@reason.ToString().SplitByUpperCase()</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Message Body</label>
                        <div class="col-sm-6">
                            <textarea name="body" id="body" required style="width: 100%" rows="5" class="form-control"></textarea>
                            <p class="text-muted">Max of 1000 characters</p>
                            <input type="hidden" name="email" id="email"/>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-lg-6 col-lg-offset-3 col-md-12 text-medium-small">
                            <div class="pull-left">
                                <button type="button"
                                        data-dismiss="modal"
                                        class="btn btn-primary searchActivitiesBtn btn-md"
                                        onclick="closeModal()">
                                    Cancel
                                </button>
                            </div>
                            <div class="pull-right">
                                <button type="submit"
                                        data-dismiss="modal"
                                        class="btn btn-primary btn-md">
                                    Send Email
                                </button>
                                <input type="hidden" class="webUserIDs" name="webUserIDs"/>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            
        </div>
    </div>
</div>

<script>
    function doSearch() 
    {
        location.href = `@Url.Action("index", "volunteer")?search=${$('#search').val()}&type=` + $('#type').find(":selected").val();
    }
     
    function sendEmail(firstName, lastName, email)
    {
       $("#title").text("Select Message to " + firstName + ' ' + lastName);
       $('#email').val(email);
       $('#modal-send-mail').addClass('md-show'); 
    }
    
    function closeModal()
    {
        $('#modal-send-mail').removeClass('md-show');
        $(':input','.modal-form').val('');
    }
    
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $('#search').keypress(function (e) {
            if (e.keyCode == 13 || e.keyCode == 10) {
                doSearch();
            }
        });
        
        $('#type').on('change', function() {
           location.href = '@Url.Action("index","Volunteer")?type=' + this.value; 
        });
    });
    
</script>

