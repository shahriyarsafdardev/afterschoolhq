@{
    ViewBag.Title = "Invite School";
}

@{ Html.RenderPartial("DistrictHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", (SystemMessages)ViewBag.Messages); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-id"></i> Invite School
        </div>

        <div class="panel-body">

            <form class="form-horizontal" method="post" action="@Url.Action("invite", "school")">

                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        School Name
                    </div>
                    <div class="col-sm-6">
                        <input type="text" maxlength="50" name="orgname" id="orgname" class="form-control" value="@Request["orgname"]" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        First Name
                    </div>
                    <div class="col-sm-6">
                        <input type="text" maxlength="50" name="firstname" id="firstname" class="form-control" value="@Request["firstname"]" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        Last Name
                    </div>
                    <div class="col-sm-6">
                        <input type="text" maxlength="50" name="lastname" id="lastname" class="form-control" value="@Request["lastname"]" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        Email
                    </div>
                    <div class="col-sm-6">
                        <input type="text" maxlength="50" name="email" id="email" class="form-control" value="@Request["email"]" />
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        Invite Message
                    </div>
                    <div class="col-sm-6">
                        <textarea class="form-control" rows="4" cols="100" name="message" id="message">@Request["message"]</textarea>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button type="reset" class="btn btn-default" onclick="location.href='@Url.Action("index", "school")'">Cancel</button>
                        <button type="submit" class="btn btn-primary pull-right"><i class="s7-paper-plane"></i> Send Invite</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


