@model List<Account>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var inviteUrl = Url.Action("invite", "school");
}

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">
                <a href=@inviteUrl class="btn btn-default"><i class="s7-plus"></i> Invite School</a>
            </div>
            <h2><i class="s7-study"></i> Schools</h2>
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">

            @if (Model.Any())
            {
                <div class="row">
                    <div class="col-sm-4">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-toggle="counter" data-end="@Model.Count" data-decimals="0" data-suffix="" class="value">@Model.Count</div>
                                <div class="desc">School@(Model.Count > 1 ? "s" : "") in District</div>
                            </div>
                            <div class="icon"><span class="s7-study"></span></div>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table">
                        <tr>
                            <th></th>
                            <th>School</th>
                            <th>Contact</th>
                            <th>Grades Offered</th>
                            <th>Leagues Participating</th>
                        </tr>
                        @foreach (var account in Model)
                        {
                            <tr>
                                <td>
                                    <a href="@Url.Action("loginto", "school", new { id = account.Uid })" class="btn btn-primary btn-sm">Login</a>
                                </td>
                                <td>@account.Name</td>
                                <td>@account.GetAccountOwner().DisplayName</td>
                                <td>Grades</td>
                                <td>@account.GetLeagueCount(true)</td>
                            </tr>
                        }               
                    </table>
                </div>
            }
            else
            {
                <div class="widget">
                    <div class="widget-head">
                        <h1>Manage all of your schools here</h1>
                    </div>
                    <div class="widget-tile">
                        <hr />
                        <p>You haven't invited any schools to your district yet. In order to get started, <a href="@inviteUrl">invite your first school</a>.</p>
                        <p>&nbsp;</p>
                        <p>
                            <a href="@inviteUrl" class="btn btn-primary btn-lg">Invite Your First School &raquo;</a>
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
