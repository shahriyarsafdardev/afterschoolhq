@model List<AfterSchoolLibrary.Account>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var inviteUrl = Url.Action("inviteschool", "league");
    var schoolsToInvite = ViewBag.SchoolsToInvite;
    var currentSchools = (List<Account>)ViewBag.CurrentSchools;
    var schoolsPerColumn = (int)ViewBag.SchoolsPerColumn;
    var activityGroupUid = ViewBag.ActivityGroupUid;

}

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <h2><i class="s7-study"></i> Schools</h2>
            <div class="clearfix"></div>
        </div>
        <div class="panel-body">

            @if (Model.Any())
            {
                <div class="row">
                    <div class="col-sm-4">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div data-toggle="counter" data-end="@Model.Count" data-decimals="0" data-suffix="" class="value">@Model.Count</div>
                                <div class="desc">Schools In District</div>
                            </div>
                            <div class="icon"><span class="s7-study"></span></div>
                        </div>
                    </div>
                </div>

                if (Model.Count == 0)
                {
                    <p> You have no schools in your disctrict, please go to Schools in the side bar and invite them there. </p>
                }
                else
                {
                    <form action="@Url.Action("inviteschool","league",new { uid = activityGroupUid } )" method="post" id="invite-schools-forms">
                        <div class="form-group">
                            <label class="col-sm-3 control-label">
                                Select @UILabel.RegistrantLabel(true)<br />
                                <a href="javascript:selectAll()">Select All</a> | <a href="javascript:clearAll()">Clear All</a>
                            </label>
                            <div class="col-sm-6">
                                @for (int i = 0; i < 3; i++)
                                {
                                    <div class="col-md-4">
                                        @foreach (var school in Model.Skip((i * schoolsPerColumn)).ToList().Take(schoolsPerColumn))
                                        {
                                            <div class="am-checkbox">
                                                <input type="checkbox" onclick="toggleCheck(@school)" id="school-@school.ID.Value" name="registrant-@school.ID" value="1" @(currentSchools.Contains(school) ? " checked=\"checked\" " : "") />
                                                <label for="school-@school.ID">@school.Name.MaxChars(20, "...")</label>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Invite Teams</button>
                        </div>

                    </form>

                }
            }
            else
            {
                <div class="widget">
                    <div class="widget-head">
                        <h1>Manage all of your schools here</h1>
                    </div>
                    <div class="widget-tile">
                        <hr />
                        <p>You haven't invited any schools yet. In order to get started, <a href="@inviteUrl">invite your first school</a>.</p>
                        <p>&nbsp;</p>
                        <p>
                            <a href="@inviteUrl" class="btn btn-primary btn-lg">Invite Your First School &raquo;</a>
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>


<script>
    function toggleCheck(school) {
        var cs = @currentSchools;
        if (cs.Contains(school)) {
            cr.Remove(school);
        } else {
            cr.Add(school);
        }
        @currentSchools = cr;
    }
</script>