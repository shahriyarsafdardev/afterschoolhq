@model ActivityGroup
@{
    ViewBag.Title = "Activities";
    var msgs = (SystemMessages)ViewBag.Messages;
    var activities = (List<Activity>)ViewBag.Activities;
}

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
    @{Html.RenderPartial("_LeagueHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">

            <div class="pull-right hide">

                <a href="@Url.Action("inviteschool", "league", new { group = Model.Uid })" class="btn btn-primary btn-space margin-r-10">
                    <i class="icon icon-left s7-plus"></i>
                    Add @UILabel.ActivityLabel(Model.ActivityGroupTypeId)
                </a>
            </div>

                @{Html.RenderPartial("_ActivityGroupTitle", Model.Name); }
                <div class="clearfix"></div>
            </div>
            <div class="panel-body">

                @{ Html.RenderPartial(
                    "~/Views/Shared/_Teams.cshtml",
                    activities,
                    new ViewDataDictionary() {
                        { "Account", SessionVariables.CurrentAccount },
                        { "AccountPackage", SessionVariables.AccountPackage },
                        { "PagingModel", ViewBag.PagingModel },
                        { "ShowRegistrationPeriodFilter", false },
                        { "Group", Model },
                        { "NeedToUpgrade", false},
                        { "HasArchivedActivities", false}
                    }
                ); }
            </div>
        </div>
    </div>
