@model ActivityGroup
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var forms = (List<Form>)ViewBag.Forms;
    var schedule = (ActivitySchedule)ViewBag.Schedule;
    var activityInstances = (List<ActivityInstance>)ViewBag.ActivityInstances;
    var teams = (List<Activity>)ViewBag.Teams;

}

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("_LeagueHeader");}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityGroupTitle.cshtml", Model.Name); }
        </div>
        <div class="panel-body">
            
            <div class="panel-heading">
                <div class="pull-right">
                    <a href="@Url.Action("editgame", "league", new { id = Model.Uid })" class="btn-primary btn-space margin-r-10 padding-10">
                        <i class="icon icon-left s7-plus"></i>
                        Add Game
                    </a>
                </div>
               
                <h2>
                    Season Schedule
                </h2>
            </div>
            @foreach(List<ActivityInstance> day in activityInstances.GroupBy(a => a.StartDateTime.Value.Date).Select(grp => grp.ToList()).ToList())
            { 
                
                <h4 class="margin-10">@day.First().StartDateTime.Value.ToShortDateString() - @day.First().Day.ToDayOfWeek().ToString()
                    <a href="@Url.Action("editgame", "league", new { id = Model.Uid, date = day.First().StartDateTime.Value.ToShortDateString() })" class="btn-default  btn-space margin-r-10 padding-10">
                        <i class="icon icon-right s7-plus"></i>
                    </a>
                </h4>
                foreach (var activityInstance in day)
                {

                    var matches = Match.LoadByActivityInstanceId(activityInstance.ID.Value);
                    var matchTeams = "";
                    var location = new Location();
                    var locationName = " @ TBD";
                    var startTime = activityInstance.StartDateTime.Value.ToShortTimeString();
                    var endTime = activityInstance.EndDateTime.Value.ToShortTimeString();
                    if (activityInstance.LocationId.IsNotEmpty())
                    {
                        location = Location.Load(activityInstance.LocationId.Value);
                        locationName = " @ " + location.Name.ToString() + " - ";
                    }


                    var vs = " ";

                    foreach ( var match in matches)
                    {
                        Activity team = teams.Find(t => t.ID.Value == match.TeamId.Value);


                        if (team.IsNotEmpty())
                        {
                            matchTeams += vs + team.Name.ToString();
                            vs = " vs. ";
                        }

                    }

                    <h6>
                        <a href="@Url.Action("editgame", "league", new { id = Model.Uid, instance = activityInstance.ID.Value})">
                            <i class="icon icon-left s7-more"></i>
                            @startTime - @endTime @locationName @matchTeams
                        </a>
                    </h6>
                       

                    
                    
                }
                <br/>
                
            }
        </div>
    </div>
</div>
