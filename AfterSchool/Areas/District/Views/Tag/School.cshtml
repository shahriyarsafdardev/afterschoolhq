@using Microsoft.Ajax.Utilities
@model List<Account>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var availableTags = (List<AvailableTag>)ViewBag.AvailableTags;
}

@{Html.RenderPartial("DistrictHeader");}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs);};


<div class="main-content">
    
    @{ Html.RenderPartial("_TagHeader");}

    <div class="panel panel-default">
        
        <div class="panel-heading">
            <h2><i class="s7-smile"></i> School</h2>
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            
            <table class="table">
                <tr>
                    <th>School</th>
                    <th>Link</th>
                    <th>Tag</th>
                </tr>
                @if (Model.Count > 0)
                {
                    foreach (var school in Model)
                    {
                        <tr>
                            <td>@school.Name</td>
                            <td><a href="@school.BrowseUrl" target="_blank" >@school.BrowseUrl</a></td>
                            <td>
                                <input type="text" class="form-control assignedTags" data-role="tagsinput" value="@(AssignedTagService.GetByIdByType((int)school.ID, (int)ObjectType.Account).Select(x => x.Tag).ToStringList(","))">
                                <input type="hidden" id="@school.ID"/>
                            </td>
                        </tr>
                    }
                }
            </table>

        </div>
    </div>
</div>


@section scripts
{
    <script>
    
    $(document).ready(function(){
        
        $(".assignedTags").on('beforeItemAdd', function(event) {
            
            var availableTags = JSON.parse('@Html.Raw(availableTags.Select(x => x.Tag).ToJSON())');
            
            if(!availableTags.includes(event.item)) {
                 event.cancel = true;
            }
            else
            {
                 var tag = event.item;
                 var objectId = $(this).next().attr("id");
                 var objectType = '@((int)ObjectType.Account)';
                 
                 $.ajax({  
                     type: "GET",  
                     url: '@(Url.Action("AddRemoveAssignedTag", "Tag"))?tag='+tag+'&objectId='+objectId+'&objectType='+objectType+'&operation=add' ,  
                     data: {},  
                     contentType: "application/json; charset=utf-8",  
                     dataType: "json",  
                     success: function (msgs) {  
                         
                     },            
                     complete: function(){  
                          
                     },  
                     failure: function (jqXHR, textStatus, errorThrown) {                  
                          event.cancel = true;
                     }  
                 }); 
                 
            }
            
        });
        
        $(".assignedTags").on('beforeItemRemove', function(event) {
                        
             var tag = event.item;
             var objectId = $(this).next().attr("id");
             var objectType = '@((int)ObjectType.Account)';
             
             $.ajax({  
                 type: "GET",  
                 url: '@(Url.Action("AddRemoveAssignedTag", "Tag"))?tag='+tag+'&objectId='+objectId+'&objectType='+objectType+'&operation=remove' ,  
                 data: {},  
                 contentType: "application/json; charset=utf-8",  
                 dataType: "json",  
                 success: function (msgs) {  
                     
                 },            
                 complete: function(){  
                      
                 },  
                 failure: function (jqXHR, textStatus, errorThrown) {                  
                      event.cancel = true;
                 }  
             }); 
            
        });
        
    }); 
    
    </script>

}
