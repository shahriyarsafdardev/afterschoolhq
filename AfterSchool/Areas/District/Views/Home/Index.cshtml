@model AfterSchoolLibrary.Account
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var submittedActivites = (List<Activity>)ViewBag.SubmittedActivities;
}

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    <div class="panel panel-default">
        <div class="panel-heading">
            Welcome @SessionVariables.LoggedInUser.FirstName!
        </div>
        <div class="panel-body">
            This is your district dashboard 

            @if (submittedActivites.Count > 0)
            {
                foreach(Activity activity in submittedActivites)
                {
                    <p>@activity.Name has been submitted to @activity.GetActivityGroup().Name</p>
                }
            }
            @* loop through notifications *@
        </div>
    </div>
</div>
