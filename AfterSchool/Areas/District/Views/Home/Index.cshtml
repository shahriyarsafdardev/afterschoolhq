@model Account
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var submittedActivites = (List<Activity>)ViewBag.SubmittedActivities;
}

@{Html.RenderPartial("DistrictHeader");}

<div class="main-content">

    <div class="panel panel-default">
        <div class="panel-heading">
            Welcome @SessionVariables.LoggedInUser.FirstName!
        </div>
        <div class="panel-body">

            @if (submittedActivites.Count > 0)
            {
                <span>Recent Team Submissions</span>

                <ul>
                    @foreach (var activity in submittedActivites)
                    {
                        <li>@activity.AccountName submitted @activity.Name to @activity.GetActivityGroup().Name</li>
                    }
                </ul>
            }

        </div>
    </div>
</div>
