@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
}

@{Html.RenderPartial("OrgAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model);}

    <div class="panel panel-default">
        <div class="panel-heading">            
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Details"); }
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("edit", "activity", new { id = Model.ID })" class="form-horizontal">
               
                @{Html.RenderPartial("~/Views/Shared/_ActivityForm.cshtml", Model, new ViewDataDictionary() { { "AccountPackage", accountPackage } });}

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary btn-lg btn-block pull-right"><i class="s7-diskette"></i> Save</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>