@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var activity = (Activity)ViewBag.Activity;
}

@{Html.RenderPartial("OrgAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", null);}

    @{Html.RenderPartial(
          "~/Views/Shared/_ActivityWizard.cshtml",
          activity,
          new ViewDataDictionary() { { "AccountPackage", accountPackage } }
          );}

</div>