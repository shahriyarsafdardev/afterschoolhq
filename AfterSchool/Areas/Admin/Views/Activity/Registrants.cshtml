@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("AdminAccountHeader", Model.AccountId.ToString());}

<div class="main-content">

    @Html.Raw(UI.RenderMessagesToHtml(msgs))

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model.ID.ToString());}

    <div class="panel panel-default">
        <div class="panel-heading">
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", Model.Name + " - Registrants");}            
        </div>
        <div class="panel-body">

            @{Html.RenderPartial("~/Views/Shared/_Registrants.cshtml", Model);}

        </div>
    </div>
</div>
