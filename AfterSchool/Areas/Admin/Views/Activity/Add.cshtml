@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("AdminAccountHeader", Model.ID.ToString());}

<div class="main-content">

    @Html.Raw(UI.RenderMessagesToHtml(msgs))

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", "");}

    <div class="panel panel-default">
        <div class="panel-heading">            
            @{Html.RenderPartial("~/Views/Shared/_ActivityTitle.cshtml", UILabel.ActivityLabel()); }
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("add", "activity", new { id = Model.ID })" class="form-horizontal">
                
                @{Html.RenderPartial("~/Views/Shared/_ActivityForm.cshtml", new Activity() { WaitingListSeats = 0, SeatsAvailable = 10 });}

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary btn-lg btn-block pull-right">Next &raquo;</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>