@model AfterSchoolLibrary.Activity
@{
    ViewBag.Title = Model.AccountName;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("AdminAccountHeader", Model.AccountId.ToString());}

<div class="main-content">
   
    @Html.Raw(UI.RenderMessagesToHtml(msgs))

    @{Html.RenderPartial("~/Views/Shared/_ActivityHeader.cshtml", Model.ID.ToString());}

    <div class="panel panel-default">
        <div class="panel-heading">            
            <i class="s7-gleam"></i> @Model.Name
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("edit", "activity", new { id = Model.ID })" class="form-horizontal">

                @{Html.RenderPartial("~/Views/Shared/_ActivityForm.cshtml", Model);}

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary btn-lg btn-block pull-right"><i class="s7-diskette"></i> Save</button>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>