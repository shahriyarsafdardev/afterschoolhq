@model List<WebUser>
@{
    ViewBag.Title = "Users";
}

<div class="page-head">
    <h2>Users</h2>
</div>
<div class="main-content">
    <div class="panel panel-default">

        <div class="pull-right">
            <a href="@Url.Action("edit", "user")" class="btn btn-primary">Add Administrator</a>
        </div>

        <div class="panel-body">
            @{ Html.RenderPartial(
                   "~/Views/Shared/_Users.cshtml", 
                   Model, 
                   new ViewDataDictionary() { 
                    { "AccountId", ViewBag.AccountId }, 
                    { "ReturnUrl", ViewBag.ReturnUrl } ,
                    { "PagingModel", ViewBag.PagingModel }
                   }); 
            }
        </div>
    </div>
</div>


