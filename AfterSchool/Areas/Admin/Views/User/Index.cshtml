@model List<WebUser>
@{
    ViewBag.Title = "Users";
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div class="page-head">
    <h2>Users</h2>
</div>
<div class="main-content">
    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">
                <a href="@Url.Action("edit", "user", new { returnurl = Url.Action("index", "user") })" class="btn btn-primary">Add Administrator</a>
            </div>
            <i class="s7-users"></i> Users
        </div>
        <div class="panel-body">

            <div class="row padding-v-10">
                <div class="col-md-4">
                    <input type="text" id="search" name="search" value="@Request["search"]" class="form-control" placeholder="Enter Search Term..." />
                </div>
                <div class="col-md-4">
                </div>
                <div class="col-md-4">

                </div>
            </div>

            @{ Html.RenderPartial(
               "~/Views/Shared/_Users.cshtml",
               Model,
               new ViewDataDictionary()
               {
                    { "AccountId", ViewBag.AccountId },
                    { "ReturnUrl", ViewBag.ReturnUrl } ,
                    { "PagingModel", ViewBag.PagingModel }
         });
            }
        </div>
    </div>
</div>


<script>
    function doSearch() {
        location.href = `@Url.Action("index", "user")?search=${$('#search').val()}`;
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#search').keypress(function (e) {
            if (e.keyCode == 13 || e.keyCode == 10) {
                doSearch();
            }
        });
    });
</script>

