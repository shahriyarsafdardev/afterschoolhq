@model WebUser
@{
    ViewBag.Title = @Model.DisplayName;
    var returnUrl = ViewBag.ReturnUrl;
}

<div class="page-head">
    <h2>@Model.DisplayName</h2>
</div>
<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", (SystemMessages)ViewBag.Messages); }

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-user"></i> @Model.DisplayName
        </div>
        <div class="panel-body">
            <form method="post" action="@Url.Action("edit", "user", new { id = @Model.Uid, returnurl = Request["returnurl"] })" class="form-horizontal">
                <div class="form-group">
                    <label class="col-sm-3 control-label">First Name</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="firstname" name="firstname" value="@Model.FirstName" onfocus="this.select()" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Last Name</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="lastname" name="lastname" value="@Model.LastName" onfocus="this.select()" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Email</label>
                    <div class="col-sm-6">
                        <input type="email" class="form-control" id="email" name="email" value="@Model.Email" onfocus="this.select()" required />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Phone</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone" onfocus="this.select()" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Password</label>
                    <div class="col-sm-6">
                        <input type="password" class="form-control" id="password1" name="password1" value="" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Verify Password</label>
                    <div class="col-sm-6">
                        <input type="password" class="form-control" id="password2" name="password2" value="" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Is Active</label>
                    <div class="col-sm-6">
                        @{ Html.RenderPartial(
                      "~/Views/Shared/_SwitchButton.cshtml",
                      Model.IsActive,
                      new ViewDataDictionary() { { "checkboxname", "isactive" }, { "checkboxid", "isactive" } });
                        }
                    </div>
                </div>
                @if (!Model.ID.HasValue)
                {
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Create System Admin Account</label>
                        <div class="col-sm-6">
                            @{ Html.RenderPartial(
                              "~/Views/Shared/_SwitchButton.cshtml",
                              false,
                              new ViewDataDictionary() { { "checkboxname", "sysadmin" }, { "checkboxid", "sysadmin" } });
                            }
                        </div>
                    </div>
                }
                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button type="submit" class="btn btn-primary pull-right">Save</button>
                        <a href="@returnUrl" class="pull-left text-muted">
                            Back to List
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>


