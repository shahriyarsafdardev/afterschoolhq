@model Package
@{
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages) ViewBag.Messages;
    var disableAttr = "";
    var readonlyAttr = "";
    var features = (List<PackageFeature>) ViewBag.Features;
    var featureTypes = Enum.GetValues(typeof(FeatureType)).Cast<FeatureType>().OrderBy(x => x.ToString());
}

<div class="page-head">
    <h2>Package: @Model.Name</h2>
</div>

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">
        <div class="panel-body">
            <form id="frmPackageFeatures" method="post" action="@Url.Action("edit", "package", new {id = Model.ID})" class="form-horizontal">

                <div class="form-group">
                    <label class="col-sm-3 control-label">Package Name</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="name" name="name" value="@Model.Name" onfocus="this.select()" required/>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Price / Month</label>
                    <div class="col-sm-6">
                        <input type="number" class="form-control" id="price" name="price" value="@Model.Price.IfEmpty(0).ToString("####.00")" onfocus="this.select()" step="any" required @readonlyAttr/>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Price / Year</label>
                    <div class="col-sm-6">
                        <input type="number" class="form-control" id="priceperyear" name="priceperyear" value="@Model.PricePerYear.IfEmpty(0).ToString("####.00")" onfocus="this.select()" step="any" required @readonlyAttr/>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Is Active</label>
                    <div class="col-sm-6">
                        @{ Html.RenderPartial(
                               "~/Views/Shared/_SwitchButton.cshtml",
                               Model.IsActive,
                               new ViewDataDictionary
                               {
                                   {"checkboxname", "isactive"},
                                   {"checkboxid", "isactive"},
                               }); }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Is Popular</label>
                    <div class="col-sm-6">
                        @{ Html.RenderPartial(
                               "~/Views/Shared/_SwitchButton.cshtml",
                               Model.IsPopular,
                               new ViewDataDictionary
                               {
                                   {"checkboxname", "ispopular"},
                                   {"checkboxid", "ispopular"},
                               }); }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">For AfterSchoolHQ.com?</label>
                    <div class="col-sm-6">
                        @{ Html.RenderPartial(
                               "~/Views/Shared/_SwitchButton.cshtml",
                               Model.IsAfterSchool,
                               new ViewDataDictionary
                               {
                                   {"checkboxname", "isafterschool"},
                                   {"checkboxid", "isafterschool"},
                               }); }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Description</label>
                    <div class="col-sm-6">
                        <textarea class="form-control" id="description" name="description" onfocus="this.select()">@Model.Description</textarea>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <div>
                            <h3>Features</h3>
                            <p>Enter 0 to turn off feature, a number greater than 0 to activate feature and one denote the max number of the feature the package has</p>
                        </div>
                    </div>
                </div>

                @foreach (var type in featureTypes)
                {
                    if (type == FeatureType.NotSet)
                    {
                        continue;
                    }

                    var feature = features.Where(x => x.FeatureTypeId == type).FirstOrDefault();
                    var value = feature.IsNotEmpty() ? feature.Max.ToString() : "";

                    <div class="form-group">
                        <label class="col-sm-3 control-label">@type.ToString().SplitByUpperCase()</label>
                        <div class="col-sm-1">
                            <input id="@type" type="number" class="form-control" name="@type" value="@value" min="0" step="0.01" required @readonlyAttr
                                   onfocus="this.select()"
                                   oninput="this.value = !!this.value && Math.abs(this.value) >= 0 ? this.value : null"/>
                        </div>
                        <div class="col-sm-8">
                            @if (Model.ID.HasValue)
                            {
                                <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="resetConfirmationModal" onclick="resetFeature(@((int) type), '@type', '@FormConstants.IndividualProviderAccountTypes.Select(x => (int) x).ToStrings().ToStringList()', false, 'This will reset all accounts with the account type of @FormConstants.IndividualProviderAccountTypes.Select(x => x.ToString()).ToStringList(", ", ", or ") where the account value is less than ' + document.getElementById('@type').value)">
                                    Reset Provider Accts (&lt;)
                                </button>
                                <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="resetConfirmationModal" onclick="resetFeature(@((int) type), '@type', '@FormConstants.IndividualProviderAccountTypes.Select(x => (int) x).ToStrings().ToStringList()', true, 'This will reset all accounts with the account type of @FormConstants.IndividualProviderAccountTypes.Select(x => x.ToString()).ToStringList(", ", ", or ") to ' + document.getElementById('@type').value)">
                                    Reset Provider Accts (all)
                                </button>
                                <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="resetConfirmationModal" onclick="resetFeature(@((int) type), '@type', '@FormConstants.LocationProviderAccountTypes.Select(x => (int) x).ToStrings().ToStringList()', false, 'This will reset all accounts with the account type of @FormConstants.LocationProviderAccountTypes.Select(x => x.ToString()).ToStringList(", ", ", or ") where the account value is less than ' + document.getElementById('@type').value)">
                                    Reset School Accts (&lt;)
                                </button>
                                <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="resetConfirmationModal" onclick="resetFeature(@((int) type), '@type', '@FormConstants.LocationProviderAccountTypes.Select(x => (int) x).ToStrings().ToStringList()', true, 'This will reset all accounts with the account type of @FormConstants.LocationProviderAccountTypes.Select(x => x.ToString()).ToStringList(", ", ", or ") to ' + document.getElementById('@type').value)">
                                    Reset School Accts (all)
                                </button>
                                <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="resetConfirmationModal" onclick="resetFeature(@((int) type), '@type', '@FormConstants.ProviderAccountTypes.Select(x => (int) x).ToStrings().ToStringList()', false, 'This will reset all accounts with the account type of @FormConstants.ProviderAccountTypes.Select(x => x.ToString()).ToStringList(", ", ", or ") where the account value is less than ' + document.getElementById('@type').value)">
                                    Reset All Accts (&lt;)
                                </button>
                                <button type="button" class="btn btn-default btn-sm md-trigger" data-modal="resetConfirmationModal" onclick="resetFeature(@((int) type), '@type', '@FormConstants.ProviderAccountTypes.Select(x => (int) x).ToStrings().ToStringList()', true, 'This will reset all accounts with the account type of @FormConstants.ProviderAccountTypes.Select(x => x.ToString()).ToStringList(", ", ", or ") to ' + document.getElementById('@type').value)">
                                    Reset All Accts (all)
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button id="btnSavePackage" type="submit" class="btn btn-primary" onclick="return processPackageSave();">Save</button>
                        <button type="reset" class="btn btn-default">Discard Changes</button>
                        <a href="@Url.Action("index", "package")" class="btn btn-default pull-right"><i class="icon icon-left s7-left-arrow"></i> Back to List</a>
                    </div>
                </div>
            </form>

            <form id="frmFeatureReset" method="post" action="@Url.Action("resetfeature", "package", new {id = Model.ID})" class="form-horizontal">

                <input type="hidden" name="packageId" id="packageId" value="@Model.ID"/>
                <input type="hidden" name="featureTypeId" id="featureTypeId" value=""/>
                <input type="hidden" name="featureValue" id="featureValue" value=""/>
                <input type="hidden" name="accountTypeIds" id="accountTypeIds" value=""/>
                <input type="hidden" name="resetIfAcctValueGreaterThan" id="resetIfAcctValueGreaterThan" value=""/>

            </form>
        </div>
    </div>
</div>

@{
    Html.RenderPartial(
        "~/Views/Shared/_Modal.cshtml",
        new ModalViewModel
        {
            ActionButtonHtml = "Continue &gt; ",
            HtmlBody = "",
            Title = "Are you sure?",
            ActionButtonId = "resetConfirmationButton",
            ID = "resetConfirmationModal",
        }
        );
}


@section Scripts
{
    <script src="~/Scripts/jquery.validate.js"></script>
    <script type="text/javascript">
        function processPackageSave() {
            var btnSave = $('#btnSavePackage');
            var formClaimProfile = $('#frmPackageFeatures');

            if (formClaimProfile.valid()) {
                btnSave.prop('disabled', true);
                btnSave.html('...');
                showLoader();

                formClaimProfile.submit();
            } else {
                Notifications.showBar({
                    title: 'Error',
                    message: 'Form is not valid, please check all the required fields.',
                    success: false
                });
            }
        }

        PageEvent.add(PageEvent.AFTER_INIT, function () {
            $('#resetConfirmationButton').click(function () {
                $('#frmFeatureReset').submit();
            });
        });

        function resetFeature(featureTypeId, featureValue, accountTypeIds, resetIfAcctValueGreaterThan, confirmationMsg) {
            $('#featureTypeId').val(featureTypeId);
            $('#featureValue').val($('#' + featureValue).val());
            $('#accountTypeIds').val(accountTypeIds);
            $('#resetIfAcctValueGreaterThan').val(resetIfAcctValueGreaterThan);
            $('#resetConfirmationModal').find('.modal-body').html(confirmationMsg + '. This action cannot be undone.');
        }

    </script>
}