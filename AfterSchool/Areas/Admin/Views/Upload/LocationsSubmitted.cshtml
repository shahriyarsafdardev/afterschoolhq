@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var hasErrors = msgs.HasErrors();
    var buttonText = "Upload More";
    if(hasErrors)
    {
        buttonText = "Try Again";
    }
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Locations Submitted
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <form action="@Url.Action("index", "upload" )" method="get" enctype="multipart/form-data" class="form-horizontal">
                <div class="row">
                    <div class="col-md-6 col-md-offset-3">
                        <div class="panel-body">
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-lg btn-block">@buttonText</button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {

    });

    function uploadMore() {
        event.preventDefault();

    }

</script>