@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var importText = ViewBag.ImportText;
    var showSubmit = (bool)ViewBag.ShowSubmit;
    var step = (int)ViewBag.step;

    var url = Url.Action("index", "upload", new { step = (step + 1).ToString()});
    var buttonText = "Import CSV";

    if (showSubmit)
    {
        url = Url.Action("submitLocations", "upload", new { rows = ViewBag.Rows, headers = ViewBag.Headers });
        buttonText = "Confirm Upload";
    }

}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Upload Schools
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <form action="@url" method="post" enctype="multipart/form-data" class="form-horizontal">
                <div class="row">
                    <div class="col-md-6 col-md-offset-3">
                        <div class="panel-body">
                            <div class="form-group" id="csvfile-container">
                                <label for="csvfile">
                                    Import CSV
                                </label>
                                <input type="file" class="form-control" name="csvfile" id="csvfile"  />
                            </div>
                            @if (showSubmit)
                            {
                                <div class="form-group">
                                    <textarea readonly style="width:auto; height:30vh; white-space: pre-line;">@importText</textarea>
                                </div>
                            }
                        <div class="form-group">
                            <button type="submit"  class="btn btn-primary btn-lg btn-block">@buttonText</button>
                        </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {

    });

    function showImportText() {
        $('#importtext').removeClass('hide');
        $('#confirm-upload').removeClass('hide');
    }

    function navigateActivity(url) {
        $('#form1').attr('action', url);
    }

</script>