@model List<AfterSchoolLibrary.Registrant>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var importText = ViewBag.ImportText;
    var contactList = (ContactList)ViewBag.ContactList;
    var contactLists = (List<ContactList>)ViewBag.ContactLists;
    string[] importTextArray = importText.Split( new[] { Environment.NewLine }, StringSplitOptions.None);
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Upload Schools
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <form action="@Url.Action("index", "upload" )" method="post" enctype="multipart/form-data" class="form-horizontal">
                <div class="row">
                    <div class="col-md-6 col-md-offset-3">
                        <div class="panel-body">
                            <div class="form-group" id="csvfile-container">
                                <label for="csvfile">
                                    Import CSV
                                </label>
                                <input type="file" class="form-control" name="csvfile" id="csvfile" />
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-lg btn-block">Import CSV</button>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 col-md-offset-3">
                        <div class="panel-body">
                            <div class="form-group">
                                <textarea  readonly style="width:auto; height:30vh; white-space: pre-line;">@importText</textarea>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn btn-primary btn-lg btn-block">Confirm Upload</button>
                            </div>
                        </div>
                    </div>
                </div>  
            </form>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
     
    });

    function showImportText() {
        $('#importtext').removeClass('hide');
        $('#confirm-upload').removeClass('hide');
    }
</script>