@model WebUser
@{
    ViewBag.Title = "Invite Organization";
    ViewBag.Messages = ViewBag.Messages;
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", (SystemMessages)ViewBag.Messages); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-id"></i> Add Organization
        </div>

        <div class="panel-body">

            <div class="row">
                <div class="col-sm-6 col-sm-offset-3">
                    <p>
                        <i class="s7-check text-success"></i> 
                        
                        @if (Model.IsNotEmpty())
                        {
                            <span>Your invite has been sent successfully to @Model.Email.</span>
                        }
                        else
                        {
                            <span>The account has been added</span>
                        }
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>


