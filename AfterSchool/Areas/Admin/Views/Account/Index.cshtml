@model List<Account>
@{
    ViewBag.Title = "Accounts";
    var paging = (PagingModel)ViewBag.PagingModel;
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <a href="@Url.Action("invite", "account")" class="btn btn-primary btn-space pull-right">
                <i class="icon icon-left s7-plus"></i>
                Add Account
            </a>
            <i class="s7-id"></i> Accounts
        </div>

        <div class="panel-body">

            <div class="row padding-v-10">
                <div class="col-md-4">
                    <input type="text" id="search" name="search" value="@Request["search"]" class="form-control" placeholder="Enter Search Term..." />
                </div>
                <div class="col-md-4">
                    <select name="type" id="type" class="form-control">
                        <option value="">All Account Types</option>
                        @foreach(var item in Enum.GetValues(typeof(AccountType)).Cast<AccountType>().Where(accountType => accountType.NotIn(new AccountType[] { AccountType.AfterSchool, AccountType.NotSet })))
                        {
                            <option value="@((int)item)" @(Request["type"] == ((int)item).ToString() ? "selected=\"selected\"" : "")>
                                @item.ToString().SplitByUpperCase()
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">

                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped">
                    <tr>
                        <th></th>
                        <th>Account Name</th>
                        <th>Account #</th>
                        <th>Account Type</th>
                        <th>Is Test</th>
                        <th>Is Claimed</th>
                        <th>Is Active</th>
                        <th>Payments Connected</th>
                        <th>Member Since</th>
                        <th></th>
                    </tr>
                    @if (Model.Any())
                    {
                        foreach (var account in Model)
                        {
                            <tr>
                                <td>                                    
                                    <a href="@Url.Action("loginto", "account", new { id = account.Uid })" class="btn btn-primary btn-xs">
                                        <i class="icon icon-left s7-id"></i> 
                                        Login
                                    </a>
                                </td>
                                <td>@account.Name</td>
                                <td>@account.AccountNumber</td>
                                <td>@account.AccountTypeId.ToString().SplitByUpperCase()</td>
                                <td>@account.IsTest.ToYesNo()</td>
                                <td>@account.IsClaimed.ToYesNo()</td>
                                <td>@account.IsActive.ToYesNo()</td>
                                <td>@account.CanProcessPayments().ToYesNo()</td>
                                <td>@account.CreateDate.Value.ToLongDateString()</td>
                                <td>
                                    @if (account.GetMemberCount() == 0)
                                    {
                                        <a href="@Url.Action("invite", "account", new { id = account.Uid, pn = paging.PageNumber, rpp = paging.RecordsPerPage, search = Request["search"], type = Request["type"] })" class="btn btn-default btn-xs">
                                            Invite To Account
                                        </a> 
                                    } 
                                    else if (account.GetActiveMemberCount() == 0) 
                                    {
                                        <a href="@Url.Action("resendinvite", "account", new { id = account.Uid, pn = paging.PageNumber, rpp = paging.RecordsPerPage, search = Request["search"], type = Request["type"] })" class="btn btn-default btn-xs">
                                            Resend Invite
                                        </a>
                                    }

                                    <a href="@Url.Action("updateaccountstatus", "account", new { id = account.Uid, pn = paging.PageNumber, rpp = paging.RecordsPerPage, search = Request["search"], type = Request["type"] })" class="btn btn-xs @($"{(account.IsActive ? "btn-warning" : "btn-info" )}")">
                                        @($"{(account.IsActive ? "Deactivate" : "Activate" )}")
                                    </a>

                                    <a href="@Url.Action("updateaccountclaims", "account", new { id = account.Uid, pn = paging.PageNumber, rpp = paging.RecordsPerPage, search = Request["search"], type = Request["type"] })" class="btn @($"{(account.IsClaimed ? "btn-default" : "btn-info" )}") btn-xs">
                                        @($"{(!account.IsClaimed ? "Mark as Claimed" : "Mark as UnClaimed")}")
                                    </a>
                                    
                                    <a href="#" class="btn btn-danger btn-xs md-trigger" data-modal="modal-confirm-account-deletion-@account.Uid">
                                        Delete
                                    </a>

                                    @{
                                        Html.RenderPartial("~/Views/Shared/_Modal.cshtml", new ModalViewModel()
                                        {
                                            ActionButtonHtml = "Delete &raquo;",
                                            ActionButtonId = $"btn-confirm-account-deletion-{account.Uid}",
                                            HtmlBody = "<p>Are you sure you want to delete this account? </p>",
                                            ID = $"modal-confirm-account-deletion-{account.Uid}",
                                            Title = "Are you sure?",
                                        });
                                    }

                                     <a href="@Url.Action("UpdateAccountTestFlagStatus", "account", new { id = account.Uid, pn = paging.PageNumber, rpp = paging.RecordsPerPage, search = Request["search"], type = Request["type"] })" class="btn btn-xs @($"{(account.IsTest ? "btn-success" : "btn-info" )}")">
                                        @($"{(account.IsTest ? "Unset as Test" : "Set as Test")}")
                                    </a>

                                <script>
                                    PageEvent.add(PageEvent.AFTER_INIT, function () {
                                            $('#btn-confirm-account-deletion-@account.Uid').click(function () {
                                                location.href = '@Url.Action("deleteaccount", "account", new { id = account.Uid, pn = paging.PageNumber, rpp = paging.RecordsPerPage, search = Request["search"], type = Request["type"] })';
                                            });
                                        });
                                </script>   
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">There are no accounts. Please <a href="/account/edit/">add a new account</a></td>
                        </tr>
                    }
                </table>
            </div>

            @{Html.RenderPartial(
                      "~/Views/Shared/_Paging.cshtml",
                      paging,
                      new ViewDataDictionary()
                      {
                        { "id", "" },
                        { "action", "index" },
                        { "controller", "account" },
                        { "querystring", $"search={Request["search"]}&type={Request["type"]}" }
                      }
                  );
            }
        </div>
    </div>
</div>

<script>
    function doSearch() {
        location.href = `@Url.Action("index", "account")?search=${$('#search').val()}&type=${$('#type').val()}`;
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#type').change(function () {
            doSearch();
        });

        $('#search').keypress(function (e) {
            if (e.keyCode == 13 || e.keyCode == 10) {
                doSearch();
            }
        });
    });
</script>
