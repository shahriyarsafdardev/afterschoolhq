@model List<AfterSchoolLibrary.Account>
@{
    ViewBag.Title = "Accounts";
    var paging = (PagingModel)ViewBag.PagingModel;

}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    <div class="panel panel-default">

        <div class="panel-heading">
            <a href="@Url.Action("invite", "account")" class="btn btn-primary btn-space pull-right">
                <i class="icon icon-left s7-plus"></i>
                Invite Account
            </a>
            <i class="s7-id"></i> Accounts
        </div>

        <div class="panel-body">

            <div class="row padding-v-10">
                <div class="col-md-4">
                    <input type="text" id="search" name="search" value="@Request["search"]" class="form-control" placeholder="Enter Search Term..." />
                </div>
                <div class="col-md-4">
                    <select name="type" id="type" class="form-control">
                        <option value="">All Account Types</option>
                        @foreach(var item in Enum.GetValues(typeof(AccountType)).Cast<AccountType>().Where(accountType => accountType.NotIn(new AccountType[] { AccountType.AfterSchool, AccountType.NotSet })))
                        {
                            <option value="@((int)item)" @(Request["type"] == ((int)item).ToString() ? "selected=\"selected\"" : "")>
                                @item.ToString().SplitByUpperCase()
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-4">

                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-striped">
                    <tr>
                        <th></th>
                        <th>Account Name</th>
                        <th>Account #</th>
                        <th>Account Type</th>
                        <th>Is Active</th>
                        <th>Member Since</th>
                        <th></th>
                    </tr>
                    @if (Model.Any())
                    {
                        foreach (var account in Model)
                        {
                            <tr>
                                <td>
                                    @if (account.GetActiveUserCount() > 0)
                                    {
                                        <a href="@Url.Action("impersonate", "user", new { id = account.ID })" class="btn btn-primary btn-xs"><i class="icon icon-left s7-id"></i> View</a>
                                    }
                                </td>
                                <td>@account.Name</td>
                                <td>@account.AccountNumber</td>
                                <td>@account.AccountTypeId.ToString().SplitByUpperCase()</td>
                                <td>@account.IsActive.ToYesNo()</td>
                                <td>@account.CreateDate.Value.ToLongDateString()</td>
                                <td>
                                    @if (account.GetUserCount() == 0)
                                    {
                                        <a href="@Url.Action("invite", "account", new { id = account.Uid })" class="btn btn-default btn-sm">
                                            Invite To Account
                                        </a>
                                    }
                                    else if (account.GetActiveUserCount() == 0)
                                    {
                                        <a href="@Url.Action("resendinvite", "account", new { id = account.Uid })" class="btn btn-default btn-sm">
                                            Resend Invite
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">There are no accounts. Please <a href="/account/edit/">add a new account</a></td>
                        </tr>
                    }
                </table>
            </div>

            @{Html.RenderPartial(
                      "~/Views/Shared/_Paging.cshtml",
                      paging,
                      new ViewDataDictionary()
                      {
                        { "id", "" },
                        { "action", "index" },
                        { "controller", "account" },
                        { "querystring", $"search={Request["search"]}&type={Request["type"]}" }
                      }
                  );
            }
        </div>
    </div>
</div>

<script>
    function doSearch() {
        location.href = `@Url.Action("index", "account")?search=${$('#search').val()}&type=${$('#type').val()}`;
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#type').change(function () {
            doSearch();
        });

        $('#search').keypress(function (e) {
            if (e.keyCode == 13 || e.keyCode == 10) {
                doSearch();
            }
        });
    });
</script>
