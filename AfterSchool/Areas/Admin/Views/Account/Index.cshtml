@model List<AfterSchoolLibrary.Account>
@{
    ViewBag.Title = "Accounts";
    var paging = (PagingModel)ViewBag.PagingModel;

}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    <div class="panel panel-default">

        <div class="panel-heading">
            <a href="@Url.Action("invite", "account")" class="btn btn-primary btn-space pull-right">
                <i class="icon icon-left s7-plus"></i>
                Invite Account
            </a>
            <i class="s7-id"></i> Accounts
        </div>

        <div class="panel-body">

            <div class="table-responsive">
                <table class="table table-striped">
                    <tr>
                        <th></th>
                        <th>Account Name</th>
                        <th>Account #</th>
                        <th>Account Type</th>
                        <th>Is Active</th>
                        <th>Member Since</th>
                        <th></th>
                    </tr>
                    @if (Model.Any())
                    {
                        foreach (var account in Model)
                        {
                            <tr>
                                <td>
                                    @if (account.GetUserCount() > 0)
                                    {
                                        <a href="@Url.Action("impersonate", "user", new { id = account.ID })" class="btn btn-primary btn-xs"><i class="icon icon-left s7-id"></i> View</a>
                                    }
                                </td>
                                <td>@account.Name</td>
                                <td>@account.AccountNumber</td>
                                <td>@account.AccountTypeId.ToString()</td>
                                <td>@account.IsActive.ToYesNo()</td>
                                <td>@account.CreateDate.Value.ToLongDateString()</td>
                                <td>
                                    @if (account.GetUserCount() == 0)
                                    {
                                        <a href="@Url.Action("invite", "account", new { id = account.Uid })" class="btn btn-default btn-sm">Invite To Account</a>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4">There are no accounts. Please <a href="/account/edit/">add a new account</a></td>
                        </tr>
                    }
                </table>
            </div>


            @{Html.RenderPartial(
                      "~/Views/Shared/_Paging.cshtml",
                      paging,
                      new ViewDataDictionary()
                      {
                        { "id", "" },
                        { "action", "index" },
                        { "controller", "account" }
                      }
                  );
            }
        </div>
    </div>
</div>


