@model AfterSchoolLibrary.Account
@{
    ViewBag.Title = Model.Name;
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

@{Html.RenderPartial("AdminAccountHeader", Model.ID.ToString());}

<div class="main-content">
    
    @Html.Raw(UI.RenderMessagesToHtml(msgs))

    <div class="panel panel-default">
        <div class="panel-heading">
            <i class="s7-credit"></i> Stripe Integration
        </div>
        <div class="panel-body">
            <p>If you want to accept payments for your activities, please connect your account with Stripe</p>
        </div>
    </div>
</div>
