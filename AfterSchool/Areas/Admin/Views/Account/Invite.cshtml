@{
    ViewBag.Title = "Invite Organization";

    var account = (Account)ViewBag.Account;
    var packages = (List<Package>)ViewBag.Packages;
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", (SystemMessages)ViewBag.Messages); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-id"></i> Add Organization
        </div>

        <div class="panel-body">

            <form class="form-horizontal" id="invitation-form" method="post" action="@Url.Action("invite", "account", new { id = account?.Uid })">

                <div class="row">
                    <div class="col-sm-6 col-sm-offset-3">
                        <h3>Organization</h3>
                        <hr />
                    </div>
                </div>

                @if (account.IsNotEmpty())
                {
                    <div class="form-group">
                        <div class="col-sm-3 control-label">
                            Organization
                        </div>
                        <div class="col-sm-6">
                            @account.Name
                        </div>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <div class="col-sm-3 control-label">
                            Organization Name
                        </div>
                        <div class="col-sm-6">
                            <input type="text" maxlength="50" name="orgname" id="orgname" class="form-control" value="@Request["orgname"]" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-3 control-label">
                            Organization Type
                        </div>
                        <div class="col-sm-6">
                            <select name="accounttype" id="accounttype" class="form-control">
                                <option value="">Select...</option>
                                @foreach (var item in Enum.GetValues(typeof(AccountType)).Cast<AccountType>().OrderBy(x => x.ToString()))
                                {
                                    if (item != AccountType.AfterSchool && item != AccountType.NotSet)
                                    {
                                        <option value="@((int)item)" @(Request["accounttype"] == ((int)item).ToString() ? "selected=\"selected\"" : "")>
                                            @item.ToString().SplitByUpperCase()
                                        </option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="col-sm-3 control-label">Time Zone</label>
                        <div class="col-sm-6">
                            @{ Html.RenderPartial("~/Views/Shared/Components/_TimezoneDropdown.cshtml", Request["timezone"]); }
                        </div>
                    </div>
                }
                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        Package
                    </div>
                    <div class="col-sm-6">
                        <select name="package" id="package" class="form-control">
                            <option value="">Select...</option>
                            @foreach (var item in packages)
                            {
                                <option value="@item.ID" @(Request["package"] == item.ID.ToString() ? "selected=\"selected\"" : "")>
                                    @item.Name
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <div class="col-sm-3 control-label">
                        Billing Period
                    </div>
                    <div class="col-sm-6">
                        <select name="billingperiod" id="billingperiod" class="form-control">
                            <option value="">Select...</option>
                            <option value="@((int)BillingPeriodType.Month)"
                                    @(Request["billingperiod"] == ((int)BillingPeriodType.Month).ToString() ? "selected=\" selected\"" : "" )>
                                Per @BillingPeriodType.Month.ToString().SplitByUpperCase()
                            </option>
                            <option value="@((int)BillingPeriodType.Year)"
                                    @(Request["billingperiod"] == ((int)BillingPeriodType.Year).ToString() ? "selected=\"selected\"" : "")>
                                Per @BillingPeriodType.Year.ToString().SplitByUpperCase()
                            </option>
                        </select>
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Is Test Account</label>
                    <div class="col-sm-6">
                        @{ Html.RenderPartial(
                             "~/Views/Shared/_SwitchButton.cshtml",
                             false,
                             new ViewDataDictionary() { { "checkboxname", "istest" }, { "checkboxid", "istest" } });
                        }
                    </div>
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label">Is Unclaimed</label>
                    <div class="col-sm-6">
                        @{ Html.RenderPartial(
                             "~/Views/Shared/_SwitchButton.cshtml",
                             false,
                             new ViewDataDictionary() { { "checkboxname", "isunclaimed" }, { "checkboxid", "isunclaimed" } });
                        }
                    </div>
                </div>

                 <div id="divClaimEmailDomain" class="form-group hide">
                    <div class="col-sm-3 control-label">
                        Claim Email Domain
                    </div>
                    <div class="col-sm-6">
                        <input id="txtClaimEmailDomain" name="claimemaildomain" type="text" maxlength="50"  class="form-control" value="@Request["claimemaildomain"]" />
                    </div>
                </div>

                <div id="personal-info">
                    <div class="row">
                        <div class="col-sm-6 col-sm-offset-3">
                            <h3>Personal Details</h3>
                            <hr />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-3 control-label">
                            First Name
                        </div>
                        <div class="col-sm-6">
                            <input type="text" maxlength="50" name="firstname" id="firstname" class="form-control" value="@Request["firstname"]" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-3 control-label">
                            Last Name
                        </div>
                        <div class="col-sm-6">
                            <input type="text" maxlength="50" name="lastname" id="lastname" class="form-control" value="@Request["lastname"]" />
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-sm-3 control-label">
                            Email
                        </div>
                        <div class="col-sm-6">
                            <input type="text" maxlength="50" name="email" id="email" class="form-control" value="@Request["email"]" />
                        </div>
                    </div>                   
                </div>

                <div class="form-group">
                    <label class="col-sm-3 control-label"></label>
                    <div class="col-sm-6">
                        <button type="reset" class="btn btn-default" onclick="location.href='@Url.Action("index", "account")'">Cancel</button>
                        <button type="submit" id="submit-btn" class="btn btn-primary pull-right"><i class="s7-paper-plane"></i> <span id="btn-add-account-text">Send Invite</span></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $("#invitation-form").submit(function (e) {
            //disable the submit button
            $("#submit-btn").attr("disabled", true);
        });

        $('#isunclaimed').click(toggleIsUnclaimed);
    });

    function toggleIsUnclaimed() {
        if ($('#isunclaimed').is(':checked')) {
            $('#personal-info').addClass('hide');            
            $('#btn-add-account-text').html('Add Account');
            $('#divClaimEmailDomain').removeClass('hide');            
        } else {
            $('#personal-info').removeClass('hide');            
            $('#btn-add-account-text').html('Send Invite');
            $('#divClaimEmailDomain').addClass('hide');
        }
    }
</script>


