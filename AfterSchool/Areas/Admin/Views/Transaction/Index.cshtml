@model List<Transaction>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var transactionCount = ((PagingModel)ViewBag.PagingModel).TotalCount;
    var totalTransactionAmount = (decimal)ViewBag.TotalAmountPaid;
    var avgTransactionAmount = transactionCount == 0 ? 0 : totalTransactionAmount / transactionCount;
    var totalRefunded = (decimal)ViewBag.TotalRefunded;
    var totalFees = (decimal)ViewBag.TotalFeesPaid;
    var totalPayout = totalTransactionAmount - totalFees - totalRefunded;
    var totalProfit = (decimal)ViewBag.TotalProfit;
    var accounts = (List<Account>)ViewBag.Accounts;
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("_TransactionsHeader"); }

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Transactions
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">

            <div class="row">
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "startdate",
                                Name = "startdate",
                                Value = Request["sdate"],
                                Placeholder = "From Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "enddate",
                                Name = "enddate",
                                Value = Request["edate"],
                                Placeholder = "To Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-primary btn-lg" onclick="search()">Search</button>
                </div>
            </div>

            <div class="row">

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalTransactionAmount" id="totalTransactionAmount" data-decimals="2" data-suffix="" class="value">@totalTransactionAmount.ToCurrency()</div>
                            <div class="desc">Total Amt Paid</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@transactionCount" id="transactionCount" data-decimals="0" data-suffix="" class="value">@transactionCount</div>
                            <div class="desc">Total Transactions</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@avgTransactionAmount" id="avgTransactionAmount" data-decimals="2" data-suffix="" class="value">@avgTransactionAmount.ToCurrency()</div>
                            <div class="desc">Avg Transaction Amt</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalFees" id="totalPayout" data-decimals="2" data-suffix="" class="value">@totalFees.ToCurrency()</div>
                            <div class="desc">Total Fees</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalProfit" id="totalProfit" data-decimals="2" data-suffix="" class="value">@totalProfit.ToCurrency()</div>
                            <div class="desc">Total Profit</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalPayout" id="totalPayout" data-decimals="2" data-suffix="" class="value">@totalPayout.ToCurrency()</div>
                            <div class="desc">Total For Providers</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <script>
                    function search() {
                        window.location.href = `@Url.Action("index", "transaction")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}`;
                    }
                </script>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <button type="button"
                            class="btn btn-primary md-trigger" 
                            data-modal="modal-create-transaction">
                        Create Transaction
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Created On</th>
                            <th>Biller</th>
                            <th>Payer</th>
                            <th>Item Description</th>
                            <th class="text-center">Amount</th>
                            <th class="text-center">Conv Fee</th>
                            <th class="text-center">Trans Fee</th>
                            <th class="text-center">Stripe Fee</th>
                            <th class="text-center">Payout Amount</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Type</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var transaction in Model)
                            {
                                var currentStatus = transaction.GetStatus();
                                var billerAccount = transaction.GetBillerAccount();
                                var payerAccount = transaction.GetPayerAccount();
                                var payerAmount = transaction.GetPayerAmount();
                                var useStripeConnect = billerAccount.HasFeature(FeatureType.UseStripeConnectedAccount);
                                var enableTransfer = !transaction.UsedStripeConnect && !transaction.PayoutId.HasValue && useStripeConnect && billerAccount.StripePayoutsEnabled;
                                
                                <tr id="row-@transaction.Uid">
                                    <td>
                                        @transaction.GetTransactionNumber()
                                    </td>
                                    <td>
                                        @transaction.CreateDate.ToShortDateTimeString()
                                    </td>
                                    <td>
                                        @billerAccount.Name
                                    </td>
                                    <td>
                                        @payerAccount.Name
                                    </td>
                                    <td>
                                        @transaction.Description
                                    </td>
                                    <td class="text-center">
                                        @(transaction.IsRefund() ? "-" : "")@payerAmount.ToCurrency()
                                    </td>
                                    @if (transaction.PaymentSourceTypeId == PaymentSourceType.AfterSchoolPlatform)
                                    {
                                        if (transaction.IsCharge())
                                        {
                                            <td class="text-center">
                                                @transaction.ConvenienceFeeCharged.ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                @transaction.PaymentTypeFeeCharged.ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                @transaction.GetStripeFee().ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                @transaction.GetBillerPayout().ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                @if (transaction.HasRefunds())
                                                {
                                                    @:Refunded
                                                }
                                                else
                                                {
                                                    @currentStatus
                                                }
                                            </td>
                                        }
                                        else if (transaction.IsRefund())
                                        {
                                            <td class="text-center">
                                                -@transaction.ConvenienceFeeCharged.ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                -@transaction.PaymentTypeFeeCharged.ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                - @* NEED TO CALCULATE THIS, but can figure out later *@
                                            </td>
                                            <td class="text-center">
                                                -@transaction.GetBillerPayout().ToCurrency()
                                            </td>
                                            <td class="text-center">
                                                @if (transaction.HasRefunds())
                                                {
                                                    @:Refunded
                                                }
                                                else
                                                {
                                                    @currentStatus
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="text-center">-</td>
                                            <td class="text-center">-</td>
                                            <td class="text-center">-</td>
                                            <td class="text-center">-</td>
                                            <td class="text-center">-</td>
                                        }
                                    }
                                    else
                                    {
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                        <td class="text-center">-</td>
                                    }
                                    <td class="text-center">
                                        @transaction.PaymentTypeId.ToString().SplitByUpperCase()
                                    </td>
                                    <td>
                                        <div class="btn-group">
                                            <button onclick="setTransaction('@transaction.Uid', '@transaction.GetTransactionNumber()', '@transaction.Amount.ToCurrency()')"
                                                    class="md-trigger btn btn-sm btn-alt6"
                                                    data-modal="modal-refund"
                                                    @(!transaction.HasRefundableAmount(true) ? "disabled=\"disabled\"" : "")>
                                                <i class="s7-back"></i>
                                            </button>

                                            @if (enableTransfer)
                                            {
                                                Html.RenderPartial("~/Views/Shared/Modals/_TransferModal-TransferButton.cshtml", transaction);
                                            }

                                            <button onclick="setTransaction('@transaction.Uid', '@transaction.GetTransactionNumber()')"
                                                    class="md-trigger btn btn-sm btn-danger"
                                                    data-modal="modal-delete">
                                                <i class="s7-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10">There are no transactions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                Html.RenderPartial(
                    "~/Views/Shared/_Paging.cshtml",
                    (PagingModel)ViewBag.PagingModel,
                    new ViewDataDictionary()
                    {
                    { "controller", "transaction" },
                    { "action", "index" },
                    { "querystring", $"sdate={Request["sdate"]}&edate={Request["edate"]}&poId={Request["poId"]}&poTypeId={Request["poTypeId"]}" }
}
                );
            }
        </div>
    </div>
</div>

<div id="modal-delete" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Mark as Deleted?</h3>
        </div>
        <div class="modal-body form">
            <div class="form-group">
                Are you sure you want to delete transaction <strong><span class="transaction-id"></span></strong> and related payments?
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" id="confirm-delete-btn" data-dismiss="modal" onclick="deleteTransaction()" class="btn btn-danger md-close">
                Delete Transaction &raquo;
            </button>
        </div>
    </div>
</div>

<div id="modal-refund" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Refund?</h3>
        </div>
        <div class="modal-body form">
            <div class="form-group">
                <p>
                    Are you sure you want to refund transaction <strong><span class="transaction-id"></span></strong> for the amount of <strong><span class="transaction-amount"></span></strong>?
                </p>
                <p>
                    This cannot be undone
                </p>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" id="confirm-delete-btn" data-dismiss="modal" onclick="refundTransaction()" class="btn btn-primary md-close">
                Refund Transaction &raquo;
            </button>
        </div>
    </div>
</div>

<div id="modal-create-transaction" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Create Transaction</h3>
        </div>
        <div class="modal-body form">
            <div class="form-group">
                <label>Account</label>
                <select class="form-control" id="create-transaction-account">
                    <option value="">Select...</option>
                    @foreach (var account in accounts)
                    {
                        <option value="@account.Uid">@account.AccountNumber - @account.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Amount</label>
                <input type="number" value="1.00" id="create-transaction-amount" class="form-control" step=".01" max="1000" min="1" />
            </div>
            <div class="form-group">
                <label>Transaction Type</label>
                <select class="form-control" id="create-transaction-type">
                    <option value="">Select...</option>
                    <option value="@((int)TransactionType.Credit)">@TransactionType.Credit.ToString()</option>
                    <option value="@((int)TransactionType.Debit)">@TransactionType.Debit.ToString()</option>
                </select>
            </div>
            <div class="form-group">
                <label>Note</label>
                <input type="text" value="" id="create-transaction-note" class="form-control" maxlength="400" />
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" id="confirm-create-transaction-btn" data-dismiss="modal" onclick="createTransaction()" class="btn btn-primary md-close">
                Create Transaction &raquo;
            </button>
        </div>
    </div>
</div>

@{ Html.RenderPartial(
        "~/Views/Shared/Modals/_TransferModal.cshtml",
        null,
        new ViewDataDictionary
        {
           { "controller", "transaction" },
           { "action", "createtransfer" },
           { "area", "admin" }
        });
}

<script>
    var transactionUid = null;

    function setTransaction(uid, id, amount) {
        transactionUid = uid;
        $('.transaction-id').html(id);
        $('.transaction-amount').html(amount);
    }

    function createTransaction() {

        var validated = true;

        if ($('#create-transaction-account').val().length == 0)
            validated = false;

        if (isNaN($('#create-transaction-amount').val()))
            validated = false;

        if (isNaN($('#create-transaction-type').val()))
            validated = false;

        if ($('#create-transaction-note').val().length == 0)
            validated = false;

        if (validated) {

            var accountUid = $('#create-transaction-account').val();
            var amount = $('#create-transaction-amount').val();
            var transactionType = $('#create-transaction-type').val();
            var note = $('#create-transaction-note').val();

            var parameters = `accountuid=${accountUid}&amount=${amount}&transactionType=${transactionType}&note=${encodeURIComponent(note)}`;

            $.post(
                '@Url.Action("create", "transaction")',
                parameters,
                function (data) {
                    if (data && data.status == 'ok') {
                        Notifications.showMessage('Success', 'Transaction has been created', true)

                        setTimeout(function () {
                            location.reload();
                        }, 500);

                    } else {
                        Notifications.showErrors(data.messages);
                    }
                }
            )

        }

    }

    function deleteTransaction() {
        $.get(
            '@Url.Action("delete", "transaction")/' + transactionUid,
            function (data) {
                if (data && data.status == 'ok') {

                    $('#row-' + transactionUid).addClass('hide');
                    Notifications.showMessage('Success', 'Transaction has been deleted', true)

                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }

    function refundTransaction() {
        $.get(
            '@Url.Action("refund", "transaction")/' + transactionUid,
            function (data) {
                if (data && data.status == 'ok') {

                    Notifications.showMessage('Success', 'Transaction has been refunded', true)

                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        );
    }

</script>
