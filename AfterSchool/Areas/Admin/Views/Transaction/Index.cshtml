@model List<Transaction>
@{
    var msgs = (SystemMessages)ViewBag.Messages;
    var transactionCount = ((PagingModel)ViewBag.PagingModel).TotalCount;
    var totalTransactionAmount = (decimal)ViewBag.TotalAmountPaid;
    var avgTransactionAmount = transactionCount == 0 ? 0 : totalTransactionAmount / transactionCount;
    var totalFees = (decimal)ViewBag.TotalFeesPaid;
    var totalPayout = totalTransactionAmount - totalFees;
    var totalProfit = (decimal)ViewBag.TotalProfit;
}

@{ Html.RenderPartial("AdminHeader"); }

<div class="main-content">

    @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

    <div class="panel panel-default">

        <div class="panel-heading">
            <i class="s7-note2"></i> Transactions
            <div class="clearfix"></div>
        </div>

        <div class="panel-body">
            <div class="row">

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalTransactionAmount" id="totalTransactionAmount" data-decimals="2" data-suffix="" class="value">@totalTransactionAmount.ToCurrency()</div>
                            <div class="desc">Total Amt Paid</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@transactionCount" id="transactionCount" data-decimals="0" data-suffix="" class="value">@transactionCount</div>
                            <div class="desc">Total Transactions</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@avgTransactionAmount" id="avgTransactionAmount" data-decimals="2" data-suffix="" class="value">@avgTransactionAmount.ToCurrency()</div>
                            <div class="desc">Avg Transaction Amt</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalFees" id="totalPayout" data-decimals="2" data-suffix="" class="value">@totalFees.ToCurrency()</div>
                            <div class="desc">Total Fees</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalProfit" id="totalProfit" data-decimals="2" data-suffix="" class="value">@totalProfit.ToCurrency()</div>
                            <div class="desc">Total Profit</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="widget widget-tile widget-bordered">
                        <div class="data-info">
                            <div data-toggle="counter" data-end="@totalPayout" id="totalPayout" data-decimals="2" data-suffix="" class="value">@totalPayout.ToCurrency()</div>
                            <div class="desc">Total For Providers</div>
                        </div>
                        <div class="icon"><span class=""></span></div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "startdate",
                                Name = "startdate",
                                Value = Request["sdate"],
                                Placeholder = "From Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-2">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Components/_Date.cshtml",
                            new FormInputViewModel()
                            {
                                Id = "enddate",
                                Name = "enddate",
                                Value = Request["edate"],
                                Placeholder = "To Date"
                            }
                        );
                    }
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-primary btn-lg" onclick="search()">Search</button>
                    <button type="button" class="btn btn-primary btn-lg hide" onclick="DownloadToCSV()">Export To CSV</button>
                </div>

                <script>
                    function search() {
                        window.location.href = `@Url.Action("index", "transaction")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}`;
                    }
                    function DownloadToCSV() {
                         window.location.href = `@Url.Action("DownloadCSV", "transaction")?sdate=${encodeURIComponent($('#startdate').val())}&edate=${encodeURIComponent($('#enddate').val())}`;
                    }

                </script>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-condensed" id="transaction-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Created On</th>
                            <th>Biller</th>
                            <th>Payer</th>
                            <th>Item Description</th>
                            <th class="text-center">Total Amt Paid</th>
                            <th class="text-center">Platform Fee</th>
                            <th class="text-center">Payout Amount</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Type</th>
                            @*<th>Refund</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count > 0)
                        {
                            foreach (var transaction in Model)
                            {
                                var purchase = transaction.GetPurchase();
                                var registrant = Registrant.Load(purchase.RegistrantId.Value);
                                var participationObjects = transaction.GetParticipationObjects();
                                var currentStatus = transaction.GetStatus();
                                var disableChk = !transaction.CanRequestPayout() ? "disabled" : "";

                                <tr id="@transaction.Uid" data-refunded-amount="@transaction.GetRefundedAmount().ToCurrency()">
                                    <td>
                                        @transaction.GetTransactionNumber()
                                    </td>
                                    <td>
                                        @transaction.CreateDate.ToShortDateTimeString()
                                    </td>
                                    <td>
                                        @transaction.GetBillerAccount().Name
                                    </td>
                                    <td>
                                        @transaction.GetPayerAccount().Name
                                    </td>
                                    <td>
                                        @participationObjects.DistinctBy(po => new { po.ObjectID, po.ObjectType }).Select(po => po.Name).ToStringList(", ")
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetPayerAmount().ToCurrency()
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetFeesChargedToPayer().ToCurrency()
                                    </td>
                                    <td class="text-center">
                                        @transaction.GetBillerPayout().ToCurrency()
                                    </td>
                                    <td class="text-center">
                                        @currentStatus
                                    </td>
                                    <td class="text-center">
                                        @transaction.PaymentTypeId.ToString().SplitByUpperCase()
                                    </td>
                                    @*<td>
                                    @if (transaction.IsCharge() && !transaction.IsTotallyRefunded())
                                    {
                                        <button onclick="openDialog('@transaction.Uid')"
                                                class="md-trigger"
                                                data-modal="modal-refund">
                                            Refund
                                        </button>
                                    }
                                </td>*@
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">There are no transactions</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @{
                Html.RenderPartial(
                    "~/Views/Shared/_Paging.cshtml",
                    (PagingModel)ViewBag.PagingModel,
                    new ViewDataDictionary()
                    {
                    { "controller", "transaction" },
                    { "action", "index" },
                    { "querystring", $"sdate={Request["sdate"]}&edate={Request["edate"]}&poId={Request["poId"]}&poTypeId={Request["poTypeId"]}" }
}
                );
            }
        </div>
    </div>
</div>

<div id="modal-refund" class="md-modal colored-header custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Refund</h3>
        </div>
        <div class="modal-body form">
            <div class="form-group">
                <div class="col-sm-5">
                    <div class="input-group input-group-lg xs-mb-15">
                        <span>Amount refunded: </span>
                        <span id="refunded-amount" style="color: red"></span>
                    </div>
                    <div class="input-group input-group-lg xs-mb-15">
                        <span class="input-group-addon">$</span>
                        <input type="number" onblur="validateForm()" onchange="validateForm()" class="form-control" id="amount" placeholder="amount" required min="0.1" step="0.1" />
                    </div>
                </div>

                <div class="col-sm-7">
                </div>
            </div>
            <br />
            <div class="form-group">
                <div class="col-sm-12">
                    <h5 style="margin-left: 50px"><b style="color: #ef6262">This is not reversable!</b></h5>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <button type="button" id="confirm-refund-btn" disabled data-dismiss="modal" onclick="confirmRefund()" class="btn btn-primary md-close">Refund</button>
        </div>
    </div>
</div>


<script>
     var selectedTransactions = [];
     function validateForm() {
        var val = parseFloat($("#amount").val());
        var isValid = val >= 0.1;

        $("#confirm-refund-btn").attr('disabled', !isValid);
     }

    function requestPayout() {
        $("#TransactionIds").val(this.selectedTransactions.join());
        $("#requestPayoutForm").submit();
    }

    function openDialog(newUid) {
        $("#modal-refund").data("uid", newUid);
        $("#refunded-amount").text($("#" + newUid).data('refunded-amount'));
    }

      function selectTransaction(id, event) {
        if (event.checked) {
            this.selectedTransactions.push(id);
        }
        else {
            var index = this.selectedTransactions.map(x => {
                    return x;
                }).indexOf(id);
            this.selectedTransactions.splice(index, 1);
        }
        if (this.selectedTransactions.length > 0)
            $("#request-payout").attr("disabled", false);
        else
            $("#request-payout").attr("disabled", true);
    }

    function selectAllTransaction(event) {
        var allChkBoxes = $(".chkTransaction");
        allChkBoxes.map(function (e) {
            if (event.checked) {
                if ($(this).prop("checked") == false)
                    this.click();
               }
             else {
                if ($(this).prop("checked") == true)
                    this.click();
              }
           })
    }

    function confirmRefund() {
        var amount = $("#amount").val();

        if (!!amount) {
            var uid = $("#modal-refund").data("uid");

            $.post(
                "@Url.Action("refund", "Accounting")",
                { uid: uid, amount: amount },
                function (data) {
                    if (data.status === "ok") {
                        var transaction = data.transaction;

                        // update the page header
                        var transactionNumber = parseInt($("#transactionCount").data("end")) + 1;
                        var totalTransactionAmount = (parseFloat($("#totalTransactionAmount").data("end")) + parseFloat(transaction.totalPaid)).toFixed(2);
                        var totalPayout = (parseFloat($("#totalPayout").data("end")) + parseFloat(transaction.payout)).toFixed(2);
                        var avgTransactionAmount = (totalTransactionAmount / transactionNumber).toFixed(2);

                        $("#transactionCount").data("end", transactionNumber);
                        $("#transactionCount").text(transactionNumber);
                        $("#avgTransactionAmount").data("end", avgTransactionAmount);
                        $("#avgTransactionAmount").text("$" + avgTransactionAmount);
                        $("#totalTransactionAmount").data("end", totalTransactionAmount);
                        $("#totalTransactionAmount").text("$" + totalTransactionAmount);
                        $("#totalPayout").data("end", totalPayout);
                        $("#totalPayout").text("$" + totalPayout);
                        $("#" + transaction.originalTransactionUid).data('refunded-amount', "$"+ data.refundedAmount.toFixed(2));

                        // update the transaction table
                        $("#transaction-table tr:first").after('<tr>' +
                            '<td>' + transaction.id + '</td>' +
                            '<td>' + transaction.createdOn + '</td>' +
                            '<td>' + transaction.payer + '</td>' +
                            '<td>' + transaction.refundFor + '</td>' +
                            '<td>' + transaction.itemDescription + '</td>' +
                            '<td>-$' + (-transaction.totalPaid).toFixed(2) + '</td>' +
                            '<td>$' + transaction.platformFee.toFixed(2) + '</td>' +
                            '<td>-$' + (-transaction.payout).toFixed(2) + '</td>' +
                            '<td></td>' +
                            '</tr>'
                        );
                        Notifications.showBar({
                            title: 'Success',
                            message: `<strong>Successful operation!</strong>`,
                            success: true
                        });
                    } else {
                        var items = "";
                        for (var message of data.messages) {
                            items += "<li>" + message.Text + "</li>";
                        }

                        Notifications.showBar({
                            title: 'Error',
                            message: '<ul>' + items + '</ul>',
                            success: false
                        });
                    }
                },
                "json"
            );
        }
    }
</script>
