@using AfterSchoolLibrary.Services;
@using BasicLibrary;
@using AfterSchoolLibrary.Models;
@model List<(ParticipationObject ParticipationObject, decimal? BillerAmount, decimal? FeesChargedToBiller, decimal? BillerPayout)>
@{
    Layout = "../Shared/Layouts/_FullScreenLob.cshtml";
    ViewBag.Title = "Payout Breakdown";
}
    <div>
        <div class="row">
            <h2 class="col-md-2">"Payout Breakdown</h2>
        </div>
        <div class="table-responsive">
            <table class="table table-hover table-condensed" id="transaction-table">
                <thead>
                    <tr>
                        <th>Activity</th>
                        <th class="text-center">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var groupedTransaction in Model)
                    {
                        <tr id="@groupedTransaction.ParticipationObject.Uid">
                            <td>
                                @groupedTransaction.ParticipationObject.Name
                            </td>
                            <td class="text-right">
                                @groupedTransaction.BillerPayout.ToCurrency()
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="text-right"><strong>Total: </strong></td>
                        <td class="text-right"><strong>@ViewBag.TotalPayout</strong></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

