  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5.2" />
      </system.Web>
  -->
  <system.web>
    <sessionState timeout="480" mode="Custom" customProvider="DynamoDBSessionStoreProvider">
      <providers>
        <add name="DynamoDBSessionStoreProvider" type="Amazon.SessionProvider.DynamoDBSessionStateStore" Table="ASP.NET_SessionState" AWSAccessKey="AKIAJVP454LES3BB24NA" AWSSecretKey="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" Region="us-east-2" />
      </providers>
    </sessionState>
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.7.2">
      <assemblies>
        <add assembly="netstandard, Version=2.0.0.0, Culture=neutral, PublicKeyToken=cc7b13ffcd2ddd51" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.7" requestValidationMode="2.0" maxRequestLength="20480" />
    <customErrors mode="RemoteOnly" defaultRedirect="/error.html">
      <error statusCode="404" redirect="/404.html" />
    </customErrors>
  </system.web>
  <system.webServer>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" responseMode="Redirect" path="/404.html" />
    </httpErrors>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>
    <staticContent>
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="application/x-font-woff" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/truetype" />
      <remove fileExtension=".otf" />
      <mimeMap fileExtension=".otf" mimeType="font/opentype" />
      <remove fileExtension=".eot" />
      <mimeMap fileExtension=".eot" mimeType="application/vnd.ms-fontobject" />
      <remove fileExtension=".md" />
      <mimeMap fileExtension=".md" mimeType="text/x-markdown" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".html" />
      <mimeMap fileExtension=".html" mimeType="text/html" />
    </staticContent>
    <handlers>
      <add name="HtmlHandler" path="public/*.html" verb="*" preCondition="integratedMode" type="System.Web.StaticFileHandler" />
      <!--<add name="HtmlHandler" path="home/*" verb="GET" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />-->

    <remove name="ExtensionlessUrlHandler-Integrated-4.0" /><remove name="OPTIONSVerbHandler" /><remove name="TRACEVerbHandler" /><add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" /></handlers>
    <rewrite>
      <rules>
        <rule name="legal" stopProcessing="true">
            <match url="^legal\/tos\/?$" />
            <action type="Redirect" url="/tos" />
        </rule>
        <rule name="transform" stopProcessing="true">
          <match url="^transform\/?$" />
          <action type="Redirect" url="https://docs.google.com/forms/d/e/1FAIpQLSdtbhjhMQr703BYEhpykSlNMF5lhyg54fDK3cWK-77M4hxtNA/viewform?usp=sf_link" />
        </rule>
        <rule name="student-survey" stopProcessing="true">
          <match url="^student-?survey\/?$" />
          <action type="Redirect" url="https://airtable.com/shrwZTUUlS4wnqrR8" />
        </rule>
        <rule name="parent-survey" stopProcessing="true">
          <match url="^parent-?survey\/?$" />
          <action type="Redirect" url="https://airtable.com/shrDjVHGCXMVK98Gc" />
        </rule>
        <rule name="staff-survey" stopProcessing="true">
          <match url="^staff-?survey\/?$" />
          <action type="Redirect" url="https://airtable.com/shrR4nmXBQXr84Ct2" />
        </rule>
        <rule name="partner-program" stopProcessing="true">
          <match url="^partner-?program\/?$" />
          <action type="Redirect" url="https://airtable.com/shrOJCogUgVan1Yu2" />
        </rule>
        <rule name="ips-parents" stopProcessing="true">
          <match url="^ips-?parents\/?$" />
          <action type="Redirect" url="https://hub.afterschoolhq.com/ips-parents" />
        </rule>
        <rule name="eans" stopProcessing="true">
          <match url="^eans(\/|\.html)?$" />
          <action type="Redirect" url="https://hub.afterschoolhq.com/eans-2" />
        </rule>
        <rule name="esser" stopProcessing="true">
          <match url="^esser(\/|\.html)?$" />
          <action type="Redirect" url="https://hub.afterschoolhq.com/esser" />
        </rule>
        <rule name="ips-principals" stopProcessing="true">
          <match url="^ips-?principals\/?$" />
          <action type="Redirect" url="https://hub.afterschoolhq.com/ips-principals" />
        </rule>
        <rule name="district-launch" stopProcessing="true">
          <match url="^district-?launch\/?$" />
          <action type="Redirect" url="https://hub.afterschoolhq.com/district-launch" />
        </rule>
        <rule name="jobspark2020" stopProcessing="true">
          <match url="^jobspark2020\/?$" />
          <action type="Redirect" url="https://forms.gle/FrncdHyQS9jwKSjX7" />
        </rule>
        <rule name="handle-public" stopProcessing="true">
          <match url="^public\/?$" />
          <action type="Redirect" url="/" />
        </rule>
        <rule name="public-pages" stopProcessing="true">
          <match url="^\/?(about|ian19|case-study-cfi70|contact-us|contact|copyright|index|parents|privacy|providers|schools|sign-up|tos|joinips|manage-programs|new-programs|teachers|parents|joinmccoy|team|tpf4y|iyi|press-kit|pricing|joinisyp|ambassadors|esser|eans|sales-development-representative|bpm-free-trial|ips|news|ahq-partners-with-mccoy|afterschoolhq-partners-with-ips)\/?$" />
          <action type="Rewrite" url="/{R:1}.html" />
        </rule>
        <rule name="cfi70-case-study" stopProcessing="true">
          <match url="^cfi70\/?$" />
          <action type="Rewrite" url="/case-study-cfi70.html" />
        </rule>
        <rule name="sitemap_index.xml" stopProcessing="true">
          <match url="^sitemap_index.xml\/?$" />
          <action type="Rewrite" url="/sitemap/GenerateIndex" />
        </rule>
        <rule name="sitemap-profiles.xml" stopProcessing="true">
          <match url="^sitemap-profiles.xml\/?$" />
          <action type="Rewrite" url="/sitemap/GenerateProfileSitemap" />
        </rule>
        <rule name="sitemap-home.xml" stopProcessing="true">
          <match url="^sitemap-home.xml\/?$" />
          <action type="Rewrite" url="/sitemap/GetHomeSitemap" />
        </rule>
        <rule name="default" stopProcessing="true">
          <match url="^\/?$" />
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
