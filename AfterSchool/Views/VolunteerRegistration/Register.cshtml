@model AfterSchool.Assemblers.RegisterResult
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Complete Registration";
    var msgs = Model.Messages;
    var qvms = Model.Questions;
    var registrant = Model.Registrant;
    var groups = qvms.Select(qvm => qvm.Question.ToFormQuestionGroup())
        .OrderBy(group => group.DisplayOrder)
        .DistinctBy(group => group.ID)
        .ToList();
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        Model.RegistrationStartPageAccount,
        new ViewDataDictionary
        {
            { "ParticipationObject", Model.ParticipationObject },
        }
    );
}

@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(Model.ParticipationObject, $"Registering <strong>{registrant.FirstName}</strong> for <strong>{Model.ParticipationObject.Name}</strong>", ""),
        new ViewDataDictionary
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">
                <div class="text-center reg-instructions">
                    <p>
                        <strong>Step 3 of 3: Finalize Registration</strong>
                    </p>
                </div>
                <h3 class="text-center reg-instructions">
                    You must e-sign to finalize registration
                </h3>

                <form class="form-horizontal" id="register-form" method="post" action="@Url.Action("register", "VolunteerRegistration")" enctype="multipart/form-data">

                    @foreach (var group in groups)
                    {
                        Html.RenderPartial(
                            "~/Views/Shared/Form/_Group.cshtml",
                            group,
                            new ViewDataDictionary { { "QuestionViewModels", qvms.Where(qvm => qvm.Question.FormQuestionGroupId == group.ID).ToList() } });
                    }

                    <div class="form-group">
                        <label for="signature" class="col-md-3 control-label">
                            E-Signature
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-6">
                            <input type="text" id="signature" name="signature" value="" class="form-control" required="required" placeholder="Please type your full name" />
                        </div>
                    </div>
                    
                    <div class="row padding-v-20">
                        <div class="col-md-6 col-md-offset-3">
                            <button type="submit" id="btn-register" class="btn btn-register-primary btn-lg">
                                Complete Registration &raquo;
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <div class="padding-v-20 text-center">
                            <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a> &bull; <a href="@Url.Action("select", "account")" class="text-muted">Select a different child</a>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#register-form').submit(function () {
            $('#btn-register').html('Saving...');
            $('#btn-register').prop('disabled', true);
        });

        checkEligibility('@SessionVariables.CurrentRegistrant.Uid', null, null);
    });
</script>

@if (Model.ParticipationObject.IsActivityGroup() && Model.ParticipationObject.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        Model.ParticipationObject,
        new ViewDataDictionary
        {
            { "IsDuringCheckout", true }
        }
    );
}