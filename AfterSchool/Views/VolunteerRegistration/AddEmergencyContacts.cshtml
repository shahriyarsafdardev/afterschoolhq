@model AfterSchool.Controllers.AddEmergencyContactResult
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Emergency Contacts";
    var msgs = Model.Messages;
    var participationObject = Model.ParticipationObject;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        Model.RegistrationStartPageAccount,
        new ViewDataDictionary
        {
            { "ParticipationObject", participationObject },
            { "IsDuringProfileSetup", true }
        }
    );
}

@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(participationObject, true),
        new ViewDataDictionary()
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">
                <div>
                    <div class="text-center reg-instructions">
                        <p><strong>Step 4 of 6: Emergency Contacts</strong></p>
                    </div>

                    <div role="alert" class="alert alert-primary alert-icon alert-dismissible">
                        <div class="icon"><span class="s7-info"></span></div>
                        <div class="message">
                            <p class="text-center">
                                In case of emergency, parents will be called first. Please list two additional contacts as backup in case you are not reachable.
                            </p>
                        </div>
                    </div>

                    <form class="form-horizontal" id="emergency-contact-form" method="post" action="@Url.Action("addemergencycontacts", "VolunteerRegistration")">

                        <h4 class="col-md-9 col-md-offset-3 padding-v-20">Emergency Contact 1</h4>
                        @foreach (var qvm in Model.Questions.Where(qvm => qvm.Question.FormQuestionGroupQuestionGroupDataTypeId == QuestionGroupDataType.EmergencyContact1))
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <h4 class="col-md-9 col-md-offset-3 padding-v-20">Emergency Contact 2 (optional)</h4>
                        @foreach (var qvm in Model.Questions.Where(qvm => qvm.Question.FormQuestionGroupQuestionGroupDataTypeId == QuestionGroupDataType.EmergencyContact2))
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <h4 class="col-md-9 col-md-offset-3 padding-v-20">Emergency Contact 3 (optional)</h4>
                        @foreach (var qvm in Model.Questions.Where(qvm => qvm.Question.FormQuestionGroupQuestionGroupDataTypeId == QuestionGroupDataType.EmergencyContact3))
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <div class="row padding-v-20">
                            <div class="col-md-6 col-md-offset-3">
                                <button type="submit" id="btn-emergency-contact" class="btn btn-register-primary btn-lg">Save &amp; Continue &raquo;</button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#emergency-contact-form').submit(function () {
            $('#btn-emergency-contact').html('Saving Emergency Contact Info...');
            $('#btn-emergency-contact').prop('disabled', true);
        });
    });
</script>

@if (participationObject.IsActivityGroup() && participationObject.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        participationObject,
        new ViewDataDictionary()
        {
            { "IsDuringCheckout", true },
            { "AllowToModifyCart", false }
                                }
    );
}