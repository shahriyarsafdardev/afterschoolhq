@{ 
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Search";

    var msgs = (SystemMessages)ViewBag.Messages;
    var neighborhoods = (List<string>)ViewBag.Neighborhoods;
    var grades = (List<GradeLevel>)ViewBag.Grades;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div class="row">
    <div class="reg-header" style="background-image: linear-gradient(rgba(0, 0, 0, .8), rgba(0, 0, 0, .8)), url(https://afterschoolhq-prod.s3.us-east-2.amazonaws.com/McCoyYouth/headerimage/120221640_10157669465950893_7044339041890392902_n.png); min-height: 100%;">

        <div class="reg-header-overlay col-md-12">

            <div class="col-lg-3 col-md-6" style="margin-top: -75px; margin-bottom: 25px;">
                <div class="reg-header-logo-mccoy">
                    <img src="~/img/logo-white.png" />
                </div>
            </div>

            <div class="col-lg-7 col-md-6">
                <div class="form-group has-feedback mccoy-has-search">
                    <span class="glyphicon glyphicon-search form-control-feedback"></span>
                    <input id="txtMccoySearch" type="text" class="form-control" placeholder="Search" onkeyup="return waitAndFilterSearch()">
                </div>
            </div>

            <div class="col-lg-2 col-md-6">
                <a href="~/mccoy.html" class="btn btn-default btn-md btn-center" style="margin-top: 5px;"> Join the MCCOY Directory </a>
            </div>
        </div>

        <div class="clearfix"></div>
    </div>
</div>

<div id="filters" class="col-md-3" style="padding-right: 0;">

    @{
        <h4 class="mccoy-filter-header">Neighborhoods</h4>

        foreach (var item in neighborhoods)
        {
            <div class="am-checkbox" style="padding: 3px 0;">
                <input id="chk-neighborhoods-@(item.ToLower())" name="neighborhoods" value="@(item.ToLower())" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                <label for="chk-neighborhoods-@(item.ToLower())" class="margin-h-10 mobile-padding">@item</label>
            </div>
        }
    }

    @{
        var totalGradeCount = grades.Count;
        var firstHalf = totalGradeCount / 2;
        var secondHalf = totalGradeCount - firstHalf;

        <h4 class="mccoy-filter-header">Grades</h4>

        <div class="col-md-6 col-sm-12 no-padding">
            @foreach (var item in grades.Take(firstHalf))
            {
                <div class="am-checkbox" style="padding: 3px 0;">
                    <input id="chk-grades-@(item.ID)" name="grades" value="@(item.ID)" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                    <label for="chk-grades-@(item.ID)" class="margin-h-10 mobile-padding">@item.Name</label>
                </div>
            }
        </div>
        <div class="col-md-6 col-sm-12 no-padding">
            @foreach (var item in grades.Skip(firstHalf).Take(secondHalf))
            {
                <div class="am-checkbox" style="padding: 3px 0;">
                    <input id="chk-grades-@(item.ID)" name="grades" value="@(item.ID)" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                    <label for="chk-grades-@(item.ID)" class="margin-h-10 mobile-padding">@item.Name</label>
                </div>
            }
        </div>
    }

    @{
        <h4 class="mccoy-filter-header">Ages</h4>

        <div class="col-md-6 col-sm-12 no-padding">
            <div class="am-checkbox" style="padding: 3px 0;">
                <input id="chk-Ages-1" name="Ages" value="0,4" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                <label for="chk-Ages-1" class="margin-h-10 mobile-padding">0 - 4 yrs</label>
            </div>
            <div class="am-checkbox" style="padding: 3px 0;">
                <input id="chk-Ages-2" name="Ages" value="5,9" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                <label for="chk-Ages-2" class="margin-h-10 mobile-padding">5 - 9 yrs</label>
            </div>
        </div>

        <div class="col-md-6 col-sm-12 no-padding">
            <div class="am-checkbox" style="padding: 3px 0;">
                <input id="chk-Ages-3" name="Ages" value="10,14" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                <label for="chk-Ages-3" class="margin-h-10 mobile-padding">10 - 14 yrs</label>
            </div>
            <div class="am-checkbox" style="padding: 3px 0;">
                <input id="chk-Ages-4" name="Ages" value="15,18" type="checkbox" class="schedulerepeat-checkbox" onclick="return prepareSearchParams()" />
                <label for="chk-Ages-4" class="margin-h-10 mobile-padding">15 - 18 yrs</label>
            </div>
        </div>
    }

</div>

<div id="search-result" class="col-md-9"> </div>

<div class="clearfix"></div>

<script id="script-search-result-list" type="text/template">

    <% _.each(response, function(searchResult){ %>

    <div id="<%= searchResult.AccountUid %>" name="<%= searchResult.AccountName %>" class="col-sm-12 col-md-6 col-lg-4 col-xl-3 participation-object searchable-object pointer" onclick="WebPage.navigateIframe('<%= searchResult.HomePageUrl %>')">

        <div class="panel" style="overflow: hidden;">
            <div class="reg-header" style="background-image: url(<%= searchResult.ProfileHeaderImageUrl %>); min-height: 100px; height: 150px; padding: 5px 5px; position: relative;">

                <% if(searchResult.IsOpenDuringCovid) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        Open During COVID
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsELearningCenter) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        E-Learning Center
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsAccountNowEnrolling) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-danger profile-badge text-small">
                        Now Enrolling
                    </span>
                </div>

                <% } %>

                <div style="position: absolute; bottom: 0; right: 0; background-color: #fff; color: #333;">
                    <div class="padding-h-10">
                        <span class="text-small">
                            <%= searchResult.Location %>
                        </span>
                    </div>
                </div>

            </div>
            <div class="panel-body" style="position: relative;">

                <div class="" style="position: absolute; top: 10px; left: 15px; overflow: hidden; height: 20px;">

                    <div class="pull-left margin-l-5">
                        <% if(searchResult.IsRestrictByGrade) { %>

                        <span class="badge badge-gray profile-badge text-small">
                            <%= searchResult.GradeStart %> - <%= searchResult.GradeEnd %> Grade
                        </span>

                        <% } else { %>

                        <span class="badge badge-gray profile-badge text-small">
                            Ages <%= searchResult.AgeStart %> - <%= searchResult.AgeEnd %>
                        </span>

                        <% } %>
                    </div>

                </div>

                <div style="margin-top: 20px; height: 75px;display: table-cell; vertical-align: middle;">
                    <h3>
                        <strong title="<%= searchResult.AccountName %>"><%= searchResult.AccountName %></strong>
                    </h3>
                </div>

                <div class="" style="height: 40px;">
                    <span class="text-medium-small">
                        <%= searchResult.ProfileHeadline %>
                    </span>
                </div>

                <div class="margin-t-20">
                    <a href="javascript:WebPage.navigateIframe('<%= searchResult.HomePageUrl %>')" class="btn btn-register btn-block">
                        Learn More &raquo;
                    </a>
                </div>

            </div>
        </div>
    </div>

    <% }); %>

</script>


@section Scripts
{
    <script type="text/javascript">

        var delayTimer;
        var txtMccoySearch = $('#txtMccoySearch');

        $(document).ready(function () {
            loadAccounts();
        })

        function waitAndFilterSearch() {
            clearTimeout(delayTimer);
            delayTimer = setTimeout(function () {
                prepareSearchParams();
            }, 1000); //1 second wait
        }

        function prepareSearchParams() {
            //.. prepare params
            var comma_delimited_neighborhoods = '';

            $('input:checkbox[name=neighborhoods]:checked').each(function ()
            {
                if (comma_delimited_neighborhoods.length > 0) {
                    comma_delimited_neighborhoods += ',';
                }
                comma_delimited_neighborhoods += $(this).val();   
            });

            // .. call api
            loadAccounts(txtMccoySearch.val(), comma_delimited_neighborhoods);
        }


        function loadAccounts(search, neighborhoods) {            
            showLoader();

            var url = '@Url.Action("GetMccoySearch", "Search", new { Area = "" })';
            $.ajax({
                type: "POST",
                url: url,
                data: { search, neighborhoods },
                success: function (data) {
                    if (data && data.success == true) {

                        //.. prepare source and template
                        var source = $("#script-search-result-list").html();
                        var compiled = _.template(source);

                        //.. format data as JSON and combine with template
                        var compiledHtml = compiled({
                            response: data.data,
                        });

                        //.. update html to dom
                        $('#search-result').html(compiledHtml);

                        hideLoader();
                        return;
                    }
                    else {
                        Notifications.showBar({
                            title: 'Error',
                            message: 'No records found or something went wrong.',
                            success: false
                        });
                        hideLoader();
                        return false;
                    }
                }
            });
        }

    </script>
}