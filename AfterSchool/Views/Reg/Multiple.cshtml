@using System.Collections.Specialized;
@model AfterSchoolLibrary.Account

@{
    var questions = (List<FormQuestion>)ViewBag.Questions;
    var questionGroups = (List<FormQuestionGroup>)ViewBag.QuestionGroups;

    ViewBag.Title = "Registration";
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";

    var msgs = (SystemMessages)ViewBag.Messages;
    var items = (List<CartItem>)ViewBag.CartItems;
    var adminMode = (bool)ViewBag.AdminMode;
    var isPreview = (bool)ViewBag.Preview;

    var activities = items.Select(x => x.GetActivity()).ToList();

    var costPerRegistrant = activities.Sum(x => x.CostPerRegistrant);
    var acceptPayments = activities.Where(x => x.CanAcceptPayments).Count() > 0;
    var acceptCreditCard = activities.Where(x => x.AcceptCreditCard).Count() > 0;
    var acceptPayPal = activities.Where(x => x.AcceptPayPal).Count() > 0;
    var allowToPayLater = activities.Where(x => x.AllowToPayLater).Count() > 0;
    var hasUnpublished = activities.Where(x => x.IsPublished == false).Count() > 0;

    var disabledBtns = (isPreview || hasUnpublished) ? "disabled=\"disabled\"" : "";
    var registration = (Registration)ViewBag.Registration;
    var registrationUid = (string)ViewBag.RegistrationUid;
    var fieldValues = (NameValueCollection)ViewBag.FieldValues;
    var addOnly = registration.IsNotEmpty() && SessionVariables.LoggedInUser.IsEmpty();
    var routeId = ViewContext.RouteData.Values["id"].ToString();
    var postParams = string.Format("reg={0}&group={1}&profile={2}&copy={3}", registrationUid, Request["group"], Request["profile"], Request["copy"]);

        var hidequestions = "";
        if (addOnly)
        {
            hidequestions = "hide";
        }

        var submit = "Submit";
        if (registration.IsNotEmpty() && !addOnly)
        {
            submit = "Update";
        }
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@if (!Model.IsEmpty())
{
    <div class="page-head registration-titlebar">
        @if (!isPreview && false)
        {
            <p><a href="/@Model.UniqueName?reg=@registrationUid&group=@Request["group"]&invite=@Request["invite"]" class="text-white">&laquo; Modify @UILabel.ActivityLabel(ActivityType.Activity, true)</a></p>
        }
        <h2>
            <i class="icon icon-left s7-note2"></i> 
            @Model.Name
            @if (registration.IsNotEmpty())
            {
                @: - @registration.Name
            }
        </h2>
        <p></p>
    </div>
}

<div class="main-content">

    @if (items.Count == 0)
    {
        <div class="widget">
            <h1>Sorry but there is no registration form here :(</h1>
        </div>
    }
    else
    {
        <div class="col-md-3">     

            @foreach (var item in items.OrderBy(x => x.Day))
            {
                var hidedescription = "";
                var showLock = false;
                if(addOnly && registration.IsRegisteredFor(item.GetActivity()))
                {
                    hidedescription = "hide";
                    showLock = true;
                }

                <div class="panel panel-default">
                    <div class="panel-heading">
                        @if (showLock)
                        {
                            <i class="s7-lock"></i>
                        }
                        <strong>@(item.Day != DayOfWeekASL.NotSet ? item.Day.ToString().MaxChars(2) + ": " : "")</strong>
                        @item.GetActivity().Name
                    </div>
                    <div class="panel-body @hidedescription">
                        <div>
                            @Html.Raw(item.GetActivity().Details)
                        </div>
                    </div>
                </div>
            }

            <div>
                <button type="button" onclick="postForm()" class="btn btn-link btn-lg">&laquo; Modify Activities</button>
                <script>
                    function postForm(){
                        console.log('postform');
                        $('#registration-form').find(':required').each(function(){
                            $(this).removeAttr('required');
                        });
                        $('#registration-form').attr('action', '@Html.Raw(Url.Action("modifyactivities", "reg", new { id = routeId }))?@Html.Raw(postParams)');
                        console.log(document.getElementById("registration-form").id);
                        document.getElementById("registration-form").submit();
                    }
                </script>
            </div>
        </div>
        <div class="col-md-9">
            
            @{ Html.RenderPartial("_RegLoginBlock"); }            

            <form action="/reg/savemultiple/@routeId?@postParams" method="post" class="form-horizontal" id="registration-form">

                @foreach (var group in questionGroups.Where(x => x.RegistrantTypeId == RegistrantType.Individual))
                {
                    var groupQuestions = new List<FormQuestion>();

                    if (group.QuestionGroupDataTypeId != QuestionGroupDataType.NotSet)
                    {
                        groupQuestions = questions.Where(x => x.GetFormQuestionGroup().QuestionGroupDataTypeId == group.QuestionGroupDataTypeId).ToList();
                    }
                    else
                    {
                        groupQuestions = questions.Where(x => x.FormQuestionGroupId == group.ID).ToList();
                    }

                    <div class="panel panel-default">
                        <div class="panel-heading">
                            @if (addOnly)
                            {
                                <i class="s7-lock"></i>
                            }
                            @group.Name
                        </div>
                        
                        <div class="panel-body @hidequestions">
                            @foreach (var question in groupQuestions)
                            {
                                Html.RenderPartial(
                                    "_RegFormQuestions",
                                    question,
                                    new ViewDataDictionary() {
                                        { "id", "question-" + ((int)question.ID).ToString() },
                                        { "fieldValues", fieldValues }
                                    }
                                );
                            }
                        </div>
                    </div>
                }

                @{ Html.RenderPartial(
                    "_ActivityPayment",
                    registration,
                    new ViewDataDictionary()
                    {
                        { "costPerRegistrant", costPerRegistrant },
                        { "acceptPayments", acceptPayments },
                        { "acceptCreditCard", acceptCreditCard },
                        { "acceptPayPal", acceptPayPal },
                        { "fieldValues", fieldValues },
                        { "allowToPayLater", allowToPayLater },
                    }
                    ); }

                @{ Html.RenderPartial(
                     "_ActivityPreference",
                     items,
                     new ViewDataDictionary() {
                        { "fieldValues", fieldValues },
                        { "registration", registration },
                        { "addonly", addOnly }
                     }); }

                @if (SessionVariables.LoggedInUser.IsEmpty() || adminMode)
                {
                    Html.RenderPartial("_RegCreateAccount");
                }

                <input type="hidden" name="registranttype" id="registranttype" value="@RegistrantType.Individual.ToString()" />           

                <div class="panel panel-default">
                    <div class="panel-body">
                        <button class="btn btn-primary btn-block btn-lg" type="submit" id="submitreg" @disabledBtns>@submit &raquo;</button>
                        <button class="btn btn-primary btn-block btn-lg hide" type="submit" id="submitpaypal" @disabledBtns>Continue &amp; Pay via  PayPal &raquo;</button>
                    </div>
                </div>

            </form>
        </div>
    }

</div>

@section fbadevents
{
    @if (Model.GetAccountProperty(AccountPropertyType.FacebookAdPixel).IsNotEmpty())
    {
        <script>
          fbq('track', 'ViewContent');
        </script>
    }
}

@section scripts
{
    <script>
        $(document).ready(function(){           

            if($('#paymenttype-@((int)PaymentType.PayPal)').is(':checked')){
                showpaypal();
            }

            $('#registration-form').find('[data-required]').each(function () {
                $(this).attr('required', 'required');
            });
            
        });

        function showcreditcard() {
            $('#creditcard').removeClass("hide");
            $('#payment-instructions').addClass('hide');
            $('#paypal').addClass("hide");
            $('#submitpaypal').addClass("hide");
            $('#submitreg').removeClass("hide");
            $('#inperson').addClass("hide");

            $('#ccname').prop('required', true);
            $('#ccnumber').prop('required', true);
            $('#cccvc').prop('required', true);
            $('#ccexpmonth').prop('required', true);
            $('#ccexpyear').prop('required', true);
        }

        function showpaypal() {
            $('#paypal').removeClass("hide");
            $('#payment-instructions').addClass('hide');
            $('#creditcard').addClass("hide");
            $('#submitpaypal').removeClass("hide");
            $('#submitreg').addClass("hide");
            $('#inperson').addClass("hide");

            $('#ccname').prop('required', false);
            $('#ccnumber').prop('required', false);
            $('#cccvc').prop('required', false);
            $('#ccexpmonth').prop('required', false);
            $('#ccexpyear').prop('required', false);
        }

        function showinperson(){
            $('#payment-instructions').addClass('hide');
            $('#creditcard').addClass("hide");
            $('#paypal').addClass("hide");
            $('#submitpaypal').addClass("hide");
            $('#submitreg').removeClass("hide");
            $('#inperson').removeClass("hide");

            $('#ccname').prop('required', false);
            $('#ccnumber').prop('required', false);
            $('#cccvc').prop('required', false);
            $('#ccexpmonth').prop('required', false);
            $('#ccexpyear').prop('required', false);
        }

        function updateTotalCost(multiplier){

            if(!isNaN(multiplier)){
                var total = numbro(multiplier * @costPerRegistrant).formatCurrency('0.00'); //numbro(1000.234).formatCurrency();
                var totalCostVal = '@costPerRegistrant.ToCurrency() x ' + multiplier.toString() + ' Seat(s) = ' + total;
                console.log(totalCostVal);
                $('#numberofseats').val(multiplier);
                $('#total-cost').html(totalCostVal);
            }
        }
    </script>
}









