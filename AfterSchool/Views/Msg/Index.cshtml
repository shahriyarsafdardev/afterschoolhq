@model ActivityMessage
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Subject;
    var createdBy = Model.GetCreatedBy();
    var participationObject = Model.GetParticipationObject();
    
}

<div>
    <div class="col-md-6 col-md-offset-3 text-center">
        <div class="panel">
            <div class="panel-footer">
                <p>Sent by <strong>@(createdBy.DisplayName)</strong> at <strong>@Model.CreateDate.ToLongDateTimeString()</strong></p>
            </div>
            <div class="panel-heading text-left">
                <h1><strong>@Model.Subject for @(participationObject.Name)</strong></h1>
            </div>
            <div class="panel-body">
                <p class="text-left">@Html.Raw(Model.Body.Replace("\n", "<br />"))</p>
            </div>
            <div class="panel-footer">
                <p>
                    For more information, feel free to reach @participationObject.ContactName via <a href="mailto:@participationObject.ContactEmail">email</a> or <a href="tel:@participationObject.ContactPhone">@participationObject.ContactPhone</a>
                </p>
            </div>
        </div>
    </div>
</div>