@{
    ViewBag.Title = "After School HQ";
    Layout = "~/Views/Shared/_LayoutPublic-AfterSchool.cshtml";
}

<!-- Top content -->
<div id="home" class="parallax top-content" data-stellar-background-ratio="0.3">
    <div class="inner-bg">
        <div class="container">
            <div class="row">

                <div class="col-md-10 col-md-offset-1 top-description">

                    <img src="/assets/img/afterschool-logo.png" />

                    <h2 class="text-center">
                        After School Management Simplified
                    </h2>

                    <p>Create enrollment forms, Simplify Communication with Parents and Teachers, Track student engagement and After School Program Effectiveness</p>
                    <div class="top-button">
                        <a class="btn btn-top btn-lg hide" href="#pricing-section">Get Started</a>
                        <a class="btn btn-top-white btn-lg" href="#features-section">Learn More <i class="ion ion-ios-arrow-down"></i></a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<!-- Features -->
<div id="features-section" class="features-container">
    <div class="container">
        <div class="row">
            <div class="col-sm-12 features">
                <h3>Features</h3>
                <p>We have all the tools you need to manage your @UILabel.ActivityLabel(true)</p>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-4 features-box">
                <div class="icon">
                    <i class="icon ion-clipboard"></i>
                </div>
                <h4>Enroll</h4>
                <p>
                    @UILabel.ProductName() allows you to quickly create and publish enrollment forms without wasting time building custom forms. Now you can anticipate attendance and put an end to late paper registration forms by allowing students to reserve their seats.
                </p>
                <a class="btn btn-features btn-lg hide" href="#"> Learn More</a>

            </div>
            <div class="col-sm-4 features-box">
                <div class="icon">
                    <i class="icon ion-chatboxes"></i>
                </div>
                <h4>Communicate</h4>
                <p>
                    Are you using multiple tools to communicate with your students? There’s a good chance they could miss important updates and information from you. @UILabel.ProductName() allows you to Login and send a message to all or just one of your students in one simple tool.
                </p>
                <a class="btn btn-features btn-lg hide" href="#"> Learn More</a>

            </div>
            <div class="col-sm-4 features-box">
                <div class="icon">
                    <i class="icon ion-cash"></i>
                </div>
                <h4>Accept Payments Online</h4>
                <p>
                    With @UILabel.ProductName() you no longer have to wait to hold a seats while waiting for payments. You can quickly accept payment using credit cards and/or Paypal and reserve seats for those who pay first.
                </p>
                <a class="btn btn-features btn-lg hide" href="#"> Learn More</a>

            </div>
        </div>

        <div class="row">
            <div class="col-sm-4 features-box">
                <div class="icon">
                    <i class="icon ion-clock"></i>
                </div>
                <h4>Waiting Lists</h4>
                <p>
                    Allow everyone who enrolls to see right away how many seats are available. When seats are filled you can easily open up a waiting list where each student will be placed in order of enrollment. @UILabel.ProductName() allows you to easily add a student to your @UILabel.ActivityLabel().ToLower() if a student drops out or you decide to add more seats.
                </p>
                <a class="btn btn-features btn-lg hide" href="#"> Learn More</a>

            </div>
            <div class="col-sm-4 features-box">
                <div class="icon">
                    <i class="icon ion-android-checkbox-outline"></i>
                </div>
                <h4>Attendance</h4>
                <p>
                    Need to know which @UILabel.ActivityLabel(true) are getting the best attendance or which students are present? Take attendance to keep track of performance per @UILabel.ActivityLabel() and per student and view reports on demand.
                </p>
                <a class="btn btn-features btn-lg hide" href="#"> Learn More</a>

            </div>
            <div class="col-sm-4 features-box">
                <div class="icon">
                    <i class="icon ion-shuffle"></i>
                </div>
                <h4>Lottery</h4>
                <p>
                    Want to offer a lottery instead of first come first serve? Allow students to pick the @UILabel.ActivityLabel(true) they want and select their preference. Then when enrollment is closed, run a lottery to place your students.
                </p>
                <a class="btn btn-features btn-lg hide" href="#"> Learn More</a>

            </div>
        </div>
    </div>
</div>

