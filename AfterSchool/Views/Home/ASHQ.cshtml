<!-- Contact us -->
<div id="contact-section" class="contact-container">

    <div class="inner-contact">
        <div class="container">
            <div class="row">
                <div class="col-sm-12 contact">
                    <h3>Contact Us</h3>
                    <p>
                        We would love to hear from you. Drop us a line.
                    </p>
                </div>
            </div>
            <div class="row">
                <div class="col-sm-6 form-group contact-form">
                    <h4>Send Message</h4>
                    <div class="submit-contact-error bg-danger hide padding-10 margin-r-20 text-white">

                    </div>
                    <div class="submit-contact-success bg-success hide padding-10 margin-r-10 text-white">
                        Thank you! Your message has been sent to our team.
                    </div>

                    <form method="post" action="assets/contact.php">
                        <input type="text" name="email" placeholder="Email" id="email" class="form-control contact-email" required>
                        <input type="text" name="subject" placeholder="Subject" id="subject" class="form-control contact-subject" required>
                        <textarea name="message" class="form-control" id="message" placeholder="Message" required></textarea>
                        <div class="margin-b-10">
                            <div class="g-recaptcha" data-sitekey="6Lfg2BEUAAAAADCXTFVlYUywSoqvMUgLd-tERDxO"></div>
                        </div>
                        <button type="button" id="btn-submit-contact-form" class="btn btn-contact" onclick="submitContactForm()">Submit</button>
                    </form>
                    <script>
                        function submitContactForm() {

                            var params = 'email=' + $('#email').val() +
                                '&subject=' + $('#subject').val() +
                                '&message=' + $('#message').val() +
                                '&g_recaptcha_response=' + $('#g-recaptcha-response').val();

                            $('#btn-submit-contact-form').html('Submitting...');
                            $('#btn-submit-contact-form').prop('disabled', true);

                            $.post(
                                '/services/submitcontactform',
                                params,
                                function (data) {

                                    $('#btn-submit-contact-form').html('Submit');
                                    $('#btn-submit-contact-form').prop('disabled', false);
                                    grecaptcha.reset();

                                    if (data && data.status == 'ok') {

                                        $('#email').val('');
                                        $('#subject').val('');
                                        $('#message').val('');

                                        $('.submit-contact-error').addClass('hide');
                                        $('.submit-contact-success').removeClass('hide');

                                    } else {

                                        $('.submit-contact-success').addClass('hide');
                                        $('.submit-contact-error').removeClass('hide');
                                        $('.submit-contact-error').html('');

                                        for (var message of data.messages) {
                                            $('.submit-contact-error').append('<p>');
                                            $('.submit-contact-error').append(message.Text);
                                            $('.submit-contact-error').append('</p>');
                                        }

                                    }
                                }
                            );
                        }
                    </script>
                </div>
                <div class="col-sm-6 contact-address contact-about">
                    <h4>About</h4>
                    <p>@UILabel.ProductName() was created with love in Fishers, IN. We hope to allow you to focus on what you love and let technology get out of the way.</p>
                    <h4>Address</h4>
                    <p><i class="fa fa-map-marker"></i>12175 Visionary Way #107, Fishers, Indiana, USA</p>
                    <p><i class="fa fa-phone"></i>Phone: 317-316-0596</p>
                </div>
            </div>
        </div>
    </div>
</div>

