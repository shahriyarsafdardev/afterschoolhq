@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Home Address";
    var msgs = (SystemMessages)ViewBag.Messages;
    var participationObject = (ParticipationObject)ViewBag.ParticipationObject;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        SessionVariables.RegistrationStartPageAccount,
        new ViewDataDictionary()
        {
            { "ParticipationObject", participationObject },
            { "IsDuringProfileSetup", true }
        }
    );
}

@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(participationObject, true),
        new ViewDataDictionary()
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">
                <div class="text-center reg-instructions">
                    <p><strong>Step 2 of 6: Home Address</strong></p>
                </div>
                <div>
                    <div class="text-center reg-login">
                        <p>Add your home address so that activity providers have it on file in case of an emergency.</p><br />
                    </div>
                    <form class="form-horizontal" id="add-home-address-form" method="post" action="@Url.Action("addhomeaddress", "account")">
                        @foreach (var qvm in Model)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }
                        
                        <div class="row padding-v-20">
                            <div class="col-md-6 col-md-offset-3">
                                <button type="submit" id="btn-add-home-address" class="btn btn-register-primary btn-lg">Save &amp; Continue &raquo;</button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#add-home-address-form').submit(function () {
            $('#btn-add-home-address').html('Saving Home Address...');
            $('#btn-add-home-address').prop('disabled', true);
        });
    });
</script>

@if (participationObject.IsActivityGroup() && participationObject.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        participationObject,
        new ViewDataDictionary()
        {
            { "IsDuringCheckout", true },
            { "AllowToModifyCart", false }
                                }
    );
}