@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Student";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var school = (Location)ViewBag.School;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml"); }

<div class="reg-header">
    <div>
        @foreach (var item in cart.GetCartItems())
        {
            <div>
                <h1>You are registering for: @item.GetParticipationObject().Name</h1>
            </div>
        }
    </div>
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <div>
                    <h3 class="text-center reg-instructions"><strong>Additional Parent Information</strong></h3>

                    <div class="row">
                        <div class="padding-v-20 text-center">
                            <a href="@Url.Action("addemergencycontacts", "account")" class="text-muted">Skip &raquo;</a>
                        </div>
                    </div>

                    <form class="form-horizontal" id="add-parent-form" method="post" action="@Url.Action("addparent", "account")">

                        @foreach (var qvm in Model)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <div class="padding-v-20">
                            <button type="submit" id="btn-add-parent" class="btn btn-register btn-lg">Save &amp; Continue &raquo;</button>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#add-parent-form').submit(function () {
            $('#btn-add-parent').html('Saving Parent Info...');
            $('#btn-add-parent').prop('disabled', true);
        });
    });
</script>