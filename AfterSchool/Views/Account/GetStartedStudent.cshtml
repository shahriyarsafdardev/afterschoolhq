@model List<FormQuestionViewModel>

@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Get Started";
    var participationObject = (ParticipationObject)ViewBag.ParticipationObject;
    var msgs = (SystemMessages)ViewBag.Messages;

    var cleverSsoEnabled = ViewBag.CleverSsoEnabled;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        SessionVariables.RegistrationStartPageAccount,
        new ViewDataDictionary()
        {
            { "ParticipationObject", participationObject },
            { "CleverSsoEnabled", cleverSsoEnabled }
        }
    );
}

@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(participationObject, true),
        new ViewDataDictionary()
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <div class="text-center reg-instructions">
                    <p><strong>Step 1 of 2: Your Student Information</strong></p>
                </div>

                <div class="text-center reg-login">
                    <p>
                        If this is your first time signing up, we'll keep it quick. <br />Even better: you'll only have to input your information once.
                    </p>
                    <br />
                    <p>
                        Already have an account?
                        <a href="#" class="md-trigger" data-modal="modal-login">
                            Login
                        </a>
                    </p>
                    <p>
                        Are you a Parent?
                        <a href="@Url.Action("getstarted", "account", new { regaccount = Request["regaccount"] })">
                            Register Here
                        </a>
                    </p>
                </div>

                <form method="post" class="form-horizontal" id="sign-up-form" action="@Url.Action("GetStartedStudent", "account")">

                    @foreach (var item in Model)
                    {
                        Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", item);

                        if (item.Question.QuestionDataTypeId == QuestionDataType.RegistrantEmail)
                        {
                            <div class="row">
                                <div class="col-md-6 col-md-offset-3">
                                    <div> Please use your student email</div>
                                </div>
                            </div>
                        }
                        else if (item.Question.QuestionDataTypeId == QuestionDataType.RegistrantMobilePhone)
                        {
                            <div class="row">
                                <div class="col-md-6 col-md-offset-3">
                                    <div class="am-checkbox">
                                        <input type="checkbox" id="textnotifications" name="textnotifications" value="1" @(Request["textnotifications"] == "1" ? " checked=\"checked\" " : "") />
                                        <label for="textnotifications">
                                            I would like to receive text messages about my student&#39;s activities&#46;
                                            Notifications may include information about attendance&#44; reminders&#44; and important information&#46;
                                        </label>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    <div class="form-group">
                        <label for="password1" class="control-label col-md-3">
                            Password <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-6">
                            <input id="password1" name="password1" type="password" class="form-control" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="password1" class="control-label col-md-3">
                            Verify Password <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-6">
                            <input id="password2" name="password2" type="password" class="form-control" />
                        </div>
                    </div>

                    <div class="row padding-v-20">
                        <div class="col-md-6 col-md-offset-3">
                            <div class="am-checkbox text-center">
                                <input type="checkbox" id="agree" name="agree" value="1" @(Request["agree"] == "1" ? " checked=\"checked\" " : "") />
                                <label for="agree">
                                    I agree to the <a href="@Url.Action("tos", "legal")" target="_blank">terms and services</a> of using @UILabel.ProductName()
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="padding-v-20">
                        <button type="submit" id="btn-create-account" class="btn btn-register-primary btn-lg">Save &amp; Continue &raquo;</button>
                    </div>

                    <div class="row">
                        <div class="padding-v-20 text-center">
                            <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                        </div>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#sign-up-form').submit(function () {
            $('#btn-create-account').html('Saving...');
            $('#btn-create-account').prop('disabled', true);
        });
    });
</script>

@if (participationObject.IsActivityGroup() && participationObject.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        participationObject,
        new ViewDataDictionary()
        {
            { "IsDuringCheckout", true }
                                }
    );
}

