@model ParticipationObject
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Complete Registration";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;
    var registrant = (Registrant)ViewBag.Registrant;
    var groups = qvms.Select(qvm => qvm.Question.ToFormQuestionGroup())
        .OrderBy(group => group.DisplayOrder)
        .DistinctBy(group => group.ID)
        .ToList();
    var sessionActivities = (List<ParticipationObject>)ViewBag.SessionActivities;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        SessionVariables.RegistrationStartPageAccount,
        new ViewDataDictionary()
        {
            { "ParticipationObject", Model }
                        }
    );
}

@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(Model, $"Registering <strong>{SessionVariables.CurrentRegistrant.FirstName}</strong> for <strong>{Model.Name}</strong>", ""),
        new ViewDataDictionary()
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <h3 class="text-center reg-instructions">
                    You must e-sign to finalize registration
                </h3>

                <form class="form-horizontal" id="register-form" method="post" action="@Url.Action("register", "account")" enctype="multipart/form-data">

                    @foreach (var group in groups)
                    {
                        Html.RenderPartial(
                            "~/Views/Shared/Form/_Group.cshtml",
                            group,
                            new ViewDataDictionary() { { "QuestionViewModels", qvms.Where(qvm => qvm.Question.FormQuestionGroupId == group.ID).ToList() } });
                    }

                    @if (sessionActivities.IsNotEmpty() && sessionActivities.Any())
                    {
                        Html.RenderPartial(
                            "~/Views/Shared/Activity/_ActivityPreferences.cshtml",
                            sessionActivities);
                    }

                    <div class="form-group">
                        <label for="signature" class="col-md-3 control-label">
                            Parent E-Signature
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-6">
                            <input type="text" id="signature" name="signature" value="" class="form-control" required="required" placeholder="Please type your full name" />
                        </div>
                    </div>
                    
                    <div class="row padding-v-20">
                        <div class="col-md-6 col-md-offset-3">
                            <button type="submit" id="btn-register" class="btn btn-register-primary btn-lg">
                                @if (!Model.ShouldParentPay())
                                {
                                    @: Complete Registration &raquo;
                                }
                                else if (Model.PostPayPlans.Any())
                                {
                                    @: E-Sign &amp; Add Payment Method &raquo;
                                }
                                else
                                {
                                    @: E-Sign and Continue to Payment &raquo;
                                }
                            </button>
                        </div>
                    </div>

                    <div class="row">
                        <div class="padding-v-20 text-center">
                            <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a> &bull; <a href="@Url.Action("select", "account")" class="text-muted">Select a different child</a>
                        </div>
                    </div>

                </form>

            </div>
        </div>
    </div>
</div>

@{ Html.RenderPartial("~/Views/Shared/Registration/_GradeIneligibility.cshtml", Model); }

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#register-form').submit(function () {
            $('#btn-register').html('Saving...');
            $('#btn-register').prop('disabled', true);
        });

        checkEligibility('@SessionVariables.CurrentRegistrant.Uid', null, null);
    });
</script>

@if (Model.IsActivityGroup() && Model.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        Model,
        new ViewDataDictionary()
        {
            { "IsDuringCheckout", true }
                                }
    );
}