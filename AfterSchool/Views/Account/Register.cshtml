@model ParticipationObject
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;

}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div>
    <h1>Register for @Model.Name</h1>
    <div>
        @Html.Raw(Model.Details)
    </div>
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <p>
                    You must e-sign to finalize registration
                </p>

                <form class="form-horizontal" method="post" action="@Url.Action("register", "account")">

                    @foreach (var group in qvms.Select(qvm => qvm.Question.ToFormQuestionGroup()))
                    {
                        Html.RenderPartial("~/Views/Shared/Form/_Group.cshtml", group, new ViewDataDictionary() { { "QuestionViewModels", qvms } });
                    }

                    <div class="form-group">
                        <label for="signature" class="col-md-3 control-label">
                            Parent E-Signature
                            <span class="text-danger">*</span>
                        </label>
                        <div class="col-md-6">
                            <input type="text" id="signature" name="signature" value="" class="form-control" required="required" placeholder="Please type your full name" />
                        </div>
                    </div>

                    <div class="padding-v-20">
                        <button type="button" class="btn btn-xl center-block btn-primary">
                            @if (Model.Cost == 0)
                            {
                                @: Complete Registration &raquo;
                            }
                            else
                            {
                                @: E-Sign and Continue to Payment &raquo;
                            }
                            
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>