@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Student";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var student = (Registrant)ViewBag.Student;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div class="reg-header">
    <div>
        @foreach (var item in cart.GetCartItems())
        {
            <div>
                <h1>You are registering for: @item.GetParticipationObject().Name</h1>
            </div>
        }
    </div> 
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <div>
                    <h3 class="text-center reg-instructions"><strong>Health Information</strong></h3>
                    <p class="text-center reg-login">Please add health information for: @student.DisplayName</p>
                    <form class="form-horizontal" id="add-health-form" method="post" action="@Url.Action("addhealth", "account")">
                        @foreach (var qvm in Model)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <div class="padding-v-20">
                            <button type="submit" id="btn-add-health" class="btn btn-xl center-block btn-register">Continue &raquo;</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#add-health-form').submit(function () {
            $('#btn-add-health').html('Saving Health Info...');
            $('#btn-add-health').prop('disabled', true);
        });
    });
</script>