@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Emergency Contacts";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml"); }

<div class="reg-header">
    <div>
        @foreach (var item in cart.GetCartItems())
        {
            <div>
                <h1>You are registering for: @item.GetParticipationObject().Name</h1>
            </div>
        }
    </div>
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">
                <div>
                    <h3 class="text-center reg-instructions"><strong>Emergency Contacts</strong></h3>
                    <p class="text-center">In case of emergency, parents will be called first. Please list two additional contacts as backup.</p>
                    <form class="form-horizontal" id="emergency-contact-form" method="post" action="@Url.Action("addemergencycontacts", "account")">

                        <h4 class="col-md-9 col-md-offset-3">Contact 1</h4>
                        @foreach (var qvm in Model.Where(qvm => qvm.Question.FormQuestionGroupQuestionGroupDataTypeId == QuestionGroupDataType.EmergencyContact1))
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <h4 class="col-md-9 col-md-offset-3">Contact 2</h4>
                        @foreach (var qvm in Model.Where(qvm => qvm.Question.FormQuestionGroupQuestionGroupDataTypeId == QuestionGroupDataType.EmergencyContact2))
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                        }

                        <div class="padding-v-20">
                            <button type="submit" id="btn-emergency-contact" class="btn btn-register btn-lg">Save &amp; Continue &raquo;</button>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#emergency-contact-form').submit(function () {
            $('#btn-emergency-contact').html('Saving Emergency Contact Info...');
            $('#btn-emergency-contact').prop('disabled', true);
        });
    });
</script>