@model ParticipationObject
@{
    ViewBag.Title = "Complete Registration";
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    var cart = (Cart)ViewBag.Cart;
    var msgs = (SystemMessages)ViewBag.Messages;
    var alreadyRegistered = (bool)ViewBag.AlreadyRegistered;
    var homePageUrl = Model.GetActivity();
    var sessionActivities = (List<ParticipationObject>)ViewBag.SessionActivities;
    var qvms = (List<FormQuestionViewModel>)ViewBag.QuestionViewModels;
    var groups = qvms.Select(qvm => qvm.Question.ToFormQuestionGroup())
       .OrderBy(group => group.DisplayOrder)
       .DistinctBy(group => group.ID)
       .ToList();
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        SessionVariables.RegistrationStartPageAccount,
        new ViewDataDictionary()
        {
            { "ParticipationObject", Model }
        }
    );
}

@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(Model, true),
        new ViewDataDictionary()
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="am-content">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="text-center">
                    <h2>Registration Confirmation</h2><br />
                </div>
                <div class="panel-body">

                    @if (alreadyRegistered)
                    {
                        <p class="text-medium-small text-center">
                            You've already registered for @Model.Name
                        </p>

                        <div class="padding-v-20">
                            <a href="@SessionVariables.RegistrationStartPageAccount.HomePageUrl" class="btn btn-register btn-lg">&laquo; View More Activities</a>
                        </div>
                    }
                    else
                    {
                        <form method="post" id="register-form" class="form-horizontal" action="@Url.Action("RegisterStudent", "account")">

                            @foreach (var group in groups)
                            {
                                Html.RenderPartial(
                                    "~/Views/Shared/Form/_Group.cshtml",
                                    group,
                                    new ViewDataDictionary() { { "QuestionViewModels", qvms.Where(qvm => qvm.Question.FormQuestionGroupId == group.ID).ToList() } });
                            }

                            @if (sessionActivities.IsNotEmpty() && sessionActivities.Any())
                            {
                                Html.RenderPartial("~/Views/Shared/Activity/_ActivityPreferences.cshtml", sessionActivities);
                            }

                            <div class="form-group">
                                <div class="col-md-12 text-center">
                                    <div class="am-checkbox">
                                        <input type="checkbox" id="agree" name="agree" value="1" @(Request["agree"] == "1" ? " checked=\"checked\" " : "") />
                                        <label for="agree">
                                            I confirm that I have entered both my information and my parent's information correctly and I intend to participate in <strong>@Model.Name</strong><br />
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-12 text-center">
                                    <div class="padding-v-20">
                                        <div class="col-md-6 col-md-offset-3">
                                            <button type="submit" id="btn-create-account-register" class="btn btn-register-primary btn-lg">Register &raquo;</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <div class="col-md-12 text-center">
                                    <div class="row">
                                        <div class="padding-v-20 text-center">
                                            <a href="@homePageUrl.HomePageUrl">Cancel</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </form>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#register-form').submit(function () {
            $('#btn-register-account').html('Registering...');
            $('#btn-register-account').prop('disabled', true);
        });
    });
</script>

@if (Model.IsActivityGroup() && Model.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        Model,
        new ViewDataDictionary()
        {
            { "IsDuringCheckout", true }
        }
    );
}
