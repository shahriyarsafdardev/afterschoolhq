
@{
    ViewBag.Title = "RegisterStudent";
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
}

<div>
    <div class="am-content">
        <div class="panel panel-default">
            <div class="panel-heading">
                <div class="text-center">
                    <a href="/"><img src="@UILabel.ProductLogoInverse()" alt="logo" width="350px" class="logo-img"></a>
                </div>
            </div>
            <div class="panel-body">
                <div class="text-center">
                    <h2>Registration Confirmation</h2><br />
                    <br />
                    <br />
                </div>
                <div class="panel-body">
                    <form method="post" id="register-form" class="form-horizontal" action="@Url.Action("RegisterAccount", "account")">
                        <div class="form-group">
                            <label for="password1" class="control-label col-md-3">
                            </label>
                            <div class="col-md-9">
                                <div class="am-checkbox">
                                    <input type="checkbox" class="form-control" name="agree" id="agree" />
                                    <label for="agree">
                                        I have entered both my information and my parent's information correctly and I intead to participate in Gymnastics<br />
                                    </label>
                                </div>
                            </div>
                            <button type="submit" id="btn-register-account" class="btn btn-register btn-lg">Register</button>
                            <br />
                        </div>
                    </form>
                </div>
                <div class="text-center out-links"><a href="/">&copy; @DateTime.UtcNow.Year @UILabel.ProductName()</a></div>
            </div>
        </div>
    </div>
</div>
<script>
     PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#register-form').submit(function () {
            $('#btn-register-account').html('Saving...');
            $('#btn-register-account').prop('disabled', true);
        });
    });
</script>

