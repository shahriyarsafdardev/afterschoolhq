@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Student";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var school = (Location)ViewBag.School;
    var showStepNumber = (bool)ViewBag.ShowStepNumber;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }

<div class="reg-header">
    <div>
        @foreach (var item in cart.GetCartItems())
        {
            <div>
                <h1>You are registering for: @item.GetParticipationObject().Name</h1>
            </div>
        }
    </div>
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <div>
                                        
                    <div class="text-center reg-instructions">
                        <p>
                            <strong>
                                @if (showStepNumber)
                                {
                                    <span>Step 5 of 6: </span>
                                }
                                Student Information
                            </strong>
                        </p>
                    </div>

                    <form class="form-horizontal" id="add-student-form" method="post" action="@Url.Action("addstudent", "account")">

                        @foreach (var qvm in Model)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
                            if (qvm.Question.QuestionDataTypeId == QuestionDataType.RegistrantEmail)
                            {
                                <div class="row">
                                    <div class="col-md-6 col-md-offset-3">
                                        <div class="am-checkbox">
                                            <input type="checkbox" id="createUserAccount" name="createUserAccount" value="1" />
                                            <label for="createUserAccount">
                                                Allow my child to login and register for activities (<em>cannot be the same as your email address</em>)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/_LocationEdit.cshtml",
                                school ?? new Location(),
                                new ViewDataDictionary()
                                {
                                    { "label", "Enter your school" },
                                    { "searchOnly", true },
                                    { "placeholderText", "Enter your school name" },
                                    { "locationType", (int)LocationType.School }
                                }
                            );
                        }

                        <div class="padding-v-20">
                            <button type="submit" id="btn-add-student" class="btn btn-register btn-lg">Save &amp; Continue &raquo;</button>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#add-student-form').submit(function () {
            $('#btn-add-student').html('Saving Student Info...');
            $('#btn-add-student').prop('disabled', true);
        });
    });
</script>