@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Add Student";
    var msgs = (SystemMessages)ViewBag.Messages;
    var participationObject = (ParticipationObject)ViewBag.ParticipationObject;
    var school = (Location)ViewBag.School;
    var showStepNumber = (bool)ViewBag.ShowStepNumber;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        SessionVariables.RegistrationStartPageAccount,
        new ViewDataDictionary()
        {
            { "ParticipationObject", participationObject },
            { "IsDuringProfileSetup", true }
        }
    );
}


@{
    Html.RenderPartial
    (
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(participationObject, true),
        new ViewDataDictionary()
        {
            { "hidebuttons", true }
        }
    );
}

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <div>

                    <div class="text-center reg-instructions">
                        <p>
                            <strong>
                                @if (showStepNumber)
                                {
                                    <span>Step 5 of 6: </span>
                                }
                                Student Information
                            </strong>
                        </p>
                    </div>

                    <form class="form-horizontal" id="add-student-form" method="post" action="@Url.Action("addstudent", "account")" onkeydown="return event.key != 'Enter';">

                        @foreach (var qvm in Model)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);

                            if (qvm.Question.QuestionDataTypeId == QuestionDataType.RegistrantEmail)
                            {
                                var selected = "";

                                if (Request["createUserAccount"].IsNumber())
                                {
                                    selected = "checked=\"checked\"";
                                }

                                <div class="row hide">
                                    <div class="col-md-6 col-md-offset-3">
                                        <div class="am-checkbox">
                                            <input type="checkbox" id="createUserAccount" name="createUserAccount" value="1" @selected />
                                            <label for="createUserAccount">
                                                Allow my child to login and register for activities (<em>cannot be the same as your email address</em>)
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        <div class="form-group">
                            <div class="col-md-3 control-label">
                                School <span class="text-danger">*</span>
                            </div>
                            <div class="col-md-6">
                                @{ Html.RenderPartial(
                                        "~/Views/Shared/Components/_GoogleLocationEdit.cshtml",
                                        new Location() { },
                                        new ViewDataDictionary() { { "types", "establishment" }, { "description", "Enter your school name" } });
                                }                                
                                <div class="am-checkbox">
                                    <input type="checkbox" id="schoolnotfound" name="schoolnotfound" value="true"/>
                                    <label for="schoolnotfound">
                                        I can’t find my child’s school or my child is homeschooled
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row padding-v-20">
                            <div class="col-md-6 col-md-offset-3">
                                <button type="submit" id="btn-add-student" class="btn btn-register-primary btn-lg">Save &amp; Continue &raquo;</button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#add-student-form').submit(function () {
            $('#btn-add-student').html('Saving Student Info...');
            $('#btn-add-student').prop('disabled', true);
        });

        $('#schoolnotfound').click(function () {
            if ($(this).prop("checked") == true) {
                $('#location').val('');
                $('#placeid').val('');
            }
        });
    });
</script>

@if (participationObject.IsActivityGroup() && participationObject.GetActivityGroup().ActivityGroupTypeId == ActivityGroupType.Session)
{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_BrowseCart.cshtml",
        participationObject,
        new ViewDataDictionary()
        {
            { "IsDuringCheckout", true },
            { "AllowToModifyCart", false }
        }
    );
}