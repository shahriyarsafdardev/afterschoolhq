@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Already withdrawn";
    var providerEmail = (string) ViewBag.ProviderEmail;
}
<style>
    .btn-border {
        font-size: 13px;
        letter-spacing: 2px;
        text-shadow: 0px 0px 0px #000000;
        font-weight: 500;
        border-color: #FEFFFF;
        padding: 15px 20px 15px 20px;
        border-radius: 10px 10px 10px 10px;
        border-width: 4px 4px 4px 4px;
    }
    .btn-clean {
        box-shadow: 0 1px 3px rgba(0,0,1,.25), inset 0 1px 0 0 rgba(255,255,255,.15);
    }
    .img-101-style {
        width: 100px;
    }
    .btn-caribbean-green {
        background: #00C5A3;
        color: #FFFFFF;
    }
    .wire-btn-caribbean-green {
        color: #00C5A3 !important;
        border-color: #00C5A3;
    }
    .btn-caribbean-green:hover {
        background: #009e82;
        color: #FFFFFF;
    }

</style>
@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }

<div class="col-md-6 col-md-offset-3 col-sm-12 margin-t-35 text-center">
    <img src="~/img/warning.png" class="img-fluid img-101-style" alt="warning"/>
    <h1 class="font-weight-500">
        Payment Not Available
    </h1>
    <h3 class="margin-t-30">
        You are unable to pay because you are currently withdrawn from this activity. Please contact the provider if you believe this is an error.
    </h3>
    <div>
        <a href="mailto:@providerEmail" class="btn wire-btn-caribbean-green margin-r-20 btn-border margin-t-35 btn-clean">EMAIL PROVIDER</a>
        <a href="@Url.Action("Index", "Home", new {Area = "User"})" class="btn btn-caribbean-green btn-border margin-t-35 btn-clean">RETURN TO ACCOUNT</a>
    </div>
</div>