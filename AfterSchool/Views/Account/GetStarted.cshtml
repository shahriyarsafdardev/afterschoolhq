@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Get Started";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var registrationAccount = (Account)ViewBag.RegistrationAccount;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }

<div class="reg-header">

    <div class="row">
        <div class="col-md-8 col-sm-12">
            <div>
                @foreach (var item in cart.GetCartItems())
                {
                    <div>
                        <h1>You are registering for&#58; @item.GetParticipationObject().Name</h1>
                    </div>
                }
            </div>
            <div>
                Enter your information below to begin your simplest registration yet.
            </div>
        </div>

        <div class="col-md-4 col-sm-12 hide">
            <div class="pull-right">
                <a href="@SessionVariables.RegistrationStartPageAccount.HomePageUrl" class="btn btn-alt8">
                    &laquo; @SessionVariables.RegistrationStartPageAccount.Name Home
                </a>
            </div>
        </div>
    </div>

</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <div class="text-center reg-instructions">
                    <p><strong>Step 1 of 6: Parent / Guardian Information</strong></p>
                </div>

                @if (SessionVariables.CurrentUser.IsEmpty())
                {
                    <div class="text-center reg-login new-account">
                        <p>
                            If this is your first time signing up, we'll keep it quick. <br />Even better: you'll only have to input parent information once.
                        </p>
                        <br />
                        <p>
                            Already have an account? 
                            <a href="#" class="md-trigger" data-modal="modal-login">
                                Login
                            </a>
                        </p>
                        <p>
                            Are you a student? 
                            <a href="@Url.Action("getstartedstudent", "account", new { regaccount = Request["regaccount"] })">
                                Register Here
                            </a>
                        </p>
                    </div>
                }

                <div>
                    <form class="form-horizontal" id="signup-form" method="post" action="@Url.Action("getstarted", "account")">
                        @foreach (var qvm in Model)
                        {                            
                            Html.RenderPartial(
                                "~/Views/Shared/Form/_Question.cshtml", 
                                qvm);

                            if (qvm.Question.QuestionDataTypeId == QuestionDataType.RegistrantMobilePhone)
                            {
                                <div class="row">
                                    <div class="col-md-6 col-md-offset-3">
                                        <div class="am-checkbox text-center">
                                            <input type="checkbox" id="textnotifications" name="textnotifications" value="1" @(Request["textnotifications"] == "1" || System.Web.HttpContext.Current.Request.HttpMethod.ToString() == "GET" ? " checked=\"checked\" " : "") />
                                            <label for="textnotifications">
                                                I would like to receive text messages about my student&#39;s activities&#46;
                                                Notifications may include information about attendance&#44; reminders&#44; and important information&#46;
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            }
                        }

                        @if (SessionVariables.LoggedInUser.IsEmpty())
                        {
                            <div class="form-group new-account">
                                <label for="password1" class="control-label col-md-3">
                                    Password <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-6">
                                    <input type="password" class="form-control" id="password1" name="password1" />
                                </div>
                            </div>

                            <div class="form-group new-account">
                                <label for="password1" class="control-label col-md-3">
                                    Verify Password <span class="text-danger">*</span>
                                </label>
                                <div class="col-md-6">
                                    <input type="password" class="form-control" id="password2" name="password2" />
                                </div>
                            </div>
                        }

                        <div class="row padding-v-20">
                            <div class="col-md-6 col-md-offset-3">
                                <div class="am-checkbox text-center">
                                    <input type="checkbox" id="agree" name="agree" value="1" @(Request["agree"] == "1" ? " checked=\"checked\" " : "") />
                                    <label for="agree">
                                        I agree to the <a href="@Url.Action("tos", "legal")" target="_blank">terms and services</a> of using @UILabel.ProductName()
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="padding-v-20">
                            <button type="submit" id="btn-create-account" class="btn btn-register btn-lg">Save &amp; Continue &raquo;</button>
                        </div>

                        <div class="row">
                            <div class="padding-v-20 text-center">
                                <a href="javascript:history.go(-1)" class="text-muted">&laquo; Back</a>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#signup-form').submit(function () {
            $('#btn-create-account').html('Saving...');
            $('#btn-create-account').prop('disabled', true);
        });
    });
</script>