@using Utilities = AfterSchoolLibrary.Helpers.Utilities
@model AfterSchool.Assemblers.ThankYouResult
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Thank you";
    var msgs = Model.Messages;
    var account = Model.Account;
    var registrant = Model.Registrant;
    var isSelfRegistered = Model.IsSelfRegistered;
    var assignmentType = Model.AssignmentType;
    var participationObject = Model.ParticipationObject;
    var currentUser = Model.CurrentUser;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }

<div>
    <div class="col-md-6 col-md-offset-3 text-center">
        <div class="panel">
            <div class="panel-body">

                <h1>Thank You</h1>

                <div class="reg-ul">
                    <p>
                        @if (isSelfRegistered)
                        {
                            <span>You have</span>
                        }
                        else
                        {
                            <span><strong>@registrant.FirstName</strong> has</span>
                        }

                        @if (assignmentType == RegistrationAssignmentType.Applied)
                        {
                            <span>
                                <strong>applied</strong>
                            </span>
                        }
                        else if (assignmentType == RegistrationAssignmentType.WaitingList)
                        {
                            <span>been placed on the <strong>waiting list</strong></span>
                        }
                        else
                        {
                            <span>been <strong>registered</strong></span>
                        }
                        for <strong>@participationObject.Name</strong>
                    </p>
                    @if (currentUser.IsRegistered)
                    {
                        <p>
                            <a href="@Url.Action("index", "home", new {area = "user"})">View your account</a>
                        </p>
                    }
                </div>

                <div>
                    @if (!currentUser.IsRegistered)
                    {
                        <hr/>
                        <p>
                            Thank you for your interest! We've helped thousands of parents find activities for their children and we'd love to do the same for you. Click the link below to join the @UILabel.ProductName() family.
                        </p>
                        <p>
                            <a href="@Utilities.CompleteSignUpUrl(currentUser.Uid)">
                                Complete Account Sign Up &raquo;
                            </a>
                        </p>
                    }
                    else if (participationObject.IsInviteOnly)
                    {
                        <hr/>
                        <div class="margin-v-20">
                            <p>
                                <a href="@participationObject.GetHomePageUrl()" class="btn btn-xl btn-register-primary btn-register-xl">Register another child</a>
                            </p>
                        </div>
                    }
                    else
                    {
                        <hr/>

                        if (true)
                        {
                            Html.RenderPartial(
                                "~/Views/Shared/Registration/_RegisterButton.cshtml",
                                participationObject,
                                new ViewDataDictionary
                                {
                                    {"anotherChild", true},
                                    {"condensed", true},
                                });
                        }

                        <div class="margin-v-10">
                            <p>
                                <a href="@account.HomePageUrl" class="btn btn-xl btn-register-primary btn-register-xl">Find another activity</a>
                            </p>
                        </div>
                    }
                </div>

            </div>
        </div>

        <div class="panel">
            <div class="panel-body">

                <div>
                    @{ Html.RenderPartial(
                           "~/Views/Shared/Registration/_ShareLinks.cshtml",
                           new ViewDataDictionary
                           {
                               {"ShareObject", participationObject.Name},
                               {"ShareUrl", participationObject.GetHomePageUrl()},
                           }
                           ); }
                </div>

            </div>
        </div>

    </div>
</div>

@{ Html.RenderPartial("~/Views/Shared/JavascriptIncludes/_Beamer.cshtml"); }