@model List<Registrant>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Thank you";
    var msgs = (SystemMessages)ViewBag.Messages;
    var account = (Account)ViewBag.Account;
    var registration = (Registration)ViewBag.Registration;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div>
   
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                <h1>Thank You</h1>
                <p>
                    You have been registered
                </p>

                <div>
                    @Html.Raw(Registration.GetRegistrationConfirmationHtml(registration, account, null, null, null))
                </div>

                <div>
                    <a href="@account.HomePageUrl" class="btn btn-xl btn-primary center-block">Register for another activity</a>
                </div>

            </div>
        </div>
    </div>
</div>