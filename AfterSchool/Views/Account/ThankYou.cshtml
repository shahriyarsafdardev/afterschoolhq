@model List<Registrant>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Thank you";
    var msgs = (SystemMessages)ViewBag.Messages;
    var account = (Account)ViewBag.Account;
    var registration = (Registration)ViewBag.Registration;
    var registrant = (Registrant)ViewBag.Registrant;
    var isSelfRegistered = (bool)ViewBag.IsSelfRegistered;
    var assignmentType = registration.GetRegistrantActivities().First().AssignmentTypeId;
    var participationObject = registration.GetParticipationObject();
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }


<div>
    <div class="col-md-6 col-md-offset-3 text-center">
        <div class="panel">
            <div class="panel-body">

                <h1>Thank You</h1>

                <div class="reg-ul">
                    <p>
                        @(isSelfRegistered ? "You have" : $"{registrant.FirstName} has") 
                        @if(assignmentType == RegistrationAssignmentType.Applied)
                        {
                            <span>applied</span>
                        }
                        else if (assignmentType == RegistrationAssignmentType.WaitingList)
                        {
                            <span>been placed on the waiting list</span>
                        }
                        else
                        {
                            <span>been registered</span>
                        }
                        for <strong>@participationObject.Name</strong>
                    </p>
                    <p>
                        <a href="@Url.Action("index", "home", new { area = "user" })" target="_blank">View your account</a>
                    </p>
                </div>

                <div>
                    <a href="@account.HomePageUrl" class="btn btn-xl btn-register btn-register-xl">Register for another activity</a>
                </div>

            </div>
        </div>
    </div>
</div>