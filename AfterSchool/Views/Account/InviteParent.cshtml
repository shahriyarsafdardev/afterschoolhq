@model List<FormQuestionViewModel>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Invite Parent";
    var cart = (Cart)ViewBag.Cart;
    var msgs = (SystemMessages)ViewBag.Messages;
}
@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }
@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }

<div class="reg-header">
    <div>
        @foreach (var item in cart.GetCartItems())
        {
            <div>
                <h1>You are registering for: @item.GetParticipationObject().Name</h1>
            </div>
        }
    </div>
</div>

<div>
    <div class="am-content">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="text-center">
                    <h5>Enter your Parent/Guardian Info</h5><br />
                </div>
                <div class="panel-body">
                    <form method="post" id="invite-parent-form" class="form-horizontal" action="@Url.Action("InviteParent", "account")">

                        @foreach (var item in Model)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", item);
                        }
                        <button type="submit" id="btn-invite-parent" class="btn btn-register btn-lg">Next</button>
                    </form>
                </div>
            </div>
            <div class="text-center out-links"><a href="/">&copy; @DateTime.UtcNow.Year @UILabel.ProductName()</a></div>
        </div>
    </div>

</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#invite-parent-form').submit(function () {
            $('#btn-invite-parent').html('Saving...');
            $('#btn-invite-parent').prop('disabled', true);
        });
    });
</script>