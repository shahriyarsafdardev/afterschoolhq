@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Thank you";
    var msgs = (SystemMessages)ViewBag.Messages;
    var account = (Account)ViewBag.Account;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", account); }

<div>
    <div class="col-md-6 col-md-offset-3 text-center">
        <div class="panel">
            <div class="panel-body">

                <h1>Thank You</h1>

                <div class="reg-ul">
                    <p>
                        <span>You have</span>
                        <span>sent a payment to @account.Name</span>
                    </p>
                    <p>
                        <a href="@Url.Action("index", "home", new { area = "user" })">View your account</a>
                    </p>
                </div>

                <div>
                    <a href="@account.HomePageUrl" class="btn btn-xl btn-register-primary btn-register-xl">Register for an activity</a>
                </div>

            </div>
        </div>
    </div>
</div>