@model List<Registrant>
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Select Student";
    var msgs = (SystemMessages)ViewBag.Messages;
    var cart = (Cart)ViewBag.Cart;
    var participationObject = (ParticipationObject)ViewBag.ParticipationObject;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<div>
    <h1>Select Student</h1>
    <div>
        Please select your student below
    </div>
</div>

<div>
    <div class="col-md-12">
        <div class="panel">
            <div class="panel-body">

                @foreach(var registrant in Model)
                {
                    var isRegistered = registrant.IsRegisteredFor(participationObject);
                    var btnText = isRegistered ? "Already Registered" : "Register";
                    var disabledText = isRegistered ? " disabled=\"disabled\" " : "";

                    <div class="col-md-3">
                        <p>@registrant.DisplayName</p>
                        <p>@registrant.GetAnswer(QuestionDataType.RegistrantGrade).Text Grade</p>
                        <p>
                            <a href="@Url.Action("setstudent", "account", new { id = registrant.Uid })" 
                               class="btn btn-primary btn-lg"
                               @disabledText>
                               @btnText
                            </a>
                        </p>
                    </div>
                }

                <div class="col-md-3">
                    <p>New Child</p>
                    <p>-</p>
                    <p><a href="@Url.Action("addstudent", "account")" class="btn btn-primary btn-lg">Add Child</a></p>
                </div>

            </div>
        </div>
    </div>
</div>