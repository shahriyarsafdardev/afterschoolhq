@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = "Registration Complete";
    var msgs = (SystemMessages) ViewBag.Messages;
    var registrant = (Registrant) ViewBag.Registrant;
    var assignmentType = (RegistrationAssignmentType) ViewBag.AssignmentType;
    var participationObject = (ParticipationObject) ViewBag.ParticipationObject;
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", SessionVariables.RegistrationStartPageAccount); }

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
        new RegistrationHeaderViewModel(participationObject, true),
        new ViewDataDictionary
        {
            {"hidebuttons", true},
        });
}

<div>
    <div class="text-center">
        <div class="panel">
            <div class="panel-body">
                <div class="col-md-8 col-md-offset-2">

                    <h1>Registration Complete!</h1>

                    <div class="reg-ul">
                        <p>
                        <span>You have reserved a spot in <strong>@participationObject.Name</strong>. Your registration will be confirmed once your parent or guardian accepts their invitation and enters the required information.</span>
                    </div>

                    <div class="margin-v-10">
                        <div class="col-md-6 col-md-offset-3">
                            <a href="@Url.Action("index", "home", new {area = "user"})" onclick="return showLoader()"
                               class="btn btn-xl btn-register-primary btn-register-xl">
                                View Account
                            </a>
                        </div>
                    </div>

                    <div class="margin-v-10">
                        <div class="col-md-6 col-md-offset-3">
                            <a href="@participationObject.GetHomePageUrl()" onclick="return showLoader()"
                               class="btn btn-xl btn-register-primary btn-register-xl">
                                Register for Another Activity
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel">
            <div class="panel-body">

                <div>
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/Registration/_ShareLinks.cshtml",
                            new ViewDataDictionary
                            {
                                {"ShareObject", participationObject.Name},
                                {"ShareUrl", participationObject.GetHomePageUrl()},
                            });
                    }
                </div>

            </div>
        </div>

    </div>
</div>