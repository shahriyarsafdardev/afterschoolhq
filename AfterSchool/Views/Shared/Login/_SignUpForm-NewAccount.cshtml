@{
    var showPhone = false;

    if (ViewData["showphone"].IsNotEmpty() && ViewData["showphone"].ToString().IsBoolean())
    {
        showPhone = ViewData["showphone"].ToString().ToBoolean();
    }
}

@helper RenderAccountType(AccountType accountType)
{
    var checkedString = "";

    if (((int)accountType).ToString() == Request.Form["orgtype"])
    {
        checkedString = "checked=\"checked\"";
    }

    <div class="am-radio inline">
        <input type="radio" name="accounttype" id="accounttype-@((int)accountType)" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#nick-handler" required="required" autocomplete="off" class="form-control" data-parsley-id="4" value="@((int)accountType)" @checkedString />
        <label for="accounttype-@((int)accountType)">
            <span class="text-white">@accountType.ToString().SplitByUpperCase()</span>
        </label>
    </div>
}

<div class="sign-up-form">

    <div class="form-group">
        <div class="text-center">
            <p class="text-medium-small text-white">
                Choose your organization type
            </p>

            @RenderAccountType(AccountType.ActivityProvider)
            @RenderAccountType(AccountType.School)

        </div>
    </div>
    
    <div class="form-group">
        <p>&nbsp;</p>
    </div>

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-culture"></i></span>
            <input type="text" name="orgname" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#nick-handler" required="required" placeholder="Organization / Program Name" autocomplete="off" class="form-control" data-parsley-id="4" value="@Request.Form["orgname"]" />
        </div>
    </div>

    <div class="form-group">
        <div id="phone-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-phone"></i></span>
            <input type="text" name="phone" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#phone-handler" required="required" placeholder="Organization Phone" autocomplete="off" class="form-control" data-parsley-id="6" value="@Request.Form["phone"]" />
        </div>
    </div>
    
    <div class="form-group">
        <p>&nbsp;</p>
    </div>

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="firstname" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#nick-handler" required="required" placeholder="Your First Name" autocomplete="off" class="form-control" data-parsley-id="4" value="@Request.Form["firstname"]" />
        </div>
    </div>

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="lastname" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#nick-handler" required="required" placeholder="Your Last Name" autocomplete="off" class="form-control" data-parsley-id="4" value="@Request.Form["lastname"]">
        </div>
    </div>
    
    <div class="form-group">
        <div id="email-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-mail"></i></span>
            <input type="email" name="email" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#email-handler" required="required" placeholder="Your E-mail" autocomplete="off" class="form-control" data-parsley-id="6" value="@Request.Form["email"]" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-xs-6">
            <div id="password-handler" class="input-group">
                <span class="input-group-addon"><i class="icon s7-lock"></i></span>
                <input id="password1" name="password1" type="password" data-parsley-errors-messages-disabled="true" placeholder="Password" data-parsley-class-handler="#password-handler" required="required" class="form-control" data-parsley-id="8">
            </div>
        </div>
        <div class="col-xs-6">
            <div id="confirm-handler" class="input-group">
                <span class="input-group-addon"><i class="icon s7-lock"></i></span>
                <input name="password2" parsley-equalto="#pass1" type="password" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#confirm-handler" required="required" placeholder="Confirm" class="form-control" data-parsley-id="10">
            </div>
        </div>
    </div>
</div>
<p class="conditions">By creating an account, you agree with the <a href="~/Public/tos.html" target="_blank">Terms and Conditions</a>.</p>
<button type="submit" class="btn btn-block btn-primary btn-lg">Sign Up &raquo;</button>
