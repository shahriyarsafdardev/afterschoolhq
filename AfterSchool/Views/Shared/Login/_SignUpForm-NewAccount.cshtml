@model SignUpIndexViewModel

@Html.AntiForgeryToken()

<div class="sign-up-form">

    <input id="hidden-signup-accountName" type="hidden" name="OrgName" value="@Model.OrgName" />
    <input id="hidden-signup-accountType" type="hidden" name="OrgType" value="@Model.OrgType" />
    <input id="hidden-invitecode" type="hidden" name="invitecodetoshare" value="@Model.InviteCodeToShare" />
    <input id="hidden-isrequestaccessonly" type="hidden" name="isrequestonlyaccess" value="@Model.IsRequestOnlyAccess.ToString()" />

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="firstname" required="required" placeholder="First Name" autocomplete="off" class="form-control" value="@Model.FirstName" />
        </div>
    </div>

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="lastname" required="required" placeholder="Last Name" autocomplete="off" class="form-control" value="@Model.LastName">
        </div>
    </div>

    <div class="form-group">
        <div id="email-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-mail"></i></span>
            <input type="email" name="email" required="required" placeholder="E-mail" autocomplete="off" class="form-control" value="@Model.Email" />
        </div>
    </div>

    <div class="form-group">
        <div id="password-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
            <input type="password" name="password1" required="required" placeholder="Password" class="form-control" />
        </div>
    </div>

    <div class="form-group">
        <div id="confirm-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
            <input type="password" name="password2" required="required" placeholder="Confirm Password" class="form-control">
        </div>
    </div>

    <div class="form-group text-center">
        @if (AfterSchoolLibrary.Helpers.Utilities.IsProduction && AfterSchoolLibrary.Helpers.Utilities.IsStaging)
        {
            Html.RenderPartial("~/Views/Shared/Form/_Recaptcha.cshtml", "");
        }
    </div>

</div>

<div class="clearfix"></div>
<br />
<p class="conditions text-center">By creating an account, you agree with the <a href="/tos" target="_blank">Terms and Conditions</a>.</p>

<div class="visible-md visible-lg margin-v-30">
    <a href="#" class="pull-left" onclick="return proceedBack('7')">&laquo; Back</a>
    <button type="submit" class="btn btn-primary btn-lg pull-right">Get Started &raquo;</button>
</div>

<div class="visible-sm visible-xs margin-v-30">
    <button type="submit" class="btn btn-primary btn-lg pull-right col-xs-12">Get Started &raquo;</button>

    <div class="clearfix"></div>
    <div class="text-center margin-v-30">
        <a href="#" class="text-muted" onclick="return proceedBack('7')">&laquo; Back</a>
    </div>
</div>

