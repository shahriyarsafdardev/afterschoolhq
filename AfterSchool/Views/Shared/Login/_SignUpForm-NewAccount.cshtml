@{
    var showPhone = false;

    if (ViewData["showphone"].IsNotEmpty() && ViewData["showphone"].ToString().IsBoolean())
    {
        showPhone = ViewData["showphone"].ToString().ToBoolean();
    }
}

@helper RenderAccountType(AccountType accountType)
{
    var checkedString = "";

    if (((int)accountType).ToString() == Request.Form["orgtype"])
    {
        checkedString = "checked=\"checked\"";
    }

    <div class="am-radio inline">
        <input type="radio" name="orgtype" id="accounttype-@((int)accountType)" required="required" autocomplete="off" class="form-control" value="@((int)accountType)" @checkedString />
        <label for="accounttype-@((int)accountType)">
            <span>@accountType.ToString().SplitByUpperCase()</span>
        </label>
    </div>
}

<div class="sign-up-form">

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-culture"></i></span>
            <input type="text" name="orgname" required="required" placeholder="Organization / Program Name" autocomplete="off" class="form-control" value="@Request["orgname"]" />
        </div>
    </div>

    <div class="form-group">
        <div id="phone-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-phone"></i></span>
            <input type="text" name="phone" required="required" placeholder="Organization Phone" autocomplete="off" class="form-control" value="@Request.Form["phone"]" />
        </div>
    </div>
    
    <div class="form-group">
        <div class="text-center">
            <p class="text-medium-small">
                Choose your organization type
            </p>

            @RenderAccountType(AccountType.ActivityProvider)
            @RenderAccountType(AccountType.School)

        </div>
    </div>

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="firstname" required="required" placeholder="Your First Name" autocomplete="off" class="form-control" value="@Request.Form["firstname"]" />
        </div>
    </div>

    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="lastname" required="required" placeholder="Your Last Name" autocomplete="off" class="form-control" value="@Request.Form["lastname"]">
        </div>
    </div>
    
    <div class="form-group">
        <div id="email-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-mail"></i></span>
            <input type="email" name="email" required="required" placeholder="Your E-mail" autocomplete="off" class="form-control" value="@Request.Form["email"]" />
        </div>
    </div>

    <div class="form-group">
        <div id="password-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
            <input id="password1" name="password1" type="password" required="required" class="form-control" placeholder="Your Password" />
        </div>
    </div>
    <div class="form-group">
        <div id="confirm-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
            <input name="password2" type="password" required="required" placeholder="Confirm Password" class="form-control">
        </div>
    </div>
</div>
<p class="conditions">By creating an account, you agree with the <a href="~/Public/tos.html" target="_blank">Terms and Conditions</a>.</p>
<button type="submit" class="btn btn-block btn-primary btn-lg">Sign Up &raquo;</button>
