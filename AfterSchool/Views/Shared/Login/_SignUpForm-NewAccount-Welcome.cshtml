@model SignUpIndexViewModel

@Html.AntiForgeryToken()

<div class="sign-up-form">

    <input id="hidden-signup-accountName" type="hidden" name="OrgName" value="@Model.OrgName" />
    <input id="hidden-signup-accountType" type="hidden" name="OrgType" value="@Model.OrgType" />
    <input id="hidden-invitecode" type="hidden" name="invitecodetoshare" value="@Model.InviteCodeToShare" />
    <input id="hidden-isrequestaccessonly" type="hidden" name="isrequestonlyaccess" value="@Model.IsRequestOnlyAccess.ToString()" />
    <input id="hidden-signup-type" type="hidden" name="signuptype" value="@Model.SignupType" />


    <div class="col-md-6 onboarding-form-group">
        <label class="onboarding-lable">FIRST NAME</label>
        <input type="text" name="firstname" required="required" autocomplete="off" class="form-control onboarding-input" value="@Model.FirstName" />
    </div>

    <div class="col-md-6 onboarding-form-group">
        <label class="onboarding-lable">LAST NAME</label>
        <input type="text" name="lastname" required="required" autocomplete="off" class="form-control onboarding-input" value="@Model.LastName">
    </div>

    <div class="col-md-12 onboarding-form-group">
        <label class="onboarding-lable">EMAIL ADDRESS</label>
        <input type="email" name="email" required="required" autocomplete="off" class="form-control onboarding-input" id="email" value="@Model.Email" onblur="validateEmailServerSide(this.value)" />
    </div>

    <div class="col-md-12 onboarding-form-group">
        <label class="onboarding-lable">PASSWORD</label>
        <input type="password" name="password1" required="required" class="form-control onboarding-input" />
    </div>

    <div class="col-md-12 onboarding-form-group">
        <label class="onboarding-lable">CONFIRM PASSWORD</label>
        <input type="password" name="password2" required="required" class="form-control onboarding-input">
    </div>
    <div class="col-md-12 onboarding-form-group">
        <label class="onboarding-lable">HOW'D YOU HEAR ABOUT US?</label>
        <select required="required" name="HowHearAboutUs" id="HowHearAboutUs" class="form-control onboarding-input" style="height:40px">
            <option value=""></option>
            <option value="Ad">Ad</option>
            <option value="Conference/Event">Conference/Event</option>
            <option value="Email">Email</option>
            <option value="My School">My School</option>
            <option value="Search Engine">Search Engine</option>
            <option value="Social Media">Social Media</option>
            <option value="Word of Mouth">Word of Mouth</option>
            <option value="Other">Other</option>
        </select>
    </div>

    <div class="clearfix"></div>
    <div class="text-center onboarding-form-group" style="margin-top: 20px;">
        @if (AfterSchoolLibrary.Helpers.Utilities.IsProduction || AfterSchoolLibrary.Helpers.Utilities.IsStaging)
        {
            Html.RenderPartial("~/Views/Shared/Form/_Recaptcha.cshtml", "");
        }
    </div>

</div>

<div class="clearfix"></div>
<br />
<p class="conditions text-center">By creating an account, you agree with the <a href="/tos" target="_blank">Terms and Conditions</a>.</p>

<div class="visible-md visible-lg margin-v-30">

    <a href="#" class="process-back" onclick="return proceedBack('7')">
        <img src="~/img/welcome-back-arrow.PNG" />
    </a>

    <button type="submit" class="btn btn-primary pull-right register-continue">Continue</button>
</div>

<div class="visible-sm visible-xs margin-v-30">
    <button type="submit" class="btn btn-primary btn-lg pull-right col-xs-12 register-continue">Continue</button>

    <div class="clearfix"></div>
    <div class="text-center margin-v-30">
        <a href="#" class="text-muted" onclick="return proceedBack('7')">Back</a>
    </div>
</div>

