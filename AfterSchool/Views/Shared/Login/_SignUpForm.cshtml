@model WebUser

@{
    var showPhone = false;

    if (ViewData["showphone"].IsNotEmpty() && ViewData["showphone"].ToString().IsBoolean())
    {
        showPhone = ViewData["showphone"].ToString().ToBoolean();
    }
}

<div class="sign-up-form">
    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="firstname" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#nick-handler" required="required" placeholder="First Name" autocomplete="off" class="form-control" data-parsley-id="4" value="@Model.FirstName" />
        </div>
    </div>
    <div class="form-group">
        <div id="nick-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-user"></i></span>
            <input type="text" name="lastname" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#nick-handler" required="required" placeholder="Last Name" autocomplete="off" class="form-control" data-parsley-id="4" value="@Model.LastName">
        </div>
    </div>
    <div class="form-group">
        <div id="email-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-mail"></i></span>
            <input type="email" name="email" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#email-handler" required="required" placeholder="E-mail" autocomplete="off" class="form-control" data-parsley-id="6" value="@Model.Email" />
        </div>
    </div>

    @if (showPhone)
    {
        <div class="form-group">
            <div id="phone-handler" class="input-group">
                <span class="input-group-addon"><i class="icon s7-phone"></i></span>
                <input type="text" name="phone" data-parsley-trigger="change" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#phone-handler" required="required" placeholder="Phone" autocomplete="off" class="form-control" data-parsley-id="6" value="@Model.Phone" />
            </div>
        </div>
    }

    <div class="form-group">
        <div id="password-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
            <input id="password1" name="password1" type="password" data-parsley-errors-messages-disabled="true" placeholder="Create Password" data-parsley-class-handler="#password-handler" required="required" class="form-control" data-parsley-id="8">
        </div>            
    </div>

    <div class="form-group">
        <div id="confirm-handler" class="input-group">
            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
            <input name="password2" parsley-equalto="#pass1" type="password" data-parsley-errors-messages-disabled="true" data-parsley-class-handler="#confirm-handler" required="required" placeholder="Confirm" class="form-control" data-parsley-id="10">
        </div>
    </div>
</div>
<p class="conditions">By creating an account, you agree with the <a href="/tos" target="_blank">Terms and Conditions</a>.</p>
<button type="submit" class="btn btn-block btn-primary btn-lg" style="margin-bottom: 10px;">Sign Up &raquo;</button>
<div style="text-align:center">
    <a href="@AfterSchoolLibrary.Helpers.CleverHelper.SSOLink" class="btn-clever-login">
        <img src="~/img/CleverSSO.png" style="width: 225px; height: 50px;" class="clever-login-img" />
    </a>
</div>
