@{
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var groupController = ViewBag.GroupController;
}

    <div class="btn-toolbar">
        <div class="btn-group hidden-xs">
            <a href="@Url.Action("index", @groupController)" class="btn btn-alt6@(actionName == "summary" ? "-active" : "")"><i class="s7-graph2"></i>Internal</a>
           <a href="@Url.Action("indexexternal", @groupController)" class="btn btn-alt6@(actionName == "summary" ? "-active" : "")"><i class="s7-graph2"></i>External</a>
          
        </div>
        <div class="hidden-lg hidden-sm hidden-md">
            <select class="form-control" onchange="location.href=this.value;">
                <option value="">Navigation</option>
                <option value="@Url.Action("index",  @groupController)">Internal</option>
                <option value="@Url.Action("indexexternal",  @groupController)">External</option>
            </select>
        </div>
    </div>