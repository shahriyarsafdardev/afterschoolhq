<div id="upgrade-my-plan">
    <div class="Container">
        <span class="span-upgrade-modal-close" onclick="return hideUpgradeMyPlan()">X</span>
        <div class="col-md-offset-3 col-lg-6 col-md-6 col-sm-6">
            <h2 id="gain-access">Gain access to this feature by upgrading your plan</h2>            
        </div>
        <div class="col-md-1 col-sm-12 visible-md visible-lg">
            <a href="#" class="btn btn-default btn-upgrade-plan btn-lg" onclick="return loadUpgradePage()">Upgrade My Plan</a>
            <div class="clearfix"></div>
        </div>
        <div class="col-sm-6 col-xs-12 visible-xs visible-sm">
            <a href="#" class="btn btn-default btn-upgrade-plan text-center btn-center btn-lg" onclick="return loadUpgradePage()">Upgrade My Plan</a>
            <div class="clearfix"></div>
        </div>
        <div class="clearfix"></div>
    </div>
    <div class="clearfix"></div>
</div>

<script type="text/javascript">
    var featureId;
    function showUpgradeMyPlan(name, id) {
        $('#app-body').addClass('overlay')
        $('#upgrade-my-plan').fadeIn();

        if(name)
            $('#gain-access').append(` to ${name}`);
  
        if(id)
            featureId = id;

    };

    function hideUpgradeMyPlan() {
        $('#app-body').removeClass('overlay')
        $('#upgrade-my-plan').fadeOut();
    };

    function loadUpgradePage() {
        var url = '@Url.Action("newbilling", "account", new { Area = "org", ReturnUrl = "updateThisText"})'
        url = url.replace("updateThisText", location.pathname);
        if (featureId)
            url = url + `&featureId=${featureId}`;

        location.href = url;
    }
</script>