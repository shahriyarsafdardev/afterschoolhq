<div id="upgrade-my-plan">
    <div class="Container">
        <div class="col-md-offset-1 col-md-6 col-sm-12">
            <h2>Get access to payment plans, customizable subscriptions, and more with our Premium plan!</h2>
            <h5>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,</h5>
        </div>
        <div class="col-md-4 col-sm-12 visible-md visible-lg">
            <span class="span-close-upgrade-my-plan" onclick="return hideUpgradeMyPlan()">X</span>
            <a href="#" class="btn btn-danger btn-upgrade-plan" onclick="return loadUpgradePage()">Upgrade My Plan</a>
            <div class="clearfix"></div>
        </div>
        <div class="col-sm-12 visible-xs visible-sm ">
            <a href="#" class="btn btn-danger btn-upgrade-plan" onclick="return loadUpgradePage()">Upgrade My Plan</a>
            <button class="btn btn-warning btn-upgrade-plan" onclick="return hideUpgradeMyPlan()">Close</button>
            <div class="clearfix"></div>
        </div>
        <div class="clearfix"></div>
    </div>
    <div class="clearfix"></div>
</div>

<script type="text/javascript">
    function showUpgradeMyPlan() {
        $('#app-body').addClass('overlay')
        $('#upgrade-my-plan').fadeIn();
    };

    function hideUpgradeMyPlan() {
        $('#app-body').removeClass('overlay')
        $('#upgrade-my-plan').fadeOut();
    };

    function loadUpgradePage() {
        var url = '@Url.Action("newbilling", "account", new { Area = "org", ReturnUrl = "updateThisText" })'
        url = url.replace("updateThisText", location.pathname);
        location.href = url;
    }
</script>