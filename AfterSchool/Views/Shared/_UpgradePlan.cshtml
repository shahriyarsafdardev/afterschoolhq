@using AfterSchoolLibrary.Enums
<div id="upgrade-my-plan">
    <div class="Container">
        <button aria-label="Close" class="modal-close-button" onclick="hideUpgradeMyPlan()" type="button">
            <span aria-hidden="true">&times;</span>
        </button>
        <h2 class="gain-access text-center" style="font-family: Montserrat, sans-serif"></h2>
        <div class="clearfix"></div>
    </div>
    <div class="clearfix"></div>
</div>

<script type="text/javascript">
    let featureId;
    function showUpgradeMyPlan(name, id, preventClose = false) {
        $('#app-body').addClass('overlay')
        $('#upgrade-my-plan').fadeIn();

        if (name)
            $('.gain-access').html(`Upgrade to the ${name} plan to access this feature. <a href="javascript:AccountSetup.getStripeBillingLink('', @((int)BillingPortalConfigurationType.SubscriptionUpdate))" class="btn btn-default btn-upgrade-plan btn-lg" style="font-family: Montserrat, sans-serif">Upgrade My Plan</a>`);
  
        if (id)
            featureId = id;

        if (name === '' || id === '') {
            $('.gain-access').html('This feature is not accessible. contact admin for more information.');
        }

        if (preventClose)
            $('.modal-close-button').hide();
    }

    function hideUpgradeMyPlan() {
        $('#app-body').removeClass('overlay')
        $('#upgrade-my-plan').fadeOut();
    }
    function setFeatureIdAndLoadUpgradePage(id) {
        featureId = id;
        loadUpgradePage();
    }
    function loadUpgradePage() {        
        location.href = AccountSetup.getStripeBillingLink('', @((int)BillingPortalConfigurationType.SubscriptionUpdate)); //url;
    }
</script>