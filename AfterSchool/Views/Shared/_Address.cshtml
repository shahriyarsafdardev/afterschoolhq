@model AddressViewModel

@{ 
    var address1Required = ViewData["address1required"].IsNotEmpty() && ViewData["address1required"].ToString().ToBoolean();
    var address2Required = ViewData["address2Required"].IsNotEmpty() && ViewData["address2Required"].ToString().ToBoolean();
    var cityRequired = ViewData["cityRequired"].IsNotEmpty() && ViewData["cityRequired"].ToString().ToBoolean();
    var stateRequired = ViewData["stateRequired"].IsNotEmpty() && ViewData["stateRequired"].ToString().ToBoolean();
    var postalCodeRequired = ViewData["postalCodeRequired"].IsNotEmpty() && ViewData["postalCodeRequired"].ToString().ToBoolean();

    var labeladdress1Required = false;
    var labeladdress2Required = false;
    var labelcityRequired = false;
    var labelstateRequired = false;
    var labelpostalCodeRequired = false;

    if (ViewData["labeladdress1required"].IsNotEmpty() && ViewData["labeladdress1required"].ToString().ToBoolean())
    {
        labeladdress1Required = ViewData["labeladdress1required"].ToString().ToBoolean();
    }
    else if (ViewData["address1required"].IsNotEmpty() && ViewData["address1required"].ToString().ToBoolean())
    {
        labeladdress1Required = ViewData["address1required"].ToString().ToBoolean();
    }

    if (ViewData["labeladdress2required"].IsNotEmpty() && ViewData["labeladdress2required"].ToString().ToBoolean())
    {
        labeladdress2Required = ViewData["labeladdress2required"].ToString().ToBoolean();
    }
    else if (ViewData["address2required"].IsNotEmpty() && ViewData["address2required"].ToString().ToBoolean())
    {
        labeladdress2Required = ViewData["address2required"].ToString().ToBoolean();
    }

    if (ViewData["labelcityRequired"].IsNotEmpty() && ViewData["labelcityRequired"].ToString().ToBoolean())
    {
        labelcityRequired = ViewData["labelcityRequired"].ToString().ToBoolean();
    }
    else if (ViewData["cityRequired"].IsNotEmpty() && ViewData["cityRequired"].ToString().ToBoolean())
    {
        labelcityRequired = ViewData["cityRequired"].ToString().ToBoolean();
    }

    if (ViewData["labelstateRequired"].IsNotEmpty() && ViewData["labelstateRequired"].ToString().ToBoolean())
    {
        labelstateRequired = ViewData["labelstateRequired"].ToString().ToBoolean();
    }
    else if (ViewData["stateRequired"].IsNotEmpty() && ViewData["stateRequired"].ToString().ToBoolean())
    {
        labelstateRequired = ViewData["stateRequired"].ToString().ToBoolean();
    }

    if (ViewData["labelpostalCodeRequired"].IsNotEmpty() && ViewData["labelpostalCodeRequired"].ToString().ToBoolean())
    {
        labelpostalCodeRequired = ViewData["labelpostalCodeRequired"].ToString().ToBoolean();
    }
    else if (ViewData["postalCodeRequired"].IsNotEmpty() && ViewData["postalCodeRequired"].ToString().ToBoolean())
    {
        labelpostalCodeRequired = ViewData["postalCodeRequired"].ToString().ToBoolean();
    }

    var labelColWidth = 3;
    var maxCols = 12;
    var disabled = false;
    var disabledAttr = "";

    if (ViewData["labelcolwidth"].IsNumber())
    {
        labelColWidth = ViewData["labelcolwidth"].ToString().ToInteger();
    }
    var inputColWidth = maxCols - labelColWidth;

    if (ViewData["disabled"].IsNotEmpty() && ViewData["disabled"].ToString().IsBoolean())
    {
        disabled = ViewData["disabled"].ToString().ToBoolean();
    }

    if (disabled)
    {
        disabledAttr = "disabled=\"disabled\"";
    }

}

<div class="form-group">
    <label class="col-sm-@labelColWidth control-label">
        Street Address
        @if (labeladdress1Required)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <div class="col-sm-@inputColWidth">
        <input type="text" id="address1" name="address1" value="@Model.Address1" class="form-control" onfocus="this.select()" @(address1Required ? "required" : "") @disabledAttr />
    </div>
</div>

<div class="form-group">
    <label class="col-sm-@labelColWidth control-label">
        Apt/Suite
        @if (labeladdress2Required)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <div class="col-sm-@inputColWidth">
        <input type="text" id="address2" name="address2" value="@Model.Address2" class="form-control" onfocus="this.select()" @(address2Required ? "required" : "") @disabledAttr />
    </div>
</div>

<div class="form-group">
    <label class="col-sm-@labelColWidth control-label">
        City
        @if (labelcityRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <div class="col-sm-@inputColWidth">
        <input type="text" id="city" name="city" value="@Model.City" class="form-control" onfocus="this.select()" @(cityRequired ? "required" : "") @disabledAttr />
    </div>
</div>

<div class="form-group">
    <label class="col-sm-@labelColWidth control-label">
        State
        @if (labelstateRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <div class="col-sm-@inputColWidth">
        @{ Html.RenderPartial("~/views/shared/_statedropdown.cshtml", Model.State, new ViewDataDictionary() { { "required", stateRequired }, { "disabled", disabled } }); }
    </div>
</div>

<div class="form-group">
    <label class="col-sm-@labelColWidth control-label">
        Zip Code
        @if (labelpostalCodeRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <div class="col-sm-@inputColWidth">
        <input type="text" id="postalcode" name="postalcode" value="@Model.PostalCode" class="form-control" onfocus="this.select()" @(postalCodeRequired ? "required" : "") @disabledAttr />
    </div>
</div>
