@model ActivityFormDetailsViewModel

<div class="panel panel-default panel-small-padding margin-bottom-zero">
    <div class="panel-heading activity-heading">
        About Your @UILabel.ActivityLabel(Model.Activity.ActivityTypeId)
    </div>
    <div class="panel-body">
        <div class="form-group">
            <label class="col-md-3 control-label">
                Enter details about your @UILabel.ActivityLabel(Model.Activity.ActivityTypeId).ToLower() <span class="text-danger">*</span>
            </label>
            <div class="col-md-9">
                @{ Html.RenderPartial("~/Views/Shared/_TextEditor.cshtml", Model.Details, new ViewDataDictionary
                   {
                       {"required", false},
                       {"name", "details"},
                       {"id", "details"},
                   }); }

                <p class="text-muted">
                    <em>
                        Share information about this opportunity. What can volunteers expect? Are there any requirements (i.e. wear comfortable shoes)?
                    </em>
                </p>
            </div>
        </div>
    </div>
</div>