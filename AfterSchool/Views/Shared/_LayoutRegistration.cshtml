@{ 
    var accountProfile = (AccountProfile)ViewBag.AccountProfile ?? new AccountProfile();
    var account = accountProfile?.GetAccount();
    var author = account?.Name;
    var description = accountProfile?.Headline;
    var propertyTypes = new List<AccountPropertyType>() { AccountPropertyType.AcademicSubjects, AccountPropertyType.Classifications, AccountPropertyType.PricingOption, AccountPropertyType.ServiceOffered, AccountPropertyType.SoftSkills, AccountPropertyType.TeachingMethods, AccountPropertyType.TimeOffered };
    var keywords = account?.GetAccountProperties(propertyTypes).Select(x => x.Value).ToStringList(", ");
    var shortHomePageUrl = account?.ShortHomePageUrl;
    var site = UILabel.ProductName();

    var ah = AfterSchoolLibrary.Helpers.Utilities.GetNewAmazonHelper();
    string logoUrl = null;

    if (accountProfile.Logo.IsNotBlank())
    {
        logoUrl = ah.GetFileLink(accountProfile.Logo, true, null, true);
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <link rel="shortcut icon" href="/favicon.png">
    <link href="https://fonts.googleapis.com/css?family=Montserrat:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&amp;subset=cyrillic,cyrillic-ext,latin-ext,vietnamese" rel="stylesheet">
    <meta name="keywords" content="@keywords">
    <meta name="description" content="@description">
    <meta name="author" content="@author">

    <meta property="og:title" content="@author">
    <meta property="og:description" content="@description">
    <meta property="og:image" content="@logoUrl">
    <meta property="og:url" content="@shortHomePageUrl">
    <meta property="og:site_name" content="@site">

    <meta name="twitter:title" content="@author">
    <meta name="twitter:description" content="@description">
    <meta name="twitter:image" content="@logoUrl">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@("@afterschoolhq")">
    <meta name="twitter:image:alt" content="@author">

    <title>@ViewBag.Title - @site</title>

    @{Html.RenderPartial("~/Views/Shared/_HeadIncludes.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/_ZendeskWidget.cshtml");}

    <link href="~/Assets/css/style-registration.css?v=1.02" type="text/css" rel="stylesheet" />

    @{Html.RenderPartial("~/Views/Shared/Registration/_CustomStyle.cshtml", accountProfile);}

    @*@Html.Raw(SessionVariables.CurrentAccount?.GetAccountProperty(AccountPropertyType.FacebookAdPixel)?.Value)*@
    @RenderSection("fbadevents", required: false)
    @RenderSection("header", required: false)

    <style>
        .layout-footer a {
            color: #fff;
            font-weight: 300;
            font-style: italic;
            font-family: 'Montserrat', sans-serif;
        }
    </style>
    <link href="~/Content/googleTranslate.css" rel="stylesheet" />
</head>


<body class="registration">
    <div class="am-wrapper notopmenu am-nosidebar-left">
        <div class="am-content">
            @RenderBody()
        </div>
    </div>

    <div id="footerShowHide" class="layout-footer text-center">
        <div class="container-footer footer-extended">
            <div class="row" style="padding: 20px">
                <ul class="list-inline last-icon-ul">
                    <li><a href="https://afterschoolhq.com/?utm_source=app&utm_medium=registration" target="_blank">AfterSchool HQ was created</a></li>
                    <li><a href="https://afterschoolhq.com/?utm_source=app&utm_medium=registration" target="_blank"><img src="/assets/img/footer-copy-right-img.png" style="max-width: 60px"></a></li>
                    <li><a href="https://afterschoolhq.com/?utm_source=app&utm_medium=registration" target="_blank">with love in Fishers, IN.</a></li>
                </ul>
            </div>
        </div>
    </div>

    @{Html.RenderPartial("~/Views/Shared/_JavascriptIncludes.cshtml");}

    @RenderSection("scripts", required: false)
    <script src="~/js/googleTranslateJs.js"></script>
    <script type="text/javascript" src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <div id="modal-saving" class="hide" style="position: fixed; width: 250px; height: 65px; top: 10px; right: 10px; padding: 0px; margin: 0px; background-color: white; color: black; border-radius: 10px; border: 1px solid;">
        <h3 class="text-center">Loading...</h3>
    </div>
</body>
</html>