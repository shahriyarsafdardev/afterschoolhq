<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="shortcut icon" href="/assets/img/favicon.png">
    <meta name="keywords" content="app, responsive, jquery, bootstrap, dashboard, admin">
    <title>@ViewBag.Title - @UILabel.ProductName()</title>

    @{Html.RenderPartial("~/Views/Shared/_HeadIncludes.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/_ZendeskWidget.cshtml");}

    <link href="~/Assets/css/style-registration.css" type="text/css" rel="stylesheet" />

    @Html.Raw(SessionVariables.CurrentAccount?.GetAccountProperty(AccountPropertyType.FacebookAdPixel)?.Value)
    @RenderSection("fbadevents", required: false)

</head>


<body class="registration">
    <div class="am-wrapper notopmenu am-nosidebar-left">
        <div class="am-content">
            @RenderBody()
        </div>
    </div>

    <div id="layout-footer">
        <a href="https://afterschoolhq.com/?utm_source=app&utm_medium=registration" target="_blank"><img src="../../Assets/img/powered-by.png" alt="Powered by AfterSchool" height="50" /></a>
        @Html.Raw(AfterSchoolLibrary.Email.GetAppSignature(isAfterSchool: SessionVariables.IsAfterSchool.Value, utm_medium: "website", utm_campaign: "registration"))
    </div>

    @{Html.RenderPartial("~/Views/Shared/_JavascriptIncludes.cshtml");}

    @RenderSection("scripts", required: false)
</body>
</html>