@model Location

@{ 
    var currentAccountId = (int)ViewData["accountId"];
    var location = Model ?? new Location();
    var isMyLocation = currentAccountId == location?.HostAccountId;
    var addressViewModel = isMyLocation ? location.ToAddressViewModel() : new AddressViewModel();

    var hideRelationship = "";
    var hideType = "";

    if (!isMyLocation && location.ID.HasValue)
    {
        hideRelationship = "hide";
        hideType = "hide";
    }

}

<div class="panel panel-default">
    <div class="panel-body">

        @{
            Html.RenderPartial(
            "~/Views/Shared/_LocationEdit.cshtml",
            location,
            new ViewDataDictionary() { { "accountId", currentAccountId } }
        );
        }

        <div id="add-location" class="hide">
            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Location Name <span class="text-danger">*</span>
                    <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Building name or organization name" data-placement="top"></i>
                </label>
                <div class="col-sm-9">
                    <input type="text" name="locationname" id="locationname" value="" class="form-control" />
                </div>
            </div>

            <div class="form-group @hideRelationship" id="hostaccount-div">
                <label class="control-label col-sm-3">Room Number / Specific Instructions</label>
                <div class="col-sm-9">
                    <input type="text" name="locationdescription" id="locationdescription" value="" class="form-control" />
                </div>
            </div>

            <div class="col-sm-9">
                <input type="text" name="locationtype" id="locationtype" value="1" class="form-control hide" />
            </div>

            @{
            Html.RenderPartial(
              "~/Views/Shared/_Address.cshtml",
              addressViewModel
             );
            }

        </div>
      
    </div>
</div>
