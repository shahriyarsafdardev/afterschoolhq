@model FormQuestionGroup

<div class="panel panel-default question-group">
    <div class="panel-heading">
        @Model.Name
    </div>
    <div class="panel-body">
        @foreach (var question in Model.GetActiveQuestions())
        {
            Html.RenderPartial(
            "_RegFormQuestions",
            question,
            new ViewDataDictionary() {
                { "id", "question-" + ((int)question.ID).ToString() },
                { "FieldValues", ViewData["FieldValues"] }
            }
            );
        }
    </div>
</div>
