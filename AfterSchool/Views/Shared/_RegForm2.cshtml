@using System.Collections.Specialized;
@model Activity

@{ 
    var preview = (bool)ViewData["Preview"];
    var questionGroups = (List<FormQuestionGroup>)ViewData["QuestionGroups"];
    var defaultOrgSeatCount = (int)ViewData["DefaultOrgSeatCount"];
    var totalSeatsRemaining = (int)ViewData["TotalSeatsRemaining"];
    var fieldValues = (NameValueCollection)ViewData["FieldValues"];
    var groups = questionGroups.Where(x => x.RegistrantTypeId == RegistrantType.Individual && x.GetActiveQuestionCount() > 0).ToList();

    var previewParam = "";
    var disabledBtn = "";
    if (preview)
    {
        previewParam = "&preview=" + Request.Params["preview"];
        disabledBtn = "disabled=\"disabled\"";
    }
}

<form action="/reg/savemultiple/?activity=@Model.Uid.ToString()@previewParam" method="post" class="form-horizontal" id="registration-form">
    
    @foreach (var group in groups)
    {
        <div id="@group.Name.Replace(" ", "-")">

            <div class="panel panel-default question-group" id="question-group-@group.ID">
                <div class="panel-heading">
                    @group.Name - @(groups.IndexOf(group) + 1) of @groups.Count
                </div>
                <div class="panel-body">
                    @foreach (var question in group.GetActiveQuestions())
                    {
                        Html.RenderPartial(
                            "_RegFormQuestions",
                            question,
                            new ViewDataDictionary() {
                                { "id", "question-" + ((int)question.ID).ToString() },
                                { "FieldValues", fieldValues }
                            }
                            );
                    }
                </div>
                @if (groups.Count > 1)
                {
                    <div class="panel-footer">
                        <button type="button" class="btn btn-primary btn-lg btn-block btn-next" disabled="disabled">Next &raquo;</button>
                    </div>
                }
            </div>
            <input type="hidden" id="numberofseats" name="numberofseats" value="1" />

        </div>
    }

    @if (Model.CostPerRegistrant > 0)
    {
        <div class="panel panel-default">
            <div class="panel-heading">
                Payment
            </div>
            <div class="panel-body">

                <div class="row">
                    <div class="col-sm-6 col-sm-offset-3">
                        <div class="widget widget-tile widget-bordered">
                            <div class="data-info">
                                <div class="value" id="total-cost">@Model.CostPerRegistrant.ToCurrency() x 1 Seat = @((Model.CostPerRegistrant.Value * 1).ToCurrency())</div>
                                <div class="desc">@Model.CostDescription</div>
                            </div>
                            <div class="icon"><span class="s7-credit"></span></div>
                        </div>
                    </div>
                </div>

                @if (Model.CanAcceptPayments())
                {
                    <div class="row">
                        <label class="col-sm-3 control-label">
                            Payment Type
                        </label>
                        <div class="col-sm-6">
                            @if (Model.AcceptCreditCard)
                            {
                                <div class="am-radio inline">
                                    <input type="radio" name="paymenttype" id="paymenttype-@((int)PaymentType.CreditCard)" required value="@PaymentType.CreditCard.ToString()" onclick="showcreditcard()" checked="checked">
                                    <label for="paymenttype-@((int)PaymentType.CreditCard)">Credit Card</label>
                                </div>
                            }
                            @if (Model.AcceptPayPal)
                            {
                                var checkedString = !Model.AcceptCreditCard || Request.Params["paymenttype"] == PaymentType.PayPal.ToString() ? " checked=\"checked\" " : "";

                                <div class="am-radio inline">
                                    <input type="radio" name="paymenttype" id="paymenttype-@((int)PaymentType.PayPal)" required value="@PaymentType.PayPal.ToString()" onclick="showpaypal()" @checkedString>
                                    <label for="paymenttype-@((int)PaymentType.PayPal)">PayPal</label>
                                </div>
                            }
                            @if (Model.AllowToPayLater)
                            {
                                var check = Request.Params["paymenttype"] == "InPerson" ? " checked=\"checked\" " : "";
                                <div class="am-radio inline">
                                    <input type="radio" name="paymenttype" id="paymenttype-0" required value="InPerson" onclick="showinperson()" @check>
                                    <label for="paymenttype-0">Pay Later</label>
                                </div>
                            }

                        </div>
                    </div>
                }

                @if (Model.AcceptCreditCard)
                {
                    <div id="creditcard" class="padding-10">
                        @{Html.RenderPartial(
                            "~/Views/Shared/_CreditCardPaymentForm.cshtml",
                            null,
                            new ViewDataDictionary()
                            {
                                { "required", true },
                                { "prefix", "cc" }
                            }
                            );}
                    </div>
                }
                @if (Model.AcceptPayPal)
                {
                    var hide = !Model.AcceptCreditCard ? "" : "hide";

                    <div id="paypal" class="@hide">
                        @{Html.RenderPartial("~/Views/Shared/_PayPalPaymentForm.cshtml");}
                    </div>
                }

                <div id="inperson" class="hide">
                    <div class="col-md-6 col-md-offset-3 padding-10">
                        You can pay by check or cash in person. You will be placed on the waiting list until your payment is received.
                    </div>
                </div>

            </div>
        </div>
    }

    <input type="hidden" name="registranttype" id="registranttype" value="@RegistrantType.Individual.ToString()" />

    <div class="panel panel-default hide">
        <div class="panel-body">
            <button class="btn btn-primary btn-block btn-lg" type="submit" id="submit" @disabledBtn>Submit Registration &raquo;</button>
            <button class="btn btn-primary btn-block btn-lg hide" type="submit" id="submitpaypal" @disabledBtn>Continue &amp; Pay via  PayPal &raquo;</button>
        </div>
    </div>
</form>

<script type="text/javascript">
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('[required]').blur(function () {
            if (!formHasErrors()) {
                $('#btnNext').prop('disabled', false);
            }
        });

        alert('here');

        $('#registration-form').find('[data-required]').each(function () {
            $(this).removeAttr('required');
        });

        $('.question-group').first().find('[data-required]').each(function () {
            $(this).attr('required', 'required');
        });
    });
</script>

