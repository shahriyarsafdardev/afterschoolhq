@model Account

@{
    var actionName = ViewContext.RouteData.Values["action"].ToString().ToLower();
    var isFullScreen = (bool?) ViewBag.IsFullScreen;
    var defaultPaymentsAction = "paymentsoptions";

    if (SessionVariables.CurrentAccount.CanReceiveACHDeposits())
    {
        // defaultPaymentsAction = "banksetup";
    }
}

@if (Model?.ID.GetValueOrDefault(0) > 0 && (!isFullScreen.HasValue || !isFullScreen.Value))
{
    <div class="btn-toolbar">
        <div class="btn-group hidden-xs">
            <a href="@Url.Action("edit", "account")" class="btn btn-alt6@(actionName == "edit" ? "-active" : "")">Details</a>
            <a href="@Url.Action("location", "account")" class="btn btn-alt6@(actionName == "location" ? "-active" : "") hide">Location</a>
            <a href="@Url.Action("forms", "account")" class="btn btn-alt6@(actionName == "forms" ? "-active" : "")">Forms</a>

            <a href="@Url.Action("style", "account")" class="btn btn-alt6@(actionName == "style" ? "-active" : "")">Profile Setup</a>
            <a href="@Url.Action("integrations", "account")" class="hide btn btn-alt6@(actionName == "integrations" ? "-active" : "")">Integrations</a>
            <a href="@Url.Action(defaultPaymentsAction, "account")" class="btn btn-alt6@(actionName == defaultPaymentsAction ? "-active" : "")">Accept Payments</a>
            @if (SessionVariables.CurrentAccount.AccountTypeId.In(FormConstants.LocationProviderAccountTypes))
            {
                <a href="@Url.Action("visitors", "account")" class="btn btn-alt6@(actionName == "visitors" ? "-active" : "")">Providers</a>
            }
            else
            {
                <a href="@Url.Action("hosts", "account")" class="hide btn btn-alt6@(actionName == "visitors" ? "-active" : "")">Schools</a>
            }

            @if (Model.StripeCustomerId.IsNotEmpty())
            {
                <a href="@Url.Action("billing", "account")" class="btn btn-alt6@(actionName == "billing" ? "-active" : "")">Billing</a>
            }

            @if (SessionVariables.OriginalLoggedInUser.IsNotEmpty())
            {
                <a href="@Url.Action("features", "account")" class="btn btn-alt6@(actionName == "features" ? "-active" : "")">Features</a>
            }
        </div>
        <div class="hidden-lg hidden-sm hidden-md">
            <select class="form-control" onchange="location.href=this.value;">
                <option value="">Navigation</option>
                <option value="@Url.Action("edit", "account")">Details</option>
                <!--<option value="@Url.Action("location", "account")">Location</option>-->
                <option value="@Url.Action("forms", "account")">Forms</option>
                <option value="@Url.Action("style", "account")">Profile Setup</option>
                <option value="@Url.Action(defaultPaymentsAction, "account")">Accept Payments</option>
                <option value="@Url.Action("newbilling", "account")">Packages</option>

                @{
                    <option value="@Url.Action("billing", "account")">Billing</option>

                    if (SessionVariables.CurrentAccount.AccountTypeId.In(FormConstants.LocationProviderAccountTypes))
                    {
                        <option value="@Url.Action("visitors", "account")">Providers</option>
                    }
                    else
                    {
                        <option class="hide" value="@Url.Action("hosts", "account")">Schools</option>
                    }

                    if (SessionVariables.OriginalLoggedInUser.IsNotEmpty())
                    {
                        <option value="@Url.Action("features", "account")">Features</option>
                    }
                }

            </select>
        </div>
    </div>
}