@model string

<div>
    <div id="blured-bg"></div>
    <div class="modal-isyp-intro">
        <div id="modal-isyp-intro" class="md-modal">
            <div class="md-content modal-lg">
                <div class="modal-header isyp-modal-header text-center">
                    <img src="@Model" class="modal-isyp-logo" />
                </div>
                <div class="modal-body" style="color: black;">
                    <h1 style="margin: 0; font-size: 24px">Learn, explore, and play this summer!</h1>
                    <br />
                    <div class="break-words" style="font-size: 13px">
                        From sports to science to arts and culture, Indy Summer Youth Programs offer a wide variety of programs to ensure there’s something for everyone. 
                        Many programs provide healthy meals 
                        and snacks, 
                        and free and low-cost enrollment options,
                        as well as scholarships, are available to help cover the costs of attendance.  
                        Find the right summer program for 
                        your child.
                    </div>

                    <div style="padding: 10px 15px; text-align: center;">
                        <button class="btn btn-register btn-isyp-getstarted primary-bg-color primary-border-color" onclick="return closeModalIsyp();"> Get Started</button>
                        <div class="clearfix"></div>
                    </div>
                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>
</div>