@model Account
@{
    var activeMenu = Url.RequestContext.RouteData.Values["action"].ToString();

    var paymentsentity = activeMenu == "paymentsentity" ? "active" : "";
    var paymentsbank = activeMenu == "paymentsbank" ? "active" : "";
    var paymentstos = activeMenu == "paymentstos" ? "active" : "";
}
<div id="list1" class="dd">
    <ol class="dd-list">
        <li data-id="1" class="dd-item">
            <div class="dd-handle @paymentsentity">
                @{Html.RenderPartial(
                      "~/Views/Shared/_ActiveLink.cshtml",
                      new ViewDataDictionary {
                                { "Url", Url.Action("paymentsentity", "account") },
                                { "Text", "Legal Entity Information" },
                                { "IsActive", true },
                      }
                  );
                }
            </div>
        </li>
        <li data-id="2" class="dd-item">
            <div class="dd-handle @paymentsbank">
                @{Html.RenderPartial(
                "~/Views/Shared/_ActiveLink.cshtml",
                new ViewDataDictionary {
                { "Url", Url.Action("paymentsbank", "account") },
                { "Text", "Bank information" },
                { "IsActive", true },
                }
                );
                }
            </div>
        </li>
        <li data-id="2" class="dd-item">
            &nbsp;
        </li>
        <li data-id="2" class="dd-item">
            &nbsp;
        </li>
        <li data-id="2" class="dd-item">
            &nbsp;
        </li>
        <li data-id="2" class="dd-item">
            &nbsp;
        </li>
        <li data-id="2" class="dd-item">
            &nbsp;
        </li>
    </ol>
</div>   