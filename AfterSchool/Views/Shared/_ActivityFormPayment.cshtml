@model AfterSchoolLibrary.Activity

@{
    var paypal = Model.AccountPayPalEmailAddress;
    var stripe = Model.AccountStripePublishableKey;
    
    if(!Model.ID.HasValue)
    {
        var a = Model.GetAccount();
        paypal = a.PayPalEmailAddress;
        stripe = a.StripePublishableKey;
    }
    
    var accountPackage = (AccountPackage)ViewData["AccountPackage"];

    var paymentdisabled = "";
    if (!accountPackage.HasFeature(FeatureType.AcceptPayments))
    {
        paymentdisabled = " disabled=\"disabled\" ";
    }
}

<div class="panel panel-default">
    <div class="panel-heading">
        Payment Information
    </div>

    <div class="panel-body">

        @if (Model.CanAcceptPayments)
        {
            <div class="form-group">
                <label class="col-sm-3 control-label">Cost Per @UILabel.RegistrantLabel()</label>
                <div class="col-sm-9">
                    <div class="input-group input-group-lg xs-mb-15">
                        <span class="input-group-addon">$</span>
                        <input type="number" class="form-control" id="cost" name="cost" onfocus="this.select()" value="@Model.CostPerRegistrant.ToCurrency().Replace("$", "")" required min="0.00" step=".01" @paymentdisabled />
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Cost Description
                    <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Describe what the cost of your @UILabel.ActivityLabel(Model.ActivityTypeId) covers" data-placement="top"></i>
                </label>
                <div class="col-sm-9">
                    <textarea class="form-control" id="costdescription" name="costdescription" onfocus="this.select()" @paymentdisabled placeholder="(ex. The cost will cover uniforms and materials, etc)">@Model.CostDescription</textarea>
                </div>
            </div>
            
            <div class="form-group">
                <label class="col-sm-3 control-label">Accept PayPal</label>
                <div class="col-sm-1">
                    @{Html.RenderPartial
                        (
                            "~/Views/Shared/_SwitchButton.cshtml",
                            Model.AcceptPayPal,
                            new ViewDataDictionary()
                            {
                                { "checkboxname", "acceptpaypal" },
                                { "checkboxid", "acceptpaypal" },
                                { "disabled", !accountPackage.HasFeature(FeatureType.AcceptPayments) || paypal.IsBlank() }
                            }
                        );
                    }
                </div>
                <div class="col-sm-3">
                    @if (!accountPackage.HasFeature(FeatureType.AcceptPayments))
                    {
                        <a href="@Url.Action("newbilling", "account")" target="_blank">Upgrade your account to accept payments <i class="s7-link"></i></a>
                    }
                    else if (paypal.IsBlank())
                    {
                        <a href="@Url.Action("payments", "account")" target="_blank">Connect PayPal <i class="s7-link"></i></a>
                    }
                </div>
            </div>
            
            <div class="form-group">
                <label class="col-sm-3 control-label">Accept Credit Cards</label>
                <div class="col-sm-1">
                    @{Html.RenderPartial
                        (
                            "~/Views/Shared/_SwitchButton.cshtml",
                            Model.AcceptCreditCard,
                            new ViewDataDictionary()
                            {
                                { "checkboxname", "acceptcreditcard" },
                                { "checkboxid", "acceptcreditcard" },
                                { "disabled", !accountPackage.HasFeature(FeatureType.AcceptPayments) || stripe.IsBlank() }
                            }
                        );
                    }
                </div>
                <div class="col-sm-3">
                    @if (!accountPackage.HasFeature(FeatureType.AcceptPayments))
                    {
                        <a href="@Url.Action("newbilling", "account")" target="_blank">Upgrade your account to accept payments <i class="s7-link"></i></a>
                    }
                    else if (stripe.IsBlank() && accountPackage.HasFeature(FeatureType.AcceptPayments))
                    {
                        <a href="@Url.Action("payments", "account")" target="_blank">Connect Stripe <i class="s7-link"></i></a>
                    }
                </div>
            </div>
            
            <div class="form-group">
                <label class="col-sm-3 control-label">Allow to Pay Later</label>
                <div class="col-sm-9">
                    @{Html.RenderPartial
                        (
                            "~/Views/Shared/_SwitchButton.cshtml",
                            Model.AllowToPayLater,
                            new ViewDataDictionary()
                            {
                                { "checkboxname", "allowtopaylater" },
                                { "checkboxid", "allowtopaylater" },
                                { "disabled", !accountPackage.HasFeature(FeatureType.AcceptPayments) }
                            }
                        );
                    }
                </div>
            </div>

        }
        else
        {
            <p>
                Please setup your <a href="@Url.Action("payments", "account")" target="_blank">payment integrations</a> in order to accept payment.
            </p>
        }
    </div>
</div>