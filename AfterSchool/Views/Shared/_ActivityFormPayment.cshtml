@model Activity

@{
    var subscriptionPlan = (SubscriptionPlan)ViewBag.SubscriptionPlan;
    var paymentPlan = (SubscriptionPlan)ViewBag.PaymentPlan;
    var postPayPlan = (SubscriptionPlan)ViewBag.PostPayPlan;
    var postPayPlanBillingPeriod = (BillingPeriodType)(postPayPlan.IsNotEmpty() && postPayPlan.BillingPeriodTypeId.IsNotEmpty() ? postPayPlan.BillingPeriodTypeId : BillingPeriodType.Day);
    var canProcessPayments = (bool)ViewBag.CanProcessPayments;
    var accountPackage = (AccountPackage)ViewData["AccountPackage"];
    var paymentdisabled = "";
    var hasSchedule = (bool)ViewBag.hasSchedule;

    if (!accountPackage.HasFeature(FeatureType.AcceptPayments))
    {
        paymentdisabled = " disabled=\"disabled\" ";
    }

    var showAllowPayLater = accountPackage.HasFeature(FeatureType.AllowPayLater);
    var showAllPayLaterPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.AllowPayLater);

    var showAllowPaymentPlans = accountPackage.HasFeature(FeatureType.AllowPaymentPlans);
    var showAllowPaymentPlansPackage = PackageService.GetPackageWithFeatureLowestPrice(FeatureType.AllowPaymentPlans);

    var allowAttendance = accountPackage.HasFeature(FeatureType.Attendance);
}

<div class="panel panel-default panel-small-padding">
    <div class="panel-heading activity-heading">
        Registration Fees
    </div>

    <div class="panel-body">

        <div class="form-group">
            <label class="col-sm-3 control-label" for="do-parents-pay">
                Do parents pay? <span class="text-danger">*</span>
            </label>
            <div class="col-sm-9">
                <div class="am-radio inline">
                    <input type="radio" class="form-control" name="doparentspay" id="do-parents-pay-no" required @(Model.IsFree ? "checked=\"checked\"" : "") />
                    <label for="do-parents-pay-no">No</label>
                </div>
                <div class="am-radio inline">
                    <input type="radio" class="form-control" name="doparentspay" id="do-parents-pay-yes" required />
                    <label for="do-parents-pay-yes">Yes</label>
                </div>
            </div>
        </div>

        <div id="tuition-costs" class="hide">

            <div class="form-group">
                <label class="col-sm-3 control-label">Registration Fee</label>
                <div class="col-sm-9">
                    <div class="input-group input-group-lg xs-mb-15">
                        <span class="input-group-addon">$</span>
                        <input type="number" class="form-control" id="cost" name="cost" onfocus="this.select()" value="@(Model.CostPerRegistrant.HasValue ? Model.CostPerRegistrant.Value.ToString("0.00") : "0.00")" required min="0.00" step=".01" @paymentdisabled />
                    </div>
                    <p class="text-muted text-medium-small">
                        <span id="pricetoparent-span">
                            <em>The total cost will be <span class="text-bold">$<span id="pricetoparent">0.00</span></span> at checkout</em>.
                        </span>
                        <span id="amounttoprovider-span">
                            <em>The total amount you will receive is <span class="text-bold">$<span id="amounttoprovider">0.00</span></span></em>.
                        </span>
                    </p>
                    <div>
                        <div class="am-checkbox">
                            <input type="checkbox" name="isparentpricecost" id="isparentpricecost" value="1" @(Model.IsConvenienceFeeTakenOutOfCost ? "checked=\"checked\"" : "") />
                            <label for="isparentpricecost">Price is the amount the parent pays</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group hide">
                <label class="col-sm-3 control-label">
                    Fee Description
                </label>
                <div class="col-sm-9">
                    <textarea class="form-control" id="costdescription" name="costdescription" onfocus="this.select()" @paymentdisabled placeholder="(ex. The cost will cover uniforms and materials, etc)">@Model.CostDescription</textarea>

                    <p class="text-muted">
                        <em>
                            Describe what the cost of your @UILabel.ActivityLabel(Model.ActivityTypeId).ToLower() covers.
                        </em>
                    </p>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-3 control-label">Allow to Pay Later</label>
                <div class="col-sm-9" @if (!showAllowPayLater) { <text> onclick="return showUpgradeMyPlan('@(showAllPayLaterPackage.Name)','@(showAllPayLaterPackage.ID)')"</text> }>
                    @{
                        Html.RenderPartial(
                        "~/Views/Shared/_SwitchButton.cshtml",
                        Model.AllowToPayLater,
                        new ViewDataDictionary()
                        {
                            { "checkboxname", "allowtopaylater" },
                            { "checkboxid", "allowtopaylater" },
                            { "disabled", !showAllowPayLater }
                        });
                    }
                    <p class="text-muted">
                        <em>
                            Allowing a @UILabel.RegistrantLabel().ToLower() to pay later means a @UILabel.RegistrantLabel().ToLower() can register and occupy a seat for your @Model.ActivityTypeId.ToString().ToLower() without paying. <br />
                            <strong>NOTE: This could cause an unpaid @UILabel.RegistrantLabel().ToLower() to take a reserved seat another @UILabel.RegistrantLabel().ToLower() may have paid for, and therefore is discouraged.</strong>
                        </em>
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="advanced-settings-container" class="hide">

    <div class="col-md-offset-3 col-md-9 padding-v-30">
        <span><a onclick="ActivitySetup.showAdvancedSettings()" id="btn-advanced-settings" class="pointer">Show Advanced Settings</a></span>
    </div>

    <div class="panel panel-default hide advanced-settings">

        <div class="panel-heading">
            Payment Plan Options
        </div>

        <div class="panel-body">

            <div class="form-group">
                <div class="row">
                    <label class="col-sm-3 control-label">Registration Payment Plan</label>
                    <div class="col-sm-1" @if (!showAllowPaymentPlans) { <text> onclick="return showUpgradeMyPlan('@(showAllowPaymentPlansPackage.Name)','@(showAllowPaymentPlansPackage.ID)')" </text> }>
                        @{
                            Html.RenderPartial(
                            "~/Views/Shared/_SwitchButton.cshtml",
                            showAllowPaymentPlans ? Model.HasPaymentPlan() : false,
                            new ViewDataDictionary()
                            {
                                { "checkboxname", "haspaymentplan" },
                                { "checkboxid", "haspaymentplan" },
                                { "disabled", !showAllowPaymentPlans }
            });
                        }
                    </div>
                </div>
                <br />

                <div id="paymentplansection" class="row">
                    <div class="col-md-3"></div>
                    <div class="col-sm-6 col-md-9">
                        <div class="input-group input-group-lg xs-mb-15">
                            <span class="input-group-addon">Payment Amt $</span>
                            <input type="number" class="form-control" id="paymentplancost"
                                   name="paymentplancost" onfocus="this.select()"
                                   value="@(paymentPlan.IsNotEmpty() && paymentPlan.CostPerPeriod.HasValue ? paymentPlan.CostPerPeriod.Value.ToString("0.00") : "0.00")"
                                   required min="0.00" step=".01" @paymentdisabled />
                        </div>
                        <p class="text-muted text-medium-small">
                            <span id="pricetoparent-paymentplan-span">
                                <em>The total cost will be <span class="text-bold">$<span id="pricetoparent-paymentplan">0.00</span></span> at checkout</em>.
                            </span>
                            <span id="amounttoprovider-paymentplan-span">
                                <em>The total amount you will receive is <span class="text-bold">$<span id="amounttoprovider-paymentplan">0.00</span></span></em>.
                            </span>
                        </p>
                        <div>
                            <div class="am-checkbox">
                                <input type="checkbox" name="isparentpricepaymentplan" id="isparentpricepaymentplan" value="1" @(paymentPlan.IsNotEmpty() && paymentPlan.IsConvenienceFeeTakenOutOfCost ? "checked=\"checked\"" : "") />
                                <label for="isparentpricepaymentplan">Price is the amount the parent pays</label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3"></div>
                    <div class="col-sm-6 col-md-9">
                        <div class="input-group input-group-lg xs-mb-15">
                            <span class="input-group-addon">Every</span>
                            <select name="paymentplanperiod" id="paymentplanperiod" class="form-control" required>
                                @BillingPeriodOptions(paymentPlan, SubscriptionPlanType.PaymentPlan)
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3"></div>
                    <div class="col-sm-6 col-md-9">
                        <div class="input-group input-group-lg xs-mb-15">
                            <span class="input-group-addon"># of Payments</span>
                            <input type="number" class="form-control" id="paymentplanperiodnumber"
                                   name="paymentplanperiodnumber" onfocus="this.select()"
                                   value="@(paymentPlan.IsNotEmpty() ? paymentPlan.TotalPeriods.ToString() : "0")"
                                   required min="0" step="1" @paymentdisabled />
                        </div>
                    </div>

                    <div class="row">
                        <label class="col-sm-3 control-label">When should payments start?</label>
                        <div class="col-sm-9">
                            <select name="paymentplanpaymentstarttype" id="paymentplanpaymentstarttype" class="form-control" required="required">
                                @if (hasSchedule)
                                {
                                    foreach (var item in Enum.GetValues(typeof(PlanPaymentStartType)).Cast<PlanPaymentStartType>().Except(new List<PlanPaymentStartType>() { PlanPaymentStartType.NotSet, PlanPaymentStartType.OnPeriodStart }))
                                    {
                                        var selected = (PlanPaymentStartType.WhenActivityStarts == item) ? "selected=\"selected\"" : "";

                                        if (paymentPlan.IsNotEmpty())
                                        {
                                            selected = item == paymentPlan.PaymentStartTypeId ? "selected=\"selected\"" : "";
                                        }

                                        <option value="@((int)item)" @selected>@item.ToString().SplitByUpperCase()</option>
                                    }
                                }
                                else
                                {
                                    var item = (PlanPaymentStartType)PlanPaymentStartType.OnCheckout;
                                    <option value="@((int)item)" selected="selected">@item.ToString().SplitByUpperCase()</option>
                                }

                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-3"></div>
                        <div class="col-sm-9">
                            <p class="text-muted padding-v-10">If an activity has no schedule, payment plans will begin upon checkout.</p>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-3"></div>
                    <div class="col-sm-9">
                        <p class="text-muted padding-v-10">Payment plans are used to break up the registration fee into monthly payments.</p>
                    </div>
                </div>
            </div>

        </div>

        @{Html.RenderPartial("~/Views/Shared/_SubscriptionPlan.cshtml", Model, 
              new ViewDataDictionary() {
                  { "subscriptionPlan", subscriptionPlan },
                  { "accountPackage", accountPackage },
                  { "paymentdisabled", paymentdisabled }
              });
        }

        <div class="panel-heading">
            Attendance-Based Billing Options
        </div>

        <div class="panel-body">

            <div class="form-group">
                <div class="row">
                    <label class="col-sm-3 control-label">Attendance-Based Billing Option</label>
                    <div class="col-sm-1">
                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/_SwitchButton.cshtml",
                                Model.HasPostPayPlan(),
                                new ViewDataDictionary() {
                                    { "checkboxname", "haspostpayplan" },
                                    { "checkboxid", "haspostpayplan" }
                                });
                        }
                    </div>
                </div>
                <br />

                <div id="postpaysection" class="row">
                    <div class="col-md-3"></div>
                    <div class="col-sm-6 col-md-9">
                        <div class="input-group input-group-lg xs-mb-15">
                            <span class="input-group-addon">Payment Amt $</span>
                            <input type="number" class="form-control" id="postpaycost"
                                   name="postpaycost" onfocus="this.select()"
                                   value="@(postPayPlan.IsNotEmpty() && postPayPlan.CostPerPeriod.HasValue ? postPayPlan.CostPerPeriod.Value.ToString("0.00") : "0.00")"
                                   required min="0.00" step=".01" @paymentdisabled />
                        </div>
                        <p class="text-muted text-medium-small">
                            <span id="pricetoparent-postpay-span">
                                <em>The parent will be charged <span class="text-bold">$<span id="pricetoparent-postpay">0.00</span></span> per <span id="pricetoparent-postpaybillingperiod">@(postPayPlanBillingPeriod.ToString().ToLower())</span> attended</em>.
                            </span>
                            <span id="amounttoprovider-postpay-span">
                                <em>The total amount you will receive is <span class="text-bold">$<span id="amounttoprovider-postpay">0.00</span></span> per class attended</em>.
                            </span>
                        </p>
                        <div>
                            <div class="am-checkbox">
                                <input type="checkbox"
                                       name="isparentpricepostpay"
                                       id="isparentpricepostpay"
                                       value="1"
                                       @(postPayPlan.IsNotEmpty() && postPayPlan.IsConvenienceFeeTakenOutOfCost ? "checked=\"checked\"" : "") />
                                <label for="isparentpricepostpay">Price is the amount the parent pays</label>
                            </div>
                        </div>
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-sm-3"></div>
                    <div class="col-sm-6 col-md-9">
                        <p></p>
                        <div class="input-group input-group-lg xs-mb-15">
                            <span class="input-group-addon"># of <span id="postpayprepaybillingperiod">@(postPayPlanBillingPeriod.ToString())</span>s to Pre-pay</span>
                            <input type="number" class="form-control" id="prepaidperiodspostpay"
                                   name="prepaidperiodspostpay" onfocus="this.select()"
                                   value="@(postPayPlan.IsNotEmpty() && postPayPlan.NumberOfPeriodsPrePaid.HasValue ? postPayPlan.NumberOfPeriodsPrePaid.ToString() : "0")"
                                   required min="0" step="1" />
                        </div>
                        <p class="text-muted text-medium-small">
                            <span id="pricetoparent-postpay-prepay-span">
                                <em>The parent will be charged <span class="text-bold">$<span id="pricetoparent-postpay-prepay">0.00</span></span> upon checkout</em>.
                            </span>
                            <span id="amounttoprovider-postpay-prepay-span">
                                <em>The total amount you will receive is <span class="text-bold">$<span id="amounttoprovider-postpay-prepay">0.00</span></span></em>.
                            </span>
                        </p>
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-3">
                        <label class="control-label">How do you want to charge attendance?</label>
                    </div>
                    <div class="col-sm-6 col-md-9">
                        <div class="input-group input-group-lg xs-mb-15">
                            <span class="input-group-addon">Every</span>
                            <select name="postpayplanperiod" id="postpayplanperiod" class="form-control">
                                @BillingPeriodOptions(postPayPlan, SubscriptionPlanType.PostPayPlan)
                            </select>
                        </div>
                    </div>
                    <div class="clearfix"></div>
                </div>

                <div class="row">
                    <div class="col-sm-3"></div>
                    <div class="col-sm-9">
                        <p class="text-muted padding-v-10">Attendance-based billing options are used to allow parents to pay based on attendance.</p>
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

<script>
    var costTimeOut = null;
    var paymentplanTimeOut = null;
    var subscriptionTimeOut = null;

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        setSubscriptionPlanSection();
        setPaymentPlanSection();
        setPostPayPlanSection();
        toggleSubscriptionPeriodWeek();

        $('#isparentpricecost').click(function () {
            calculateFinalPriceCost();
        });

        $('#isparentpricepostpay').click(function () {
            calculateFinalPricePostPay();
        });

        $('#isparentpricepaymentplan').click(function () {
            calculateFinalPricePaymentPlan();
        });

        $('#isparentpricesubscription').click(function () {
            calculateFinalPriceSubscription();
        });

        $('#hassubscriptionplan').change(function (cb) {
            setSubscriptionPlanSection();
        });

        $('#haspaymentplan').change(function (cb) {
            setPaymentPlanSection();
        });

        $('#haspostpayplan').change(function (cb) {
           @if (!allowAttendance)
           {
              <text>
                if (this.checked) {
                    showUpgradeMyPlan('@(showAllowPaymentPlansPackage.Name)', '@(showAllowPaymentPlansPackage.ID)');
                            $(this).removeAttr('checked'); //don't allow checkbox
                }
              </text>
           }
           else
           {
              <text>
                 setPostPayPlanSection();
              </text>
           }

           
        });

        $('#do-parents-pay-yes').click(function () {
            showTuitionCosts();
        })

        $('#do-parents-pay-no').click(function () {
            showTuitionCosts();
            $('#cost').val(0);
        })

        $('#postpayplanperiod').change(function () {
            var updatedBillingPeriod = $('#postpayplanperiod :selected').text();
            $('#pricetoparent-postpaybillingperiod').text(updatedBillingPeriod.toLowerCase());
            $('#postpayprepaybillingperiod').text(updatedBillingPeriod);

        })

        if ('@Model.IsFree' == '@false') {
            $('#do-parents-pay-yes').prop('checked', true);
            $('#do-parents-pay-yes').trigger('click');

            if ('@Model.HasSubscriptionPlan()' == '@true' || '@Model.HasPaymentPlan()' == '@true' || '@Model.HasPostPayPlan()' == '@true') {
                ActivitySetup.showAdvancedSettings();
            }
        }

        $('#cost').keyup(function () {
            costTimeOut = null;
            costTimeOut = setTimeout(function () {
                calculateFinalPriceCost();
            }, 200);
        });

        $('#paymentplancost').keyup(function () {
            paymentplanTimeOut = null;
            paymentplanTimeOut = setTimeout(function () {
                calculateFinalPricePaymentPlan();
            }, 200);
        });

        $('#subscriptionplancost').keyup(function () {
            subscriptionTimeOut = null;
            subscriptionTimeOut = setTimeout(function () {
                getSubscriptionFinalPrice();
            }, 500);
        });

        $('#postpaycost').keyup(function () {
            postpayplanTimeOut = null;
            postpayplanTimeOut = setTimeout(function () {
                calculateFinalPricePostPay();
            }, 200);
        });

        calculateFinalPriceCost();
        calculateFinalPricePaymentPlan();
        calculateFinalPricePostPay();
        getSubscriptionFinalPrice();

        updateSubscriptionPeriodText();
        updatePaymentPlanStartText();

        $('#subscriptionplanperiod').change(function () {
            updateSubscriptionPeriodText();

            toggleSubscriptionPeriodWeek();
        });

        $('#subscriptionPaymentStartType').change(function () {
            toggleSubscriptionPeriodWeek();
        });

        $('#splitcostevenly').click(function () {
            getSubscriptionFinalPrice();
        })

        $('#paymentplanpaymentstarttype').change(function () {
            updatePaymentPlanStartText();
        })

        $('#prepaidperiodspostpay').change(function () {
            updatePrePayDays();
        });

        $('#subscriptionperiodstartweekday').change(function () {
            toggleSubscriptionPeriodWeek();
        });

        $('#subscriptionperiodstartmonthday').change(function () {
            toggleSubscriptionPeriodWeek();
        });
    });

    function toggleSubscriptionPeriodWeek() {
        //.. if payment start == onPeriodStart and billing type is every month or week
        if ($('#subscriptionPaymentStartType').val() == "3") {
            if ($('#subscriptionplanperiod').val() == "1") {
                Array.from($("#container-subscription-month, #container-subscription-enddate-label")).forEach(elem => { $(elem).removeClass("hide") });
                $("#container-subscription-week").addClass("hide");
                $("#subscriptionperiodstartmonthday").prop('required', true);
                $("#subscriptionperiodstartweekday").prop('required', false);
                LoadEndDate();
            } else if ($('#subscriptionplanperiod').val() == "3") {
                Array.from($("#container-subscription-week, #container-subscription-enddate-label")).forEach(elem => { $(elem).removeClass("hide") });
                $("#container-subscription-month").addClass("hide");
                $("#subscriptionperiodstartweekday").prop('required', true);
                $("#subscriptionperiodstartmonthday").prop('required', false);
                LoadEndDate();
            } else {
                clearSubscriptionPaymentHiddenInputs();
                hideWeekMonthContainers();
            }
        } else {
            clearSubscriptionPaymentHiddenInputs();
            hideWeekMonthContainers();
        }
    }

    function hideWeekMonthContainers() {
        Array.from($("#container-subscription-month, #container-subscription-week, #container-subscription-enddate-label")).forEach(elem => { $(elem).addClass("hide") });
        $("#subscriptionperiodstartweekday").prop('required', false);
        $("#subscriptionperiodstartmonthday").prop('required', false);
    }

    function clearSubscriptionPaymentHiddenInputs() {
        $('#subscriptionStartDate').val('');
        $('#subscriptionEndDate').val('');
    }

    function calculateFinalPriceCost() {
        calculateFinalPrice($('#cost').val(), $('#pricetoparent'), $('#amounttoprovider'), $('#isparentpricecost'));
    }

    function calculateFinalPricePostPay() {
        calculateFinalPrice($('#postpaycost').val(), $('#pricetoparent-postpay'), $('#amounttoprovider-postpay'), $('#isparentpricepostpay'), function () {
            updatePrePayDays();
        });
    }

    function calculateFinalPricePaymentPlan() {
        calculateFinalPrice($('#paymentplancost').val(), $('#pricetoparent-paymentplan'), $('#amounttoprovider-paymentplan'), $('#isparentpricepaymentplan'));
    }

    function calculateFinalPriceSubscription() {
        calculateFinalPrice($('#subscriptionplancost').val(), $('#pricetoparent-subscription'), $('#amounttoprovider-subscription'), $('#isparentpricesubscription'));
    }

    function updatePrePayDays() {
        var numOfDays = parseInt($('#prepaidperiodspostpay').val());
        var priceToParent = parseFloat($('#pricetoparent-postpay').html());
        var amountToProvider = parseFloat($('#amounttoprovider-postpay').html());

        var priceToParentPrePay = numOfDays * priceToParent;
        var amountToProviderPrePay = numOfDays * amountToProvider;

        $('#pricetoparent-postpay-prepay').html(priceToParentPrePay.toFixed(2));
        $('#amounttoprovider-postpay-prepay').html(amountToProviderPrePay.toFixed(2));
    }

    function updateSubscriptionPeriodText() {
        $('.subscription-period-text').html($('#subscriptionplanperiod option:selected').text().toLowerCase());
    }

    function getSubscriptionFinalPrice() {

        $('.subscription-range').addClass('hide');
        showHideSubscriptionSplit();

        if ($('#splitcostevenly').is(':checked')) {
            var totalAmt = $('#subscriptionplancost').val();

            $('.subscription-range').removeClass('hide');

            calculateFinalPrice(totalAmt / @Model.SeatsAvailable, $('#finalsubscriptionplancost-1'));
            calculateFinalPrice(totalAmt / @(Model.MinSeatsRequired ?? 1), $('#finalsubscriptionplancost-2'));
            calculateFinalPrice(totalAmt / @(Model.GetSeatsTaken() == 0 ? 1 : Model.GetSeatsTaken()), $('#finalsubscriptionplancost-3'));

        } else {

            var totalAmt = $('#subscriptionplancost').val();
            calculateFinalPriceSubscription();
        }
    }

    function showHideSubscriptionSplit() {

        $('.subscription-plan-cost-nosplit').addClass('hide');
        $('.subscription-plan-cost-split').addClass('hide');

        if ($('#splitcostevenly').is(':checked')) {
            $('.subscription-plan-cost-split').removeClass('hide');
        } else {
            $('.subscription-plan-cost-nosplit').removeClass('hide');
        }

    }

    function calculateFinalPrice(cost, priceToParentSpan, amountToProviderSpan, takenOutOfCostChk, callback) {

        if (isNaN(cost))
            return;

        var takenOutOfCost = 0;

        if (takenOutOfCostChk.is(':checked')) {
            takenOutOfCost = 1;
        }

        $.get(
            '@Url.Action("calculatefinalprice", "services")?cost=' + cost + '&activityUid=@Model.Uid.ToString()&takenoutofcost=' + takenOutOfCost,
            function (data) {
                if (data && data.status == 'ok') {
                    priceToParentSpan.html(parseFloat(data.priceToParent).toFixed(2));
                    amountToProviderSpan.html(parseFloat(data.amountToProvider).toFixed(2));
                } else {
                    priceToParentSpan.html('0.00');
                    amountToProviderSpan.html('0.00');
                }

                if (callback) {
                    callback();
                }
            }
        );
    }

    function showTuitionCosts() {

        if ($('#do-parents-pay-yes').is(':checked')) {
            $('#tuition-costs').removeClass('hide');
            $('#provider-info').removeClass('hide');
            $('#advanced-settings-container').removeClass('hide');
        } else {
            $('#tuition-costs').addClass('hide');
            $('#provider-info').addClass('hide');
            $('#advanced-settings-container').addClass('hide');
        }
    }

    function setSubscriptionPlanSection() {
        if ($('#hassubscriptionplan').is(':checked')) {
            $('.subscriptionplansection').show();
            $('#subscriptionplanperiod').prop('required', true)
        } else {
            disableSubscriptionPlanSection();
        }
    }

    function setPaymentPlanSection() {
        if ($('#haspaymentplan').is(':checked')) {
            $('#paymentplansection').show();
            $('#paymentplanperiod').prop('required', true);
        } else {
            disablePaymentPlanSection();
        }
    }

    function disableSubscriptionPlanSection() {
        $('.subscriptionplansection').hide();
        $('#subscriptionplanperiod').prop('required', false)
    }

    function disablePaymentPlanSection() {
        $('#paymentplansection').hide();
        $('#paymentplanperiod').prop('required', false);
    }

    function setPostPayPlanSection() {
        if ($('#haspostpayplan').is(':checked')) {
            $('#postpaysection').show();
            $('#postpaysection').prop('required', true);

            postPayDisableOtherOptions();

        } else {
            $('#postpaysection').hide();
            $('#postpaysection').prop('required', false);

            // re-enable other options
            postPayEnableOtherOptions();
        }
    }

    function postPayDisableOtherOptions() {

        if ($('#haspaymentplan').is(':checked')) {
            $('#haspaymentplan').trigger('click');
        }
        if ($('#hassubscriptionplan').is(':checked')) {
            $('#hassubscriptionplan').trigger('click');
        }

        $('#cost').val(0.00);
        $('#pricetoparent').html(0.00);
        $('#amounttoprovider').html(0.00);

        $('#hassubscriptionplan').prop('disabled', true);
        $('#haspaymentplan').prop('disabled', true);
        $('#allowtopaylater').prop('disabled', true);
        $('#cost').prop('disabled', true);
        setChkParentPriceCost(false);
    }

    function postPayEnableOtherOptions() {
        hasSubscriptionsDisabledDefault();
        paymentPlansDisabledDefault();
        payLaterDisabledDefault();
        $('#cost').prop('disabled', false);
        setChkParentPriceCost(true);
    }

    function setChkParentPriceCost(enable) {
        var isParentPricecostChecked = $('#isparentpricecost').prop('checked');

        if (enable) {
            $('#isparentpricecost').prop('checked', isParentPricecostChecked);
            $('#isparentpricecost').prop('disabled', false);
        } else {
            $('#isparentpricecost').prop('checked', false);
            $('#isparentpricecost').prop('disabled', true);
        }
    }

    function updatePaymentPlanStartText() {
        var e = $('#paymentplanpaymentstarttype :selected');
        var text = e.text().toLowerCase();

        $('#paymentplanstarttypetext').html(text);
    }

    function payLaterDisabledDefault() {
        if (@((!showAllowPayLater).ToString().ToLower()))
            $('#allowtopaylater').prop('disabled', true);
        else
            $('#allowtopaylater').prop('disabled', false);
    }

    function paymentPlansDisabledDefault() {
        if (@((!showAllowPaymentPlans).ToString().ToLower()))
          $('#haspaymentplan').prop('disabled', true);
        else
            $('#haspaymentplan').prop('disabled', false);
    }

    function hasSubscriptionsDisabledDefault() {
        if (@((!showAllowPaymentPlans).ToString().ToLower()))
            $('#hassubscriptionplan').prop('disabled', true);
        else
            $('#hassubscriptionplan').prop('disabled', false);
    }


</script>

@helper BillingPeriodOptions(SubscriptionPlan plan, SubscriptionPlanType type)
{
var exceptions = new List<BillingPeriodType> { BillingPeriodType.NotSet };

if (AfterSchoolLibrary.Helpers.Utilities.IsProduction)
{
    exceptions = new List<BillingPeriodType> { BillingPeriodType.NotSet, BillingPeriodType.Day, BillingPeriodType.Year };
}

if (type.IsNotEmpty() && type == SubscriptionPlanType.PostPayPlan)
{
    exceptions = new List<BillingPeriodType> { BillingPeriodType.NotSet, BillingPeriodType.Month, BillingPeriodType.Year, BillingPeriodType.TwoWeeks };
}

foreach (var billingPeriodType in Enum.GetValues(typeof(BillingPeriodType)).Cast<BillingPeriodType>().Where(x => x.NotIn(exceptions)))
{
    var selected = "";
    if (plan.IsEmpty() && billingPeriodType == BillingPeriodType.Month)
    {
        selected = " selected=\"selected\" ";
    }
    else if (plan.IsNotEmpty() && billingPeriodType == plan.BillingPeriodTypeId)
    {
        selected = " selected=\"selected\" ";
    }
    else if (type.IsNotEmpty() && type == SubscriptionPlanType.PostPayPlan && plan.IsEmpty() && billingPeriodType == BillingPeriodType.Day)
    {
        selected = " selected=\"selected\" ";
    }

        <option value="@((int)billingPeriodType)" @selected>@billingPeriodType.ToString().SplitByUpperCase()</option>
    }
}