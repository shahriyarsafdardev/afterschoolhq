@model Activity
@{
    var accountPackage = (AccountPackage)ViewData["AccountPackage"];
    var finalstep = 7;
    if (accountPackage.PackageHasPayments)
    {
        finalstep = 7;
    }
}
<div class="row wizard-row">
    <div class="col-md-12 fuelux">
        <div class="block-wizard panel panel-default">

            <form class="form-horizontal" id="form1" method="post" action="@Url.Action("add", "activity")">

                <div id="wizard1" class="wizard wizard-ux">
                    <ul class="steps" style="margin-left: 0">
                        <li data-step="1" class="active">1 - @UILabel.ActivityLabel() Setup<span class="chevron"></span></li>
                        <li data-step="2">2 - Contact Information<span class="chevron"></span></li>
                        <li data-step="3">3 - @UILabel.ActivityLabel() Details<span class="chevron"></span></li>
                        <li data-step="4">4 - Location Details<span class="chevron"></span></li>
                        <li data-step="5">5 - @UILabel.ActivityLabel() Cost<span class="chevron"></span></li>
                        <li data-step="6">6 - Confirmation Msg<span class="chevron"></span></li>
                        <li data-step="@finalstep">@finalstep - Review &amp; Save<span class="chevron"></span></li>
                    </ul>
                    <div class="actions hide">
                        <button type="button" class="btn btn-xs btn-prev btn-default"><i class="icon s7-angle-left"></i>Prev</button>
                        <button type="button" data-last="Finish" class="btn btn-xs btn-next btn-default">Next<i class="icon s7-angle-right"></i></button>
                    </div>
                    <div class="step-content">
                        <div data-step="1" class="step-pane active" id="step-1">

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <!--<button class="btn btn-default btn-space">Cancel</button>-->
                                        <button onclick="validate(1)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">
                                @{Html.RenderPartial("~/Views/Shared/_ActivityFormSetup.cshtml", Model);}
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <!--<button class="btn btn-default btn-space">Cancel</button>-->
                                        <button onclick="validate(1)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div data-step="2" class="step-pane" id="step-2">

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(2)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">
                                @{Html.RenderPartial("~/Views/Shared/_ActivityFormContactInfo.cshtml", Model);}
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(2)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div data-step="3" class="step-pane" id="step-3">

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(3)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">
                                @{Html.RenderPartial("~/Views/Shared/_ActivityFormDetails.cshtml", Model);}
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(3)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div data-step="4" class="step-pane" id="step-4">

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(4)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">
                                @{Html.RenderPartial("~/Views/Shared/_ActivityFormLocation.cshtml", Model);}
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(4)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div data-step="5" class="step-pane" id="step-5">

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(5)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">
                                @{Html.RenderPartial("~/Views/Shared/_ActivityFormPayment.cshtml", Model);}
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(5)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div data-step="6" class="step-pane" id="step-6">

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(6)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">
                                @{Html.RenderPartial("~/Views/Shared/_ActivityFormConfirmation.cshtml", Model);}
                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button onclick="validate(6)" data-wizard="#wizard1" class="btn btn-primary btn-space wizard-next">Next Step <i class="icon s7-angle-right"></i></button>
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div data-step="@finalstep" class="step-pane" id="step-@finalstep">
                            
                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button class="btn btn-success btn-space" type="submit"><i class="icon s7-check"></i> Save &amp; Build Registration Form &raquo;</button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-10 col-md-offset-1">

                            </div>

                            <div class="form-group">
                                <div class="col-sm-12">
                                    <div class="pull-right">
                                        <button data-wizard="#wizard1" class="btn btn-default btn-space wizard-previous"><i class="icon s7-angle-left"></i> Previous</button>
                                        <button class="btn btn-success btn-space" type="submit"><i class="icon s7-check"></i> Save &amp; Build Registration Form &raquo;</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<script>

    function validate(step) {
        console.log('function: validate');

        $('#wizard1').removeClass('form-errors')

        var foundErrors = false;

        $('div[id="step-' + step + '"]').find('[required]').each(function () {

            console.log('id: ' + $(this).attr('id'));

            var errors = checkElement($(this));
            if (errors) {
                foundErrors = errors;
            }
        });

        if (foundErrors) {
            console.log('Found Errors');
            $('#wizard1').addClass('form-errors');
        }
        else if (step == @(finalstep - 1)) {

            $('#step-@finalstep > div:eq(1)').html('');

            $('#step-@finalstep > div:eq(1)').append($('#step-1 > div:eq(1)').html());
            $('#step-@finalstep > div:eq(1)').append($('#step-2 > div:eq(1)').html());
            $('#step-@finalstep > div:eq(1)').append($('#step-3 > div:eq(1)').html());
            $('#step-@finalstep > div:eq(1)').append($('#step-4 > div:eq(1)').html());
            $('#step-@finalstep > div:eq(1)').append($('#step-5 > div:eq(1)').html());
            $('#step-@finalstep > div:eq(1)').append($('#step-6 > div:eq(1)').html());

            var html = '';
            var parent = null;

            $('#step-@finalstep input').each(function () {
                if ($(this).attr('type') == 'checkbox') {
                    if ($(this).is(':checked')) {
                        html = '<div class="padding-10">Yes</div>';
                    }
                    else {
                        html = '<div class="padding-10">No</div>';
                    }
                    $(this).parent().parent().html(html);
                }
                else {
                    html = '<div class="padding-10">' + $('#' + $(this).attr('id')).val() + '</div>';
                    if ($(this).attr('data-type') == 'date') {
                        $(this).parent().parent().html(html);
                    }
                    else {

                        if ($(this).parent().hasClass('input-group')) {
                            $(this).parent().parent().html(html);
                        }
                        else {
                            $(this).parent().html(html);
                        }

                    }
                }
            });
            $('#step-@finalstep textarea').each(function () {
                html = '<div class="padding-10">' + $('#' + $(this).attr('id')).val() + '</div>';
                $(this).parent().html(html);
            });
            $('#step-@finalstep select').each(function () {
                html = '<div class="padding-10">' + $('#' + $(this).attr('id')).val() + '</div>';
                $(this).parent().html(html);
            });
        }
    }

    function checkElement(obj) {
        var foundErrors = false;

        if (obj.attr('type') == 'checkbox') {
            if (!obj.is(':checked')) {
                foundErrors = true;
            }
        }
        else if (obj.attr('type') == 'number') {
            if (obj.val().length == 0) {
                foundErrors = true;
            }
            else if(!isNaN(obj.attr('min')) && (isNaN(obj.val()) || parseFloat(obj.val()) < parseFloat(obj.attr('min')) )){
                foundErrors = true;
            }
            else if(!isNaN(obj.attr('max')) && (isNaN(obj.val()) || parseFloat(obj.val()) > parseFloat(obj.attr('max')) )) {
                foundErrors = true;
            }

            if(foundErrors){
                obj.addClass('bg-danger');

                obj.blur(function () {
                    checkElement($(this));
                });
            }
            else{
                obj.removeClass('bg-danger');
            }
        }
        else {
            if (obj.val().length == 0) {
                foundErrors = true;
                obj.addClass('bg-danger');

                obj.blur(function () {
                    checkElement($(this));
                });
            }
            else {
                obj.removeClass('bg-danger');
            }
        }

        return foundErrors;
    }

</script>
