@model Activity
@{
    var msgs = new SystemMessages();
    var grades = GradeLevel.Load();
    var showAllowStudentRegistration = SessionVariables.AccountPackage.HasFeature(FeatureType.AllowStudentRegistration) && Model.ActivityTypeId.In(new[]
    {
        ActivityType.Activity,
        ActivityType.Team,
        ActivityType.FieldTrip,
        ActivityType.LearningPod,
    });
    var allAgeRegistrationEnabled = SessionVariables.AccountPackage.HasFeature(FeatureType.AllAgeRegistration);
    var requiresParentConsent= Model.RequiresParentalConsent;
    var activeForm = Model.GetActiveActivityForm(msgs).GetForm(msgs);
    var questions = activeForm.GetActiveQuestions();
    var gardeQuestion = questions.Where(question => question.QuestionDataTypeId == QuestionDataType.RegistrantGrade).FirstOrDefault();
    var gradeQuestionSettings = FormQuestionSettings.LoadByQuestionIds(gardeQuestion.ID);
    var genderQuestion = questions.Where(question => question.QuestionDataTypeId == QuestionDataType.RegistrantGender).FirstOrDefault();
    var genderQuestionSettings = FormQuestionSettings.LoadByQuestionIds(genderQuestion.ID);
    var ageQuestion = questions.Where(question => question.QuestionDataTypeId == QuestionDataType.RegistrantDateOfBirth).FirstOrDefault();
    var ageQuestionSettings = FormQuestionSettings.LoadByQuestionIds(ageQuestion.ID);
    var isFormAgeRestricted = false;
    var isFormGenderRestricted = false;
    var isFormGradeRestricted = false;

    if(gradeQuestionSettings.Count == 0)
    {
        isFormGradeRestricted = gardeQuestion.IsRequired;
    }
    else
    {
        var notRequiredCount = gradeQuestionSettings.Where(question => question.Required == false).Count();
        var notShowCount = gradeQuestionSettings.Where(question => question.Show == false).Count();
        if(notRequiredCount == 0 && notShowCount==0)
        {
            isFormGradeRestricted = true;
        }
    }

    if (ageQuestionSettings.Count == 0)
    {
        isFormAgeRestricted = ageQuestion.IsRequired;
    }
    else
    {
        var notRequiredCount = ageQuestionSettings.Where(question => question.Required == false).Count();
        var notShowCount = ageQuestionSettings.Where(question => question.Show == false).Count();
        if (notRequiredCount == 0 && notShowCount == 0)
        {
            isFormAgeRestricted = true;
        }
    }

    if (genderQuestionSettings.Count == 0)
    {
        isFormGenderRestricted = genderQuestion.IsRequired;
    }
    else
    {
        var notRequiredCount = genderQuestionSettings.Where(question => question.Required == false).Count();
        var notShowCount = genderQuestionSettings.Where(question => question.Show == false).Count();
        if (notRequiredCount == 0 && notShowCount == 0)
        {
            isFormGenderRestricted = true;
        }
    }
}
<div class="panel panel-default panel-small-padding">
    <div class="panel-heading activity-heading">
        Restrictions
    </div>
    <div class="panel-body">

        <div class="form-group">
            <label class="col-md-3 control-label">
                Gender Restrictions
            </label>
            <div class="col-md-9 margin-left">
                <div class="am-radio inline">
                    @foreach (GenderRestrictionType item in Enum.GetValues(typeof(GenderRestrictionType)))
                    {
                        <input type="radio"
                               data-modal="modal-gender-restriction-error"
                               name="genderrestrictions"
                               id="genderrestrictions-@((int) item)"
                               @(Model.GenderRestriction == item ? " checked=\"checked\" " : "")
                               value="@((int) item)" onclick="handleCheck(this)" />
                        <label for="genderrestrictions-@((int) item)" class="margin-h-10">
                            @item.ToString().SplitByUpperCase()
                        </label>
                    }
                </div>
            </div>
        </div>
        @{
            Html.RenderPartial("~/Views/Shared/_RestrictionModal.cshtml", new RestrictionModalViewModel()
            {
                Title = "Gender Restriction Error",
                HtmlBody = "<p>You have turned on gender restrictions for this activity but your default form doesn't ask for gender. To enforce this restriction, we will ask registrants for their gender during registration.</ p > ",
                ActionButtonHtml = "Remove Restriction",
                ActionButtonId = $"btn-gender-restriction-error",
                ID = $"modal-gender-restriction-error",
                OkButtonHtml = "Okay",
                OkButtonId = "modal-gender-restriction-ok",
            }); ;
        }

        <div class="form-group" id="strictGenderRestrictions">
            <label class="col-md-3 control-label">
                Strictly Enforce Gender Restrictions
            </label>
            <div class="col-md-9 margin-left">
                <div class="am-radio inline">
                    <input id="genderrestrictions1" name="strictgenderrestrictions" @(!Model.IsGenderEnforced ? " checked=\"checked\" " : "") type="radio" value="0" />
                    <label for="genderrestrictions1" class="margin-h-10">
                        No
                    </label>
                    <input id="genderrestrictions2" name="strictgenderrestrictions" @(Model.IsGenderEnforced ? " checked=\"checked\" " : "") type="radio" value="1" />
                    <label for="genderrestrictions2" class="margin-h-10">
                        Yes
                    </label>
                </div>
                <div class="margin-h-10" style="color: #b3b3b3;">
                    <i>
                        Stops students of the restricted gender from registering for the activity. Student gender is set by the parent during onboarding and might not match the student's gender identity. Students who select 'Other' for gender will not be able to register for this activity.
                    </i>
                </div>
            </div>
        </div>

        @{
            Html.RenderPartial(
                "~/Views/Shared/_RestrictBySelection.cshtml",
                null,
                new ViewDataDictionary
                {
                    {"minGradeLevelId", Model.GradeLevelStart},
                    {"MaxGradeLevelId", Model.GradeLevelEnd},
                    {"grades", grades},
                    {"ageStart", Model.AgeStart},
                    {"ageEnd", Model.AgeEnd},
                    {"restrictbygrade", Model.RestrictByGrade()},
                    {"isFormAgeRestricted", isFormAgeRestricted},
                    {"isFormGradeRestricted", isFormGradeRestricted},
                }
                );
        }
        @if (showAllowStudentRegistration)
        {
            <div class="form-group" id="allowRegistration">
                <label class="col-md-3 control-label">
                    Allow @(allAgeRegistrationEnabled?"Minors":"Students") To Register
                </label>
                <div class="col-md-9 d-flex align-items-center">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/_SwitchButton.cshtml",
                            Model.IsStudentAllowedToRegister,
                            new ViewDataDictionary
                            {
                                {"checkboxname", "isStudentAllowed"},
                                {"checkboxid", "isStudentAllowed"},
                                {"disabled", false},
                                {"onclick", "showParentConsent();"},
                                {"required", false},

});
                    }
                    <i id="parentConsentWarning" class="s7-attention icon-large text-warning margin-l-10 position-relative" data-toggle="popover" data-trigger="hover" data-content="If you allow minors to register, they can actually register without parental knowledge." data-placement="top"></i>
                </div>
            </div>
            <div class="form-group hidden" id="parentConsent">
                <label class="col-md-3 control-label">
                    Requires Parental Consent
                </label>
                <div class="col-md-9">
                    @{
                        Html.RenderPartial(
                            "~/Views/Shared/_SwitchButton.cshtml",
                            Model.RequiresParentalConsent,
                            new ViewDataDictionary
                            {
                                {"checkboxname", "requiresparentalconsent"},
                                {"checkboxid", "requiresparentalconsent"},
                                {"onclick", "showConsentWarning();"},
                                {"disabled", false}
});
                    }
                </div>
            </div>
        }
        else
        {
            <input type="hidden" value="true" name="requiresparentalconsent" id="requiresparentalconsent" />
        }

    </div>
</div>

<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $("#btn-gender-restriction-error").click(function () {
                $("input[name='genderrestrictions']:checked").attr("checked", false);
                $('#strictGenderRestrictions').addClass("hidden");
                $("#genderrestrictions-0").prop("checked", true);
            });
        });
    function showConsentWarning() {
        var isStudentAllowed = $("#isStudentAllowed").is(":checked");
        var isParentConsent = $("#requiresparentalconsent").is(":checked");

        if (isStudentAllowed && !isParentConsent) {
            $('#parentConsentWarning').removeClass("hidden");
        } else {
            $('#parentConsentWarning').addClass("hidden");
        }
    }

    function showParentConsent() {
        var isStudentAllowed = $("#isStudentAllowed").is(":checked");
        if (isStudentAllowed) {
            $('#parentConsent').removeClass("hidden");
        }
        else {
            $('#parentConsent').addClass("hidden");
        }
        $("#requiresparentalconsent").prop('checked', false);
        showConsentWarning();

    }

    function showStrictGender() {
            var genderrestrictions = $("#genderrestrictions-0").is(":checked");
            if (genderrestrictions) {
                $('#strictGenderRestrictions').addClass("hidden");
            }
            else {
                $('#strictGenderRestrictions').removeClass("hidden");
            }
    }

    function handleCheck(obj) {
        if (obj.getAttribute("value") != 0)
        {
            $('#strictGenderRestrictions').removeClass("hidden");
        }
        else
        {
            $('#strictGenderRestrictions').addClass("hidden");
        }
    }
    function validateAgeChanged() {
        if (parseInt($('#agestart').val()) >= 18) {
            $('#allowRegistration').addClass("hidden");
            $('#parentConsent').addClass("hidden");
        }
        else {
            $('#allowRegistration').removeClass("hidden");
            showParentConsent();
        }
    }

    function handleAllAgeAdultCheck() {
        $('#agestart').change(function () {
            validateAgeChanged();
        });
        $('#ageend').change(function () {
            validateAgeChanged();
        });
    }
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        showParentConsent();
        showStrictGender();
        handleAllAgeAdultCheck();
        $("#requiresparentalconsent").prop('checked', @(requiresParentConsent.IsEmpty() ? "false" : (requiresParentConsent ? "true" : "false")));
        showConsentWarning();
    });

    function addClassToRadioInputs() {
        var radioInputs = document.querySelectorAll('input[name="genderrestrictions"]');
        for (var i = 0; i < radioInputs.length; i++) {
            var input = radioInputs[i];
            if (input.value !== "0" && "@isFormGenderRestricted" == "False") {
                input.classList.add("md-trigger");
            }
        }
    }
    document.addEventListener('DOMContentLoaded', function () {
        addClassToRadioInputs();
    });

</script>