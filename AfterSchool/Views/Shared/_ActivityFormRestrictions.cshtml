@model AfterSchoolLibrary.Activity
@{ 
    var grades = GradeLevel.Load();
}
<div class="panel panel-default">
    <div class="panel-heading">
        Restrictions
    </div>
    <div class="panel-body">
        <div class="form-group hide">
            <label class="col-md-3 control-label">
                Allow Organizations to Register
            </label>
            <div class="col-md-9">
                @{Html.RenderPartial
                        (
                            "~/Views/Shared/_SwitchButton.cshtml",
                            Model.AllowOrganizationRegistration,
                            new ViewDataDictionary()
                            {
                                { "checkboxname", "alloworganization" },
                                { "checkboxid", "alloworganization" },
                                { "disabled", false }
                            }
                        );
                }
            </div>
        </div>

        <div class="form-group">
            <label class="col-md-3 control-label">
                Gender Restrictions
            </label>
            <div class="col-md-9">
                <div class="am-radio inline">
                    @foreach (GenderRestrictionType item in System.Enum.GetValues(typeof(GenderRestrictionType)))
                    {
                        <input type="radio" name="genderrestrictions" id="genderrestrictions-@((int)item)" @(Model.GenderRestriction == item ? " checked=\"checked\" " : "") value="@((int)item)" />
                        <label for="genderrestrictions-@((int)item)" class="margin-h-10">
                            @item.ToString().SplitByUpperCase()
                        </label>
                    }
                </div>
            </div>
        </div>

        <div class="form-group">
            <label class="col-md-3 control-label">
                Age Restrictions
            </label>
            <div class="col-md-1">
                @{Html.RenderPartial
                    (
                        "~/Views/Shared/_SwitchButton.cshtml",
                        Model.AgeStart.HasValue,
                        new ViewDataDictionary()
                        {
                            { "checkboxname", "agerestrictions" },
                            { "checkboxid", "agerestrictions" },
                            { "disabled", false }
                        }
                    );
                }
            </div>
            <div class="col-md-8 hide" id="age">
                <select id="agestart" name="agestart" class="form-control">
                    @for (var i = 0; i < 115; i++)
                    {
                        <option value="@i" @(Model.AgeStart == i ? " selected=\"selected\" " : "")>@i</option>
                    }
                </select>
                <p class="margin-v-10">
                    To
                </p>
                <select id="ageend" name="ageend" class="form-control">
                    @for (var i = 0; i < 115; i++)
                    {
                        <option value="@i" @(Model.AgeEnd == i ? " selected=\"selected\" " : "")>@i</option>
                    }
                </select>
            </div>           
        </div>

        <div class="form-group">
            <label class="col-md-3 control-label">
                Grade Restrictions
            </label>
            <div class="col-md-1">
                @{Html.RenderPartial
                    (
                        "~/Views/Shared/_SwitchButton.cshtml",
                        Model.GetGradeLevels().Count > 0,
                        new ViewDataDictionary()
                        {
                            { "checkboxname", "graderestrictions" },
                            { "checkboxid", "graderestrictions" },
                            { "disabled", false }
                        }
                    );
                }
            </div>
            <div class="col-md-8 hide" id="grade">

                @{ var gradesPerColumn = Math.Ceiling(grades.Count / 3.0).ToInteger();}
                @for (int i = 0; i < 3; i++)
                {
                    <div class="col-md-4">
                        @foreach (var grade in grades.Skip(i * gradesPerColumn).ToList().Take(gradesPerColumn))
                        {
                            <div class="am-checkbox">
                                <input type="checkbox" class="gradelevel" name="grade-@grade.ID" id="grade-@grade.ID" value="1" @(Model.HasGradeLevel(grade) ? " checked=\"checked\" " : "") />
                                <label for="grade-@grade.ID" class="margin-h-10">@grade.Name</label>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $('#agerestrictions').click(function() {
                ageCheck();
            });
            $('#graderestrictions').click(function() {
                gradeCheck();
            });

            $('#agestart').change(function() {
                if(parseInt($(this).val()) > parseInt($('#ageend').val())){
                    $('#ageend').val($(this).val());
                }
            });

            $('#gradestart').change(function() {
                if(parseInt($(this).val()) > parseInt($('#gradeend').val())){
                    $('#gradeend').val($(this).val());
                }
            });

            ageCheck();
            gradeCheck();
        }
    );

    function ageCheck(){
        if ($('#agerestrictions').is(':checked')) {
            $('#age').removeClass('hide');
            $('#graderestrictions').prop('disabled', true);

            $('.gradelevel').prop('checked', false);
            $('.gradelevel').prop('disabled', true);

        } else {
            $('#age').addClass('hide');
            $('#graderestrictions').prop('disabled', false);
            $('.gradelevel').prop('disabled', false);
        }
    }

    function gradeCheck() {
        if ($('#graderestrictions').is(':checked')) {
            $('#grade').removeClass('hide');
            $('#agerestrictions').prop('disabled', true);
            $('.gradelevel').prop('disabled', false);
        } else {
            $('#grade').addClass('hide');
            $('#agerestrictions').prop('disabled', false);
            $('.gradelevel').prop('disabled', true);
        }
    }
</script>
