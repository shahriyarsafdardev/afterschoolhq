<form action="@Url.Action("index", "login", new { returnurl = ViewData["ReturnUrl"], invite = ViewData["invite"] })" method="post" class="form-horizontal" id="form-login">
    <div class="login-form">
        <div class="form-group">
            <div class="input-group">
                <span class="input-group-addon"><i class="icon s7-user"></i></span>
                <input id="username" name="username" type="text" placeholder="Email Address, Phone, or Username" autocomplete="off" class="form-control" required>
            </div>
        </div>
        <div class="form-group">
            <div class="input-group">
                <span class="input-group-addon"><i class="icon s7-lock"></i></span>
                <input id="password" name="password" type="password" placeholder="Password" class="form-control" required>
            </div>
        </div>
        <div class="form-group">
            <div class="remember text-center">
                <div class="am-checkbox checkbox-inline">
                    <input type="checkbox" id="remember-login" name="remember" value="1" checked="checked" class="form-control">
                    <label for="remember-login">Remember me on this computer</label>
                </div>
            </div>
        </div>
        <div class="form-group">
            <div class="form-group login-submit">
                <button data-dismiss="modal" type="submit" class="btn btn-primary btn-lg">Log me in</button>
            </div>
            <div class="form-group footer row">
                <div class="col-xs-12 text-center"><a href="/login/resetpassword">Forgot Password?</a></div>
            </div>
        </div>
</form>
