@model ActivityForm

<form method="post" action="@Url.Action("form", "activity", new { id = Model.Uid })" class="form-horizontal">
    <div class="col-sm-10 col-md-offset-1">

        <div role="alert" class="alert alert-primary alert-icon alert-icon-color alert-dismissible">
            <div class="icon"><span class="s7-info"></span></div>
            <div class="message">
                <button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="s7-close"></span></button>
                <big>
                    Please enter your registration form title and include brief instructions for your @UILabel.RegistrantLabel(true). Then select the questions you want to display on your registration form.
                </big>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="pull-right">
                <a href="@Model.GetPreviewUrl()" target="_blank" class="btn btn-primary btn-space"><i class="icon icon-left s7-look"></i>Preview</a>
                <button type="submit" class="btn btn-primary btn-space"><i class="icon icon-left s7-diskette"></i>Update</button>
                @if (!Model.IsPublished)
                {
                    <a href="@Url.Action("publish", "activity", new { id = Model.Uid })" class="btn btn-primary btn-space">Save &amp; Publish <i class="icon icon-left s7-right-arrow"></i></a>
                }
            </div>
            <div class="panel-heading">
                Form Builder
            </div>
        </div>

        @{Html.RenderPartial("~/Views/Shared/_RegistrationFormFields.cshtml", Model);}
        
        <div class="form-group">
            <label class="col-sm-3 control-label"></label>
            <div class="col-sm-6">
                <button type="submit" class="btn btn-primary btn-lg btn-block pull-right"><i class="s7-diskette"></i> Update</button>
            </div>
        </div>
    </div>
</form>