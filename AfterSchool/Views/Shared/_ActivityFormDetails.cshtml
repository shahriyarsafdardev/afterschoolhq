@model AfterSchoolLibrary.Activity
@{ 
    var accountPackage = (AccountPackage)ViewData["AccountPackage"];
}

<div class="panel panel-default">
    <div class="panel-heading">
        About Your @UILabel.ActivityLabel(Model.ActivityTypeId)
    </div>
    <div class="panel-body">

        <div class="form-group">
            <label class="col-md-3 control-label">
                Enter details about your @UILabel.ActivityLabel(Model.ActivityTypeId).ToLower() <span class="text-danger">*</span>
                <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Tell us why we should sign up for your @UILabel.ActivityLabel(Model.ActivityTypeId).ToLower(). What will we get out of it?. What should we expect?" data-placement="top"></i>
            </label>
            <div class="col-md-9">
                @{ Html.RenderPartial(
                  "~/Views/Shared/_TextEditor.cshtml",
                  Model.Details,
                  new ViewDataDictionary() {
                        { "required", true },
                        { "name", "details" },
                        { "id", "details" }
                  }
                  ); }
            </div>
        </div>

    </div>
</div>

