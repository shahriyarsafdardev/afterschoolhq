</div>

<script type="text/javascript">
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('input[name="couponApplyType"]').click(function () {
            if ($(this).data('flag') === 'SubscriptionPlan') {
                $('#duration-section').removeClass('hide');
            } else {
                $('#duration-section').addClass('hide');
            }
        });

        $('#form-add-payment').submit(function () {
            $('#btn-submit-payment').html('Adding Payment...');
            $('#btn-submit-payment').prop('disabled', true);
        });
    });

    function toggleDiscountType(type) {
        if (type == @((int)CouponAmountType.FlatAmount)) {
            $('#amounttype-flat').removeClass('hide');
            $('#amounttype-percentage').addClass('hide');
        } else {
            $('#amounttype-percentage').removeClass('hide');
            $('#amounttype-flat').addClass('hide');
        }
    }
    
</script>

@if (isPrintView)
{
    <div style="page-break-after: always;"></div>
}
