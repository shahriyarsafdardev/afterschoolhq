@model List<RegistrantActivity>
@{
    var account = (Account) ViewData["Account"];
    var activity = (Activity) ViewData["Activity"];
    var participationObject = activity.GetParticipationObject();
    var editaction = ViewData["EditAction"].ToString();
    var editcontroller = ViewData["EditController"].ToString();
    var headerTitle = (RegistrationAssignmentType) ViewData["HeaderTitle"];
    var isTechSupport = SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
    var isReadOnly = (bool) ViewData["IsReadOnly"];
    var assignmentTypesForActivity = activity.GetRegistrationAssignmentTypes();
    var canViewRegistrantData = ViewData["canViewRegistrantData"].IsNotEmpty() ? ViewData["canViewRegistrantData"].ToString().ToBoolean() : true;
}

<div class="panel panel-default">
<div class="panel-heading">
    <h3 class="panel-title">@headerTitle.ToString().SplitByUpperCase()</h3>
</div>
<div class="panel-body">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
            <tr>
                <th></th>
                <th>Name</th>
                @if (!participationObject.CanRegisterPerClass)
                {
                    <th class="text-center">Seat Index</th>
                }
                <th>Date Registered</th>
                @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView))
                {
                    <th>Amount Paid</th>
                }
                @if (!participationObject.CanRegisterPerClass)
                {
                    <th>Status</th>
                    <th></th>
                }
            </tr>
            </thead>
            <tbody>
            @if (Model.Count > 0)
            {
                foreach (var ra in Model)
                {
                    var instanceSeats = ra.GetInstanceSeats();
                    <tr class="instance @instanceSeats.Select(x => $"instance-{x.ActivityInstanceId.ToString()}").ToStringList(" ")">
                        <td>
                            @if (ra.RegistrationId.HasValue && ra.AssignmentTypeId != RegistrationAssignmentType.Invited && canViewRegistrantData)
                            {
                                <a href="@Url.Action(editaction, editcontroller, new {id = ra.Uid})" class="btn btn-default btn-sm">
                                    <i class="icon icon-left s7-user"></i> View Details
                                </a>
                            }
                        </td>
                        <td>
                            @(!isTechSupport ? ra.RegistrantName.IfBlank(ra.RegistrantEmail)
                                : ra.RegistrantEmail.Length < 3 ?
                                    ra.RegistrantName.IfBlank(ra.RegistrantEmail).MaskString(0, ra.RegistrantName.Length)
                                    : ra.RegistrantName.IfBlank(ra.RegistrantEmail).MaskString(3, 3))
                        </td>
                        @if (!participationObject.CanRegisterPerClass)
                        {
                            <td class="text-center">@ra.SeatIndex</td>
                        }

                        <td>@account.ConvertToAccountTimeZone(ra.CreateDate.Value).ToLongDateTimeString()</td>
                        @{
                            var hasPaymentPlan = ra.HasPaymentPlan();
                            var registrant = ra.GetRegistrant();
                            var amountPaid = ra.GetAmountPaid();
                        }
                        @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView))
                        {
                            var isProRated = ra.GetIsProRatedFlagByParent();

                            <td>
                                @if (participationObject.IsFree)
                                {
                                    @:FREE
                                }
                                else
                                {
                                    @amountPaid.ToCurrency()

                                    if (isProRated)
                                    {
                                        <i class="s7-info icon-small"
                                           data-toggle="popover"
                                           data-trigger="hover"
                                           data-html="true"
                                           data-placement="top"
                                           data-content="Amount paid for this student is pro-rated by AHQ system and Stripe.">
                                        </i>
                                    }

                                    if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView) && participationObject.IsNotFreeAndCanAcceptPayments && registrant.ParentRegistrantId.HasValue)
                                    {
                                        if (hasPaymentPlan)
                                        {
                                            <i class="s7-flag icon-small" data-toggle="popover" data-trigger="hover" data-html="true" data-placement="top"
                                               data-content="Student registered with payment plan.">
                                            </i>
                                        }

                                        if (amountPaid == 0)
                                        {
                                            var showPayLaterIcon = true;

                                            if (activity.HasSubscriptionPlan())
                                            {
                                                var subscriptionPlan = activity.GetSubscriptionPlan();

                                                if (subscriptionPlan.SplitCostEvenly && !activity.RegistrationFinalized)
                                                {
                                                    showPayLaterIcon = false;
                                                }
                                            }
                                            if (hasPaymentPlan)
                                            {
                                                showPayLaterIcon = false;
                                            }
                                            if (showPayLaterIcon)
                                            {
                                                <i class="s7-info icon-small" data-toggle="popover" data-trigger="hover" data-html="true" data-placement="top"
                                                   data-content="Student registered with option of allow to pay later.">
                                                </i>
                                            }
                                        }
                                    }
                                }
                            </td>
                        }
                        @if (!participationObject.CanRegisterPerClass)
                        {
                            <td>
                                @if (ra.IsRegistrantActivityStatusAccessible() && !isReadOnly)
                                {
                                    <select name="newassignmenttype"
                                            id="newassignmenttype-@ra.ID"
                                            class="form-control"
                                            onchange="moveRegistrantAssignment(@ra.RegistrantId, '@UI.JavascriptSafeString(ra.RegistrantName)', this)"
                                            @(isReadOnly ? "disable" : "")>

                                        @foreach (var assignmenttype in assignmentTypesForActivity)
                                        {
                                            <option value="@((int) assignmenttype)" @(assignmenttype == ra.AssignmentTypeId ? "selected=\"selected\"" : "")>
                                                @assignmenttype.ToString().SplitByUpperCase()
                                            </option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <label>@ra.AssignmentTypeId</label>
                                }
                            </td>
                            <td>
                                @if (ra.AssignmentTypeId == RegistrationAssignmentType.Withdrawn)
                                {
                                    <button type="button" class="btn btn-primary searchActivitiesBtn"
                                            onclick="showModal(@(!activity.IsFree ? "\'modal-process-free-re-enrollment\'" : "\'modal-process-re-enrollment\'"));
                                            setModalAttributes('@ra.RegistrantUid.ToString()', '@ra.ParticipationObjectId.ToString()', 
                                            '@ra.ParticipationObjectTypeId.ToString()')">
                                        Re-Enroll
                                    </button>
                                }
                                else
                                {
                                    if (ra.IsWithdrawEnabled() && !isReadOnly)
                                    {
                                        var subCount = ra.GetRegistrant().GetSubscriptionCount(participationObject);

                                        <button id="btn-withdraw-@ra.Uid" class="btn btn-danger btn-sm"
                                                onclick="return processWithdraw('@ra.Uid', '@ra.ID', '@ra.RegistrantUid', '@ra.ParticipationObjectId', '@ra.ParticipationObjectTypeId', '@ra.RegistrantFirstName','@subCount', '@hasPaymentPlan');">
                                            Withdraw
                                        </button>
                                    }
                                    if (ra.IsSendInvoiceEnabled() &&
                                        Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView) &&
                                        participationObject.IsNotFreeAndCanAcceptPayments &&
                                        amountPaid == 0 && registrant.ParentRegistrantId.HasValue && !isReadOnly)
                                    {
                                        var showButton = true;

                                        if (activity.HasSubscriptionPlan())
                                        {
                                            var subscriptionPlan = activity.GetSubscriptionPlan();

                                            if (subscriptionPlan.SplitCostEvenly && !activity.RegistrationFinalized)
                                            {
                                                showButton = false;
                                            }
                                        }
                                        if (hasPaymentPlan)
                                        {
                                            showButton = false;
                                        }
                                        if (showButton)
                                        {
                                            <button class="btn btn-default btn-sm"
                                                    data-modal="modal-waitinglist"
                                                    id="btnsendinvoice-@ra.ID"
                                                    onclick="sendPaymentReminder(this, @ra.RegistrantId, '@UI.JavascriptSafeString(ra.RegistrantName)')">
                                                Send Payment Link
                                            </button>
                                        }
                                    }
                                }
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">There are no @UILabel.RegistrantLabel(true).ToLower()</td>
                </tr>
            }
            </tbody>

        </table>
    </div>
</div>
</div>
<div id="modal-process-re-enrollment" class="md-modal colored-header custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Re-enrollment Confirmation</h3>
        </div>
        <div id="modal-attributes" class="modal-body form text-center" data-ruid="" data-aid="" data-atype="">
            <p>Taco Turner has previously paid <strong>$150.00</strong> for <strong>My First Business</strong>. Do you want to send a payment link for a
                registration fee of <strong>$150.00</strong>?</p>
            <br/>
            <p class="fontSize12"><strong>NOTE:</strong> Refunds will not happen automatically and can be handled via the Accounting page.</p>
        </div>
        <div class="modal-footer textCenterImportant">
            <button type="button" onclick="reEnrollRegistrant(false)" data-dismiss="modal" class="btn btn-dark md-close">Re-enroll Without Charge</button>
            <button type="button" onclick="reEnrollRegistrant(true)" data-dismiss="modal" class="btn btn-default md-close">Re-enroll With Charge</button>
        </div>
    </div>
</div>
<div id="modal-process-free-re-enrollment" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Re-enrollment Confirmation</h3>
        </div>
        <div class="modal-body form text-center">
            <p>Do you want to re-enroll Taco Turner in <strong>My First Business</strong>.</p>
        </div>
        <div class="modal-footer textCenterImportant">
            <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            <button type="button" data-dismiss="modal" onclick="reEnrollRegistrant(false)" class="btn btn-default">Confirm Re-enrollment</button>
        </div>
    </div>
</div>
<div id="modal-display-response" class="md-modal colored-header custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" onclick="reloadPage()" aria-hidden="true" class="close md-close">
                <i class="icon s7-close"></i>
            </button>
            <h3 class="modal-title">Re-enrollment Message</h3>
        </div>
        <div class="modal-body form text-center">
            <p id="display-Message"></p>
            <br/>
            <p id="refundNote" class="fontSize12 hide"><strong>NOTE:</strong> Refunds will not happen automatically and can be handled via the Accounting page.</p>
        </div>
        <div class="modal-footer textCenterImportant">
              <button type="button" class="btn btn-default" onclick="reloadPage()" data-dismiss="modal">Close</button>
        </div>
    </div>
</div>
<script>
    function reEnrollRegistrant(requirePayment) {
        showLoader();
        let url = '@Url.Action("ReEnrollRegistrant", "Activity", new {Area = "Org"})';
        let participationObjectId = $('#modal-attributes').attr('data-aid');
        let registrantUId = $('#modal-attributes').attr('data-ruid');
        let type = $('#modal-attributes').attr('data-atype');
        $.ajax({
            type: "POST",
            url: url,
            data: { participationObjectId: participationObjectId, registrantUId: registrantUId, requirePayment: requirePayment, participationObjectType: type },
            success: function (data) {
                if (data && data.success === true) {
                    hideLoader();
                    displayResponse(data.data, false);
                } else if (data && data.status === 'error') {    
                    hideLoader();
                    displayResponse(data.data, true);
                }
            }
        });
    }
    function setModalAttributes(ruid,aid,atype)
    {
        $("#modal-attributes").attr('data-ruid',ruid);
        $("#modal-attributes").attr('data-aid',aid);
        $("#modal-attributes").attr('data-atype',atype);
    }
    function showModal(modal)
    {
       
       $(modal).modal('show');
    }
    function displayResponse(data, isError)
    {
        let beforeText = "";
        let displayMessage = $("#display-Message");
        let refundNote = $("#refundNote");
        if (!isError) {
            beforeText = 'Success! ';
            displayMessage.attr('success','true');
            refundNote.removeClass('hide');
        }
        else {
            beforeText = 'Error! ';
            displayMessage.attr('success','false');
            refundNote.addClass(' hide');
        }
        displayMessage.html(beforeText + data);
        showModal("modal-display-response");
    }
    function reloadPage()
    {
        if ($("#display-Message").attr('success') === 'true') {
            setTimeout(function () {
                location.reload();
            }, 500);
        }
    }
</script>