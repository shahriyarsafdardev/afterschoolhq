@model ActivityForm

<div class="form-group">
    <label class="col-sm-3 control-label">Registration Form Name</label>
    <div class="col-sm-6">
        <input type="text" class="form-control" id="name" name="name" value="@Model.Name.IfBlank(Model.ActivityName + " Registration Form")" onfocus="this.select()" required />
    </div>
</div>

<div class="form-group">
    <label class="col-sm-3 control-label">Brief Instructions</label>
    <div class="col-sm-6">
        <textarea name="description" id="description" class="form-control" rows="5" required>@Model.Description.IfBlank("Please fill in the registration form below")</textarea>
    </div>
</div>

@foreach (var group in Model.ToForm().GetQuestionGroups())
{
    <div class="panel panel-alt4">
        <div class="panel-heading">
            @group.Name
        </div>
        <div class="panel-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <tr>
                        <th>Question Text</th>
                        <th>Show Question?</th>
                        <th>Is Required?</th>
                    </tr>
                    @foreach (var question in group.GetAllQuestions())
                    {
                        <tr>
                            <td>@question.Text</td>
                            <td>
                                @{Html.RenderPartial(
                                  "~/Views/Shared/_SwitchButton.cshtml",
                                  question.IsActive,
                                  new ViewDataDictionary()
                                  {
                                      { "checkboxname", "active-" + question.ID },
                                      { "checkboxid", "active-" + question.ID },
                                      { "disabled", question.IsLocked }
                                  });}
                            </td>
                            <td>
                                @{Html.RenderPartial(
                                  "~/Views/Shared/_SwitchButton.cshtml",
                                  question.IsRequired,
                                  new ViewDataDictionary()
                                  {
                                      { "checkboxname", "required-" + question.ID },
                                      { "checkboxid", "required-" + question.ID },
                                      { "disabled", question.IsLocked }
                                  });}
                            </td>
                        </tr>
                    }

                </table>
            </div>
        </div>
    </div>
}