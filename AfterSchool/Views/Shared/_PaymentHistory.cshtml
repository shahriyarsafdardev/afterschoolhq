@model Account

@{ 
    var charges = (List<Stripe.Charge>)ViewBag.BillingHistory; 
}

@if (charges.Count > 0)
{
    <h4>Payment History</h4>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <tr>
                <th>Date</th>
                <th>Amount</th>
                <th>Card</th>
            </tr>
            @foreach (var charge in charges)
            {
                var card = (Stripe.Card)charge.Source;
                <tr>
                    <td>@Model.ConvertToAccountTimeZone(charge.Created).ToShortDateTimeString()</td>
                    <td>@((charge.Amount / 100M).ToCurrency())</td>
                    <td><span class="badge badge-success">@card.Brand</span> **** **** **** @card.Last4</td>
                </tr>
                }
        </table>
    </div>
}

