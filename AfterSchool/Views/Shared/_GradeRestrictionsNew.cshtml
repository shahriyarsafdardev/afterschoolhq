@{
    var grades = (List<GradeLevel>)ViewData["grades"];
    var minGradeLevelId = (int?)ViewData["minGradeLevelId"];
    var maxGradeLevelId = (int?)ViewData["maxGradeLevelId"];

    var showToggle = true;
    var showToggleUpdated = false;

    if ((bool)ViewData["showToggle"].IsNotEmpty())
    {
        showToggle = (bool)ViewData["showToggle"];
        showToggleUpdated = true;
    }

}

<div class="col-md-12 onboarding-form-group">
    <label class="onboarding-label">  GRADE RESTRICTIONS</label>

    <div class=@(showToggle ? "col-md-1": "")>
        @{Html.RenderPartial("~/Views/Shared/_SwitchButton.cshtml", minGradeLevelId.HasValue || (showToggleUpdated && !showToggle), new ViewDataDictionary() {
              { "checkboxname", "graderestrictions" },
              { "checkboxid", "graderestrictions" },
              { "disabled", false },
              { "hidden", showToggle ? "" : "hide" }
        }); }
    </div>

    <div class="hide" id="grade">
        <div class="col-md-4 col-xs-12" style="padding: 0;">
            <select id="mingrade" name="mingrade" class="form-control onboarding-input" style="height: 44px;">
                @foreach (var grade in grades)
                {
                    <option value="@grade.ID" @(minGradeLevelId == grade.ID ? " selected=\"selected\" " : "")>@grade.Name</option>
                }
            </select>
        </div>
         <p class="col-md-1 col-xs-12 margin-v-10 desktop-text-center" style="color: #00c5a3; font-size: 16px;">
            TO
        </p>
        <div class="col-md-4 col-xs-12" style="padding: 0;">
            <select id="maxgrade" name="maxgrade" class="form-control onboarding-input" style="height: 44px;">
                @foreach (var grade in grades)
                {
                    <option value="@grade.ID" @(maxGradeLevelId == grade.ID ? " selected=\"selected\" " : "")>@grade.Name</option>
                }
            </select>
        </div>
    </div>
</div>
<div class="clearfix"></div>

<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $('#graderestrictions').click(function () {
                gradeCheck();
            });

            $('#mingrade').change(function () {
                if (parseInt($(this).val()) > parseInt($('#maxgrade').val())) {
                    $('#maxgrade').val($(this).val());
                }
            });

            $('#maxgrade').change(function () {
                if (parseInt($(this).val()) < parseInt($('#mingrade').val())) {
                    $('#mingrade').val($(this).val());
                }
            });

            gradeCheck();
        }
    );

    function gradeCheck() {
        if ($('#graderestrictions').is(':checked')) {
            $('#grade').removeClass('hide');
        } else {
            $('#grade').addClass('hide');
        }
    }
</script>