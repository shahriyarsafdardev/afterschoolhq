@model string

@{
    var required = "";
    if (ViewData["required"].IsNotEmpty() && ViewData["required"].ToString().IsBoolean() && ViewData["required"].ToString().ToBoolean())
    {
        required = " required=\"required\" ";
    }

    var javascriptVarName = $"quill_{ViewData["name"]}";
    var javascriptAppendName = $"_{ViewData["name"]}";
}

<div class="">
    <div class="editable" id="@ViewData["id"]-div">@Html.Raw(Model)</div>
    <textarea name="@ViewData["name"]" id="@ViewData["id"]" class="hide"></textarea>
    <textarea name="@(ViewData["name"])_data" id="@(ViewData["id"])_data" class="hide"></textarea>
</div>

<script>

    var @javascriptVarName = new Quill('#@ViewData["id"]-div', {
        modules: {
            toolbar: [
                [{ header: [1, 2, 3, false] }, { 'align': [] }],
                ['bold', 'italic', 'underline'],
                ['link', 'blockquote', 'image'],
                [{ list: 'ordered' }, { list: 'bullet' }],
            ]
        },
        placeholder: '',
        theme: 'snow'
    });

    var valueOnPageLoadFor_@javascriptVarName = "";
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('form').submit(function () {

            var text = @(javascriptVarName).getText().trim();

            if (text.length == 0) {
                $('#@ViewData["id"]').val('');
            } else {
                $('#@ViewData["id"]').val(@(javascriptVarName).root.innerHTML);
            }

        });

        @(javascriptVarName).getModule('toolbar').addHandler('image', () => {
            selectLocalImage@(javascriptAppendName)();
        });

        valueOnPageLoadFor_@javascriptVarName = @(javascriptVarName).getText().trim();

        $(".reset").on('click', function () {
             @(javascriptVarName).root.innerHTML = valueOnPageLoadFor_@javascriptVarName;
             $('#@ViewData["id"]').val(@(javascriptVarName).root.innerHTML);
             $('#@ViewData["id"]').attr('data', @(javascriptVarName).getText());
        });
    });

 

    @(javascriptVarName).on('text-change', function () {
        $('#@ViewData["id"]').val(@(javascriptVarName).root.innerHTML);
        $('#@ViewData["id"]').attr('data', @(javascriptVarName).getText());
    });


    function selectLocalImage@(javascriptAppendName)() {
        const input = document.createElement('input');
        input.setAttribute('type', 'file');
        input.setAttribute('accept', '.jpg,.jpeg,.png');
        input.click();

        // Listen upload local image and save to server
        input.onchange = () => {
            const file = input.files[0];

            // file type is only image.
            if (/^image\//.test(file.type)) {
                saveToServer@(javascriptAppendName)(file);
            } else {
                console.warn('You can only upload images.');
            }
        };
    }

    function saveToServer@(javascriptAppendName)(file) {
        const fd = new FormData();
        fd.append('file', file);

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '@Url.Action("uploadfile", "services")', true);
        xhr.onload = () => {
            if (xhr.status === 200) {
                // this is callback data: url
                const data = JSON.parse(xhr.responseText);

                if (data && data.status == 'ok') {
                    const url = data.url;
                    insertToEditor@(javascriptAppendName)(url);
                } else {
                    Notifications.showErrors(data.messages);
                }
            }
        };
        xhr.send(fd);
    }

    function insertToEditor@(javascriptAppendName)(url) {
        // push image url to rich editor.
        const range = @(javascriptVarName).getSelection();
        @(javascriptVarName).insertEmbed(range.index, 'image', url);
    }

</script>
