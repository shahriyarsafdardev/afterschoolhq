@model List<WebUser>
@{
    string accountId = "";
    string returnUrl = "";
    var currentAccount = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
    var accountPackage = (AccountPackage)ViewData["AccountPackage"];
    var paging = (PagingModel)ViewData["PagingModel"];
    var isAfterSchoolAdmin = currentAccount.AccountTypeId == AccountType.AfterSchool;
    var canDelete = SessionVariables.OriginalLoggedInUser.IsNotEmpty();
    string inviteUrl = Url.Action("invite", "user");

    var currentUserType = currentUser.GetUserType(currentAccount);

    if (!ViewData["AccountId"].IsEmpty())
    {
        accountId = ViewData["AccountId"].ToString();
    }

    if (!ViewData["ReturnUrl"].IsEmpty())
    {
        returnUrl = ViewData["ReturnUrl"].ToString();
    }

    if (accountId.Length > 0)
    {
        inviteUrl = Url.Action("teaminvite", "account", new { id = accountId });
    }

    if (accountPackage.IsNotEmpty() && Model.Count >= accountPackage.GetFeature(FeatureType.TeamAccounts).Max.Value)
    {
        inviteUrl = "javascript:alert('Please upgrade your account or delete existing user accounts in order to invite additional users')";
    }

}
@if (accountPackage.IsNotEmpty())
{
    <p class="pull-right text-bold">
        @Model.Count of @((int)accountPackage.GetFeature(FeatureType.TeamAccounts).Max.Value) User Accounts
    </p>
    <div class="clearfix"></div>
}
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                @if (isAfterSchoolAdmin)
                {
                    <th></th>
                }
                <th>Name</th>
                <th>Email</th>
                <th>Registered?</th>
                <th>Is Active?</th>
                @if (!isAfterSchoolAdmin)
                {
                    <th>Type</th>
                }
                <th>Member Since</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count() > 0)
            {
                foreach (WebUser user in Model)
                {
            <tr>
                @if (isAfterSchoolAdmin)
                {
                    <td>
                        <a href="@Url.Action("impersonate", "user", new { id = accountId, uid = @user.Uid })" class="btn btn-default btn-xs">
                            <i class="icon icon-left s7-user"></i> View
                        </a>
                    </td>
                }
                <td>@user.DisplayName</td>
                <td><a href="mailto:@user.Email">@user.Email</a></td>
                <td>@user.IsRegistered.ToYesNo()</td>
                <td>@user.IsActive.ToYesNo()</td>
                @if (!isAfterSchoolAdmin)
                {
                <td>
                    @if (currentUserType == UserType.Administrator || currentUserType == UserType.Owner || currentUserType == UserType.TechSupport)
                    {
                        if ((user.GetUserType(currentAccount) == UserType.Administrator || user.GetUserType(currentAccount) == UserType.Owner) && currentUserType == UserType.Administrator)
                        {
                            @user.GetUserType(currentAccount).ToString().SplitByUpperCase()
                        }
                        else if (user.GetUserType(currentAccount) == UserType.Owner && currentUserType == UserType.Owner)
                        {
                            @user.GetUserType(currentAccount).ToString().SplitByUpperCase()
                        }
                        else
                        {
                            <select name="newassignmenttype"
                                    id="newassignmenttype-@user.ID"
                                    class="form-control"
                                    onchange="updateAssignment(@user.ID, '@UI.JavascriptSafeString(user.FullName)', this)">

                                @foreach (var assignmenttype in Enum.GetValues(typeof(UserType)).Cast<UserType>())
                                {
                                    switch (assignmenttype)
                                    {
                                        case UserType.NotSet:
                                        case UserType.Parent:
                                        case UserType.Student:
                                        case UserType.SuperAdmin:
                                            continue;
                                    }
                                    <option value="@((int)assignmenttype)" @(assignmenttype == user.GetUserType(currentAccount) ? "selected=\"selected\"" : "")>
                                        @assignmenttype.ToString().SplitByUpperCase()
                                    </option>
                                }
                            </select>
                        }
                    }
                    else
                    {
                        @user.GetUserType(currentAccount).ToString().SplitByUpperCase()
                    }
                </td>
                }
                <td>@user.CreateDate.Value.ToLongDateString()</td>
                <td>
                    <div class="btn-group">
                        @if (isAfterSchoolAdmin)
                        {
                            <a href="@Url.Action("edit", "user", new { id = user.Uid, returnUrl = returnUrl })" class="btn btn-default btn-xs">
                                <i class="icon icon-left s7-edit"></i> Edit
                            </a>
                        }
                        else if (!user.IsRegistered)
                        {
                            <button type="button"
                                    class="btn btn-default btn-sm md-trigger"
                                    data-modal="modal-invite"
                                    onclick="showInviteLink('@user.GetInviteUrl(currentAccount)')">
                                Get Invite Link
                            </button>

                        }
                        else if (SessionVariables.AccountUserType.In(AccountService.AdminUserTypes) && (user.ID != currentUser.ID))
                        {
                            <button type="button"
                                    class="btn btn-danger btn-sm md-trigger"
                                    data-modal="modal-confirm-delete"
                                    onclick="removeUser('@user.Uid', '@UI.JavascriptSafeString(user.DisplayName)')">
                                <i class="s7-trash"></i> Remove
                            </button>

                            Html.RenderPartial("~/Views/Shared/_Modal.cshtml", new ModalViewModel() { ActionButtonHtml = "Remove Team Member &raquo;", ActionButtonId = "btn-confirm-delete", HtmlBody = $"<p>Are you sure you want to remove <strong><span class=\"delete-user-name\"></span></strong> from the team?</p><p><strong>If you want to re-add <span class=\"delete-user-name\"></span> you will need to invite them again</strong></p>", ID = "modal-confirm-delete", Title = "Remove Team Member" });

                            <script>
                                        var userUid = '';
                                        function removeUser(uid, name) {
                                            $('.delete-user-name').html(name);
                                            userUid = uid;
                                        }
                                        PageEvent.add(PageEvent.AFTER_INIT, function () {
                                            $('#btn-confirm-delete').click(function () {
                                                location.href = '@Url.Action("TeamRemoveMember", "account")/' + userUid;
                                            });
                                        });
                            </script>
                        }
                    </div>
                </td>
            </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7">There are no users. Please <a href="@Url.Action("invite", "user", new { id = accountId, returnUrl = returnUrl })">invite new user</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{Html.RenderPartial(
        "~/Views/Shared/_Paging.cshtml",
        paging,
        new ViewDataDictionary()
        {
        { "id", "" },
        { "action", "index" },
        { "controller", "user" },
        { "querystring", $"search={Request["search"]}" }
        }
    );
}

<div id="modal-invite" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Invite Link</h3>
        </div>
        <div class="modal-body form">

            <input type="text" readonly="readonly" id="invite-link" value="" class="form-control" onclick="this.select()" />

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Done</button>
        </div>
    </div>
</div>

<script>
    function showInviteLink(link) {
        $('#invite-link').val(link);
    }
</script>
