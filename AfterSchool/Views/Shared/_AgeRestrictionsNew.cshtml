@{
    var agestart = (int?)ViewData["agestart"];
    var ageend = (int?)ViewData["ageend"];
    var showToggle = true;
    var showToggleUpdated = false;

    if ((bool)ViewData["showToggle"].IsNotEmpty())
    {
        showToggle = (bool)ViewData["showToggle"];
        showToggleUpdated = true;
    }
}

<div class="col-md-12 onboarding-form-group">
    <label class="onboarding-label">AGE RESTRICTIONS</label>

    <div class=@(showToggle ? "col-md-1": "")>
        @{Html.RenderPartial
              (
                  "~/Views/Shared/_SwitchButton.cshtml",
                  agestart.IsEmpty() || ageend.IsEmpty() || (showToggleUpdated && !showToggle),
                  new ViewDataDictionary()
                  {
                { "checkboxname", "agerestrictions" },
                { "checkboxid", "agerestrictions" },
                { "disabled", false },
                { "hidden", showToggle ? "" : "hide" }
                  }
              ); }
    </div>

    <div class="hide" id="age">
        <div class="col-md-4 col-xs-12" style="padding: 0;">
            <select id="agestart" name="agestart" class="form-control onboarding-input" style="height: 44px;">
                @for (int i = 0; i <= 18; i++)
                {
                    <option value="@i" @(agestart == i ? " selected=\"selected\" " : "")>@i</option>            
                }
            </select>
        </div>
        <p class="col-md-1 col-xs-12 margin-v-10 desktop-text-center" style="color: #00c5a3; font-size: 16px;">
            TO
        </p>
        <div class="col-md-4 col-xs-12" style="padding: 0;">
            <select id="ageend" name="ageend" class="form-control onboarding-input" style="height: 44px;">
                @for (int i = 0; i <= 18; i++)
                {
                    <option value="@i" @(ageend == i ? " selected=\"selected\" " : "")>@i</option>            
                }
            </select>
        </div>
    </div>
</div>
<div class="clearfix"></div>

<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $('#agerestrictions').click(function () {
                ageCheck();
            });

            $('#agestart').change(function () {
                if (parseInt($(this).val()) > parseInt($('#ageend').val())) {
                    $('#ageend').val($(this).val());
                }
            });

            $('#ageend').change(function () {
                if (parseInt($(this).val()) < parseInt($('#agestart').val())) {
                    $('#agestart').val($(this).val());
                }
            });

            ageCheck();
        }
    );

    function ageCheck() {
        if ($('#agerestrictions').is(':checked')) {
            $('#age').removeClass('hide');
        } else {
            $('#age').addClass('hide');
        }
    }
</script>