@model Activity
@{ 
    var list = (List<Attendance>)ViewData["attendances"];
    var totalPresent = Model.GetAttendancePresentCount();
    var totalSeats = Model.GetAttendancePossibleCount();
    var totalAbsent = totalSeats - totalPresent;
    var attendanceRate = "0";
    var account = SessionVariables.CurrentAccount;
    var controller = (string)ViewData["controller"];
    var postPayPlan = Model.HasPostPayPlan();

    if (totalPresent > 0)
    {
        attendanceRate = ((totalPresent.ToDouble() / (totalPresent + totalAbsent)) * 100).Round(1).ToString("###.#");
    }

    var paging = (PagingModel)ViewData["PagingModel"];
}

<div class="row">
    <div class="col-md-3">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                @if (list != null)
                {
                    <div data-toggle="counter" data-end="@list.Count" data-decimals="0" data-suffix="" class="value">@list.Count</div>
                }
                else
                {
                    <div data-toggle="counter" data-end="0" data-decimals="0" data-suffix="" class="value">0</div>
                }

                <div class="desc">Meetings</div>
            </div>
            <div class="icon"><span class="s7-users"></span></div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="widget widget-tile widget-bordered">
            <div class="data-info">
                <div data-end="@attendanceRate.IfBlank("0")" data-decimals="0" data-suffix="" class="value">@attendanceRate.IfBlank("0")%</div>
                <div class="desc">Attendance Rate</div>
            </div>
            <div class="icon"><span class="s7-check-circle"></span></div>
        </div>
    </div>
</div>

@{

    if (Model.HasSchedule)
    {
        <a href="@Url.Action("trackattendance", controller, new { id = Model.Uid.ToString() })" class="btn btn-primary btn-space">Take Attendance</a> 
    }
    else if (Model.ActivityTypeId.NotIn(new ActivityType[] { ActivityType.PermissionSlip, ActivityType.FieldTrip }))
    {
        <p>In order to take attendance, please <a href="@Url.Action("editschedule", "activity", new { id = Model.Uid })">add a schedule</a> to @Model.Name</p>
    }

    if (postPayPlan)
    {
        <a id="charge-attendance" onclick="chargeAttendanceFee()" disabled="disabled" class="btn btn-default btn-space">Charge Attendance Fee</a>
    }
}



<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                @{ 
                    if (postPayPlan)
                    {
                        <th>
                            <span class="am-checkbox">
                                <input type="checkbox" id="selectAllTransaction" onchange="selectAllAttendance(this)" />
                                <label for="selectAllTransaction"></label>
                            </span>
                        </th>
                    }
                }
                <th></th>
                <th>Date</th>
                <th>Total</th>
                <th># Present</th>
                <th># Absent</th>
            </tr>
        </thead>
        <tbody>
            @if (list != null && list.Count > 0)
            {
                foreach (var attendance in list)
                {
                    var seatsPossible = attendance.GetAttendanceRegistrantCount();
                    var presentCount = attendance.GetPresentCount();
                    var disableCheck = attendance.IsCharged ? "disabled" : ""; 
                    <tr>
                        @if (postPayPlan)
                        {
                            <td>
                                <span class="am-checkbox">
                                    <input type="checkbox"
                                           id="selectAttendance-@attendance.ID"
                                           @disableCheck 
                                           class="chkAttendance"
                                           onchange="selectAttendance(@attendance.ID,this)" />
                                    <label for="selectAttendance-@attendance.ID"></label>
                                </span>
                            </td>
                        }

                        <td>
                            <a href="@Url.Action("trackattendance", controller, new { id = Model.Uid, att = attendance.ID })" class="btn btn-primary btn-xs"><i class="icon icon-left s7-user"></i> View Details</a>
                        </td>

                        <td>@account.ConvertToAccountTimeZone(attendance.Date.Value).ToLongDateString()</td>

                        <td>@seatsPossible</td>

                        <td>@presentCount</td>

                        <td>@Math.Max(0, seatsPossible - presentCount)</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">You have not taken attendance yet</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ 

    Html.RenderPartial(
       "~/Views/Shared/_Paging.cshtml",
       paging,
       new ViewDataDictionary()
       {
            { "id", Model.Uid.ToString() },
            { "querystring", "" },
            { "action", "attendance" },
            { "controller", "activity" }
       }
   );
}




<form action="@Url.Action("chargeattendancefee","activity")" id="chargeAttendanceForm" method="post">
    @Html.Hidden("AttendanceIds")
    @Html.HiddenFor(m => m.Uid)
</form>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {

    });


    var selectedAttendances = [];

    function chargeAttendanceFee() {
        if (this.selectedAttendances.length > 0) {
            $("#AttendanceIds").val(this.selectedAttendances.join());
            $("#chargeAttendanceForm").submit();
        }
    }

    function selectAttendance(id, event) {
        if (event.checked) {
            this.selectedAttendances.push(id);
        }
        else {
            var index = this.selectedAttendances.map(x => {
                return x;
            }).indexOf(id);
            this.selectedAttendances.splice(index, 1);
        }
        if (this.selectedAttendances.length > 0)
            $("#charge-attendance").attr("disabled", false);
        else
            $("#charge-attendance").attr("disabled", true);
    }

    function selectAllAttendance(event) {
        var allChkBoxes = $(".chkAttendance");
        allChkBoxes.map(function (e) {
            if (event.checked) {
                if ($(this).prop("checked") == false)
                    this.click();
            }
            else {
                if ($(this).prop("checked") == true)
                    this.click();
            }
        })
    }

</script>