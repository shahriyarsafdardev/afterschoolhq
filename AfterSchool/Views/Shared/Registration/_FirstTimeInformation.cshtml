@model Account

@if (!Model.ID.HasValue)
{
    <div class="firsttime-information">
        <div class="row">
            <div class="pull-right hide">
                <i class="s7-close text-white text-large"></i>
            </div>
            <div class="col-md-6 col-md-offset-3">
                <h2 class="text-success">Welcome</h2>
                <p>
                    This is where your @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower() will be listed for parents to discover, register, and pay.
                </p>
                <h2 class="text-success">Is it Safe?</h2>
                <p>
                    AfterSchool HQ is trusted by parents, providers, schools, and districts alike. The information you and your parents enter is kept completely secure and private.
                </p>
                <h2 class="text-success">What does it cost?</h2>
                <p>
                    We understand you're working to make a difference. That is why we've decided to make our platform is free to use. You can add your @UILabel.ActivityLabel(ActivityType.Activity, true).ToLower(), register parents, and collect payments.
                </p>
                <p>
                    <a href="@Url.Action("index", "signup")" class="btn btn-register">Customize this page &raquo;</a>
                </p>
            </div>
        </div>
    </div>
}