@model Registrant

@{
    var participationObject = (ParticipationObject) ViewBag.ParticipationObject;
    var selectedDates = (List<DateTime>) ViewBag.SelectedDates;

    var registered = "Enrolled";
    var register = "Enroll";

    if (participationObject.RegistrationMode == RegistrationMode.Apply)
    {
        register = "Apply";
        registered = "Applied";
    }

    if (participationObject.SeatsRemaining == 0)
    {
        register = "Join Waiting List";
    }

    var disabledText = "";
    var btnText = "";
    var registerUrl = Url.Action("setstudent", "account", new {id = Model.Uid});
    var btnUrl = $"javascript:checkEligibility('{Model.Uid}', '{registerUrl}', 'btn-register-{Model.Uid}')";
    var registrantGrade = Model.GetAnswer(QuestionDataType.RegistrantGrade);
    var registrantGradeText = registrantGrade.Text;
    var canStillRegister = false;


    var ineligibleText = "";

    var isGradeRestricted = participationObject.IsNotEmpty() && participationObject.RestrictByGrade() && !participationObject.IsStudentGradeInRange(Model);
    var isAgeRestricted = participationObject.IsNotEmpty() && !participationObject.RestrictByGrade() && !participationObject.IsStudentAgeInRange(Model);
    var isGenderRestricted = participationObject.IsNotEmpty() && participationObject.IsGenderEnforced
                           && !participationObject.AcceptsGenderType(Model.GenderId);
    
    var startingGrade = "";
    var endingGrade = "";
    var minAge = "";
    var maxAge = "";
    var singleGrade = false;
    var singleAge = false;
    
    if (isGradeRestricted)
    {
        startingGrade = participationObject.GetActivity().GetStartingGradeLevel().Name;
        endingGrade = participationObject.GetActivity().GetEndingGradeLevel().Name;
        singleGrade = startingGrade == endingGrade;
    }
    else if (isAgeRestricted)
    {
        minAge = participationObject.GetActivity().AgeStart.ToString();
        maxAge = participationObject.GetActivity().AgeEnd.ToString();
        singleGrade = minAge == maxAge;
    }
    

    if (participationObject.CanRegisterPerClass)
    {
        canStillRegister = !Model.IsReservedForAllDates(participationObject, selectedDates, null);
    }


    if (Model.HasSubmittedFor(participationObject, null) && !canStillRegister)
    {
        if (Model.HasWithdrawn(participationObject))
        {
            if (participationObject.SubscriptionPlans.Any() && Model.HasCancelledSubscription(participationObject))
            {
                btnText = "Re-Enroll &raquo";
            }
            else
            {
                btnText = "Withdrawn";
                disabledText = " disabled=\"disabled\" ";
                btnUrl = "#";
            }
        }
        else if (!Model.HasConsentFor(participationObject))
        {
            btnText = "Give Consent";
        }
        else if (Model.OnWaitingListFor(participationObject))
        {
            btnText = "On Waiting List";
            disabledText = " disabled=\"disabled\" ";
            btnUrl = "#";
        }
        else if (!Model.IsReservedAndPaidFor(participationObject, null) && !Model.IsAppliedFor(participationObject, null) && !Model.MasterRegistrantHasPlan(participationObject))
        {
            var subscriptionPlan = participationObject.SubscriptionPlans.FirstOrDefault();

            if (subscriptionPlan.IsNotEmpty() && subscriptionPlan.SplitCostEvenly && !participationObject.RegistrationFinalized)
            {
                btnText = "Awaiting Finalization";
                disabledText = " disabled=\"disabled\" ";
                btnUrl = "#";
            }
            else
            {
                btnText = "Pay Now &raquo";
                btnUrl = Url.Action("makepayment", "account", new {id = Model.GetRegistrationWithParticipationObject(participationObject).Uid});
            }
        }
        else if (participationObject.IsSession()) //&& registered != "Applied" (NOTE: removed by Darye, not sure what this is doing, logic is not obvious - basing code on a text field doesn't seem right and needs more explanation if this is the right thing to do.
        {
            btnText = "Add To Existing Registration &raquo";
        }
        else
        {
            btnText = $"Already {registered}";
            disabledText = " disabled=\"disabled\" ";
            btnUrl = "#";
        }
    }
    else
    {
        // if incomplete let them "update and enroll" which will really force them to update their profiles
        // then it checks again after the profile is updated

        if (!Model.IsProfileCompleted)
        {
            btnText = "Update Profile &amp; Enroll &raquo";
            btnUrl = registerUrl;
        }
        else
        {
            switch (isGenderRestricted)
            {
                case true when isAgeRestricted:
                    btnText = "Ineligible";
                    disabledText = " disabled=\"disabled\" ";
                    ineligibleText = $"This activity is for students who are {minAge} years old" + (singleAge? "": $"- {maxAge}")+
                    $" and {ParticipationObjectUI.PrintGenderRestrictions(participationObject).ToLower()}.";
                    break;
                case true when isGradeRestricted:
                    btnText = "Ineligible";
                    disabledText = " disabled=\"disabled\" ";
                    ineligibleText = $"This activity is for students who are in {startingGrade} grade" + (singleGrade? "": $"- {endingGrade}")+
                                     $" and {ParticipationObjectUI.PrintGenderRestrictions(participationObject).ToLower()}.";
                    break;
                case false when isGradeRestricted:
                    btnText = "Ineligible";
                    disabledText = " disabled=\"disabled\" ";
                    ineligibleText = $"This activity is for students in grade {startingGrade}" + (singleGrade? "": $" - {endingGrade}") + ".";
                    break;
                case false when isAgeRestricted:
                    btnText = "Ineligible";
                    disabledText = " disabled=\"disabled\" ";
                    ineligibleText = $"This activity is for students who are {startingGrade}" + (singleGrade? "": $" - {endingGrade}") + ".";
                    break;
                case true:
                    btnText = "Ineligible";
                    disabledText = " disabled=\"disabled\" ";
                    ineligibleText = $"The selected activity is for {ParticipationObjectUI.PrintGenderRestrictions(participationObject).ToLower()}";
                    break;
                default:
                    btnText = register + " &raquo";
                    break;
            }
        }
    }
}
<div class="col-sm-12 col-md-6 col-lg-4">
    <div class="panel border-none">
        <div class="heading panel-h3 text-center bg-color-f0f0 p-l-0">
            <div class="student-register-fn-ln">
                <div class="font-size-20 font-weight-bold long-text-ellipses notranslate">@Model.FirstName</div>
                <div class="font-size-18 notranslate">@Model.LastName</div>
            </div>
        </div>
        <div class="panel-body p-15-25">
            <p class="text-center text-small padding-v-10 text-muted font-size-16 p-b-0">
                @UILabel.GetGradeDescription(registrantGradeText)
            </p>
            <p>
                <a href="@btnUrl"
                   id="btn-register-@Model.Uid"
                   class="btn btn-register-primary btn-lg"
                   @disabledText>
                    @Html.Raw(btnText)
                </a>
            </p>
            <p class="text-center" style="color: #b3b3b3;">@Html.Raw(ineligibleText.IsNotEmpty() ? ineligibleText : "<br>")</p>
            <p class="text-center">
                @if (Model.IsProfileCompleted)
                {
                    <a href="@Url.Action("editstudentpersonal", "family", new {Area = "user", id = Model.Uid, student = Model?.Uid, returnUrl = Request.Url.AbsolutePath})">Update Profile</a>
                }
                else
                {
                    <span>&nbsp;</span>
                }
            </p>
        </div>
    </div>
</div>