@model Account
@{
    var showAdd = !Model.ID.HasValue || (
        SessionVariables.CurrentUser.IsNotEmpty() &&
        SessionVariables.CurrentAccount.AccountTypeId.In(FormConstants.ProviderAccountTypes));

    var addActivityUrl = "";
    var addText = $"Add {UILabel.ActivityLabel()}";
    var footerText = $"Create a new {UILabel.ActivityLabel()}";

    if (showAdd)
    {
        addActivityUrl = Url.Action("editsetup", "activity", new {isnew = 1, type = (int) ActivityType.Activity, Area = "org"});

        if (!Model.ID.HasValue)
        {
            addActivityUrl = Url.Action("index", "signup");
            footerText = $"Customize this page by creating your first {UILabel.ActivityLabel().ToLower()}";
        }
    }
}

@if (showAdd)
{
    <div class="col-sm-12 col-md-6 col-lg-4 participation-object participation-object-add pointer" onclick="location.href='@addActivityUrl'">
        <div class="panel">
            <div class="panel-body">
                <div class="padding-v-20 margin-t-10">
                    <p class="text-center">
                        <i class="s7-plus icon-xxlarge text-success"></i>
                    </p>
                    <p>&nbsp;</p>
                    <p class="text-center text-large text-success">
                        @addText
                    </p>
                </div>
            </div>
            <div class="panel-footer">
                <p class="text-center">@footerText</p>
            </div>
        </div>
    </div>
}