@model Account
@{ 
    var showAdd = !Model.ID.HasValue || (
        SessionVariables.LoggedInUser.IsNotEmpty() &&
        SessionVariables.AccountUserType.NotIn(new List<UserType>() { UserType.Parent, UserType.Student }));

    var addActivityUrl = "";

    if (showAdd)
    {
        addActivityUrl = Url.Action("editsetup", "activity", new { isnew = 1, Area = "org" });

        if (!Model.ID.HasValue)
        {
            addActivityUrl = Url.Action("index", "signup", new { orgname = Model.Name });
        }
    }
}

@if (showAdd)
{
    <div class="col-sm-12 col-md-6 col-lg-4 participation-object pointer" onclick="location.href='@addActivityUrl'">
        <div class="panel">
            <div class="panel-body">
                <div class="padding-v-30 margin-t-20">
                    <p class="text-center">
                        <i class="s7-plus icon-xxlarge text-success"></i>
                    </p>
                    <p>&nbsp;</p>
                    <p class="text-center text-xlarge text-success">
                        Add Activity
                    </p>
                </div>
            </div>
        </div>
    </div>
}
