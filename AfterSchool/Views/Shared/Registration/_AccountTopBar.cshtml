@model Account
@{
    var currentUser = SessionVariables.CurrentUser;
    var currentAccount = SessionVariables.CurrentAccount;
    var accountOrDashboard = "Account";
    var participationObject = (ParticipationObject)ViewData["ParticipationObject"];
    var canPublishActivity = ViewData["CanPublishActivity"].IsNotEmpty() ? ViewData["CanPublishActivity"].ToString().ToBoolean() : false;
    var dashboardUrl = Url.Action("index", "home", new { area = "user" });
    var session = (ParticipationObject)ViewData["session"];
    var isDuringProfileSetup = false;
    var returnUrl = SessionVariables.RegistrationStartPageAccount?.HomePageUrl;
    var registrationStartPage = SessionVariables.RegistrationStartPageAccount;
    var isAccount = ViewData["IsAccount"] != null ? (bool)ViewData["IsAccount"] : false;
    var isOnboardingStepsAcknowledged = CookieVariables.OnboardingStepsAcknowledged;
    var isInEditMode = Request["edit"] == "1";

    var enableApproveButton = canPublishActivity &&
        !participationObject.IsPublished &&
        participationObject.IsNotEmpty() &&
        participationObject.IsExternalToAccount(currentAccount) &&
        !participationObject.IsAccountActivityGroup();

    if (currentAccount.IsNotEmpty() && currentAccount.AccountTypeId != AccountType.Registrant)
    {
        accountOrDashboard = "Dashboard";
        dashboardUrl = Url.Action("index", "home", new { area = "org" });
    }

    if (session.IsEmpty() && participationObject.IsNotEmpty() && participationObject.IsSession())
    {
        session = participationObject;
    }

    if (ViewData["IsDuringProfileSetup"].IsNotEmpty() && ViewData["IsDuringProfileSetup"].ToString().IsBoolean())
    {
        isDuringProfileSetup = ViewData["IsDuringProfileSetup"].ToString().ToBoolean();
    }

    var currentLevel = AccountService.OnboardingCompletionStatus(currentAccount);
    var currentProgress = AccountService.GetCurrentOnboardingProcess(currentAccount);
    var totalNumberOfOnboardingSteps = 4;
    var hasAnyPaidActivity = currentAccount.IsNotEmpty() && currentAccount.HasPaidActivities();
    //If there is no paid activity configured then we should not display Payment Modal and Progressbar to user
    var totalStepsLeft = hasAnyPaidActivity ? totalNumberOfOnboardingSteps : totalNumberOfOnboardingSteps - 1;
    var progressPercentage = ((Decimal)currentProgress.Count / totalStepsLeft) * 100;


    var isAccountAndLoggedInUserIsOwner = currentAccount.IsNotEmpty() &&
        currentUser.IsNotEmpty() &&
        (currentAccount.ID == Model?.ID) &&
        (currentUser.HasAccessTo(Model));

    Activity unpublishActivity = null;
    var url = "";
    if (currentLevel == GettingStartedOptions.PublishActivity)
    {
        unpublishActivity = AccountService.GetUnpublishActivity(SessionVariables.CurrentAccount);
        if (unpublishActivity.IsNotEmpty())
        {
            url = unpublishActivity.ShortHomePageUrl;
        }
    }

    var loginReturnUrl = ViewData["LoginReturnUrl"];

    var cleverSsoEnabled = ViewData["CleverSsoEnabled"];

    //set redirection url for clever login to redirect user to home page if they try to login from account topbar
    TempData["redirectUrl"] = loginReturnUrl.IsNotEmpty() ? loginReturnUrl.ToString() : returnUrl;
}

@helper RenderReturnToHomeUrl(ParticipationObject session, Account registrationStartPage)
{
    if (session.IsNotEmpty() && !Request.Url.ToString().ToLower().Contains(session.GetHomePageUrl().ToLower()))
    {
        <a href="@session.GetBrowseUrl()" class="btn btn-link">
            &laquo; Return to @session.Name Home
        </a>
    }
    else if (Model.IsNotEmpty() && !(Model.HomePageUrl.ToLower().Contains(Request.Url.AbsolutePath.ToLower())))
    {
        <a href="@Model.HomePageUrl" class="btn btn-link">
            &laquo; Return To Profile
        </a>
    }
}

<style>
    .dropdown-menu > li > a:focus, .dropdown-menu > li > a:active {
        color: #b3b3b3;
    }
</style>

<div class="blur-bg"></div>

<div class="reg-login-bar">
    @if (Model.IsNotEmpty() && Model.ID.HasValue)
    {
    <div class="row" style="line-height: 35px;">
        <div class="col-md-6 col-sm-6 col-xs-12">

            @if (isAccount && isAccountAndLoggedInUserIsOwner && Model.OnboardingCompletionStatus() != GettingStartedOptions.ProcessCompleted && isOnboardingStepsAcknowledged != "True" && !isInEditMode)
            {
                <div id="popover-container" class="dropdown popover-dropdown">
                    <a id="ddl-finish-setup" class="dropdown-toggle dropdown-label" onclick="return toggleList();">
                        Finish Setup
                        <div class="progress" style="height: 4px; margin-bottom: 0;">
                            <div class="progress-bar" style="width:@progressPercentage%; background-color: #00AE83;"></div>
                        </div>
                    </a>
                    <ul class="dropdown-menu" style="background-color: #434e52;">
                        <li>
                            @if (currentLevel == GettingStartedOptions.CreateProfile)
                            {
                                <a class="active-item finish-setup-anchor" href="#">
                                    <div class="am-checkbox checkbox-override" onclick="return redirectUser('@GettingStartedOptions.CreateProfile');">
                                        <input id="chk-TopBar-getting-started-profile" name="GettingStartedSelection-TopBar" type="checkbox"
                                               value="@GettingStartedOptions.CreateProfile"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.CreateProfile) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-profile">Create Profile</label>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a href="#" class="finish-setup-anchor cursor-no-drop">
                                    <div class="am-checkbox checkbox-override">
                                        <input id="chk-TopBar-getting-started-profile" name="GettingStartedSelection-TopBar" type="checkbox" disabled="disabled"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.CreateProfile) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-profile">Create Profile</label>
                                    </div>
                                </a>
                            }
                        </li>
                        <li>
                            @if (currentLevel == GettingStartedOptions.CreateFirstActivity || currentLevel == GettingStartedOptions.PublishActivity)
                            {
                                <a class="active-item finish-setup-anchor" href="#">
                                    <div class="am-checkbox checkbox-override" onclick="return redirectUser('@currentLevel');">
                                        <input id="chk-TopBar-getting-started-first-activity" name="GettingStartedSelection-TopBar" type="checkbox"
                                               value="@GettingStartedOptions.CreateFirstActivity"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.CreateFirstActivity) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-first-activity">Create Your First Activity</label>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a href="#" class="finish-setup-anchor cursor-no-drop">
                                    <div class="am-checkbox checkbox-override">
                                        <input id="chk-TopBar-getting-started-first-activity" name="GettingStartedSelection-TopBar" type="checkbox" disabled="disabled"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.CreateFirstActivity) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-first-activity">Create Your First Activity</label>
                                    </div>
                                </a>
                            }
                        </li>
                        <li>
                            @if (currentLevel == GettingStartedOptions.ValidateEmail)
                            {
                                <a class="active-item finish-setup-anchor" href="#">
                                    <div class="am-checkbox checkbox-override" onclick="return redirectUser('@GettingStartedOptions.ValidateEmail');">
                                        <input id="chk-TopBar-getting-started-email" name="GettingStartedSelection-TopBar" type="checkbox"
                                               value="@GettingStartedOptions.ValidateEmail"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.ValidateEmail) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-email">Validate Email</label>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a href="#" class="finish-setup-anchor cursor-no-drop">
                                    <div class="am-checkbox checkbox-override">
                                        <input id="chk-TopBar-getting-started-email" name="GettingStartedSelection-TopBar" type="checkbox" disabled="disabled"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.ValidateEmail) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-email">Validate Email</label>
                                    </div>
                                </a>
                            }
                        </li>
                        <li>
                            @if (currentLevel == GettingStartedOptions.AcceptPayments)
                            {
                                <a class="active-item finish-setup-anchor" href="#">
                                    <div class="am-checkbox checkbox-override" onclick="return redirectUser('@GettingStartedOptions.AcceptPayments');">
                                        <input id="chk-TopBar-getting-started-payments" name="GettingStartedSelection-TopBar" type="checkbox"
                                               value="@GettingStartedOptions.AcceptPayments"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.AcceptPayments) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-payments">Accept Payments</label>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a href="#" class="finish-setup-anchor cursor-no-drop">
                                    <div class="am-checkbox checkbox-override">
                                        <input id="chk-TopBar-getting-started-payments" name="GettingStartedSelection-TopBar" type="checkbox" disabled="disabled"
                                               @(currentProgress.IsNotEmpty() && currentProgress.Contains(GettingStartedOptions.AcceptPayments) ? "checked=\"checked\"" : "") />
                                        <label for="chk-TopBar-getting-started-payments">Accept Payments</label>
                                    </div>
                                </a>
                            }

                        </li>
                    </ul>

                    <ul class="popover-menu">
                        <li class="popover-menu-item">
                            You can complete remaining process from here.
                            <br />
                            <br />
                            <button class="btn btn-success btn-xs" onclick="return popOverButton()">Got It.</button>
                            <br />
                            <div class="clearfix"></div>
                        </li>
                    </ul>
                </div>
            }

            @if (registrationStartPage.IsNotEmpty())
            {
                <div class="reg-login-bar-title">
                    <a href="@registrationStartPage.HomePageUrl">
                        <span class="reg-login-bar-title-item notranslate" style="@(ViewData["InsideActDetails"] != null ? "color:#b2b2b4": "")">@registrationStartPage.Name</span>
                    </a>
                    @if (ViewData["InsideActDetails"] != null)
                    {
                        <span class="reg-login-bar-title-item notranslate"> > @ViewData["InsideActDetails"]</span>
                    }
                </div>
            }
            else if (currentUser.IsNotEmpty())
            {
                if (currentAccount.IsNotEmpty())
                {
                    <span class="reg-login-bar-title notranslate">@currentAccount.Name</span>
                }
                else
                {
                    <span class="reg-login-bar-title notranslate">@currentUser.DisplayName</span>
                }
            }

        </div>

        @if (!isDuringProfileSetup)
        {
            <div class="col-md-6 col-sm-6 col-xs-12">
                <div class="pull-right navTop">
                    <input type="checkbox" id="nav-check">
                    
                    <div class="nav-links">


                        @RenderReturnToHomeUrl(session, registrationStartPage)
                        @Html.Partial("_GoogleTranslateDropDown");

                        @if (currentUser.IsNotEmpty())
                        {

                            if (enableApproveButton)
                            {
                                <a href="@Url.Action("publishdetail", "activity", new { Area = "org", id = participationObject.Uid })"
                                   class="btn btn-primary btn-sm">
                                    Approve &amp; Publish Activity &raquo;
                                </a>
                            }

                            if (currentUser.IsActive)
                            {
                                <a href="@dashboardUrl" class="btn btn-link">@accountOrDashboard</a>
                            }
                            else if (!currentUser.IsRegistered)
                            {
                                <a href="@AfterSchoolLibrary.Helpers.Utilities.CompleteSignUpUrl(currentUser.Uid, Request.Url.ToString())" class="btn btn-link">Complete account setup &raquo;</a>
                            }

                            if (Model.HasAccountProfile() && currentUser.HasAccessTo(Model))
                            {
                                var editModeUrl = Model.HomePageUrl;


                                if (!isInEditMode)
                                {
                                    if (editModeUrl.Contains("?"))
                                    {
                                        editModeUrl += "&";
                                    }
                                    else
                                    {
                                        editModeUrl += "?";
                                    }
                                }

                                <a href="@(editModeUrl)@(!isInEditMode ? "edit=1" : "")" class="btn btn-link">Toggle Edit Mode</a>
                            }

                            if (currentUser.HasMultipleAccounts())
                            {
                                var registrationAccount = currentUser.GetRegistrantAccount();
                                if (registrationAccount.IsNotEmpty() && currentAccount?.ID != registrationAccount.ID)
                                {
                                    <a class="btn btn-link" href="@Url.Action("select", "login", new { area = "", id = registrationAccount.Uid.ToString() })">Switch to @registrationAccount.Name</a>
                                }
                                else
                                {
                                    <a href="@Url.Action("switch", "logout", new { returnurl = returnUrl })" class="btn btn-link">Switch Accounts</a>
                                }
                            }
                            <a href="@Url.Action("index", "logout", new { returnurl = returnUrl })" class="btn btn-link">Logout</a>
                        }
                        else
                        {

                            <button type="button" class="btn btn-link md-trigger" onclick="return showModal('modal-login')">Login to Account</button>
                        }
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-6 col-sm-6 col-xs-12">
             <div class="btn-group pull-right">
                 @Html.Partial("_GoogleTranslateDropDown");
            </div>
            </div>

        }
    </div>
    }
    else if (false)
    {
        <div class="row">
            <div class="pull-right">
                @RenderReturnToHomeUrl(session, registrationStartPage)
            </div>
        </div>
        <div>
            <a href="@Url.Action("index", "signup")" class="btn btn-alt7 btn-block btn-xl">
                <span class="hidden-xs">
                    Complete your free account to customize this page &raquo;
                </span>
                <span class="hidden-sm hidden-md hidden-lg">
                    Complete your free account &raquo;
                </span>
            </a>
            <button type="button" class="btn btn-alt7 btn-block btn-xl md-trigger hide" data-modal="modal-lead-form">
                Sign Up for Your Free Account &raquo;
            </button>
        </div>
    }
</div>

@{
    Html.RenderPartial("~/Views/Shared/Registration/_LoginModalWithUpdatedDesign.cshtml", null, new ViewDataDictionary()
    {
        { "ReturnUrl", loginReturnUrl },
        { "CleverSsoEnabled", cleverSsoEnabled },
    });
}

<script type="text/javascript">
    function popOverButton() {
        if ($("#popover-container").hasClass("popover-setup")) {
            $("#popover-container").removeClass("popover-setup popover-active full-z-index");
            $('.blur-bg').hide()
            $('body').removeClass('hidden-overflow');
            setOnboardingStepsAcknowledge();
        }
        else {
            $("#popover-container").addClass("popover-setup popover-active full-z-index");
            $('.blur-bg').show();
            $('body').addClass('hidden-overflow');
            toggleList();
        }
    }

    function toggleList() {
        var itm = $('#ddl-finish-setup');
        $(itm).parent().toggleClass('open');
    }

    function redirectUser(item) {
        showLoader()

        if (item == '@GettingStartedOptions.CreateProfile') {
            location.href = '@Url.Action("programinfo", "onboarding", new { area = "org" })';
        } else if (item == '@GettingStartedOptions.CreateFirstActivity') {
            location.href = '@Html.Raw(Url.Action("editsetup", "activity", new { area = "org", isnew = 1, type = (int)ActivityType.Activity }))';
        } else if (item == '@GettingStartedOptions.PublishActivity') {
            location.href = '@url';
        } else if (item == '@GettingStartedOptions.ValidateEmail') {
           javascript:AccountSetup.sendVerificationEmail();
        } else if (item == '@GettingStartedOptions.AcceptPayments') {
            hideLoader();
            LoadPaymentModal();
        }
    }

    function setOnboardingStepsAcknowledge() {
        var url = '@Url.Action("SetOnboardingStepsAcknowledged", "Services", new { Area = "" })';
        $.ajax({
            type: "POST",
            url: url
        });
    }
</script>

