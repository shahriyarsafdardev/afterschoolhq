@model Account

@{ 
    var accountOrDashboard = "Account";

    if (Model.AccountTypeId != AccountType.Registrant)
    {
        accountOrDashboard = "Dashboard";
    }
}

@helper RenderReturnToHomeUrl()
{
    if (Model.IsNotEmpty() && !($"{Model.HomePageUrl}/browse".ToLower().Contains(Request.Url.AbsolutePath.ToLower())))
    {
        <a href="@Model.HomePageUrl" class="btn btn-link">
            &laquo; Return to @Model.Name Home
        </a>
    }
}

<div class="reg-login-bar">
    @if (Model.ID.HasValue)
    {
        <div class="row">
            <div class="col-md-6 col-sm-6 col-xs-12">

                @if (SessionVariables.CurrentUser.IsNotEmpty())
                {
                    <span class="reg-login-bar-title">@SessionVariables.CurrentAccount.Name</span>
                }

            </div>
            <div class="col-md-6 col-sm-6 col-xs-12">
                <div class="btn-group pull-right">
                    <div>
                        
                        @RenderReturnToHomeUrl()

                        @if (SessionVariables.CurrentUser.IsNotEmpty())
                        {
                            <a href="@Url.Action("index", "home", new { area = "user" })" class="btn btn-link">View @accountOrDashboard</a>
                            <a href="@Url.Action("index", "logout", new { returnurl = SessionVariables.RegistrationStartPageAccount.HomePageUrl })" class="btn btn-link">Logout</a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-link md-trigger" data-modal="modal-login">Login to Account</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="pull-right">
                @RenderReturnToHomeUrl()
            </div>
        </div>
        <div>
            <a href="@Url.Action("index", "signup")" class="btn btn-alt7 btn-block btn-xl">
                <span class="hidden-xs">
                    Complete your free account to customize this page &raquo;
                </span>
                <span class="hidden-sm hidden-md hidden-lg">
                    Complete your free account &raquo;
                </span>
            </a>
            <button type="button" class="btn btn-alt7 btn-block btn-xl md-trigger hide" data-modal="modal-lead-form">
                Sign Up for Your Free Account &raquo;
            </button>
        </div>
    }
</div>

@{ Html.RenderPartial("~/Views/Shared/Registration/_LoginModal.cshtml"); }