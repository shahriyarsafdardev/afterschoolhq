@model RegistrationHeaderViewModel

@{
    var accountProfile = Model.AccountProfile;
    var participationObject = Model.ParticipationObject;
    var account = Model.Account;

    var previewImage = accountProfile?.GetLogoUrl();

    if (previewImage.IsBlank())
    {
        previewImage = accountProfile?.GetHeaderImageUrl();
    }

    if (previewImage.IsBlank())
    {
        previewImage = $"{AfterSchoolLibrary.Helpers.Utilities.BaseUrl()}/assets/img/student-hands.png";
    }

    var title = participationObject?.Name ?? accountProfile?.Title ?? account.Name;
}

<meta property="og:title" content="@title">
<meta property="og:description" content="@(accountProfile?.Headline)">
<meta property="og:image" content="@previewImage" />
<meta property="og:url" content="@account.ShortHomePageUrl">
<meta property="og:site_name" content="@UILabel.ProductName()">

<meta name="twitter:title" content="@title">
<meta name="twitter:description" content="@(accountProfile?.Headline)">
<meta name="twitter:image" content="@previewImage">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@("@")afterschoolhq">
<meta name="twitter:image:alt" content="@title">
