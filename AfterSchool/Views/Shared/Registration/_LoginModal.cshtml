<div id="modal-login" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Login</h3>
        </div>
        <div class="modal-body">

            <div class="col-md-8 col-md-offset-2">
                @{ Html.RenderPartial("_Login", null, new ViewDataDictionary() { { "ReturnUrl", Request.Url.AbsolutePath } }); }
            </div>

        </div>
    </div>
</div>