@model ParticipationObject
@{
    var objects = (List<ParticipationObject>)ViewBag.ParticipationObjects;
    var grades = (List<GradeLevel>)ViewBag.Grades;
    var cart = (Cart)ViewBag.Cart;
    var locations = (List<Location>)ViewBag.Locations;
    var showSeatsRemaining = true;
    var showLocation = false;
    var accountProfile = (AccountProfile)ViewBag.AccountProfile;

    if (Model.SeatsRemaining.HasValue && Model.SeatsRemaining.Value <= 40)
    {
        if (Model.IsActivityGroup() && Model.ActivityGroupType.Value != ActivityGroupType.League)
        {
            showSeatsRemaining = false;
        }
        else if (Model.IsActivity() && Model.ActivityType.Value.In(new ActivityType[] { ActivityType.FieldTrip, ActivityType.PermissionSlip }))
        {
            showSeatsRemaining = false;
        }
    }
    else
    {
        showSeatsRemaining = false;
    }

    if (Model.Location.IsNotEmpty())
    {
        if (Model.IsActivity())
        {
            if (Model.ActivityLocationType == ActivityLocationType.Physical)
            {
                showLocation = true;
            }
        }
        else
        {
            showLocation = true;
        }
    }
}

<div class="col-sm-12 participation-object-wide searchable-object"
     id="@Model.Uid"
     mingrade="@Model.MinGradeId"
     maxgrade="@Model.MaxGradeId"
     mingradetext="@(Model.GetMinGradeLevel()?.Name)"
     maxgradetext="@(Model.GetMaxGradeLevel()?.Name)"
     agestart="@Model.AgeStart"
     ageend="@Model.AgeEnd"
     hasseatsremaining="@Model.HasSeatsAvailable().ToString().ToLower()"
     haswaitinglistremaining="@Model.HasWaitingListSeatsAvailable().ToString().ToLower()"
     days="@ParticipationObjectUI.PrintDaysOfWeekList(Model)"
     location="@(Model.Location?.FormatAddress(false))"
     gender="@((int)Model.GenderRestriction)"
     name="@Model.Name"
     isvirtual="@((Model.ActivityLocationType == ActivityLocationType.Virtual) ? "1" : "0")"
     isphysical="@((Model.ActivityLocationType == ActivityLocationType.Physical || Model.ActivityLocationType == ActivityLocationType.NotSet) ? "1" : "0")"
     issport="@((Model.IsAccountActivityGroup()) ? "1" : "0")">

    <div class="panel" style="overflow: hidden;">

        @if (accountProfile.IsNotEmpty())
        {
            var hasProvider = Model.Provider.IsNotEmpty();
            var isProviderProfile = hasProvider && Model.Provider.ID == accountProfile.AccountId;
            var isProvidedAtHostAccount = Model.Location?.HostAccountId == accountProfile.AccountId || !hasProvider;
            <!-- badge-success badge-blue badge-dark-gray -->
            <div style="padding:5px;" class="badge-dark-gray">
                <div class="text-white text-bold">
                    @if (Model.ActivityLocationType == ActivityLocationType.Virtual)
                    {
                        <span>Virtual</span>
                    }
                    else
                    {
                        <span>In-person</span>
                    }

                    <span>activity</span>

                    @if (isProviderProfile)
                    {
                        <span>at <a href="@Model.OwnerAccount.HomePageUrl" class="text-white">@Model.OwnerAccount.Name</a></span>
                    }
                    else
                    {
                        if (hasProvider)
                        {
                            <span>by <a href="@Model.Provider.HomePageUrl" class="text-white">@Model.Provider.Name</a></span>
                        }
                        else
                        {
                            <span>by <a href="@Model.OwnerAccount.HomePageUrl" class="text-white">@Model.OwnerAccount.Name</a></span>
                        }
                    }
                </div>
            </div>
        }

        <div class="panel-body" onclick="location.href='@Model.GetHomePageUrl(true)'" style="cursor:pointer">

            <div class="col-md-4 notranslate">

                <div class="heading panel-h3">
                    <p>
                        @Model.OwnerAccount.Name
                    </p>
                    <h3>
                        <strong title="@Model.Name">@Model.Name</strong>
                        @if (!Model.ObjectID.HasValue)
                        {
                            <span class="badge badge-danger">DEMO</span>
                        }
                    </h3>
                </div>

                <div class="margin-t-20">
                    <p class="text-medium-small">
                        @if (showLocation && Model.Location.ID != Model.OwnerAccount.DefaultLocationId)
                        {
                            <span>
                                @@
                                @Model.Location.Name
                            </span>
                        }
                    </p>
                </div>

                <p class="activity-description text-muted hide">
                    @Html.Raw(Model.Description.MaxChars(80, "...").IfEmpty(BasicLibrary.Utilities.RemoveHTMLAndEntities(Model.Details).MaxChars(80, "...")))
                </p>

                <div class="seats-remaining">
                    @if (showSeatsRemaining)
                    {
                        <strong>
                            <em>
                                @if (!Model.RegistrationPeriod.IsClosed(Model.OwnerAccount))
                                {
                                    <span>@Model.SeatsRemaining.ToString() seats</span>
                                    @(Model.RegistrationMode == RegistrationMode.Register ? "left" : "")

                                    if (Model.CanRegisterPerClass)
                                    {
                                        <span>for next class</span>
                                    }
                                }
                                else if (!Model.RegistrationPeriod.WillOpen(Model.OwnerAccount))
                                {
                                    @:Closed
                                }

                            </em>
                        </strong>
                    }
                </div>
            </div>

            <div class="col-md-4">
                <div class="padding-v-10">

                    @if (Model.StartDate.HasValue)
                    {
                        <span>
                            Start Date: @Model.StartDate.ToShortDateString() @Model.StartDate.ToShortTimeString()
                        </span>
                        <br />
                    }
                    @if (Model.Schedule.IsNotEmpty())
                    {
                        <span>
                            Days of the Week: @Model.Schedule.GetDaysOfTheWeek().OrderBy(x => (int)x).Select(x => x.ToString().Substring(0, 3)).ToStringList(", ")
                        </span>
                        <br />
                    }

                    <span>
                        @ParticipationObjectUI.PrintAgeGradeRestrictions(Model)
                    </span>

                    <br />
                    <span>
                        Restrictions: @ParticipationObjectUI.PrintGenderRestrictions(Model)
                    </span>
                </div>
            </div>

            <div class="col-md-4">

                <div class="margin-t-20">
                    @if (Model.IsActivity() && Model.GetActivity().IsNotEmpty() && Model.GetActivity().ActivityGroupId.HasValue)
                    {
                        var isOpen = Model.RegistrationPeriod.IsOpen();
                        var learnMoreColSize = isOpen ? "col-md-9" : "col-md-12";
                        var learnMoreStyle = isOpen ? "btn-register-default" : "btn-register";

                        <div class="row">
                            <div class="@learnMoreColSize">
                                <a href="@Model.GetHomePageUrl(true)" class="btn @learnMoreStyle">
                                    View Details &raquo;
                                </a>
                            </div>
                            @if (isOpen)
                            {
                                <div class="col-md-3">
                                    <button class="btn btn-register btn-cart" in-cart="0" uid="@Model.Uid">
                                        <span><i class="s7-plus icon-medium"></i><i class="s7-cart icon-medium"></i></span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <a href="@Model.GetHomePageUrl(true)" class="btn btn-register btn-block">
                            View Details &raquo;
                        </a>
                    }

                    <p class="text-center">
                        @Html.Raw(ParticipationObjectUI.PrintRegistrationPeriod(Model))
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

