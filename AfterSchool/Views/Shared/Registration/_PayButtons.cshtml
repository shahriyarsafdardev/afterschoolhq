@using AfterSchoolLibrary.Billing
@using AfterSchoolLibrary.Helpers
@using Stripe
@{
    var sources = (List<Source>) ViewData["Sources"];
    var bankAccounts = (List<BankAccount>) ViewData["BankAccounts"];
    var acceptAch = (bool) ViewData["acceptACH"];
    var formActionUrl = (string) ViewData["formActionUrl"];
    var participationObject = (ParticipationObject) ViewData["participationObject"];
    var postPayPlan = participationObject?.GetPostPayPlan();
    var subscriptionPlan = participationObject?.GetSubscriptionPlan();

    var hasPlans = postPayPlan.IsNotEmpty() || subscriptionPlan.IsNotEmpty();
    var savePaymentInfoOnly = postPayPlan.IsNotEmpty() && !postPayPlan.NumberOfPeriodsPrePaid.IsPositive();

    var ccClassAttendedLabel = savePaymentInfoOnly
        ? postPayPlan.IsNotEmpty()
            ? $"({participationObject.GetPostPayCreditCardFee().ToCurrency()} per {postPayPlan.BillingPeriodTypeId.ToString().ToLower()})"
            : "per class attended"
        : "";

    var startsToday = participationObject.OwnerAccount.ConvertFromAccountTimeZone(SessionVariables.CurrentRegistrant.GetPlanStartDate(subscriptionPlan, participationObject)).Date == DateTime.UtcNow.Date;
}

<div class="margin-t-20 padding-v-20">

@if (acceptAch)
{
    <div id="payment-info-ach">

        <div class="text-center">
            <p class="text-large">@(savePaymentInfoOnly ? "Save Bank Account Info" : "Pay using a Bank Account")</p>
            <p class="text-medium-small">
                <strong>No Transaction Fees</strong>
            </p>
        </div>

        @* PAY VIA Existing ACH Sources *@
        @if (bankAccounts.Any())
        {
            <div class="row">
                <div class="col-md-6 col-md-offset-3 col-sm-12 padding-30">

                    <form class="form-horizontal existing-payment-form" action="@formActionUrl" method="post" id="existing-payment-form-ach">

                        <input type="hidden" name="paymentoption" id="paymentoption-existing" class="payment-option" value="0"/>
                        <input type="hidden" name="coupon" class="coupon" value=""/>
                        <textarea name="paymentdescription" id="payment-description-existing-ach" class="hide payment-description"></textarea>

                        <div class="form-group">
                            <label class="col-md-3 control-label">
                                Select Account
                            </label>
                            <div class="col-md-9">
                                <select name="banksource" id="banksource" class="form-control">
                                    @foreach (var bankAccount in bankAccounts)
                                    {
                                        <option value="@bankAccount.Id">
                                            * * * * * * @bankAccount.Last4 - @bankAccount.BankName
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-register-primary btn-lg btn-pay" id="btn-paywithexistingach">
                                @(savePaymentInfoOnly ? "Save Bank Info" : "Pay via Bank Account")
                                <span class="pay-button-amount @(savePaymentInfoOnly ? "hide" : "")">
                                    -
                                    <span class="total-due-today-ach"></span>*
                                </span>
                                &raquo;
                            </button>
                        </div>
                        <div class="row">
                            <p>&nbsp;</p>
                        </div>
                    </form>
                </div>
            </div>
        }

        @* PAY VIA ACH *@
        <div class="row">
            <div class="col-md-6 col-md-offset-3 col-sm-12">

                <div class="form-group">
                    <p class="text-medium text-center">
                        @(savePaymentInfoOnly ? "Save Bank Info" : "Pay using a new Bank Account")
                    </p>
                    <p class="text-muted">
                        Clicking @(savePaymentInfoOnly ? "'Save Bank Info'" : "'Pay via ACH'") will allow you to connect and pay using your bank account. After you login and select the account to use, it will checkout and @(savePaymentInfoOnly ? "use your bank account information for attendance payments." : "complete your purchase using your bank account information.")
                    </p>
                    <button type="button" id="plaid-button" class="btn btn-register@(bankAccounts.Any() ? "-default" : "-primary") btn-lg btn-pay">
                        @(savePaymentInfoOnly ? "Save Bank Info" : "Pay via Bank Account")
                        <span class="pay-button-amount @(savePaymentInfoOnly ? "hide" : "")">
                            -
                            $<span class="total-due-today-ach"></span>*
                        </span>
                        &raquo;
                    </button>

                    <form action="@formActionUrl" method="post" id="payment-form-ach">

                        <textarea name="paymentdescription" id="payment-description-new-ach" class="hide payment-description"></textarea>

                    </form>
                </div>

            </div>
        </div>

        <hr/>
    </div>
}

<div id="payment-info" style="position:relative;">

    <div class="row">
        <div class="col-md-6 col-md-offset-3 col-sm-12">
            <div class="text-center">
                <p class="text-large">@(savePaymentInfoOnly ? "Save Credit Card Info" : "Pay using a credit card")</p>
                <p class="text-medium-small margin-t-20">
                    @(Html.Raw(savePaymentInfoOnly ? "" : "Credit card transactions will be charged <br />an additional"))
                    <strong>
                        $<span class="total-fee-ccf">0</span>
                        Transaction Fee
                        @*NOTE: for payment plans and subscriptions should add the text "Per Payment"*@
                    </strong>

                    @ccClassAttendedLabel

                </p>
                <p class="text-muted text-center">Credit card transaction fees are 2.9% + $0.30 and are non-refundable</p>
            </div>
        </div>
    </div>

    @* PAY VIA Existing Sources *@
    @if (sources.Any(source => source.Card.IsNotEmpty()))
    {
        <div class="row">
            <div class="col-md-6 col-md-offset-3 col-sm-12">
                <form class="form-horizontal existing-payment-form" action="@formActionUrl" method="post" id="existing-payment-form-cc">
                    <input type="hidden" name="paymentoption" id="paymentoption-existing" class="payment-option" value="0"/>
                    <input type="hidden" name="coupon" class="coupon" value=""/>
                    <textarea name="paymentdescription" id="payment-description-existing-cc" class="hide payment-description"></textarea>

                    <div class="form-group">
                        <label class="col-md-3 control-label">
                            Select Card
                        </label>
                        <div class="col-md-9">
                            <select name="ccsource" id="ccsource" class="form-control">
                                @foreach (var source in sources.Where(source => source.Card.IsNotEmpty()))
                                {
                                    <option value="@source.Id">
                                        **** **** **** @source.Card.Last4
                                        -
                                        @source.Card.ExpMonth / @source.Card.ExpYear
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-register-default btn-lg btn-pay" id="btn-paywithexistingcard">
                            @(savePaymentInfoOnly ? "Save Credit Card Info" : "Pay via credit card")
                            <span class="pay-button-amount @(savePaymentInfoOnly ? "hide" : "")">
                                -
                                $<span class="total-due-today-cc"></span>*
                            </span>
                            &raquo;
                        </button>
                    </div>

                    <div class="row">
                        <p>&nbsp;</p>
                    </div>
                </form>
            </div>
        </div>
    }

    @* PAY VIA NEW CC *@
    <div class="row">
        <div class="col-md-6 col-md-offset-3 col-sm-12">

            <form action="@formActionUrl" method="post" id="payment-form" class="form-horizontal">

                <input type="hidden" name="paymentoption" id="paymentoption-new" class="payment-option" value="0"/>
                <textarea name="paymentdescription" id="payment-description-new-cc" class="hide payment-description"></textarea>
                <input type="hidden" name="coupon" class="coupon" value=""/>

                <div class="form-group">
                    <label for="card-element">
                        <p>Enter new credit or debit card</p>
                    </label>
                    <div id="card-number"></div>
                    <div id="card-cvc"></div>
                    <div id="card-expiry"></div>

                    <!-- Used to display Element errors. -->
                    <div id="card-errors" role="alert"></div>
                </div>

                <div class="row">
                    <div class="col-md-10 col-md-offset-1">
                        <div class="am-checkbox text-center">
                            <input type="checkbox"
                                   id="savepaymentinfo"
                                   name="savepaymentinfo"
                                   value="1"
                                   @(Request["savepaymentinfo"] == "1" || hasPlans ? " checked=\"checked\"" : "")
                                   @(hasPlans ? "disabled" : "")/>

                            <label for="savepaymentinfo">
                                Save my card for convenient checkout
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group padding-v-20">
                    <button type="button" id="btn-paywithnewcard" class="btn btn-register-default btn-lg btn-pay">
                        @(savePaymentInfoOnly ? "Save Credit Card Info" : "Pay via credit card")
                        <span class="pay-button-amount @(savePaymentInfoOnly ? "hide" : "")">
                            -
                            $<span class="total-due-today-cc"></span>*
                        </span>
                        &raquo;
                    </button>
                </div>

            </form>

        </div>
    </div>

    <div class="clearfix"></div>

    <hr/>
</div>

<div id="payment-for-zero-checkout" style="display: none;">
    <div class="row">
        <div class="col-md-6 col-md-offset-3 col-sm-12">

            <form id="payment-form-zero-checkout" class="form-horizontal existing-payment-form" action="@formActionUrl" method="post">
                <input type="hidden" name="paymentoption" value="-1"/>
                <input type="hidden" name="coupon" class="coupon" value=""/>

                <div class="form-group">
                    <button type="submit" class="btn btn-register-primary btn-lg btn-pay">
                        Checkout
                        <span class="pay-button-amount">
                            - $<span>0.00</span>*
                        </span>
                        &raquo;
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>

<p class="text-center text-small text-muted hide">
    * Cost includes fees supporting afterschool programs for @SessionVariables.RegistrationStartPageAccount.Name
</p>

</div>


<script src="https://js.stripe.com/v3/"></script>

<script>
    function allowContinue() {
        if ($('#payinperson').is(':checked')) {
            $('#btn-continue').prop('disabled', false);
        } else {
            $('#btn-continue').prop('disabled', true);
        }
    }

    function updateTotals(regFee, regTotalToday) {
        let total = regFee + regTotalToday;
        if (@Json.Encode(startsToday)) {
            total += getSubscriptionTotalValue();
        }
        $('.total-due-today').html(total.toFixed(2));
    }

    function updateCC(ccfees) {
        $('.total-fee-ccf').html(ccfees.toFixed(2));
    }

    function updateTotalsCC(regFee, regTotalToday) {
        let total = regFee + regTotalToday;
        if (@Json.Encode(startsToday)) {
            total += getSubscriptionTotalValueCC();
        }
        $('.total-due-today-cc').html(total.toFixed(2));
    }

    function updateTotalsACH(regFee, regTotalToday) {
        let total = regFee + regTotalToday;
        if (@Json.Encode(startsToday)) {
            total += getSubscriptionTotalValueACH();
        }
        $('.total-due-today-ach').html(total.toFixed(2));
    }

    function getSubscriptionTotalValue() {
        if (!isNaN($('#subscription-total-value').html())) {
            return parseFloat($('#subscription-total-value').html());
        }
        return 0;
    }

    function getSubscriptionTotalValueCC() {
        if (!isNaN($('#subscription-total-value').html())) {
            return parseFloat($('#subscription-total-value').html()) + parseFloat($('#subscription-ccf-value').html());
        }
        return 0;
    }

    function getSubscriptionTotalValueACH() {
        if (!isNaN($('#subscription-total-value').html())) {
            return parseFloat($('#subscription-total-value').html());
        }
        return 0;
    }

    function updatePaymentOptionCost(paymentPlanId) {
        let regTotalToday = parseFloat($('#payment-plan-cost-' + paymentPlanId).html());
        let regTotalTodayCC = parseFloat($('#payment-plan-cost-' + paymentPlanId).html()) + parseFloat($('#payment-plan-ccf-' + paymentPlanId).html());
        let regTotalTodayACH = parseFloat($('#payment-plan-cost-' + paymentPlanId).html());

        $('#registration-fee-row').addClass('hide');
        $('.paymentplan-fee-row').addClass('hide');

        if (paymentPlanId == 0) {
            updateTotals(getRegFee(), 0);
            updateTotalsCC(getRegFeeCC(), 0);
            updateTotalsACH(getRegFeeACH(), 0);
            $('#registration-fee-row').removeClass('hide');
        } else {
            updateTotals(0, regTotalToday);
            updateTotalsCC(0, regTotalTodayCC);
            updateTotalsACH(0, regTotalTodayACH);
            $('#paymentplan-fee-row-' + paymentPlanId).removeClass('hide');
        }
        updateCC(getTotalCCFee(paymentPlanId), 0);
    }

    function getRegFee() {
        if (!isNaN($('#fee-total-value').html())) {
            return parseFloat($('#fee-total-value').html());
        }

        return 0;
    }

    function getTotalCCFee(paymentPlanId) {
        return parseFloat($('#payment-plan-ccf-' + paymentPlanId).html()) + parseFloat($('#subscription-ccf-value').html());
    }

    function getRegFeeCC() {
        if (!isNaN($('#fee-total-value').html())) {
            return parseFloat($('#fee-total-value').html()) + parseFloat($('#fee-ccf').html());
        }

        return 0;
    }

    function getRegFeeACH() {
        if (!isNaN($('#fee-total-value').html())) {
            return parseFloat($('#fee-total-value').html());
        }

        return 0;
    }

    function sizePaymentBlock() {

        $('#block-payment-info').css({
            'width': ($("#payment-info").width() + 'px'),
            'height': ($("#payment-info").height() + 'px'),
            'line-height': ($("#payment-info").height() + 'px'),
            'opacity': .95,
            'background-color': '#333'
        });
    }

    function updatePaymentFees(paymentPlanId) {
        var newccf = parseFloat($('#payment-plan-ccf-' + paymentPlanId).html());
        var newasf = parseFloat($('#payment-plan-asf-' + paymentPlanId).html());

        $('#fee-ccf').html(newccf);
        $('#fee-asf').html(newasf);
        $('#fee-ccf-text').html('$' + newccf.toFixed(2));
        $('#fee-asf-text').html('$' + newasf.toFixed(2));
    }

    function updatePaymentFeesACH(paymentPlanId) {
        var newasf = parseFloat($('#payment-plan-asf-' + paymentPlanId).html());

        if (!isNaN($('#subscription-total-value').html())) {
            newasf += parseFloat($('#subscription-asf-value').html());
        }

        $('#fee-asf').html(0);
        $('#fee-asf-text').html('$0');
    }
</script>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $('.payment-option-radio').click(function () {
            $('.payment-option').val($(this).val());

            let paymentPlanId = $(this).attr('id').split('-')[1];

            updatePaymentFees(paymentPlanId);
            updatePaymentFeesACH(paymentPlanId);
            updatePaymentOptionCost(paymentPlanId);
            unapplyCoupon();

        });

        updatePaymentFees(0);
        updatePaymentFeesACH(0);

        @if ((participationObject.IsNotEmpty() && participationObject.PaymentPlans.Any()) || postPayPlan.IsNotEmpty())
        {
            @: updatePaymentOptionCost(0);
        }
        else
        {
            @: updateTotals(getRegFee(), 0);
            @: updateTotalsCC(getRegFeeCC(), 0);
            @: updateTotalsACH(getRegFeeACH(), 0);
            @: updateCC(getTotalCCFee(0), 0);
        }

        $('.existing-payment-form').submit(function () {
            $('.btn-pay').html('Processing...');

            disableButtons();
        });
    });

    function disableButtons() {
        $('.btn-pay').prop('disabled', true);
        $('#plaid-button').prop('disabled', true);
    }

    function enableButtons() {
        $('.btn-pay').prop('disabled', false);
        $('#plaid-button').prop('disabled', false);
    }
</script>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $('#btn-paywithnewcard').click(function () {

            $('#btn-paywithnewcard').html('Processing...');

            disableButtons();

            stripe.createToken(card).then(function (result) {

                if (result.error) {
                    // Inform the customer that there was an error.
                    var errorElement = document.getElementById('card-errors');
                    errorElement.textContent = result.error.message;
                    // $('#btn-paywithnewcard').html('Review Purchase');
                    enableButtons();

                } else {

                    // Send the token to your server.
                    stripeTokenHandler(result.token);
                }
            });
        });

        var stripe = Stripe('@StripeHelper.PublishableKey');
        var elements = stripe.elements();

        // Custom styling can be passed to options when creating an Element.
        var style = {
            base: {
                // Add your base input styles here. For example:
                fontSize: '16px',
                color: "#32325d",
            }
        };

        // Create an instance of the card Element.
        var card = elements.create('card', { style: style });

        // Add an instance of the card Element into the `card-element` <div>.
        card.mount('#card-number');

        cardNumber.addEventListener('change', function (event) {
            var displayError = document.getElementById('card-errors');
            if (event.error) {
                displayError.textContent = event.error.message;
            } else {
                displayError.textContent = '';
            }
        });

        // Create a token or display an error when the form is submitted.
        var form = document.getElementById('payment-form');

        function stripeTokenHandler(token) {
            // Insert the token ID into the form so it gets submitted to the server
            var form = $('#payment-form');
            form.append('<input type="hidden" name="stripetoken" value="' + token.id + '" />')
            form.append('<textarea name="paymentdescription" class="hide">' + $('#payment-description-new-cc').val() + '</textarea>');
            form.submit();
        }
    });
</script>


@if (acceptAch)
{
    <script src="https://cdn.plaid.com/link/v2/stable/link-initialize.js"></script>

    <script>
        var linkHandler = Plaid.create({
            env: '@PlaidHelper.PlaidEnvironment',
            clientName: 'AfterSchool HQ',
            key: '@PlaidHelper.PublicKey',
            product: ['auth'],
            selectAccount: true,
            onSuccess: function (public_token, metadata) {
                // Send the public_token and account ID to your app server
                $('#plaid-button').html('Processing...');

                disableButtons();

                plaidTokenHandler(public_token, metadata.account_id)
            },
            onExit: function (err, metadata) {
                // The user exited the Link flow.
                if (err != null) {
                    // The user encountered a Plaid API error prior to exiting.
                }
            },
        });

        function plaidTokenHandler(token, accountId) {
            // Insert the token ID into the form so it gets submitted to the server
            var form = $('#payment-form-ach');
            form.append('<input type="hidden" name="plaidtoken" value="' + token + '" />');
            form.append('<input type="hidden" name="plaidaccountid" value="' + accountId + '" />');

            var coupon = $('#txt-coupon-code').val();
            if (coupon) {
                form.append('<input type="hidden" name="coupon" value="' + coupon + '" />');
            }
            
            form.append('<textarea name="paymentdescription" class="hide">' + $('#payment-description-new-ach').val() + '</textarea>');
            form.submit();
        }

        // Trigger the Link UI
        document.getElementById('plaid-button').onclick = function () {
            linkHandler.open();
        };
    </script>
}

<script>
    function applyCoupon() {

        showLoader();

        var couponCode = $('#txt-coupon-code').val();
        var paymentOption = $('input[name=paymentoption]:checked').val();

        $.get(
            '/services/validatecoupon?couponcode=' + encodeURIComponent(couponCode)+'&paymentoption='+ paymentOption,
            function (data) {
                hideLoader();
                if (data) {
                    //var amount = data.amount;
                    //var spAmount = data.subscriptionPlanAmount;
                    //var numberInMonths = data.numberInMonths;
                    var discountString = data.discountString;

                    //.. calculated this value on back end side and updated the UI on the fly
                    // if coupon is invalid amounts will be regular amount of activity                    
                    if (data.postPayPlanAmount <= 0 && data.calculatedAmountCC == 0 && data.calculatedAmountACH == 0 && data.calculatedCCFee == 0) {
                        $('#payment-info-ach').hide()
                        $('#payment-info').hide()
                        $('#payment-for-zero-checkout').show();
                    } else {
                        $('#payment-for-zero-checkout').hide();
                        $('#payment-info-ach').show()
                        $('#payment-info').show()

                        updateTotalsCC(data.calculatedAmountCC, 0);
                        updateTotalsACH(data.calculatedAmountACH, 0);
                        updateCC(data.calculatedCCFee);
                    }
               
                    if (data && data.status == 'ok') {
                        $('.coupon').val(couponCode);
                        $('#txt-coupon-applied').html(`Coupon ${couponCode} applied successfully with ${discountString} discount.`).show();
                    } else {
                        unapplyCoupon();
                        $('#txt-coupon-applied').html(``).hide();
                    }

                    for (var message of data.messages) {
                        var title = message.IsError ? 'Error' : 'Success';
                        Notifications.showBar({
                            title,
                            message: message.Text,
                            success: !message.IsError
                        });
                    }
                }
            }
        ).fail(function () {
            Notifications.showBar({
                title: 'Error',
                message: 'Something went wrong, Please contact customer support.',
                success: false
            });
            hideLoader();
        })
    }

    function unapplyCoupon() {
        $(".total-due-today").removeAttr("style");
        $("#dollar-prefix").removeAttr("style");
        $("#txt-coupon-code").val('');
        $('.coupon').val('');
    }
</script>