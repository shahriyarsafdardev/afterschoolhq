@model List<ParticipationObject>
@{
    var browseUrl = (string) ViewData["BrowseUrl"];
    var activityType = (ActivityType) ViewData["ActivityType"];
    var showViewMore = (bool) ViewData["ShowViewMore"];
    var isInEditMode = (bool) ViewData["IsInEditMode"];
    var accountUid = (Guid) ViewData["AccountUid"];
    var activityTypeDisplayLabel = activityType.ToString().SplitByUpperCase();
}

@if (Model.Any())
{
    <div class="row panel-heading" style="width: 100%">
        <div class="col-lg-12">
            <div class="activity-detail-block">
                <div class="pull-left">
                    <h2>@UILabel.ActivityLabel(activityType, true)</h2>
                </div>
                <div class="pull-right padding-v-20">
                    <a href="@browseUrl">
                        View All &raquo;
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@if (isInEditMode)
{
    var redirectUrl = Url.Action("editsetup", "activity", new {area = "org", isnew = 1, source = "profile", type = (int) activityType});

    <div class="row">
        <div style="position: relative;">
            <span>
                <a href="@Url.Action("switch", "logout", new {id = accountUid, redirectUrl})"
                   class="btn btn-alt7 btn-sm">
                    Add New @activityTypeDisplayLabel &raquo;
                </a>
            </span>
        </div>
    </div>
}

<div class="row">
    <div style="position: relative; margin-left: -20px; margin-right: -20px;">
        @foreach (var item in Model)
        {
            Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObjectWide.cshtml", item);
        }
    </div>
</div>

@if (showViewMore)
{
    <div class="row">
        <div class="col-md-4 col-md-offset-4">
            <a href="@browseUrl" class="btn btn-register">
                View More Activities &raquo;
            </a>
        </div>
    </div>
}