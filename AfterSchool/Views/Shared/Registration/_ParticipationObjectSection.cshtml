@model List<ParticipationObject>
@{
    var browseUrl = (string) ViewData["BrowseUrl"];
    var activityType = (ActivityType) ViewData["ActivityType"];
    var showViewMore = (bool) ViewData["ShowViewMore"];
    var isInEditMode = (bool) ViewData["IsInEditMode"];
    var accountUid = (Guid) ViewData["AccountUid"];
    var activityTypeDisplayLabel = activityType.ToString().SplitByUpperCase();
    var activityLabel = (string) ViewData["ActivityLabel"];
    var sectionTitle = activityLabel == "Opportunities" ? "Volunteer Opportunities" : activityLabel;
    var sectionSubTitle = activityLabel == "Opportunities" ? "For Parents & Community Members" : "For Students";
}
<style>

    @@media(max-width: 992px) {
        .activity-section-header > .view-all-link
        {
            display: none;
        }
        .activity-section-footer
        {
            display: block;
           align-items: center;
           background: #00517c;
           display: flex;
           justify-content: center;    
           padding: 16px 59px 18px 45px;
           
        }
    }
    
    @@media(min-width: 992px) {
            .activity-section-footer
            {
               display: none;
            }
    }

    .section-title {
        color: #282828;
        font-size: 26px;
        font-weight: 500;
        margin: 0 0 4px;
    }
    .section-subtitle {
        color: #494949;
        font-size: 16px;
        font-weight: 300;
        margin: 0;
    }
    .view-all-link {
        font-size: 20px;
        font-weight: 300;
        color: #494949;
        white-space: nowrap;
    }
    .activity-section-footer > .view-all-link
    {
        color: #f8f9f9;
    }
</style>
<div class="activity-section">
    @if (Model.Any())
    {
        <div class="activity-section-header">
            <div>
                <h2 class="section-title">@sectionTitle</h2>
                <p class="section-subtitle">@sectionSubTitle</p>
            </div>
            <a href="@browseUrl" class="view-all-link">
                View All &raquo;
            </a>
        </div>
    }

    @if (isInEditMode)
    {
        var redirectUrl = Url.Action("editsetup", "activity", new {area = "org", isnew = 1, source = "profile", type = (int) activityType});

        <div class="row">
            <div style="position: relative;">
                <span>
                    <a href="@Url.Action("switch", "logout", new {id = accountUid, redirectUrl})"
                       class="btn btn-alt7 btn-sm">
                        Add New @activityTypeDisplayLabel &raquo;
                    </a>
                </span>
            </div>
        </div>
    }

    @foreach (var item in Model)
    {
        Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObjectWide.cshtml", item);
    }

    <div class="activity-section-footer">
        <a href="@browseUrl" class="view-all-link">
            @Html.Raw(activityType == ActivityType.Activity ? "View All Activities &raquo" : "View All Opportunities &raquo")
        </a>
    </div>

    @if (showViewMore)
    {
        <div class="row hide">
            <div class="col-md-4 col-md-offset-4">
                <a href="@browseUrl" class="btn btn-register">
                    View More @activityLabel &raquo;
                </a>
            </div>
        </div>
    }
</div>