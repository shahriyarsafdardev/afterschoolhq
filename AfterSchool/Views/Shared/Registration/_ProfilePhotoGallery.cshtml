@model List<AccountProperty>
@{
    var maxPhotos = 5; // Math.Min(Model.Count, 6);
}

@if (maxPhotos == 5)
{
    foreach (var item in Model.Take(3))
    {
        <div class="col-md-4 profile-photo-gallery" style="background-image: url('@item.Value');"></div>
    }

    foreach (var item in Model.Skip(3).Take(2))
    {
        <div class="col-md-6 profile-photo-gallery" style="background-image: url('@item.Value');"></div>
    }
}
else if (maxPhotos == 4 || maxPhotos == 2)
{
    foreach (var item in Model.Take(maxPhotos))
    {
        <div class="col-md-6 profile-photo-gallery" style="background-image: url('@item.Value');"></div>
    }
}
else if (maxPhotos == 1)
{
    <div class="col-md-12 profile-photo-gallery" style="background-image: url('@Model.First().Value');"></div>
}
else
{
    foreach (var item in Model.Take(maxPhotos))
    {
        <div class="col-md-4 profile-photo-gallery" style="background-image: url('@item.Value');"></div>
    }
}