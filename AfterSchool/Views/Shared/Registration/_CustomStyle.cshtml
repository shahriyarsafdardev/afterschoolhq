@model AccountProfile

@{ 
    var color = Model?.PrimaryColor.TrimStart('#');
}

@if (color.IsNotEmpty())
{
    <style>
        .btn-register{
            border-color: #@color; 
            background-color: #@color;
        }

        .btn-register:hover{
            border-color: #@color; 
            background-color: #@color;
        }

        .btn-register-default{
            border-color: #@color;
            background-color: #@color;
        }

        .btn-register-default:hover{
            border-color: #@color; 
            background-color: #@color;
        }

        a {
            color: #@color;
        }

        a:hover {
            color: #@color;
        }
    </style>
}
else
{
    <style>       
        a {
            color: #555;
        }

        a:hover {
            color: #555;
        }
    </style>
}
