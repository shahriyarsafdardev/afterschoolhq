@model AccountProfile

@{ 
    var color = Model?.PrimaryColor?.TrimStart('#');
}

<style>
    .profile-photo-gallery {
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        background-position: 50% 50%;
        height: 300px;
    }
</style>

@if (color.IsNotEmpty())
{
    <style>
        .btn-register{
            border-color: #@color; 
            background-color: #@color;
        }

        .btn-register:hover{
            border-color: #@color; 
            background-color: #@color;
        }

        .btn-register-default{
            border-color: #@color;
            background-color: #@color;
        }

        .btn-register-default:hover{
            border-color: #@color; 
            background-color: #@color;
        }

        a {
            color: #@color;
        }

        a:hover {
            color: #@color;
        }
    </style>
}
else
{
    <style>       
        a {
            color: #555;
        }

        a:hover {
            color: #555;
        }
    </style>
}
