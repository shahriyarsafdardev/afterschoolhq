@model Account

@{
    var regHeaderStyle = "";
    var profile = Model.GetAccountProfile();
    var showLogo = false;
    var logoUrl = "";

    if (profile.HeaderImage.IsNotEmpty())
    {
        regHeaderStyle = $"background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url({profile.GetHeaderImageUrl()})";
    }

    if (profile.Logo.IsNotEmpty())
    {
        showLogo = true;
        logoUrl = profile.GetLogoUrl();
    }
}

<div class="reg-header" style="@regHeaderStyle">
    <div class="reg-header-overlay">

        @if (showLogo)
        {
            <div class="reg-header-logo">
                <img src="@logoUrl" />
            </div>
        }

        <h1 class="activity-title text-center">
            <span>@Model.Name</span>
            @if (ViewBag.Session != null)
            {
                @: - @(((ParticipationObject)ViewBag.Session).Name)
            }
            @if (!Model.ID.HasValue)
            {
                <span class="badge badge-danger">DEMO</span>
            }
        </h1>

        @if (profile.Headline.IsNotEmpty())
        {
            <p class="reg-header-headline">
                @profile.Headline
            </p>
        }
    </div>
</div>
