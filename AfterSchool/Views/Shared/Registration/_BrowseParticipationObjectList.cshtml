@model List<ParticipationObject>

@{ 
    var title = ViewData["title"];
    var perPage = 10M;
    var numberOfPages = Math.Ceiling(Model.Count / perPage);
}
<div class="row">
    <div class="col-md-12 text-center">
        <h3>@title</h3>
    </div>

    @foreach (var item in Model)
    {
        Html.RenderPartial("~/Views/Shared/Registration/_BrowseAllActivities.cshtml", 
            item, 
            new ViewDataDictionary() { { "accountprofile", ViewData["accountProfile"] } });
    }

    @if (numberOfPages > 1 && false)
    {
        <div class="col-md-12 text-center">

            @for (var i = 1; i <= numberOfPages; i++)
            {
                <a href="#" class="btn btn-default btn-lg">@i</a>
            }

        </div>
    }

</div>