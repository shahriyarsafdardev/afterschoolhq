@model AccountProfile
@{
    var account = Model.GetAccount();
    var profileHeaderImageUrl = Model.GetHeaderImageUrl();
    var followers = account.GetSubscriberCount();
    var location = Model.GetLocation();
    var gradeLevelStart = Model.GetGradeLevelStart();
    var gradeLevelEnd = Model.GetGradeLevelEnd();
    var photos = Model.GetPhotos();
    var properties = Model.GetProperties(AccountPropertyType.Classifications);

    if (photos.Any() && profileHeaderImageUrl.IsBlank())
    {
        var ah = AfterSchoolLibrary.Helpers.Utilities.GetNewAmazonHelper();
        profileHeaderImageUrl = ah.GetFileLink(photos.First().Value, true, null, true);
    }

    if (profileHeaderImageUrl.IsBlank() && location.IsNotEmpty())
    {
        profileHeaderImageUrl = LocationService.GetGoogleMapsImageUrl(location, 1500, 600);
    }
}

<div class="col-sm-12 col-md-6 col-lg-4 col-xl-3 participation-object searchable-object pointer" onclick="location.href='@account.HomePageUrl';"
     id="@account.Uid"     
     name="@account.Name">

    <div class="panel" style="overflow: hidden;">
        <div class="reg-header" style="background-image: url(@profileHeaderImageUrl); min-height: 100px; height: 150px; padding: 5px 5px;">

            @if (Model.IsOpenDuringCovid)
            {
                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        <icon class="s7-clock"></icon>
                        Open During COVID
                    </span>
                </div>
            }

            @if (Model.IsELearningCenter)
            {
                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        <icon class="s7-clock"></icon>
                        E-Learning Center
                    </span>
                </div>
            }

        </div>
        <div class="panel-body" style="position: relative;">

            <div class="" style="position: absolute; top: 10px; left: 15px; overflow: hidden; height: 20px;">

                <div class="pull-left margin-l-5">
                    <span class="badge badge-default profile-badge text-small">
                        @gradeLevelStart.Name - @gradeLevelEnd.Name Grade
                    </span>
                </div>

                @foreach (var property in properties)
                {
                    <div class="pull-left margin-l-5">
                        <span class="badge badge-default profile-badge text-small">
                            @property.Value
                        </span>
                    </div>
                }
            </div>

            <h3>
                <strong title="@account.Name">@account.Name</strong>
            </h3>

            <div class="">
                <span class="text-small">
                    <span>
                        @location.FormatCityStateZipCode(false)
                    </span>
                </span>
            </div>

            <div class="margin-t-10" style="height: 40px;">
                <p class="text-medium-small">
                    @Model.Headline.MaxChars(75, "... (more)")
                </p>
            </div>

            <div class="margin-t-20">
                <a href="@account.HomePageUrl" class="btn btn-register btn-block">
                    Learn More &raquo;
                </a>
            </div>

        </div>
    </div>
</div>
