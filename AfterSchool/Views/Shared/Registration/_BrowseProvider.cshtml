@model AccountProfile
@{
    var account = Model.GetAccount();
    var profileHeaderImageUrl = Model.GetHeaderImageUrl();
    var followers = account.IsEmpty() ? 0 : account.GetSubscriberCount();
    var location = Model.GetLocation();
    var gradeLevelStart = Model.GetGradeLevelStart();
    var gradeLevelEnd = Model.GetGradeLevelEnd();
    var ageStart = Model.GetAgeStart();
    var ageEnd = Model.GetAgeEnd();
    var restrictByGrade = Model.RestrictByGrade();
    var photos = Model.GetPhotos();
    var properties = Model.GetProperties(AccountPropertyType.Classifications);

    if (photos.Any() && profileHeaderImageUrl.IsBlank())
    {
        var ah = AfterSchoolLibrary.Helpers.Utilities.GetNewAmazonHelper();
        profileHeaderImageUrl = ah.GetFileLink(photos.First().Value, true, null, true);
    }

    if (profileHeaderImageUrl.IsBlank() && location.IsNotEmpty())
    {
        profileHeaderImageUrl = LocationService.GetGoogleMapsImageUrl(location, 1500, 600);
    }
}

<div class="col-sm-12 col-md-6 col-lg-4 col-xl-3 participation-object searchable-object pointer"
     onclick="WebPage.navigateIframe('@(account?.HomePageUrl)')"
     id="@(account?.Uid)"     
     name="@(account?.Name)">

    <div class="panel" style="overflow: hidden;">
        <div class="reg-header" style="background-image: url(@profileHeaderImageUrl); min-height: 100px; height: 150px; padding: 5px 5px; position: relative;">

            @if (Model.IsOpenDuringCovid)
            {
                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        Open During COVID
                    </span>
                </div>
            }

            @if (Model.IsVirtualProgram)
            {
                <div class="pull-right margin-l-10">
                    <span class="badge badge-blue profile-badge text-small">
                        Virtual
                    </span>
                </div>
            }

            @if (Model.IsELearningCenter)
            {
                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        E-Learning Center
                    </span>
                </div>
            }

            @if (account.IsNotEmpty() && account.IsNowEnrolling())
            {
                <div class="pull-right margin-l-10">
                    <span class="badge badge-danger profile-badge text-small">
                        Now Enrolling
                    </span>
                </div>
            }

            @if (location.IsNotEmpty())
            {
                <div style="position: absolute; bottom: 0; right: 0; background-color: #fff; color: #333;">
                    <div class="padding-h-10">
                        <span class="text-small">
                            @location.FormatCityState(false)
                        </span>
                    </div>
                </div>
            }

        </div>
        <div class="panel-body" style="position: relative;">

            <div class="" style="position: absolute; top: 10px; left: 15px; overflow: hidden; height: 20px;">

                <div class="pull-left margin-l-5">
                    @if (restrictByGrade)
                    {
                        <span class="badge badge-gray profile-badge text-small">
                            @gradeLevelStart.Abbreviation - @gradeLevelEnd.Abbreviation Grade
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-gray profile-badge text-small">
                            Ages @ageStart.ToString() - @ageEnd.ToString()
                        </span>
                    }

                </div>

                @foreach (var property in properties)
                {
                    <div class="pull-left margin-l-5">
                        <span class="badge badge-gray profile-badge text-small">
                            @property.Value
                        </span>
                    </div>
                }
            </div>

            <div style="margin-top: 20px; height: 75px;display: table-cell; vertical-align: middle;">
                <h3>
                    <strong title="@Model.Title">@Model.Title.MaxChars(28, "...")</strong>
                </h3>
            </div>

            <div class="" style="height: 40px;">
                <span class="text-medium-small">
                    @Model.Headline.MaxChars(70, "...")
                </span>
            </div>

            <div class="margin-t-20">
                <a href="javascript:WebPage.navigateIframe('@(account?.HomePageUrl)')" class="btn btn-register btn-block">
                    Learn More &raquo;
                </a>
            </div>

        </div>
    </div>
</div>
