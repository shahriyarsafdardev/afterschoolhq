@model AccountProfile
@{
    var account = Model.GetAccount();
    var profileHeaderImageUrl = Model.GetHeaderImageUrl();
    var followers = account.GetSubscriberCount();
    var location = Model.GetLocation();
    var gradeLevelStart = Model.GetGradeLevelStart();
    var gradeLevelEnd = Model.GetGradeLevelEnd();
    var photos = Model.GetPhotos();

    if (photos.Any() && profileHeaderImageUrl.IsBlank())
    {
        var ah = AfterSchoolLibrary.Helpers.Utilities.GetNewAmazonHelper();
        profileHeaderImageUrl = ah.GetFileLink(photos.First().Value, true, null, true);
    }

    if (profileHeaderImageUrl.IsBlank())
    {
        profileHeaderImageUrl = $"https://maps.googleapis.com/maps/api/staticmap?center={location.FormatAddressWithoutName(false).Replace(" ", "")}&zoom=13&size=1500x600&maptype=roadmap&markers=color:{Server.UrlEncode("0x00AE83")}|{Server.UrlEncode(location.FormatAddressWithoutName(false))}&key=AIzaSyAdjn8QBBStTz9TDAjZOyijAato7uzvjjk";
    }
}

<div class="col-sm-12 col-md-6 col-lg-4 col-xl-3 participation-object searchable-object"
     id="@account.Uid"     
     name="@account.Name">

    <div class="panel" style="overflow: hidden;">
        <div class="reg-header" style="background-image: url(@profileHeaderImageUrl); min-height: 150px; height: 200px; position: relative;">

            @if (Model.IsOpenDuringCovid)
            {
                <div style="top: 10px; right: 10px; position:absolute;">
                    <span class="badge badge-danger profile-badge text-small">
                        <icon class="s7-clock"></icon>
                        Open During COVID
                    </span>
                </div>
            }

        </div>
        <div class="panel-body">

            <h3>
                <strong title="@account.Name">@account.Name</strong>
            </h3>

            <div class="">
                <p class="text-medium-small">
                    <span>
                        <span>@gradeLevelStart.Name - @gradeLevelEnd.Name Grade</span>
                    </span>
                </p>
            </div>

            <div class="margin-t-20">
                <p class="text-medium-small">
                    <span>
                        @location.FormatAddressWithoutName(false)
                    </span>
                </p>
            </div>

            <p class="activity-description text-muted hide">
                Description
            </p>

            <div class="margin-t-20">
                <a href="@account.HomePageUrl" class="btn btn-register btn-block">
                    Learn More &raquo;
                </a>
            </div>

        </div>
    </div>
</div>
