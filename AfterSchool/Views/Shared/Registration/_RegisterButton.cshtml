@model ParticipationObject

@{
    var condensed = false;
    var accountOwner = Model.OwnerAccount.ID.HasValue ? Model.OwnerAccount.GetAccountOwner() : null;
    var canRegiserFor = true;
    var session = (ParticipationObject)ViewData["session"];

    if (ViewData["condensed"].IsNotEmpty() && ViewData["condensed"].ToString().ToBoolean())
    {
        condensed = true;
    }

    if (ViewData["canRegisterFor"].IsNotEmpty())
    {
        canRegiserFor = ViewData["canRegisterFor"].ToString().ToBoolean();
    }
}

@if (!Model.OwnerAccount.ID.HasValue)
{
    <a href="@Url.Action("index", "signup")" class="btn btn-register btn-block">
        @if (condensed)
        {
            @: Customize &raquo;
        }
        else
        {
            <div class="hidden-xs">
                Customize this page &raquo;
            </div>
            <div class="hidden-sm hidden-md hidden-lg">
                Customize &raquo;
            </div>
        }
    </a>
}
else if (accountOwner.IsNotEmpty() && !accountOwner.VerifiedAccount)
{
    if (SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model.OwnerAccount))
    {
        <button class="btn btn-header-action-callout btn-block" onclick="AccountSetup.sendVerificationEmail()">
            @if (condensed)
            {
                @: Verify Email
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo; Verify your email
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Verify Email &raquo;
                </div>
            }
        </button>
    }
    else
    {
        <button class="btn btn-register btn-block" disabled title="The account owner has not verified their account">
            @if (condensed)
            {
                @: Registration Disabled
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo;
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Registration Disabled &raquo;
                </div>
            }
        </button>
    }
}
else
{
    if (Model.RegistrationPeriod.IsOpen(Model.OwnerAccount))
    {
        if (Model.IsSession())
        {
            var group = Model.GetActivityGroup();

            if (canRegiserFor)
            {
                <a href="@group.BrowseUrl" class="btn btn-register btn-block">
                    @if (condensed)
                    {
                        @:Browse &raquo;
                    }
                    else
                    {
                        @:Browse Activities &raquo;
                    }
                </a>
            }
        }
        else if (session.IsNotEmpty())
        {
            <button href="@Model.GetRegistrationPageUrl()" class="btn btn-register btn-cart btn-block" in-cart="0" uid="@Model.Uid">
                <span><i class="s7-plus icon-medium"></i><i class="s7-cart icon-medium"></i></span>
            </button>
        }
        else
        {
            <a href="@Model.GetRegistrationPageUrl()" class="btn btn-register btn-block">
                @Model.RegistrationMode.ToString() &raquo;
            </a>
        }
    }
    else if (Model.RegistrationPeriod.WillOpen(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register btn-block">
            @if (condensed)
            {
                @:Will open soon
            }
            else
            {
                var ts = Model.RegistrationPeriod.WillOpenIn(Model.OwnerAccount);

                @:Registration will open in

                if (ts.Days > 0)
                {
                    @: @ts.Days days @ts.Hours hrs
                }
                else
                {
                    @: @ts.Hours hrs @ts.Minutes mins
                }
            }
        </button>
    }
    else if (Model.RegistrationPeriod.IsClosed(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register btn-block">
            @if (condensed)
            {
                @:Registration Closed
            }
            else
            {
                @:Registration is now closed
            }

        </button>
    }
}

@if (!condensed)
{
    <div class="row margin-v-30"></div>
}