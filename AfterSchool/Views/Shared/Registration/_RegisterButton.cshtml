@model ParticipationObject

@{
    var condensed = false;
    var accountOwner = Model.OwnerAccount.ID.HasValue ? Model.OwnerAccount.GetAccountOwner() : null;
    var canRegisterFor = true;
    var session = (ParticipationObject)ViewData["session"];
    var currentUser = SessionVariables.CurrentUser;
    var anotherChild = ViewData["anotherChild"].IsNotEmpty();

    if (ViewData["condensed"].IsNotEmpty() && ViewData["condensed"].ToString().ToBoolean())
    {
        condensed = true;
    }

    if (ViewData["canRegisterFor"].IsNotEmpty())
    {
        canRegisterFor = ViewData["canRegisterFor"].ToString().ToBoolean();
    }

    var isPublished = Model.IsPublished;
}

@if (!Model.OwnerAccount.ID.HasValue)
{
    <a href="@Url.Action("index", "signup")" class="btn btn-register btn-block">
        @if (condensed)
        {
            @: Customize &raquo;
        }
        else
        {
            <div class="hidden-xs">
                Customize this page &raquo;
            </div>
            <div class="hidden-sm hidden-md hidden-lg">
                Customize &raquo;
            </div>
        }
    </a>
}
else if (accountOwner.IsNotEmpty() && !accountOwner.VerifiedAccount)
{
    if (currentUser.IsNotEmpty() && currentUser.HasAccessTo(Model.OwnerAccount))
    {
        <button class="btn btn-header-action-callout btn-block" onclick="AccountSetup.sendVerificationEmail()">
            @if (condensed)
            {
                @: Verify Email
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo; Verify your email
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Verify Email &raquo;
                </div>
            }
        </button>
    }
    else
    {
        <button class="btn btn-register btn-block" disabled title="The account owner has not verified their account">
            @if (condensed)
            {
                @: Registration Disabled
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo;
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Registration Disabled &raquo;
                </div>
            }
        </button>
    }
}
else if (!Model.OwnerAccount.CanProcessPayments() && !Model.IsFree)
{
    if (currentUser.IsNotEmpty() && currentUser.HasAccessTo(Model.OwnerAccount))
    {
        var redirectUrl = Url.Action("paymentsoptions", "account", new { area = "org", isfullscreen = 1, source = "profile" });

        <a class="btn btn-header-action-callout btn-block" href="@Url.Action("switch", "logout", new { id = Model.OwnerAccount.Uid, redirectUrl = redirectUrl })">
            @if (condensed)
            {
                @: Enable Payments
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo; Enable Payments
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Enable Payments &raquo;
                </div>
            }
        </a>
    }
    else
    {
        <button class="btn btn-register btn-block" disabled title="The account owner has not setup their payment account">
            @if (condensed)
            {
                @: Registration Disabled
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo;
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Registration Disabled &raquo;
                </div>
            }
        </button>
    }
}
else if (Model.RegistrationFinalized)
{
    <button type="button" class="btn btn-register btn-block">
        @if (condensed)
        {
            @:Registration Closed
        }
        else
        {
            @:Registration is now closed
        }
    </button>
}
else
{
    if (Model.RegistrationPeriod.IsOpen(Model.OwnerAccount))
    {
        if (Model.IsSession())
        {
            var group = Model.GetActivityGroup();

            if (canRegisterFor)
            {
                <a href="@group.BrowseUrl" class="btn btn-register btn-block">
                    @if (condensed)
                    {
                        @:Browse &raquo;
                    }
                    else
                    {
                        @:Browse Activities &raquo;
                    }
                </a>
            }
        }
        else if (session.IsNotEmpty())
        {
            if (canRegisterFor)
            {
                <button href="@Model.GetRegistrationPageUrl()" class="btn btn-register btn-cart btn-block" in-cart="0" uid="@Model.Uid">
                    <span><i class="s7-plus icon-medium"></i><i class="s7-cart icon-medium"></i></span>
                </button>
            }
        }
        else if (Model.Schedule.IsNotEmpty() && !Model.Schedule.IsOngoing && Model.Schedule.IsEndingInTwoDays(Model.OwnerAccount))
        {
            <button type="button" class="btn btn-register btn-block">
                Registration Closed
            </button>
        }
        else if (Model.ActivityType == ActivityType.VolunteerOpportunity)
        {
            if (canRegisterFor || !isPublished)
            {
                if (Model.GetActivity().CostFrequencyTypeId == ActivityCostFrequencyType.PerClass)
                {   
                    if (!isPublished)
                    {
                        <button class="disabled btn btn-register btn-block" disabled="disabled" False>
                            <span>Select Dates &raquo;</span>
                        </button>
                    }
                    else
                    {
                        <a href="@Model.GetActivityDateSelectionUrl()" class="btn btn-register btn-block" True>
                            <span>Select Dates &raquo;</span>
                        </a>
                    }
                }
                else
                {
                    var buttonText = Model.SeatsRemaining == 0 ? "Join Waiting List" : Model.RegistrationMode.ToString();
                    var alreadyRegistered = false;
                    var volunteerRegistrant = currentUser?.GetMasterVolunteerRegistrant();
                    
                    if (volunteerRegistrant.IsNotEmpty() && volunteerRegistrant.HasSubmittedFor(Model, null))
                    {
                        alreadyRegistered = true;
                        buttonText = "Already Registered";
                    }

                    if (!isPublished || alreadyRegistered)
                    {
                        <button class="disabled btn btn-register btn-block" disabled="disabled">
                            <span>@buttonText &raquo;</span>
                        </button>
                    }
                    else
                    {
                        <a href="@Model.GetRegistrationPageUrl()" class="btn btn-register btn-block">
                            <span>@buttonText &raquo;</span>
                        </a>
                    }
                }
            }
        }
        else
        {
            if (canRegisterFor || !isPublished)
            {
                var anotherChildString = anotherChild ? " for New Child" : "";
                
                if (Model.IsActivity() && Model.GetActivity().CostFrequencyTypeId == ActivityCostFrequencyType.PerClass)
                {
                    if (!isPublished)
                    {
                        <button class="disabled btn btn-register btn-block" disabled="disabled">
                            <span>Select Dates @anotherChildString &raquo;</span>
                        </button>
                    }
                    else
                    {
                        <a href="@Model.GetActivityDateSelectionUrl()" class="btn btn-register btn-block">
                            <span>Select Dates @anotherChildString &raquo;</span>
                        </a>
                    }
                }
                else
                {
                    var buttonText = Model.SeatsRemaining == 0 ? "Join Waiting List" : Model.RegistrationMode.ToString();
                    
                    if (!isPublished)
                    {
                        <button class="disabled btn btn-register btn-block" disabled="disabled">
                            <span>@buttonText @anotherChildString &raquo;</span>
                        </button>
                    }
                    else
                    {
                        <a href="@Model.GetRegistrationPageUrl()" class="btn btn-register btn-block">
                            <span>@buttonText @anotherChildString &raquo;</span>
                        </a>
                    }
                }
            }
        }
    }
    else if (Model.RegistrationPeriod.WillOpen(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register btn-block">
            @if (condensed)
            {
                @:Will open soon
            }
            else
            {
                var ts = Model.RegistrationPeriod.WillOpenIn(Model.OwnerAccount);

                @:Registration will open in

                if (ts.Days > 0)
                {
                    @: @ts.Days days @ts.Hours hrs
                }
                else
                {
                    @: @ts.Hours hrs @ts.Minutes mins
                }
            }
        </button>
    }
    else if (Model.RegistrationPeriod.IsClosed(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register btn-block">
            @if (condensed)
            {
                @:Registration Closed
            }
            else
            {
                @:Registration is now closed
            }

        </button>
    }
}

@if (!condensed)
{
    <div class="row margin-v-30"></div>
}