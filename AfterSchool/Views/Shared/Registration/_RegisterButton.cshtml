@model ParticipationObject

@{
    var condensed = false;
    var accountOwner = Model.OwnerAccount.ID.HasValue ? Model.OwnerAccount.GetAccountOwner() : null;

    if (ViewData["condensed"].IsNotEmpty() && ViewData["condensed"].ToString().ToBoolean())
    {
        condensed = true;
    }
}

@if (!Model.OwnerAccount.ID.HasValue)
{
    <a href="@Url.Action("index", "signup")" class="btn btn-register">
        @if (condensed)
        {
            @: Customize &raquo;
        }
        else
        {
            <div class="hidden-xs">
                Customize this page &raquo;
            </div>
            <div class="hidden-sm hidden-md hidden-lg">
                Customize &raquo;
            </div>
        }
    </a>
}
else if (accountOwner.IsNotEmpty() && !accountOwner.VerifiedAccount)
{
    if (SessionVariables.LoggedInUser.IsNotEmpty() && SessionVariables.LoggedInUser.HasAccessTo(Model.OwnerAccount))
    {
        <button class="btn btn-register" onclick="AccountSetup.sendVerificationEmail()">
            @if (condensed)
            {
                @: Verify Email
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo; Verify your email
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Verify Email &raquo;
                </div>
            }
        </button>
    }
    else
    {
        <button class="btn btn-register" disabled title="The account owner has not verified their account">
            @if (condensed)
            {
                @: Registration Disabled
            }
            else
            {
                <div class="hidden-xs">
                    Registration Not Enabled &raquo;
                </div>
                <div class="hidden-sm hidden-md hidden-lg">
                    Registration Disabled &raquo;
                </div>
            }
        </button>
    }
}
else
{
    if (Model.RegistrationPeriod.IsOpen(Model.OwnerAccount))
    {
        <a href="@Model.GetRegistrationPageUrl()" class="btn btn-register">
            @Model.RegistrationMode.ToString() &raquo;
        </a>
    }
    else if (Model.RegistrationPeriod.WillOpen(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register">
            @if (condensed)
            {
                @:Will open soon
            }
            else
            {
                var ts = Model.RegistrationPeriod.WillOpenIn(Model.OwnerAccount);

                @:Registration will open in 

                if (ts.Days > 0)
                {
                    @: @ts.Days days @ts.Hours hrs
                }
                else
                {
                    @: @ts.Hours hrs @ts.Minutes mins
                }
            }
        </button>
    }
    else if (Model.RegistrationPeriod.IsClosed(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register">
            @if (condensed)
            {
                @:Registration Closed
            }
            else
            {
                @:Registration is now closed
            }

        </button>
    }
}