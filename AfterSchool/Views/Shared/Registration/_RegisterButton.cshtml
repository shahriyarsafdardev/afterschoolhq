@model ParticipationObject

@{ 
    var condensed = false;

    if (ViewData["condensed"].IsNotEmpty() && ViewData["condensed"].ToString().ToBoolean())
    {
        condensed = true;
    }
}

@if (!Model.OwnerAccount.ID.HasValue)
{
    <a href="mailto:sales@afterschoolhq.com?subject=RE: @Model.OwnerAccount.Name - Get Started with @UILabel.ProductName()&body=%0D%0A%0D%0A%0D%0A @Model.OwnerAccount.HomePageUrl" class="btn btn-register">
        @if (condensed)
        {
            @: Get Started &raquo;
        }
        else
        {
            @: Get Started with @UILabel.ProductName()  &raquo;
        }
    </a>
}
else
{
    if (Model.RegistrationPeriod.IsOpen(Model.OwnerAccount))
    {
        <a href="@Model.GetRegistrationPageUrl()" class="btn btn-register">
            @Model.RegistrationMode.ToString() &raquo;
        </a>
    }
    else if (Model.RegistrationPeriod.WillOpen(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register">
            @if (condensed)
            {
                @:Will open soon
            }
            else
            {
                @:Registration will open in @Model.RegistrationPeriod.WillOpenIn(Model.OwnerAccount).Days days @Model.RegistrationPeriod.WillOpenIn(Model.OwnerAccount).Hours hrs
            }
        </button>
    }
    else if (Model.RegistrationPeriod.IsClosed(Model.OwnerAccount))
    {
        <button type="button" class="btn btn-register">
            @if (condensed)
            {
                @:Registration Closed
            }
            else
            {
                @:Registration is now closed
            }
        
        </button>
    }
}