@model RegistrationHeaderViewModel

@{
    var currentUser = SessionVariables.CurrentUser;
    var currentAccount = SessionVariables.CurrentAccount;
    var regHeaderStyle = "";
    var logoUrl = "";
    var isFollowing = false;
    var midColSpan = 6;
    var showFollow = false;
    var showUnfollow = true;
    var hideButtons = false;
    var shareUrl = Model.Account.ShortHomePageUrl;
    var shareObject = Model.Account.Name;
    var isInEditMode = currentUser.IsNotEmpty() && currentUser.HasAccessTo(Model.Account) && Request["edit"] == "1";
    var groupId = Model.ParticipationObject?.GetAnyRelatedActivityGroupId();

    if (Model.ParticipationObject.IsNotEmpty())
    {
        shareUrl = Model.ParticipationObject.GetHomePageUrl();
        shareObject = $"{Model.ParticipationObject.Name} by {Model.Account.Name}";
    }

    if (Model.HeaderUrl.IsNotEmpty())
    {
        regHeaderStyle = $"background-image: linear-gradient(rgba(0, 0, 0, .8), rgba(0, 0, 0, .8)), url(\"{Model.HeaderUrl}\")";
    }

    if (Model.LogoUrl.IsNotEmpty())
    {
        logoUrl = Model.LogoUrl;
    }

    if (currentUser.IsNotEmpty())
    {
        isFollowing = currentUser.IsSubscribedTo(Model.Account);

        showFollow = !isFollowing;
        showUnfollow = isFollowing;
    }

    if (ViewData["hidebuttons"] != null)
    {
        hideButtons = ViewData["hidebuttons"].ToString().ToBoolean();
    }

    if (hideButtons)
    {
        midColSpan = 10;
        hideButtons = true;
    }

    if (Model.AccountProfile.IsEmpty())
    {
        midColSpan = 12;
        hideButtons = true;
    }
    else if (logoUrl.IsBlank())
    {
        if (hideButtons)
        {
            midColSpan = 12;
        }
        else
        {
            midColSpan = 8;
        }
    }
}

@helper renderEditButtion(string anchor, WebUser currentUser)
{
    if (currentUser.IsNotEmpty() && currentUser.HasAccessTo(Model.Account) && Request["edit"] == "1")
    {
        var redirectUrl = $"{Url.Action("style", "account", new { area = "org", isfullscreen = 1, returnurl = Request.Url })}#{anchor}";

        <span>
            <a href="@Url.Action("switch", "logout", new { id = Model.Account.Uid, redirectUrl = redirectUrl })#@anchor"
               class="btn btn-alt7 btn-sm">
                Edit &raquo;
            </a>
        </span>
    }
}

<div class="row">

    @if (!Model.Account.HasAccountProfile() && currentUser.IsNotEmpty() && currentUser.HasAccessTo(Model.Account))
    {
        <div class="profile-edit-bar text-center">
            <a href="@Url.Action("style", "account", new { area = "org", isfullscreen = 1, returnurl = Request.Url })"
               class="btn btn-alt7 btn-lg btn-block">
                Customize your Profile &raquo;
            </a>
        </div>
    }

    <div class="reg-header" style="@regHeaderStyle">
        <div class="reg-header-overlay col-lg-10 col-lg-offset-1 col-md-12">

            <div>
                @renderEditButtion("header", currentUser)
            </div>

            @if (logoUrl.IsNotBlank())
            {
                <div class="col-lg-2 col-md-12">
                    <div class="logo-wrapper">
                        <img src="@logoUrl" onclick="location.href='@Model.Account.HomePageUrl'" class="pointer" />
                    </div>
                </div>
            }

            <div class="col-lg-@midColSpan col-md-6 col-sm-12">


                <h1 class="activity-title notranslate">
                    <span>@Html.Raw(Model.Title)</span>
                    @if (Model.SessionName.IsNotEmpty())
                    {
                        @: - @(((ParticipationObject)ViewBag.Session).Name)
                    }
                    @if (Model.IsDemo)
                    {
                        <span class="badge badge-danger">DEMO</span>
                    }
                </h1>

                @if (Model.Account.Name != Model.Title && Model.AccountProfile?.Title != Model.Title)
                {
                    <p class="text-medium-small">
                        @Model.Account.Name
                    </p>
                }

                @if (Model.Headline.IsNotEmpty())
                {
                    <p class="reg-header-headline">
                        @Model.Headline
                    </p>
                }

                <div>
                    @if (Model.AccountProfile.IsNotEmpty() && Model.AccountProfile.IsOpenDuringCovid)
                    {
                        <span class="profile-badge badge badge-success profile-badge text-small">
                            <icon class="s7-clock"></icon>
                            Open During COVID
                        </span>
                    }
                    @if (Model.AccountProfile.IsNotEmpty() && Model.AccountProfile.IsVirtualProgram)
                    {
                        <span class="profile-badge badge badge-success profile-badge text-small">
                            <icon class="s7-monitor"></icon>
                            Virtual
                        </span>
                    }
                    @if (Model.AccountProfile.IsNotEmpty() && Model.AccountProfile.IsELearningCenter)
                    {
                        <span class="profile-badge badge badge-success profile-badge text-small">
                            <icon class="s7-clock"></icon>
                            E-Learning Center
                        </span>
                    }
                    @if (Model.Followers > 0)
                    {
                        <span class="profile-badge badge badge-darkgray profile-badge text-small">
                            <icon class="s7-user"></icon>
                            @Model.FollowersFormatted follower@(Model.Followers == 1 ? "" : "s")
                        </span>
                    }
                    @if (Model.NumberOfHoursEnrolled > 0)
                    {
                        <span class="profile-badge badge badge-darkgray profile-badge text-small">
                            <icon class="s7-clock"></icon>
                            @Model.NumberOfHoursEnrolledFormatted hrs of education provided
                        </span>
                    }
                    @if (Model.NumberOfStudentsServed > 0)
                    {
                        <span class="profile-badge badge badge-darkgray profile-badge text-small">
                            <icon class="s7-study"></icon>
                            @Model.NumberOfStudentsServedFormatted students served
                        </span>
                    }
                </div>

            </div>

            @if (!hideButtons)
            {
                var followButtonAttrs = $"class=\"btn btn-header-action {(isFollowing ? "hide" : "")} md-trigger\" data-modal=\"modal-login\" onclick=\"setLoginAction(function (callback) {{ follow(callback); }}, true)\" id=\"btn-follow\"";

                if (currentUser.IsNotEmpty())
                {
                    followButtonAttrs = $"onclick=\"follow()\" class=\"btn btn-header-action {(isFollowing ? "hide" : "")}\" id=\"btn-follow\"";
                }

                <div class="col-lg-4 col-md-6 col-sm-12">
                    <div class="padding-v-20 text-center">

                        <div>
                            <div class="btn-group @(!isFollowing ? "hide" : "")" style="width:100%;" id="btn-unfollow">
                                <button class="btn btn-header-action dropdown-toggle" data-toggle="dropdown">
                                    Following
                                    <span class="caret"></span>
                                </button>
                                <div class="dropdown-menu pointer" style="width:100%;">
                                    <button class="btn btn-header-action" onclick="unfollow()">
                                        <span class="">Unfollow</span>
                                    </button>
                                </div>
                            </div>
                            <button @Html.Raw(followButtonAttrs)>
                                <i class="icon icon-left s7-add-user"></i>
                                Follow
                            </button>
                        </div>

                        <button class="btn btn-header-action btn-share">
                            <i class="icon icon-left s7-share"></i>
                            Share
                        </button>

                        @if (Model.ParticipationObject.IsEmpty())
                        {
                            if (!Model.Account.IsClaimed)
                            {
                                <button id="model-claim" class="btn btn-header-action md-trigger btn-danger" data-modal="modal-claim-profile" onclick="resetClaimForm()">
                                    <i class="icon icon-left s7-door-lock"></i>
                                    <span class="">Claim Profile</span>
                                </button>
                            }

                            if (Model.Account.ContactFormId.HasValue)
                            {
                                <a href="@Model.Account.ContactUrl" class="btn btn-header-action">
                                    <i class="icon icon-left s7-mail"></i>
                                    <span class="">Contact Us</span>
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-header-action md-trigger" data-modal="modal-contact-provider" onclick="resetContactProviderForm()">
                                    <i class="icon icon-left s7-mail"></i>
                                    <span class="">Contact Us</span>
                                </button>
                            }

                            if (Model.Account.IsClaimed)
                            {
                                <div>
                                    <div class="btn-group" style="width:100%;">
                                        <button class="btn btn-header-action dropdown-toggle" data-toggle="dropdown">
                                            <i class="s7-more"></i>
                                            More
                                            <span class="caret"></span>
                                            <span class="sr-only">Toggle Dropdown</span>
                                        </button>
                                        <div class="dropdown-menu pointer" style="width:100%;">
                                            @RenderViewActivitiesButton(isInEditMode)
                                            @RenderMakeAPaymentButton(currentUser)
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else if (groupId.IsEmpty())
                        {
                            //.. we will not show this button if activity is associated with session or activity group.
                            <a href="@Model.ParticipationObject.GetInterestedPageUrl()" class="btn btn-header-action">
                                <i class="icon icon-left s7-bell"></i>
                                <span class="">I'm Interested</span>
                            </a>
                        }

                    </div>
                    <div class="clearfix"></div>
                </div>
            }

        </div>

        <div class="clearfix"></div>
    </div>
</div>

<div id="modal-share" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-body">

            <div class="row">
                <button type="button" data-dismiss="modal" id="modal-share-close" aria-hidden="true" class="close md-close">
                    <i class="s7-close text-medium"></i>
                </button>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div>
                        @{ Html.RenderPartial(
                                  "~/Views/Shared/Registration/_ShareLinks.cshtml",
                                  new ViewDataDictionary() {
                                   { "ShareObject", shareObject },
                                   { "ShareUrl", shareUrl }
}
                           ); }
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="modal-claim-profile" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-body">
            <div class="row">
                <button type="button" data-dismiss="modal" id="modal-share-close" aria-hidden="true" class="close md-close">
                    <i class="s7-close text-medium"></i>
                </button>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="claim-profile-form">
                        <div class="form-group">
                            <p>Please submit your information below to begin the claim process</p>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input id="claim-firstname" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input id="claim-lastname" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input id="claim-email" type="email" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input id="claim-phone" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            @if (AfterSchoolLibrary.Helpers.Utilities.IsProduction || AfterSchoolLibrary.Helpers.Utilities.IsStaging)
                            {
                                Html.RenderPartial("~/Views/Shared/Form/_Recaptcha.cshtml", "");
                            }
                        </div>
                        <div class="form-group claim-profile-submit text-center">
                            <button type="button" id="btn-claim-profile" class="btn btn-primary btn-lg btn-block" onclick="claimProfile()">Claim Profile  &raquo;</button>
                        </div>
                    </div>
                    <div id="claim-profile-done" class="hide">
                        <h2>Thank you!</h2>
                        <p>Your information has been submitted. Someone will be in touch with you shortly.</p>
                        <p>
                            <button type="button" data-dismiss="modal" id="modal-share-close" class="btn btn-primary btn-lg btn-block md-close">
                                Close
                            </button>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="modal-contact-provider" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-body">
            <div class="row">
                <button type="button" data-dismiss="modal" id="modal-share-close" aria-hidden="true" class="close md-close">
                    <i class="s7-close text-medium"></i>
                </button>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="contact-provider-form">
                        <div class="form-group">
                            <p class="text-medium-small">Please enter your information to contact @Model.Account.Name</p>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input id="contact-firstname" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input id="contact-lastname" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input id="contact-email" type="email" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input id="contact-phone" type="text" autocomplete="off" class="form-control">
                        </div>
                        <div class="form-group">
                            @if (AfterSchoolLibrary.Helpers.Utilities.IsProduction || AfterSchoolLibrary.Helpers.Utilities.IsStaging)
                            {
                                Html.RenderPartial("~/Views/Shared/Form/_Recaptcha.cshtml", "");
                            }
                        </div>
                        <div class="form-group contact-provider-submit text-center">
                            <button type="button" id="btn-contact-provider" class="btn btn-primary btn-lg btn-block" onclick="contactProvider()">Submit &raquo;</button>
                        </div>
                    </div>
                    <div id="contact-provider-done" class="hide">
                        <h2>Thank you!</h2>
                        <p>Your information has been submitted. Someone will be in touch with you shortly.</p>
                        <p>
                            <button type="button" data-dismiss="modal" id="modal-share-close" class="btn btn-primary btn-lg btn-block md-close">
                                Close
                            </button>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    function follow(callback) {
        $('#btn-follow').val('...');
        $('#btn-follow').prop('disabled', true);

        $.get('@Url.Action("follow", "services")/@Model.Account.Uid', function (data) {

            if (data && data.status == 'ok') {

                $('#btn-follow').addClass('hide');
                $('#btn-unfollow').removeClass('hide');

                if (callback) {
                    callback();
                } else {
                    Notifications.showMessage('Success', '<p>You are now following <strong>@Model.Account.Name</strong>.</p><p>You will receive notifications when @Model.Account.Name publishes new activities.</p>', true);
                }

            } else {
                Notifications.showErrors(data.messages);
            }

            $('#btn-follow').prop('disabled', false);
        });
    }

    function unfollow(callback) {
        $('#btn-follow').val('...');
        $('#btn-follow').prop('disabled', true);

        $.get('@Url.Action("unfollow", "services")/@Model.Account.Uid', function (data) {

            if (data && data.status == 'ok') {

                $('#btn-follow').removeClass('hide');
                $('#btn-unfollow').addClass('hide');

                if (callback) {
                    callback();
                }

            } else {
                Notifications.showErrors(data.messages);
            }

            $('#btn-follow').prop('disabled', false);
        });
    }

    function interested() {

    }

    function resetClaimForm() {
        $('#claim-profile-form').removeClass('hide');
        $('#claim-profile-done').addClass('hide');

        $('#claim-firstname').val('');
        $('#claim-lastname').val('');
        $('#claim-email').val('');
        $('#claim-phone').val('');

        AHQRecaptcha.reset('claim-form-recaptcha');
    }

    function claimProfile() {

        params = 'profile=@Model.Account.Uid&firstname=' + encodeURIComponent($('#claim-firstname').val()) + '&lastname=' + encodeURIComponent($('#claim-lastname').val()) + '&email=' + encodeURIComponent($('#claim-email').val()) + '&phone=' + encodeURIComponent($('#claim-phone').val()) + '&g_recaptcha_response=' + AHQRecaptcha.getToken('claim-form-recaptcha');

        $('#btn-claim-profile').html('Submitting...');
        $('#btn-claim-profile').prop('disabled', true);

        $.post(
            '@Url.Action("claimprofile", "services")',
            params,
            function (data) {

                $('#btn-claim-profile').prop('disabled', false);
                $('#btn-claim-profile').html('Claim Profile');

                if (data && data.status == 'ok') {
                    $('#claim-profile-form').addClass('hide');
                    $('#claim-profile-done').removeClass('hide');
                } else {
                    Notifications.showErrors(data.messages);
                }

            }
        )
    }

    function resetContactProviderForm() {
        $('#contact-provider-form').removeClass('hide');
        $('#contact-provider-done').addClass('hide');

        $('#contact-firstname').val('');
        $('#contact-lastname').val('');
        $('#contact-email').val('');
        $('#contact-phone').val('');

        AHQRecaptcha.reset('contact-form-recaptcha');
    }

    function contactProvider() {

        params = 'profile=@Model.Account.Uid&firstname=' + encodeURIComponent($('#contact-firstname').val()) + '&lastname=' + encodeURIComponent($('#contact-lastname').val()) + '&email=' + encodeURIComponent($('#contact-email').val()) + '&phone=' + encodeURIComponent($('#contact-phone').val()) + '&g_recaptcha_response=' + AHQRecaptcha.getToken('contact-form-recaptcha');

        $('#btn-contact-provider').html('Submitting...');
        $('#btn-contact-provider').prop('disabled', true);

        $.post(
            '@Url.Action("contactprovider", "services")',
            params,
            function (data) {

                $('#btn-contact-provider').prop('disabled', false);
                $('#btn-contact-provider').html('Contact &raquo;');

                if (data && data.status == 'ok') {
                    $('#contact-provider-form').addClass('hide');
                    $('#contact-provider-done').removeClass('hide');
                } else {
                    Notifications.showErrors(data.messages);
                }

            }
        )
    }

</script>

@helper RenderViewActivitiesButton(bool isInEditMode)
{
    if (!Request.Url.ToString().IsSameAs(Model.Account.BrowseUrl))
    {
        if (!isInEditMode || Model.Account.HasActivities())
        {
            <button onclick="location.href='@Model.Account.BrowseUrl'" class="btn btn-header-action">
                <i class="icon icon-left s7-gleam"></i>
                <span class="">
                    View @UILabel.ActivityLabel(ActivityType.Activity, true)
                </span>
            </button>
        }
    }
}

@helper RenderMakeAPaymentButton(WebUser currentUser)
{
    if (Model.Account.CanProcessPayments())
    {
        if (currentUser.IsNotEmpty())
        {
            var payUrl = Model.Account.PayUrl;

            if (!currentUser.IsActive)
            {
                payUrl = Url.Action("confirm", "signup", new { id = currentUser.Uid, returnurl = payUrl });
            }

            <button onclick="location.href='@payUrl'" class="btn btn-header-action">
                <i class="icon icon-left s7-credit"></i>
                <span class="">Make A Payment</span>
            </button>
        }
        else
        {
            <button type="button" class="btn btn-header-action md-trigger" data-modal="modal-login" onclick="setLoginRedirect('@Model.Account.PayUrl', true)">
                <i class="icon icon-left s7-credit"></i>
                <span class="">Make A Payment</span>
            </button>
        }
    }
    else if (currentUser.IsNotEmpty() && Model.Account.OwnerId == currentUser.ID && !Model.Account.CanProcessPayments())
    {
        var redirectUrl = Url.Action("paymentsoptions", "account", new { area = "org", isfullscreen = 1, source = "profile" });

        <a href="@Url.Action("switch", "logout", new { id = Model.Account.Uid, redirectUrl = redirectUrl })"
           class="btn btn-header-action-callout">
            <i class="icon icon-left s7-credit"></i>
            Enable Payments
        </a>
    }
}
