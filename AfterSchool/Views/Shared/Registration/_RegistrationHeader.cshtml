@model ParticipationObject

@{ 
    var regHeaderStyle = "";
    var profile = Model.OwnerAccount.GetAccountProfile();

    if (profile.HeaderImage.IsNotEmpty())
    {
        regHeaderStyle = $"background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url({profile.GetHeaderImageUrl()})";
    }
}

<div class="reg-header" style="@regHeaderStyle">
    <div class="reg-header-overlay">
        <h1 class="text-center">You are registering for: @Model.Name</h1>
    </div>
</div>
