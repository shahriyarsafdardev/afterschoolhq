@model RegistrationHeaderViewModel

@{
    var regHeaderStyle = "";
    var logoUrl = "";
    var isFollowing = false;
    var midColSpan = 7;
    var showFollow = false;
    var showUnfollow = true;
    var hideButtons = false;
    var shareUrl = Model.Account.ShortHomePageUrl;
    var shareObject = Model.Account.Name;
    var isInEditMode = SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model.Account);

    if (Model.ParticipationObject.IsNotEmpty())
    {
        shareUrl = Model.ParticipationObject.GetHomePageUrl();
        shareObject = $"{Model.ParticipationObject.Name} by {Model.Account.Name}";
    }

    if (Model.HeaderUrl.IsNotEmpty())
    {
        regHeaderStyle = $"background-image: linear-gradient(rgba(0, 0, 0, .8), rgba(0, 0, 0, .8)), url({Model.HeaderUrl})";
    }

    if (Model.LogoUrl.IsNotEmpty())
    {
        logoUrl = Model.LogoUrl;
    }

    if (SessionVariables.CurrentUser.IsNotEmpty())
    {
        isFollowing = SessionVariables.CurrentUser.IsSubscribedTo(Model.Account);

        showFollow = !isFollowing;
        showUnfollow = isFollowing;
    }

    if (ViewData["hidebuttons"] != null)
    {
        hideButtons = ViewData["hidebuttons"].ToString().ToBoolean();
    }

    if (hideButtons)
    {
        midColSpan = 10;
        hideButtons = true;
    }

    if (Model.AccountProfile.IsEmpty())
    {
        midColSpan = 12;
        hideButtons = true;
    }
    else if (logoUrl.IsBlank())
    {
        midColSpan = 9;
    }
}

@helper renderEditButtion(string anchor)
{
    if (SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model.Account) && Request["edit"] == "1")
    {
        <span>
            <a href="@Url.Action("style", "account", new { area = "org", isfullscreen = 1, returnurl = Request.Url })#@anchor"
               class="btn btn-alt7 btn-sm">
                Edit &raquo;
            </a>
        </span>
    }
}

<div class="row">

    @if (!Model.Account.HasAccountProfile() && SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model.Account))
    {
        <div class="profile-edit-bar text-center">
            <a href="@Url.Action("style", "account", new { area = "org", isfullscreen = 1, returnurl = Request.Url })"
               class="btn btn-alt7 btn-lg btn-block">
                Customize your Profile &raquo;
            </a>
        </div>
    }

    <div class="reg-header" style="@regHeaderStyle">
        <div class="reg-header-overlay col-md-8 col-md-offset-2">

            <div>
                @renderEditButtion("header")
            </div>

            @if (logoUrl.IsNotBlank())
            {
                <div class="col-lg-2 col-md-12">
                    <div class="reg-header-logo">
                        <img src="@logoUrl" onclick="location.href='@Model.Account.HomePageUrl'" class="pointer" />
                    </div>
                </div>
            }

            <div class="col-lg-@midColSpan col-md-12">
                <h1 class="activity-title">
                    <span>@Html.Raw(Model.Title)</span>
                    @if (Model.SessionName.IsNotEmpty())
                    {
                        @: - @(((ParticipationObject)ViewBag.Session).Name)
                    }
                    @if (Model.IsDemo)
                    {
                        <span class="badge badge-danger">DEMO</span>
                    }
                </h1>

                @if (Model.Headline.IsNotEmpty())
                {
                    <p class="reg-header-headline">
                        @Model.Headline
                    </p>
                }

                <div>
                    @if (Model.Followers > 0)
                    {
                        <span class="badge badge-darkgray profile-badge text-small">
                            <icon class="s7-user"></icon>
                            @Model.FollowersFormatted follower@(Model.Followers == 1 ? "" : "s")
                        </span>
                    }
                    @if (Model.NumberOfHoursEnrolled > 0)
                    {
                        <span class="badge badge-darkgray profile-badge text-small">
                            <icon class="s7-clock"></icon>
                            @Model.NumberOfHoursEnrolledFormatted hrs of education provided
                        </span>
                    }
                    @if (Model.NumberOfStudentsServed > 0)
                    {
                        <span class="badge badge-darkgray profile-badge text-small">
                            <icon class="s7-study"></icon>
                            @Model.NumberOfStudentsServedFormatted students served
                        </span>
                    }
                </div>

            </div>

            @if (!hideButtons)
            {
                var followButtonAttrs = $"class=\"btn btn-header-action {(isFollowing ? "hide" : "")} md-trigger\" data-modal=\"modal-login\" onclick=\"setLoginAction(function (callback) {{ follow(callback); }})\" id=\"btn-follow\"";

                if (SessionVariables.CurrentUser.IsNotEmpty())
                {
                    followButtonAttrs = $"onclick=\"follow()\" class=\"btn btn-header-action {(isFollowing ? "hide" : "")}\" id=\"btn-follow\"";
                }

                <div class="col-lg-3 col-md-12">
                    <div class="padding-v-20 text-center">

                        <div>
                            <div class="btn-group @(!isFollowing ? "hide" : "")" style="width:100%;" id="btn-unfollow">
                                <button class="btn btn-register dropdown-toggle" data-toggle="dropdown">
                                    Following
                                    <span class="caret"></span>
                                </button>
                                <div class="dropdown-menu pointer" style="width:100%;">
                                    <a class="dropdown-item text-center" href="#" onclick="unfollow()" style="display: inline">Unfollow</a>
                                </div>
                            </div>
                            <button @Html.Raw(followButtonAttrs)>
                                <i class="icon icon-left s7-add-user"></i>
                                Follow
                            </button>
                        </div>

                        <button class="btn btn-header-action btn-share">
                            <i class="icon icon-left ion-share hide"></i>
                            <i class="icon icon-left s7-share"></i>
                            Share

                            @if (Model.ParticipationObject.IsNotEmpty())
                            {
                                @UILabel.ActivityLabel(ActivityType.Activity, false)
                            }
                            else
                            {
                                @:Profile
                            }

                        </button>

                        @if (Model.ParticipationObject.IsEmpty())
                        {
                            <button onclick="location.href='@Model.Account.BrowseUrl'" class="btn btn-header-action">
                                <i class="icon icon-left s7-gleam"></i>
                                <span class="">View @UILabel.ActivityLabel(ActivityType.Activity, true)</span>
                            </button>

                            if (Model.Account.IsClaimed)
                            {
                                if (SessionVariables.CurrentUser.IsNotEmpty())
                                {
                                    <button onclick="location.href='@Model.Account.PayUrl'" class="btn btn-header-action">
                                        <i class="icon icon-left s7-credit"></i>
                                        <span class="">Make A Payment</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-header-action md-trigger" data-modal="modal-login" onclick="setLoginRedirect('@Model.Account.PayUrl')">
                                        <i class="icon icon-left s7-credit"></i>
                                        <span class="">Make A Payment</span>
                                    </button>
                                }
                            }
                            else
                            {
                                <button class="btn btn-header-action md-trigger" data-modal="modal-claim-profile" onclick="resetClaimForm()">
                                    <i class="icon icon-left s7-door-lock"></i>
                                    <span class="">Claim Profile</span>
                                </button>
                            }
                        }
                        else
                        {
                            <button onclick="interested()" class="btn btn-header-action hide">
                                <i class="icon icon-left s7-bell"></i>
                                <span class="">I'm Interested</span>
                            </button>
                        }
                    </div>
                    <div class="clearfix"></div>
                </div>
            }

        </div>

        <div class="clearfix"></div>
    </div>
</div>

<div id="modal-share" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">

    <div class="md-content">
        <div class="modal-body">
            
            <div class="row">
                <button type="button" data-dismiss="modal" id="modal-share-close" aria-hidden="true" class="close md-close">
                    <i class="icon s7-close"></i>
                </button>
            </div>
            
            <div class="row">
                <div class="col-md-12">
                    <div>
                        <div class="form-group text-center">

                            <div>
                                <p>
                                    Share <strong>@shareObject</strong> with your friends and family via Web Link, Twitter, or Facebook
                                </p>
                            </div>

                            <div class="footer-social-icon text-center">
                                <input type="text" value="@shareUrl" id="account-reg-url" onclick="this.select()" class="form-control inline hidden" />
                                <span class="icon-xlarge pointer"
                                      style="text-decoration: none;"
                                      onclick="copyUrlToShare()"
                                      title="Copy Url">
                                    <i class="ion-ios-world-outline"></i>
                                </span>
                                <span style="font-size: 12px;" id="copy-url-text">Copy Url</span>
                            </div>

                            <div class="footer-social-icon text-center hide">
                                <span class="icon-xlarge"
                                      style="text-decoration: none;">
                                    <i class="ion-ios-email-outline"></i>
                                </span>
                                <span style="font-size: 12px;">Email</span>
                            </div>

                            <div class="footer-social-icon">
                                <a href="http://twitter.com/share?text=@Url.Encode($"Check out {shareObject} on {AfterSchoolLibrary.Helpers.Utilities.AppName()}")&url=@Url.Encode(shareUrl)&hashtags=Education,AfterschoolActivities,AfterSchoolHQ"
                                   class="icon-xlarge"
                                   style="text-decoration: none;"
                                   target="_blank"
                                   title="Share to Twitter">
                                    <i class="ion-social-twitter-outline"></i>
                                </a>
                                <span style="font-size: 12px;">Twitter</span>
                            </div>

                            <div class="footer-social-icon text-center">
                                <a href="https://www.facebook.com/sharer/sharer.php?u=@Url.Encode(shareUrl)"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;"
                                   target="_blank"
                                   title="Share to Facebook">
                                    <i class="ion-social-facebook-outline"></i>
                                </a>
                                <span style="font-size: 12px;">Facebook</span>
                            </div>

                            <div class="footer-social-icon text-center hide">
                                <span id="share-more"
                                      class="icon-xlarge margin-h-30"
                                      style="text-decoration: none; cursor: pointer;"
                                      target="_blank"
                                      title="More...">
                                    <i class="ion-ios-more"></i>
                                </span>
                                <span style="font-size: 12px; text-align: center;">More</span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<div id="modal-claim-profile" class="md-modal colored-header modal-colored-header modal-colored-header-dark custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-body">
            <div class="row">
                <button type="button" data-dismiss="modal" id="modal-share-close" aria-hidden="true" class="close md-close">
                    <i class="icon s7-close"></i>
                </button>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div id="claim-profile-form">
                        <div class="form-group">
                            <p>Please submit your information below to begin the claim process</p>
                        </div>
                        <div class="form-group">
                            <label>First Name</label>
                            <input id="claim-firstname" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Last Name</label>
                            <input id="claim-lastname" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input id="claim-email" type="email" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Phone</label>
                            <input id="claim-phone" type="text" autocomplete="off" class="form-control" required>
                        </div>
                        <div class="form-group claim-profile-submit text-center">
                            <button type="button" id="btn-claim-profile" class="btn btn-primary btn-lg btn-block" onclick="claimProfile()">Claim Profile</button>
                        </div>
                    </div>
                    <div id="claim-profile-done" class="hide">
                        <h2>Thank you!</h2>
                        <p>Your information has been submitted. Someone will be in touch with you shortly.</p>
                        <p>
                            <button type="button" data-dismiss="modal" id="modal-share-close" class="btn btn-primary btn-lg btn-block md-close">
                                Close
                            </button>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>

    PageEvent.add(PageEvent.AFTER_INIT, function () {

        if (navigator.share) {
            $('#share-more').parent().removeClass('hide');
            $('#share-more').click(function () {
                navigator.share({
                    title: '@shareObject',
                    url: '@shareUrl',
                    text: 'Check out @shareObject on @AfterSchoolLibrary.Helpers.Utilities.AppName()'
                }).then(() => {
                    console.log('Thanks for sharing!');
                }).catch(console.error);
            });

        }

        $('.btn-share').click(function () {
            $('#modal-share').addClass('md-show');
            $('#modal-share-close').click(function () {
                $('#modal-share').removeClass('md-show');
            });
        });

    });

    function follow(callback) {
        $('#btn-follow').val('...');
        $('#btn-follow').prop('disabled', true);

        $.get('@Url.Action("follow", "services")/@Model.Account.Uid', function (data) {

            if (data && data.status == 'ok') {

                $('#btn-follow').addClass('hide');
                $('#btn-unfollow').removeClass('hide');

                if (callback) {
                    callback();
                } else {
                    Notifications.showMessage('Success', '<p>You are now following <strong>@Model.Account.Name</strong>.</p><p>You will receive notifications when @Model.Account.Name publishes new activities.</p>', true);
                }

            } else {
                Notifications.showErrors(data.messages);
            }

            $('#btn-follow').prop('disabled', false);
        });
    }

    function unfollow(callback) {
        $('#btn-follow').val('...');
        $('#btn-follow').prop('disabled', true);

        $.get('@Url.Action("unfollow", "services")/@Model.Account.Uid', function (data) {

            if (data && data.status == 'ok') {

                $('#btn-follow').removeClass('hide');
                $('#btn-unfollow').addClass('hide');

                if (callback) {
                    callback();
                }

            } else {
                Notifications.showErrors(data.messages);
            }

            $('#btn-follow').prop('disabled', false);
        });
    }

    function interested() {

    }

    function copyUrlToShare() {
        WebPage.copySelection('account-reg-url', 'URL has been copied', function () {
            $('#copy-url-text').html('Copied!');

            setTimeout(function () {
                $('#copy-url-text').html('Copy Url');
            }, 3000);
        })
    }

    function resetClaimForm() {
        $('#claim-profile-form').removeClass('hide');
        $('#claim-profile-done').addClass('hide');
    }

    function claimProfile() {

        params = 'profile=@Model.Account.Uid&firstname=' + encodeURIComponent($('#claim-firstname').val()) + '&lastname=' + encodeURIComponent($('#claim-lastname').val()) + '&email=' + encodeURIComponent($('#claim-email').val()) + '&phone=' + encodeURIComponent($('#claim-phone').val());

        $('#btn-claim-profile').html('Submitting...');
        $('#btn-claim-profile').prop('disabled', true);

        $.post(
            '@Url.Action("claimprofile", "services")',
            params,
            function (data) {

                $('#btn-claim-profile').prop('disabled', false);
                $('#btn-claim-profile').html('Claim Profile');

                if (data && data.status == 'ok') {
                    $('#claim-profile-form').addClass('hide');
                    $('#claim-profile-done').removeClass('hide');
                } else {
                    Notifications.showErrors(data.messages);
                }

            }
        )
    }
    </script>
