@model AfterSchoolLibrary.Activity

@{ 
    var location = Model.GetLocation() ?? new Location();
    var isMyLocation = Model.AccountId == location?.HostAccountId;
    var addressViewModel = isMyLocation ? location.ToAddressViewModel() : new AddressViewModel();

    var hideRelationship = "";
    var hideType = "";

    if (!isMyLocation && location.ID.HasValue)
    {
        hideRelationship = "hide";
        hideType = "hide";
    }

}

<div class="panel panel-default">
    <div class="panel-heading">
        Your Activity Location Information
    </div>
    <div class="panel-body">
        

        @{
        Html.RenderPartial(
            "~/Views/Shared/_LocationEdit.cshtml",
            location,
            new ViewDataDictionary() { { "accountId", Model.AccountId.Value } }
        );
        }

        <div id="add-location" class="hide">
            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Location Name <span class="text-danger">*</span>
                    <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Building name or organization name" data-placement="top"></i>
                </label>
                <div class="col-sm-9">
                    <input type="text" name="locationname" id="locationname" value="" class="form-control" />
                </div>
            </div>

            @{
            Html.RenderPartial(
              "~/Views/Shared/_Address.cshtml",
              addressViewModel,
                new ViewDataDictionary()
                {
                    { "labeladdress1required", true },
                    { "labelcityrequired", true },
                    { "labelstaterequired", true },
                    { "labelpostalcoderequired", true },
                    { "labelcolwidth", 3 },
                    { "disabled", false }
                });
            }

        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">
                Room Number / Specific Instructions
            </label>
            <div class="col-sm-9">
                @{
                    Html.RenderPartial(
                             "~/Views/Shared/_TextEditor.cshtml",
                             Model.LocationDetails,
                             new ViewDataDictionary() {
                            //{ "required", true },
                            { "name", "locationdetails" },
                            { "id", "locationdetails" }
                             }
                             );
                }
                <p class="text-muted"><em>Enter your room number or any special instructions or information about the location? Such as pick up or drop off locations?</em></p>
            </div>
        </div>

        <div class="form-group @hideRelationship" id="hostaccount-div">
            <label class="control-label col-sm-3">What is your relationship with this location?</label>
            <div class="col-sm-9">
                <div class="am-radio inline">
                    <input type="radio" id="mylocation-no" name="mylocation" class="form-control my-location" required="required" value="" @(isMyLocation ? "" : "checked=\"checked\"") />
                    <label for="mylocation-no">I provide an activity at this location</label>
                </div>
                <div class="am-radio inline">
                    <input type="radio" id="mylocation-yes" name="mylocation" class="form-control my-location" required="required" value="1" @(isMyLocation ? "checked=\"checked\"" : "") />
                    <label for="mylocation-yes">I am an employee/associated with this location</label>
                </div>
            </div>
        </div>

        <div class="form-group @hideType" id="isschool-div">
            <label class="col-sm-3">What type of location is this?</label>
            <div class="col-sm-9">
                <div class="am-checkbox">
                    @foreach (var item in Enum.GetValues(typeof(LocationType)).Cast<LocationType>().Where(x => x != LocationType.NotSet))
                    {
                        <div class="am-radio inline">
                            <input type="radio" 
                                   id="locationtype-@((int)item)" 
                                   name="locationtype" 
                                   class="form-control location-type" 
                                   @*required="required"*@ 
                                   value="@((int)item)" 
                                   @(item == location.LocationTypeId ? "checked=\"checked\"" : "") />
                            <label for="locationtype-@((int)item)">@item.ToString().SplitByUpperCase()</label>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>
