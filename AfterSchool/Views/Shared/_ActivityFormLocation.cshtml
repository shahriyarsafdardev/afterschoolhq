@model Activity

<div class="panel panel-default panel-small-padding">
    <div class="panel-heading">
        Your Activity Location Information
    </div>
    <div class="panel-body">

        <div class="form-group">
            <label class="col-md-3 control-label">
                Location
            </label>
            <div class="col-md-9">
                <div class="am-radio">
                    <span>
                        <input type="radio"
                               name="activitylocationtype"
                               id="activitylocationtype-@((int)ActivityLocationType.NotSet)"
                               value="@((int)ActivityLocationType.NotSet)"
                               class="activitylocationtype"
                               @(Model.ActivityLocationTypeId == ActivityLocationType.NotSet ? "checked=\"checked\"" : "") />
                        <label for="activitylocationtype-@((int)ActivityLocationType.NotSet)">None</label>
                        &nbsp;
                    </span>
                    <span>
                        <input type="radio"
                               name="activitylocationtype"
                               id="activitylocationtype-@((int)ActivityLocationType.Physical)"
                               value="@((int)ActivityLocationType.Physical)"
                               class="activitylocationtype"
                               @(Model.ActivityLocationTypeId == ActivityLocationType.Physical ? "checked=\"checked\"" : "") />
                        <label for="activitylocationtype-@((int)ActivityLocationType.Physical)">Physical</label>
                        &nbsp;
                    </span>
                    <span>
                        <input type="radio"
                               name="activitylocationtype"
                               id="activitylocationtype-@((int)ActivityLocationType.Virtual)"
                               value="@((int)ActivityLocationType.Virtual)"
                               class="activitylocationtype"
                               @(Model.ActivityLocationTypeId == ActivityLocationType.Virtual ? "checked=\"checked\"" : "") />
                        <label for="activitylocationtype-@((int)ActivityLocationType.Virtual)">Virtual</label>
                        &nbsp;
                    </span>
                </div>
            </div>
        </div>

        <div id="physical-location" class="hide">

            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Activity Location
                </label>
                <div class="col-sm-9">
                    @{ Html.RenderPartial("~/Views/Shared/Components/_GoogleLocationEdit.cshtml", Model.GetLocation() ?? new Location() { }); }
                </div>
            </div>

            @*
            @{
                Html.RenderPartial(
                    "~/Views/Shared/Components/_LocationAddOrEdit.cshtml",
                    null,
                    new ViewDataDictionary() { { "LocationId", Model.LocationId }, { "AccountId", Model.AccountId } });
            }
            *@

            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Room Number / Specific Instructions
                </label>
                <div class="col-sm-9">
                    @{
                        Html.RenderPartial(
                         "~/Views/Shared/_TextEditor.cshtml",
                         Model.LocationDetails,
                         new ViewDataDictionary() {
                            //{ "required", true },
                            { "name", "locationdetails" },
                            { "id", "locationdetails" }
                }
                         );
                    }
                    <p class="text-muted"><em>Enter your room number or any special instructions or information about the location? Such as pick up or drop off locations?</em></p>
                </div>
            </div>

        </div>

        <div id="virtual-location" class="hide">
            <div class="form-group">
                <label class="col-sm-3 control-label">Virtual Meeting Link</label>
                <div class="col-sm-9">
                    <input type="text" class="form-control" id="virtuallocation" name="virtuallocation" onfocus="this.select()" value="@Model.VirtualLocationUrl" placeholder="https://zoom.us/example-link" />
                    <p class="text-muted">
                        <em>Will only be shared with the parent once registration has been confirmed</em>
                    </p>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        $('.activitylocationtype').click(function () {
            toggleLocationEdit($(this));
        });

        if ($('#activitylocationtype-@((int)ActivityLocationType.Physical)').is(':checked')) {
            toggleLocationEdit($('#activitylocationtype-@((int)ActivityLocationType.Physical)'));
        }

    });

    function toggleLocationEdit(obj) {
        $('#physical-location').addClass('hide');
        $('#virtual-location').addClass('hide');

        $('.my-location').prop("required", false);
        $('#virtuallocation').prop("required", false);

        if (obj.val() == '@((int)ActivityLocationType.Physical)') {
            $('#physical-location').removeClass('hide');
            $('.my-location').prop("required", true);
        } else if (obj.val() == '@((int)ActivityLocationType.Virtual)') {
            $('#virtual-location').removeClass('hide');
            $('#virtuallocation').prop("required", true);
        } 
    }

</script>
