@model AfterSchoolLibrary.Activity

@{ 
    var location = Model.GetLocation() ?? new Location();
    var isOwnedLocation = Model.AccountId == location?.HostAccountId;
    var addressViewModel = isOwnedLocation ? location.ToAddressViewModel() : new AddressViewModel();

}

<div class="panel panel-default">
    <div class="panel-heading">
        Location Information
    </div>
    <div class="panel-body">

        @{ 
            Html.RenderPartial(
                "~/Views/Shared/_LocationEdit.cshtml",
                location,
                new ViewDataDictionary() { { "accountId", Model.AccountId.Value } }
            );
        }
        
        <div id="add-location" class="hide">
            <div class="form-group">
                <label class="col-sm-3 control-label">
                    Location Name <span class="text-danger">*</span>
                    <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Building name or organization name" data-placement="top"></i>
                </label>
                <div class="col-sm-9">
                    <input type="text" name="locationname" id="locationname" value="" class="form-control" />
                </div>
            </div>

            @{ 
                Html.RenderPartial(
                  "~/Views/Shared/_Address.cshtml",
                  addressViewModel
                 );
            }

        </div>

        <div class="form-group">
            <label class="col-sm-3 control-label">
                Specific Instructions <span class="text-danger">*</span>
                <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Any special instructions or information about the location?" data-placement="top"></i>
            </label>
            <div class="col-sm-9">
                @{ 
                    Html.RenderPartial(
                     "~/Views/Shared/_TextEditor.cshtml",
                     Model.LocationDetails,
                     new ViewDataDictionary() {
                        { "required", true },
                        { "name", "locationdetails" },
                        { "id", "locationdetails" }
                     }
                     );
                }
            </div>
        </div>

        <div class="form-group" id="hostaccount-div">
            <div class="col-sm-offset-3 col-sm-9">
                <div class="am-checkbox">
                    <input type="checkbox" class="checkbox" id="mylocation" name="mylocation" value="1" @(isOwnedLocation ? " checked=\"checked\" " : "") />
                    <label for="mylocation">
                        This is my location
                        <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Do you own or have rights to this location? If so you can claim it" data-placement="top"></i>
                    </label>
                </div>
            </div>
        </div>

    </div>
</div>
