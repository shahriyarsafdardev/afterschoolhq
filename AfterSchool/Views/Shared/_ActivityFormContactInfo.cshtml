@model AfterSchoolLibrary.Activity
@{ 
    var instructors = (List<ListWebUser>)ViewBag.Instructors;
}

<div class="panel panel-default">
    <div class="panel-heading">
        Contact Information
    </div>
    <div class="panel-body">

        <div class="form-group">
            <label class="col-md-3 control-label">Contact Name <span class="text-danger">*</span></label>
            <div class="col-md-9">
                <input type="text" class="form-control" id="contactname" name="contactname" onfocus="this.select()" value="@Model.ContactName.IfBlank(SessionVariables.LoggedInUser.DisplayName)" required />
            </div>
        </div>

        <div class="form-group">
            <label class="col-md-3 control-label">Contact Phone <span class="text-danger">*</span></label>
            <div class="col-md-9">
                <input type="text" class="form-control" id="contactphone" name="contactphone" onfocus="this.select()" value="@Model.ContactPhone.IfBlank(SessionVariables.LoggedInUser.Phone)" required />
                <p class="text-muted hide">
                    <em>
                        For privacy purposes only @UILabel.RegistrantLabel(true).ToLower() who have registered will receive the contact phone number.
                    </em>
                </p>
            </div>
        </div>

        <div class="form-group">
            <label class="col-md-3 control-label">Contact Email <span class="text-danger">*</span></label>
            <div class="col-md-9">
                <input type="email" class="form-control" id="contactemail" name="contactemail" onfocus="this.select()" value="@Model.ContactEmail.IfBlank(SessionVariables.LoggedInUser.Email)" required />
            </div>
        </div>
    </div>

    <div class="panel-heading">
        Instructor
    </div>

    <div class="panel-body">
        <div class="form-group">
            <label class="col-md-3 control-label">Instructor</label>
            <div class="col-md-9">
                <select class="form-control" id="instructor" name="instructor">
                    <option value="0"></option>
                    @foreach(var instructor in instructors)
                    {
                        <option value="@instructor.ID" @(instructor.ID == Model.InstructorId ? "selected=\"selected\"" : "")>@instructor.DisplayName</option>
                    }
                </select>
            </div>
        </div>

        <script>
            PageEvent.add(PageEvent.AFTER_INIT, function () {
                $('#instructor').change(function () {
                    if ($(this).val() == '0') {
                        $('#newinstructor').removeClass('hide');
                        $('#instructorfirstname').attr('required', 'required');
                        $('#instructorlastname').attr('required', 'required');
                        $('#instructoremail').attr('required', 'required');
                        $('#instructorphone').attr('required', 'required');
                    } else {
                        $('#newinstructor').addClass('hide');
                        $('#instructorfirstname').removeAttr('required');
                        $('#instructorlastname').removeAttr('required');
                        $('#instructoremail').removeAttr('required');
                        $('#instructorphone').removeAttr('required');
                    }
                });
            });
        </script>

        <div id="newinstructor" class="hide">
            <div class="form-group">
                <label class="col-md-3 control-label">First Name</label>
                <div class="col-md-9">
                    <input type="text" class="form-control" id="instructorfirstname" name="instructorfirstname" onfocus="this.select()" value="" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-3 control-label">Last Name</label>
                <div class="col-md-9">
                    <input type="text" class="form-control" id="instructorlastname" name="instructorlastname" onfocus="this.select()" value="" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-3 control-label">Email</label>
                <div class="col-md-9">
                    <input type="text" class="form-control" id="instructoremail" name="instructoremail" onfocus="this.select()" value="" />
                </div>
            </div>
            <div class="form-group">
                <label class="col-md-3 control-label">Phone</label>
                <div class="col-md-9">
                    <input type="text" class="form-control" id="instructorphone" name="instructorphone" onfocus="this.select()" value="" />
                </div>
            </div>
        </div>
    </div>
</div>