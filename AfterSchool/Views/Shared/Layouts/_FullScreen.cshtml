<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="description" content="">
    <meta name="author" content="">
    <link rel="shortcut icon" href="/favicon.png">
    <meta name="keywords" content="app, responsive, jquery, bootstrap, dashboard, admin">
    <title>@UILabel.ProductName()</title>

    @{Html.RenderPartial("~/Views/Shared/_HeadIncludes.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/_ZendeskWidget.cshtml");}
    @{Html.RenderPartial("~/Views/Shared/JavascriptIncludes/_QuillEditorScripts.cshtml");}

    @RenderSection("head", required: false)

</head>
<body>
    <div class="am-wrapper notopmenu">
        <!-- Main section-->
        <div id="app-body" class="am-content-full">
            @RenderBody()
        </div>

        <div id="upgrade-my-plan">
            <div class="Container">
                <div class="col-md-offset-1 col-md-6 col-sm-12">
                    <h2>Get access to payment plans, customizable subscriptions, and more with our Premium plan!</h2>
                    <h5>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s,</h5>
                </div>
                <div class="col-md-4 col-sm-12 visible-md visible-lg">
                    <span class="span-close-upgrade-my-plan" onclick="return hideUpgradeMyPlan()">X</span>
                    <button class="btn btn-danger btn-upgrade-plan">Upgrade My Plan</button>                    
                    <div class="clearfix"></div>
                </div>
                <div class="col-sm-12 visible-xs visible-sm ">
                    <button class="btn btn-danger btn-upgrade-plan">Upgrade My Plan</button>
                    <button class="btn btn-warning btn-upgrade-plan" onclick="return hideUpgradeMyPlan()">Close</button>
                    <div class="clearfix"></div>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>

    </div>

    @{Html.RenderPartial("~/Views/Shared/_JavascriptIncludes.cshtml");}

    @RenderSection("scripts", required: false)

    <script>
        $(document).ready(function () {

            $('.am-content-full').css({
                'min-height': $(window).height(),
                'background-color': '#fff',
                'padding': '40px'
            });

            $('form').submit(function () {
                $(this).find('button[type="submit"]').prop('disabled', true);
                $(this).find('button[type="submit"]').html('...');
                $('#modal-saving').removeClass('hide');
            });

            $('a').click(function () {
                if ($(this).attr('href') != "#" && $(this).attr('href').indexOf('javascript:') == -1 && $(this).attr('target') != "_blank") {
                    $('#modal-saving').removeClass('hide');
                }
            });
        });

        function showUpgradeMyPlan() {
            $('#app-body').addClass('overlay')
            $('#Popup').fadeIn();
        };

        function hideUpgradeMyPlan() {
            $('#app-body').removeClass('overlay')
            $('#Popup').fadeOut();
        };
    </script>


    <div id="modal-saving"
         class="hide"
         style="position: absolute; width: 250px; height: 65px; top: 10px; right: 10px; padding: 0px; margin: 0px; background-color: #333; color: #eee; border-radius: 10px;">
        <h3 class="text-center">Loading...</h3>
    </div>

    <div id="modal-saving-1" class="md-modal modal-container modal-full-color modal-full-color-success modal-effect-8" style="perspective: 1300px;">
        <div class="modal-content">
            <div class="modal-body">
                <div style="background-image: url(/assets/img/spinner.gif); background-position: center; width: 600px; height: 300px;">
                </div>
                <div class="text-center hide">
                    <h3 id="saving-text">Saving...</h3>
                </div>
            </div>
        </div>
    </div>

</body>
</html>