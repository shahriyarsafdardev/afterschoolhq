@model Account

@{
    var refunds = (List<Stripe.Refund>)ViewBag.RefundHistory;
}
@if (refunds.Count > 0)
{
    <h4>Refund History</h4>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <tr>
                <th>Date</th>
                <th>Amount</th>
                <th>Card</th>
            </tr>        
            @foreach (var refund in refunds)
            {
                var card = (Stripe.Card)refund.Charge.Source;

                <tr>
                    <td>@refund.Created.ToShortDateTimeString()</td>
                    <td>@((refund.Amount / 100M).ToCurrency())</td>
                    <td><span class="badge badge-success">@card.Brand</span> **** **** **** @card.Last4</td>
                </tr>
            }
        </table>
    </div>
}

