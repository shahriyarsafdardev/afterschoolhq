@model ActivityGroup
@{

    var accountPackage = (AccountPackage)ViewBag.AccountPackage;
    var forms = (List<Form>)ViewBag.Forms;
    var grades = (List<GradeLevel>)ViewBag.Grades;
}

<div class="form-group">
    <label class="col-sm-3 control-label">@UILabel.ActivityGroupLabel(Model.ActivityGroupTypeId) Name<span class="text-danger">*</span></label>
    <div class="col-sm-6">
        <input type="text" class="form-control" id="name" name="name" value="@Model.Name" onfocus="this.select()" required />
    </div>
</div>

<div class="form-group hide">
    <label class="col-md-3 control-label">
        About / Description
        <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Registration Description / Instructions" data-placement="top"></i>
    </label>
    <div class="col-md-9">
        <div class="text-editor-container">
            <div class="text-editor" id="description-div">
                @Html.Raw(Model.Description)
            </div>
            <textarea name="description" id="description" class="hide"></textarea>
        </div>
    </div>
</div>

@if (accountPackage.HasFeature(FeatureType.ManageForms))
{ // should ignore if from district
    <div class="form-group">
        <label class="col-md-3 control-label">
            Registration Form <span class="text-danger">*</span>
        </label>
        <div class="col-md-6">
            <select name="form" id="form" class="form-control" required>
                <option value="">Select Form...</option>
                <option value="0"> + New Form</option>
                @foreach (var form in forms)
                {
                    <option value="@form.ID" @(Model.FormId == form.ID ? " selected=\"selected\" " : "")>@form.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <a class="btn btn-block btn-link" href="@Url.Action("edit","form", new { id = Model.FormId })" id="editForm" target="_blank">Edit Form</a>
        </div>
    </div>
}

<div class="form-group">
    <label class="col-sm-3 control-label">Invite Only</label>
    <div class="col-sm-9">
        @{
            Html.RenderPartial(
                "~/Views/Shared/_SwitchButton.cshtml",
                Model.IsInviteOnly,
                new ViewDataDictionary()
                {
                    { "checkboxname", "isinviteonly" },
                    { "checkboxid", "isinviteonly" }
                }
            );
        }
    </div>
</div>

@if (SessionVariables.AccountPackage.HasFeature(FeatureType.AllowApplications))
{
    <div class="form-group">
        <label class="col-sm-3 control-label">
            Registration Mode <span class="text-danger">*</span>
        </label>
        <div class="col-sm-9">
            <div class="am-radio inline">
                @foreach (var item in Enum.GetValues(typeof(RegistrationMode)).Cast<RegistrationMode>().Where(x => x != RegistrationMode.NotSet))
                {
                    <input type="radio" name="regmode" id="regmode-@item.ToString()" value="@((int)item)" @(item == Model.RegistrationModeId ? "checked=\"checked\"" : "") />
                    <label for="regmode-@item.ToString()" class="margin-h-10">@item.ToString().SplitByUpperCase()</label>
                }
            </div>
        </div>
    </div>
}
else
{
    <input type="hidden" name="regmode" value="@((int)RegistrationMode.Register)" />
}

@if (Model.ActivityGroupTypeId == ActivityGroupType.League)
{
    <div class="form-group">
        <label class="col-md-3 control-label">
            Gender Restrictions
        </label>
        <div class="col-md-9">
            <div class="am-radio inline">
                @foreach (GenderRestrictionType item in System.Enum.GetValues(typeof(GenderRestrictionType)))
                {
                    <input type="radio" name="genderrestrictions" id="genderrestrictions-@((int)item)" @(Model.GenderRestriction == item ? " checked=\"checked\" " : "") value="@((int)item)" />
                    <label for="genderrestrictions-@((int)item)" class="margin-h-10">
                        @item.ToString().SplitByUpperCase()
                    </label>
                }
            </div>
        </div>
    </div>

    <div class="form-group">
        <label class="col-md-3 control-label">
            Grade Restrictions
        </label>
        <div class="col-md-1">
            @{Html.RenderPartial
                    (
                        "~/Views/Shared/_SwitchButton.cshtml",
                        Model.MinGradeLevelId.HasValue,
                        new ViewDataDictionary()
                        {
                        { "checkboxname", "graderestrictions" },
                        { "checkboxid", "graderestrictions" },
                        { "disabled", false }
                        }
                    );
            }
        </div>
        <div class="col-md-5 hide" id="grade">
            <select id="mingrade" name="mingrade" class="form-control">
                @foreach (var grade in grades)
                {
                    <option value="@grade.ID" @(Model.MinGradeLevelId == grade.ID ? " selected=\"selected\" " : "")>@grade.Name</option>
                }
            </select>
            <p class="margin-v-10">
                To
            </p>
            <select id="maxgrade" name="maxgrade" class="form-control">
                @foreach (var grade in grades)
                {
                    <option value="@grade.ID" @(Model.MaxGradeLevelId == grade.ID ? " selected=\"selected\" " : "")>@grade.Name</option>
                }
            </select>
        </div>
    </div>
}


<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $('#graderestrictions').click(function () {
                gradeCheck();
            });

            $('#mingrade').change(function () {
                if (parseInt($(this).val()) > parseInt($('#maxgrade').val())) {
                    $('#maxgrade').val($(this).val());
                }
            });

            gradeCheck();
        }
    );

    function gradeCheck() {
        if ($('#graderestrictions').is(':checked')) {
            $('#grade').removeClass('hide');
        } else {
            $('#grade').addClass('hide');
        }
    }
</script>