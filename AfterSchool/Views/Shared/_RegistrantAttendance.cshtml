@model Attendance
@{
    var attendanceRegistrants = (List<AttendanceRegistrant>)ViewData["AttendanceRegistrants"];
    var account = SessionVariables.CurrentAccount;
    var schedule = (ActivitySchedule)ViewData["schedule"];
    var controller = (string)ViewData["controller"];
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
    const int FUTURE_INSTANCES_TO_SHOW = 8;
    var getRegistrantActivity = (List<RegistrantActivity>)ViewData["RegistrantActivity"];
}

<form method="post" action="@Url.Action("trackattendance", controller, new { id = Model.ActivityUid, att = Model.ID })" class="form-horizontal">

    <div class="panel panel-default">
        <div class="panel-heading">
            <div class="pull-right">
                <a href="@Url.Action("attendance", controller, new { id = Model.ActivityUid })" class="btn btn-default btn-space">&laquo; Back to List</a>
                <button type="submit" class="btn btn-primary btn-space" @(attendanceRegistrants.Count == 0 || getRegistrantActivity.Where(a => a.AssignmentTypeId != RegistrationAssignmentType.Withdrawn && a.AssignmentTypeId != RegistrationAssignmentType.WaitingList).Count() == 0 ? "disabled=\"disabled\"" : "")><i class="icon icon-left s7-diskette"></i> Save Attendance</button>
            </div>
            <i class="s7-check"></i> Take Attendance
        </div>
        <div class="panel-body">

            <div class="row">
                <div class="form-group">
                    <div class="col-md-2 control-label">
                        Attendance Date
                    </div>
                    <div class="col-md-10">
                        <select name="activityinstance" id="activityinstance" class="form-control">
                            <option value="">Select...</option>
                            @{
                                foreach (var instance in schedule.GetInSessionInstances().DistinctBy(instance => instance.ID))
                                {
                                    if (instance.StartDateTime.HasValue)
                                    {
                                        if (DateTime.UtcNow >= account.ConvertFromAccountTimeZone(instance.StartDateTime.Value).AddDays(-FUTURE_INSTANCES_TO_SHOW))
                                        {
                                            <option value="@instance.ID" @(Model.ActivityInstanceId == instance.ID ? " selected=\"selected\" " : "")>
                                                @instance.StartDateTime.ToShortTimeString(), @instance.StartDateTime.Value.ToLongDateString()
                                            </option>
                                        }
                                    }
                                }
                            }
                        </select>                       
                    </div>
                </div>
            </div>
            <div class="col-md-10 col-md-offset-2">

                <div class="table-responsive">
                    <table class="table table-striped">
                        <tr>
                            <th>Name</th>
                            <th>Present? (<a href="javascript:checkAll()">All</a> / <a href="javascript:uncheckAll()">None</a>)</th>
                        </tr>

                        @foreach (var attendanceRegistrant in attendanceRegistrants)
                        {
                            if (getRegistrantActivity.Any(a => a.RegistrantId == attendanceRegistrant.RegistrantId && (a.AssignmentTypeId != RegistrationAssignmentType.Withdrawn && a.AssignmentTypeId != RegistrationAssignmentType.WaitingList)))
                            { 
                            <tr>
                                <td>@(isTechSupport ? attendanceRegistrant.RegistrantId.ToString() : attendanceRegistrant.RegistrantName)</td>
                                <td>
                                    @if (attendanceRegistrant.RegistrantRegistrantTypeId == RegistrantType.Individual)
                                    {
                                        Html.RenderPartial(
                                            "~/Views/Shared/_SwitchButton.cshtml",
                                            attendanceRegistrant.NumberPresent > 0,
                                            new ViewDataDictionary()
                                            {
                                                { "checkboxname", "present-" + attendanceRegistrant.ID },
                                                { "checkboxid", "present-" + attendanceRegistrant.ID },
                                                { "disabled", attendanceRegistrant.TransactionId.IsNotEmpty().ToString() }
                                            });
                                    }
                                    else
                                    {
                                        <div class="col-md-6">
                                            <input type="number" step="1" name="present-@attendanceRegistrant.ID" id="present-@attendanceRegistrant.ID" value="@(attendanceRegistrant.NumberPresent.HasValue ? attendanceRegistrant.NumberPresent.Value : 0)" class="form-control" onfocus="this.select()" />
                                        </div>
                                        <div class="col-md-6 text-large">
                                            of @attendanceRegistrant.NumberPossible
                                        </div>
                                    }
                                </td>
                            </tr>
                            }
                        }

                    </table>
                </div>
            </div>

            <div class="form-group">
                <label class="col-sm-2 control-label"></label>
                <div class="col-sm-10">
                    <button type="submit" class="btn btn-primary btn-lg btn-block pull-right" @(attendanceRegistrants.Count == 0 || (getRegistrantActivity.Where(a => a.AssignmentTypeId != RegistrationAssignmentType.Withdrawn && a.AssignmentTypeId != RegistrationAssignmentType.WaitingList).Count() == 0) ? "disabled=\"disabled\"" : "")><i class="s7-diskette"></i> Save</button>
                </div>
            </div>

        </div>
    </div>
</form>

<script>

    function checkAll() {
        $('input[id^="present-"]').prop('checked', true);
    }
    function uncheckAll() {
        $('input[id^="present-"]').prop('checked', false);
    }
</script>


<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#activityinstance').change(function () {
            location.href = '@Url.Action("trackattendance", "activity")?actinst=' + $(this).val();
        });
    });
</script>

