@model List<RegistrantActivity>
@{ 
    var account = (Account)ViewData["Account"];
    var activity = (Activity)ViewData["Activity"];
    var editaction = ViewData["EditAction"].ToString();
    var editcontroller = ViewData["EditController"].ToString();
    var assignmentType = (RegistrationAssignmentType)ViewData["assignmentType"];
    var paging = (PagingModel)ViewData["PagingModel"];

    var previousLink = "#";
    var nextLink = "#";
    if (paging.IsNotEmpty())
    {
        if (paging.PageNumber > 1)
        {
            previousLink = Url.Action("index", "registrant", new { activity = Request["activity"], pn = paging.PageNumber - 1, rpp = Request["rpp"] });
        }
        if (paging.PageNumber < paging.TotalPages)
        {
            nextLink = Url.Action("index", "registrant", new { activity = Request["activity"], pn = paging.PageNumber + 1, rpp = Request["rpp"] });
        }
    }
}

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                @if (activity.IsEmpty())
                {
                    <th>Activity</th>
                }
                <th class="text-center">Seat Index</th>
                <th>Date Registered</th>
                <th>Amount Paid</th>
                @if (activity.IsNotEmpty())
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                foreach (var ra in Model)
                {
                    <tr>
                        <td>
                            @if (ra.RegistrationId.HasValue && ra.RegistrationAssignmentTypeId != RegistrationAssignmentType.Invited)
                            {
                                <a href="@Url.Action(editaction, editcontroller, new { id = ra.ID })" class="btn btn-default btn-sm">
                                    <i class="icon icon-left s7-user"></i> View Details
                                </a>
                            }
                        </td>
                        <td>@ra.RegistrantName.IfBlank(ra.RegistrantEmail)</td>
                        @if (activity.IsEmpty())
                        {
                            <td>@ra.ActivityName</td>
                        }
                        <td class="text-center">@ra.AssignmentSeatIndex</td>
                        <td>@account.ConvertToAccountTimeZone(ra.CreateDate.Value).ToLongDateTimeString()</td>
                        <td>
                            @if (ra.ActivityCostPerRegistrant == 0)
                            {
                                @:FREE
                            }
                            else
                            {
                                @ra.GetAmountPaid().ToCurrency()
                            }
                        </td>
                        @if (activity.IsNotEmpty())
                        {
                            <td>
                                <select name="newassignmenttype" id="newassignmenttype" class="form-control">
                                    @foreach (var assignmenttype in Enum.GetValues(typeof(RegistrationAssignmentType)).Cast<RegistrationAssignmentType>())
                                    {
                                        switch(assignmenttype)
                                        {
                                            case RegistrationAssignmentType.NotSet:
                                                continue;
                                        }
                                        <option value="@((int)assignmenttype)" @(assignmenttype == ra.AssignmentTypeId ? "selected=\"selected\"" : "")>
                                            @assignmenttype.ToString().SplitByUpperCase()
                                        </option>
                                    }
                                </select>

                                <button class="btn btn-primary btn-xs md-trigger btn-space hide" 
                                        data-modal="modal-waitinglist" 
                                        onclick="setWaitingListRegistrant('@ra.RegistrantName', '@Url.Action("waitinglist", "activity", new { id = ra.ID })', '@ra.TotalSeats')">
                                    <i class="s7-edit"></i> Waiting List
                                </button>
                            </td>
                        }
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">There are no @UILabel.RegistrantLabel(true).ToLower()</td>
                </tr>
            }
        </tbody>

    </table>
</div>

@if(paging.IsNotEmpty() && paging.TotalCount > 0)
{
    <div class="row">
        <div class="col-md-6">
            Showing @paging.StartingRecord - @paging.EndingRecord of @paging.TotalCount
        </div>
        <div class="col-md-6">
            <div class="btn-group pull-right">
                <a class="btn btn-default" href="@previousLink">Previous</a>
                @for (var i = 1; i <= paging.TotalPages; i++)
                {
                    <a class="btn btn-default" href="@Url.Action("index", "registrant", new { activity = Request["activity"], pn = i, rpp = Request["rpp"] })">@i</a>
                }
                <a class="btn btn-default" href="@nextLink">Next</a>
            </div>
        </div>
    </div>
}


<div id="modal-waitinglist" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-waitinglist" action="" method="post" class="form-inline">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Manage <span id="registrant-name"></span> Waiting List</h3>
            </div>
            <div class="modal-body form">

                <p>
                    

                    Move 
                    <select id="numbertomove" name="numbertomove" class="form-control"></select>
                    @UILabel.RegistrantLabel(true).ToLower()
                    <select id="movefromto" name="movefromto" class="form-control">
                        <option value="from">from</option>
                        <option value="to">to</option>
                    </select>
                    the waiting list
                </p>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Waiting List &raquo;</button>
            </div>
        </div>
    </form>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#newassignmenttype').change(function () {
            location.href = '@Url.Action("moveregistrant", "activity", new { id = activity.Uid })';
        });
    }); 

    function setWaitingListRegistrant(name, url, totalSeats) {
        $('#registrant-name').html(name);
        $('#form-waitinglist').attr('action', url);

        $('#numbertomove').html('');
        for (var i = 1; i <= totalSeats; i++) {
            $('#numbertomove').append('<option value="' + i + '">' + i + '</option>')
        }
    }
</script>