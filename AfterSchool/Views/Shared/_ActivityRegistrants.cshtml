@model List<RegistrantActivity>
@{ 
    var account = (Account)ViewData["Account"];
    var activity = (Activity)ViewData["Activity"];
    var participationObject = activity.GetParticipationObject();
    var editaction = ViewData["EditAction"].ToString();
    var editcontroller = ViewData["EditController"].ToString();
    var assignmentType = (RegistrationAssignmentType)ViewData["assignmentType"];
    var paging = (PagingModel)ViewData["PagingModel"];
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);

    var previousLink = "#";
    var nextLink = "#";
    if (paging.IsNotEmpty())
    {
        if (paging.PageNumber > 1)
        {
            previousLink = Url.Action("index", "registrant", new { activity = Request["activity"], pn = paging.PageNumber - 1, rpp = Request["rpp"] });
        }
        if (paging.PageNumber < paging.TotalPages)
        {
            nextLink = Url.Action("index", "registrant", new { activity = Request["activity"], pn = paging.PageNumber + 1, rpp = Request["rpp"] });
        }
    }
}

<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th></th>
                <th>Name</th>
                <th class="text-center">Seat Index</th>
                <th>Date Registered</th>
                @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView))
                {
                    <th>Amount Paid</th>
                }
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count > 0)
            {
                foreach (var ra in Model)
                {
                    <tr>
                        <td>
                            @if (ra.RegistrationId.HasValue && ra.AssignmentTypeId != RegistrationAssignmentType.Invited)
                            {
                                <a href="@Url.Action(editaction, editcontroller, new { id = ra.Uid })" class="btn btn-default btn-sm">
                                    <i class="icon icon-left s7-user"></i> View Details
                                </a>
                            }
                        </td>
                        <td>@(!isTechSupport ? ra.RegistrantName.IfBlank(ra.RegistrantEmail) : ra.RegistrantName.IfBlank(ra.RegistrantEmail).ToMaskedData())</td>
                        <td class="text-center">@ra.SeatIndex</td>
                        <td>@account.ConvertToAccountTimeZone(ra.CreateDate.Value).ToLongDateTimeString()</td>
                        @if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView))
                        {
                            var amount = ra.GetAmountPaid();
                            var isProRated = ra.GetIsProRatedFlagByParent();

                            <td>
                                @if (participationObject.IsFree)
                                {
                                    @:FREE
                                }
                                else
                                {
                                    @amount.ToCurrency()

                                    if (isProRated)
                                    {
                                         <i class="s7-info icon-small" data-toggle="popover" data-trigger="hover" data-html="true" data-placement="top"
                                               data-content="Amount paid for this student is pro-rated by AHQ system and Stripe.">
                                            </i>
                                    }

                                    if (Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView) && participationObject.IsNotFreeAndCanAcceptPayments && ra.GetAmountPaid() == 0 && ra.GetRegistrant().ParentRegistrantId.HasValue)
                                    {
                                        var showButton = true;

                                        if (activity.HasSubscriptionPlan())
                                        {
                                            var subscriptionPlan = activity.GetSubscriptionPlan();

                                            if (subscriptionPlan.SplitCostEvenly && !activity.RegistrationFinalized)
                                            {
                                                showButton = false;
                                            }
                                        }

                                        if (showButton)
                                        { 
                                            <i class="s7-info icon-small" data-toggle="popover" data-trigger="hover" data-html="true" data-placement="top"
                                               data-content="Student registered with option of allow to pay later.">
                                            </i>
                                        }
                                    }    
                                }
                            </td>
                        }
                        <td>
                            @if (ra.IsRegistrantActivityStatusAccessible())
                            {
                                <select name="newassignmenttype" 
                                        id="newassignmenttype-@ra.ID" 
                                        class="form-control" 
                                        onchange="moveRegistrantAssignment(@ra.RegistrantId, '@UI.JavascriptSafeString(ra.RegistrantName)', this)">

                                    @foreach (var assignmenttype in Enum.GetValues(typeof(RegistrationAssignmentType)).Cast<RegistrationAssignmentType>())
                                    {
                                        switch (assignmenttype)
                                        {
                                            case RegistrationAssignmentType.NotSet:
                                                continue;
                                        }
                                        <option value="@((int)assignmenttype)" @(assignmenttype == ra.AssignmentTypeId ? "selected=\"selected\"" : "")>
                                            @assignmenttype.ToString().SplitByUpperCase()
                                        </option>
                                    }

                                </select>
                            } else 
                            {
                                <label>@((RegistrationAssignmentType)ra.AssignmentTypeId)</label>
                            }
                        </td>
                        <td>
                            @if (ra.IsWithdrawEnabled())
                            {
                                <button id="btn-withdraw-@ra.Uid" class="btn btn-danger btn-sm" 
                                        onclick="return processWithdraw('@ra.Uid', '@ra.ID', '@ra.RegistrantUid', '@ra.ParticipationObjectId', '@ra.ParticipationObjectTypeId', '@ra.RegistrantFirstName');">
                                    Withdraw
                                </button>
                            }
                            @if (ra.IsSendInvoiceEnabled() && Permissions.HasPermission(SessionVariables.AccountUserType, PermissionType.AccountingView) && participationObject.IsNotFreeAndCanAcceptPayments && ra.GetAmountPaid() == 0 && ra.GetRegistrant().ParentRegistrantId.HasValue)
                            {
                                var showButton = true;

                                if (activity.HasSubscriptionPlan())
                                {
                                    var subscriptionPlan = activity.GetSubscriptionPlan();

                                    if (subscriptionPlan.SplitCostEvenly && !activity.RegistrationFinalized)
                                    {
                                        showButton = false;
                                    }
                                }

                                if (showButton)
                                {
                                    <button class="btn btn-default btn-sm" 
                                            data-modal="modal-waitinglist" 
                                            id="btnsendinvoice-@ra.ID"
                                            onclick="sendPaymentReminder(this, @ra.RegistrantId, '@UI.JavascriptSafeString(ra.RegistrantName)')">
                                        Send Invoice
                                    </button>
                                }   
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">There are no @UILabel.RegistrantLabel(true).ToLower()</td>
                </tr>
            }
        </tbody>

    </table>
</div>

@if(paging.IsNotEmpty() && paging.TotalCount > 0)
{
    <div class="row">
        <div class="col-md-6">
            Showing @paging.StartingRecord - @paging.EndingRecord of @paging.TotalCount
        </div>
        <div class="col-md-6">
            <div class="btn-group pull-right">
                <a class="btn btn-default" href="@previousLink">Previous</a>
                @for (var i = 1; i <= paging.TotalPages; i++)
                {
                    <a class="btn btn-default" href="@Url.Action("index", "registrant", new { activity = Request["activity"], pn = i, rpp = Request["rpp"] })">@i</a>
                }
                <a class="btn btn-default" href="@nextLink">Next</a>
            </div>
        </div>
    </div>
}


<div id="modal-waitinglist" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-waitinglist" action="" method="post" class="form-inline">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Manage <span id="registrant-name"></span> Waiting List</h3>
            </div>
            <div class="modal-body form">

                <p>
                    

                    Move 
                    <select id="numbertomove" name="numbertomove" class="form-control"></select>
                    @UILabel.RegistrantLabel(true).ToLower()
                    <select id="movefromto" name="movefromto" class="form-control">
                        <option value="from">from</option>
                        <option value="to">to</option>
                    </select>
                    the waiting list
                </p>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Waiting List &raquo;</button>
            </div>
        </div>
    </form>
</div>

<div id="withdraw-modal-container"></div>
<script id="script-withdraw-template" type="text/template">

    <div id="modal-withdraw-registrant-<%= registrantActivityUId %>" class="modal colored-header fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                    <h3 class="modal-title"><i class="s7-attention"></i> Withdrawal Confirmation</h3>
                </div>

                <div class="modal-body">
                    Are you sure you want to withdraw <strong><%= registrantName %></strong> from <strong><%= activityName %></strong> ?
                </div>

                <div class="modal-footer">
                    <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                    <button type="button" id="btn-manual-withdraw" class="btn btn-danger padding-h-20" onclick="return withdraw('<%= participationObjectId %>', '<%= registrantId %>', '<%= type %>', '<%= registrantActivityUId %>', '<%= registrantActivityId %>')">Withdraw &amp; Cancel Payments &raquo;</button>
                </div>
            </div>
        </div>
    </div>

</script>

<script>

    function moveRegistrantAssignment(registrant, registrantName, selectBox) {
        let newAssignment = selectBox.value;
        let newAssignmentText = selectBox.options[selectBox.selectedIndex].text;
        console.log(newAssignment, selectBox.selectedIndex, newAssignmentText)
        moveRegistrantAssignment2(registrant, registrantName, newAssignment, newAssignmentText);
    }

    function moveRegistrantAssignment2(registrant, registrantName, newAssignment, newAssignmentText) {
        $.get(
            `@Url.Action("moveregistrantassignment", "services", new { id = activity.Uid })?registrant=${registrant}&assignmenttype=${newAssignment}`,
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: `${registrantName}'s seat has been moved to ${newAssignmentText}.`
                    });
                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: `Error updating the seat for ${registrantName}. Please <a href="mailto:@AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress" class="white">contact support</a>.`
                    });
                }
            }
        );
    }

    function sendPaymentReminder(obj, registrant, registrantName) {

        let objId = $(obj).attr('id').split('-')[1];

        $(obj).html('Sending...');
        $(obj).prop('disabled', true);

        $.get(
            `@Url.Action("sendpaymentreminder", "services", new { id = activity.Uid })?registrant=${registrant}`,
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: `A payment reminder email has been sent to ${registrantName}.`
                    });

                    $(`#newassignmenttype-${objId}`).val(data.AssignmentType);

                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: `Error sending payment reminder email to ${registrantName}. Please <a href="mailto:@AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress" class="white">contact support</a>.`
                    });
                }
                $(obj).html('Send Invoice');
                $(obj).prop('disabled', false);
            }
        );
    }

    function processWithdraw(registrantActivityUId, registrantActivityId, registrantId, participationObjectId, type, registrantName) {
        //.. prepare source and template
        var source = $("#script-withdraw-template").html();
        var compiled = _.template(source);

        //.. format data as JSON and combine with template
        var compiledHtml = compiled({
            registrantActivityUId: registrantActivityUId,
            registrantActivityId: registrantActivityId,
            registrantId: registrantId,
            participationObjectId: participationObjectId,
            registrantName: registrantName,
            type: type,
            activityName: '@activity.Name',
        });

        //.. update html to dom
        $('#withdraw-modal-container').html(compiledHtml);
        $('#modal-withdraw-registrant-' + registrantActivityUId).modal('show');

        return false;
    }

    function withdraw(participationObjectId, registrantId, type, registrantActivityUId, registrantActivityId) {
        if (participationObjectId && registrantId) {
            showLoader();

            var url = '@Url.Action("WithdrawRegistrant", "Activity", new { Area = "Org" })';
            $.ajax({
                type: "POST",
                url: url,
                data: { participationObjectId: participationObjectId, registrantUId: registrantId, type },
                success: function (data) {
                    if (data && data.success == true) {

                        $('#modal-withdraw-registrant-' + registrantActivityUId).modal('hide');

                        var withdrawn = '@Json.Encode(RegistrationAssignmentType.Withdrawn)';
                        $('#newassignmenttype-' + registrantActivityId).val(withdrawn); //status udpate to withdrawn
                        $('#btn-withdraw-' + registrantActivityUId).attr('disabled', 'disabled');
                        hideLoader();

                        Notifications.showBar({
                            title: 'Success',
                            message: 'Registrant Withdrawn successfully.',
                            success: true
                        });
                    } else {
                        if (data && data.status == 'error') {
                            $('#search-result').html('');

                            var error = '';

                            _.each(data.data, function (msg) {
                                error += msg?.Text + '<br />';
                            });

                            hideLoader();

                            Notifications.showBar({
                                title: 'Error',
                                message: error,
                                success: false
                            });
                        }
                    }
                }
            });
        }
    }
</script>
