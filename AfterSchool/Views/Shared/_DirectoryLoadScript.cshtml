@model string 

<script id="script-search-result-list" type="text/template">

    <% _.each(response, function(searchResult){ %>

    <style>
        #dynamicLogo-<%=searchResult.AccountUid %> {
            background-image: url("<%= searchResult.ProfileHeaderImageUrl %>");
        }
    </style>

    <div id="<%= searchResult.AccountUid %>" name="<%= searchResult.AccountName %>" class="participation-object directory-search-panel-holder">

        <div id="directory-panel" class="panel" onclick="WebPage.navigateIframe('<%= searchResult.HomePageUrl %>?dir=@Model')">
            <div id="dynamicLogo-<%= searchResult.AccountUid %>" class="reg-header panel-tabs">

                <% if(showDistance) { %>

                <div class="distance-lable">
                    <%= Math.round(searchResult.TotalDifference * 100) / 100 %> mi
                </div>

                <% } %>

                <% if(searchResult.IsAccountNowEnrolling) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-danger profile-badge text-small">
                        Now Enrolling
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsVirtualProgram) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge profile-badge text-small">
                        Virtual
                    </span>
                </div>

                <% } %>

            </div>
            <div class="panel-body" style="position: relative;">

                <div class="text-wrap directory-panel-account-name">
                    <h3 style="" class="margin-bottom-zero">
                        <strong title="<%= searchResult.AccountName %>"><%= searchResult.AccountName %></strong>
                    </h3>
                </div>

                <div class="clearfix"></div>
                <div class="text-wrap">
                    <h4 class="margin-bottom-zero font-weight-500">
                        <%= searchResult.Location %>
                    </h4>
                </div>
                <div class="clearfix"></div>
                <br/>
                <div class="text-wrap">
                    <% if(searchResult.IsRestrictByGrade) { %>
                    <h4 class="padding-top-10 font-weight-500">
                        Grade: <%= searchResult.GradeStart %> - <%= searchResult.GradeEnd %>
                    </h4>
                    <% } else { %>
                    <h4 class="padding-top-10 font-weight-500">
                        Ages: <%= searchResult.AgeStart %> - <%= searchResult.AgeEnd %>
                    </h4>
                    <% } %>
                </div>
                <div class="clearfix"></div>
                <div class="text-wrap">
                    <% if(searchResult.CostLow && searchResult.CostHigh) { %>
                    <h4 class="margin-top-0 font-weight-500">
                        Cost: $<%= searchResult.CostLow %> - $<%= searchResult.CostHigh %>
                    </h4>
                    <% } else { %>
                    <h4 class="margin-top-0">
                        <br />
                    </h4>
                    <% } %>
                </div>

                <div class="clearfix"></div>
                <div class="margin-t-20">
                    <a href="javascript:WebPage.navigateIframe('<%= searchResult.HomePageUrl %>?dir=@Model')" class="btn btn-register btn-block join-directory-btn">
                        Learn More
                    </a>
                </div>

            </div>
        </div>
    </div>

    <% }) %>

</script>