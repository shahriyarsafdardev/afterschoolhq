@model string 

<style>
    .additional-card-information {
        font-size: 17px;
        font-weight: 300;
        height: 53px;
        list-style: none;
        margin-top: 16px;
        padding: 0;
    }

    .additional-card-information li {
        margin-bottom: 2px;
    }
</style>

<script id="script-search-result-list" type="text/template">

    <% _.each(response, function(searchResult){ %>

    <style>
        #dynamicLogo-<%=searchResult.AccountUid %> {
            background-image: url("<%= searchResult.ProfileHeaderImageUrl %>");
        }
    </style>

    <div id="<%= searchResult.AccountUid %>" name="<%= searchResult.AccountName %>" class="participation-object directory-search-panel-holder">
        <div id="directory-panel" class="panel">
            <div id="dynamicLogo-<%= searchResult.AccountUid %>" class="reg-header panel-tabs">

                <% if(showDistance) { %>

                <div class="distance-lable">
                    <%= Math.round(searchResult.TotalDifference * 100) / 100 %> mi
                </div>

                <% } %>

                <% if(searchResult.IsAccountNowEnrolling) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-danger profile-badge text-small">
                        Now Enrolling
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsVirtualProgram) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge profile-badge text-small">
                        Virtual Options
                    </span>
                </div>

                <% } %>

            </div>

            <div class="panel-body" style="position: relative;">

                <h3 class="directory-panel-account-name notranslate" title="<%= searchResult.AccountName %>">                
                    <%= searchResult.AccountName %>
                </h3>

                <h4 class="margin-bottom-zero font-weight-500 notranslate">
                    <% if(searchResult.Location) { %>
                        <%= searchResult.Location %>
                    <% } else { %>
                        <br />
                    <% } %>
                </h4>
                <ul class="additional-card-information">
                    <% if(searchResult.IsRestrictByGrade) { %>
                        <li>Grade: <%= searchResult.GradeStart %> – <%= searchResult.GradeEnd %></li>
                    <% } else { %>
                        <li>Ages: <%= searchResult.AgeStart %> – <%= searchResult.AgeEnd %></li>
                    <% } %>
                    <% if (searchResult.CostRange) { %>
                        <li>Cost: <%= searchResult.CostRange %></li>
                    <% } %>
                </ul>

                <a href="<%= searchResult.HomePageUrl %>?dir=@Model" class="btn btn-register btn-block join-directory-btn">
                    Learn More
                </a>

            </div>
        </div>
    </div>

    <% }) %>

</script>