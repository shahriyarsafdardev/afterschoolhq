@model PagingModel

@if (Model.IsNotEmpty())
{
    var id = ViewData["id"];
    var action = (string)ViewData["action"];
    var controller = (string)ViewData["controller"];
    var queryString = ViewData["querystring"];
    var querySearchTxt = (ViewData["QuerySearchText"] != null ? "&q="+ViewData["QuerySearchText"].ToString() : "");
    var pageUrl = $"{Url.Action(action, controller, new { id = id })}?{queryString}{querySearchTxt}";

    var previousLink = "#";
    var nextLink = "#";

    if (Model.PageNumber > 1)
    {
        previousLink = $"{Url.Action(action, controller, new { id = id, rpp = Request["rpp"], pn = Model.PageNumber - 1 })}&{queryString}{querySearchTxt}";
    }
    if (Model.PageNumber < Model.TotalPages)
    {
        nextLink = $"{Url.Action(action, controller, new { id = id, rpp = Request["rpp"], pn = Model.PageNumber + 1 })}&{queryString}{querySearchTxt}";
    }

    var iStart = 2;
    var iEnd = Model.TotalPages - 1;
    var before = 4;
    var after = 4;

    var calcStartNumber = Model.PageNumber >= iStart ? Model.PageNumber : iStart;
    var calcEndNumber = Model.PageNumber <= iEnd ? Model.PageNumber : iEnd;

    if (iEnd - iStart > before + after)
    {
        // give me 10 surrounding numbers
        var potentialIStart = calcStartNumber - before;
        if (potentialIStart < iStart)
        {
            before += potentialIStart - iStart;
            after += (potentialIStart - iStart) * -1;
        }

        var potentialIEnd = calcEndNumber + after;
        if (potentialIEnd > iEnd)
        {
            after += iEnd - potentialIEnd;
            before += (iEnd - potentialIEnd) * -1;
        }

        potentialIStart = Model.PageNumber - before;
        potentialIEnd = Model.PageNumber + after;

        iStart = potentialIStart > iStart ? potentialIStart : iStart;
        iEnd = potentialIEnd < iEnd ? potentialIEnd : iEnd;
    }

    var itemsPerPageOptions = new int[] { 10, 25, 50, 100, 250, 500, 1000 };

    if (Model.TotalCount > 1)
    {
        var itemsPerPageFullUrl = pageUrl + (!pageUrl.Contains("?") ? "?" : "&") + "pn=1";
        var pageSelectFullUrl = pageUrl + (!pageUrl.Contains("?") ? "?" : "&") + "pn={0}&rpp=" + Request["rpp"];

        <div class="row">
            <div class="col-md-2">
                <div class="padding-10">
                    Showing @Model.StartingRecord - @Model.EndingRecord of @Model.TotalCount
                </div>
            </div>

            <div class="col-md-4">
                <form class="form-inline">
                    <select class="form-control form-control-sm" name="rpp" id="rpp" onchange="location.href='@itemsPerPageFullUrl&rpp='+this.value;">
                        @foreach (var x in itemsPerPageOptions.Where(x => x < Model.TotalCount))
                        {
                            <option value="@x" @(Request["rpp"] == x.ToString() ? " selected=\"selected\" " : "")>@x Per Page</option>
                        }
                        <option value="@Model.TotalCount" @(Request["rpp"] == Model.TotalCount.ToString() ? " selected=\"selected\" " : "")>All</option>
                    </select>
                </form>
            </div>
        
            @if (Model.TotalPages > 1)
            {
                <div class="col-md-6">
                    <div class="btn-group pull-right">
                        <a class="btn btn-default" href="@previousLink">Previous</a>
                    
                        <a class="btn @("1" == Request["pn"] || Request["pn"].IsBlank() ? "btn-primary" : "btn-default")" href="@string.Format(pageSelectFullUrl, 1)">1</a>  
                                  
                        @if (Model.TotalPages > 2)
                        {
            if (iStart - 1 > 1)
            {
                                <a class="btn btn-default" href="@string.Format(pageSelectFullUrl, iStart - 1)">...</a>
                            }

                            for (var i = iStart; i <= iEnd; i++)
                            {
                                <a class="btn @(i.ToString() == Request["pn"] ? "btn-primary" : "btn-default")" href="@string.Format(pageSelectFullUrl, i)">@i</a>
}

                            if (Model.TotalPages - iEnd > 1)
                            {
                                <a class="btn btn-default" href="@string.Format(pageSelectFullUrl, iEnd + 1)">...</a>
                            }
                        }

                        <a class="btn @(Model.TotalPages.ToString() == Request["pn"] ? "btn-primary" : "btn-default")" href="@string.Format(pageSelectFullUrl, Model.TotalPages)">@Model.TotalPages</a>  

                        <a class="btn btn-default" href="@nextLink">Next</a>
                    </div>
                </div>
            }
        </div>
    }
}
