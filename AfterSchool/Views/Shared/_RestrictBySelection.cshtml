@{
    var restrictbygrade = (bool)ViewData["restrictbygrade"];
    var grades = (List<GradeLevel>)ViewData["grades"];
    var minGradeLevelId = (int?)ViewData["minGradeLevelId"];
    var maxGradeLevelId = (int?)ViewData["maxGradeLevelId"];

    var agestart = (int?)ViewData["agestart"];
    var ageend = (int?)ViewData["ageend"];

    if (!minGradeLevelId.HasValue && !minGradeLevelId.HasValue && !agestart.HasValue && !ageend.HasValue)
    {
        minGradeLevelId = grades.FirstOrDefault().ID.Value;
        maxGradeLevelId = grades.LastOrDefault().ID.Value;
    }
    var allAgeRegistrationEnabled = SessionVariables.AccountPackage.HasFeature(FeatureType.AllAgeRegistration);
}

@{
    Html.RenderPartial("~/Views/Shared/_RestrictionModal.cshtml", new RestrictionModalViewModel()
    {
        Title = "Age Restriction Error",
        HtmlBody = "<p>You have turned on age restrictions for this activity but your default form doesn't ask for date of birth. To enforce this restriction, we will ask registrants for date of birth during registration.</p>",
        ActionButtonHtml = "Remove Restriction",
        ActionButtonId = $"btn-age-restriction-error",
        ID = $"modal-age-restriction-error",
        OkButtonId = "modal-age-restriction-ok",
        OkButtonHtml = "Okay",
    });
}
@{
    Html.RenderPartial("~/Views/Shared/_RestrictionModal.cshtml", new RestrictionModalViewModel()
    {
        Title = "Grade Restriction Error",
        HtmlBody = "<p>You have turned on grade restrictions for this activity but your default form doesn't ask for grade. To enforce this restriction, we will ask registrants for grade during registration.</p>",
        ActionButtonHtml = "Remove Restriction",
        ActionButtonId = $"btn-grade-restriction-error",
        ID = $"modal-grade-restriction-error",
        OkButtonId = "modal-grade-restriction-ok",
        OkButtonHtml = "Okay",
    });
}

<div class="form-group">
    <label class="col-lg-3 control-label">
        Restrict by
    </label>
    <div class="col-lg-9 margin-left-sm">
        <div class="am-radio inline">
            <input type="radio" id="restrictby-grade" name="restrictbygrade" data-modal="modal-grade-restriction-error" class="form-control " value="1" @(restrictbygrade ? "checked=\"checked\"" : "") />
            <label for="restrictby-grade">Grade</label>
        </div>
        <div class="am-radio inline">
            <input type="radio" id="restrictby-age" name="restrictbygrade" data-modal="modal-age-restriction-error" class="form-control " value="0" @(!restrictbygrade ? "checked=\"checked\"" : "") />
            <label for="restrictby-age">Age</label>
        </div>
    </div>
</div>
<div id="restrictbygrade" name="restrictbygrade">
    @{
        Html.RenderPartial(
            "~/Views/Shared/_GradeRestrictions.cshtml",
            null,
            new ViewDataDictionary() {
                    { "minGradeLevelId", minGradeLevelId },
                    { "MaxGradeLevelId", maxGradeLevelId },
                    { "grades", grades },
                    { "showToggle", false } }
            );
    }
</div>

<div id="restrictbyage">
    @{
        Html.RenderPartial(
            "~/Views/Shared/_AgeRestrictions.cshtml",
            null,
            new ViewDataDictionary() {
                    { "ageStart", agestart },
                    { "ageEnd", ageend },
                    { "showToggle", false } }
            );
    }
</div>


<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $('#restrictby-grade').click(function () {
                gradeOrAgeCheck();
                if (@allAgeRegistrationEnabled.ToString().ToLower()) {
                    showRestrictionsCheck();
                }
            });
            $('#restrictby-age').click(function () {
                gradeOrAgeCheck();
                if (@allAgeRegistrationEnabled.ToString().ToLower()) {
                    validateByAge();
                }
            });
            gradeOrAgeCheck();
        }
    );

    function gradeOrAgeCheck() {
        if ($('#restrictby-grade').is(':checked')) {
            $('#restrictbyage').addClass('hide');
            $('#restrictbygrade').removeClass('hide');
        } else {
            $('#restrictbyage').removeClass('hide');
            $('#restrictbygrade').addClass('hide');
        }
    }

    function showRestrictionsCheck() {
        $('#allowRegistration').removeClass('hidden');
        if ($('#isStudentAllowed').is(':checked')) {
            $('#parentConsent').removeClass('hidden');
        } else {
            $('#parentConsent').addClass('hidden');
        }
    }

    function validateByAge() {
        if (parseInt($('#agestart').val()) >= 18) {
            $('#allowRegistration').addClass("hidden");
            $('#parentConsent').addClass("hidden");
        }
        else {
            showRestrictionsCheck();
        }
    }

</script>