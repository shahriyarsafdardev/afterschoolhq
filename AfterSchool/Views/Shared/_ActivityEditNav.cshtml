@using AfterSchool.Areas.Org.Controllers
@model Activity
@{
    string SetToActiveIfEquals(string activeMenuValue, string matchString)
    {
        return activeMenuValue.Equals(matchString, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    }

    var isActive = Model.ID.HasValue && Model.ID.Value > 0;
    var isScheduleActive = Model.ID.HasValue && Model.ID.Value > 0;
    var activeMenu = ViewData["ActiveMenu"].ToString();

    var editSetupActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditSetup);
    var editRestrictionsActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditRestrictions);
    var editDetailsActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditDetails);
    var editContactActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditContact);
    var editScheduleActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditSchedule);
    var editLocationActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditLocation);
    var editCostActive = SetToActiveIfEquals(activeMenu, EditHelpers.EditCost);
    var editConfirmationActive = SetToActiveIfEquals(activeMenu, "EditConfirmation");
}
<div id="list1" class="dd">
    <ol class="dd-list">
        <li data-id="1" class="dd-item">
            <div class="dd-handle @editSetupActive">
                <a href="@Url.Action("editsetup", "activity", new {id = Model.ID.HasValue && Model.ID > 0 ? Model.Uid.ToString() : "", isnew = Request["isnew"]})">Settings</a>
            </div>
        </li>

        @if (EditHelpers.EditSetupPagesForActivityType(Model.ActivityTypeId).Contains(EditHelpers.EditRestrictions))
        {
            <li data-id="4" class="dd-item">
                <div class="dd-handle @editRestrictionsActive">
                    @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                       {
                           {"Url", Url.Action("editrestrictions", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                           {"Text", "Restrictions"},
                           {"IsActive", isScheduleActive},
                       }); }
                </div>
            </li>
        }
        @if (EditHelpers.EditSetupPagesForActivityType(Model.ActivityTypeId).Contains(EditHelpers.EditSchedule))
        {
            <li data-id="4" class="dd-item">
                <div class="dd-handle @editScheduleActive">
                    @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                       {
                           {"Url", Url.Action("editschedule", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                           {"Text", "Schedule"},
                           {"IsActive", isActive},
                       }); }
                </div>
            </li>
        }
        @if (EditHelpers.EditSetupPagesForActivityType(Model.ActivityTypeId).Contains(EditHelpers.EditDetails))
        {
            <li data-id="2" class="dd-item">
                <div class="dd-handle @editDetailsActive">
                    @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                       {
                           {"Url", Url.Action("editdetails", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                           {"Text", "About Your " + UILabel.ActivityLabel(Model.ActivityTypeId)},
                           {"IsActive", isActive},
                       }); }
                </div>
            </li>
        }
        <li data-id="3" class="dd-item">
            <div class="dd-handle @editContactActive">
                @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                   {
                       {"Url", Url.Action("editcontact", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                       {"Text", "Contact"},
                       {"IsActive", isActive},
                   }); }
            </div>
        </li>

        @if (EditHelpers.EditSetupPagesForActivityType(Model.ActivityTypeId).Contains(EditHelpers.EditLocation))
        {
            <li data-id="4" class="dd-item">
                <div class="dd-handle @editLocationActive">
                    @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                       {
                           {"Url", Url.Action("editlocation", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                           {"Text", "Location"},
                           {"IsActive", isActive},
                       }); }
                </div>
            </li>
        }

        @if (EditHelpers.EditSetupPagesForActivityType(Model.ActivityTypeId).Contains(EditHelpers.EditCost))
        {
            <li data-id="5" class="dd-item">
                <div class="dd-handle @editCostActive">
                    @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                       {
                           {"Url", Url.Action("editcost", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                           {"Text", "Pricing & Payment"},
                           {"IsActive", isActive},
                       }); }
                </div>
            </li>
        }

        @if (!Model.ActivityGroupId.HasValue)
        {
            <li data-id="6" class="dd-item">
                <div class="dd-handle @editConfirmationActive">
                    @{ Html.RenderPartial("_ActiveLink", new ViewDataDictionary
                       {
                           {"Url", Url.Action("editconfirmation", "activity", new {id = Model.Uid.ToString(), isnew = Request["isnew"]})},
                           {"Text", "Email Content"},
                           {"IsActive", isActive},
                       }); }
                </div>
            </li>
        }
    </ol>
</div>