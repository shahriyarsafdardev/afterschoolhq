@model ModalViewModel

<div id="@Model.ID" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">@Model.Title</h3>
        </div>
        <div class="modal-body form">

            @Html.Raw(Model.HtmlBody)

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>

            @{ 
                if (Model.ActionButtonId.IsNotEmpty())
                {
                    <a class="btn btn-danger" href="#" id="@Model.ActionButtonId">@Html.Raw(Model.ActionButtonHtml)</a>
                }
            }
            
        </div>
    </div>
</div>

