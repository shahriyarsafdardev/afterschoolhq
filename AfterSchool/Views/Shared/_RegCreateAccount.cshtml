<div class="panel panel-default">
    <div class="panel-heading">
        Create Your Account
    </div>
    <div class="panel-body">
        <div class="form-group">
            <div class="col-md-6 col-md-offset-3">
                Never type in all of this information again. Creating an account will allow you to use your registration information on multiple forms. Add a password to create your @UILabel.ProductName() account.
            </div>
        </div>
        <div class="form-group">
            <label class="control-label col-md-3 text-right">Enter your password:</label>
            <div class="col-md-6">
                <input type="password" name="password" id="password" class="form-control" />
            </div>
        </div>
    </div>
</div>
