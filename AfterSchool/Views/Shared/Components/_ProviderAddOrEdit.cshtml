@{
    var providerId = (int?)ViewData["ProviderId"];
    var provider = Account.Load(providerId.Value) ?? new Account();
}

@{
    Html.RenderPartial(
        "~/Views/Shared/Components/_ProviderEdit.cshtml",
        provider
    );
}

<div id="add-location" class="hide">
    <div class="form-group">
        <label class="col-sm-3 control-label">
            Provider Name <span class="text-danger">*</span>
            <i class="s7-help1 icon-medium" data-toggle="popover" data-trigger="hover" data-content="Organization or Program name" data-placement="top"></i>
        </label>
        <div class="col-sm-9">
            <input type="text" name="providername" id="providername" value="" class="form-control" />
        </div>
    </div>

</div>