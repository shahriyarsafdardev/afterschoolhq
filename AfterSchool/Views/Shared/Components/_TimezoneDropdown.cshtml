@model string

<select name="timezone" id="timezone" class="form-control" required>
    @foreach (var zone in new[] {"Eastern - EST", "Central - CST", "Mountain - MST", "Pacific - PST", "Alaska - AKST", "Hawaii - HAST"})
    {
        var selected = "";
        if (zone == Model)
        {
            selected = " selected=\"selected\" ";
        }
        <option value="@zone" @selected>@zone</option>
    }
    @foreach (var zone in new[] {"Arabia - AST"})
    {
        if (zone == Model)
        {
            <option value="@zone" selected="selected">@zone</option>
        }
    }
</select>