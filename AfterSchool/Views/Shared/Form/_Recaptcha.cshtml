@model string
@if (Model.IsBlank())
{
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <style>
        .g-recaptcha {
            display: inline-block;
        }
    </style>
    <div class="g-recaptcha" data-sitekey="@AfterSchoolLibrary.Helpers.GoogleHelper.Recaptcha.DataSiteKey"></div>
}
else
{
    <div id="@Model"></div>

    <script>
        AHQRecaptcha.writeScriptTag();
        AHQRecaptcha.add('@Model', function () {
            return grecaptcha.render('@Model', { 'sitekey': '@AfterSchoolLibrary.Helpers.GoogleHelper.Recaptcha.DataSiteKey' });
        });
    </script>
}