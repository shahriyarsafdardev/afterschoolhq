@model FormQuestionGroup

@{ 
    var qvms = (List<FormQuestionViewModel>)ViewData["QuestionViewModels"];

    if (qvms.IsEmpty())
    {
        qvms = Model.GetActiveQuestions()
            .Select(question => question.ToFormQuestionViewModel())
            .ToList();
    }

    // var showGroup = qvms.Any(qvm => qvm.Question.QuestionTypeId != QuestionType.TextBlock);
    var showGroup = qvms.Any(qvm => qvm.Question.IsActive);
}

@if (showGroup)
{
    <div class="panel panel-default question-group">
        <div class="panel-heading">
            <div class="row">
                <div class="col-md-9 col-md-offset-3">
                    @Model.Name
                </div>
            </div>
        </div>
        <div class="panel-body">
            @foreach (var qvm in qvms)
            {
                Html.RenderPartial("~/Views/Shared/Form/_Question.cshtml", qvm);
            }
        </div>
    </div>
}
