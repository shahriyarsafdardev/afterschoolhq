@model FormQuestionViewModel
@{ 
    var data = AfterSchoolLibrary.Helpers.Utilities.GetKeyValuePairs(Model.Value);
}

<div @Html.Raw(Model.ToolTip) @Html.Raw(Model.ToolTipId)>
    @foreach (var option in Model.Question.Options.Split(','))
    {
        if (option.Contains("|"))
        {
            var splitedOptions = option.Split('|');
            var key = splitedOptions[0].Trim();
            var desc = splitedOptions[1].Trim();
            var value = new AfterSchoolLibrary.Helpers.KeyValuePair() { key = key, value = desc };
            var selected = data.Any(m => m.key == value.key) ? " checked=\"checked\" " : "";

            <div class="am-checkbox">
                <input type="checkbox" id="@Model.Id-@key" name="@Model.Name" class="form-control" @Model.RequiredProperty value="@value.ToJSON()" @selected />
                <label for="@Model.Id-@key">@desc</label>
            </div>
        }
        else
        {
            var desc = option.Trim();
            var value = new AfterSchoolLibrary.Helpers.KeyValuePair() { key = desc, value = desc };
            var selected = data.Any(m => m.key == value.key) ? " checked=\"checked\" " : "";

            <div class="am-checkbox">
                <input type="checkbox" id="@Model.Id-@desc" name="@Model.Name" class="form-control" @Model.RequiredProperty value="@value.ToJSON()" @selected />
                <label for="@Model.Id-@desc">@desc</label>
            </div>
        }
     }
</div>
