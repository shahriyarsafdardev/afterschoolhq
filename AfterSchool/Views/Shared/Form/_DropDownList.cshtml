@model FormQuestionViewModel

<div @Html.Raw(Model.ToolTip) @Html.Raw(Model.ToolTipId))>
    <select id="@Model.Id" name="@Model.Name" class="form-control" @Model.RequiredProperty>
        <option value="">Select...</option>
        @foreach (var option in Model.Question.Options.Split(','))
        {
            if (option.Contains("|"))
            {
                var splitedOptions = option.Split('|');
                var key = splitedOptions[0].Trim();
                var desc = splitedOptions[1].Trim();
                var value = new List<KeyValuePair<string, string>>() { new KeyValuePair<string, string>(key, desc) };
                var selected = Model.Value.IfEmpty("").Trim().ToLower() == value.ToJSON().ToLower() ? " selected=\"selected\" " : "";

                <option value="@value.ToJSON()" @selected>@desc</option>
            }
            else
            {
                var desc = option.Trim();
                var value = new List<KeyValuePair<string, string>>() { new KeyValuePair<string, string>(desc, desc) };
                var selected = Model.Value.IfEmpty("").Trim().ToLower() == value.ToJSON().Trim().ToLower() ? " selected=\"selected\" " : "";

                <option value="@value.ToJSON()" @selected>@desc</option>
            }
        }
    </select>
</div>
