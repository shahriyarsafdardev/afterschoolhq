@model FormQuestionViewModel

<input type="@Model.Question.QuestionTypeId.ToString().ToLower()" 
       id="@Model.Id" 
       name="@Model.Name" 
       class="form-control @ViewData["AdditionalClass"]" 
       onfocus="this.select()" 
       @Model.RequiredProperty 
       @Html.Raw(Model.ToolTip) 
       @Html.Raw(Model.ToolTipId) 
       value="@Model.Value" />
