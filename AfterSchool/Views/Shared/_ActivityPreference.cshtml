@using System.Collections.Specialized;
@model List<CartItem>

@{
    var fieldValues = (NameValueCollection)ViewData["fieldValues"];
    var registration = (Registration)ViewData["registration"];
    var addOnly = (bool)ViewData["addonly"];
}
@if (Model.Count > 1)
{
    <div class="panel panel-default">
        <div class="panel-heading">
            @UILabel.ActivityLabel() Preference
        </div>
        <div class="panel-body">

            @for (var i = 1; i <= Model.Count; i++)
            {
                var preferenceId = string.Format("preference-{0}", i);

                <div class="form-group">
                    <label class="col-md-3 control-label" for="@preferenceId">
                        Choice #@i
                    </label>
                    <div class="col-md-6">
                        <select name="@preferenceId" id="@preferenceId" class="form-control activity-preference" required>
                            <option value="">Select Choice...</option>
                            @foreach (var item in Model)
                            {
                                var readonlystr = "";
                                var selected = "";

                                if (fieldValues[preferenceId].IsNotBlank() && addOnly)
                                {
                                    readonlystr = "readonly=\"readonly\"";
                                }
                                if (item.ActivityId.ToString() == fieldValues[preferenceId])
                                {
                                    selected = "selected=\"selected\" ";
                                }
                                <option value="@item.ActivityId" @readonlystr @selected>
                                    @item.GetActivity().Name - @item.GetActivity().GetDaysOfTheWeek().Select(x => x.ToString()).ToStringList(", ")
                                </option>
                            }
                        </select>
                    </div>
                </div>
            }

