@model List<ActivityMessage>

@{
    var sendNewLink = (string)ViewData["SendNewMessageLink"];
    var viewController = (string)ViewData["ViewLinkController"];
    var viewAction = (string)ViewData["ViewLinkAction"];
    var viewId = (string)ViewData["ViewLinkId"];
    var account = (Account)ViewData["Account"];
    var paging = (PagingModel)ViewData["PagingModel"];
    var showAddMessage = true;

    if (ViewData["ShowAddMessage"] != null && ViewData["ShowAddMessage"].ToString().IsBoolean())
    {
        showAddMessage = ViewData["ShowAddMessage"].ToString().ToBoolean();
    }

    var accountPackage = SessionVariables.AccountPackage;
    var showEmail = accountPackage.HasFeature(FeatureType.EmailMessaging);
    var showText = accountPackage.HasFeature(FeatureType.TextMessaging);
    var maxMessageCount = accountPackage.HasFeature(FeatureType.TextMessaging) ? (int)accountPackage.GetFeature(FeatureType.TextMessaging).Max.Value : 0;

    var showFormFields = (paging.IsEmpty() ? 0 : paging?.TotalCount ?? 0) >= maxMessageCount ? false : true;
    var messagingPackage = PackageService.GetPackageWithAnyFeaturesLowestPrice(new List<FeatureType>() { FeatureType.EmailMessaging, FeatureType.TextMessaging });
}

@if (showAddMessage)
{
    <div class="row">
        <div class="col-md-12">
            @if (showEmail || showText)
            {
                <a href="@sendNewLink" class="btn btn-primary btn-space"><i class="icon icon-left s7-paper-plane"></i> Send New Message</a>
            }
            else
            {
                <a href="#" class="btn btn-primary btn-space" onclick="return showUpgradeMyPlan('@(messagingPackage.Name)',@(messagingPackage.ID))"><i class="icon icon-left s7-paper-plane"></i> Send New Message</a>
            }

        </div>
    </div>
}
<div class="table-responsive">
    <table class="table table-hover">
        <thead>
            <tr>
                <th></th>
                <th>Sent By</th>
                <th>Date Sent</th>
                <th>Subject</th>
                <th># Sent</th>
                <th># Unsent</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count() > 0)
            {
                foreach (var message in Model)
                {
                    <tr>
                        <td><a href="@Url.Action("messagedetail", viewController, new { id = message.Uid })" class="btn btn-primary btn-sm">View</a></td>
                        <td>@message.GetCreatedBy().DisplayName</td>
                        <td>@(message.DateSent.HasValue ? account.ConvertToAccountTimeZone(message.DateSent.Value).ToLongDateTimeString() : "N/A")</td>
                        <td>@message.Subject</td>
                        <td>@message.GetSentCount()</td>
                        <td>@message.GetUnsentCount()</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">You haven't sent any messages to your @UILabel.RegistrantLabel(true).ToLower()</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@{ 
    Html.RenderPartial(
        "~/Views/Shared/_Paging.cshtml",
        paging,
        new ViewDataDictionary()
        {
            { "id", viewId },
            { "action", viewAction },
            { "controller", viewController }
        }
    );
}
