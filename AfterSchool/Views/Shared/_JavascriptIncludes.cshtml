@if (AfterSchoolLibrary.Helpers.Utilities.IsProduction && SessionVariables.OriginalLoggedInUser.IsEmpty() && (SessionVariables.CurrentAccount.IsEmpty() || SessionVariables.CurrentAccount.AccountTypeId != AccountType.AfterSchool))
{
    <script>
        @if (SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentAccount.IsNotEmpty())
        {
            @:smartlook('identify', '@SessionVariables.CurrentUser.Uid', {
            @:    "name": "@SessionVariables.CurrentUser.DisplayName",
            @:    "email": "@SessionVariables.CurrentUser.Email",
            @:    "userType": "@SessionVariables.AccountUserType.ToString()",
            @:    "accountType": "@SessionVariables.CurrentAccount.AccountTypeId.ToString()",
            @:    "account": "@SessionVariables.CurrentAccount.Name"
            @:    });
        }
    </script>
}
