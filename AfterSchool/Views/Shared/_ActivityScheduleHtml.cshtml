@model ActivitySchedule
@{ 
    var instances = Model.GetInstances();
}
@if (Model.RepeatsWeekly)
{
    <span>
        We will meet from <strong>@Model.DailyStartTime.ToShortTimeString()</strong> to <strong>@Model.DailyEndTime.ToShortTimeString()</strong> every <strong>@Model.GetDaysOfTheWeek().OrderBy(x => (int)x).Select(x => x.ToString().MaxChars(3)).ToStringList(", ", ", & ")</strong> starting <strong>@Model.StartDate.ToShortDateString()</strong> 
        
        @if (!Model.IsOngoing)
        {
            <span>and ending on <strong>@Model.EndDate.ToShortDateString()</strong></span>
        }
        
        <br />

        @if (instances.Where(instance => instance.InstanceTypeId == InstanceType.OutOfSession).Any())
        {   <br />
            <span>
                We will <strong><em>not</em></strong> meet on the following dates: @instances.Where(instance => instance.InstanceTypeId == InstanceType.OutOfSession).Select(range => range.StartDateTime.ToShortDateString()).ToStringList(", ")
            </span>
        }

        
    </span>

}
else
{
    <table class="table table-condensed">
        <thead>
            <tr>
                <th>Date</th>
                <th>Day</th>
                <th>From</th>
                <th>To</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var instance in instances)
            {
                <tr>
                    <td>@instance.StartDateTime.Value.ToString("M/d/yy")</td>
                    <td>@instance.StartDateTime.Value.DayOfWeek.ToString().MaxChars(2)</td>
                    <td>@instance.StartDateTime.ToShortTimeString()</td>
                    <td>@instance.EndDateTime.ToShortTimeString()</td>
                </tr>
            }
        </tbody>
    </table>
}
