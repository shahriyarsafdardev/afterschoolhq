@{
    var agestart = (int?)ViewData["agestart"] ?? 0;
    var ageend = (int?)ViewData["ageend"] ?? 18;
    var showToggle = true;
    var showToggleUpdated = false;

    if ((bool)ViewData["showToggle"].IsNotEmpty())
    {
        showToggle = (bool)ViewData["showToggle"];
        showToggleUpdated = true;
    }

}
<div class="form-group">
    <label class="col-lg-3 control-label">
        Age Restrictions
    </label>
    <div class=@(showToggle ? "col-md-1": "")>
        @{Html.RenderPartial
              (
                  "~/Views/Shared/_SwitchButton.cshtml",
                  agestart.IsEmpty() || ageend.IsEmpty() || (showToggleUpdated && !showToggle),
                  new ViewDataDictionary()
                  {
                { "checkboxname", "agerestrictions" },
                { "checkboxid", "agerestrictions" },
                { "disabled", false },
                { "hidden", showToggle ? "" : "hide" }
                  }
              );
        }
    </div>
    <div class="col-lg-9" id="age">
        <select id="agestart" name="agestart" class="form-control">
            @for (int i = 0; i <= 18; i++)
            {
                <option value="@i" @(agestart == i ? " selected=\"selected\" " : "")>@i</option>
            }
        </select>
        <p class="margin-v-10">
            To
        </p>
        <select id="ageend" name="ageend" class="form-control">
            @for (int i = 0; i <= 100; i++)
            {
                <option value="@i" @(ageend == i ? " selected=\"selected\" " : "")>@i</option>
            }
        </select>
    </div>
</div>


<script>
    PageEvent.add(
        PageEvent.AFTER_INIT,
        function () {
            $('#agerestrictions').click(function () {
                ageCheck();
            });

            $('#agestart').change(function () {
                if (parseInt($(this).val()) > parseInt($('#ageend').val())) {
                    $('#ageend').val($(this).val());
                }
            });

            $('#ageend').change(function () {
                if (parseInt($(this).val()) < parseInt($('#agestart').val())) {
                    $('#agestart').val($(this).val());
                }
            });

            ageCheck();
        }
    );

    function ageCheck() {
        if ($('#agerestrictions').is(':checked')) {
            $('#age').removeClass('hide');
        } else {
            $('#age').addClass('hide');
        }
    }
</script>