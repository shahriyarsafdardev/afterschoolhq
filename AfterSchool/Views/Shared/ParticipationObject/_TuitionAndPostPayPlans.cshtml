@model ParticipationObject

@{
    var displayCheckoutPrice = false;

    if (ViewData["DisplayCheckoutPrice"] != null && ViewData["DisplayCheckoutPrice"].ToString().IsBoolean())
    {
        displayCheckoutPrice = ViewData["DisplayCheckoutPrice"].ToString().ToBoolean();
    }

    var billingPeriod = Model.PostPayPlans.FirstOrDefault()?.BillingPeriodTypeId.ToString().ToLower();

    var youOrProvider = "you";
    var currentAccount = SessionVariables.CurrentAccount;

    if (Model.IsActivity() && Model.GetActivity().ProviderAccountId.HasValue && Model.GetActivity().ProviderAccountId != currentAccount?.ID)
    {
        youOrProvider = Model.GetActivity().GetProvider().Name;
    }

}

<p>    
    @if (!Model.IsRegistrationFree)
    {
        <span>Cost to register is @ParticipationObjectUI.PrintRegistrationFee(Model, displayCheckoutPrice) plus</span>
    }

    @if (Model.PostPayPlans.Any())
    {
        <span>
            @if (displayCheckoutPrice)
            {
                <span>                        
                    <strong>@Model.GetPostPayCostWithConvenienceFee().ToCurrency()</strong>
                    per @billingPeriod attended per @UILabel.RegistrantLabel().ToLower()
                </span>
                if (Model.PostPayPlans.First().NumberOfPeriodsPrePaid.HasValue)
                { 
                    <span>
                        with a pre-payment of 
                        <strong>@((Model.GetPostPayCostWithConvenienceFee() * Model.PostPayPlans.First().NumberOfPeriodsPrePaid.Value).ToCurrency())</strong>
                    </span>
                }
            }
            else
            {
                <span>
                    Parents will pay <strong>@Model.GetPostPayCostWithConvenienceFee().ToCurrency()</strong> 
                    @if (Model.PostPayPlans.First().NumberOfPeriodsPrePaid.HasValue)
                    { 
                <span>
                    with a pre-payment of <strong>@((Model.GetPostPayCostWithConvenienceFee() * Model.PostPayPlans.First().NumberOfPeriodsPrePaid.Value).ToCurrency())</strong>
                </span>
                    }
                    and @youOrProvider will receive
                    <strong>@Model.GetPostPayProviderAmount().ToCurrency()</strong>
                    per @billingPeriod attended per @UILabel.RegistrantLabel().ToLower()
                </span>
                    
            }
        </span>
    }

</p>