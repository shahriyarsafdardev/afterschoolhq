@model ParticipationObjectViewModel

@{
    var billingPeriod = Model.ParticipationObject.PostPayPlans.FirstOrDefault()?.BillingPeriodTypeId.ToString().ToLower();

    var youOrProvider = "You";
    var currentAccount = SessionVariables.CurrentAccount;

    if (Model.ParticipationObject.IsActivity() && Model.ParticipationObject.GetActivity().ProviderAccountId.HasValue &&
        Model.ParticipationObject.GetActivity().ProviderAccountId != currentAccount?.ID)
    {
        youOrProvider = Model.ParticipationObject.GetActivity().GetProvider().Name;
    }

}

<p>
    @if (!Model.ParticipationObject.IsRegistrationFree)
    {
        <span>Cost to register is @ParticipationObjectUI.PrintRegistrationFee(Model.ParticipationObject, Model.IsCheckoutCost) plus</span>
    }

    @if (Model.ParticipationObject.PostPayPlans.Any())
    {
        <span>
            @{
                var firstPostPayPlanHasNumberOfPrePaidPeriods = Model.ParticipationObject.PostPayPlans.First().NumberOfPeriodsPrePaid.HasValue;
                var prePaymentAmount = (Model.ParticipationObject.GetPostPayCostWithConvenienceFee() * Model.ParticipationObject.PostPayPlans.First().NumberOfPeriodsPrePaid.Value).ToCurrency();
                var prePaymentProviderAmount = (Model.ParticipationObject.GetPostPayProviderAmount() * Model.ParticipationObject.PostPayPlans.First().NumberOfPeriodsPrePaid.Value).ToCurrency();
                var prepaymentText1 = "";
                var prepaymentText2 = "";
                var prepaymentText3 = "";
                if (firstPostPayPlanHasNumberOfPrePaidPeriods)
                {
                    var noOfPeriodsPrepaid = Model.ParticipationObject.PostPayPlans.First().NumberOfPeriodsPrePaid.Value;
                    prepaymentText1 = $"<span> with a pre-payment of <strong>{prePaymentAmount}</strong></span>";
                    prepaymentText2 = $"<span><strong>{prePaymentProviderAmount}</strong> as pre-payment and then</span>"; //$57 as pre-payment and then 
                    prepaymentText3 = $"after {noOfPeriodsPrepaid} {billingPeriod}";
                    if (noOfPeriodsPrepaid > 1)
                    {
                        prepaymentText3 += "s";
                    }
                }

            }
            @if (Model.IsCheckoutCost)
            {
                <span>
                    <strong>@Model.ParticipationObject.GetPostPayCostWithConvenienceFee().ToCurrency()</strong>
                    per @billingPeriod attended per @UILabel.RegistrantLabel().ToLower()
                </span>
                if (firstPostPayPlanHasNumberOfPrePaidPeriods)
                {
                    <span>
                        with a pre-payment of <strong>@prePaymentAmount</strong>
                    </span>
                }
            }
            else
            {
                <span>
                    Parents will pay <strong>@Model.ParticipationObject.GetPostPayCostWithConvenienceFee().ToCurrency()</strong>
                    @Html.Raw(prepaymentText1). @youOrProvider will receive @Html.Raw(prepaymentText2)
                    <strong>@Model.ParticipationObject.GetPostPayProviderAmount().ToCurrency()</strong>
                    per @billingPeriod attended per @(UILabel.RegistrantLabel().ToLower()) @prepaymentText3.
                </span>
            }
        </span>
    }

</p>