@model ParticipationObject

<h3>
    @{ Html.RenderPartial("ParticipationObject/_FreeTuition", Model); }
</h3>

@if (!Model.IsFree)
{
    if (Model.PostPayPlans.IsNotEmpty() && Model.PostPayPlans.Any())
    {
        Html.RenderPartial("ParticipationObject/_TuitionAndPostPayPlans", new ParticipationObjectViewModel
        {
            IsCheckoutCost = true,
            ParticipationObject = Model,
        });
    }
    else if (Model.SubscriptionPlans.IsNotEmpty() && Model.SubscriptionPlans.Any())
    {
        Html.RenderPartial("ParticipationObject/_SubscriptionPlan", new ParticipationObjectViewModel
        {
            IsCheckoutCost = true,
            ParticipationObject = Model,
        });
    }
    else if (Model.PaymentPlans.IsNotEmpty() && Model.PaymentPlans.Any())
    {
        Html.RenderPartial("ParticipationObject/_TuitionAndPaymentPlans", new ParticipationObjectViewModel
        {
            IsCheckoutCost = true,
            ParticipationObject = Model,
        });
    }
    else
    {
        Html.RenderPartial("ParticipationObject/_TuitionAndNoPaymentPlans", new ParticipationObjectViewModel
        {
            IsCheckoutCost = true,
            ParticipationObject = Model,
        }, new ViewDataDictionary{{"CurrentAccount", SessionVariables.CurrentAccount}});
    }
}
