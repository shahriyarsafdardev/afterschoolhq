@model ParticipationObject

<h3>
    @{ Html.RenderPartial("~/Views/Shared/ParticipationObject/_FreeTuition.cshtml", Model); }
</h3>

@if (!Model.IsFree)
{
    if (Model.PostPayPlans.IsNotEmpty() && Model.PostPayPlans.Any())
    {
        Html.RenderPartial(
            "~/Views/Shared/ParticipationObject/_TuitionAndPostPayPlans.cshtml",
            Model,
            new ViewDataDictionary() { { "DisplayCheckoutPrice", true } });
    }
    else if (Model.SubscriptionPlans.IsNotEmpty() && Model.SubscriptionPlans.Any())
    {
        Html.RenderPartial(
          "~/Views/Shared/ParticipationObject/_SubscriptionPlan.cshtml",
          Model,
          new ViewDataDictionary() { { "DisplayCheckoutPrice", true } });
    }
    else if (Model.PaymentPlans.IsNotEmpty() && Model.PaymentPlans.Any())
    {
        Html.RenderPartial(
            "~/Views/Shared/ParticipationObject/_TuitionAndPaymentPlans.cshtml",
            Model,
            new ViewDataDictionary() { { "DisplayCheckoutPrice", true } });
    }
    else
    {
        Html.RenderPartial(
            "~/Views/Shared/ParticipationObject/_TuitionAndNoPaymentPlans.cshtml",
            Model,
            new ViewDataDictionary() { { "DisplayCheckoutPrice", true } });
    }

    if (Model.CostDescription.IsNotEmpty())
    {
        <p class="padding-v-10">
            @Model.CostDescription
        </p>
    }
}
