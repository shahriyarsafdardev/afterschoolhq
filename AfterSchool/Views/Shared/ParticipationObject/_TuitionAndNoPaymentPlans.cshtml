@model ParticipationObject

<p>
    The tuition fee is <strong>@Model.GetCheckoutTotalCost().ToCurrency()</strong>
    @if (Model.SubscriptionPlans.Any())
    {
        <span>
            plus <strong>@Model.SubscriptionPlans.First().CostPerPeriod.ToCurrency()</strong> each @Model.SubscriptionPlans.First().BillingPeriodTypeId.ToString().ToLower()
        </span>
    }
</p>
