@model ParticipationObject

@{ 
    var displayCheckoutPrice = false;

    if (ViewData["DisplayCheckoutPrice"] != null && ViewData["DisplayCheckoutPrice"].ToString().IsBoolean())
    {
        displayCheckoutPrice = ViewData["DisplayCheckoutPrice"].ToString().ToBoolean();
    }
}

<p>
    @if (!Model.IsRegistrationFree)
    {
        <span>
            The registration fee is
            <strong>
                @ParticipationObjectUI.PrintRegistrationFee(Model, displayCheckoutPrice)
            </strong>
        </span>
    }    

    @{ Html.RenderPartial(
        "~/Views/Shared/ParticipationObject/_SubscriptionPlan.cshtml",
        Model,
        new ViewDataDictionary() { { "DisplayCheckoutPrice", displayCheckoutPrice } }); 
    }
</p>
