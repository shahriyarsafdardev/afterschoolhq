@model ParticipationObjectViewModel

@{
    var currentAccount = (Account) ViewData["CurrentAccount"];
    var isActivityLeader = (bool?)ViewData["isActivityLeader"] ?? false;

    var youOrProvider = Model.ParticipationObject.IsActivity() && Model.ParticipationObject.GetActivity().ProviderAccountId.HasValue && Model.ParticipationObject.GetActivity().ProviderAccountId != currentAccount?.ID ? Model.ParticipationObject.GetActivity().GetProvider().Name : "you";
}

<p>
    @if (Model.ParticipationObject.SubscriptionPlans.Any())
    {
        if (Model.IsCheckoutCost)
        {
            <span>The cost is</span>
        }
        else
        {
            <span>@youOrProvider.ToProperCase() will receive</span>
        }
    }

    @if (!Model.ParticipationObject.IsRegistrationFree)
    {
        <span>
            @if (!Model.ParticipationObject.SubscriptionPlans.Any())
            { 
                if (Model.IsCheckoutCost)
                {
                    <span>The fee is</span>
                }
                else
                {
                    <span>@youOrProvider.ToProperCase() will receive</span>
                }
            }
            
            <strong>
                @((isActivityLeader ? Model.ParticipationObject.Cost - Model.ParticipationObject.GetConvenienceFee() : 
                    Model.ParticipationObject.Cost).ToCurrency())
            </strong>
            
            @if (!Model.ParticipationObject.SubscriptionPlans.Any())
            {
                <span>
                    per                     
                    @if (Model.ParticipationObject.IsActivity() && Model.ParticipationObject.GetActivity().CostFrequencyTypeId == ActivityCostFrequencyType.PerClass)
                    {
                        <span>selected date</span>
                    }
                    else
                    {
                        <span>registration</span>
                    }
                </span>
            }

        </span>
    }    

    @{ Html.RenderPartial("ParticipationObject/_SubscriptionPlan", Model,new ViewDataDictionary { { "isActivityLeader", isActivityLeader } }); }
</p>