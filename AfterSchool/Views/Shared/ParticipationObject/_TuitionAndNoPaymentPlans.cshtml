@model ParticipationObject

@{ 
    var displayCheckoutPrice = false;

    if (ViewData["DisplayCheckoutPrice"] != null && ViewData["DisplayCheckoutPrice"].ToString().IsBoolean())
    {
        displayCheckoutPrice = ViewData["DisplayCheckoutPrice"].ToString().ToBoolean();
    }
}

<p>
    @if (!Model.IsTuitionFree)
    {
        <span>
            The tuition fee is
            <strong>
                @ParticipationObjectUI.PrintTuitionFee(Model, displayCheckoutPrice)
            </strong>
        </span>
    }    

    @if (Model.SubscriptionPlans.Any())
    {
        <span>
            @if (!Model.IsTuitionFree)
            {
                <span>plus</span>
            }            
            <strong>
                @ParticipationObjectUI.PrintPlanFee(Model.SubscriptionPlans.First(), Model.OwnerAccount, displayCheckoutPrice)
            </strong> 
            each 
            @Model.SubscriptionPlans.First().BillingPeriodTypeId.ToString().ToLower()
        </span>
    }
</p>
