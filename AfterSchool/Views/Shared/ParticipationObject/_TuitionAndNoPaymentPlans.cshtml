@model ParticipationObjectViewModel

@{
    var currentAccount = (Account) ViewData["CurrentAccount"];

    var youOrProvider = Model.ParticipationObject.IsActivity() && Model.ParticipationObject.GetActivity().ProviderAccountId.HasValue && Model.ParticipationObject.GetActivity().ProviderAccountId != currentAccount?.ID ? Model.ParticipationObject.GetActivity().GetProvider().Name : "you";
}

<p>
    @if (Model.ParticipationObject.SubscriptionPlans.Any())
    {
        if (Model.IsCheckoutCost)
        {
            <span>The cost is</span>
        }
        else
        {
            var subscriptionPlan = Model.ParticipationObject.SubscriptionPlans.FirstOrDefault();
            if (!Model.ParticipationObject.IsRegistrationFree)
            {
                <span>One-time fee of <strong>@Model.ParticipationObject.Cost.ToCurrency()</strong> plus <strong>@subscriptionPlan.CostPerPeriod.ToCurrency()
                    </strong> every <strong>@subscriptionPlan.BillingPeriodTypeId.ToString().SplitByUpperCase().ToLower()</strong></span>
            }
            else
            {
                <span>@subscriptionPlan.BillingPeriodTypeId.ToString().SplitByUpperCase()ly payment of 
                    <strong>@subscriptionPlan.CostPerPeriod.ToCurrency()</strong></span>
            }
            <span>(@youOrProvider will receive</span>
        }
    }

    @if (!Model.ParticipationObject.IsRegistrationFree)
    {
        <span>
            @if (!Model.ParticipationObject.SubscriptionPlans.Any())
            { 
                if (Model.IsCheckoutCost)
                {
                    <span>The fee is</span>
                }
                else
                {
                    <span>One-time fee of <strong>@Model.ParticipationObject.Cost.ToCurrency()</strong> (@youOrProvider will receive</span>
                }
            }
            
            <strong>
                @((Model.ParticipationObject.Cost - (Model.IsCheckoutCost ? 0 : Model.ParticipationObject.GetConvenienceFee())).ToCurrency())
            </strong>
            @if (!Model.ParticipationObject.SubscriptionPlans.Any())
            {
                <span>
                    per                     
                    @if (Model.ParticipationObject.IsActivity() && Model.ParticipationObject.GetActivity().CostFrequencyTypeId == ActivityCostFrequencyType.PerClass)
                    {
                        <span>selected date</span>
                    }
                    else
                    {
                        <span>registration@(!Model.IsCheckoutCost ? ")" : "")</span>
                    }
                </span>
            }
            else
            {
                @(Model.IsCheckoutCost ? "" : " per registration ")
            }

        </span>
    }    

    @{ Html.RenderPartial("ParticipationObject/_SubscriptionPlan", Model); }
</p>