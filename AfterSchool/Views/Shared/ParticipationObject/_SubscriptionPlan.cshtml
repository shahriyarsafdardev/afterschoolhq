@model ParticipationObjectViewModel
@if (Model.ParticipationObject.SubscriptionPlans.Any())
{
    var subscriptionPlan = Model.ParticipationObject.SubscriptionPlans.First();
    <span>
        @if (!Model.ParticipationObject.IsRegistrationFree)
        {
            if (Model.IsCheckoutCost)
            {
                <span>Pay</span> <strong>@Model.ParticipationObject.Cost.ToCurrency()</strong> <span>today </span>
            }
            <span>plus</span>
        }
        <span>
        <strong>@((subscriptionPlan.CostPerPeriod - (Model.IsCheckoutCost ? 0 :
                    subscriptionPlan.GetConvenienceFee(Model.ParticipationObject.OwnerAccount))).ToCurrency())</strong>
        every
        <strong>@subscriptionPlan.BillingPeriodTypeId.ToString().SplitByUpperCase().ToLower()</strong>

        @if (subscriptionPlan.StartDate.HasValue)
        {
            <span>starting on <strong>@subscriptionPlan.StartDate.ToShortDateString()</strong></span>
        }

        @if (subscriptionPlan.EndDate.HasValue)
        {
            if (subscriptionPlan.StartDate.HasValue)
            {
                <span> and </span>
            }

            <span>ending on <strong>@subscriptionPlan.EndDate.ToShortDateString()</strong></span>
        }
        </span>

        @if (subscriptionPlan.RegFeeAsDownPayment && !Model.ParticipationObject.IsRegistrationFree)
        {
            <span><br /><br />The registration fee will count towards @(Model.IsCheckoutCost ? "your" : "the") subscription payments</span>
        }
    </span>
}