@model ParticipationObject

@{
    var displayCheckoutPrice = false;

    if (ViewData["DisplayCheckoutPrice"] != null && ViewData["DisplayCheckoutPrice"].ToString().IsBoolean())
    {
        displayCheckoutPrice = ViewData["DisplayCheckoutPrice"].ToString().ToBoolean();
    }
}

@if (Model.SubscriptionPlans.Any())
{
    var subscriptionPlan = Model.SubscriptionPlans.First();
<span>
    @if (!Model.IsRegistrationFree)
    {
        <span>Pay</span> <strong>@Model.Cost.ToCurrency()</strong> <span>today plus</span>
    }

    @if (subscriptionPlan.SplitCostEvenly)
    {
        @*<span>
                between <strong>@ParticipationObjectUI.PrintMinPlanFee(subscriptionPlan, Model.OwnerAccount, displayCheckoutPrice)</strong> and <strong>@ParticipationObjectUI.PrintMaxPlanFee(subscriptionPlan, Model.OwnerAccount, displayCheckoutPrice)</strong>
            </span>*@
        <span>
            a fee to be determined after all students are registered
        </span>
    }
    else
    {
        <span>
            <strong>@ParticipationObjectUI.PrintPlanFee(subscriptionPlan, Model.OwnerAccount, displayCheckoutPrice)</strong>
            every
            <strong>@Model.SubscriptionPlans.First().BillingPeriodTypeId.ToString().SplitByUpperCase().ToLower()</strong>
        </span>
    }


    @*
        @if (subscriptionPlan.SplitCostEvenly)
        {
            <span>with <strong>@(Model.MinSeatsRequired ?? 1)</strong> to <strong>@Model.SeatsAvailable</strong> students attending</span>
            <span><br /><br />Final cost will be determined once all students are registered</span>
        }
    *@

    @if (subscriptionPlan.RegFeeAsDownPayment && !Model.IsRegistrationFree)
    {
        <span><br /><br />The registration fee will count towards @(displayCheckoutPrice ? "your" : "the") subscription payments</span>
    }
</span>
}

@helper PrintPlanFee(SubscriptionPlan plan, Account ownerAccount, bool displayCheckoutPrice)
{
    if (displayCheckoutPrice)
    {
        @plan.GetTotalCostWithConvenienceFee(ownerAccount).ToCurrency();
    }

    @plan.CostPerPeriod.ToCurrency();
}
