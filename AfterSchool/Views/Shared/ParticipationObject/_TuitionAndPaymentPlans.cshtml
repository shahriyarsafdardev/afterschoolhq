@model ParticipationObject

@{
    var displayCheckoutPrice = false;

    if (ViewData["DisplayCheckoutPrice"] != null && ViewData["DisplayCheckoutPrice"].ToString().IsBoolean())
    {
        displayCheckoutPrice = ViewData["DisplayCheckoutPrice"].ToString().ToBoolean();
    }
}

<p>
    Registration Fee payment options:
    <ul>
        @if (!Model.IsRegistrationFree)
        {
        <li>
            1 payment of             
             @ParticipationObjectUI.PrintRegistrationFee(Model, displayCheckoutPrice)@(Model.PaymentPlans.Any() ? ", or " : "")
        </li>
        }
        @foreach (var plan in Model.PaymentPlans)
        {
            <li>
                @plan.TotalPeriods payments of
                @ParticipationObjectUI.PrintPlanFee(plan, Model.OwnerAccount, displayCheckoutPrice)

                @if (plan.TotalPeriods > 1)
                {    
                    <span>each</span>
                    @plan.BillingPeriodTypeId.ToString().ToLower() @(plan.ID != Model.PaymentPlans.Last().ID ? ", or " : "")
                }
            </li>
        }
    </ul>
</p>

<p>
    @{ Html.RenderPartial(
          "~/Views/Shared/ParticipationObject/_SubscriptionPlan.cshtml",
          Model,
          new ViewDataDictionary() { { "DisplayCheckoutPrice", displayCheckoutPrice } });
    }
</p>