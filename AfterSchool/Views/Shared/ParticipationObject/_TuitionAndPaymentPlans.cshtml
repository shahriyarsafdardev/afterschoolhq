@model ParticipationObjectViewModel
<p>
    <ul>
        @if (!Model.ParticipationObject.IsRegistrationFree)
        {
        <li>
            1 payment of
            @Html.Raw(ParticipationObjectUI.PrintRegistrationFee(Model.ParticipationObject, Model.IsCheckoutCost))
            @(Model.ParticipationObject.PaymentPlans.Any() ? ", or " : "")
        </li>
        }
        @foreach (var plan in Model.ParticipationObject.PaymentPlans)
        {
            <li>
                @plan.TotalPeriods payments of
                <strong>@ParticipationObjectUI.PrintPlanFee(plan, Model.ParticipationObject.OwnerAccount, Model.IsCheckoutCost)</strong>

                @if (plan.TotalPeriods > 1)
                {    
                    <span>every</span>
                    @plan.BillingPeriodTypeId.ToString().SplitByUpperCase().ToLower() @(plan.ID != Model.ParticipationObject.PaymentPlans.Last().ID ? ", or " : "")
                    @Html.Raw(Model.IsCheckoutCost ? "" : 
                        $" (you will receive <strong>{(plan.CostPerPeriod - plan.GetConvenienceFee(null)).ToCurrency()}</strong> per payment)")
                }
            </li>
        }
    </ul>
</p>

<p>
    @{ Html.RenderPartial("ParticipationObject/_SubscriptionPlan", Model); }
</p>