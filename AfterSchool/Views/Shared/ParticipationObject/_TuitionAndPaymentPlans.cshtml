@model ParticipationObjectViewModel
<p>
    Registration Fee payment options:
    <ul>
        @if (!Model.ParticipationObject.IsRegistrationFree)
        {
        <li>
            1 payment of
            @ParticipationObjectUI.PrintRegistrationFee(Model.ParticipationObject, Model.IsCheckoutCost)@(Model.ParticipationObject.PaymentPlans.Any() ? ", or " : "")
        </li>
        }
        @foreach (var plan in Model.ParticipationObject.PaymentPlans)
        {
            <li>
                @plan.TotalPeriods payments of
                @ParticipationObjectUI.PrintPlanFee(plan, Model.ParticipationObject.OwnerAccount, Model.IsCheckoutCost)

                @if (plan.TotalPeriods > 1)
                {    
                    <span>every</span>
                    @plan.BillingPeriodTypeId.ToString().SplitByUpperCase().ToLower() @(plan.ID != Model.ParticipationObject.PaymentPlans.Last().ID ? ", or " : "")
                }
            </li>
        }
    </ul>
</p>

<p>
    @{ Html.RenderPartial("ParticipationObject/_SubscriptionPlan", Model); }
</p>