@model ParticipationObject

<p>
    Tuition Fee payment options:
    <ul>
        <li>
            1 payment of @ParticipationObjectUI.PrintTuitionFee(Model)@(Model.PaymentPlans.Any() ? ", or " : "")
        </li>
        @foreach (var plan in Model.PaymentPlans)
        {
            <li>
                @plan.TotalPeriods payments of
                @plan.CostPerPeriod.ToCurrency() each
                @plan.BillingPeriodTypeId.ToString().ToLower()@(plan.ID != Model.PaymentPlans.Last().ID ? ", or " : "")
            </li>
        }
    </ul>
</p>
