@{
    var neighborhoods = ViewBag.Neighborhoods != null ? (List<string>)ViewBag.Neighborhoods : null;
    var grades = (List<GradeLevel>)ViewBag.Grades;

    var totalGradeCount = grades.Count;
    var firstHalf = totalGradeCount / 2;
    var secondHalf = totalGradeCount - firstHalf;

    var services = AfterSchoolLibrary.Helpers.ProfileHelper.ServicesOfferings;
    var timing = AfterSchoolLibrary.Helpers.ProfileHelper.OfferingTimes;
    var pricingOptions = AfterSchoolLibrary.Helpers.ProfileHelper.PricingOptions;
    var specialNeeds = AfterSchoolLibrary.Helpers.ProfileHelper.SpecialNeedsOfferings;
}

<div style="text-align: center; text-decoration: underline;">
    <a id="clear-filters" href="#" style="display: none;" onclick="return clearFilters();">Clear Filters</a>
    <div class="clearfix"></div>
</div>

<div class="mr-3">
    <h4 class="filter-header">Find programs nearby</h4>
    <div class="input-group has-search">
        <input id="txtZipCode" type="text" class="form-control" name="zipcode" placeholder="Enter your school or Zip Code" />
        <div id="divValidatePostalCode" class="input-group-addon" onclick="return validatePostalCodeAndSearch();">
            <span class="input-group-text" style="font-size: 12px;">Update</span>
        </div>
    </div>    
</div>
<div class="filter-end-line"></div>

@if (neighborhoods.IsNotEmpty() && neighborhoods.Count > 0)
{
    <div id="list-neighborhoods">
        <h4 id="header-neighborhoods" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-neighborhoods" onclick="return loadTabs('neighborhoods')">Neighborhoods</h4>
        <div id="tags-container-neighborhoods"></div>

        <div id="collapse-neighborhoods" class="collapse">
            @foreach (var item in neighborhoods)
            {
                <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                    <input id="chk-neighborhoods-@(item.ToLower())" name="neighborhoods" value="@(item.ToLower())" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                    <label for="chk-neighborhoods-@(item.ToLower())" class="filter-body mobile-padding">@item</label>
                </div>
            }
        </div>
    </div>

    if (neighborhoods.Count > 5)
    {
        <p onclick="return loadMore(this, 'list-neighborhoods', '@neighborhoods.Count')" class="show-more">Show more...</p>
    }
    
    <div class="filter-end-line"></div>
}

<div>
    <h4 id="header-grades" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-grades" onclick="return loadTabs('grades')">
        Grades
    </h4>
    <div id="tags-container-grades"></div>

    <div id="collapse-grades" class="collapse">
        <div class="col-md-6 col-sm-6 col-xs-6 no-padding">
            @foreach (var item in grades.Take(firstHalf))
            {
                <div class="am-checkbox am-filter-checkbox am-generic-checkbox" style="">
                    <input id="chk-grades-@(item.ID)" name="grades" value="@(item.Name.ToLower().Replace(" ", "_"))" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                    <label for="chk-grades-@(item.ID)" class="filter-body mobile-padding">@item.Name</label>
                </div>
            }
        </div>

        <div class="col-md-6 col-sm-6 col-xs-6 no-padding">
            @foreach (var item in grades.Skip(firstHalf).Take(secondHalf))
            {
                <div class="am-checkbox am-filter-checkbox am-generic-checkbox" style="">
                    <input id="chk-grades-@(item.ID)" name="grades" value="@(item.Name.ToLower().Replace(" ", "_"))" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                    <label for="chk-grades-@(item.ID)" class="filter-body mobile-padding">@item.Name</label>
                </div>
            }
        </div>
        <div class="clearfix"></div>
    </div>
</div>
<div class="filter-end-line"></div>

<div>
    <h4 id="header-ages" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-ages" onclick="return loadTabs('ages')">Ages</h4>
    <div id="tags-container-ages"></div>

    <div id="collapse-ages" class="collapse">
        <div class="col-md-6 col-sm-6 col-xs-6 no-padding">
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-ages-1" name="ages" value="0_4" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-ages-1" class="filter-body mobile-padding">0 - 4 yrs</label>
            </div>
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-ages-2" name="ages" value="5_9" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-ages-2" class="filter-body mobile-padding">5 - 9 yrs</label>
            </div>
        </div>

        <div class="col-md-6 col-sm-6 col-xs-6 no-padding">
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-ages-3" name="ages" value="10_14" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-ages-3" class="filter-body mobile-padding">10 - 14 yrs</label>
            </div>
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-ages-4" name="ages" value="15_18" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-ages-4" class="filter-body mobile-padding">15 - 18 yrs</label>
            </div>
        </div>

        <div class="clearfix"></div>
    </div>
</div>
<div class="filter-end-line"></div>

<div class="form-group">
    <h4 id="header-gender" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-genders" onclick="return loadTabs('gender')"> Gender Restrictions</h4>
    <div id="tags-container-gender"></div>

    <div id="collapse-genders" class="collapse">
        @foreach (GenderRestrictionType item in System.Enum.GetValues(typeof(GenderRestrictionType)))
        {
            if (item != GenderRestrictionType.None)
            {
                <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                    <input id="chk-gender-@((int)item)" name="gender" value="@(item.ToString().ToLower())" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                    <label for="chk-gender-@((int)item)" class="filter-body mobile-padding"> @item.ToString().SplitByUpperCase() </label>
                </div>
            }
        }
    </div>
</div>
<div class="filter-end-line"></div>

<div id="list-services" class="form-group">
    <h4 id="header-services" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-services-offered" onclick="return loadTabs('services')">Services Offered</h4>
    <div id="tags-container-services"></div>

    <div id="collapse-services-offered" class="collapse">
        @foreach (var item in services.OrderBy(m => m))
        {
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-services-@item.ToLower()" name="services" value="@item" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-services-@item.ToLower()" class="filter-body mobile-padding">@item</label>
            </div>
        }

        <p onclick="return loadMore(this, 'list-services', '@services.Length')" class="show-more">Show more...</p>
    </div>
</div>
<div class="filter-end-line"></div>

<div id="list-timing" class="form-group">
    <h4 id="header-timing" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-timing" onclick="return loadTabs('timing')">Timing</h4>
    <div id="tags-container-timing"></div>

    <div id="collapse-timing" class="collapse">
        @foreach (var item in timing)
        {
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-timing-@item.ToLower()" name="timing" value="@item" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-timing-@item.ToLower()" class="filter-body mobile-padding">@item</label>
            </div>
        }

        <p onclick="return loadMore(this, 'list-timing', '@timing.Length')" class="show-more">Show more...</p>
    </div>
</div>
<div class="filter-end-line"></div>

<div class="form-group">
    <h4 id="header-cost" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-cost" onclick="return loadTabs('cost')">Cost</h4>
    <div id="tags-container-cost"></div>

    <div id="collapse-cost" class="collapse">
        <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
            <input id="chk-cost-1" name="cost" value="cost_free" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
            <label for="chk-cost-1" class="filter-body mobile-padding">Free</label>
        </div>

        <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
            <input id="chk-cost-2" name="cost" value="cost_0_50" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
            <label for="chk-cost-2" class="filter-body mobile-padding">Less than $50</label>
        </div>

        <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
            <input id="chk-cost-3" name="cost" value="cost_50_150" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
            <label for="chk-cost-3" class="filter-body mobile-padding">Between $50 and $150</label>
        </div>

        <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
            <input id="chk-cost-4" name="cost" value="cost_150_above" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
            <label for="chk-cost-4" class="filter-body mobile-padding">$150 and Above</label>
        </div>
    </div>
</div>
<div class="filter-end-line"></div>

<div id="list-pricing" class="form-group">
    <h4 id="header-pricing" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-pricing" onclick="return loadTabs('pricing')">Pricing options</h4>
    <div id="tags-container-pricing"></div>

    <div id="collapse-pricing" class="collapse">
        @foreach (var item in pricingOptions.OrderBy(m => m))
        {
            <div class="am-checkbox am-filter-checkbox am-generic-checkbox">
                <input id="chk-pricing-@item.ToLower()" name="pricing" value="@item" type="checkbox" class="schedulerepeat-checkbox" onclick="return checkAndSearch(this)" />
                <label for="chk-pricing-@item.ToLower()" class="filter-body mobile-padding">@item</label>
            </div>
        }
    </div>
</div>
<div class="filter-end-line"></div>

<div class="form-group">
    <h4 id="header-starting" class="filter-header accordion-toggle collapsed" data-toggle="collapse" isOpen="false" href="#collapse-starts-in" onclick="return loadTabs('starting')">Starts in</h4>
