@model AfterSchoolLibrary.Activity
@{ 
    var properties = Model.GetActivityProperties();
}

<div class="panel panel-default">
    <div class="panel-heading">
        Email Content
    </div>
    <div class="panel-body">

        @foreach (var item in properties.Select(x => x.AccountPropertyTypeId))
        {
            if(
                (item == AccountPropertyType.ApplicationThankYouEmail && Model.RegistrationModeId == RegistrationMode.Apply) || 
                (item == AccountPropertyType.RegistrationThankYouEmail && Model.RegistrationModeId == RegistrationMode.Register))
            { 
                <div class="form-group">
                    <label class="col-md-3 control-label">
                        @item.ToString().SplitByUpperCase()
                    </label>
                    <div class="col-md-9">
                        @{ Html.RenderPartial(
                                   "~/Views/Shared/_TextEditor.cshtml",
                                   properties.Find(x => x.AccountPropertyTypeId == item).Value,
                                   new ViewDataDictionary()
                                   {
                                      { "id",  @item.ToString().ToLower() },
                                      { "name",  @item.ToString().ToLower() },
                                      { "required",  true }
                                   }
                                   ); }                   
                    </div>
                </div>
            }
        }
        
    </div>
</div>
