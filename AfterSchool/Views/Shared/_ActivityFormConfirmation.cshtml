@model Activity
@{
    var properties = Model.GetActivityProperties();
}

<div class="panel panel-default panel-small-padding">
    <div class="panel-heading activity-heading">
        Email Content
    </div>
    <div class="panel-body">

        @ShowEmailContent(properties, AccountPropertyType.RegistrationThankYouEmail)

        <div class="col-md-offset-3 col-md-9 padding-v-30">
            <a onclick="ActivitySetup.showAdvancedSettings()" id="btn-advanced-settings" class="pointer">Show Advanced Settings</a>
        </div>

        <div class="hide advanced-settings">
            @ShowEmailContent(properties, AccountPropertyType.ApplicationThankYouEmail)
        </div>

    </div>
</div>

@helper ShowEmailContent(List<AccountProperty> properties, AccountPropertyType item)
{
    <div class="form-group">
        <label class="col-md-3 control-label">
            @item.ToString().SplitByUpperCase()
        </label>
        <div class="col-md-9">
            @{ Html.RenderPartial(
                   "~/Views/Shared/_TextEditor.cshtml",
                   properties.FirstOrDefault(x => x.AccountPropertyTypeId == item)?.Value,
                   new ViewDataDictionary
                   {
                       {"id", item.ToString().ToLower()},
                       {"name", item.ToString().ToLower()},
                       {"required", true},
                   }
                   ); }


            <p class="text-muted">
                <em>
                    <span>
                        This thank you message is sent when the @UILabel.ActivityLabel(Model.ActivityTypeId).ToLower() is set to
                        '@(item == AccountPropertyType.ApplicationThankYouEmail ? "Apply" : "Register")'
                        Mode.
                    </span>
                </em>
            </p>

        </div>
    </div>
}