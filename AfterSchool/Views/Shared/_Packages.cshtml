@model Account
@{
    List<Package> packages = (List<Package>)ViewBag.Packages;
    AccountPackage accountPackage = (AccountPackage)ViewBag.AccountPackage;
}

@if (accountPackage.IsEmpty())
{
    <div role="alert" class="alert alert-primary alert-icon alert-icon-color alert-dismissible">
        <div class="icon"><span class="s7-info"></span></div>
        <div class="message">
            <button type="button" data-dismiss="alert" aria-label="Close" class="close"><span aria-hidden="true" class="s7-close"></span></button>
            This account has not selected a package yet. Please select a package below
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-striped">
        <tr>
            <td></td>
            @foreach (Package package in packages)
            {
                <th class="text-center header">@package.Name</th>
            }
        </tr>
        <tr>
            <th class="text-right">@UILabel.ActivityLabel(ActivityType.Activity, true)</th>
            @foreach (Package package in packages)
            {
                <td class="text-center text-bold">@package.GetFeature(FeatureType.Activities).Max.Value</td>
            }
        </tr>
        <tr>
            <th class="text-right">@UILabel.RegistrantLabel(true) / @UILabel.ActivityLabel(ActivityType.Activity)</th>
            @foreach (Package package in packages)
            {
                <td class="text-center text-bold">@package.GetFeature(FeatureType.Participants).Max.Value</td>
            }
        </tr>
        <tr>
            <th class="text-right">User Accounts</th>
            @foreach (Package package in packages)
            {
                <td class="text-center text-bold">@package.GetFeature(FeatureType.TeamAccounts).Max.Value</td>
            }
        </tr>
        <tr>
            <th class="text-right">Messaging to @UILabel.RegistrantLabel(true)</th>
            @foreach (Package package in packages)
            {
                <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasFeature(FeatureType.Messaging));}</td>
            }
        </tr>
        <tr>
            <th class="text-right">Manage Waiting List</th>
            @foreach (Package package in packages)
            {
                <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasFeature(FeatureType.WaitingList));}</td>
            }
        </tr>
        <tr>
            <th class="text-right">Take Attendance</th>
            @foreach (Package package in packages)
            {
                <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasFeature(FeatureType.Attendance));}</td>
            }
        </tr>
        <tr>
            <th class="text-right">Accept Payments</th>
            @foreach (Package package in packages)
            {
                <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasFeature(FeatureType.AcceptPayments));}</td>
            }
        </tr>
        <tr>
            <th class="text-right">Custom Url</th>
            @foreach (Package package in packages)
            {
                <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasFeature(FeatureType.CustomUrl));}</td>
            }
        </tr>
        <tr>
            <th class="text-right">Price</th>
            @foreach (Package package in packages)
            {
                <td class="text-center money">@(package.ID.Value == accountPackage.PackageId.Value ? accountPackage.Price.ToCurrency() : package.Price.ToCurrency())</td>
            }
        </tr>
        <tr>
            <th></th>
            @foreach (Package package in packages)
            {
                var packageSelectUrl = "";

                if (SessionVariables.CurrentAccount.IsAdminAccount)
                {
                    packageSelectUrl = Url.Action("selectpackage", "account", new { id = Model.ID, package = package.ID });
                }
                else
                {
                    if (SessionVariables.CurrentAccount.HasPaymentCard)
                    {
                        packageSelectUrl = Url.Action("selectpackage", "account", new { id = package.ID });
                    }
                    else
                    {
                        packageSelectUrl = Url.Action("newbilling", "account", new { id = package.Uid.ToString() });
                    }
                }

                <td>
                    <div>
                        @if (accountPackage.IsEmpty() || package.ID != accountPackage.PackageId)
                        {
                            <a href="@packageSelectUrl" class="btn btn-block btn-alt5 btn-lg">Select</a>
                        }
                        else
                        {
                            <a href="#" class="btn btn-block btn-success btn-lg">Selected</a>
                        }
                    </div>
                </td>
            }
        </tr>
    </table>
</div>
