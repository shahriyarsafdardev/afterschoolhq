@{
    var primaryColor = ViewData.ContainsKey("primaryColor") && ViewData["primaryColor"] != null ? ViewData["primaryColor"].ToString() : string.Empty;
    var website = ViewData.ContainsKey("website") && ViewData["website"] != null ? ViewData["website"].ToString() : string.Empty;
    var logoUrl = ViewData.ContainsKey("logoUrl") && ViewData["logoUrl"] != null ? ViewData["logoUrl"].ToString() : string.Empty;
}

<style>
    .directory-header {
        background: white;
        border-bottom: 2px solid @primaryColor;
        justify-content: space-between;
        padding: 5px 25px;
    }

    .filter-footer-container {
        position: fixed;
        z-index: 999999;
        background-color: white;
        width: 100%;
        bottom: 0;
        padding: 12px 0;
        border-top: 1px solid @primaryColor;
        display: none;
    }

    .apply-filter-mobile-button {
        border-color: @primaryColor;
        border-radius: 5px;
        color: @primaryColor;
    }
</style>

<header class="visible-lg visible-md directory-header">
    <a href=@(website.IsNotEmpty() ? website : "")>
        <img src="@logoUrl" alt="AfterSchool HQ - Your home for afterschool experiences"/>
    </a>
    <div class="language-select pull-right" style="background-color: @primaryColor">
        @Html.Partial("_GoogleTranslateDropDown")
    </div>
</header>

<header class="visible-sm visible-xs bg-color">    
    <div class="col-xs-6" style="padding: 10px;">
        <a href=@(website.IsNotEmpty() ? website : "")>
            <img src="@logoUrl" alt="AfterSchool HQ - Your home for afterschool experiences" style="height: 55px;" />
        </a>
    </div>

    <div class="language-select pull-right" style="background-color: @primaryColor; margin-top: 15px;">
        @Html.Partial("_GoogleTranslateDropDown")
    </div>

    <div class="clearfix"></div>
    <div id="mobile-filter-footer" class="filter-footer-container">
        <button type="button" class="btn btn-default btn-center apply-filter-mobile-button" onclick="validatePostalCodeAndApplyFilters()">Apply Filters</button>
    </div>

    <div class="clearfix"></div>
</header>