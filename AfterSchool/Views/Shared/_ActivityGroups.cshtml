@model List<ActivityGroup>
@{
    var activityGroupType = (ActivityGroupType)ViewBag.ActivityGroupType;
    var paging = (PagingModel)ViewBag.PagingModel;
    var hasArchivedGroups = (bool)ViewBag.HasArchivedGroups;
    var controller = ViewBag.GroupController;
    var action = ViewBag.GroupAction;
    var isExternalGroupsView = ViewBag.isExternalGroupsView ?? false;
    var pendingInvites = (List<ActivityGroup>)ViewBag.pendingInvites;
    var recentlyDeclinedInvites = (List<ActivityGroup>)ViewBag.RecentlyDeclinedInvites;
    var addAction = activityGroupType == ActivityGroupType.League ? "editsetup" : "edit";

    if (action == null)
    {
        action = "index";
    }

    var previousLink = "#";
    var nextLink = "#";
    if (paging.IsNotEmpty())
    {
        if (paging.PageNumber > 1)
        {
            previousLink = Url.Action(action, controller, new { pn = paging.PageNumber - 1, rpp = Request["rpp"], archive = Request["archive"] });
        }
        if (paging.PageNumber < paging.TotalPages)
        {
            nextLink = Url.Action(action, controller, new { pn = paging.PageNumber + 1, rpp = Request["rpp"], archive = Request["archive"] });
        }
    }

    var currentClass = "";
    var archiveClass = "";
    var isArchive = false;
    if (Request["archive"] == "1")
    {
        archiveClass = "text-bold";
        isArchive = true;
    }
    else
    {
        currentClass = "text-bold";
    }
}

@if (isExternalGroupsView && (pendingInvites.Any() || recentlyDeclinedInvites.Any()))
{
    Html.RenderPartial("~/Areas/Org/Views/League/Invitations.cshtml", pendingInvites);
}
else if (isExternalGroupsView && Model.Count == 0)
{
    <p>You don't have any pending  @UILabel.ActivityGroupLabel(activityGroupType, true).ToLower().TrimEnd('s') invitations. </p>

}

@if ((Model.Count == 0 && !hasArchivedGroups))
{
    <div class="widget">
        <div class="widget-head">
            <h1>Welcome to @UILabel.ActivityGroupLabel(activityGroupType, true)</h1>
        </div>
        <div class="widget-tile">
            <hr />
            <p>Welcome, @SessionVariables.CurrentUser.FirstName!</p>
            @if (isExternalGroupsView)
            {
                <p>You haven't accepted invitations to or created any @UILabel.ActivityGroupLabel(activityGroupType, true).ToLower() yet. </p>
            }
            else
            {
                <p>You haven't created any @UILabel.ActivityGroupLabel(activityGroupType, true).ToLower() yet. In order to get started, <a href="@Url.Action(addAction, controller, new { isnew = 1 })">create your first @UILabel.ActivityGroupLabel(activityGroupType).ToLower()</a>.</p>

                <p>&nbsp;</p>
                <p>
                    <a href="@Url.Action(addAction, controller, new { isnew = 1 })" class="btn btn-primary btn-lg">Create Your First @UILabel.ActivityGroupLabel(activityGroupType) &raquo;</a>
                </p>
            }

        </div>
    </div>
}
else
{


    if (!isExternalGroupsView)
    {
        <div class="row">
            <div class="col-md-12">
                <div class="pull-right">
                    <a href="@Url.Action(action, controller, new { archive = 0 })" class="@currentClass">Current</a> |
                    <a href="@Url.Action(action, controller, new { archive = 1 })" class="@archiveClass">Archived</a>
                </div>
            </div>
        </div>
    }


    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th></th>
                    <th>
                        @UILabel.ActivityGroupLabel(activityGroupType)
                    </th>
                    <th class="text-center">
                        @UILabel.ActivityLabel(activityGroupType, true)
                    </th>
                    <th class="text-center">
                        Registrations
                    </th>
                    <th>
                        @if (isExternalGroupsView)
                        {
                            <span>Team Registration Deadline</span>
                        }
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count > 0)
                {
                    foreach (var group in Model)
                    {
                        var aag = group.GetAccountActivityGroup(SessionVariables.CurrentAccount);
                        var regCount = aag.IsEmpty() ? group.GetRegistrationCount() : aag.GetRegistrationCount();
                        var activityCount = aag.IsEmpty() ? group.GetActivityCount(null, isArchive, false, null) : aag.GetActivityCount(null, isArchive, false);
                        var period = group.GetLatestRegistrationPeriod();

                        <tr>
                            <td>
                                <a href="@Url.Action("summary", controller, new {id = group.Uid})" class="btn btn-default btn-sm"><i class="icon icon-left s7-date"></i> Manage</a>
                            </td>
                            <td>
                                <a href="@Url.Action("summary", controller, new {id = group.Uid})">@group.Name</a>
                            </td>
                            
                            <td class="text-center">@activityCount</td>
                            
                            <td class="text-center">@regCount</td>

                            @if (!isExternalGroupsView)
                            {
                                <td>
                                    <div class="btn-group pull-right">

                                        @if (group.ActivityGroupTypeId == ActivityGroupType.Session)
                                        {
                                            <button class="btn btn-default btn-sm md-trigger"
                                                    data-modal="modal-copy"
                                                    onclick="setCopyGroup('@group.Name', '@Url.Action("copy", controller, new { id = group.Uid.ToString() })')">
                                                <i class="s7-copy-file"></i> Repeat
                                            </button>
                                        }

                                        @if (!group.IsArchived)
                                        {
                                            <button class="btn btn-default btn-sm md-trigger"
                                                    data-modal="modal-archive"
                                                    onclick="archiveGroup('@group.Name', '@Url.Action("archive", controller, new { id = group.Uid.ToString() })')">
                                                <i class="s7-albums"></i> Archive
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-default btn-sm md-trigger"
                                                    data-modal="modal-restore"
                                                    onclick="restoreGroup('@group.Name', '@Url.Action("restore", controller, new { id = group.Uid.ToString() })')">
                                                <i class="s7-albums"></i> Restore
                                            </button>
                                        }
                                        @if (!group.IsDeleted)
                                        {
                                            <button class="btn btn-default btn-sm md-trigger"
                                                    data-modal="modal-delete"
                                                    onclick="deleteGroup('@group.Name', '@Url.Action("delete", controller, new { id = group.Uid.ToString() })')">
                                                <i class="s7-trash"></i> Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            }
                            else
                            {
                                <td>
                                    @if (period.IsNotEmpty())
                                    {
                                        if (period.IsOpen())
                                        {
                                            <span>Teams must be submitted by @period.EndDateTime.ToLongDateTimeString()</span>
                                        }
                                        else if (period.WillOpen())
                                        {
                                            <span>Team registration will open @period.EndDateTime.ToLongDateTimeString()</span>
                                        }
                                        else if (period.IsClosed())
                                        {
                                            <span>Team registration closed @period.EndDateTime.ToLongDateTimeString()</span>
                                        }
                                    }
                                </td>
                            }

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            There are no @UILabel.ActivityGroupLabel(activityGroupType, true).ToLower(). Please <a href="@Url.Action($"edit{(activityGroupType == ActivityGroupType.League ? "setup" : "")}", controller, new { isnew = 1 })">add a new @UILabel.ActivityGroupLabel(activityGroupType).ToLower()</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    Html.RenderPartial(
        "~/Views/Shared/_Paging.cshtml",
        paging,
        new ViewDataDictionary()
        {
            { "id", "" },
            { "querystring", string.Format("archive={0}", Request["archive"]) },
            { "action", action },
            { "controller", controller }
        }
    );

}



<div id="modal-copy" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-copy" action="" method="post">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Repeat @UILabel.ActivityGroupLabel(activityGroupType)</h3>
            </div>
            <div class="modal-body form">

                <p>This is used to create an copy of the existing @UILabel.ActivityGroupLabel(activityGroupType).ToLower(). Once copied you can make any modifications as needed.</p>

                <div class="form-group">
                    <label>@UILabel.ActivityGroupLabel(activityGroupType) Name</label>
                    <input type="text" placeholder="Your @UILabel.ActivityGroupLabel(activityGroupType) Name" class="form-control" id="groupnamecopy" name="groupnamecopy" onfocus="this.select()">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Repeat @UILabel.ActivityGroupLabel(activityGroupType) &raquo;</button>
            </div>
        </div>
    </form>
</div>

<div id="modal-archive" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Archive @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to archive <strong><span id="archive-group-name"></span></strong>? </p><p>Archived @UILabel.ActivityGroupLabel(activityGroupType, true).ToLower() are automatically unpublished and all related @UILabel.ActivityLabel(activityGroupType, true).ToLower() are also archived and unpublished.</p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="archive-group-button">Archive &raquo;</a>
        </div>
    </div>
</div>

<div id="modal-restore" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Restore @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to restore <strong><span id="restore-group-name"></span></strong>? </p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="restore-group-button">Restore &raquo;</a>
        </div>
    </div>
</div>

<div id="modal-delete" class="md-modal colored-header custom-width md-effect-9">
    <div class="md-content">
        <div class="modal-header">
            <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
            <h3 class="modal-title">Delete @UILabel.ActivityGroupLabel(activityGroupType)</h3>
        </div>
        <div class="modal-body form">

            <p>Are you sure you want to delete <strong><span id="delete-group-name"></span></strong>? </p>

        </div>
        <div class="modal-footer">
            <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
            <a class="btn btn-primary" href="#" id="delete-group-button">Delete &raquo;</a>
        </div>
    </div>
</div>


<script>
    function setCopyGroup(name, url) {
        $('#groupnamecopy').val(name + ' [copy]');
        $('#form-copy').attr('action', url);
    }
    function archiveGroup(name, url) {
        $('#archive-group-name').html(name);
        $('#archive-group-button').attr('href', url);
    }
    function restoreGroup(name, url) {
        $('#restore-group-name').html(name);
        $('#restore-group-button').attr('href', url);
    }
    function deleteGroup(name, url) {
        $('#delete-group-name').html(name);
        $('#delete-group-button').attr('href', url);
    }
</script>