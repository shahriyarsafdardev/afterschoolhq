@model List<RegistrantActivity>
@{ 
    var account = (Account)ViewData["Account"];
    var activity = (Activity)ViewData["Activity"];
    var participationObject = activity.GetParticipationObject();
    var editaction = ViewData["EditAction"].ToString();
    var editcontroller = ViewData["EditController"].ToString();
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);
    var isReadOnlySeatStatus = (bool)ViewData["IsReadOnlySeatStatus"].IsNotEmpty() && (bool)ViewData["IsReadOnlySeatStatus"];

    var reservedButPendingPayment = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.ReservedPendingPayment).ToList();
    var reservedPendingParentalConsent = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.ReservedPendingParentalConsent).ToList();
    var reserved = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.Reserved).ToList();
    var waiting = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.WaitingList).ToList();
    var invited = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.Invited).ToList();
    var applied = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.Applied).ToList();
    var interested = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.Interested).ToList();
    var withdrawn = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.Withdrawn).ToList();
    var declined = Model.Where(m => m.AssignmentTypeId == RegistrationAssignmentType.Declined).ToList();
}

<div class="clearfix"></div>
@if (reservedButPendingPayment.IsNotEmpty() && reservedButPendingPayment.Count > 0)
{
    Html.RenderPartial("~/Views/Shared/_ActivityRegistrantsForSpecificStatus.cshtml",
      reservedButPendingPayment,
      new ViewDataDictionary() {
          { "Activity", activity },
          { "Account", account },
          { "EditAction", editaction },
          { "EditController", editcontroller },
          { "HeaderTitle", RegistrationAssignmentType.ReservedPendingPayment },
          { "IsReadOnly", isReadOnlySeatStatus }
