<div id="modal-waitinglist" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-waitinglist" action="" method="post" class="form-inline">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title">Manage <span id="registrant-name"></span> Waiting List</h3>
            </div>
            <div class="modal-body form">
                <p>
                    Move 
                    <select id="numbertomove" name="numbertomove" class="form-control"></select>
                    @UILabel.RegistrantLabel(true).ToLower()
                    <select id="movefromto" name="movefromto" class="form-control">
                        <option value="from">from</option>
                        <option value="to">to</option>
                    </select>
                    the waiting list
                </p>

            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Update Waiting List &raquo;</button>
            </div>
        </div>
    </form>
</div>

<div id="withdraw-modal-container"></div>
<script id="script-withdraw-template" type="text/template">

    <div id="modal-withdraw-registrant-<%= registrantActivityUId %>" class="modal colored-header fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                    <h3 class="modal-title"><i class="s7-attention"></i> Withdrawal Confirmation</h3>
                </div>

                <div class="modal-body">
                    <p class="text-center">Are you sure you want to withdraw <strong><%= registrantName %></strong> from <strong><%= activityName %></strong> ? </p>
                    <% if (hasPaymentPlan) { %>
                        <p class="text-center">
                            <%= registrantName %> is on a payment plan. Do you want to cancel the remaining <%= count %> payments?
                        </p>
                        <div class="" style="margin: 0 25%;">
                            <div class="am-radio">
                                <input type="radio" class="form-control yesno" name="yesno" id="yes" value="yes" />
                                <label for="yes">Yes, cancel remaining payment.</label>
                            </div>
                            <div class="am-radio">
                                <input type="radio" class="form-control yesno" name="yesno" id="no" value="no" />
                                <label for="no">No, do not cancel remaining payment.</label>
                            </div>
                        </div>
                        <p class="text-center">
                            Note: Refunds can be handled through the Accounting Dashboard
                        </p>
                    <% }  %>
                </div>

                <div class="modal-footer textCenterImportant">
                    <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                    <button type="button" id="btn-manual-withdraw" class="btn btn-danger padding-h-20" onclick="return withdraw('<%= participationObjectId %>', '<%= registrantId %>', '<%= type %>', '<%= registrantActivityUId %>', '<%= registrantActivityId %>', 'true')">Withdrawal &amp; Cancel Payments &raquo;</button>
                </div>
            </div>
        </div>
    </div>

</script>

<script>


    function moveRegistrantAssignment(registrant, registrantName, selectBox) {
        let newAssignment = selectBox.value;
        let newAssignmentText = selectBox.options[selectBox.selectedIndex].text;
        console.log(newAssignment, selectBox.selectedIndex, newAssignmentText)
        moveRegistrantAssignment2(registrant, registrantName, newAssignment, newAssignmentText);
    }

    function moveRegistrantAssignment2(registrant, registrantName, newAssignment, newAssignmentText) {
        $.get(
            `@Url.Action("moveregistrantassignment", "services", new { id = activity.Uid })?registrant=${registrant}&assignmenttype=${newAssignment}`,
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: `${registrantName}'s seat has been moved to ${newAssignmentText}.`
                    });
                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: `Error updating the seat for ${registrantName}. Please <a href="mailto:@AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress" class="white">contact support</a>.`
                    });
                }
            }
        );
    }

    function sendPaymentReminder(obj, registrant, registrantName) {

        let objId = $(obj).attr('id').split('-')[1];

        $(obj).html('Sending...');
        $(obj).prop('disabled', true);

        $.get(
            `@Url.Action("sendpaymentreminder", "services", new { id = activity.Uid })?registrant=${registrant}`,
            function (data) {
                if (data && data.status == 'ok') {
                    Notifications.showBar({
                        title: 'Success',
                        message: `A payment reminder email has been sent to ${registrantName}.`
                    });

                    $(`#newassignmenttype-${objId}`).val(data.AssignmentType);

                } else {
                    Notifications.showBar({
                        title: 'Error',
                        message: `Error sending payment reminder email to ${registrantName}. Please <a href="mailto:@AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress" class="white">contact support</a>.`
                    });
                }
                $(obj).html('Send Invoice');
                $(obj).prop('disabled', false);
            }
        );
    }

    function processWithdraw(registrantActivityUId, registrantActivityId, registrantId, participationObjectId, type, registrantName, count, hasPaymentPlan) {
        //.. prepare source and template
        var source = $("#script-withdraw-template").html();
        var compiled = _.template(source);

        //.. format data as JSON and combine with template
        var compiledHtml = compiled({
            registrantActivityUId: registrantActivityUId,
            registrantActivityId: registrantActivityId,
            registrantId: registrantId,
            participationObjectId: participationObjectId,
            registrantName: registrantName,
            type: type,
            activityName: '@activity.Name',
            count: count,
            hasPaymentPlan: hasPaymentPlan
        });

        //.. update html to dom
        $('#withdraw-modal-container').html(compiledHtml);
        $('#modal-withdraw-registrant-' + registrantActivityUId).modal('show');
        $('input:radio[name=yesno][value=yes]', '#withdraw-modal-container').attr('checked', true);

        return false;
    }

    function withdraw(participationObjectId, registrantId, type, registrantActivityUId, registrantActivityId, isWithdrawAndCancelClicked) {
        if (participationObjectId && registrantId) {
            showLoader();

            var url = '@Url.Action("WithdrawRegistrant", "Activity", new { Area = "Org" })';
            $.ajax({
                type: "POST",
                url: url,
                data: { participationObjectId: participationObjectId, registrantUId: registrantId, type, isWithdrawAndCancelClicked },
                success: function (data) {
                    if (data && data.success == true) {

                        $('#modal-withdraw-registrant-' + registrantActivityUId).modal('hide');

                        var withdrawn = '@Json.Encode(RegistrationAssignmentType.Withdrawn)';
                        $('#newassignmenttype-' + registrantActivityId).val(withdrawn); //status udpate to withdrawn
                        $('#btn-withdraw-' + registrantActivityUId).attr('disabled', 'disabled');
                        hideLoader();

                        Notifications.showBar({
                            title: 'Success',
                            message: 'Registrant Withdrawn successfully.',
                            success: true
                        });
                    } else {
                        if (data && data.status == 'error') {
                            $('#search-result').html('');

                            var error = '';

                            _.each(data.data, function (msg) {
                                error += msg?.Text + '<br />';
                            });

                            hideLoader();

                            Notifications.showBar({
                                title: 'Error',
                                message: error,
                                success: false
                            });
                        }
                    }
                }
            });
        }
    }
</script>
