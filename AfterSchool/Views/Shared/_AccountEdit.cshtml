@model Account

@{
    var accountPackage = (AccountPackage)ViewBag.AccountPackage;

    var customurldisabled = "";
    var value = Model.UniqueName;
    if (!accountPackage.PackageHasCNameUrl)
    {
        customurldisabled = " disabled=\"disabled\" ";
        value = "";
    }
}

<form method="post" action="@Url.Action("edit", "account", new { id = @Model.ID })" class="form-horizontal">
    <div class="form-group">
        <label class="col-sm-3 control-label">Organization Name</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="name" name="name" value="@Model.Name" onfocus="this.select()" required />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Phone</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="phone" name="phone" value="@Model.Phone" onfocus="this.select()" required />
        </div>
    </div>
    @if (accountPackage.PackageHasCNameUrl) { 
        <div class="form-group">
            <label class="col-sm-3 control-label">Custom Url</label>
            <div class="col-sm-6">
                <div class="input-group">
                    <input type="text" class="form-control" name="uniquename" id="uniquename" value="@value" @customurldisabled /><span class="input-group-addon">.@AfterSchoolLibrary.Helpers.Utilities.HostName</span>
                </div>
            </div>
        </div>
    }
    
    <div class="form-group">
        <label class="col-sm-3 control-label">Street Address</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="address1" name="address1" value="@Model.Address1" onfocus="this.select()" required />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Apt #/Suite</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="address2" name="address2" value="@Model.Address2" onfocus="this.select()" />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">City</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="city" name="city" value="@Model.City" onfocus="this.select()" required />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">State</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="state" name="state" value="@Model.State" onfocus="this.select()" required />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Zip Code</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="postalcode" name="postalcode" value="@Model.PostalCode" onfocus="this.select()" required />
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Time Zone</label>
        <div class="col-sm-6">
            <select name="timezone" id="timezone" class="form-control" required>
                @foreach (var zone in new string[] { "Eastern - EST", "Central - CST", "Mountain - MST", "Pacific - PST", "Alaska - AKST", "Hawaii - HAST" })
                {
                    var selected = "";
                    if (zone == Model.TimeZone) { selected = " selected=\"selected\" "; }
                    <option value="@zone" @selected>@zone</option>
                }
            </select>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-3 control-label">Logo Url</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" id="logourl" name="logourl" value="@Model.LogoUrl" onfocus="this.select()" required />
        </div>
    </div>

    @if (SessionVariables.CurrentAccount.IsAdminAccount)
    {
        <div class="form-group">
            <label class="col-sm-3 control-label">Is Active</label>
            <div class="col-sm-6">
                <div class="switch-button switch-button-yesno">
                    <input type="checkbox" @(Model.IsActive ? " checked=\"checked\" " : "") name="isactive" id="isactive">
                    <span>
                        <label for="isactive"></label>
                    </span>
                </div>
            </div>
        </div>
    }

    <div class="form-group">
        <label class="col-sm-3 control-label"></label>
        <div class="col-sm-6">
            <button type="submit" class="btn btn-primary">Save</button>
            <button type="reset" class="btn btn-default">Discard Changes</button>
        </div>
    </div>
</form>
