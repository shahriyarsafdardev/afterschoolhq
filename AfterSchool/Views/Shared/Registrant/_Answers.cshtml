@model List<FormQuestionAnswer>
@{ 
    var isTechSupport = (bool)SessionVariables.CurrentUser.IsTechSupport(SessionVariables.CurrentAccount);

    var isPrintView = false;
    var tableCondensed = "";
    if (ViewData["IsPrintView"].IsNotEmpty() && ViewData["IsPrintView"].ToString().IsBoolean())
    {
        isPrintView = ViewData["IsPrintView"].ToString().ToBoolean();
    }

    if (isPrintView)
    {
        tableCondensed = "table-condensed";
    }
}

@foreach (var group in Model.Select(x => x.ToFormQuestionGroup()).DistinctBy(x => x.QuestionGroupDataTypeId).OrderBy(x => x.DisplayOrder))
{
    <div class="table-responsive">
        <table class="table table-striped @tableCondensed">
            <thead>
                <tr>
                    <th colspan="2">@group.Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var answer in Model.Where(x => x.FormQuestionGroupQuestionGroupDataTypeId == group.QuestionGroupDataTypeId).OrderBy(x => x.FormQuestionDisplayOrder))
                {
                    <tr>
                        <td valign="top" width="33%" class="text-right">@answer.FormQuestionText</td>
                        <td valign="top">
                            @if (isTechSupport)
                            {
                                <span>••••••••</span>
                            }
                            else if (answer.FormQuestionQuestionTypeId == QuestionType.Checkbox)
                            {
                                @answer.Text.IfBlank("0").ToBoolean().ToYesNo();
                            }
                            else if (answer.FormQuestionQuestionTypeId.In(new List<QuestionType>() { QuestionType.RadioList, QuestionType.DropDownList }))
                            {
                                //[{"Key":"2","Value":"Female"}]
                                @(UILabel.GetFormattedAnswer(answer.Text).IsNotEmpty() ? UILabel.GetFormattedAnswer(answer.Text) : "••••••••");
                            }
                            else if (answer.FormQuestionQuestionTypeId.In(new List<QuestionType>() { QuestionType.CheckboxList }))
                            {
                                //[{"key":"html","value":"html"},{"key":"js","value":"js"}]
                                @(UILabel.GetFormattedAnswerForArray(answer.Text).IsNotEmpty() ? UILabel.GetFormattedAnswerForArray(answer.Text) : "••••••••");
                            }
                            else if (answer.FormQuestionQuestionTypeId == QuestionType.RadioMatrix)
                            {
                                foreach (var item in answer.Text.Split(';'))
                                {
                                    <span>@item.Split('=')[0]: @item.Split('=')[1]</span><br />
                                }
                            }
                            else if (answer.FormQuestionQuestionTypeId == QuestionType.FileUpload && answer.Text.IsNotBlank())
                            {
                                <span>
                                    @*
                                    <a href="@Url.Action("downloadfile", "registration", new { id = Model.Uid, r = selectedRegistration.Uid, file = answer.ID, returnUrl = Request["returnurl"] })"
                                       target="_blank">
                                        Download File
                                    </a>
                                    *@
                                    <a href="@answer.GetFileDownloadLink()" target="_blank">
                                        Download File
                                    </a>
                                </span>
                            }
                            else
                            {
                                @answer.Text.IfBlank("-")
                            }

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
