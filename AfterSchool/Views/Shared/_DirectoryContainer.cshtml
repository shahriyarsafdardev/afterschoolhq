@{
    var primaryColor = ViewData.ContainsKey("primaryColor") && ViewData["primaryColor"] != null ? ViewData["primaryColor"].ToString() : string.Empty;
    var grades = ViewData.ContainsKey("grades") && ViewData["grades"] != null ? (List<GradeLevel>) ViewData["grades"] : new List<GradeLevel>();
}

<style>
    #search-and-results-container {
        background-color: #f8f8f8;
        flex-grow: 1;
        float: none;
    }
    
    .search-filter-and-map-heading {
        padding-top: 15px;
    }
    
    #results-container {
        height: calc(100vh - 148px);
        overflow-y: auto;
        padding: 0 15px 15px;
        width: 100%;
    }
</style>
<div id="main-view-container" class="display-flex">
    <div id="list-view" class="directory-list-view">
        <div id="filters" class="col-md-3 directory-filters" style="display: none;">
            <span id="directory-sidebar-icon" class="primary-color directory-sidebar-arrow" isOpen="true" onclick="return toggleSideBar(this)">
                <i id="search-sidebar-arrow" class="fa fa-chevron-circle-left" aria-hidden="true"></i>
            </span>

            @{ Html.RenderPartial("~/Views/Shared/_DirectoryFilters.cshtml", null, new ViewDataDictionary {{"grades", grades}}); }

        </div>

        <div id="search-and-results-container">

            <div class="search-filter-and-map-heading">
                <div class="col-lg-9 col-md-9 col-sm-9 col-xs-9 mobile-padding-zero">
                    <div class="has-feedback has-search" style="margin-bottom: 12px;">
                        <input id="txtSearch" name="search" type="text" class="form-control directory-search-input" placeholder="Search For Programs" onkeyup="return waitAndFilterSearch(this.value)">
                        <span class="glyphicon glyphicon-search form-control-feedback directory-search-magnyfier-icon"></span>
                    </div>
                </div>

                <div id="container-show-filter-button" class="col-xs-3 directory-filter-symbol">
                    <button id="btn-mobile-filter" class="btn btn-sm btn-default" isOpen="0" onclick="mobileFilter()" style="border-radius: 5px; height: 37px; width: 100%; margin-left: 3px; font-weight: bold;">
                        <img src="~/Assets/img/filter.svg" class="directory-filter-icon-mobile" alt="Show or hide filters"/>
                        Filter
                    </button>
                </div>

                <div id="container-show-map-chk" class="am-checkbox checkbox-show-map col-lg-3 col-md-3" style="display: none;">
                    <input id="chk-map-view" name="show-map" checked="checked" value="1" type="checkbox" class="schedulerepeat-checkbox" onclick="return toggleMapView(this)"/>
                    <label for="chk-map-view" class="margin-h-10 mobile-padding font-weight-bold">Show Map</label>
                </div>
            </div>
            <div id="results-container">
                <div class="clearfix"></div>

                <div id="tags-container-mobile-view" style="margin-bottom: 12px;"></div>
                <div class="clearfix"></div>

                <div id="search-result" class="row"> </div>
                <div class="clearfix"></div>

                <div class="directory-search-no-result"></div>

                <div id="ProgressBar">
                    <img src="~/Assets/img/loading-spinner.gif" alt="Loading more results">
                </div>

                <div id="notification-contact-us" class="text-center sticky-bottom">
                    <button class="btn btn-contact-us" style="border: 3px solid @primaryColor;" type="button" data-toggle="modal" data-target="#ContactUsModal">
                        Can't find what you are looking for?
                        <span class="contactSpan">CONTACT US</span>
                    </button>
                </div>
                <div class="clearfix"></div>
            </div>
        </div>
    </div>

    <div id="map-view" style="display: none;">
        <div id="map" style="height: 100%;"></div>
    </div>
</div>

<div class="clearfix"></div>