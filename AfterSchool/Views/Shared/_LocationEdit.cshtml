@model Location

@{ 
    var accountId = 0;
    var searchOnly = false;
    var label = "Enter a location";
    var placeholderText = "Search Locations...";
    var locationIsRequired = false;

    if (ViewData["searchonly"].IsNotEmpty())
    {
        searchOnly = (bool)ViewData["searchonly"];
    }

    if (ViewData["label"].IsNotEmpty())
    {
        label = ViewData["label"].ToString();
    }

    if (ViewData["placeholderText"].IsNotEmpty())
    {
        placeholderText = ViewData["placeholderText"].ToString();
    }

    if (!searchOnly)
    {
        accountId = (int)ViewData["accountId"];
    }

    if (ViewData["locationIsRequired"].IsNotEmpty() && ViewData["locationIsRequired"].IsNotEmpty().ToString().ToBoolean())
    {
        locationIsRequired = ViewData["locationIsRequired"].IsNotEmpty().ToString().ToBoolean();
    }
}

<div class="form-group">
    <label class="col-sm-3 control-label">
        @label
        @if(@locationIsRequired)
        {
            <span class="text-danger">*</span>
        }
    </label>
    <div class="col-sm-6" style="position:relative;">
        <input type="text" class="form-control" id="location-search" name="location-search" value="@Model.FormatAddress(false)" placeholder="@placeholderText" autocomplete="off" />
        <input type="hidden" name="location" id="location" value="@(Model?.ID)" />
        <input type="hidden" name="hostaccount" id="hostaccount" value="" />
        <div id="location-list" class="border-light-gray pointer hide" style="position:absolute; width:100%; z-index:1000; background-color: white; border-width: 2px;">

        </div>
    </div>
</div>

<script>
    var locationList;
    var locationSearch;
    var isSearching = false;
    var listItemClass = "text-small padding-10";
    var listItemStyle = "background-color: #f0f0f0;";
    var listItemOnMouseOver = "locationMouseOver";
    var listItemOnMouseOut = "locationMouseOut";
    var listItemOnClick = "locationMouseClick";

    function locationMouseOver(id) {
        $(`#location-${id}`).addClass('bg-warning');
    }

    function locationMouseOut(id) {
        $(`#location-${id}`).removeClass('bg-warning');
    }

    function locationMouseClick(id, fullAddress, hostAccount, locationType) {
        locationList.addClass('hide');

        if (id > 0) {

            $('#add-location').addClass('hide');
            $('#location').val(id);
            locationSearch.val(fullAddress);
            $('#hostaccount').val(hostAccount);

            $('#mylocation').prop('checked', false);
            $('#isschool').prop('checked', false);

            if (locationType.toLowerCase() == "school") {
                $('#isschool').prop('checked', true);
            }

            // console.log(@accountId, hostAccount);

            if (hostAccount.length > 0 && hostAccount != "@accountId") {

                // console.log('dont own this');

                // $('#add-location').addClass('hide');
                $('#hostaccount-div').addClass('hide');
                $('#isschool-div').addClass('hide');

                $('.my-location').removeAttr('required');
                $('.location-type').removeAttr('required');

            } else {

                // console.log('do own this');

                // $('#add-location').removeClass('hide');
                $('#hostaccount-div').removeClass('hide');
                $('#isschool-div').removeClass('hide');

                $('.my-location').removeAttr('required');
                $('.location-type').removeAttr('required');

                if (hostAccount.length > 0 && hostAccount == @accountId) {
                    $('#mylocation').prop('checked', true);
                }
            }
        } else if (@searchOnly.ToString().ToLower() == false) {          
            $('#locationname').val(locationSearch.val());

            $('#add-location').removeClass('hide');
            $('#location').val('');
            locationSearch.val('');
            $('#hostaccount').val('');
            $('#hostaccount-div').removeClass('hide');
            $('#isschool-div').removeClass('hide');
            $('.my-location').attr('required', 'required');
            $('.location-type').attr('required', 'required');
        }
    }

    function doLocationSearch(locationSearch, locationList) {
        if (locationSearch.val().length > 0 && !isSearching) {
            isSearching = true;
                
            $.get(
                `@Url.Action("searchlocations", "services")?search=${locationSearch.val()}`,
                function (data) {

                    isSearching = false;

                    if (data && data.status == 'ok') {

                        locationList.html('');

                        for (let location of data.locations) {
                            let addressEscaped = location.FullAddress.replace(/'/g, "\\'");
                            locationList.append(`
                                <div class="${listItemClass}" 
                                    style="${listItemStyle}" 
                                    id="location-${location.ID}" 
                                    onmouseover="${listItemOnMouseOver}(${location.ID})" 
                                    onmouseout="${listItemOnMouseOut}(${location.ID})" 
                                    onclick="${listItemOnClick}(${location.ID},'${addressEscaped}','${location.HostAccountId}','${location.LocationType}')">
                                    <strong>${location.FullAddress}</strong>
                                </div>`);
                        }

                        if (locationSearch.val().length >= 4 && @searchOnly.ToString().ToLower() == false) {
                            locationList.append(`
                            <div class="${listItemClass}"
                                style="${listItemStyle}" 
                                id="location-0"
                                onmouseover="${listItemOnMouseOver}(0)" 
                                onmouseout="${listItemOnMouseOut}(0)" 
                                onclick="${listItemOnClick}(0)">
                                <strong>Location not found &raquo; Click here to a new location.</strong>
                            </div>`);
                        } else if (data.locations.length == 0) {
                            locationList.append(`
                            <div class="${listItemClass}"
                                style="${listItemStyle}" 
                                id="location-0">
                                <strong>Searching... Type of the location name or address</strong>
                            </div>`);
                        }

                        locationList.removeClass('hide');

                    } else {
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Error loading locations',
                            success: false
                        });
                    }
                }
            );
        } else {
            // locationList.html('');
            // locationList.addClass('hide');
        }
    }


    var searchTimeout = null;

    PageEvent.add(PageEvent.AFTER_INIT, function () {

        locationList = $('#location-list');
        locationSearch = $('#location-search');

        locationSearch.keyup(function () {

            if (locationSearch.val().length > 0) {
                locationList.removeClass('hide');
                locationList.html('');
                locationList.append(`
                    <div class="${listItemClass}"
                        style="${listItemStyle}" 
                        id="location-0">
                        <strong>Searching... Type of the location name or address</strong>
                    </div>`);
            }
            else {
                locationList.html('');
                locationList.addClass('hide');
            }

            if (!isSearching) {
                clearTimeout(searchTimeout);
            }

            searchTimeout = setTimeout(function () {
                doLocationSearch($('#location-search'), $('#location-list'))
            }, 250);

        });

    });
</script>
