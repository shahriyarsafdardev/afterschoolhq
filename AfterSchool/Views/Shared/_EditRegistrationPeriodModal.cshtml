@model ActivityGroup
@{ 
    var defaultOpenDateTime = (DateTime)ViewData["DefaultOpenDateTime"];
    var defaultCloseDateTime = (DateTime)ViewData["DefaultCloseDateTime"];
    var postController = ViewData["PostController"].ToString();
}

<div id="modal-add" class="md-modal colored-header custom-width md-effect-9">
    <form id="form-add" action="@Url.Action("periodedit", postController, new { id = Model.Uid })" method="post" class="form-horizontal">
        <div class="md-content">
            <div class="modal-header">
                <button type="button" data-dismiss="modal" aria-hidden="true" class="close md-close"><i class="icon s7-close"></i></button>
                <h3 class="modal-title"><i class="s7-edit"></i> @UILabel.RegistrationPeriodLabel()</h3>
            </div>
            <div class="modal-body form">

                <div class="form-group reg-period">
                    <label class="col-sm-3 control-label">Open Date &amp; Time <span class="text-danger">*</span></label>
                    <div class="col-sm-5">                        
                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/Components/_Date.cshtml",
                                new FormInputViewModel()
                                {
                                    Id = "opendate",
                                    Name = "opendate",
                                    Value = defaultOpenDateTime.ToShortDateString()
                                }
                            );
                        }
                    </div>
                    <div class="col-sm-4">

                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/_TimeSelect.cshtml",
                                defaultOpenDateTime,
                                new ViewDataDictionary()
                                {
                                    { "name", "opentime" },
                                    { "id", "opentime" },
                                    { "required", true }
                                }
                            );
                        }

                    </div>
                </div>

                <div class="form-group reg-period">
                    <label class="col-sm-3 control-label">Close Date &amp; Time <span class="text-danger">*</span></label>
                    <div class="col-sm-5">                        
                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/Components/_Date.cshtml",
                                new FormInputViewModel()
                                {
                                    Id = "closedate",
                                    Name = "closedate",
                                    Value = defaultCloseDateTime.ToShortDateString()
                                }
                            );
                        }
                    </div>
                    <div class="col-sm-4">

                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/_TimeSelect.cshtml",
                                defaultCloseDateTime,
                                new ViewDataDictionary()
                                {
                                    { "name", "closetime" },
                                    { "id", "closetime" },
                                    { "required", true }
                                }
                            );
                        }

                    </div>
                </div>
                <input type="hidden" name="period" id="period-add" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" data-dismiss="modal" class="btn btn-default md-close">Cancel</button>
                <button type="submit" class="btn btn-primary">Save @UILabel.RegistrationPeriodLabel() &raquo;</button>
            </div>
        </div>
    </form>
</div>

<script>
    function editPeriod(id, opendate, opentime, closedate, closetime) {
        $('#opendate').val(opendate);
        $('#opentime').val(opentime);
        $('#closedate').val(closedate);
        $('#closetime').val(closetime);
        $('#period-add').val(id);
    }

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('input[name=opendate],input[name=closedate],input[name=closetime],input[name=opentime]').on('change', function () {
            validateSetup(event);
        });
    });
</script>