<div id="modal-email-confirmation" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-min-width" style="border-radius: 10px; box-shadow: 0 2px 12px 3px rgb(0 0 0 / 30%);">
            <div class="modal-body account-getting-started-padding">
                <div class="text-center">
                    <img src="~/img/email-symbol.png" />
                </div>
                <div id="modal-email-confirmation-text" style="margin: 30px 0 38px; font-size: 19px; font-weight: bold; letter-spacing: 1px; text-align: center; color: #4a4a4a; overflow-wrap: break-word;">
                    Before we publish your activity lets confirm your email.
                </div>
                <div id="modal-email-confirmation-btn" class="margin-v-30 text-center">
                    <a href="#" class="btn btn-primary btn-free-profile" onclick="return resendValidationEmail()">Re-Send Validation email.</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var currentLevel = @Json.Encode(currentLevel);
    var isEmailValidated = @Json.Encode(GettingStartedOptions.CreateFirstActivity);

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (currentLevel == isEmailValidated) {
            $('#modal-email-confirmation').modal('show'); //make id dynamic
        }
    });

    function resendValidationEmail() {
        $('#modal-email-confirmation-text').html('An email has been sent to <span style="color: #00b492;">@accountOwner.Email</span> Please check your inbox for next steps.');
        $('#modal-email-confirmation-btn').hide();
    }
</script>