@model Account
@{
    var account = SessionVariables.CurrentAccount;
    var currentUser = SessionVariables.CurrentUser;
    var supportEmail = AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress;
    var supportEmailHref = $"mailto:{supportEmail}";
    var accountOwner = Model.GetAccountOwner();
    var activityUid = (Guid)ViewBag.ActivityUid;
    var currentLevel = AccountService.OnboardingCompletionStatus(Model);
    var isStripeIntegrated = TempData["IsStripeIntegrated"] != null;
}

<div id="modal-email-confirmation" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-min-width modal-box">
            <div class="modal-body account-getting-started-padding">
                <div onclick="return $('#modal-email-confirmation').modal('hide');">
                    <a class="close close-icon-position">
                        <span aria-hidden="true">&times;</span>
                    </a>
                </div>
                <div class="text-center">
                    <img src="~/img/email-symbol.png" />
                </div>
                <div id="modal-email-confirmation-text" class="modal-box-body">
                    Before we publish your activity lets confirm your email.
                </div>
                <div id="modal-email-confirmation-btn" class="margin-v-30 text-center">
                    <a href="#" class="btn btn-primary btn-free-profile" onclick="return resendValidationEmail()">Re-send verification email</a>
                </div>
            </div>
        </div>
    </div>
</div>

@{ Html.RenderPartial("~/Views/Shared/_ModalPaymentConfirmation.cshtml", Model, new ViewDataDictionary() { { "ActivityUid", activityUid } }); };

<div id="modal-acceptpayment-done" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content modal-min-width modal-box">
            <div class="modal-body account-getting-started-padding">
                <div onclick="return $('#modal-acceptpayment-done').modal('hide');">
                    <a class="close close-icon-position">
                        <span aria-hidden="true">&times;</span>
                    </a>
                </div>

                <div class="text-center">
                    <img src="~/img/email-symbol.png" />
                </div>
                <div id="modal-email-confirmation-text" class="modal-box-body">
                    Account setup complete!
                </div>
                <div id="modal-email-confirmation-btn" class="margin-v-30 text-center">
                    <a href="@Url.Action("editsetup", "activity", new { id = activityUid, area = "org" })" class="btn btn-primary btn-free-profile" style="padding: 12px 20px;">View Activity</a>
                    <div class="clearfix"></div>
                    <br />
                    <a href="#" class="view-activity-text" onclick="return hideAcceptPaymentModal()">Return to activity draft</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    var currentLevel = @Json.Encode(currentLevel);
    var isEmailToBeValidated = @Json.Encode(GettingStartedOptions.ValidateEmail);
    var isActivityToBePublished = @Json.Encode(GettingStartedOptions.PublishActivity);
    var isPaymentSetupToBeDone = @Json.Encode(GettingStartedOptions.AcceptPayments);
    var isProcessCompleted = @Json.Encode(GettingStartedOptions.ProcessCompleted);
    var isStripeIntegrated = @Json.Encode(isStripeIntegrated);

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (currentLevel == isEmailToBeValidated) {
            $('#modal-email-confirmation').modal({
                backdrop: 'static'
            });
        } else if (currentLevel == isActivityToBePublished) {
            $('#footer-activity').removeClass('hide');
        } else if (currentLevel == isPaymentSetupToBeDone) {
            $('#modal-payment-confirmation').modal({
                backdrop: 'static'
            });
        } else if (currentLevel == isProcessCompleted && isStripeIntegrated) {
            $('#modal-acceptpayment-done').modal({
                backdrop: 'static'
            });
        } else if (currentLevel == isProcessCompleted) {
            $('#footer-activity').removeClass('hide');
        }

        updateButtonClasses();
        $(window).on('resize', function () {
            updateButtonClasses();
        });
    });

    function updateButtonClasses() {
        var screen = $(window);
        if (screen.width() <= 768) {
            $('#link-dd').removeClass('btn btn-alt5').addClass('mobile-payment-btn');
            $('#link-check').removeClass('btn btn-default').addClass('mobile-payment-btn');
        } else {
            $('#link-dd').removeClass('mobile-payment-btn').addClass('btn btn-alt5');
            $('#link-check').removeClass('mobile-payment-btn').addClass('btn btn-default');
        }
    }

    function resendValidationEmail() {
        AccountSetup.sendVerificationEmail();
        $('#modal-email-confirmation-text').html('An email has been sent to <span style="color: #00b492;">@accountOwner.Email</span> Please check your inbox for next steps.');
        $('#modal-email-confirmation-btn').hide();
        $('#footer-activity').removeClass('hide');      
    }

    function hideAcceptPaymentModal() {
        $('#modal-acceptpayment-done').modal('hide');
    }
</script>