@model Account
@{
    var accountOwner = Model.GetAccountOwner();
    var activityUid = (Guid) ViewBag.ActivityUid;
    var currentLevel = Model.OnboardingCompletionStatus();
    var isStripeIntegrated = TempData["IsStripeIntegrated"] != null;
    var isActivityFree = (bool) ViewBag.IsActivityFree;
    var currentUrl = Request.Url?.ToString();
}

<div class="modal fade" id="modal-email-confirmation" role="dialog" tabindex="-1">
    <div class="modal-dialog modal-min-width" role="document">
        <div class="modal-content modal-box">
            <div class="modal-body account-getting-started-padding" style="text-align: center">
                <button aria-label="Close" class="close close-icon-position"
                        onclick="$('#modal-email-confirmation').modal('hide')" type="button">
                    <span aria-hidden="true">&times;</span>
                </button>
                <img alt="Email verification" src="~/Assets/img/email-symbol.png" style="text-align: center"/>
                <p class="modal-box-body" id="modal-email-confirmation-text">
                    Before we publish your activity, let's confirm your email.
                </p>
                <button class="margin-v-30 text-center btn btn-primary btn-free-profile"
                        id="modal-email-confirmation-btn" onclick="resendValidationEmail()" type="button">
                    Re-send verification email
                </button>
                <p class="modal-box-body" id="modal-email-confirmation-sent" style="display: none">
                    An email has been sent to <span style="color: #00b492;">@accountOwner.Email</span>
                </p>
                <p class="modal-box-body" id="modal-email-confirmation-follow-steps" style="display: none">
                    Please check your inbox for next steps.
                </p>
            </div>
        </div>
    </div>
</div>

@{ Html.RenderPartial("~/Views/Shared/_ModalPaymentConfirmation.cshtml", Model, new ViewDataDictionary {{"ActivityUid", activityUid}}); }

<div id="modal-accept-payment-done" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-min-width" role="document">
        <div class="modal-content modal-box">
            <div class="modal-body account-getting-started-padding" style="text-align: center">
                <button aria-label="Click" class="close close-icon-position"
                        onclick="$('#modal-accept-payment-done').modal('hide')" type="button">
                    <span aria-hidden="true">&times;</span>
                </button>
                <img src="~/Assets/img/email-symbol.png" alt="Complete"/>
                <p class="modal-box-body">Account setup complete!</p>
                <button class="btn btn-primary btn-free-profile" onclick="$('#modal-accept-payment-done').modal('hide')"
                        style="padding: 12px 20px;">
                    Continue
                </button>
                <p style="margin-top: 16px">
                    <a class="view-activity-text"
                       href="@Url.Action("editsetup", "activity", new {id = activityUid, area = "org"})">
                        Return to edit activity
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    let currentLevel = @Json.Encode(currentLevel);
    let isEmailToBeValidated = @Json.Encode(GettingStartedOptions.ValidateEmail);
    let isActivityToBePublished = @Json.Encode(GettingStartedOptions.PublishActivity);
    let isPaymentSetupToBeDone = @Json.Encode(GettingStartedOptions.AcceptPayments);
    let isProcessCompleted = @Json.Encode(GettingStartedOptions.ProcessCompleted);
    let isStripeIntegrated = @Json.Encode(isStripeIntegrated);
    let isActivityFreeJson = @Json.Encode(isActivityFree);

    PageEvent.add(PageEvent.AFTER_INIT, function () {
        if (currentLevel === isEmailToBeValidated) {
            $('#modal-accept-payment-done').modal({
                backdrop: 'static'
            });
        } else if (currentLevel === isActivityToBePublished) {
            $('#footer-activity').removeClass('hide');
        }
        // we do not need to show payment modal, if activity is Free
        else if (currentLevel === isPaymentSetupToBeDone) {
            if (!isActivityFreeJson) {
                $('#modal-payment-confirmation').modal({
                    backdrop: 'static'
                });
            } else if (@activityUid.IsNotEmpty().ToString().ToLower()) {
                $('#footer-activity').removeClass('hide');
            }
        } else if (currentLevel === isProcessCompleted && isStripeIntegrated) {
            $('#modal-accept-payment-done').modal({
                backdrop: 'static'
            });
        } else if (currentLevel === isProcessCompleted) {
            $('#footer-activity').removeClass('hide');
        }

        updateButtonClasses();
        $(window).on('resize', function () {
            updateButtonClasses();
        });
    });

    function updateButtonClasses() {
        let screen = $(window);
        if (screen.width() <= 768) {
            $('#link-dd').removeClass('btn btn-alt5').addClass('mobile-payment-btn');
            $('#link-check').removeClass('btn btn-default').addClass('mobile-payment-btn');
        } else {
            $('#link-dd').removeClass('mobile-payment-btn').addClass('btn btn-alt5');
            $('#link-check').removeClass('mobile-payment-btn').addClass('btn btn-default');
        }
    }

    function resendValidationEmail() {
        AccountSetup.sendVerificationEmail('@currentUrl');
        $('#modal-email-confirmation-text, #modal-email-confirmation-btn').hide();
        $('#modal-email-confirmation-sent, #modal-email-confirmation-follow-steps').show();
        $('#footer-activity').removeClass('hide');
    }
</script>