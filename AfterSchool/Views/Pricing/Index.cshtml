@model IEnumerable<AfterSchoolLibrary.Package>

@{
    ViewBag.Title = "Pricing";
}

<div class="page-head">    
    <h2>@ViewBag.Title</h2>
</div>

<div class="main-content">


    <div class="table-responsive">
        <table class="table table-striped">
            <tr>
                <td class="bg-success"></td>
                @foreach (var package in Model)
                {
                    <td class="bg-success">
                        <div class="text-center text-white bg-success padding-10">
                            <h1>@package.Name</h1>
                            <a href="@Url.Action("selectpackage", "pricing", new { id = package.Uid.ToString() })" class="btn btn-block btn-success btn-lg">Sign Up &raquo;</a>
                        </div>
                    </td>
                }
            </tr>
            <tr>
                <th class="text-right">@UILabel.ActivityLabel(true)</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center text-medium">@package.MaxActivities</td>
                }
            </tr>
            <tr>
                <th class="text-right">@UILabel.RegistrantLabel(true) / @UILabel.ActivityLabel()</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center text-medium">@package.MaxRegistrants</td>
                }
            </tr>
            <tr>
                <th class="text-right">User Accounts</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center text-medium">@package.MaxUsers</td>
                }
            </tr>
            <tr>
                <th class="text-right">Messaging to @UILabel.RegistrantLabel(true)</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasMessaging);}</td>
                }
            </tr>
            <tr>
                <th class="text-right">Manage Waiting List</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasWaitingList);}</td>
                }
            </tr>
            <tr>
                <th class="text-right">Take Attendance</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasAttendance);}</td>
                }
            </tr>
            <tr>
                <th class="text-right">Accept Payments</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasPayments);}</td>
                }
            </tr>
            <tr>
                <th class="text-right">Custom Url</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center">@{Html.RenderPartial("_BooleanToHtml", package.HasCNameUrl);}</td>
                }
            </tr>
            <tr>
                <th class="text-right">Price</th>
                @foreach (Package package in Model)
                {
                    <td class="text-center money-text">@package.Price.ToCurrency()</td>
                }
            </tr>
            <tr>
                <th class="bg-success"></th>
                @foreach (Package package in Model)
                {
                    <td class="bg-success">
                        <div class="text-center text-white bg-success padding-10">
                            <a href="@Url.Action("selectpackage", "pricing", new { id = package.Uid.ToString() })" class="btn btn-block btn-success btn-lg">Sign Up &raquo;</a>
                        </div>
                    </td>
                }
            </tr>
        </table>
    </div>
