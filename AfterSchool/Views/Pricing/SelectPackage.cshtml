@model Package

@{
    ViewBag.Title = "Sign Up";
    Layout = "~/Views/Shared/_LayoutPublicInternal.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var isTrial = (bool)ViewBag.Trial;
}

<div id="signup-section" class="signup-container">

    <div class="inner-bg">
        <div class="container">
            <div class="row">

                @{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

                <div class="col-md-6 col-lg-offset-3">
                    <div class="text-white padding-10 text-center">
                        <h2>
                            @Model.Name Plan                        
                        </h2>
                        <p><span class="text-warning">@(isTrial ? string.Format("{0}-Day Trial", Model.GetFeature(FeatureType.TrialDays).GetMaxValue()) : "")</span></p>
                    </div>
                </div>

                <div class="col-md-6 col-lg-offset-3">

                    <div class="panel panel-default">
                        <div class="panel-body">

                            <form id="signup-form" class="form-horizontal" method="post" action="@Url.Action("createaccount", "pricing", new { id = Model.Uid.ToString(), trial = isTrial.ToInteger() })">

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="firstname">First Name</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" id="firstname" name="firstname" value="@Request.Params["firstname"]" onfocus="this.select()" data-tooltip-id="firstname" required data-required data-toggle='popover' data-trigger='hover' data-content='required' data-placement='right' />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="lastname">Last Name</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" id="lastname" name="lastname" value="@Request.Params["lastname"]" onfocus="this.select()" data-tooltip-id="lastname" required data-required data-toggle='popover' data-trigger='hover' data-content='required' data-placement='right' />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="company">Organization</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" id="orgname" name="orgname" value="@Request.Params["orgname"]" onfocus="this.select()" data-tooltip-id="company" required data-required data-toggle='popover' data-trigger='hover' data-content='required' data-placement='right' />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="phone">Phone</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="text" class="form-control" id="phone" name="phone" value="@Request.Params["phone"]" onfocus="this.select()" data-tooltip-id="phone" required data-required data-toggle='popover' data-trigger='hover' data-content='required' data-placement='right' />
                                    </div>
                                </div>

                                <hr />

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="email">Email</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="email" class="form-control" id="email" name="email" value="@Request.Params["email"]" onfocus="this.select()" data-tooltip-id="email" required data-required data-toggle='popover' data-trigger='hover' data-content='required' data-placement='right' />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="password1">Password</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="password" class="form-control" id="password1" name="password1" value="" onfocus="this.select()" data-tooltip-id="password1" required data-required data-toggle='popover' data-trigger='hover' data-content='required - must be at least 8 characters' data-placement='right' />
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-4 control-label">
                                        <label for="password2">Verify Password</label>
                                    </div>
                                    <div class="col-md-8">
                                        <input type="password" class="form-control" id="password2" name="password2" value="" onfocus="this.select()" data-tooltip-id="password2" required data-required data-toggle='popover' data-trigger='hover' data-content='required - must be at least 8 characters' data-placement='right' />
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-4"></div>
                                    <div class="col-md-8">
                                        <div class="margin-b-10">
                                            <div class="g-recaptcha" data-sitekey="6Lfg2BEUAAAAADCXTFVlYUywSoqvMUgLd-tERDxO"></div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="col-md-12">
                                        <div class="am-checkbox">
                                            <input id="terms" name="terms" type="checkbox" value="1" required />
                                            <label for="terms">
                                                I understand and agree to the
                                                <a href="@Url.Action("tos", "legal")" target="_blank">Terms &amp; Conditions</a>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <button class="btn btn-createaccount btn-lg btn-block" id="btn-create-account">Create My Account &raquo;</button>
                                    <div id="form-validation-settings" data-form-validation-submit-button="btn-create-account" data-form-validation-submit-text="Create Account &raquo;" data-form-validation-submitting-text="Creating Account..."></div>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#signup-form').submit(function () {
            $('#btn-create-account').html('Creating Account...');
            $('#btn-create-account').prop('disabled', true);
        });
    });
</script>

                
