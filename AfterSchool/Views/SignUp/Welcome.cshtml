            </div>
            <div class="clearfix"></div>

            <a href="#" style="margin-left: -120px;" onclick="return proceedBack('@EnumSignupPages.SelectUserType')">
                <img style="margin-top: -150px;" src="~/Assets/img/welcome-back-arrow.png"/>
            </a>
        </div>
    </div>

    <div class="visible-xs visible-sm welcome-outer-ring" style="margin-bottom: 20px;">
        <div class="mobile-inner-ring">
            <h2 class="text-center common-font" style="font-size: 24px;">What would you like to do?</h2>
            <div class="clearfix"></div>

            <div class="row margin-t-35">
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return proceedFurther('@EnumSignupPages.SearchProgramName')">Provide programs for students</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return proceedFurther('@EnumSignupPages.SearchSchool')">Enroll my child in a program</button>
            </div>
            <div class="clearfix"></div>

            <div class="text-center margin-v-30">
                <a href="#" class="text-muted" onclick="return proceedBack('@EnumSignupPages.SelectUserType')">Back</a>
            </div>
        </div>
    </div>

</div>

<div class="clearfix"></div>
<div id="signup-orgtype" style="display: none;">

    <div class="visible-lg visible-md welcome-outer-ring">
        <div class="welcome-inner-ring">
            <h2 class="text-center common-font" style="font-size: 24px;">What kind of organization?</h2>
            <div class="clearfix"></div>

            <div class="row margin-t-35">
                <div class="col-md-offset-2 col-md-4">
                    <button type="button" class="btn btn-primary btn-center btn-common btn-org-height-width" style="padding: 15px 57px 16px 58px;" onclick="return setOrgTypeAndProceedFurther('@AccountType.Business')">Business</button>
                    <div class="clearfix"></div><br/>

                    <button type="button" class="btn btn-primary btn-center btn-common btn-org-height-width" style="padding: 16px 69px 15px;" onclick="return setOrgTypeAndProceedFurther('@AccountType.School')">School</button>
                    <div class="clearfix"></div><br/>

                    <button type="button" class="btn btn-primary btn-center btn-org-height-width btn-org-common" onclick="return setOrgTypeAndProceedFurther('@AccountType.CommunityCenter')">Community Center</button>
                    <div class="clearfix"></div><br/>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-primary btn-center btn-org-height-width btn-org-common" onclick="return setOrgTypeAndProceedFurther('@AccountType.Church')">Church</button>
                    <div class="clearfix"></div><br/>

                    <button type="button" class="btn btn-primary btn-center btn-org-height-width btn-org-common" onclick="return setOrgTypeAndProceedFurther('@AccountType.ActivityProvider')">Non Profit</button>
                    <div class="clearfix"></div><br/>

                    <button type="button" class="btn btn-primary btn-center btn-org-height-width btn-org-common" onclick="return setOrgTypeAndProceedFurther('@AccountType.ActivityProvider')">Other</button>
                    <div class="clearfix"></div><br/>
                </div>
                <div class="clearfix"></div><br/>

            </div>
            <div class="clearfix"></div>

            <a href="#" style="margin-left: -120px;" onclick="return proceedBack('@EnumSignupPages.SelectUserType')">
                <img style="margin-top: -270px;" src="~/Assets/img/welcome-back-arrow.png"/>
            </a>
        </div>
    </div>

    <div class="visible-xs visible-sm welcome-outer-ring" style="margin-bottom: 20px;">
        <div class="mobile-inner-ring">
            <h2 class="text-center common-font" style="font-size: 24px;">What kind of organization?</h2>
            <div class="clearfix"></div>

            <div class="row margin-t-35">
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return setOrgTypeAndProceedFurther('@AccountType.Business')">Business</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return setOrgTypeAndProceedFurther('@AccountType.School')">School</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return setOrgTypeAndProceedFurther('@AccountType.CommunityCenter')">Community Center</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return setOrgTypeAndProceedFurther('@AccountType.Church')">Church</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return setOrgTypeAndProceedFurther('@AccountType.ActivityProvider')">Non Profit</button>
                <div class="clearfix"></div><br/>
            </div>
            <div class="clearfix"></div>

            <div class="text-center margin-v-30">
                <a href="#" class="text-muted" onclick="return proceedBack('@EnumSignupPages.SelectUserType')">Back</a>
            </div>
        </div>
    </div>
</div>

<div class="clearfix"></div>
<div id="signup-search-name" style="display: none;">
    <div class="welcome-outer-ring">
        <div class="search-inner-ring">
            <div class="">

                <div class="visible-md visible-lg">
                    <a href="#" style="margin-left: -120px;" onclick="return proceedBack('@EnumSignupPages.SearchProgramName')">
                        <img style=" position: fixed; margin-top: 150px;" src="~/Assets/img/welcome-back-arrow.png"/>
                    </a>
                </div>

                <h2 id="lbl-org-search-title" class="text-center"></h2>
                <div class="clearfix"></div>

                <div class="row margin-t-35">
                    <div class="col-md-12">
                        <label id="signup-search-label"></label>
                        <span class="label" style="color: #777777;">(Max character Limit 50)</span>
                        <span class="label" style="color: #777777;">(Remaining <span id="remaining-search-char-counter">50</span> characters)</span>
                        <input id="signup-account-search" type="text" class="form-control" autocomplete="off"/>
                        <div id="signup-account-search-list" class="border-light-gray pointer hide"></div>
                    </div>
                    <div class="clearfix"></div><br/>
                </div>
            </div>
            <div class="clearfix"></div><br/>

            <div class="visible-md visible-lg">
                <button type="button" class="btn-SearchContinue btn btn-primary btn-center btn-org-height-width register-continue" disabled="disabled" onclick="return decideToProceedFurther(this)">Continue</button>
            </div>

            <div class="visible-sm visible-xs">
                <button type="button" class="btn-SearchContinue btn btn-primary btn-lg pull-right col-xs-12 register-continue" disabled="disabled" onclick="return decideToProceedFurther(this)">Continue</button>

                <div class="clearfix"></div>
                <div class="text-center margin-v-30">
                    <a href="#" class="text-muted" onclick="return proceedBack('@EnumSignupPages.SearchProgramName')">Back</a>
                </div>
            </div>
            <div class="clearfix"></div><br/>
        </div>
    </div>
</div>

<div class="clearfix"></div>
<div id="signup-register" style="display: none;">
    <div class="welcome-outer-ring m-b-20">
        <div class="search-inner-ring p-b-5">
            <div class="margin-t-35">

                <p class="register-thankyou-1">Thanks for joining our platform to provide learning opportunities for students everywhere.</p>
                <p class="register-thankyou-2" style="margin-bottom: 20px;">We just need a little information to get started.</p>

                <div class="clearfix"></div><br/>
                <form id="form-signup-personal-details" class="form-horizontal" method="post" action="@Url.Action("indexnew", "signup")">
                    @{ Html.RenderPartial("~/Views/Shared/Login/_SignUpForm-NewAccount-Welcome.cshtml", Model); }
                    <div class="clearfix"></div>
                </form>

            </div>
            <div class="clearfix"></div>
        </div>
    </div>
</div>

<div class="clearfix"></div>
<div id="signup-claim-profile" style="display: none;">
    <div class="welcome-outer-ring m-b-20">
        <div class="search-inner-ring p-b-5">

            <h2 id="header-claim-profile-main" class="text-center"></h2>
            <div class="clearfix"></div><br/>
            <h5 id="header-account-exist" class="text-center register-thankyou-2" style="display: none;">This profile already exists on AfterSchool HQ. Please start the claim process below.</h5>
            <p id="header-account-claimed" class="text-center register-thankyou-2">This profile already claimed on AfterSchool HQ. You can request access by entering your information below.</p>
            <div class="clearfix"></div>

            <div class="margin-t-35">
                <form id="form-signup-claim-form" class="form-horizontal">
                    @Html.AntiForgeryToken()

                    <input id="hidden-claim-accountId" type="hidden" name="accountId"/>
                    <input id="hidden-account-profileUrl" type="hidden" name="profileUrl" value=""/>
                    <input id="hidden-current-page" type="hidden" name="currentPage" value=""/>

                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label">FIRST NAME</label>
                        <input class="form-control onboarding-input" type="text" required="required" name="firstName">
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label">LAST NAME</label>
                        <input class="form-control onboarding-input" type="text" required="required" name="lastName">
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label">EMAIL ADDRESS</label>
                        <input class="form-control onboarding-input" type="email" required="required" name="email">
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-12 onboarding-form-group">
                        <label class="onboarding-label">PHONE</label>
                        <input id="signup-claim-profile-phone" class="form-control onboarding-input" placeholder="ex. (317) 483 3489" type="text" required="required" name="phone">
                    </div>
                    <div class="clearfix"></div>

                    <div class="col-md-12 onboarding-form-group text-center" style="margin-top: 20px;">
                        @if (!Utilities.IsLocalHost)
                        {
                            Html.RenderPartial("~/Views/Shared/Form/_Recaptcha.cshtml", "");
                        }
                    </div>
                    <div class="clearfix"></div>

                    <div class="visible-sm visible-xs margin-v-30">
                        <button type="button" class="btn-save-claims btn btn-primary btn-lg pull-right col-xs-12 register-continue" onclick="return saveClaims(this)"></button>

                        <div class="clearfix"></div>
                        <div class="text-center margin-v-30">
                            <a href="#" class="text-muted" onclick="return proceedBack('@EnumSignupPages.ClaimProfile')">Back</a>
                        </div>
                    </div>

                    <div class="visible-md visible-lg margin-v-30">
                        <a href="#" class="process-back" onclick="return proceedBack('@EnumSignupPages.ClaimProfile')">
                            <img src="~/Assets/img/welcome-back-arrow.png"/>
                        </a>
                        <button type="button" class="btn-save-claims btn btn-primary btn-lg pull-right register-continue" onclick="return saveClaims()"></button>
                    </div>

                    <div class="clearfix"></div><br/>
                </form>
            </div>

        </div>
    </div>
</div>

<div class="clearfix"></div>
<div id="signup-thank-you" style="display: none;">
    <div class="welcome-outer-ring">
        <div class="search-inner-ring" style="min-height: 509px;padding-bottom: 5px;">
            <h2 class="text-center">Thank You!</h2>
            <div class="clearfix"></div><br/>
            <h5 id="header-thankyou-not-recognized" class="text-center" style="display: none;">We have sent an email with instructions to <strong id="lbl-org-member-email"></strong>.</h5>
            <h5 id="header2-thankyou-not-recognized" class="text-center" style="display: none;">No longer have access to this email? Incorrect email? Click <a href="#" onclick="return contactSupport()">Here</a> to automatically submit a request to our support team.</h5>

            <div id="header3-thankyou-not-recognized" class="col-md-offset-3 alert alert-info alert-icon alert-border-color alert-dismissible" role="alert" style="display: none; width: 50%; margin-top: 40px; text-align: center;">
                <div class="icon">
                    <span class="s7-info"></span>
                </div>
                <div class="message">
                    <button class="close" data-dismiss="alert" aria-label="Close">
                        <span class="s7-close" aria-hidden="true"></span>
                    </button><strong>We have sent your request!</strong> You should hear back from us in the next 24-48 hours.
                </div>
            </div>

            <h5 id="header-thankyou-recognized" class="text-center" style="display: none;">We see that you have email from same domain. We have sent you instruction to claim your account.</h5>
            <h5 id="header-thankyou-request-access" class="text-center" style="display: none;font-size: 22px; font-weight: 600; font-stretch: normal; font-style: normal; line-height: normal; letter-spacing: 0.53px; text-align: center; color: rgb(74, 74, 74); margin-bottom: 40px;" ">Your access request has been sent to the owner of this profile.</h5>
            <div class="clearfix"></div><br/>
        </div>
    </div>
</div>
</div>


<div class="modal" tabindex="-1" role="dialog" id="NoAccountFoundPopup">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" style="padding-top:0">
                <h5 class="text-center">Invite account not found</h5>
                <p>
                    Oh no! Your invite got lost in transit! We’ll have that sorted out in no time. <strong>Please follow the instructions below and then proceed with your account setup.</strong>
                </p>

                <p>To connect your account with the account that invited you, please contact our support team with:</p>

                <ul>
                    <li>The email address you’re using to sign up</li>
                    <li>The name or email address of the account that invited you.</li>
                </ul>

                <p class="text-center">
                    <a href=" https://afterschoolhq.zendesk.com/hc/en-us/requests/new" target="_blank" class="btn btn-primary">Contact Support</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/Scripts/jquery.validate.js"></script>
    <script type="text/javascript">

        var searchTimeout = null;
        var isSearching = false;
        var isOrganization = false;
        var isSchool = false;
        var isSearchSchoolPage =  false;
        var hasAccountProfileUrl = false;
        var selectedAccount = '';
        var signupWelcome = $('#signup-welcome');
        var signupSelectUsertype = $('#signup-select-usertype');
        var signupIndividualType = $('#signup-individualtype');
        var signupOrgType = $('#signup-orgtype');
        var signupSearchName = $('#signup-search-name');
        var signupRegister = $('#signup-register');
        var signupClaimProfile = $('#signup-claim-profile');
        var signupThankYou = $('#signup-thank-you');
        var lblOrgSearchTitle = $('#lbl-org-search-title');
        var lblOrgMemberEmail = $('#lbl-org-member-email');
        var btnContinue = $('.btn-SearchContinue'); //class based identification due to responsiveness issues
        var btnSaveClaims = $('.btn-save-claims'); //class based identification due to responsiveness issues
        var formClaimProfile = $('#form-signup-claim-form');
        var headerClaimProfileMain = $('#header-claim-profile-main');
        var headerAccountExist = $('#header-account-exist');
        var headerAccountClaimed = $('#header-account-claimed');
        var headerRecognisedThankYou = $('#header-thankyou-recognized');
        var headerThankYouRequestAccess = $('#header-thankyou-request-access');
        var headerThankYouNR1 = $('#header-thankyou-not-recognized');
        var headerThankYouNR2 = $('#header2-thankyou-not-recognized');
        var headerThankYouNR3 = $('#header3-thankyou-not-recognized');
        var hiddenClaimAccountId = $('#hidden-claim-accountId'); // this one is for existing accounts
        var hiddenAccountProfileUrl = $('#hidden-account-profileUrl'); // this one is for account profile url
        var hiddenAccountName = $('#hidden-signup-accountName'); // this one is for creating new account flow and placed inside partial view
        var hiddenAccountType = $('#hidden-signup-accountType');
        var signupAccountSearchList = $('#signup-account-search-list');
        var signupAccountSearch = $('#signup-account-search');
        var signupSearchLable = $('#signup-search-label');
        var signupListItemClass = "text-small padding-10";
        var signupListItemStyle = "background-color: #f0f0f0;";
        var signupListLastItemStyle = "background-color: #ddeae0;";
        var signupListItemStyleHover = "background-color: #fcfcfc;";
        var signupListOnMouseOver = "signupListMouseOver";
        var signupListOnMouseOut = "signupListMouseOut";
        var signupListOnClick = "signupListMouseClick";
        var spanRemainingCharCounter = $('#remaining-search-char-counter');

        // check for teachers signing up for 1099, redirect to user registration
        if (@Json.Encode(Model.SignupType) === @Json.Encode(SignUpType.Teacher1099)) {
            signupWelcome.hide();
            hiddenAccountType.val('@AccountType.Teacher');
            proceedFurther('@EnumSignupPages.Register');
        }

        PageEvent.add(PageEvent.AFTER_INIT, function () {

            signupAccountSearch.keyup(function (e) {
            
                var searchLength = signupAccountSearch.val().length;

                if (searchLength >= 40) {
                    spanRemainingCharCounter.text(50).css('color', 'red');
                } else {
                    spanRemainingCharCounter.text(50).css('color', '#777777');
                }

                if (searchLength < 50) {
                    spanRemainingCharCounter.text(50 - searchLength);
                }
                else if (searchLength == 50) {
                    e.preventDefault();
                    spanRemainingCharCounter.text(0);
                } else if (searchLength > 50) {
                    e.preventDefault();
                    e.stopPropagation();
                    this.value = this.value.substring(0, 50);
                    spanRemainingCharCounter.text(0);
                    return false;
                }

                if (searchLength <= 2) {
                    signupAccountSearchList.html('');
                    signupAccountSearchList.addClass('hide');
                    btnContinue.prop('disabled', true);
                    return false;
                } else if (!isSearchSchoolPage) {
                    btnContinue.prop('disabled', false);
                    hiddenAccountName.val(signupAccountSearch.val());
                }                        
                
                if (isSearchSchoolPage)
                {                
                    signupAccountSearchList.removeClass('hide');
                    signupAccountSearchList.html('');
                    signupAccountSearchList.append(`
                    <div class="${signupListItemClass}"
                        style="${signupListItemStyle}"
                        id="signup-search-listItem">
                        <strong>Searching... Type the account name</strong>
                    </div>`);
    
                    if (!isSearching) {
                        clearTimeout(searchTimeout);
                    }
    
                    searchTimeout = setTimeout(function () {
                        doAccountSearch(signupAccountSearch, signupAccountSearchList)
                    }, 250);
                }


            });

              @if (showInviteWelcome && Model.InvitingAccount.IsEmpty())
              {
                  <text>$("#NoAccountFoundPopup").modal('show');</text>
              }
        });
        
        function validateEmailServerSide(value) {
            
            // this is getting hit as soon as the page loads in Edge for some reason
            // need to review
            return;
            
            if (value.length > 0 && validateEmail(value)) {
                var dataToSend = JSON.stringify({ emailId: value });
                $.ajax({
                    url: '/Signup/IsEmailAlreadyExists',
                    type: 'post',
                    dataType: 'json',
                    data: dataToSend,
                    contentType: 'application/json',
                    success: function (data) {
                        if (!data.error) {
                            if (!data.success) {
                                Notifications.showBar({
                                    title: 'Error',
                                    message: 'Email id already exists.',
                                    success: false
                                });
                                $(".register-continue").prop('disabled', true);
                                $("#email").attr('style', 'border: 1px solid red;');
                            }
                            else {
                                $(".register-continue").prop('disabled', false);
                                $("#email").removeAttr('style');
                            }
                        }
                        else {
                            Notifications.showBar({
                                title: 'Error',
                                message: 'Something went wrong. Please contact customer support.',
                                success: false
                            });
                            
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong. Please contact customer support.',
                            success: false
                        });
                        
                    }
                });
            }
            else {
                Notifications.showBar({
                    title: 'Error',
                    message: 'Email id is not in valid format.',
                    success: false
                });
                $(".register-continue").prop('disabled', true);
                $("#email").attr('style', 'border: 1px solid red;');
            }
        }
        function signupListMouseOver(id) {
            $(`#signup-search-listItem-${id}`).attr('style', signupListItemStyleHover);
        }

        function signupListMouseOut(id) {
            $(`#signup-search-listItem-${id}`).attr('style', signupListItemStyle);
        }

        function signupListMouseClick(id, text, slug, isClaimed) {
            if (id && isGuid(id)) {
                hiddenClaimAccountId.val(id);
                selectedAccount = {
                    id,
                    text,
                    isClaimed
                };

                signupAccountSearch.val(text);

                if (isSchool) {
                    var profileUrl = slug;
                    hiddenAccountProfileUrl = profileUrl;
                    hasAccountProfileUrl = true;
                    signupAccountSearchList.addClass('hide');
                }

                if (isClaimed == false) {
                    var url = slug + '?claimprofile=1';
                    window.location = url; //move to profile page
                }
            } else {
                selectedAccount = null; //support for back click
                hiddenAccountName.val(signupAccountSearch.val())
            }

            signupAccountSearchList.addClass('hide');
            btnContinue.removeAttr("disabled");
        }

        function doAccountSearch(search, list) {
            
            if (search.val().length > 0 && !isSearching) {
                isSearching = true;

                $.get(
                    `@Url.Action("GetData", "SignUp", new { Area = "" })?search=${search.val()}`,
                    function (data) {

                        isSearching = false;

                        if (data && data.success == true) {

                            list.html('');

                            for (let account of data.accounts) {
                                var name = `${account.Text.replace(/'/g, "\\'")}`;
                                var isClaimed = false;
                                if (typeof account.IsClaimed === "boolean") {
                                    isClaimed = Boolean(account.IsClaimed);
                                }

                                list.append(`
                                    <div class="${signupListItemClass}"
                                        style="${signupListItemStyle}"
                                        id="signup-search-listItem-${account.Id}"
                                        onmouseover="${signupListOnMouseOver}('${account.Id}')"
                                        onmouseout="${signupListOnMouseOut}('${account.Id}')"
                                        onclick="${signupListOnClick}('${account.Id}', '${name}', '${account.Slug}', ${isClaimed})">
                                        <strong>${account.Text}</strong>
                                    </div>`);
                            }

                            if (data.accounts.length == 0) {
                                signupListMouseClick('0');
                            }

                            if (search.val().length >= 3) {
                                var borderStyle = '';
                                if (data.accounts.length > 0) {
                                    borderStyle = 'border-top: 1px solid;'
                                }

                                var placeholder = '';
                                if (isSchool) {
                                    placeholder = `Can't find your school, organization, or program ? Click 'Continue' below`;
                                } else {
                                    placeholder = `Can't find your ${isOrganization ? 'organization' : 'program'}? Enter the name of your ${isOrganization ? 'organization' : 'program'} then click here.`;
                                }

                                list.append(`
                                <div
                                    style="${signupListLastItemStyle} ${borderStyle}"
                                    class="${signupListItemClass}"
                                    id="signup-search-listItem-0"
                                    onclick="${signupListOnClick}('0')">
                                    <strong> ${placeholder} </strong>
                                </div>`);
                            }

                            list.removeClass('hide');

                        } else {
                            Notifications.showBar({
                                title: 'Error',
                                message: 'Error loading accounts',
                                success: false
                            });
                        }
                    }
                );
            }
        }

        function proceedFurther(page) {
            if (page === '@EnumSignupPages.WelCome') {
                // we are at welcome page and moving further to select user type
                signupWelcome.hide();
                signupSelectUsertype.show();
            } else if (page === '@EnumSignupPages.SelectIndividualType') {
                // user clicked btn-CreateIndividualAccount, and going for signup-IndividualType
                signupSelectUsertype.hide();
                signupIndividualType.show();
            } else if (page === '@EnumSignupPages.SelectOrgType') {
                // user clicked btn-CreateOrgAccount, and going for signup-OrgType
                signupSelectUsertype.hide();
                signupOrgType.show();
            } else if (page === '@EnumSignupPages.SearchProgramName') {
                // user clicked btn-ProgramForStudents, and going for name search for his/her program
                isOrganization = false;
                isSchool = false;
                hiddenAccountType.val('@AccountType.Teacher');
                lblOrgSearchTitle.text('What\'s the name of your program?');
                signupSearchLable.html('ENTER YOUR PROGRAM NAME');
                clearSearch();
                signupIndividualType.hide();
                signupSearchName.show();
            } else if (page === '@EnumSignupPages.SearchOrgName') {
                // user is from the organization, and going for name search for his/her organization
                isOrganization = true;
                isSchool = false;
                lblOrgSearchTitle.text('What\'s the name of your organization?');
                signupSearchLable.html('ENTER YOUR ORGANIZATION NAME');
                clearSearch();
                signupOrgType.hide();
                signupSearchName.show();
            } else if (page === '@EnumSignupPages.SearchSchool') {
                isSchool = true;
                isOrganization = false;
                lblOrgSearchTitle.text('Find your school, organization or program');
                signupSearchLable.html('SEARCH OR ADD YOUR SCHOOL, ORGANIZATION OR PROGRAM NAME')
                $("#hidden-current-page").val('@EnumSignupPages.SearchSchool');
                isSearchSchoolPage = true;
                clearSearch();
                signupIndividualType.hide();
                signupSearchName.show();
            } else if (page === '@EnumSignupPages.Register') {
                // user hasn't selected the system account and added a free text, so direct him to register screen
                signupSearchName.hide();
                signupRegister.show();
            } else if (page === '@EnumSignupPages.ClaimProfile') {
                // user has selected the system account, so direct him to claim profile
                signupSearchName.hide();
                signupClaimProfile.show();
            }
        }

        function decideToProceedFurther(input) {

            if (isSchool && isSearchSchoolPage && hasAccountProfileUrl) {
                window.location = hiddenAccountProfileUrl; //move to profile page
                return;
            } else if (isSchool && isSearchSchoolPage && !hasAccountProfileUrl)
            {
                selectedAccount = null; //support for back click
                hiddenAccountName.val(signupAccountSearch.val())
                    window.location = `@Url.Content("~/parents.html")`;
                    return;
            }

            if (input && $(input).hasClass('disabled')) {
                Notifications.showBar({
                    title: 'Error',
                    message: ' Program name is required',
                    success: false
                });
                return;
            }
            if (selectedAccount) {
                if (selectedAccount.isClaimed) {
                    headerClaimProfileMain.text('Request Access');
                    headerAccountExist.hide();
                    headerAccountClaimed.show();
                    proceedFurther('@EnumSignupPages.ClaimProfile');
                    btnSaveClaims.html('Request Access');
                } else {
                    headerClaimProfileMain.text('Claim Profile');
                    headerAccountClaimed.hide();
                    headerAccountExist.show();
                    proceedFurther('@EnumSignupPages.ClaimProfile');
                    btnSaveClaims.html('Start the claim process');
                }

            } else {
                proceedFurther('@EnumSignupPages.Register');
            }
        }

        function setOrgTypeAndProceedFurther(input) {
            if (input) {
                hiddenAccountType.val(input);
                proceedFurther('@EnumSignupPages.SearchOrgName');
            }
        }

        function saveClaims() {
            if (formClaimProfile.valid()) {
                var formData = formClaimProfile.serialize();
                var url = '@Url.Action("SaveClaims", "SignUp", new { Area = "" })';

                $.ajax({
                    url: url,
                    data: formData,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (data && data.success == false) {
                            var errors = ''
                            data.data.forEach(function (error) {
                                if (error && error.Text) {
                                    errors += '<li style="color: white;">' + error.Text + '</li>';
                                }
                                else {
                                    errors += '<li style="color: white;">' + error + '</li>';
                                }
                            });
                            Notifications.showBar({
                                title: 'Error',
                                message: errors,
                                success: false
                            });
                            return false;
                        } else if (data && data.data) {
                            if (selectedAccount.isClaimed) {
                                headerThankYouRequestAccess.show();
                                signupClaimProfile.hide();
                                signupThankYou.show();
                            } else {
                                // email not recognised
                                lblOrgMemberEmail.text(data.data);
                                headerThankYouNR1.show();
                                headerThankYouNR2.show();
                                signupClaimProfile.hide();
                                signupThankYou.show();
                            }
                        } else { // email recognised
                            headerRecognisedThankYou.show();
                            signupClaimProfile.hide();
                            signupThankYou.show();
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log(errorThrown);
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong. Please contact customer support.',
                            success: false
                        });
                        
                    }
                });
            }
        }

        function contactSupport() {
            if (formClaimProfile.valid()) {
                var formData = formClaimProfile.serialize();
                $.ajax({
                    url: '@Url.Action("ContactSupport", "SignUp", new { Area = "" })',
                    data: formData,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (data && data.success == false) {
                            Notifications.showBar({
                                title: 'Error',
                                message: 'Something went wrong. Please contact customer support.',
                                success: false
                            });
                            return false;
                        } else { // contact support email sent
                            headerThankYouNR2.hide();
                            headerThankYouNR3.show();
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log(errorThrown);
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong. Please contact customer support.',
                            success: false
                        });
                        
                    }
                });
            }
        }

        function isGuid(value) {
            var regex = /[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}/i;
            var match = regex.exec(value);
            return match != null;
        }

        function proceedBack(page) {
            if (page === '@EnumSignupPages.WelCome') {
                signupWelcome.show();
                signupSelectUsertype.hide();
            } else if (page === '@EnumSignupPages.SelectUserType') {
                signupOrgType.hide();
                signupIndividualType.hide();
                signupSelectUsertype.show();
            } else if (page === '@EnumSignupPages.SearchProgramName') {
                if (isOrganization) {
                    signupOrgType.show();
                }
                else {
                    signupIndividualType.show();
                }
                signupSearchName.hide();
            } else if (page === '@EnumSignupPages.ClaimProfile') {
                signupSearchName.show();
                signupRegister.hide();
                signupClaimProfile.hide();
            }
        }

        function clearSearch() {
            selectedAccount = null;
            hiddenClaimAccountId.val('');
            hiddenAccountProfileUrl.val('');
            hiddenAccountName.val('');
            signupAccountSearch.val('');
            btnContinue.prop('disabled', true);
        }

    // #region: phone number validation

        var inputElement = document.getElementById('signup-claim-profile-phone');
        inputElement.addEventListener('keydown', enforceFormat);
        inputElement.addEventListener('keyup', formatToPhone);

    // #endregion: phone number validation

    </script>

}