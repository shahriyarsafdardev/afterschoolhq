@model SignUpIndexViewModel
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var EnumSignupPages = new
    {
        WelCome = 0,
        SelectUserType = 1,
        SelectIndividualType = 2,
        SelectOrgType = 3,
        SearchProgramName = 4,
        SearchOrgName = 5,
        Register = 6,
        ClaimProfile = 7
    };
    var model = new SignUpIndexViewModel();
}

<div class="row main-content">

    <div id="signup-welcome">
        <h2 class="text-center">Welcome</h2>
        <div class="clearfix"></div>

        <div class="row col-md-offset-1 margin-t-35">
            <div class="visible-lg visible-md">
                <div class="pull-left">
                    <img src="https://afterschoolhq-qa.s3.us-east-2.amazonaws.com/MathsClub/logo/nyc-5323170_640.jpg" alt="Allison" class="img-thumbnail" style="max-width: 230px;">
                </div>
                <div class="p-description col-md-8">
                    <p class="text-medium-small">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum.</p>
                    <div class="text-medium text-sm-center"> Name | Role </div>
                </div>
                <div class="clearfix"></div>
            </div>

            <div class="visible-xs visible-sm">
                <div class="p-description col-sm-12 col-xs-12 text-center">
                    <p class="text-medium-small">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum.</p>
                    <div class="text-medium text-sm-center"> Name | Role </div>
                </div>
                <div class="clearfix"></div>
                <div class="text-center col-sm-12 col-xs-12 margin-t-30">
                    <img src="https://afterschoolhq-qa.s3.us-east-2.amazonaws.com/MathsClub/logo/nyc-5323170_640.jpg" alt="Allison" class="img-thumbnail" style="max-width: 350px;">
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>

        <div class="clearfix"></div>

        <div class="text-center margin-v-40">
            <button id="btn-GetStarted" type="button" class="col-md-offset-5 col-md-2 col-sm-12 col-xs-12 btn btn-lg btn-primary" onclick="return proceedFurther('@EnumSignupPages.WelCome')">Get Started</button>
            <div class="clearfix"></div>
        </div>
        <div class="clearfix"></div>
    </div>

    <div id="signup-select-usertype" style="display: none;">
        <h2 class="text-center">What would you like to do?</h2>
        <div class="clearfix"></div>

        <div class="row margin-t-35">
            <button id="btn-CreateIndividualAccount" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SelectIndividualType')">Create an Individual Account</button>
            <div class="clearfix"></div><br />
            <button id="btn-CreateOrgAccount" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SelectOrgType')">Create an Organization Account</button>
        </div>
    </div>

    <div id="signup-individualtype" style="display: none;">
        <h2 class="text-center">What would you like to do?</h2>
        <div class="clearfix"></div>

        <div class="row margin-t-35">
            <button id="btn-ProgramForStudents" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchProgramName')">Provide programs for students</button>
            <div class="clearfix"></div><br />
            <button id="btn-EnrollChild" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center">Enroll my child in a program</button> @*TODO: move user to /parent*@
        </div>
    </div>

    <div id="signup-orgtype" style="display: none;">
        <h2 class="text-center">What kind of organization?</h2>
        <div class="clearfix"></div>

        <div class="row margin-t-35">
            <button id="btn-Business" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Business</button>
            <div class="clearfix"></div><br />
            <button id="btn-School" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">School</button>
            <div class="clearfix"></div><br />
            <button id="btn-CommunityCenter" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Community Center</button>
            <div class="clearfix"></div><br />
            <button id="btn-Church" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Church</button>
            <div class="clearfix"></div><br />
            <button id="btn-NonProfit" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Non Profit</button>
        </div>
    </div>

    <div id="signup-search-name" style="display: none;">
        <h2 id="lbl-org-search-title" class="text-center"></h2>
        <div class="clearfix"></div>

        <div class="row margin-t-35">
            <div class="col-md-8 col-md-offset-2">
                <select id="select2-search-organizations" style="width: 100%;"></select>
            </div>
            <div class="clearfix"></div><br />

            <button id="btn-SearchContinue" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center disabled" onclick="return decideToProceedFurther(this)">Continue</button>
            <div class="clearfix"></div><br />
        </div>
    </div>

    <div id="signup-register" class="sign-up margin-h-auto" style="display: none;">
        <div class="panel panel-default">
            <div class="panel-heading">
                <a href="/"><img src="@UILabel.ProductLogoInverse()" alt="logo" style="max-width: 100%; width: 350px;" class="logo-img"></a>
            </div>
            <div class="panel-body">
                <p class="text-medium-small text-center">Thanks for joining our platform to provide learning opportunities for students everywhere.</p>
                <p class="text-medium-small text-center">We just need a little information to get started.</p>

                <form id="form-signup-personal-details" class="form-horizontal" method="post" action="@Url.Action("index", "signup")">
                    @{ Html.RenderPartial("~/Views/Shared/Login/_SignUpForm-NewAccount.cshtml", Model); }

                    @* TODO *@
                    <input id="hidden-signup-accountname" type="hidden" name="accountName" />
                </form>

            </div>
        </div>
        <div class="text-center out-links"><a href="/">&copy; @DateTime.UtcNow.Year @UILabel.ProductName()</a></div>
    </div>

    <div id="signup-claim-profile" style="display: none;">
        <h2 class="text-center">Claim Profile</h2>
        <div class="clearfix"></div><br />
        <h5 class="text-center">This profile already exists on AfterSchool HQ. Please start the claim process below.</h5>
        <div class="clearfix"></div><br />

        <div class="row margin-t-35">
            <form id="form-signup-claim-form" class="form-horizontal">
                @Html.AntiForgeryToken()

                <input id="hidden-claim-accountId" type="hidden" name="accountId" />

                <div class="form-group row">
                    <div class="col-md-6 col-md-offset-3">
                        <input class="form-control" type="text" required="required" name="firstName" placeholder="First Name">
                    </div>
                </div>
                <div class="clearfix"></div>

                <div class="form-group row">
                    <div class="col-md-6 col-md-offset-3">
                        <input class="form-control" type="text" required="required" name="lastName" placeholder="Last Name">
                    </div>
                </div>
                <div class="clearfix"></div>

                <div class="form-group row">
                    <div class="col-md-6 col-md-offset-3">
                        <input class="form-control" type="email" required="required" name="email" placeholder="Email">
                    </div>
                </div>
                <div class="clearfix"></div>

                <div class="form-group row">
                    <div class="col-md-6 col-md-offset-3">
                        <input class="form-control" type="number" required="required" name="phone" placeholder="Phone">
                    </div>
                </div>
                <div class="clearfix"></div>

                <button id="btn-StartClaimProcess" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return saveClaims()">Start the claim process</button>
                <div class="clearfix"></div><br />
            </form>
        </div>
    </div>

    <div id="signup-thank-you" style="display: none;">
        <h2 class="text-center">Thank You!</h2>
        <div class="clearfix"></div><br />
        <h5 id="header-thankyou-not-recognized" class="text-center" style="display: none;">We have sent an email with instructions to <strong id="lbl-org-member-email"></strong>.</h5>
        <h5 id="header2-thankyou-not-recognized" class="text-center" style="display: none;">No longer have access to this email? Incorrect email? Click <a href="#" onclick="return contactSupport()">Here</a> to automatically submit a request to our support team.</h5>

        <div id="header3-thankyou-not-recognized" class="col-md-offset-3 alert alert-info alert-icon alert-border-color alert-dismissible" role="alert" style="display: none; width: 50%; margin-top: 40px; text-align: center;">
            <div class="icon"><span class="s7-info"></span></div>
            <div class="message">
                <button class="close" data-dismiss="alert" aria-label="Close"><span class="s7-close" aria-hidden="true"></span></button><strong>We have sent your request!</strong> You should hear back from us in the next 24-48 hours.
            </div>
        </div>

        <h5 id="header-thankyou-recognized" class="text-center" style="display: none;">We see that you have email from same domain. We have sent you instruction to claim your account.</h5>
        <div class="clearfix"></div><br />
    </div>

</div>

@section Scripts
{
    <script src="~/Scripts/jquery.validate.js"></script>
    <script type="text/javascript">
        var selectedAccount = '';
        var signupWelcome = $('#signup-welcome');
        var signupSelectUsertype = $('#signup-select-usertype');
        var signupIndividualType = $('#signup-individualtype');
        var signupOrgType = $('#signup-orgtype');
        var signupSearchName = $('#signup-search-name');
        var signupRegister = $('#signup-register');
        var signupClaimProfile = $('#signup-claim-profile');
        var signupThankYou = $('#signup-thank-you');
        var lblOrgSearchTitle = $('#lbl-org-search-title');
        var lblOrgMemberEmail = $('#lbl-org-member-email');
        var btnContinue = $('#btn-SearchContinue');
        var btnClaimProcess = $('#btn-StartClaimProcess');
        var select2SearchOrganizations = $('#select2-search-organizations');
        var formClaimProfile = $('#form-signup-claim-form');
        var headerRecognisedThankYou = $('#header-thankyou-recognized');
        var headerThankYouNR1 = $('#header-thankyou-not-recognized');
        var headerThankYouNR2 = $('#header2-thankyou-not-recognized');
        var headerThankYouNR3 = $('#header3-thankyou-not-recognized');
        var hiddenClaimAccountId = $('#hidden-claim-accountId');

        $(document).ready(function () {
            select2SearchOrganizations.select2({
                placeholder: "Program name",
                allowClear: false, // Provides support for clearable selections. 
                minimumInputLength: 2, // Minimum number of characters required to start a search.
                tags: true, //boolean or array of objects, Used to enable free text responses.
                ajax: {
                    url: '@Url.Action("GetData", "SignUp", new { Area = "" })',
                    type: "POST",
                    dataType: "json",
                    delay: 500,
                    data: function (term) {
                        return {
                            search: term.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data.data, function (item) {
                                return {
                                    text: item.Text,
                                    slug: item.Slug,
                                    id: item.Id
                                }
                            })
                        };
                    }
                }
            });

            select2SearchOrganizations.on('select2:select', function (e) {
                //grab the selected account and set it to global object, so we can further decide on cliams profile or register
                var data = e.params.data;
                selectedAccount = data;
                if (data && data.id) {
                    hiddenClaimAccountId.val(data.id);
                }
                btnContinue.removeClass('disabled');
            });
        });

        function proceedFurther(page) {
            if (page === '@EnumSignupPages.WelCome') {
                // we are at welcome page and moving further to select user type
                signupWelcome.hide();
                signupSelectUsertype.show();
            } else if (page === '@EnumSignupPages.SelectIndividualType') {
                // user clicked btn-CreateIndividualAccount, and going for signup-IndividualType
                signupSelectUsertype.hide();
                signupIndividualType.show();
            } else if (page === '@EnumSignupPages.SelectOrgType') {
                // user clicked btn-CreateOrgAccount, and going for signup-OrgType
                signupSelectUsertype.hide();
                signupOrgType.show();
            } else if (page === '@EnumSignupPages.SearchProgramName') {
                // user clicked btn-ProgramForStudents, and going for name search for his/her program
                lblOrgSearchTitle.text('Whats the name of your Program?');
                signupIndividualType.hide();
                signupSearchName.show();
            } else if (page === '@EnumSignupPages.SearchOrgName') {
                // user is from the organization, and going for name search for his/her organization
                lblOrgSearchTitle.text('Whats the name of your Organization?');
                signupOrgType.hide();
                signupSearchName.show();
            } else if (page === '@EnumSignupPages.Register') {
                // user hasn't selected the system account and added a free text, so direct him to register screen
                signupSearchName.hide();
                signupRegister.show();
            } else if (page === '@EnumSignupPages.ClaimProfile') {
                // user has selected the system account, so direct him to claim profile
                signupSearchName.hide();
                signupClaimProfile.show();
            }
        }

        function decideToProceedFurther(input) {
            if (input && $(input).hasClass('disabled')) {
                Notifications.showBar({
                    title: 'Error',
                    message: 'Program name is required field.',
                    success: false
                });
                return;
            }
            console.log(selectedAccount);
            if (selectedAccount && selectedAccount.slug) {
                proceedFurther('@EnumSignupPages.ClaimProfile');
            } else {
                proceedFurther('@EnumSignupPages.Register');
            }
        }

        function saveClaims() {
            if (formClaimProfile.valid()) {
                var formData = formClaimProfile.serialize();
                var url = '@Url.Action("SaveClaims", "SignUp", new { Area = "" })';

                $.ajax({
                    url: url,
                    data: formData,
                    type: "POST",
                    dataType: "json",
                    success: function (data) {
                        if (data && data.status && data.status == 'error') {
                            var errors = ''
                            data.data.forEach(function (error) {
                                if (error && error.Text) {
                                    errors += '<li style="color: white;">' + error.Text + '</li>';
                                }
                                else {
                                    errors += '<li style="color: white;">' + error + '</li>';
                                }
                            });
                            Notifications.showBar({
                                title: 'Error',
                                message: errors,
                                success: false
                            });
                            return false;
                        } else if (data && data.data) { // email not recognised
                            lblOrgMemberEmail.text(data.data);
                            headerThankYouNR1.show();
                            headerThankYouNR2.show();
                            signupClaimProfile.hide();
                            signupThankYou.show();
                        } else { // email recognised
                            headerRecognisedThankYou.show();
                            signupClaimProfile.hide();
                            signupThankYou.show();
                        }
                    },
                    error: function (jqXHR, textStatus, errorThrown) {
                        console.log(errorThrown);
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong. Please contact customer support.',
                            success: false
                        });
                        return;
                    }
                });
            }
        }

        function contactSupport() {
            $.ajax({
                url: '@Url.Action("ContactSupport", "SignUp", new { Area = "" })',
                type: "POST",
                dataType: "json",
                success: function (data) {
                    if (data && data.status && data.status == 'error') {
                        Notifications.showBar({
                            title: 'Error',
                            message: 'Something went wrong. Please contact customer support.',
                            success: false
                        });
                        return false;
                    } else { // contact support email sent
                        headerThankYouNR2.hide();
                        headerThankYouNR3.show();
                    }
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log(errorThrown);
                    Notifications.showBar({
                        title: 'Error',
                        message: 'Something went wrong. Please contact customer support.',
                        success: false
                    });
                    return;
                }
            });
        }

    </script>
}