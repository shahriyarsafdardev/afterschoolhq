@{ Layout = "~/Views/Shared/Layouts/_FullScreen.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var EnumSignupPages = new
    {
        WelCome = 0,
        SelectUserType = 1,
        SelectIndividualType = 2,
        SelectOrgType = 3,
        SearchProgramName = 4,
        SearchOrgName = 5,
        ClaimProfile = 6,
        ThankYou = 7
    };
}

<style>
    .mt-30 {
        margin-top: 30px;
    }

    .mt-35 {
        margin-top: 35px;
    }

    .mtb-40 {
        margin-top: 40px;
        margin-bottom: 40px;
    }

    .btn-center {
        display: block;
        margin: 0 auto;
        float: none;
    }
</style>

<div class="row main-content">

    <div id="signup-welcome">
        <h2 class="text-center">Welcome</h2>
        <div class="clearfix"></div>

        <div class="row col-md-offset-1 mt-35">
            <div class="visible-lg visible-md">
                <div class="pull-left">
                    <img src="https://afterschoolhq-qa.s3.us-east-2.amazonaws.com/MathsClub/logo/nyc-5323170_640.jpg" alt="Allison" class="img-thumbnail" style="max-width: 230px;">
                </div>
                <div class="p-description col-md-8">
                    <p class="text-medium-small">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum.</p>
                    <div class="text-medium text-sm-center"> Name | Role </div>
                </div>
                <div class="clearfix"></div>
            </div>

            <div class="visible-xs visible-sm">
                <div class="p-description col-sm-12 col-xs-12 text-center">
                    <p class="text-medium-small">Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book. It has survived not only five centuries, but also the leap into electronic typesetting, remaining essentially unchanged. It was popularised in the 1960s with the release of Letraset sheets containing Lorem Ipsum passages, and more recently with desktop publishing software like Aldus PageMaker including versions of Lorem Ipsum.</p>
                    <div class="text-medium text-sm-center"> Name | Role </div>
                </div>
                <div class="clearfix"></div>
                <div class="text-center col-sm-12 col-xs-12 mt-30">
                    <img src="https://afterschoolhq-qa.s3.us-east-2.amazonaws.com/MathsClub/logo/nyc-5323170_640.jpg" alt="Allison" class="img-thumbnail" style="max-width: 350px;">
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="clearfix"></div>
        </div>

        <div class="clearfix"></div>

        <div class="text-center mtb-40">
            <button id="btn-GetStarted" type="button" class="col-md-offset-5 col-md-2 col-sm-12 col-xs-12 btn btn-lg btn-primary" onclick="return proceedFurther('@EnumSignupPages.WelCome')">Get Started</button>
            <div class="clearfix"></div>
        </div>
        <div class="clearfix"></div>
    </div>

    <div id="signup-select-usertype" style="display: none;">
        <h2 class="text-center">What would you like to do?</h2>
        <div class="clearfix"></div>

        <div class="row mt-35">
            <button id="btn-CreateIndividualAccount" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SelectIndividualType')">Create an Individual Account</button>
            <div class="clearfix"></div><br />
            <button id="btn-CreateOrgAccount" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SelectOrgType')">Create an Organization Account</button>
        </div>
    </div>

    <div id="signup-individualtype" style="display: none;">
        <h2 class="text-center">What would you like to do?</h2>
        <div class="clearfix"></div>

        <div class="row mt-35">
            <button id="btn-ProgramForStudents" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchProgramName')">Provide programs for students</button>
            <div class="clearfix"></div><br />
            <button id="btn-EnrollChild" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center">Enroll my child in a program</button> @*TODO: move user to /parent*@
        </div>
    </div>

    <div id="signup-orgtype" style="display: none;">
        <h2 class="text-center">What kind of organization?</h2>
        <div class="clearfix"></div>

        <div class="row mt-35">
            <button id="btn-Business" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Business</button>
            <div class="clearfix"></div><br />
            <button id="btn-School" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">School</button>
            <div class="clearfix"></div><br />
            <button id="btn-CommunityCenter" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Community Center</button>
            <div class="clearfix"></div><br />
            <button id="btn-Church" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Church</button>
            <div class="clearfix"></div><br />
            <button id="btn-NonProfit" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.SearchOrgName')">Non Profit</button>
        </div>
    </div>

    <div id="signup-search-name" style="display: none;">
        <h2 id="lbl-org-search-title" class="text-center"></h2>
        <div class="clearfix"></div>

        <div class="row mt-35">
            <div class="col-md-8 col-md-offset-2">
                <select id="select2-search-organizations" style="width: 100%;"></select>
            </div>
            <div class="clearfix"></div><br />

            <button id="btn-SearchContinue" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.ClaimProfile')">Continue</button>
            <div class="clearfix"></div><br />
        </div>
    </div>

    <div id="signup-claim-profile" style="display: none;">
        <h2 class="text-center">Claim Profile</h2>
        <div class="clearfix"></div><br />
        <h5 class="text-center">This profile already exists on AfterSchool HQ. Please start the claim process below.</h5>
        <div class="clearfix"></div><br />

        <div class="row mt-35">
            <div class="form-group row">
                <div class="col-md-6 col-md-offset-3">
                    <input class="form-control" type="text" placeholder="First Name">
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="form-group row">
                <div class="col-md-6 col-md-offset-3">
                    <input class="form-control" type="text" placeholder="Last Name">
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="form-group row">
                <div class="col-md-6 col-md-offset-3">
                    <input class="form-control" type="text" placeholder="Email">
                </div>
            </div>
            <div class="clearfix"></div>

            <div class="form-group row">
                <div class="col-md-6 col-md-offset-3">
                    <input class="form-control" type="text" placeholder="Phone">
                </div>
            </div>
            <div class="clearfix"></div>

            <button id="btn-StartClaimProcess" type="button" class="col-md-4 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center" onclick="return proceedFurther('@EnumSignupPages.ThankYou')">Start the claim process</button>
            <div class="clearfix"></div><br />
        </div>
    </div>

    <div id="signup-thank-you" style="display: none;">
        <h2 class="text-center">Thank You!</h2>
        <div class="clearfix"></div><br />
        <h5 class="text-center">We see that you have email from same domain. We have sent you instruction to claim to claim your account.</h5>
        <div class="clearfix"></div><br />

</div>

@section Scripts
{
    <script type="text/javascript">
        var signupWelcome = $('#signup-welcome');
        var signupSelectUsertype = $('#signup-select-usertype');
        var signupIndividualType = $('#signup-individualtype');
        var signupOrgType = $('#signup-orgtype');
        var signupSearchName = $('#signup-search-name');
        var signupClaimProfile = $('#signup-claim-profile');
        var signupThankYou = $('#signup-thank-you');
        var lblOrgSearchTitle = $('#lbl-org-search-title');

        $(document).ready(function () {
            // $('#select2-search-organizations').val();
            var select2SearchOrganizations = $('#select2-search-organizations');

            select2SearchOrganizations.select2({
                placeholder: "Program name",
                allowClear: true,
                minimumInputLength: 2,
                tags: [],
                ajax: {
                    url: 'GetData',
                    type: "POST",
                    dataType: "json",
                    quietMillis: 50,
                    data: function (term) {
                        return {
                            search: term.term
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data.data, function (item) {
                                return {
                                    text: item.Text,
                                    slug: item.Slug,
                                    id: item.Id
                                }
                            })
                        };
                    }
                }
            });

            select2SearchOrganizations.on('select2:select', function (e) {
                // Do something
                var data = e.params.data;
                console.log(data);
            });
        });

        function proceedFurther(page) {
            if (page === '@EnumSignupPages.WelCome') {
                // we are at welcome page and moving further to select user type
                $(signupWelcome).hide();
                $(signupSelectUsertype).show();
            } else if (page === '@EnumSignupPages.SelectIndividualType') {
                // user clicked btn-CreateIndividualAccount, and going for signup-IndividualType
                $(signupSelectUsertype).hide();
                $(signupIndividualType).show();
            } else if (page === '@EnumSignupPages.SelectOrgType') {
                // user clicked btn-CreateOrgAccount, and going for signup-OrgType
                $(signupSelectUsertype).hide();
                $(signupOrgType).show();
            } else if (page === '@EnumSignupPages.SearchProgramName') {
                // user clicked btn-ProgramForStudents, and going for name search for his/her program
                $(lblOrgSearchTitle).text('Whats the name of your Program?');
                $(signupIndividualType).hide();
                $(signupSearchName).show();
            } else if (page === '@EnumSignupPages.SearchOrgName') {
                // user is from the organization, and going for name search for his/her organization
                $(lblOrgSearchTitle).text('Whats the name of your Organization?');
                $(signupOrgType).hide();
                $(signupSearchName).show();
            } else if (page === '@EnumSignupPages.ClaimProfile') {
                $(signupSearchName).hide();
                $(signupClaimProfile).show();
            } else if (page === '@EnumSignupPages.ThankYou') {
                $(signupClaimProfile).hide();
                $(signupThankYou).show();
            }
        }
    </script>
}