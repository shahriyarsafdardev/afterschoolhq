@using Utilities = AfterSchoolLibrary.Helpers.Utilities
@model SignUpIndexViewModel
@{
    Layout = "~/Views/Shared/Layouts/_FullScreen_Onboarding.cshtml";
    var msgs = (SystemMessages)ViewBag.Messages;
    var clientSuccessManagerName = "Tatiana Givens";
    var signupType = Model.SignupType.IsNotEmpty() ? Model.SignupType : SignUpType.NotSet;
    var EnumSignupPages = new
    {
        WelCome = 0,
        SelectUserType = 1,
        SelectIndividualType = 2,
        SelectOrgType = 3,
        SearchProgramName = 4,
        SearchOrgName = 5,
        Register = 6,
        ClaimProfile = 7,
        SearchSchool = 8
    };

    var showInviteWelcome = Model.InvitingAccount.IsNotEmpty();
}

@helper PrintWelcomeParagraph1()
{
    <span>Thank you for joining us at AfterSchool HQ!</span>
}

@helper PrintWelcomeParagraph2(bool showInviteWelcome)
{
    if (showInviteWelcome)
    {
        <span>
            You have been invited to take the first step towards streamlining the 
            promotion and management of your enrichment program at <strong>@Model.InvitingAccount.Name</strong>.
        </span>
    }
    else
    {
        <span>We’re thrilled to partner with you in taking the first step towards streamlining the promotion and management of your enrichment program(s).</span>
    }
}

@helper PrintWelcomeParagraph3(bool showInviteWelcome)
{
    if (showInviteWelcome)
    {
        <span>
            We are starting you off with a free plan. You will not have to enter payment information until you are ready to upgrade. For now, to get your 
            program up and running on our platform, we just need a few bits of information from you!
        </span>
    }
    else
    {  
        <span>We start everyone out with 
            @if (Model.TrialDays > 0)
            {
                <span>
                    a <em>no-obligation</em>  @Model.TrialDays.ToInteger()-day free trial of
                </span>
            }
            our @Model.PackageName Plan 
            so you can get a feel for what AfterSchool HQ has to offer. 
            You can choose a different plan at any time. 
            Now, we just need to collect a few bits of information from you to get started!
        </span>
    }
}

@helper PrintGraphic(string clientSuccessManagerName)
{
    <div>
        <img src="~/Assets/img/client_success_manager_color.jpeg" alt="@clientSuccessManagerName" class="img-client-success-manager">
        <div class="padding-v-10 text-center">
            <p class="manager-name">@clientSuccessManagerName</p>
            <p class="manager-position">Client Success Manager</p>
        </div>
    </div>
}

@helper PrintGraphicSmall(string clientSuccessManagerName)
{
    <div class="row">
        <div class="pull-left margin-l-20">
            <img src="~/Assets/img/client_success_manager_color.jpeg" alt="@clientSuccessManagerName" class="img-client-success-manager" style="max-height: 150px;">
        </div>
        <div class="pull-left margin-l-20">
            <p class="manager-name">@clientSuccessManagerName</p>
            <p class="manager-position">Client Success Manager</p>
        </div>
        <div class="clearfix"></div>
    </div>
}

<div class="row main-content main-content-welcome-pages">

<div id="signup-welcome" @(signupType == SignUpType.Teacher1099 ? "hidden" : "")>

    <div class="welcome-outer-ring visible-lg visible-xl visible-md">
        <div class="welcome-inner-ring">
            <div class="row">

                <div class="col-md-4 col-lg-4">
                    @PrintGraphic(clientSuccessManagerName)
                </div>

                <div class="col-md-8 col-lg-8">
                    <span class="welcome-text">Welcome</span>
                    <p class="common-font padding-v-10" style="font-size: 20px;">
                        @PrintWelcomeParagraph1()
                    </p>
                    <p class="common-font" style="font-size: 18px;">
                        @PrintWelcomeParagraph2(showInviteWelcome)
                    </p>
                    <p class="common-font" style="font-size: 18px;">
                        @PrintWelcomeParagraph3(showInviteWelcome)
                    </p>

                    <div class="margin-t-30">
                        <button id="btn-GetStarted" type="button" class="col-md-3 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-proceedfuther" onclick="return proceedFurther('@EnumSignupPages.WelCome')">
                            Get Started
                        </button>
                    </div>

                    <p class="common-font text-center margin-t-30" style="font-size: 16px;">
                        <a href="@Url.Action("index", "login", new { invite = Model.InviteCodeToShare })">Already have an account? Login &raquo;</a>
                    </p>
                </div>

            </div>
        </div>
    </div>

    <div class="welcome-outer-ring visible-xs visible-sm margin-b-20">
        <div class="mobile-inner-ring">

            <div class="row padding-20">

                <div class="col-sm-12 col-md-6 col-lg-8">
                    <span class="text-center welcome-text">Welcome</span>
                    <p class="common-font padding-v-10" style="font-size: 20px;">
                        @PrintWelcomeParagraph1()
                    </p>
                    <p class="common-font" style="font-size: 18px;">
                        @PrintWelcomeParagraph2(showInviteWelcome)
                    </p>
                    <p class="common-font" style="font-size: 18px;">
                        @PrintWelcomeParagraph3(showInviteWelcome)
                    </p>
                </div>

                <div class="col-sm-12 padding-v-20">
                    @PrintGraphicSmall(clientSuccessManagerName)
                </div>

                <div class="col-sm-12 col-md-6 col-lg-8">
                    <button id="btn-GetStarted" type="button" class="col-md-3 col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-proceedfuther margin-t-30" onclick="return proceedFurther('@EnumSignupPages.WelCome')">
                        Get Started
                    </button>

                    <p class="common-font text-center margin-t-30" style="font-size: 16px;">
                        <a href="@Url.Action("index", "login", new { invite = Model.InviteCodeToShare })">Already have an account? Login &raquo;</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="clearfix"></div>
<div id="signup-select-usertype" style="display: none;">
    <div class="visible-lg visible-md welcome-outer-ring">
        <div class="welcome-inner-ring">
            <h2 class="text-center common-font" style="font-size: 24px;">What would you like to do?</h2>
            <div class="clearfix"></div>

            <div class="row margin-t-35">
                <button type="button" class="col-md-8 btn btn-lg btn-primary btn-center btn-common" onclick="return proceedFurther('@EnumSignupPages.SelectIndividualType')">Create an Individual Account</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-md-8 btn btn-lg btn-primary btn-center btn-common" onclick="return proceedFurther('@EnumSignupPages.SelectOrgType')">Create an Organization Account</button>
            </div>
            <div class="clearfix"></div>

            <a href="#" style="margin-left: -120px;" onclick="return proceedBack('@EnumSignupPages.WelCome')">
                <img style="margin-top: -150px;" src="~/Assets/img/welcome-back-arrow.png"/>
            </a>
        </div>
    </div>

    <div class="visible-xs visible-sm welcome-outer-ring" style="margin-bottom: 20px;">
        <div class="mobile-inner-ring">
            <h2 class="text-center common-font" style="font-size: 24px;">What would you like to do?</h2>
            <div class="clearfix"></div>

            <div class="row margin-t-35">
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return proceedFurther('@EnumSignupPages.SelectIndividualType')">Create an Individual Account</button>
                <div class="clearfix"></div><br/>
                <button type="button" class="col-sm-12 col-xs-12 btn btn-lg btn-primary btn-center btn-common-mobile" onclick="return proceedFurther('@EnumSignupPages.SelectOrgType')">Create an Organization Account</button>
