@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Verify Your Email";
    var msgs = (SystemMessages)ViewBag.Messages;

}

<<div class="am-wrapper am-login am-signup">
    <div class="am-content">
        <div class="main-content">
            <div class="login-container sign-up">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <a href="/"><img src="@UILabel.ProductLogo()" alt="logo" width="350px" class="logo-img"></a>
                    </div>
                    <div class="panel-body">
                        <p class="text-white">
                            @if (msgs.HasNoErrors())
                            {
                                @:Thank you! Your email has been verified. <a href="@ViewBag.URL">Continue to your account</a>.
                            }
                            else
                            {
                                @:There was an error verifying your account. Please <a href="mailto:@AfterSchoolLibrary.Helpers.Email.AppSupportEmailAddress">contact support</a> to resolve the issue.
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
     </div>
</div>
