@model WebUser

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Sign Up";
    var msgs = (SystemMessages)ViewBag.Messages;
}

<<div class="am-wrapper am-login am-signup">
    <div class="am-content">
        <div class="main-content">
            <div class="login-container sign-up">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <a href="/"><img src="@UILabel.ProductLogo()" alt="logo" width="350px" class="logo-img"></a>
                        <span>Welcome! Please enter your information below to complete the sign-up process.</span>
                    </div>
                    <div class="panel-body">

                        @Html.Raw(UI.RenderMessagesToHtml(msgs))

                        <form action="@Url.Action("new", "signup", new { id = ViewBag.Uid, a = ViewBag.AccountUid })" parsley-validate="" novalidate="" method="post" class="form-horizontal" id="sign-up-form">
                            @{ Html.RenderPartial("~/Views/Shared/Login/_SignUpForm.cshtml", Model); }
                        </form>
                    </div>
                </div>
                <div class="text-center out-links"><a href="/">© @DateTime.UtcNow.Year @UILabel.ProductName()</a></div>
            </div>
        </div>
    </div>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#sign-up-form').submit(function () {
            $('button[type="submit"]').html('Creating Account...');
            $('button[type="submit"]').prop('disabled', true);
        });
        $("input", "#sign-up-form").eq(2).attr('readonly', 'readonly');
    });
</script>
