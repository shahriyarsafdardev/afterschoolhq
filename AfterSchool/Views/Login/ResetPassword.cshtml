
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Login";
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}

<div class="am-wrapper am-login">
    <div class="am-content">
        <div class="main-content">
            <div class="login-container">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <img src="@UILabel.ProductLogo()" alt="logo" width="350px" class="logo-img">
                        <span>Reset Password</span>
                    </div>
                    <div class="panel-body">
                        
                        @Html.Raw(UI.RenderMessagesToHtml(msgs))

                        <form action="@Url.Action("ResetPassword", "Login")" method="post" class="form-horizontal">
                            <div class="login-form">
                                <div class="form-group">
                                    <div class="input-group">
                                        <span class="input-group-addon"><i class="icon s7-user"></i></span>
                                        <input id="email" name="email" type="email" placeholder="Email Address" autocomplete="off" class="form-control" required>
                                    </div>
                                </div>
                                <div class="form-group login-submit">
                                    <button data-dismiss="modal" type="submit" class="btn btn-primary btn-lg">Reset Password</button>
                                </div>
                                <div>
                                    <a href="@Url.Action("index", "login")" class="white">&laquo; Cancel</a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

