@model WebUser
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Reset Password";
    SystemMessages msgs = (SystemMessages)ViewBag.Messages;
}
<script src="~/Assets/js/password-checker.js"></script>
<link href="~/Assets/css/font-awesome-4.6.3/css/font-awesome.min.css" rel="stylesheet" />

<div class="am-wrapper am-login">
    <div class="am-content">
        <div class="main-content">
            <div class="login-container">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <img src="@UILabel.ProductLogo()" alt="logo" width="350px" class="logo-img">
                        <span>Please enter a new password.</span>
                    </div>
                    <div class="panel-body">

                        @Html.Raw(UI.RenderMessagesToHtml(msgs))

                        @if (msgs.HasNoErrors() && Model.IsNotEmpty())
                        {
                            <p class="text-white">
                                Your password has been changed successfully. <a href="@Url.Action("index", "login")" class="white">Login to your account</a>
                            </p>
                        }
                        else
                        {
                            <form action="@Url.Action("changepassword", "login", new { token = Request["token"] })" method="post" class="form-horizontal">
                                <div class="login-form">
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
                                            <input id="password1" name="password1" type="password" data-parsley-errors-messages-disabled="true" placeholder="Create Password" data-parsley-class-handler="#password-handler" required="required" class="form-control" data-parsley-id="8" onkeyup="checkStrength();">
                                            <div id="popover-password" style="display: none;">
                                                <p class="text-white">Password Strength: <span id="result"> </span></p>
                                                <div class="progress" style="height: 5px; border-radius: 5px;">
                                                    <div id="password-strength" class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="40" aria-valuemin="0" aria-valuemax="100" style="width:0%">
                                                    </div>
                                                </div>
                                                <ul class="list-unstyled">
                                                    <li class="text-white"><span class="low-upper-case text-danger"><i class="fa fa-times" aria-hidden="true"></i></span>&nbsp; 1 lowercase &amp; 1 uppercase</li>
                                                    <li class="text-white"><span class="one-number text-danger"><i class="fa fa-times" aria-hidden="true"></i></span> &nbsp;1 number (0-9)</li>
                                                    <li class="text-white"><span class="one-special-char text-danger"><i class="fa fa-times" aria-hidden="true"></i></span> &nbsp;1 special character (!@@#$%^&*)</li>
                                                    <li class="text-white"><span class="eight-character text-danger"><i class="fa fa-times" aria-hidden="true"></i></span>&nbsp; At least 8 characters</li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="form-group">
                                        <div class="input-group">
                                            <span class="input-group-addon"><i class="icon s7-lock"></i></span>
                                            <input id="password" name="password2" type="password" placeholder="Verify Password" class="form-control" required>
                                        </div>
                                    </div>
                                    <div class="form-group login-submit">
                                        <button data-dismiss="modal" id="form-submit" disabled type="submit" class="btn btn-primary btn-lg">Update Password</button>
                                    </div>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

