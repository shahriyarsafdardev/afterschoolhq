@{ Layout = "~/Views/Shared/_LayoutLogin-Updated.cshtml";
    ViewBag.Title = "Login";
    var msgs = (SystemMessages)ViewBag.Messages; }

<style>
    .bg-image {
        background-image: url("img/image-3-1800x900-1.png");
        /* Center and scale the image nicely */
        background-repeat: no-repeat;
        background-position: left top;
        background-size: 100% 100%;
        flex: 1;
        height: 100%;
    }

    .txt-generic-login {
        width: 100%;
        padding-left: 40px;
        border-radius: 6px !important;
    }

    .input-group-email {
        position: absolute;
        left: 9px;
        top: 9px;
        z-index: 9;
    }

    .btn-generic-login {
        padding: 0;
        margin: 0;
        border: medium;
        cursor: text;
        background: transparent !important;
    }

    .input-group-password {
        position: absolute;
        left: 10px;
        top: 3px;
        z-index: 9;
    }
</style>

<div class="container-login">
    <div class="content-sidebar-login pull-left">

        <div style="position: fixed; top: 30px; left: 30px;">
            <a href="/"><img src="~/img/ahq-logo-2-1-1.png" alt="logo" style="width: 325px;"></a>
        </div>

        <div class="rectangle-login-box">
            <div class="form-group">
                <p class="form-login-welcome">Welcome back.</p>
                <p class="form-login-sign">Or <a href="#">sign up </a> for a free account.</p>
            </div>
            <br /><br />

            @Html.Raw(UI.RenderMessagesToHtml(msgs))
            <div class="clearfix"></div>

            <form action="@Url.Action("index", "login", new { returnurl = ViewData["ReturnUrl"], invite = ViewData["invite"] })" method="post" class="form-horizontal" id="form-login">

                <div class="form-group">
                    <label class="short-description"> Email </label>
                    <div class="input-group" style="width: 100%;">
                        <input id="username" name="username" type="text" class="form-control txt-generic-login" required>
                        <div class="input-group-email">
                            <button id="inputGroupEmailPrepend" type="submit" class="btn btn-primary btn-sm btn-generic-login">
                                <img src="~/img/envelop_trans.png" />
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label class="short-description"> Password </label>
                    <div class="input-group" style="width: 100%;">
                        <input id="password" name="password" type="password" class="form-control txt-generic-login" required>
                        <div class="input-group-password">
                            <button id="inputGroupPassworkPrepend" type="submit" class="btn btn-primary btn-sm btn-generic-login">
                                <img src="~/img/password_trans.png" />
                            </button>
                        </div>
                    </div>
                </div>

                <div class="form-group" style="float: left;">
                    <div class="remember margin-b-10">
                        <div class="am-checkbox checkbox-inline text-center">
                            <input type="checkbox" id="remember-login" name="remember" value="1" class="form-control" checked="checked">
                            <label for="remember-login">Remember me </label>
                        </div>
                    </div>
                </div>

                <div class="form-group pull-right login-form-forgot-password-container">
                    <a href="/login/resetpassword" style="padding: 7px; line-height: 30px; font-weight: 300; text-decoration: underline; ">Forgot Password</a>
                </div>
                <div class="clearfix"></div>

                <div class="form-group login-submit text-center">
                    <button id="btn-login" type="submit" class="btn btn-primary btn-lg btn-block btn-login-updated" style="margin: 0 auto;">Log In</button>
                    <br />
                    <a href="@AfterSchoolLibrary.Helpers.CleverHelper.SSOLinkLogin" class="btn-clever-login">
                        <img src="~/img/login-clever.png" style="width: 225px; height: 50px;" class="clever-login-img" />
                    </a>
                </div>

            </form>
            <div class="clearfix"></div>
        </div>
    </div>

    <div class="bg-image">
        <div class="rectangle-thought">
            <span class="thought-header-1">
                Every kid is a genius in their own way. Our goal is to help them find their genius.
            </span>
            <br /><br /><br />
            <span class="thought-header-2">
                Darye Henry
            </span>
            <br /><br />
            <span class="thought-header-3">
                Founder, AfterSchool HQ
            </span>
        </div>
    </div>
</div>

<script type="text/javascript">
    //todo : convert error messages to toaster
    PageEvent.add(PageEvent.AFTER_INIT, function () { loadUIMessages() });

    function loadUIMessages() {
        @*debugger
        var msgs = JSON.parse(@Html.Raw(msgs));*@
    }

</script>
