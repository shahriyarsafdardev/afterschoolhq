
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Login";
    var msgs = (SystemMessages)ViewBag.Messages;
}

<div class="am-wrapper am-login">
    <div class="am-content">
        <div class="main-content">
            <div class="login-container">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <a href="/"><img src="@UILabel.ProductLogo()" alt="logo" width="100%" height="auto" class="logo-img"></a>                        
                    </div>
                    <div class="panel-body">
                        
                        @Html.Raw(UI.RenderMessagesToHtml(msgs))

                        @{ Html.RenderPartial("_Login", null, new ViewDataDictionary() { { "ReturnUrl", Request["returnurl"] }, { "Invite", Request["invite"] } }); }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

