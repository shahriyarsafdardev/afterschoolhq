@model List<Account>
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "Select Account";
    var msgs = (SystemMessages)ViewBag.Messages;
}

<div class="am-wrapper am-login">
    <div class="am-content">
        <div class="main-content">
            <div class="login-container">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        <a href="/"><img src="@UILabel.ProductLogo()" alt="logo" width="350px" class="logo-img"></a>                        
                    </div>
                    <div class="panel-body">

                        @Html.Raw(UI.RenderMessagesToHtml(msgs))

                        <div>
                            <p class="text-center text-white">
                                @if (Request["invite"].IsGuid())
                                {
                                    <span>Please select your account to connect your invite to below</span>
                                }
                                else
                                {
                                    <span>Please select your account below</span>
                                }
                            </p>
                        </div>

                        <div id="accounts">
                            @foreach (var account in Model)
                            {
                                <button onclick="selectAccount('@account.Uid')"
                                        class="btn btn-primary btn-xl btn-space btn-block">
                                    @account.Name &raquo;
                                </button>
                            }
                            <p class="text-center padding-v-20">
                                <a href="/logout">Logout</a>
                            </p>
                        </div>
                        <div id="loading" class="hide padding-30">
                            <p class="text-center text-white text-medium">
                                Loading your account...
                            </p>
                        </div>
                        <script>
                            function selectAccount(uid) {
                                $('#accounts').addClass('hide');
                                $('#loading').removeClass('hide');
                                location.href = '/login/select/' + uid + '?returnurl=@ViewBag.ReturnUrl&invite=@ViewBag.Invite';
                            }
                        </script>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>