        Html.RenderPartial("~/Views/Shared/_Modal.cshtml", new ModalViewModel()
        {
            ID = "modal-welcome-user",
            Title = "Welcome To Your Profile.",
            HtmlBody = $"<p>This is your organizations profile. you can review your dashboard and create activities from there.</p>",
        });
    }
</div>

@if (isAccountAndLoggedInUserIsOwner)
{
    <div id="footer-account" class="activity-footer text-center hide">
        <span class="span-upgrade-modal-close" onclick="return hideActivityRibbon()">X</span>
        <a href="@Url.Action("style", "account", new { id = Model.Uid, area = "org" })" class="btn btn-default btn-activity-footer">Edit Profile</a>
        <a href="@Url.Action("editsetup", "activity", new { isnew = 1, type = (int)ActivityType.Activity, area = "org", source = Request["source"]})" class="btn btn-default btn-activity-footer">Add Activity</a>
    </div>

    <div id="modal-getting-started" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-body account-getting-started-padding">
                    @{ Html.RenderPartial("~/Views/Shared/_GettingStarted.cshtml"); }
                </div>
            </div>
        </div>
    </div>

    <div id="modal-payment-confirmation-accountView" class="hide">
        @{ Html.RenderPartial("~/Views/Shared/_ModalPaymentConfirmation.cshtml", Model, new ViewDataDictionary() { { "ActivityUid", firstActivity?.Uid } }); };
    </div>

    <div id="modal-acceptpayment-done" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content modal-min-width modal-box">
                <div class="modal-body account-getting-started-padding">
                    <div onclick="return $('#modal-acceptpayment-done').modal('hide');">
                        <a class="close close-icon-position">
                            <span aria-hidden="true">&times;</span>
                        </a>
                    </div>

                    <div class="text-center">
                        <img src="~/img/email-symbol.png" />
                    </div>
                    <div id="modal-email-confirmation-text" class="modal-box-body">
                        Account setup complete!
                    </div>
                    <div id="modal-email-confirmation-btn" class="margin-v-30 text-center">
                        <a href="#" class="btn btn-primary btn-free-profile" style="padding: 12px 20px;" onclick="return hideAcceptPaymentModal()">View Activity</a>
                        <div class="clearfix"></div>
                        <br />
                        <a href="@Url.Action("editsetup", "activity", new { id = firstActivity?.Uid, area = "org" })" class="view-activity-text">Return to activity draft</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<script type="text/javascript">
    PageEvent.add(PageEvent.AFTER_INIT, function () {

        var currentLevel = @Json.Encode(currentLevel);
        var isOnboadingCompleted = @Json.Encode(isOnboadingCompleted);
        var isProcessCompleted = @Json.Encode(GettingStartedOptions.ProcessCompleted);
        var isStripeIntegrated = @Json.Encode(isStripeIntegrated);
        
        if (currentLevel == isProcessCompleted && isStripeIntegrated) {
            $('#modal-acceptpayment-done').modal({
                backdrop: 'static'
            });
        }
        else if (!isOnboadingCompleted) {
            //.. show getting started modal options if user misses any of that option
            $('#modal-getting-started').modal({
                backdrop: 'static'
            });
        }

        //$('#btn-welcome-user').click(); leaving out of this release, needs more design
        var url = new URL(window.location.href);
        var claimprofile = url.searchParams.get("claimprofile");
        if (claimprofile) {
            $('#model-claim').click();
        }
    });

    function hideActivityRibbon() {
        $('#footer-account').fadeOut();
    };

    function LoadPaymentModal() {
        $('#modal-getting-started').modal('hide');
        $('#modal-payment-confirmation-accountView').removeClass('hide');

        setTimeout(function () {
            $('#modal-payment-confirmation').modal({
                backdrop: 'static'
            });
        }, 100);
    }

    (function () {
        var url = '@accountProfile.VideoUrl';
        if (url) {
            var isVimeoVideo = checkVideoPlatform(url);
            if (isVimeoVideo) {
                var id = validateVimeoUrl(url);
                if (id) {
                    var player = document.getElementById("frameVideoUrl");
                    player.src = "https://player.vimeo.com/video/" + id;

                    var container = document.getElementById("frameContainer");
                    container.style.display = 'block';
                }
            }
            else {
                var id = validateYouTubeVideoUrl(url);
                if (id) {
                    var player = document.getElementById("frameVideoUrl");
                    player.src = "https://www.youtube.com/embed/" + id;

                    var container = document.getElementById("frameContainer");
                    container.style.display = 'block';
                }
            }
        }
    })();

    function checkVideoPlatform(url) {
        if (url && url.toLowerCase().includes('vimeo')) {
            return true;
        }

        return false;
    }

    function validateYouTubeVideoUrl(url) {
        var regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
        var match = url.match(regExp);

        if (match && match[2] && match[2].length == 11) {
            return match[2];
        }

        return false;
    }

    function validateVimeoUrl(url) {
        var regExp = /(http|https)?:\/\/(www\.)?vimeo.com\/(?:channels\/(?:\w+\/)?|groups\/([^\/]*)\/videos\/|)(\d+)(?:|\/\?)/;
        var match = url.match(regExp);

        if (match && match[4] && match[4].length >= 6) {
            return match[4];
        }

        return false;
    }
</script>

@section header
{
    @{ Html.RenderPartial("~/Views/Shared/Registration/_ShareMetaTags.cshtml", new RegistrationHeaderViewModel(Model, accountProfile)); }

}