@using AfterSchoolLibrary.Helpers.GoogleHelper
@model Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;

    var msgs = (SystemMessages) ViewBag.Messages;
    var accountProfile = (AccountProfile) ViewBag.AccountProfile;
    var location = (Location) ViewBag.Location;
    var awards = (List<AccountProperty>) ViewBag.Awards;
    var certifications = (List<AccountProperty>) ViewBag.Certifications;
    var photos = (List<AccountProperty>) ViewBag.Photos;
    var gradeLevelStart = (GradeLevel) ViewBag.GradeLevelStart;
    var gradeLevelEnd = (GradeLevel) ViewBag.GradeLevelEnd;
    var ageStart = (int?) ViewBag.AgeStart;
    var ageEnd = (int?) ViewBag.AgeEnd;
    var restrictByGrade = (bool) ViewBag.RestrictByGrade;
    var genderRestriction = (string) ViewBag.GenderRestriction;
    var participationObjects = (List<ParticipationObject>) ViewBag.ParticipationObjects;
    const int takeActivities = 3;
    var accountProperties = (List<AccountProperty>) ViewBag.AccountProperties;
    var isInEditMode = SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model) && Request["edit"] == "1";

    var skillAndMethodTypes = new[] {AccountPropertyType.SoftSkills, AccountPropertyType.TeachingMethods, AccountPropertyType.AcademicSubjects, AccountPropertyType.Classifications};
    var serviceTypes = new[] {AccountPropertyType.ServiceOffered, AccountPropertyType.TimeOffered, AccountPropertyType.PricingOption};
    var specialNeedsTypes = new[] {AccountPropertyType.SpecialNeedsOffering};

    var skillsAndMethods = accountProperties.Where(item => item.AccountPropertyTypeId.In(skillAndMethodTypes));
    var servicesOffered = accountProperties.Where(item => item.AccountPropertyTypeId.In(serviceTypes));
    var specialNeedsOffered = accountProperties.Where(item => item.AccountPropertyTypeId.In(specialNeedsTypes));
    var showPhotoGallery = photos.Any() || isInEditMode;
    var isOnboardingCompleted = SessionVariables.CurrentAccount.IsOnboardingCompleted(msgs);
    var currentLevel = Model.OnboardingCompletionStatus();
    var isStripeIntegrated = TempData["IsStripeIntegrated"] != null;
    var firstActivity = Model.GetActivities(msgs)?.FirstOrDefault();
    var isExternallyProvidedActivity = false;

    var cleverSsoEnabled = ViewBag.CleverSsoEnabled;

    if (firstActivity.IsEmpty())
    {
        firstActivity = Model.GetExternallyProvidedActivities(msgs).FirstOrDefault();
        isExternallyProvidedActivity = true;
    }

    var isAccountAndLoggedInUserIsOwner = SessionVariables.CurrentAccount.IsNotEmpty() &&
                                          SessionVariables.CurrentUser.IsNotEmpty() &&
                                          SessionVariables.CurrentAccount.ID == Model.ID &&
                                          SessionVariables.CurrentUser.HasAccessTo(Model);
    var onboardingStepsAcknowledged = CookieVariables.OnboardingStepsAcknowledged.IsNotEmpty() && CookieVariables.OnboardingStepsAcknowledged.ToBoolean();

}

<style>
