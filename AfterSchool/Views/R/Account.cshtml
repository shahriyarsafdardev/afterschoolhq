@model Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;

    var msgs = (SystemMessages)ViewBag.Messages;
    var accountProfile = (AccountProfile)ViewBag.AccountProfile;
    var location = (Location)ViewBag.Location;
    var awards = (List<AccountProperty>)ViewBag.Awards;
    var certifications = (List<AccountProperty>)ViewBag.Certifications;
    var photos = (List<AccountProperty>)ViewBag.Photos;
    var gradeLevelStart = (GradeLevel)ViewBag.GradeLevelStart;
    var gradeLevelEnd = (GradeLevel)ViewBag.GradeLevelEnd;
    var participationObjects = (List<ParticipationObject>)ViewBag.ParticipationObjects;
    var takeActivities = 3;
    var locations = (List<Location>)ViewBag.Locations;
    var accountProperties = (List<AccountProperty>)ViewBag.AccountProperties;
    var isInEditMode = SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model) && Request["edit"] == "1";

    var skillAndMethodTypes = new AccountPropertyType[] { AccountPropertyType.SoftSkills, AccountPropertyType.TeachingMethods, AccountPropertyType.AcademicSubjects, AccountPropertyType.Classifications };
    var serviceTypes = new AccountPropertyType[] { AccountPropertyType.ServiceOffered, AccountPropertyType.TimeOffered, AccountPropertyType.PricingOption };
    var specialNeedsTypes = new AccountPropertyType[] { AccountPropertyType.SpecialNeedsOffering };

    var skillsAndMethods = accountProperties.Where(item => item.AccountPropertyTypeId.In(skillAndMethodTypes));
    var servicesOffered = accountProperties.Where(item => item.AccountPropertyTypeId.In(serviceTypes));
    var specialNeedsOffered = accountProperties.Where(item => item.AccountPropertyTypeId.In(specialNeedsTypes));
}

@{
    Html.RenderPartial(
"~/Views/Shared/Registration/_AccountTopBar.cshtml",
Model,
new ViewDataDictionary()
{
            { "LoginReturnUrl", Model.HomePageUrl }
}
);
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_RegistrationHeader.cshtml", new RegistrationHeaderViewModel(Model, (AccountProfile)ViewBag.AccountProfile)); }

@helper renderEditButtion(Account account, string anchor, string buttonText = "Edit")
{
    if (SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model) && Request["edit"] == "1")
    {
        var redirectUrl = $"{Url.Action("style", "account", new { area = "org", isfullscreen = 1, returnurl = Request.Url, type = (int)ActivityType.Activity })}#{anchor}";

        <span>
            <a href="@Url.Action("switch", "logout", new { id = account.Uid, redirectUrl = redirectUrl })#@anchor"
               class="btn btn-alt7 btn-sm">
                @buttonText &raquo;
            </a>
        </span>
    }
}

@helper renderAccountProperties(IEnumerable<AccountProperty> accountProperties, int propertiesPerCol)
{
    for (int i = 0; i < 3; i++)
    {
        <div class="col-md-4">
            @foreach (var property in accountProperties.OrderBy(x => x.Value).Skip(i * propertiesPerCol).ToList().Take(propertiesPerCol))
            {
                var icon = "";
                var iconTitle = "";

                switch (property.AccountPropertyTypeId)
                {
                    case AccountPropertyType.Classifications:
                        icon = "s7-gleam";
                        iconTitle = "Activity Type";
                        break;
                    case AccountPropertyType.AcademicSubjects:
                        icon = "s7-study";
                        iconTitle = "Academic Subject";
                        break;
                    case AccountPropertyType.PricingOption:
                        icon = "s7-credit";
                        iconTitle = "Pricing Option";
                        break;
                    case AccountPropertyType.ServiceOffered:
                        icon = "s7-ticket";
                        iconTitle = "Type of Service";
                        break;
                    case AccountPropertyType.SoftSkills:
                        icon = "s7-users";
                        iconTitle = "Soft Skill";
                        break;
                    case AccountPropertyType.TeachingMethods:
                        icon = "s7-display2";
                        iconTitle = "Teaching Method";
                        break;
                    case AccountPropertyType.TimeOffered:
                        icon = "s7-clock";
                        iconTitle = "Time Offered";
                        break;
                    case AccountPropertyType.SpecialNeedsOffering:
                        icon = "s7-user";
                        iconTitle = "Special Needs Offerings";
                        break;
                }

                <p class="activity-detail-block">
                    <i class="@icon icon-large text-success" style="padding-top: 20px;" title="@iconTitle"></i>
                    <span class="text-medium" style="margin-top: -30px;">@property.Value</span>
                </p>
            }
        </div>
    }
}

<div>
    <div class="col-md-12 col-lg-10 col-lg-offset-1 participation-object participation-object-detail">

        <div class="panel panel-alt6">
            <div class="panel-heading" style="width: 100%;">
                <div class="row">
                    <div class="col-lg-12">
                        <h3 class="text-center">
                            @if (gradeLevelStart.IsNotEmpty() && gradeLevelEnd.IsNotEmpty())
                            {
                                <span>Serving @gradeLevelStart.Name - @gradeLevelEnd.Name Grade</span>
                                @renderEditButtion(Model, "grades")
                            }
                        </h3>
                    </div>
                </div>
            </div>
            <div class="panel-body">

                @if (participationObjects.Any() || isInEditMode)
                {
                    <div>

                        @if (participationObjects.Any())
                        {
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="activity-detail-block">
                                        <div class="pull-left">
                                            <h2>@UILabel.ActivityLabel(ActivityType.Activity, true)</h2>
                                        </div>
                                        <div class="pull-right padding-v-20">
                                            <a href="@Model.BrowseUrl">
                                                View All &raquo;
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @if (isInEditMode)
                        {
                            var redirectUrl = Url.Action("editsetup", "activity", new { area = "org", isnew = 1, source = "profile", type = (int)ActivityType.Activity });

                            <div class="row">
                                <div style="position: relative; margin-left: -5px; margin-right: -5px;">
                                    <span>
                                        <a href="@Url.Action("switch", "logout", new { id = Model.Uid, redirectUrl = redirectUrl })"
                                           class="btn btn-alt7 btn-sm">
                                            Add New Activity &raquo;
                                        </a>
                                    </span>
                                </div>
                            </div>
                        }

                        <div class="row">
                            <div style="position: relative; margin-left: -20px; margin-right: -20px;">
                                @foreach (var item in participationObjects.Take(takeActivities))
                                {
                                    Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObjectWide.cshtml", item);
                                }
                            </div>
                        </div>

                        @if (participationObjects.Count > takeActivities)
                        {
                            <div class="row">
                                <div class="col-md-4 col-md-offset-4">
                                    <a href="@Model.BrowseUrl" class="btn btn-register">
                                        View More Activities &raquo;
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (photos.Any() || isInEditMode)
                {
                    <div class="margin-t-20">
                        <div class="row">
                            <div style="position: relative; margin-left: -5px; margin-right: -5px;">
                                @renderEditButtion(Model, "photos", "Edit Photo Gallery")
                            </div>
                        </div>
                        <div class="row">
                            <div style="position: relative; margin-left: -20px; margin-right: -20px;">
                                @{ Html.RenderPartial("~/Views/Shared/Registration/_ProfilePhotoGallery.cshtml", photos); };
                            </div>
                        </div>
                    </div>
                }

                @if (servicesOffered.Any() || isInEditMode)
                {
                    <div class="margin-t-20">
                        <div class="row padding-h-30">
                            <div class="activity-detail-block">
                                <h2>Services Offered @renderEditButtion(Model, "services", "Edit")</h2>
                            </div>

                            @renderAccountProperties(servicesOffered, Math.Ceiling(servicesOffered.Count() / 3.0).ToInteger())

                        </div>
                    </div>

                    <div class="margin-v-40">
                        <hr style="border-color: #efefef;" />
                    </div>
                }

                @if (skillsAndMethods.Any() || isInEditMode)
                {
                    <div class="margin-t-20">
                        <div class="row padding-h-30">
                            <div class="activity-detail-block">
                                <h2>Skills &amp; Teaching Methods @renderEditButtion(Model, "services")</h2>
                            </div>

                            @renderAccountProperties(skillsAndMethods, Math.Ceiling(skillsAndMethods.Count() / 3.0).ToInteger())

                        </div>
                    </div>

                    <div class="margin-v-40">
                        <hr style="border-color: #efefef;" />
                    </div>
                }

                @if (specialNeedsOffered.Any() || isInEditMode)
                {
                    <div class="margin-t-20">
                        <div class="row padding-h-30">
                            <div class="activity-detail-block">
                                <h2>Special Needs Offerings @renderEditButtion(Model, "services")</h2>
                            </div>

                            @renderAccountProperties(specialNeedsOffered, Math.Ceiling(specialNeedsOffered.Count() / 3.0).ToInteger())

                        </div>
                    </div>

                    <div class="margin-v-40">
                        <hr style="border-color: #efefef;" />
                    </div>
                }

                @if (awards.Any() || certifications.Any() || isInEditMode)
                {
                    <div class="margin-t-20">
                        <div class="row padding-h-20">

                            @if (awards.Any() || isInEditMode)
                            {
                                <div class="col-md-6 col-sm-12">

                                    <h2>Awards @renderEditButtion(Model, "awards")</h2>

                                    @foreach (var award in awards.Where(x => x.Value.IsNotEmpty()))
                                    {
                                        <p class="activity-detail-block">
                                            <i class="s7-medal text-warning icon-large"></i>
                                            <span class="text-medium-small">@award.Value</span>
                                        </p>
                                    }

                                </div>
                            }

                            @if (certifications.Any() || isInEditMode)
                            {
                                <div class="col-md-6 col-sm-12">
                                    <h2>Certifications @renderEditButtion(Model, "certifications")</h2>

                                    @foreach (var certification in certifications.Where(x => x.Value.IsNotEmpty()))
                                    {
                                        <p class="activity-detail-block">
                                            <i class="s7-star text-warning icon-large" style="padding-top: 20px;"></i>
                                            <span class="text-medium-small" style="margin-top: -30px;">@certification.Value</span>
                                        </p>
                                    }

                                </div>
                            }

                        </div>
                    </div>

                }

                @if (accountProfile.About.IsNotBlank() || isInEditMode)
                {
                    <div class="margin-t-20">
                        <div class="row padding-h-30">
                            <h2>About @renderEditButtion(Model, "profileabout")</h2>
                            <div class="activity-detail-block">
                                @Html.Raw(accountProfile.About)
                            </div>
                        </div>
                    </div>
                }

                @if (location.IsNotEmpty())
                {
                    // var locationsQuery = locations.Select(l => Url.Encode(l.GetAddress())).ToStringList(",");

                    <div class="margin-t-20">
                        <div class="row padding-h-30">
                            <div class="col-md-12">
                                <div class="activity-detail-block">
                                    <div class="row">
                                        <div>
                                            <h2>Location @renderEditButtion(Model, "contactinfo")</h2>
                                        </div>
                                        <div>
                                            <p>
                                                @ParticipationObjectUI.PrintLocation(location)
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="height: 400px;">
                        <div style="position: relative; margin-left: -20px; margin-right: -20px">
                            <iframe width="100%"
                                    height="300"
                                    frameborder="0"
                                    style="border:0"
                                    src="https://www.google.com/maps/embed/v1/place?q=@Url.Encode(location.FormatAddressWithoutName())&key=AIzaSyAdjn8QBBStTz9TDAjZOyijAato7uzvjjk"
                                    allowfullscreen>
                            </iframe>
                        </div>
                    </div>
                }

            </div>
            <div class="panel-footer">
                <div class="col-md-12 text-center">
                    <div class="padding-v-20 padding-h-30">

                        @renderEditButtion(Model, "links")

                        @if (Model.Phone.IsNotBlank())
                        {
                            <div class="footer-social-icon">
                                <a href="tel:@Model.Phone"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-android-phone-portrait"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.Website.IsNotBlank())
                        {
                            <div class="footer-social-icon">
                                <a href="@(accountProfile.Website.StartsWith("http") ? "" : "https://")@accountProfile.Website"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-ios-world-outline"></i>
                                </a>
                            </div>
                        }
                        @if (Model.Email.IsNotBlank())
                        {
                            <div class="footer-social-icon">
                                <a href="mailto:@Model.Email"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-ios-email-outline"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.Twitter.IsNotEmpty())
                        {
                            <div class="footer-social-icon">
                                <a href="@accountProfile.TwitterUrl"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-social-twitter-outline"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.Instagram.IsNotEmpty())
                        {
                            <div class="footer-social-icon">
                                <a href="@accountProfile.InstagramUrl"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-social-instagram-outline"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.Facebook.IsNotEmpty())
                        {
                            <div class="footer-social-icon">
                                <a href="@accountProfile.Facebook"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-social-facebook-outline"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.YouTube.IsNotEmpty())
                        {
                            <div class="footer-social-icon">
                                <a href="@accountProfile.YouTube"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-social-youtube-outline"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.LinkedIn.IsNotEmpty())
                        {
                            <div class="footer-social-icon">
                                <a href="@accountProfile.LinkedIn"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-social-linkedin-outline"></i>
                                </a>
                            </div>
                        }
                        @if (accountProfile.CalendarBookingLink.IsNotEmpty())
                        {
                            <div class="footer-social-icon">
                                <a href="@accountProfile.CalendarBookingLink"
                                   target="_blank"
                                   class="icon-xlarge margin-h-30"
                                   style="text-decoration: none;">
                                    <i class="ion-ios-calendar-outline"></i>
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>