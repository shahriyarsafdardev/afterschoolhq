    div > .activity-section-header
    {
        border-top-left-radius : 8px;
        border-top-right-radius : 8px;
    }
    
    .am-wrapper.notopmenu.am-nosidebar-left
    {
        background-color: #fff;
    }
    #about-section{
    padding-left: 25px; padding-right: 25px
    }
       
</style>

@{
    Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", Model, new ViewDataDictionary
    {
        {"LoginReturnUrl", Model.HomePageUrl},
        {"IsAccount", true},
        {"CleverSsoEnabled", cleverSsoEnabled},
    });
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_RegistrationHeader.cshtml", new RegistrationHeaderViewModel(Model, (AccountProfile) ViewBag.AccountProfile)); }

@helper RenderEditButton(Account account, string anchor, string buttonText = "Edit")
{
    if (SessionVariables.CurrentUser.IsNotEmpty() && SessionVariables.CurrentUser.HasAccessTo(Model) && Request["edit"] == "1")
    {
        var redirectUrl = $"{Url.Action("style", "account", new {area = "org", isfullscreen = 1, returnurl = Request.Url, type = (int) ActivityType.Activity})}#{anchor}";

        <span>
            <a href="@Url.Action("switch", "logout", new {id = account.Uid, redirectUrl})#@anchor"
               class="btn btn-alt7 btn-sm">
                @buttonText &raquo;
            </a>
        </span>
    }
}

@helper RenderAccountProperties(IEnumerable<AccountProperty> accountProperties, int propertiesPerCol)
{
    for (var i = 0; i < 3; i++)
    {
        <div class="col-md-4">
            @foreach (var property in accountProperties.OrderBy(x => x.Value).Skip(i * propertiesPerCol).ToList().Take(propertiesPerCol))
            {
                var icon = "";
                var iconTitle = "";

                switch (property.AccountPropertyTypeId)
                {
                    case AccountPropertyType.Classifications:
                        icon = "s7-gleam";
                        iconTitle = "Activity Type";
                        break;
                    case AccountPropertyType.AcademicSubjects:
                        icon = "s7-study";
                        iconTitle = "Academic Subject";
                        break;
                    case AccountPropertyType.PricingOption:
                        icon = "s7-credit";
                        iconTitle = "Pricing Option";
                        break;
                    case AccountPropertyType.ServiceOffered:
                        icon = "s7-ticket";
                        iconTitle = "Type of Service";
                        break;
                    case AccountPropertyType.SoftSkills:
                        icon = "s7-users";
                        iconTitle = "Soft Skill";
                        break;
                    case AccountPropertyType.TeachingMethods:
                        icon = "s7-display2";
                        iconTitle = "Teaching Method";
                        break;
                    case AccountPropertyType.TimeOffered:
                        icon = "s7-clock";
                        iconTitle = "Time Offered";
                        break;
                    case AccountPropertyType.SpecialNeedsOffering:
                        icon = "s7-user";
                        iconTitle = "Special Needs Offerings";
                        break;
                }

                <p class="activity-detail-block">
                    <i class="@icon icon-medium text-success" style="padding-top: 20px;" title="@iconTitle"></i>
                    <span class="text-medium" style="margin-top: -30px;">@property.Value</span>
                </p>
            }
        </div>
    }
}

<div>
<div class="col-md-12 col-lg-10 col-lg-offset-1 participation-object participation-object-detail">

<!--<div class="panel panel-alt6"> !-->

<div>
<div class="panel-body">

