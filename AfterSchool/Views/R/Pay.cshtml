@using Stripe
@model AfterSchoolLibrary.Models.Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;

    var msgs = (SystemMessages) ViewBag.Messages;
    var accountProfile = (AccountProfile) ViewBag.AccountProfile;
    var sources = (List<Source>) ViewBag.Sources;
    var bankAccounts = (List<BankAccount>) ViewBag.BankAccounts;

    var cleverSsoEnabled = ViewBag.CleverSsoEnabled;
}

@{
    Html.RenderPartial(
        "~/Views/Shared/Registration/_AccountTopBar.cshtml",
        Model,
        new ViewDataDictionary
        {
            {"LoginReturnUrl", Model.HomePageUrl},
            {"CleverSsoEnabled", cleverSsoEnabled},
        });
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{
    Html.RenderPartial
        (
            "~/Views/Shared/Registration/_RegistrationHeader.cshtml",
            new RegistrationHeaderViewModel(Model, accountProfile),
            new ViewDataDictionary
            {
                {"hidebuttons", true},
            }
        );
}

<div>
    <div class="col-md-12 col-lg-10 col-lg-offset-1 col-lg-offset-2 participation-object participation-object-detail">

        <div class="panel panel-alt6">
            <div class="panel-heading" style="width: 100%;">
                <div class="row">
                    <div class="col-md-12">
                        <h3 class="text-center">
                            Make a Payment
                        </h3>
                        <p>Hi there hello</p>
                        <p>@(ViewBag.ProrateMessage)</p>
                    </div>
                </div>
            </div>
            <div class="panel-body">

                <div class="row pay-amount">
                    <div class="col-md-4 col-md-offset-4 col-sm-12 padding-30">
                        <div class="form-group">
                            <label for="amount" class="text-medium">Enter amount you want to pay</label>
                            <div class="input-group input-group-prepend">
                                <span class="input-group-addon">$</span>
                                <input type="number" name="amount" id="amount" value="" class="form-control text-medium" style="padding-right: 5px;" min="5.00" step=".01"/>
                            </div>
                            <p class="text-muted text-small" id="amount-error">Please enter an amount greater than or equal to $5</p>
                        </div>

                        <div class="form-group">
                            <label for="paymentdescription" class="text-medium">What is this for?</label>
                            <textarea class="form-control" id="payment-description"></textarea>
                        </div>

                        <div class="form-group">
                            <button class="btn btn-register-primary" id="btn-validate" onclick="validateAmount()">
                                Continue &raquo;
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row pay-buttons hide">

                    <div class="row">
                        <div class="col-md-4 col-md-offset-4 col-sm-12">
                            <div class="form-group text-center text-medium">
                                <button onclick="showAmount()" class="btn btn-link">&laquo; Change Payment Amount</button>
                            </div>
                            <div class="form-group text-center">
                                <p class="text-xlarge">$<span class="total-due-today-ach"></span></p>
                            </div>
                        </div>
                    </div>

                    <div>
                        @{
                            Html.RenderPartial(
                                "~/Views/Shared/Registration/_PayButtons.cshtml",
                                new ViewDataDictionary
                                {
                                    {"sources", sources},
                                    {"bankAccounts", bankAccounts},
                                    {"formActionUrl", Url.Action("pay", "account", new {id = Model.Uid})},
                                    {"acceptACH", true},
                                }
                                );
                        }
                    </div>
                </div>

            </div>
            <div class="panel-footer">
                <div class="col-md-12 text-center">
                    <p class="padding-v-20 padding-h-30">

                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function validateAmount() {

        const amount = $('#amount').val();

        if (amount.trim().length == 0 || isNaN(amount)) {
            showAmountError();
            return;
        }

        if (parseFloat(amount) < 5) {
            showAmountError();
            return;
        }

        hideAmountError();

        $.get('@Url.Action("getcreditcardfees", "services")/@Model.Uid?amount=' + amount, function (data) {

            if (data && data.status === 'ok') {

                const ccFees = data.creditCardFee;
                const achAmount = parseFloat(amount);
                const ccAmount = achAmount + ccFees

                $('.total-due-today-ach').html(achAmount.toFixed(2));
                $('.total-due-today-cc').html(ccAmount.toFixed(2));
                $('.total-fee-ccf').html(ccFees.toFixed(2));
                
                const hiddenFieldcc = '<input type="hidden" name="amount" value="' + achAmount.toFixed(2) + '">';
                const hiddenFieldach = '<input type="hidden" name="amount" value="' + achAmount.toFixed(2) + '">';
                
                $('#existing-payment-form-cc').append(hiddenFieldcc);
                $('#payment-form').append(hiddenFieldcc);                
                $('#existing-payment-form-ach').append(hiddenFieldach);
                $('#payment-form-ach').append(hiddenFieldach);

                console.log($('#payment-description').val());

                $('.payment-description').val($('#payment-description').val());

                showPayButtons();

            } else {
                Notifications.showErrors(data.messages);
            }
        });

    }

    function showAmountError() {
        if (!$('#amount-error').hasClass('text-danger')) {
            $('#amount-error').addClass('text-danger');
        }
    }

    function hideAmountError() {
        $('#amount-error').removeClass('text-danger');
    }

    function showAmount() {
        $('.pay-buttons').addClass('hide');
        $('.pay-amount').removeClass('hide');
    }

    function showPayButtons() {
        $('.pay-buttons').removeClass('hide');
        $('.pay-amount').addClass('hide');
    }

</script>