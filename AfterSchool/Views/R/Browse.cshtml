@model Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;
    var participationObjects = (List<ParticipationObject>)ViewBag.ParticipationObjects;
    var grades = (List<GradeLevel>)ViewBag.Grades;
    var cart = (Cart)ViewBag.Cart;
    var locations = (List<Location>)ViewBag.Locations;
    var registrationOpen = (List<ParticipationObject>)ViewBag.RegistrationOpened;
    var registrationClosed = (List<ParticipationObject>)ViewBag.RegistrationClosed;
    var registrationWillOpen = (List<ParticipationObject>)ViewBag.RegistrationWillOpen;
    var session = (ParticipationObject)ViewBag.Session;
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountProfile = (AccountProfile)ViewBag.AccountProfile;
}

@{ Html.RenderPartial(
         "~/Views/Shared/Registration/_AccountTopBar.cshtml",
         Model,
         new ViewDataDictionary() { { "LoginReturnUrl", Model.HomePageUrl }, { "session", session } }); }

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

@{ Html.RenderPartial(
       "~/Views/Shared/Registration/_RegistrationHeader.cshtml", 
       new RegistrationHeaderViewModel(
           Model, 
           (AccountProfile)ViewBag.AccountProfile, 
           (ParticipationObject)ViewBag.Session)); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_FirstTimeInformation.cshtml", Model); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_BrowseFilterBar.cshtml", Model); }

<div class="margin-10">

    @{
        // Html.RenderPartial("~/Views/Shared/Registration/_AddActivity.cshtml", Model);
    }

    <div class="col-lg-10 col-lg-offset-1 col-md-12">
        @if (!registrationOpen.Any() && !registrationWillOpen.Any() && !registrationClosed.Any())
        {
            <div class="row">
                <div class="col-md-12 text-center">
                    <h3>No activities currently open for registration</h3>
                    @if (accountProfile.IsNotEmpty() && (accountProfile.ProfileEmail.IsNotEmpty() || accountProfile.ProfilePhone.IsNotEmpty()))
                    {
                        <p>
                            Have questions? Please contact @Model.Name @@ @Html.Raw(accountProfile.ProfilePhone.IsNotBlank() ? accountProfile.ProfilePhone : $"<a href=\"mailto:{accountProfile.ProfileEmail}\">{accountProfile.ProfileEmail}</a>")
                        </p>
                    }
                </div>
            </div>
        }

        @if (registrationOpen.Any())
        {
            <div class="row">
                <div class="col-md-12 text-center">
                    <h3>Open for Registration</h3>
                </div>

                @foreach (var item in registrationOpen)
                {
                    Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObjectWide.cshtml", item);
                }
            </div>
            <hr />
        }

        @if (registrationWillOpen.Any())
        {
            <div class="row">
                <div class="col-md-12 text-center">
                    <h3>Registration Opening Soon</h3>
                </div>

                @foreach (var item in registrationWillOpen)
                {
                    Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObjectWide.cshtml", item);
                }
            </div>
            <hr />
        }

        @if (registrationClosed.Any())
        {
            <div class="row">
                <div class="col-md-12 text-center">
                    <h3>Registration Closed</h3>
                </div>

                @foreach (var item in registrationClosed)
                {
                    Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObjectWide.cshtml", item);
                }
            </div>
            <hr />
        }
    </div>

    

</div>

@if (session.IsNotEmpty())
{
    Html.RenderPartial("~/Views/Shared/Registration/_BrowseCart.cshtml", session);
}

@{Html.RenderPartial("~/Views/Shared/Modals/_LeadForm.cshtml", Model);}

@{Html.RenderPartial("~/Views/Shared/Modals/_FirstTimeDemoOrgName.cshtml", Model);}
