@model Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;
    var objects = (List<ParticipationObject>)ViewBag.ParticipationObjects;
    var grades = (List<GradeLevel>)ViewBag.Grades;
    var cart = (Cart)ViewBag.Cart;
    var locations = (List<Location>)ViewBag.Locations;
}

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", null); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_BrowseRegistrationHeader.cshtml", Model); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_BrowseFilterBar.cshtml", Model); }

<div class="margin-10">
    @foreach (var item in objects)
    {
        Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObject.cshtml", item);
    }
</div>

<div id="search-noresults" class="hide">
    <h1 class="text-center">Sorry, there are no activities</h1>
</div>


@{Html.RenderPartial("~/Views/Shared/Modals/_LeadForm.cshtml", Model);}