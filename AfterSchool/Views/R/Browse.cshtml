@model Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;
    var objects = (List<ParticipationObject>)ViewBag.ParticipationObjects;
    var filterCols = 2;
    var filterColsSm = 12;
    var grades = (List<GradeLevel>)ViewBag.Grades;
    var cart = (Cart)ViewBag.Cart;
    var locations = (List<Location>)ViewBag.Locations;
}

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml"); }

<div class="reg-header">
    <div class="reg-header-overlay">
        <h1 class="activity-title"><strong>@Model.Name</strong></h1>
        <p>@Model.LandingPageText</p>
    </div>
</div>

<div class="filter-bar">
    <div class="reg-container">
        <div class="col-md-@filterCols col-sm-@filterColsSm">
            <input type="text" placeholder="Search @UILabel.ActivityLabel(ActivityType.Activity) Name" id="search-name" class="form-control search-field" />
        </div>    
               
        <div class="col-md-@filterCols col-sm-@filterColsSm">
            <select class="form-control reg-form-control" id="search-location" name="search-location">
                <option value="">Any Location</option>
                @foreach (var location in locations)
                {
                    <option value="@(location.ID)">@location.FormatAddress(false)</option>
                }
            </select>
        </div>     

        <div class="col-md-@filterCols col-sm-@filterColsSm">
            <select class="form-control reg-form-control" id="search-grade" name="search-grade">
                <option value="">Any Grade</option>
                @foreach (var grade in grades)
                {
                    <option value="@grade.ID" @(SessionVariables.Cart?.GradeLevel == grade.ID ? "selected=\"selected\"" : "")>@grade.Name</option>
                }
            </select>
        </div>

        <div class="col-md-@filterCols col-sm-@filterColsSm">
            <select class="form-control reg-form-control" id="search-seatsfilled" name="search-seatsfilled">
                <option value="">All Activities</option>
                <option value="1">Has Seats Available</option>
                <option value="2">Has Waiting List Available</option>
            </select>
        </div>    

        <div class="col-md-@filterCols col-sm-@filterColsSm">
            <select class="form-control reg-form-control" id="search-dayofweek" name="search-dayofweek">
                <option value="">Any Day</option>
                @foreach (var item in Enum.GetValues(typeof(DayOfWeekASL)).Cast<DayOfWeekASL>().Where(x => x != DayOfWeekASL.NotSet))
                {
                    <option value="@item.ToString().MaxChars(2)">@item.ToString()</option>
                }
            </select>
        </div>      
       
        <div class="col-md-@filterCols col-sm-@filterColsSm">
            <select class="form-control reg-form-control" id="search-gender" name="search-gender">
                <option value="">Any Gender</option>
                @foreach (var item in Enum.GetValues(typeof(GenderType)).Cast<GenderType>().Where(x => x != GenderType.NotSet))
                {
                    <option value="@((int)item)" @(SessionVariables.Cart?.Gender == item ? "selected=\"selected\"" : "")>@item.ToString().SplitByUpperCase()</option>
                }
            </select>
        </div>
        
    </div>
</div>

<div class="margin-10">
    @foreach(var item in objects)
    {
        <div class="col-sm-12 col-md-6 col-lg-4 participation-object" 
             id="@item.Uid" 
             mingrade="@item.MinGradeId" 
             maxgrade="@item.MaxGradeId" 
             hasseatsremaining="@item.HasSeatsAvailable().ToString().ToLower()" 
             haswaitinglistremaining="@item.HasWaitingListSeatsAvailable().ToString().ToLower()"
             days="@ParticipationObjectUI.PrintDaysOfWeek(item)" 
             location="@(item.Location?.ID)"
             gender="@((int)item.GenderRestriction)"
             name="@item.Name">

            <div class="panel">
                <div class="heading panel-h3">
                    <h3><strong>@item.Name</strong></h3>
                </div>
                <div class="panel-body">
                    <div>
                        <p class="text-medium-small">
                            <span>
                                @item.OwnerAccount.Name
                            </span>
                            @if (item.Location.IsNotEmpty() && item.Location.ID != item.OwnerAccount.DefaultLocationId)
                            {
                                <span>
                                    @@
                                    @item.Location.Name
                                </span>
                            }
                        </p>
                    </div>
                    <div>
                        <span class="reg-info">
                            @ParticipationObjectUI.PrintDaysOfWeek(item)
                        </span>
                        &bull;
                        <span class="reg-info">
                            @ParticipationObjectUI.PrintGradeLevels(item) Grade
                        </span>
                        &bull;
                        <span class="reg-info">
                            @ParticipationObjectUI.PrintGenderRestrictions(item)
                        </span>
                    </div>

                    <p class="activity-description text-muted">
                        @Html.Raw(item.Description.MaxChars(80, "...").IfEmpty(BasicLibrary.Utilities.RemoveHTMLAndEntities(item.Details).MaxChars(80, "...")))
                    </p>

                    <div>
                        <a href="@item.GetHomePageUrl(SessionVariables.IsAfterSchool.Value)" class="btn btn-primary btn-register btn-block">
                            Learn More &raquo;
                        </a>
                    </div>
                    <div class="seats-remaining text-center">
                        @if (item.SeatsRemaining.HasValue)
                        {
                            <strong>
                                <em>
                                    @if (!item.RegistrationPeriod.IsClosed(item.OwnerAccount))
                                    {
                                        @:@item.SeatsRemaining.ToString() Seats @(item.RegistrationMode == RegistrationMode.Register ? "Left" : "")
                                    }
                                    else
                                    {
                                        @:Closed
                                    }
                                    
                                </em>
                            </strong>
                        }
                    </div>
                </div>
                <div class="panel-footer">
                    <p>
                        @ParticipationObjectUI.PrintRegistrationPeriod(item)
                    </p>
                </div>
            </div>
        </div>
    }
</div>

<div id="search-noresults" class="hide">
    <h1 class="text-center">Sorry, there are no activities</h1>
</div>

<script>
    PageEvent.add(PageEvent.AFTER_INIT, function () {
        $('#search-name').keyup(function () {
            search();
        });
        $('#search-seatsfilled, #search-grade, #search-gender, #search-dayofweek, #search-location').change(function () {
            search();
        });
    });

    function search() {

        var name = $('#search-name').val();
        var seatsfilled = $('#search-seatsfilled').val();
        var grade = $('#search-grade').val();
        var gender = $('#search-gender').val();
        var dayofweek = $('#search-dayofweek').val();
        var location = $('#search-location').val();

        var totalDivs = 0;
        var hiddenDivs = 0;

        $('.participation-object').each(function () {
            $(this).removeClass('hide');
            totalDivs++;
        });

        if (name != null && name.length > 0) {
            $('.participation-object').each(function () {
                if ($(this).attr('name').toLowerCase().indexOf(name.toLowerCase()) == -1 && !$(this).hasClass('hide')) {
                    $(this).addClass('hide');
                    hiddenDivs++;
                }
            });
        }

        if (grade != null && grade.length > 0) {
            $('.participation-object').each(function () {
                if ((parseInt(grade) < parseInt($(this).attr('mingrade')) || parseInt(grade) > parseInt($(this).attr('maxgrade'))) && !$(this).hasClass('hide')) {
                    $(this).addClass('hide');
                    hiddenDivs++;
                }
            });
        }

        if (gender != null && gender.length > 0) {
            $('.participation-object').each(function () {
                var genderRestriction = parseInt($(this).attr('genderrestriction'));
                if (genderRestriction > 0 && genderRestriction != gender && !$(this).hasClass('hide')) {
                    $(this).addClass('hide');
                    hiddenDivs++;
                }
            });
        }

        if (dayofweek != null && dayofweek.length > 0) {
            $('.participation-object').each(function () {
                var days = $(this).attr('days').split(',');
                if (days.indexOf(dayofweek) == -1 && !$(this).hasClass('hide')) {
                    $(this).addClass('hide');
                    hiddenDivs++;
                }
            });
        }

        if (location != null && location.length > 0) {
            $('.participation-object').each(function () {
                if ($(this).attr('location') != location && !$(this).hasClass('hide')) {
                    $(this).addClass('hide');
                    hiddenDivs++;
                }
            });
        }

        if (seatsfilled != null && seatsfilled.length > 0) {
            $('.participation-object').each(function () {
                switch (seatsfilled) {
                    case '1':
                        if ($(this).attr('hasseatsremaining') != "true" && !$(this).hasClass('hide')) {
                            $(this).addClass('hide');
                            hiddenDivs++;
                        }
                        break;
                    case '2':
                        if ($(this).attr('haswaitinglistremaining') != "true" && !$(this).hasClass('hide')) {
                            $(this).addClass('hide');
                            hiddenDivs++;
                        }
                        break;
                }
            });
        }
        
        if (hiddenDivs == totalDivs) {
            $('#search-noresults').removeClass('hide');
        } else {
            $('#search-noresults').addClass('hide');
        }

    }
</script>