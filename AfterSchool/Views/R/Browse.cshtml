@model Account
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;
    var objects = (List<ParticipationObject>)ViewBag.ParticipationObjects;
    var grades = (List<GradeLevel>)ViewBag.Grades;
    var cart = (Cart)ViewBag.Cart;
    var locations = (List<Location>)ViewBag.Locations;
    var showAdd = !Model.ID.HasValue || (
        SessionVariables.LoggedInUser.IsNotEmpty() &&
        SessionVariables.AccountUserType.NotIn(new List<UserType>() { UserType.Parent, UserType.Student }));

    var addActivityUrl = "";

    if (showAdd)
    {
        addActivityUrl = Url.Action("editsetup", "activity", new { isnew = 1, Area = "org" });

        if (!Model.ID.HasValue)
        {
            addActivityUrl = Url.Action("index", "signup", new { orgname = Model.Name });
        }
    }
}

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", null); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_BrowseRegistrationHeader.cshtml", Model); }

@{ Html.RenderPartial("~/Views/Shared/Registration/_BrowseFilterBar.cshtml", Model); }

<div class="margin-10">

    @if (showAdd)
    {
        <div class="col-sm-12 col-md-6 col-lg-4 participation-object pointer" onclick="location.href='@addActivityUrl'">
            <div class="panel">
                <div class="panel-body">
                    <div class="padding-v-30 margin-t-20">
                        <p class="text-center">
                            <i class="s7-plus icon-xxlarge text-success"></i>
                        </p>
                        <p>&nbsp;</p>
                        <p class="text-center text-xlarge text-success">                       
                            Add Activity
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }

    @foreach (var item in objects)
    {
        Html.RenderPartial("~/Views/Shared/Registration/_BrowseParticipationObject.cshtml", item);
    }
</div>

@{Html.RenderPartial("~/Views/Shared/Modals/_LeadForm.cshtml", Model);}