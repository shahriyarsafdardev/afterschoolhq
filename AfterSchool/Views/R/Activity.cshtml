@model ParticipationObject
@{
    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
    ViewBag.Title = Model.Name;
    var account = (Account)ViewBag.Account;
    var msgs = (SystemMessages)ViewBag.Messages;
}

@{ Html.RenderPartial("~/Views/Shared/Registration/_AccountTopBar.cshtml", account); }

<div class="reg-header text-center">
    <h1 class="activity-title">
        @Model.Name
        @if (!Model.OwnerAccount.ID.HasValue)
        {
            <span class="badge badge-danger">DEMO</span>
        }
    </h1>
    <div class="activity-headline">
        @Model.Description
    </div>
</div>

<div>
    <div class="col-md-6 col-md-offset-3">
        <div class="panel panel-alt6">
            <div class="panel-heading">
                <div class="row">
                    <div class="col-lg-8 col-md-12">
                        <h3 class="text-white text-center">
                            @ParticipationObjectUI.PrintDaysOfWeek(Model) &bull;
                            @ParticipationObjectUI.PrintGradeLevels(Model) &bull;
                            @ParticipationObjectUI.PrintGenderRestrictions(Model)
                        </h3>
                    </div>
                    <div class="col-lg-4 col-md-12">
                        @{ Html.RenderPartial("~/Views/Shared/Registration/_RegisterButton.cshtml", Model, new ViewDataDictionary() { { "condensed", true } }); }
                    </div>
                </div>
            </div>
            <div class="panel-body">

                <div class="activity-detail-block">
                    @Html.Raw(Model.Details)
                </div>

                <div class="activity-detail-block">
                    <h3>Schedule</h3>
                    <p>
                        @{ Html.RenderPartial("_ActivityScheduleHtml", Model.Schedule); }
                    </p>
                </div>

                @if (Model.Location.IsNotEmpty())
                {
                    <div class="activity-detail-block">
                        <h3>Location <a href="@Model.Location.GetGoogleMapsLink()" target="_blank"><i class="s7-map-marker"></i></a></h3>
                        <p>
                            <a href="@Model.Location.GetGoogleMapsLink()" target="_blank">@ParticipationObjectUI.PrintLocation(Model)</a>
                        </p>
                        @if (Model.LocationDetails.IsNotEmpty())
                        {
                            @:@Html.Raw(Model.LocationDetails)
                        }
                    </div>
                }

                <div class="activity-detail-block">
                    <h3>
                        @{ Html.RenderPartial("~/Views/Shared/ParticipationObject/_FreeTuition.cshtml", Model); }
                    </h3>
                    @if (!Model.IsFree)
                    {
                        if (!Model.PaymentPlans.Any())
                        {
                            Html.RenderPartial("~/Views/Shared/ParticipationObject/_TuitionAndNoPaymentPlans.cshtml", Model);
                        }
                        else
                        {
                            Html.RenderPartial("~/Views/Shared/ParticipationObject/_TuitionAndPaymentPlans.cshtml", Model);
                        }

                        if (Model.CostDescription.IsNotEmpty())
                        {
                            <p class="padding-v-10">
                                @Model.CostDescription
                            </p>
                        }
                    }
                </div>

                <div class="activity-detail-block">
                    <h3>Contact</h3>
                    <p>
                        @Model.ContactName &bull;
                        <a href="mailto:@Model.ContactEmail">@Model.ContactEmail</a> &bull;
                        @Model.ContactPhone
                    </p>
                </div>

                <div class="margin-10">
                    @{ Html.RenderPartial("~/Views/Shared/Registration/_RegisterButton.cshtml", Model); }
                </div>

            </div>
            <div class="panel-footer">
                <p class="text-center">
                    @ParticipationObjectUI.PrintRegistrationPeriod(Model)
                </p>
            </div>
        </div>
    </div>
</div>

@{Html.RenderPartial("~/Views/Shared/Modals/_LeadForm.cshtml", Model.OwnerAccount);}