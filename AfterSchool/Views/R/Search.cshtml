@{
    var accountUniqueName = (string)ViewBag.AccountUniqueName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountId = ViewBag.AccountId != null ? Convert.ToInt32(ViewBag.AccountId) : 0;
    var primaryColor = (string)ViewBag.PrimaryColor;
    var logoUrl = (string)ViewBag.LogoUrl;
    var headerImageUrl = (string)ViewBag.HeaderImageUrl;
    var joiningUrl = $@"/join{accountUniqueName}.html";
    var website = (string)ViewBag.Website;

    if (!logoUrl.IsNotEmpty())
    {
        logoUrl = "/img/logo-vertical.png";
    }

    if (!primaryColor.IsNotEmpty() || primaryColor.IsBlank())
    {
        primaryColor = "#00ae85";
    }

    //.. data for layout
    ViewBag.Title = accountUniqueName;
    if (accountId > 0)
    {
        ViewBag.AccountProfile = AccountProfile.LoadByAccountId(accountId);
    }

    Layout = "~/Views/Shared/_LayoutRegistration.cshtml"; }

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<style>
    .search-bg {
        background-image: linear-gradient(rgba(0, 0, 0, .8), rgba(0, 0, 0, .8)), url( @headerImageUrl ) !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
        background-position: center !important;
        justify-content: center !important;
        align-items: center !important;
    }

    .join-directory-btn {
        color: white !important;
        min-width: 180px;
        background-color: @primaryColor !important;
    }

    .isyp-modal-header {
        padding: 0;
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/img/image-3-1800x900-1.png);
        background-repeat: no-repeat;
        background-size: cover !important;
        background-position: center !important;
        justify-content: center !important;
        align-items: center !important;
        height: 200px;
    }

    .has-search .form-control:focus {
        border-color: @primaryColor;
    }

    .btn-generic {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white;
    }

    .primary-color {
        color: @primaryColor;
    }

    .primary-bg-color {
        background-color: @primaryColor;
    }

    .primary-border-color {
        border-color: @primaryColor;
    }

    .am-generic-checkbox input[type="checkbox"] + label::before {
        border: solid 1px @primaryColor !important;
        margin: 0 10px 0 0 !important;
    }

    .am-generic-checkbox input[type="checkbox"]:checked + label::before {
        background-color: @primaryColor;
        color: white;
        border-color: @primaryColor;
    }

</style>

<div class="visible-lg visible-md">
    <div class="row" style="border-bottom: 2px solid @primaryColor;">
        <div class="@(headerImageUrl.IsNotEmpty() ? "search-bg" : "")" style="min-height: 100%; background: white; padding: 35px 20px;">
            <div class="reg-header-overlay col-md-12">
                <div class="col-lg-3 col-md-3 header-logo" style="margin-top: -25px;">
                    <a href=@(website.IsNotEmpty() ? website : "")>
                        <img src="@logoUrl" style="width: 110px;" />
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

@{ Html.RenderPartial("~/Views/Shared/_DirectoryMobileSearch.cshtml"); }

<div id="main-view-container" class="display-flex">
    <div id="list-view" class="flex-1">
        <div id="filters" class="col-md-3 directory-filters">
            <span class="primary-color directory-sidebar-arrow" isOpen="true" onclick="return toggleSideBar(this)">
                <i id="search-sidebar-arrow" class="fa fa-chevron-circle-left" aria-hidden="true"></i>
            </span>

            @{ Html.RenderPartial("~/Views/Shared/_DirectoryFilters.cshtml"); }
        </div>

        <div id="search-container" class="directory-search-container col-md-9 pt-20 pb-20">

            <div class="col-lg-9 col-md-9">
                <div class="form-group has-feedback has-search" style="margin-left: 20px;">
                    <input id="txtSearch" name="search" type="text" class="form-control directory-search-input" placeholder="Search For Programs" onkeyup="return waitAndFilterSearch(this.value)">
                    <span class="glyphicon glyphicon-search form-control-feedback directory-search-magnyfier-icon"></span>
                </div>
            </div>

            <div class="am-checkbox am-generic-checkbox col-lg-3 col-md-3">
                <input id="chk-map-view" name="show-map" isEnabled="true" checked="checked" value="1" type="checkbox" class="schedulerepeat-checkbox" onclick="return toggleMapView(this)" />
                <label for="chk-map-view" class="margin-h-10 mobile-padding font-weight-bold">Show Map</label>
            </div>
            <div class="clearfix"></div>

            <div id="search-result" class="row"> </div>
            <div class="clearfix"></div>

            <div class="directory-search-no-result"></div>

            <div id="ProgressBar">
                <img src="~/img/lod_bg.gif">
            </div>

            <div id="notification-contact-us" class="text-center">
                <button class="btn btn-contact-us" style="border: 3px solid @primaryColor;" type="button" data-toggle="modal" data-target="#ContactUsModal">
                    Can't find what you are looking for?
                    <span class="contactSpan">CONTACT US</span>
                </button>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>

    <div id="map-view">
        <div id="map" style="height: 100%;"></div>
    </div>
</div>

<div class="clearfix"></div>

@{ Html.RenderPartial("~/Views/Shared/_ISYPIntroModal.cshtml", logoUrl); }

@{ Html.RenderPartial("~/Views/Shared/_DirectoryContactUs.cshtml"); }

@{ Html.RenderPartial("~/Views/Shared/_DirectoryLoadScript.cshtml", accountUniqueName); }

@section Scripts
{
    <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBq47Ro2O69sQhVLEW4_2L0ClOBSW_Srmc&libraries=places"></script>

    <script src="~/Assets/js/ahq-directory-search.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script type="text/javascript">

        var delayTimer;
        var txtSearch = $('#txtSearch');
        var txtSearchMobile = $('#txtSearch-mobile');
        var txtZip = $('#txtZipCode');
        var isMobile = window.innerWidth <= 768;
        var inCallback = false, page = 0, isReachedScrollEnd = false, isMobileFilterWindowOpened = false;

        $(document).ready(function () {
            var isIsyp =  @Json.Encode(accountUniqueName.ToUpper().Contains("ISYP")) && @Json.Encode(CookieVariables.ShowISYPModal.IsBlank());
            if (isIsyp) {
                showModalIsyp();
                @(CookieVariables.ShowISYPModal = "false")
            }

            directoryPageLoad();
            initMap();
        })

        function loadAccounts(search, neighborhoods, grades, ages, gender, services, timing, pricing, cost, starting, other, special, zip = 0) {
            if (inCallback) {
                return false;
            }

            showLoader();
            showProgressBar();
            inCallback = true;

            var url = '@Url.Action("GetAccounts", "Search", new { Area = "" })';
            $.ajax({
                type: "POST",
                url: url,
                data: { accountId: '@accountId', search, neighborhoods, grades, ages, gender, services, timing, pricing, cost, starting, other, special, zipcode: zip, pageNum: page },
                success: function (data) {
                    if (data && data.success == true) {

                        //.. prepare source and template
                        var source = $("#script-search-result-list").html();
                        var compiled = _.template(source);

                        //.. format data as JSON and combine with template
                        var compiledHtml = compiled({
                            response: data.data,
                            showDistance: data.showDistance
                        });

                        if (data.pageNum == 0) {
                            //..first page, so update whole page
                            $('#search-result').html(compiledHtml);
                        } else {
                            $('#search-result').append(compiledHtml);
                        }

                        page++;

                        if (data.data.length < 9) {
                            //..page size is less then the default, then it means no more records present
                            isReachedScrollEnd = true;
                        }

                        $('#notification-contact-us').show();
                        $('.directory-search-no-result').html('');
                    }
                    else {
                        if (data && data.status == 'error') {
                            $('#notification-contact-us').show();
                            $('#search-result').html('');

                            var error = '';

                            _.each(data.data, function (msg) {
                                error += msg?.Text + '<br />';
                            });

                            Notifications.showBar({
                                title: 'Error',
                                message: error,
                                success: false
                            });
                        }
                        else if (data && data.status == "no-result" && page <= 0) {
                            $('#notification-contact-us').show();
                            $('#search-result').html('');
                            $('.directory-search-no-result').html('<p>There are no activities that match this criteria. <br> To find more, remove filters or zoom out on the map.</p>');
                            isReachedScrollEnd = true;
                            page = 0;
                        }
                        else {
                            isReachedScrollEnd = true;
                            page = 0;
                        }
                    }

                    inCallback = false;
                    hideLoader();
                    hideProgressBar();
                    return false;
                }
            });
        }

        let map;
        let service;
        let infowindow;

        function initMap() {

            infowindow = new google.maps.InfoWindow();
            map = new google.maps.Map(document.getElementById("map"), {
                center: { lat: 39.76, lng: -86.15 },
                zoom: 10,
            });

            var request = {
                location: { lat: 39.76, lng: -86.15 },
                radius: '1000',
                type: ['school']
            };


            service = new google.maps.places.PlacesService(map);
            service.nearbySearch(request, callback);

        }
        function callback(results, status) {
            if (status == google.maps.places.PlacesServiceStatus.OK) {
                for (var i = 0; i < results.length; i++) {
                    createMarker(results[i]);
                }
            }
        }

        function createMarker(place) {
            if (!place.geometry || !place.geometry.location) return;

            const marker = new google.maps.Marker({
                map,
                position: place.geometry.location,
            });

            google.maps.event.addListener(marker, "click", () => {
                infowindow.setContent(place.name || "");
                infowindow.open(map);
            });
        }

    </script>
}
