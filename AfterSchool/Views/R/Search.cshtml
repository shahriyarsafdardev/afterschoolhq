@{
    var accountUniqueName = (string) ViewBag.AccountUniqueName;
    var msgs = (SystemMessages) ViewBag.Messages;
    var accountId = ViewBag.AccountId != null ? Convert.ToInt32(ViewBag.AccountId) : 0;
    var primaryColor = (string) ViewBag.PrimaryColor;
    var logoUrl = (string) ViewBag.LogoUrl;
    var headerImageUrl = (string) ViewBag.HeaderImageUrl;
    var joiningUrl = $@"/join{accountUniqueName}.html";
    var website = (string) ViewBag.Website;
    var grades = (List<GradeLevel>) ViewBag.Grades;

    if (!logoUrl.IsNotEmpty())
    {
        logoUrl = "/img/logo-vertical.png";
    }

    if (!primaryColor.IsNotEmpty() || primaryColor.IsBlank())
    {
        primaryColor = "#00ae85";
    }

    //.. data for layout
    ViewBag.Title = accountUniqueName;
    if (accountId > 0)
    {
        ViewBag.AccountProfile = AccountProfile.LoadByAccountId(accountId);
    }

    Layout = "~/Views/Shared/_LayoutRegistration.cshtml";
}

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<style>
    .join-directory-btn {
        color: white !important;
        min-width: 180px;
        background-color: @primaryColor !important;
    }

    .isyp-modal-header {
        padding: 0;
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('../../Assets/img/image-3-1800x900-1.png');
        background-repeat: no-repeat;
        background-size: cover !important;
        background-position: center !important;
        justify-content: center !important;
        align-items: center !important;
        height: 200px;
    }

    .has-search .form-control:focus {
        border-color: @primaryColor;
    }

    .btn-generic {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white;
    }
    .primary-color-border{
        border: 5px solid @primaryColor;
    }

    .primary-color {
        color: @primaryColor;
    }

    .primary-bg-color {
        background-color: @primaryColor;
    }

    .primary-border-color {
        border-color: @primaryColor;
    }

    .am-generic-checkbox input[type="checkbox"] + label::before {
        border: solid 1px @primaryColor !important;
        margin: 0px 5px -2px 0 !important;
    }

    .am-generic-checkbox input[type="checkbox"]:checked + label::before {
        background-color: @primaryColor;
        color: white;
        border-color: @primaryColor;
    }

    .checkbox-show-map input[type="checkbox"] + label::before {
        border: solid 1px @primaryColor !important;
        margin: 0px 5px 0px 0 !important;
    }

    .checkbox-show-map input[type="checkbox"]:checked + label::before {
        background-color: @primaryColor;
        color: white;
        border-color: @primaryColor;
    }

    .badge .close {
        font-size: 12px;
        position: absolute;
        color: black;
        opacity: 0.6;
        margin-top: -10px;
    }

    .close:hover, .close:focus {
        color: #000000;
        text-decoration: none;
        cursor: pointer;
        opacity: 1.5 !important;
        filter: alpha(opacity=50);
    }

    .search-container {
        display: flex;
        flex-direction: column;
        height: 100%;
        position: fixed;
        width: 100%;
    }
</style>

<div class="search-container">
    @{ Html.RenderPartial("~/Views/Shared/_DirectoryHeader.cshtml", null, new ViewDataDictionary {{"primaryColor", primaryColor}, {"website", website}, {"logoUrl", logoUrl}}); }

    @{ Html.RenderPartial("~/Views/Shared/_DirectoryContainer.cshtml", null, new ViewDataDictionary {{"primaryColor", primaryColor}, {"grades", grades}}); }
</div>
@{ Html.RenderPartial("~/Views/Shared/_ISYPIntroModal.cshtml", logoUrl); }

@{ Html.RenderPartial("~/Views/Shared/_DirectoryContactUs.cshtml"); }

@{ Html.RenderPartial("~/Views/Shared/_DirectoryLoadScript.cshtml", accountUniqueName); }

@section Scripts
{
    <script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBq47Ro2O69sQhVLEW4_2L0ClOBSW_Srmc&libraries=places"></script>
    <script src="~/Assets/js/ahq-directory-search.js"></script>
    <script src="~/Assets/js/ahq-directory-map.js"></script>
    <script src="~/Assets/js/ips-school-list.js"></script>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script type="text/javascript">

        var delayTimer;
        var txtSearch = $('#txtSearch');        
        var txtZip = $('#txtZipCode');
        var isMobile = window.innerWidth <= 1080;
        var inCallback = false, page = 0, isReachedScrollEnd = false, isMobileFilterWindowOpened = false;

        function loadIpsSchools() {
            ipsSchoolList.forEach( school => {
                addMarker(school.Latitude, school.Longitude, school.School, true);
                let option = $('<option>', {text: school.School});
                option.attr('data-latitude', school.Latitude);
                option.attr('data-longitude', school.Longitude);
                option.attr('data-zip-code', school.ZipCode);
                $('#ipsSchools').append(option);
            });
        }
        
        $(document).ready(function () {
            var isIsyp =  @Json.Encode(accountUniqueName.ToUpper().Contains("ISYP")) && @Json.Encode(CookieVariables.ShowISYPModal.IsBlank());
            if (isIsyp) {
                showModalIsyp();
                @(CookieVariables.ShowISYPModal = "false")
            }
            $("body").attr('style', 'overflow: hidden;');
            
            initMap();
            loadIpsSchools();
            directoryPageLoad();
        })

        function loadAccounts(search, enrollToday, grades, ages, gender, services, timing, pricing, cost, starting,
            other, special, zipCode, latitude, longitude) {

            if (inCallback) {
                return false;
            }

            showLoader();
            showProgressBar();
            inCallback = true;
            let url = '@Url.Action("GetAccounts", "Search", new {Area = ""})';
            $.ajax({
                type: "POST",
                url: url,
                data: { accountId: '@accountId', enrollToday, search, grades, ages, gender, services, timing, pricing,
                    cost, starting, other, special, zipCode, latitude, longitude, pageNum: page },
                success: function (data) {
                    if (data && data.success === true) {

                        //.. prepare source and template
                        let source = $("#script-search-result-list").html();
                        let compiled = _.template(source);

                        //.. format data as JSON and combine with template
                        let compiledHtml = compiled({
                            response: data.data,
                            showDistance: data.showDistance
                        });

                        if (data.pageNum === 0) {
                            //..first page, so update whole page
                            $('#search-result').html(compiledHtml);
                        } else {
                            $('#search-result').append(compiledHtml);
                        }

                        page++;

                        if (data.data.length === 0) {
                            isReachedScrollEnd = true;
                        }

                        $('#notification-contact-us').show();
                        $('.directory-search-no-result').html('');
                        if (data.data.length > 0) {
                            setTimeout(function () {
                                addMarkersOnMap(data.data);
                            }, 1000)
                        }
                    }
                    else {
                        if (data && data.status === 'error') {
                            $('#notification-contact-us').show();
                            $('#search-result').html('');

                            var error = '';

                            _.each(data.data, function (msg) {
                                error += msg?.Text + '<br />';
                            });

                            Notifications.showBar({
                                title: 'Error',
                                message: error,
                                success: false
                            });
                        }
                        else if (data && data.status === "no-result" && page <= 0) {
                            $('#notification-contact-us').show();
                            $('#search-result').html('');
                            $('.directory-search-no-result').html('<p>There are no activities that match this criteria. <br> To find more, remove filters.</p>');
                            isReachedScrollEnd = true;
                            page = 0;
                        }
                        else {
                            isReachedScrollEnd = true;
                            page = 0;
                        }
                    }

                    inCallback = false;
                    hideLoader();
                    hideProgressBar();
                    return false;
                }
            });
        }

        $(".am-filter-checkbox span").click(function (e) {
            e.stopPropagation();
            return false;
        });

    </script>
}