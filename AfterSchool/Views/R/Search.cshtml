@{
    var accountUniqueName = ViewBag.AccountUniqueName;
    var msgs = (SystemMessages)ViewBag.Messages;
    var accountId = ViewBag.AccountId != null ? Convert.ToInt32(ViewBag.AccountId) : 0;
    var primaryColor = (string)ViewBag.PrimaryColor;
    var logoUrl = (string)ViewBag.LogoUrl;
    var headerImageUrl = (string)ViewBag.HeaderImageUrl;
    var joiningUrl = $@"/join{accountUniqueName}.html";
    var website = (string)ViewBag.Website;

    if (!logoUrl.IsNotEmpty())
    {
        logoUrl = "/img/logo-vertical.png";
    }

    if (!primaryColor.IsNotEmpty() || primaryColor.IsBlank())
    {
        primaryColor = "#00ae85";
    }

    //.. data for layout
    ViewBag.Title = accountUniqueName;
    if (accountId > 0)
    {
        ViewBag.AccountProfile = AccountProfile.LoadByAccountId(accountId);
    }

    Layout = "~/Views/Shared/_LayoutRegistration.cshtml"; }

@{ Html.RenderPartial("~/Views/Shared/_RenderMessages.cshtml", msgs); }

<style>
    .search-bg {
        background-image: linear-gradient(rgba(0, 0, 0, .8), rgba(0, 0, 0, .8)), url( @headerImageUrl ) !important;
        background-repeat: no-repeat !important;
        background-size: cover !important;
        background-position: center !important;
        justify-content: center !important;
        align-items: center !important;
    }

    .join-directory-btn {
        color: white !important;
        min-width: 180px;
        background-color: @primaryColor !important;
    }

    .isyp-modal-header {
        padding: 0;
        background-image: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url(/img/image-3-1800x900-1.png);
        background-repeat: no-repeat;
        background-size: cover !important;
        background-position: center !important;
        justify-content: center !important;
        align-items: center !important;
        height: 200px;
    }

    .has-search .form-control:focus {
        border-color: @primaryColor;
    }

    .btn-generic {
        background-color: @primaryColor;
        border-color: @primaryColor;
        color: white;
    }

    .primary-color {
        color: @primaryColor;
    }

    .primary-bg-color {
        background-color: @primaryColor;
    }

    .primary-border-color {
        border-color: @primaryColor;
    }

    .am-generic-checkbox input[type="checkbox"] + label::before {
        border: solid 1px @primaryColor !important;
        margin: 0 10px 0 0 !important;
    }

    .am-generic-checkbox input[type="checkbox"]:checked + label::before {
        background-color: @primaryColor;
        color: white;
        border-color: @primaryColor;
    }

</style>

<div class="visible-lg visible-md">
    <div class="row" style="border-bottom: 2px solid @primaryColor;">
        <div class="@(headerImageUrl.IsNotEmpty() ? "search-bg" : "")" style="min-height: 100%; background: white; padding: 35px 20px;">
            <div class="reg-header-overlay col-md-12">
                <div class="col-lg-3 col-md-3 header-logo" style="margin-top: -25px;">
                    <a href=@(website.IsNotEmpty() ? website : "")>
                        <img src="@logoUrl" style="width: 110px;" />
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>

@{ Html.RenderPartial("~/Views/Shared/_DirectoryMobileSearch.cshtml"); }

<div id="main-view-container" class="display-flex">
    <div id="list-view" class="flex-1">
        <div id="filters" class="col-md-3 directory-filters">
            <span class="primary-color directory-sidebar-arrow" isOpen="true" onclick="return toggleSideBar(this)">
                <i id="search-sidebar-arrow" class="fa fa-chevron-circle-left" aria-hidden="true"></i>
            </span>

            @{ Html.RenderPartial("~/Views/Shared/_DirectoryFilters.cshtml"); }
        </div>

        <div id="search-container" class="directory-search-container col-md-9 pt-20 pb-20">

            <div class="col-lg-9 col-md-9">
                <div class="form-group has-feedback has-search" style="margin-left: 20px;">
                    <input id="txtSearch" name="search" type="text" class="form-control directory-search-input" placeholder="Search For Programs" onkeyup="return waitAndFilterSearch(this.value)">
                    <span class="glyphicon glyphicon-search form-control-feedback directory-search-magnyfier-icon"></span>
                </div>
            </div>

            <div class="am-checkbox am-generic-checkbox col-lg-3 col-md-3">
                <input id="chk-map-view" name="show-map" isEnabled="true" checked="checked" value="1" type="checkbox" class="schedulerepeat-checkbox" onclick="return toggleMapView(this)" />
                <label for="chk-map-view" class="margin-h-10 mobile-padding font-weight-bold">Show Map</label>
            </div>
            <div class="clearfix"></div>

            <div id="search-result" class="row"> </div>
            <div class="clearfix"></div>

            <div class="directory-search-no-result"></div>

            <div id="ProgressBar">
                <img src="~/img/lod_bg.gif">
            </div>

            <div id="notification-contact-us" class="text-center">
                <button class="btn btn-contact-us" style="border: 3px solid @primaryColor;" type="button" data-toggle="modal" data-target="#ContactUsModal">
                    Can't find what you are looking for?
                    <span class="contactSpan">CONTACT US</span>
                </button>
            </div>
            <div class="clearfix"></div>
        </div>
    </div>

    <div id="map-view"></div>
</div>

<div class="clearfix"></div>

@{ Html.RenderPartial("~/Views/Shared/_ISYPIntroModal.cshtml", logoUrl); }

@{ Html.RenderPartial("~/Views/Shared/_DirectoryContactUs.cshtml", logoUrl); }

<script id="script-search-result-list" type="text/template">

    <% _.each(response, function(searchResult){ %>

    <style>
        #dynamicLogo-<%=searchResult.AccountUid %> {
            background-image: url("<%= searchResult.ProfileHeaderImageUrl %>");
        }
    </style>

    <div id="<%= searchResult.AccountUid %>" name="<%= searchResult.AccountName %>" class="participation-object" style="height: 410px; margin-bottom: 10px; width: 350px;">

        <div class="panel" style="overflow: hidden; cursor: pointer; margin-right: 0; box-shadow: 0 5px 10px 0 rgba(0, 0, 0, 0.15);" onclick="WebPage.navigateIframe('<%= searchResult.HomePageUrl %>?dir=@accountUniqueName')">
            <div id="dynamicLogo-<%= searchResult.AccountUid %>" class="reg-header" style="min-height: 100px; height: 150px; padding: 5px 5px; position: relative;">

                <% if(showDistance) { %>

                <div class="distance-lable">
                    <%= Math.round(searchResult.TotalDifference * 100) / 100 %> mi
                </div>

                <% } %>

                <% if(searchResult.IsAccountNowEnrolling) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-danger profile-badge text-small">
                        Now Enrolling
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsVirtualProgram) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge profile-badge text-small">
                        Virtual
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsOpenDuringCovid) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        Open During COVID
                    </span>
                </div>

                <% } %>

                <% if(searchResult.IsELearningCenter) { %>

                <div class="pull-right margin-l-10">
                    <span class="badge badge-success profile-badge text-small">
                        E-Learning Center
                    </span>
                </div>

                <% } %>

                <div style="position: absolute; bottom: 0; right: 0; background-color: #fff; color: #333;">
                    <div class="padding-h-10">
                        <span class="text-small">
                            <%= searchResult.Location %>
                        </span>
                    </div>
                </div>

            </div>
            <div class="panel-body" style="position: relative;">

                <div class="" style="position: absolute; top: 10px; left: 15px; overflow: hidden; height: 20px;">

                    <div class="pull-left margin-l-5">
                        <% if(searchResult.IsRestrictByGrade) { %>

                        <span class="badge badge-gray profile-badge text-small">
                            <%= searchResult.GradeStart %> - <%= searchResult.GradeEnd %> Grade
                        </span>

                        <% } else { %>

                        <span class="badge badge-gray profile-badge text-small">
                            Ages <%= searchResult.AgeStart %> - <%= searchResult.AgeEnd %>
                        </span>

                        <% } %>
                    </div>

                </div>

                <div class="text-wrap" style="margin-top: 20px; height: 75px;">
                    <h3 style="height: 51px; overflow-y: hidden;">
                        <strong title="<%= searchResult.AccountName %>"><%= searchResult.AccountName %></strong>
                    </h3>
                </div>

                <div class="clearfix"></div>
                <div class="text-wrap">
                    <span class="text-medium-small" style="min-height: 60px; height: 60px; display: block;">
                        <%= searchResult.ProfileHeadline %>
                    </span>
                </div>

                <div class="clearfix"></div>
                <div class="margin-t-20">
                    <a href="javascript:WebPage.navigateIframe('<%= searchResult.HomePageUrl %>?dir=@accountUniqueName')" class="btn btn-register btn-block join-directory-btn">
                        Learn More &raquo;
                    </a>
                </div>

            </div>
        </div>
    </div>

    <% }) %>

</script>

@section Scripts
{
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script type="text/javascript">

        var delayTimer;
        var txtSearch = $('#txtSearch');
        var txtSearchMobile = $('#txtSearch-mobile');
        var txtZip = $('#txtZipCode');
        var isMobile = window.innerWidth <= 768;
        var inCallback = false, page = 0, isReachedScrollEnd = false, isMobileFilterWindowOpened = false;

        $(document).ready(function () {
            var isIsyp =  @Json.Encode(accountUniqueName.ToUpper().Contains("ISYP")) && @Json.Encode(CookieVariables.ShowISYPModal.IsBlank());
            if (isIsyp) {
                showModalIsyp();
                @(CookieVariables.ShowISYPModal = "false")
            }

            // we need to show the filter button, once js will get loaded, to avoid any js related error
            $("#img-mobile-filter").removeClass("hide");

            $(window).scroll(function () {
                if (isReachedScrollEnd == false &&
                    isMobileFilterWindowOpened == false &&
                    $(window).scrollTop() >= $('#search-container').offset().top + $('#search-container').outerHeight() - window.innerHeight)
                {
                    loadFiltersAndInitiateSearch();
                }
            });

            loadFiltersAndInitiateSearch();
            loadInitialTabs();

            if (!isMobile) {
                $('#filters').show();
            }

            formatContactPhoneForDirectory();
        })

        function formatContactPhoneForDirectory() {
            var inputElement = document.getElementById('phone');
            inputElement.addEventListener('keydown', enforceFormat);
            inputElement.addEventListener('keyup', formatToPhone);

            //format phone number when we load
            if (inputElement && inputElement.value) {
                var input = inputElement.value.replace(/\D/g, '').substring(0, 10); // First ten digits of input only
                var zip = input.substring(0, 3);
                var middle = input.substring(3, 6);
                var last = input.substring(6, 10);

                if (input.length > 6) { inputElement.value = `(${zip}) ${middle} ${last}`; } //(xxx) xxx xxxx
                else if (input.length > 3) { inputElement.value = `(${zip}) ${middle}`; }
                else if (input.length > 0) { inputElement.value = `(${zip}`; }
            }
        }

        function submitContactForDirectory() {
            if ($('#name').val() && $('#email').val() && $('#message').val())
            {
                var subjectLine = 'New Search Page Form Submission From: ' + $('#name').val();
                if ($('#phone').val()) {
                    subjectLine = subjectLine + ' - ' + $('#phone').val();
                }

                var params =
                    'name=' + encodeURIComponent($('#name').val()) +
                    '&pageName=search' +
                    '&fromEmail=' + encodeURIComponent($('#email').val()) +
                    '&message=' + encodeURIComponent($('#message').val()) +
                    '&MainSubject=' + encodeURIComponent(subjectLine) +
                    '&g_recaptcha_response=' + $('#g-recaptcha-response').val() +
                    '&phone=' + $('#phone').val();

                $('.formSubmitting').html('Submitting...');
                $('.btnContactUsSubmit').prop('disabled', true);

                $.post('/services/submitcontactform', params, function (data)
                {
                    $('.formSubmitting').html('Submit');
                    $('.btnContactUsSubmit').prop('disabled', false);
                    grecaptcha.reset();

                    if (data && data.status == 'ok') {
                        $('#name').val('');
                        $('#email').val('');
                        $('#message').val('');
                        $('#phone').val('');

                        Notifications.showBar({
                            title: 'Success',
                            message: 'Your message has been sent.',
                            success: true
                        });
                    }
                    else
                    {
                        var text = "";
                        for (var message of data.messages) {
                            text = text + message.Text;
                        }

                        Notifications.showBar({
                            title: 'Failed',
                            message: text,
                            success: false
                        });
                    }
                });

                return false;
            }

            return true;
        }

        function showModalIsyp() {
            $('#modal-isyp-intro').addClass('md-show');
            $('#blured-bg').addClass('blur-bg');
        }

        function closeModalIsyp() {
            $('#modal-isyp-intro').removeClass('md-show');
            $('#blured-bg').removeClass('blur-bg');
        }

        function loadFiltersAndInitiateSearch() {
            var hashUrl = WebPage.getHash();
            var filters = hashUrl.split(',');

            _.each(filters, function (filter) {
                if (filter.indexOf('search_') == 0) {
                    $(`input[name="search"]`).val(filter.split('_')[1]);
                } else if (filter.indexOf('zip_') == 0) {
                    $(`input[name="zipcode"]`).val(filter.split('_')[1]);
                } else {
                    var inputToCheck = $(`input[value="${decodeURIComponent(filter.trim())}"]`);

                    if (inputToCheck && inputToCheck.length > 0) {
                        inputToCheck.attr('checked', 'checked');
                    }
                }
            });

            prepareSearchParams();
        }

        function waitAndFilterSearch(search) {
            clearTimeout(delayTimer);
            delayTimer = setTimeout(function () {
                page = 0;
                prepareSearchParams();
            }, 1000); //1 second wait
        }

        function prepareSearchParams() {
            //.. reset scroll flag
            isReachedScrollEnd = false;

            //.. prepare params
            var mainUrl = '';
            var search = '';
            var zip = 0;
            var comma_delimited_neighborhoods = '';
            var comma_delimited_grades = '';
            var comma_delimited_ages = '';
            var comma_delimited_gender = '';
            var comma_delimited_services = '';
            var comma_delimited_timing = '';
            var comma_delimited_pricing = '';
            var comma_delimited_cost = '';
            var comma_delimited_starting = '';
            var comma_delimited_other = '';
            var comma_delimited_special = '';

            if (isMobile) {
                search = txtSearchMobile.val();
            } else {
                search = txtSearch.val();
            }

            if (search && search.length > 0) {
                mainUrl += `search_${search},`;
            }

            zip = txtZip.val() || 0;
            if (zip && zip.length > 0) {
                mainUrl += `zip_${zip},`;
            }

            $('input:checkbox[name=neighborhoods]:checked').each(function () {
                if (comma_delimited_neighborhoods.length > 0) {
                    comma_delimited_neighborhoods += ',';
                }
                comma_delimited_neighborhoods += $(this).val();
            });

            $('input:checkbox[name=grades]:checked').each(function () {
                if (comma_delimited_grades.length > 0) {
                    comma_delimited_grades += ',';
                }
                comma_delimited_grades += $(this).val();
            });

            $('input:checkbox[name=ages]:checked').each(function () {
                if (comma_delimited_ages.length > 0) {
                    comma_delimited_ages += ',';
                }
                comma_delimited_ages += $(this).val();
            });

            $('input:checkbox[name=gender]:checked').each(function () {
                if (comma_delimited_gender.length > 0) {
                    comma_delimited_gender += ',';
                }
                comma_delimited_gender += $(this).val();
            });

            $('input:checkbox[name=services]:checked').each(function () {
                if (comma_delimited_services.length > 0) {
                    comma_delimited_services += ',';
                }
                comma_delimited_services += $(this).val();
            });

            $('input:checkbox[name=timing]:checked').each(function () {
                if (comma_delimited_timing.length > 0) {
                    comma_delimited_timing += ',';
                }
                comma_delimited_timing += $(this).val();
            });

            $('input:checkbox[name=pricing]:checked').each(function () {
                if (comma_delimited_pricing.length > 0) {
                    comma_delimited_pricing += ',';
                }
                comma_delimited_pricing += $(this).val();
            });

            $('input:checkbox[name=cost]:checked').each(function () {
                if (comma_delimited_cost.length > 0) {
                    comma_delimited_cost += ',';
                }
                comma_delimited_cost += $(this).val();
            });

            $('input:checkbox[name=starting]:checked').each(function () {
                if (comma_delimited_starting.length > 0) {
                    comma_delimited_starting += ',';
                }
                comma_delimited_starting += $(this).val();
            });

            $('input:checkbox[name=other]:checked').each(function () {
                if (comma_delimited_other.length > 0) {
                    comma_delimited_other += ',';
                }
                comma_delimited_other += $(this).val();
            });

            $('input:checkbox[name=special-needs]:checked').each(function () {
                if (comma_delimited_special.length > 0) {
                    comma_delimited_special += ',';
                }
                comma_delimited_special += $(this).val();
            });

            if (comma_delimited_neighborhoods.length > 0) {
                mainUrl += `${comma_delimited_neighborhoods},`;
            }

            if (comma_delimited_grades.length > 0) {
                mainUrl += `${comma_delimited_grades},`;
            }

            if (comma_delimited_ages.length > 0) {
                mainUrl += `${comma_delimited_ages},`;
            }

            if (comma_delimited_gender.length > 0) {
                mainUrl += `${comma_delimited_gender},`;
            }

            if (comma_delimited_services.length > 0) {
                mainUrl += `${comma_delimited_services},`;
            }

            if (comma_delimited_timing.length > 0) {
                mainUrl += `${comma_delimited_timing},`;
            }

            if (comma_delimited_pricing.length > 0) {
                mainUrl += `${comma_delimited_pricing},`;
            }

            if (comma_delimited_cost.length > 0) {
                mainUrl += `${comma_delimited_cost},`;
            }

            if (comma_delimited_starting.length > 0) {
                mainUrl += `${comma_delimited_starting},`;
            }

            if (comma_delimited_other.length > 0) {
                mainUrl += `${comma_delimited_other},`;
            }

            if (comma_delimited_special.length > 0) {
                mainUrl += `${comma_delimited_special},`;
            }

            //.. get current scrolltop
            var scr = $(window).scrollTop();

            if (mainUrl) {
                WebPage.addHash(encodeURI(mainUrl));
                $('#clear-filters').show();
            } else {
                WebPage.addHash('');
                $('#clear-filters').hide();
            }

            //..scroll to last known position, because location.href scrolls to top
            document.documentElement.scrollTop = page == 0 ? 0 : scr;

            openSeeMorePanelsForSelectedCheckboxes();

            // .. call api
            if (!isMobile || !isMobileFilterWindowOpened) {
                loadAccounts(search,
                    comma_delimited_neighborhoods,
                    comma_delimited_grades,
                    comma_delimited_ages,
                    comma_delimited_gender,
                    comma_delimited_services,
                    comma_delimited_timing,
                    comma_delimited_pricing,
                    comma_delimited_cost,
                    comma_delimited_starting,
                    comma_delimited_other,
                    comma_delimited_special,
                    zip
                );
            }
        }

        function loadAccounts(search, neighborhoods, grades, ages, gender, services, timing, pricing, cost, starting, other, special, zip = 0) {
            if (inCallback) {
                return false;
            }

            showLoader();
            showProgressBar();
            inCallback = true;

            var url = '@Url.Action("GetAccounts", "Search", new { Area = "" })';
            $.ajax({
                type: "POST",
                url: url,
                data: { accountId: '@accountId', search, neighborhoods, grades, ages, gender, services, timing, pricing, cost, starting, other, special, zipcode: zip, pageNum: page },
                success: function (data) {
                    if (data && data.success == true) {

                        //.. prepare source and template
                        var source = $("#script-search-result-list").html();
                        var compiled = _.template(source);

                        //.. format data as JSON and combine with template
                        var compiledHtml = compiled({
                            response: data.data,
                            showDistance: data.showDistance
                        });

                        if (data.pageNum == 0) {
                            //..first page, so update whole page
                            $('#search-result').html(compiledHtml);
                        } else {
                            $('#search-result').append(compiledHtml);
                        }

                        page++;

                        if (data.data.length < 9) {
                            //..page size is less then the default, then it means no more records present
                            isReachedScrollEnd = true;
                        }

                        $('#notification-contact-us').show();
                        $('.directory-search-no-result').html('');
                    }
                    else {
                        if (data && data.status == 'error') {
                            $('#notification-contact-us').show();
                            $('#search-result').html('');

                            var error = '';

                            _.each(data.data, function (msg) {
                                error += msg?.Text + '<br />';
                            });

                            Notifications.showBar({
                                title: 'Error',
                                message: error,
                                success: false
                            });
                        }
                        else if (data && data.status == "no-result" && page <= 0) {
                            $('#notification-contact-us').show();
                            $('#search-result').html('');
                            $('.directory-search-no-result').html('<p>There are no activities that match this criteria. <br> To find more, remove filters or zoom out on the map.</p>');
                            isReachedScrollEnd = true;
                            page = 0;
                        }
                        else {
                            isReachedScrollEnd = true;
                            page = 0;
                        }
                    }

                    inCallback = false;
                    hideLoader();
                    hideProgressBar();
                    return false;
                }
            });
        }

        function mobileFilter() {
            var isOpen = $('#img-mobile-filter').attr('isOpen');
            if (isOpen == '0') {
                $('#filters').show();
                $('#mobile-filter-footer').show();

                $('#search-result').hide();
                $('#footerShowHide').hide();

                $('#img-mobile-filter').attr('isOpen', "1");
                isMobileFilterWindowOpened = true;
            }
            else {
                $('#filters').hide();
                $('#mobile-filter-footer').hide();
                $('#search-result').show();
                $('#footerShowHide').show();
                $('#img-mobile-filter').attr('isOpen', "0");
                isMobileFilterWindowOpened = false;
            }
        }

        function applyMobileFilter() {
            if (txtZip.val()?.length > 0) {
                //.. validate postal code first
                var isValid = checkZip($('#txtZipCode').val());
                if (isValid) {
                    mobileFilter();
                    page = 0;
                    return prepareSearchParams(true);
                } else {
                    $('#clear-filters').show();

                    Notifications.showBar({
                        title: 'Error',
                        message: 'Postal code is not in a proper format.',
                        success: false
                    });
                }
            } else {
                mobileFilter();
                page = 0;
                prepareSearchParams();
            }
        }

        function openSeeMorePanelsForSelectedCheckboxes() {
            var hashUrl = WebPage.getHash();
            var filters = hashUrl.split(',');

            _.each(filters, function (filter) {
                if (filter.indexOf('search_') != 0 && filter.indexOf('zip_') != 0) {
                    var inputToCheck = $(`input[value="${decodeURIComponent(filter.trim())}"]`);

                    if (inputToCheck && inputToCheck.length > 0) {

                        //..if checkbox is hidden, open that panel
                        var showMoreElement = inputToCheck.parent().siblings('p');
                        if (showMoreElement && showMoreElement.length > 0 && showMoreElement.text() == 'Show more...') {
                            $(showMoreElement).click();
                        }
                    }
                }
            });
        }

        function clearFilters() {
            //..clear all checkbox
            $(`input:checkbox[name=neighborhoods],[name=grades],[name=ages],[name=gender],[name=services],[name=timing],[name=pricing],[name=cost],[name=starting],[name=other],[name=special-needs]`).prop('checked', false);

            txtZip.val('');
            //..clear web link and hide clear filter link
            WebPage.addHash('');
            $('#clear-filters').hide();

            //..refresh accounts
            if (isMobile) {
                mobileFilter();
                $('#txtSearch-mobile').val('');
            } else {
                $('#txtSearch').val('');
            }

            resetTags();
            resetFlags();
            loadAccounts();
        }

        function resetFlags() {
            isReachedScrollEnd = false;
            page = 0;
            inCallback = false;
        }

        function toggleSideBar(element) {
            var isOpen = $(element).attr('isOpen');
            if (isOpen === 'true') {
                $(element).attr('isOpen', false)
                $('#search-sidebar-arrow').removeClass('fa-chevron-circle-left').addClass('fa-chevron-circle-right');
                $("#filters").animate({
                    width: '0px'
                });
            } else {
                $(element).attr('isOpen', true)
                $('#search-sidebar-arrow').removeClass('fa-chevron-circle-right').addClass('fa-chevron-circle-left');
                $("#filters").animate({
                    width: '25%'
                });
            }
        }

        function toggleMapView(element) {
            var isMapViewEnabled = $(element).attr('isEnabled');
            if (isMapViewEnabled === 'true') {
                $(element).attr('isEnabled', false)
                $("#map-view").css('flex', '0')

            } else {
                $(element).attr('isEnabled', true)
                $("#map-view").css('flex', '0.5')
            }
        }
    </script>
}
