<div style="font-family: calibri; font-size: 14px;">
  <p> Hello @Model.OwnerFirstName, </p>
  <br />
  <br />
  
  <p>
    <strong> @Model.RequestorFirstName (@Model.RequestorEmail) </strong> is requesting to claim your account on AfterSchool HQ. </p>
  <br />
  
  <p> If this is you, please <a href="@Model.ProfileClaimLink">click here</a> to claim your profile. </p>
