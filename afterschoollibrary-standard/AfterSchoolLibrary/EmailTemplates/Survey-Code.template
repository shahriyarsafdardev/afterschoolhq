<div>
  <p>Hello <b>@Model.Name</b>,</p>
  <br/>
  <p>You have been sent a survey request: <b>@Model.SurveyName</b></p>
  <br/>
  <p>Sign up using this link <a href="@Model.SignUpLink" target="_blank">@Model.SignUpLink</a> and the following invite code: <b>@Model.InviteCode</b> </p>
  <br/>
  <p>
    Or you can start the auto-signup process using this link <a href="@Model.AutoSignUpLink" target="_blank">@Model.AutoSignUpLink</a>
  </p>
  <br/>
  <p>Thanks</p>
</div>