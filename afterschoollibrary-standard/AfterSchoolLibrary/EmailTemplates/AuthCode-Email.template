<div>
  <p>Hi @Model.FirstName,</p>
    <br/>
  <p>
    Someone is attempting to <a href="@Model.LoginLink">login</a> to AfterSchool HQ using this email address. If that is you, please enter the following code to complete the login:
  </p>
    <br/>
  <p>
      <strong><font size="+2">@Model.AuthCode</font></strong>
  </p>
    <br/>
    <p>Please note that this code will expire in 3 minutes.</p>
    <br/>
  <p>
    If you did not initiate this login, please go to your account and change your password right away.
  </p>
    <br/>
   <p>
     Thank you,
   </p>
    <br/>
  <p>
    @Model.ProductName
  </p>
</div>