<div>
  <p>Hey @Model.ActivityContactName,</p>

  <p>
    This is an automated email leeting you know that @Model.CurrentUserName has withdrawn @Model.RegistrantName from @Model.ActivityName. If refund is necessary, please visit the accounting page of your AfterSchool HQ Dashboard.
  </p>
  @if(Model.OnPayment)
  {
    <p>
      This student has completed @Model.Paid out of @Model.Total payments on their payment plan. To cancel the remaining payments, please click here [link to payment plan page]
    </p>
  }
  <p>
      Your @Model.ProductName Team
  </p>
</div>