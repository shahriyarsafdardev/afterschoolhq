<div>
  <p>Hey @Model.FirstName,</p>

  <p>
    Thanks for signing up for @Model.ProductName. Please take a moment to verify the email address associated with your @Model.ProductName account by clicking the link below:
  </p>

  <p>
    <a href="@Model.VerificationLink">@Model.VerificationLink</a>
  </p>
  <p>
    If you have not signed up for a @Model.ProductName account, please let us know <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>.
  </p>
  <p>
    @Model.ProductName
  </p>
</div>