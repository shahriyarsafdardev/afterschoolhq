<div style="margin: 20px">
  <table style="border: 2px solid #f7f7f7; width: 600px;" border="0">
    <thead>
      <tr>
        <th style="padding: 10px;">
          Description
        </th>
        <th style="padding: 10px; text-align:center;">
          Qty
        </th>
        <th style="padding: 10px; text-align:center;">
          Cost
        </th>
      </tr>
    </thead>
    <tbody>
      @Model.BodyRows
    </tbody>
    <tfoot>
      <tr>
        <td colspan="2" style="text-align: left; padding: 10px;">
          Credit Card Fee
        </td>
        <td style="padding: 10px; text-align: right">
          @Model.CreditCardFee
        </td>
        <td></td>
      </tr>
      <tr>
        <td colspan="2" style="font-weight: bold; text-align: left; padding: 10px;">
          @Model.AmountDueOrPaid
        </td>
        <td style="font-weight: bold; padding: 10px; text-align: right">
          @Model.TotalCost
        </td>
        <td></td>
      </tr>
    </tfoot>
  </table>
</div>