      @Model.CustomMessage to <u>@Model.ActivityName</u>, hosted by <u>@Model.ActivityContactName</u>! @Model.YourRecepitText@Model.AllowPayLaterDetails
  </p>
    <br/>
  @Model.StripeNote

  @Model.RegistrationTable

  @Model.VirtualInfo

  @Model.SplitPaymentSubscriptionInfo
  
