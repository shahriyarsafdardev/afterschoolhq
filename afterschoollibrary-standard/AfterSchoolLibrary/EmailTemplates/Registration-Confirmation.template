<div>
  <p>Hello @Model.FirstName,</p>
    <br/>
  <p>
      @Model.CustomMessage for <u>@Model.ActivityName</u>, provided by <u>@Model.ActivityContactName</u>. Your payment receipt is below.
  </p>

  @Model.RegistrationTable

  @Model.VirtualInfo

  @Model.SplitPaymentSubscriptionInfo
  
  @Model.SubscriptionDetails
  
  <p>
    <a href="@Model.LoginLink">@Model.RegistrationDetails</a>
  </p>
  
  <p>
    If you have any questions or concerns, please contact @Model.ActivityContactName either by phone (@Model.ActivityContactPhone) or email (<a href="mailto:@Model.ActivityContactEmail">@Model.ActivityContactEmail</a>).
  </p>

  <p>
    This activity is provided by <a href="@Model.BillerAccountLink">@Model.BillerAccountName</a>.
  </p>

  <p>
    Thanks!<br />
    @Model.ProductName
  </p>
</div>