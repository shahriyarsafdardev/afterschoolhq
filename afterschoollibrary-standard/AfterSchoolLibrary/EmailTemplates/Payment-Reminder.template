<div>
  <p>@Model.FirstName,</p>
  
  <p>
    Thank your for @Model.Registering for @Model.ActivityName provided by @Model.BillerAccountName. In order to complete your registration for @Model.StudentName and ensure your spot is secured, please <a href="@Model.PaymentLink">make an online payment</a> to @Model.BillerAccountName.    
  </p>
  <p>
    Pay Online: <a href="@Model.PaymentLink">@Model.PaymentLink</a><br />
    You will directed to login to your @Model.ProductName account then automatically taken to the payment screen.
  </p>
  <p>
    If you have any questions or concerns about your registration status, please contact @Model.ActivityContactName either by phone (@Model.ActivityContactPhone) or email (<a href="mailto:@Model.ActivityContactEmail">@Model.ActivityContactEmail</a>).
  </p>
  
  <p>
      Thanks, <br />
      @Model.ProductName
  </p>
</div>