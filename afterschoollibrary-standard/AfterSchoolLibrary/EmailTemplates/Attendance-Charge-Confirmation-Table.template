<div style="margin: 20px">
  <table style="border: 2px solid #f7f7f7; width: 600px;" border="0">
    <thead>
      <tr>
        <th style="padding: 10px;">
          Attendance Date
        </th>
        <th style="padding: 10px; text-align:center;">
          Number Present
        </th>
		<th style="padding: 10px; text-align:center;">
		  Number Pre-Paid
		</th>
        <th style="padding: 10px; text-align:center;">
          Total Charge
        </th>
        <th style="padding: 10px; text-align:center;">
          Coupon Discount
        </th>
      </tr>
    </thead>
    <tbody>
      @Model.BodyRows
    </tbody>
    <tfoot>
      <tr>
		<td style="font-weight: bold;  padding: 10px;">
		 Total 
		</td>
        <td style="font-weight: bold; text-align: center; padding: 10px;">
		@Model.TotalNumberPresent
		</td>
        <td style="font-weight: bold; padding: 10px; text-align: center">
          @Model.TotalAttendanceCharge
        </td>
        <td></td>
      </tr>
    </tfoot>
  </table>
</div>