<div>
  <p>
    Hello @Model.FirstName,
  </p>
  
  @Model.CustomMessage
  
  <p>
    @Model.SenderDisplayName at @Model.AccountName has invited you to register for @Model.SessionName! @Model.RegistrationOpenText
  </p>
  
  <a href="@Model.AcceptLink" style="background:#008B6A;color:#fff;font-family:Montserrat;border:3px solid #fff;border-radius:10px;height:180px;max-width:450px;padding:5px 50px;font-size:28px;font-weight:800;text-decoration:none;margin: auto;display: flex;text-align: center;justify-content: center;
    align-items: center;">Accept and Register Now</a>
  
  <ul>
    <li>
      To <strong>decline</strong> this invite, please click the following link: <a href="@Model.DeclineLink">@Model.DeclineLink</a>
    </li>
  </ul>

  <p>
    If you have any issues signing up please contact us at <a href="mailto:@Model.SupportEmail">@Model.SupportEmail</a>
  </p>
  
  <p>
    Your @Model.ProductName Team
  </p>
</div>