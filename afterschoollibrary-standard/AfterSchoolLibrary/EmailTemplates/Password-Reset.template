<div>
  <p>Hey @Model.FirstName,</p>

  <p>
    We've received a request to reset your @Model.ProductName password. The reset password link expires in @Model.ExpiresInDays days.
  </p>

  <p>
    <a href="@Model.ResetPasswordLink">@Model.ResetPasswordLink</a>
  </p>
  <p>
    If you haven't requested a password reset, <a href="mailto:@Model.SupportEmail">let us know</a>.
  </p>
  <p>
      @Model.ProductName
  </p>
</div>